
&НаСервере
Процедура юум_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавитьЭлементы();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементы()
	
	НовЭлемент = Элементы.Добавить("юум_КодЦентральный", Тип("ПолеФормы"), 
		Элементы.ГруппаОсновноеПраво);
	НовЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовЭлемент.ПутьКДанным = "Объект.юум_КодЦентральный";
	
КонецПроцедуры
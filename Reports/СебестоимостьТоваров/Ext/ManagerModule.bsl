
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

&После("ДополнитьПараметрамиПоУмолчанию")
Процедура юум_ДополнитьПараметрамиПоУмолчанию(ПараметрыПоУмолчанию) Экспорт
	ИсключаемыеХозОперации = ПараметрыПоУмолчанию.ИсключаемыеХозОперации; 
	УдаляемоеЗначение = Перечисления.ХозяйственныеОперации.ПередачаМатериаловВПроизводство; 
	ИндексЗначения = ИсключаемыеХозОперации.Найти(УдаляемоеЗначение); 
	Если НЕ ИндексЗначения = Неопределено Тогда
		ИсключаемыеХозОперации.Удалить(ИндексЗначения);
	КонецЕсли;
	ПараметрыПоУмолчанию.Вставить("ИсключаемыеХозОперации", ИсключаемыеХозОперации);
КонецПроцедуры

#КонецЕсли

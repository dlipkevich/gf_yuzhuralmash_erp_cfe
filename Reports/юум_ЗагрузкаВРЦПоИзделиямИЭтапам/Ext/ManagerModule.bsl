Функция ИнтервалПланированияПоПериодичностиОтчета(Периодичность)
	
	Результат = Перечисления.ТочностьГрафикаПроизводства.День;
	
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Неделя;
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц 
		Или Периодичность = Перечисления.Периодичность.Квартал Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Месяц;
		
	Иначе
		Результат = Перечисления.ТочностьГрафикаПроизводства.День;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтрокуДанных(ДанныеОЗагрузке, ВыборкаДанных, ТекущийПериод, ИнтервалПланированияПоПериодичностиОтчета,
	НайденнаяДоступностьВРЦ, НайденнаяСводнаяЗанятостьВРЦ, НайденнаяСводнаяДоступностьВРЦ)
	
	СтрокаДанные = ДанныеОЗагрузке.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаДанные, ВыборкаДанных);
	
	СтрокаДанные.ПериодГрафика = ТекущийПериод;
	
	СтрокаДанные.ПериодГрафикаПредставление = ОперативныйУчетПроизводства.ИнтервалПланированияСтрокой(
		СтрокаДанные.ПериодГрафика, 
		ИнтервалПланированияПоПериодичностиОтчета);
	
	Если НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.Доступно = НайденнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли;
	
	Если НайденнаяСводнаяЗанятостьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ЗанятоСводно = НайденнаяСводнаяЗанятостьВРЦ[0].Занято;
	КонецЕсли; 
	
	Если НайденнаяСводнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ДоступноСводно = НайденнаяСводнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли; 

КонецПроцедуры

Функция ЗначениеОтбора(ИмяПоля, ЭлементыОтбора)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементКоллекции.ЛевоеЗначение = Поле 
			И ЭлементКоллекции.Использование Тогда
			
			Возврат ЭлементКоллекции.ПравоеЗначение;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#КонецЕсли 

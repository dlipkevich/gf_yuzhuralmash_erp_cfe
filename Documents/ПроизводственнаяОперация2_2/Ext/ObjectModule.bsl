#Область СлужебныеПроцедурыИФункции

// #юум {
// #04.02.01.04
// Перехват ПередЗаписью для добавления возможности изменения закрытых нарядов.
// Галфинд AMotorin 2026/11/18
&ИзменениеИКонтроль("ПередЗаписью")
Процедура юум_ПередЗаписью_Перехват(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	УстановитьКлючВСтрокахТабличныхЧастей(Отказ);
	
	ДанныеДоИзменения =  ДанныеОперацииДоИзменения();
	ДополнительныеСвойства.Вставить("ДанныеДоИзменения", ДанныеДоИзменения);
	
	// Проверка объекта
	Если Не РежимГрупповойОбработки() Тогда
		
		Если Не Этап.Пустая() Тогда
			
			СтатусЭтапа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Этап, "Статус");
			
			Если СтатусЭтапа = Перечисления.СтатусыЭтаповПроизводства2_2.Завершен Тогда
				
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'Изменение операции, принадлежащей завершенному этапу, невозможно.';
						|en = 'Cannot change the operation that belongs to a completed stage.'"),
					ЭтотОбъект,
					"Этап",,
					Отказ);
					
			ИначеЕсли РежимЗаписи = РежимЗаписиДокумента.Проведение
				И СтатусЭтапа = Перечисления.СтатусыЭтаповПроизводства2_2.Формируется
				И (КоличествоФакт > 0 ИЛИ КоличествоБрак > 0 ИЛИ КоличествоНаДоработке > 0 ИЛИ КоличествоНаКонтроле > 0) Тогда
				
				ОбщегоНазначения.СообщитьПользователю(
					СтрШаблон(НСтр("ru = 'Нельзя отражать ход выполнения операций по этапу в статусе ""%1"".';
									|en = 'Cannot display the progress of operations of the stage in the ""%1"" status.'"), СтатусЭтапа),
					ЭтотОбъект,
					"Этап",,
					Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не СменноеЗадание.Пустая() Тогда
		
			РеквизитыСменногоЗадания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СменноеЗадание, "Статус,Исполнитель");
			
		#Удаление
			Если РеквизитыСменногоЗадания.Статус = Перечисления.СтатусыСменныхЗаданий.Закрыто Тогда
		#КонецУдаления
		#Вставка
			// #юум {
			// #04.02.01.04
			// Разрешаем программное изменение операции закрытого наряда.
			// Галфинд AMotorin 2026/11/18
			Если РеквизитыСменногоЗадания.Статус = Перечисления.СтатусыСменныхЗаданий.Закрыто
				И НЕ юум_РазрешеноПрограммноеИзменениеЗакрытогоНаряда() Тогда
			// } #юум
		#КонецВставки
			
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'Изменение операции, принадлежащей закрытому сменному заданию, невозможно.';
						|en = 'Cannot edit the operation that belongs to a closed shift task.'"),
					ЭтотОбъект,
					"СменноеЗадание",,
					Отказ);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РеквизитыСменногоЗадания.Исполнитель) 
				И Исполнитель <> ДанныеДоИзменения.Исполнитель 
		#Удаление
				И Исполнитель <> РеквизитыСменногоЗадания.Исполнитель Тогда
		#КонецУдаления
		#Вставка
				И Исполнитель <> РеквизитыСменногоЗадания.Исполнитель
				И НЕ юум_РазрешеноПрограммноеИзменениеЗакрытогоНаряда() Тогда
		#КонецВставки
				
				ОбщегоНазначения.СообщитьПользователю(
					НСтр("ru = 'Изменение исполнителя, операции включенной в индивидуальное сменное задание, возможно только в сменном задании.';
						|en = 'You can change an assignee of an operation included in an individual shift task only in the shift task.'"),
					ЭтотОбъект,
					"Исполнитель",,
					Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Заполнение реквизитов
	Для каждого КлючИЗначение Из НоменклатураСервер.ПараметрыУказанияСерий(ЭтотОбъект, Документы.ПроизводственнаяОперация2_2) Цикл
		
		ПараметрыУказанияСерий = КлючИЗначение.Значение; // НоменклатураКлиентСервер.ПараметрыУказанияСерий
		
		Если ПараметрыУказанияСерий.ФактОтбора Тогда
			НоменклатураСервер.ОчиститьНеиспользуемыеСерии(ЭтотОбъект, ПараметрыУказанияСерий);
		КонецЕсли;
		
	КонецЦикла;
	
	Если НаОснованииНСИ
		И (Статус = Перечисления.СтатусыПроизводственныхОпераций.НеВыполнена
			ИЛИ Статус = Перечисления.СтатусыПроизводственныхОпераций.Пропущена) Тогда
		
		ОчиститьТабличныеЧасти();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		Для каждого Строка Из Трудозатраты Цикл
			Строка.Исполнитель = Исполнитель;
		КонецЦикла;
	КонецЕсли;
	
	ЗаполнитьНомер();
	ЗаполнитьИдентификатор(РежимЗаписи);
	
	#Вставка
	// #юум {
	// #04.02.01.04
	// Сохраняем вызов назначения номера при создании индивидуальной операции из АРМ.
	// Галфинд AMotorin 2026/11/17
	Если НЕ Отказ Тогда
		юум_ПередЗаписью_НомерИндивидуальнойОперации(Отказ, РежимЗаписи, РежимПроведения);
	КонецЕсли;
	// } #юум
	#КонецВставки
КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Обход запрета закрытого наряда без.
// Галфинд AMotorin 2026/11/18 
//
// Возвращаемое значение:
//   Булево - Истина, если объект уже существует и передан контекст программного изменения закрытого наряда, иначе Ложь.
//
Функция юум_РазрешеноПрограммноеИзменениеЗакрытогоНаряда()

    Контекст = Неопределено;

    Возврат НЕ ЭтоНовый() И ДополнительныеСвойства.Свойство("юум_КонтекстИзмененияЗакрытогоНаряда", Контекст) И ТипЗнч(Контекст) = Тип("Структура");

КонецФункции
// } #юум


// #юум {
// #04.02.01.04
// Заполнение ранее пустого исполнителя при установке статуса "Выполнена".
// Галфинд AMotorin 2026/11/16
&Вместо("УстановитьСтатус")
Функция юум_УстановитьСтатус(НовыйСтатус, ДополнительныеПараметры)

    Если НовыйСтатус = "Выполнена" И НЕ ЗначениеЗаполнено(ЭтотОбъект.Исполнитель) И ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда

        ВыбранныйИсполнитель = Неопределено;

        Если ДополнительныеПараметры.Свойство("юум_Исполнитель", ВыбранныйИсполнитель)
            И ЗначениеЗаполнено(ВыбранныйИсполнитель) Тогда

            ЭтотОбъект.Исполнитель = ВыбранныйИсполнитель;

        КонецЕсли;

    КонецЕсли;

    Возврат ПродолжитьВызов(НовыйСтатус, ДополнительныеПараметры);

КонецФункции
// } #юум


// #юум {
// #04.02.01.04
// Перед записью индивидуальной операции из АРМ назначаем порядковый номер в пределах этапа, после существующих номеров.
// Галфинд AMotorin 2026/10/27
//
// Параметры:
//   Отказ - Булево - Признак отмены записи, устанавливается в Истина при ошибке подготовки индивидуального техпроцесса.
//   РежимЗаписи - РежимЗаписиДокумента - Режим записи документа: запись, проведение либо отмена проведения.
//   РежимПроведения - РежимПроведенияДокумента - Режим проведения документа.
//
Процедура юум_ПередЗаписью_НомерИндивидуальнойОперации(Отказ, РежимЗаписи, РежимПроведения)

    РежимСозданияИзАРМ = Ложь;

	Если Отказ ИЛИ НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("юум_СозданиеИндивидуальнойИзАРМ", РежимСозданияИзАРМ) ИЛИ НЕ РежимСозданияИзАРМ ИЛИ НЕ ЭтотОбъект.ЭтоНовый() Тогда
		
        Возврат;
		
    КонецЕсли;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда 
		
        юум_ОбеспечитьИндивидуальныйТехпроцесс(Отказ);  
		
		Если Отказ Тогда 
			
            Возврат; 
			
		КонецЕсли;  
		
    КонецЕсли;

    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   ЕСТЬNULL(МАКСИМУМ(Существующие.НомерОперации), 0) КАК ПоследнийНомер
        |ИЗ
        |   (ВЫБРАТЬ
        |       Очередь.НомерОперации КАК НомерОперации
        |   ИЗ
        |       РегистрСведений.ОчередьПроизводственныхОпераций КАК Очередь
        |   ГДЕ
        |       Очередь.Этап = &Этап
        |
        |   ОБЪЕДИНИТЬ ВСЕ
        |
        |   ВЫБРАТЬ
        |       Операции.НомерОперации КАК НомерОперации
        |   ИЗ
        |       Документ.ПроизводственнаяОперация2_2 КАК Операции
        |   ГДЕ
        |       Операции.Этап = &Этап И Операции.ВключенаВТехпроцесс И НЕ Операции.ПометкаУдаления) КАК Существующие");

    Запрос.УстановитьПараметр("Этап", ЭтотОбъект.Этап);
    Выборка = Запрос.Выполнить().Выбрать();
    Выборка.Следующий();
    ПоследнийНомер = Выборка.ПоследнийНомер;
    ЭтотОбъект.НомерОперации = ПоследнийНомер + 1;
    ЭтотОбъект.НомерСледующейОперации = 0;

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Автоматический перевод техпроцесса этапа в индивидуальный режим при проведении новой производственной операции из АРМ.
// Галфинд AMotorin 2026/11/12
//
// Параметры:
//   Отказ - Булево - Признак ошибки подготовки техпроцесса, устанавливается в Истина, если переключение завершилось неуспешно.
//
Процедура юум_ОбеспечитьИндивидуальныйТехпроцесс(Отказ)

	Если Отказ Тогда 
		
        Возврат;  
		
    КонецЕсли;

    Попытка
        
        БлокировкаДанных = РегистрыСведений.ОчередьПроизводственныхОпераций.
        БлокировкаДанныхДляРасчетаОчереди(ЭтотОбъект.Этап);
        ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ТехнологическиеПроцессыЭтаповПроизводства");
        ЭлементБлокировки.УстановитьЗначение("Этап", ЭтотОбъект.Этап);
        ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
        БлокировкаДанных.Заблокировать();

        ПараметрыИсходногоТехпроцесса = РедакторПроизводственногоПроцессаВызовСервера.ПараметрыТехпроцессаЭтапа(ЭтотОбъект.Этап);  
			
		Если ПараметрыИсходногоТехпроцесса.ТипТехнологическогоПроцесса = Перечисления.ТипыТехнологическихПроцессовЭтапа.Индивидуальный Тогда 
			
            Возврат;
			
        КонецЕсли;

        НаборОчереди = РегистрыСведений.ОчередьПроизводственныхОпераций.СоздатьНаборЗаписей();
        НаборОчереди.Отбор.Этап.Установить(ЭтотОбъект.Этап);
        НаборОчереди.Прочитать();

		Если НаборОчереди.Количество() = 0 Тогда 
			
            ДанныеЭтапа = Документы.ЭтапПроизводства2_2.ДанныеДляРасчетаОчередиОпераций(ЭтотОбъект.Этап, Ложь)[ЭтотОбъект.Этап];
            ОперацииИсходногоТехпроцесса = РегистрыСведений.ОчередьПроизводственныхОпераций.СписокОперацийПоДаннымЭтапа(ДанныеЭтапа);

			Если ОперацииИсходногоТехпроцесса.Количество() > 0 Тогда  
				
                ДанныеЭтапа.ТребуетсяРассчитать = Истина;
                ПараметрыРасчета = РегистрыСведений.ОчередьПроизводственныхОпераций.ПараметрыРасчетаОчереди();
                РегистрыСведений.ОчередьПроизводственныхОпераций.РассчитатьОчередьПоДаннымЭтапа(ЭтотОбъект.Этап, ДанныеЭтапа, ПараметрыРасчета);
                НаборОчереди.Прочитать();  
				
				Если НаборОчереди.Количество() = 0 Тогда    
					
                    ВызватьИсключение "Не удалось сформировать исходную очередь операций этапа.";  
					
				КонецЕсли;       
				
			КонецЕсли;     
			
        КонецЕсли;

        ПараметрыНовогоТехпроцесса = РедакторПроизводственногоПроцессаКлиентСервер.ПараметрыТехпроцессаКонструктор();
        ПараметрыНовогоТехпроцесса.ТипТехнологическогоПроцесса = Перечисления.ТипыТехнологическихПроцессовЭтапа.Индивидуальный;
        ПараметрыНовогоТехпроцесса.КоэффициентТехнологическогоПроцесса = ПараметрыИсходногоТехпроцесса.КоэффициентТехнологическогоПроцесса;

        РегистрыСведений.ТехнологическиеПроцессыЭтаповПроизводства.ЗаписатьПараметрыТехпроцесса(ЭтотОбъект.Этап, ПараметрыНовогоТехпроцесса, Ложь);

        НаборОчереди.Записать(Истина);

        РегистрыСведений.ОчередьПроизводственныхОпераций.ДобавитьЗаданиеКРасчетуОчереди(ЭтотОбъект.Этап, Ложь, Отказ);

    Исключение
		
		Отказ = Истина;
        ТекстОшибки = СтрШаблон("Не удалось автоматически переключить технологический процесс этапа в индивидуальный: %1",
        ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,,Отказ);
		
    КонецПопытки;

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Функционал для закрытия наряда, если все производственные операции выполнены/отменены.
// Галфинд AMotorin 2026/10/27
&После("ПриЗаписи")
Процедура юум_ПослеЗаписиПроизводственнойОперации(Отказ)

	Если Отказ Тогда
		
        Возврат;   
		
    КонецЕсли;

    юум_СвязатьИндивидуальныеОперации(Отказ);

	Если Отказ Тогда  
		
        Возврат; 
		
    КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.СменноеЗадание) Тогда
		
        Возврат;    
		
    КонецЕсли;

	Если ЭтотОбъект.Статус <> Перечисления.СтатусыПроизводственныхОпераций.Выполнена И ЭтотОбъект.Статус <> Перечисления.СтатусыПроизводственныхОпераций.НеВыполнена Тогда  
		
		Возврат;    
		
    КонецЕсли;

	Запрос = Новый Запрос(
        "ВЫБРАТЬ
        | КОЛИЧЕСТВО(*) КАК КоличествоОпераций,
        | ЕСТЬNULL(СУММА(ВЫБОР
        |     КОГДА ДокОперация.Проведен
        |         И ДокОперация.Статус = &Выполнена
        |         ТОГДА 1
        |     ИНАЧЕ 0
        | КОНЕЦ), 0) КАК КоличествоВыполнено,
        | ЕСТЬNULL(СУММА(ВЫБОР
        |     КОГДА ДокОперация.Проведен
        |         И ДокОперация.Статус = &НеВыполнена
        |         ТОГДА 1
        |     ИНАЧЕ 0
        | КОНЕЦ), 0) КАК КоличествоНеВыполнено
        |ИЗ
        | Документ.ПроизводственнаяОперация2_2 КАК ДокОперация
        |ГДЕ
        | ДокОперация.СменноеЗадание = &СменноеЗадание
        | И НЕ ДокОперация.ПометкаУдаления");

    Запрос.УстановитьПараметр("СменноеЗадание", ЭтотОбъект.СменноеЗадание);
    Запрос.УстановитьПараметр("Выполнена", Перечисления.СтатусыПроизводственныхОпераций.Выполнена);
    Запрос.УстановитьПараметр("НеВыполнена", Перечисления.СтатусыПроизводственныхОпераций.НеВыполнена);

    Выборка = Запрос.Выполнить().Выбрать();

	Если НЕ Выборка.Следующий() Или Выборка.КоличествоОпераций = 0 Тогда    
		
        Возврат;        
		
    КонецЕсли;

	Если Выборка.КоличествоВыполнено <> Выборка.КоличествоОпераций И Выборка.КоличествоНеВыполнено <> Выборка.КоличествоОпераций Тогда 
		
        Возврат;             
		
    КонецЕсли;

    Задание = ЭтотОбъект.СменноеЗадание.ПолучитьОбъект();

	Если Задание.Статус = Перечисления.СтатусыСменныхЗаданий.Закрыто Тогда  
		
        Возврат;  
		
    КонецЕсли;

    Задание.Статус = Перечисления.СтатусыСменныхЗаданий.Закрыто;
	Задание.ФактическаяДатаЗавершения = ТекущаяДатаСеанса();
    Задание.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Связывание новой индивидуальной операции с ближайшим предшественником, повторное рассчитывание показателей доступности выполнения.
// Галфинд AMotorin 2026/10/27
//
// Параметры:
//   Отказ - Булево - Признак отказа при записи производственной операции, при Истина связывание не выполняется.
//
Процедура юум_СвязатьИндивидуальныеОперации(Отказ)

	Если Отказ Тогда 
		
        Возврат;  
		
    КонецЕсли;

    РежимСозданияИзАРМ = Ложь;

	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("юум_СозданиеИндивидуальнойИзАРМ", РежимСозданияИзАРМ) Тогда     
		
        Возврат;          
		
    КонецЕсли;

	Если НЕ РежимСозданияИзАРМ Тогда 
		
        Возврат;         
		
    КонецЕсли;

    ЭтапОперации = ЭтотОбъект.Этап;
    НомерНовойОперации = ЭтотОбъект.НомерОперации;

    Набор = РегистрыСведений.ОчередьПроизводственныхОпераций.СоздатьНаборЗаписей();
    Набор.Отбор.Этап.Установить(ЭтапОперации);
    Набор.Прочитать();

    НайденаНоваяОперация = Ложь;
    НомерПредыдущейОперации = 0;

    Для Каждого ЗаписьОчереди Из Набор Цикл

		Если ЗаписьОчереди.ПроизводственнаяОперация = ЭтотОбъект.Ссылка Тогда 
			
            НайденаНоваяОперация = Истина;         
			
        КонецЕсли;

		Если ЗаписьОчереди.НомерОперации < НомерНовойОперации И ЗаписьОчереди.НомерОперации > НомерПредыдущейОперации Тогда    
			
            НомерПредыдущейОперации = ЗаписьОчереди.НомерОперации;     
			
        КонецЕсли;

    КонецЦикла;

    Если НомерПредыдущейОперации > 0 Тогда

        ДокументыДляИзменения = Новый Соответствие;

        Для Каждого ЗаписьОчереди Из Набор Цикл

			Если ЗаписьОчереди.НомерОперации <> НомерПредыдущейОперации Тогда 
				
                Продолжить;       
				
            КонецЕсли;


			Если ЗначениеЗаполнено(ЗаписьОчереди.ПроизводственнаяОперация) И ЗаписьОчереди.ПроизводственнаяОперация <> ЭтотОбъект.Ссылка Тогда  
				
                ДокументыДляИзменения.Вставить(ЗаписьОчереди.ПроизводственнаяОперация, Истина);  
				
            КонецЕсли;

        КонецЦикла;

        Для Каждого ЭлементСоответствия Из ДокументыДляИзменения Цикл

            ПредыдущаяОперация = ЭлементСоответствия.Ключ.ПолучитьОбъект();

			Если ПредыдущаяОперация.НомерСледующейОперации = НомерНовойОперации Тогда    
				
                Продолжить;                
				
            КонецЕсли;

            ПредыдущаяОперация.НомерСледующейОперации = НомерНовойОперации;

            ПараметрыТехническойСвязи = Новый Структура("НоваяОперация,НомерСледующейОперации",
            ЭтотОбъект.Ссылка, НомерНовойОперации);
            КонтекстИзменения = Новый Структура("Сценарий,Параметры", "СвязьИндивидуальнойОперации", ПараметрыТехническойСвязи);
            ПредыдущаяОперация.ДополнительныеСвойства.Вставить("юум_КонтекстИзмененияЗакрытогоНаряда", КонтекстИзменения);
            ПредыдущаяОперация.Записать(РежимЗаписиДокумента.Проведение);

        КонецЦикла;

        Набор.Прочитать();
        ЕстьИзменения = Ложь;

        Для Каждого ЗаписьОчереди Из Набор Цикл

			Если ЗаписьОчереди.НомерОперации <> НомерПредыдущейОперации Тогда 
				
                Продолжить;      
				
            КонецЕсли;

			Если ЗаписьОчереди.НомерСледующейОперации = НомерНовойОперации Тогда  
				
                Продолжить;        
				
            КонецЕсли;

            ЗаписьОчереди.НомерСледующейОперации = НомерНовойОперации;
            ЕстьИзменения = Истина;

        КонецЦикла;

		Если ЕстьИзменения Тогда 
			
            Набор.Записать(Истина);  
			
        КонецЕсли;

    КонецЕсли;

    ПараметрыРасчета = РегистрыСведений.ОчередьПроизводственныхОпераций.ПараметрыРасчетаОчереди();
    СсылкиЭтапов = Новый Массив;
    СсылкиЭтапов.Добавить(ЭтапОперации);
    ДанныеЭтапов = Документы.ЭтапПроизводства2_2.ДанныеДляРасчетаОчередиОпераций(СсылкиЭтапов, Истина);
    ДанныеЭтапа = ДанныеЭтапов[ЭтапОперации];
    РегистрыСведений.ОчередьПроизводственныхОпераций.РассчитатьОчередьПоДаннымЭтапа(ЭтапОперации, ДанныеЭтапа, ПараметрыРасчета);

КонецПроцедуры
// } #юум

#КонецОбласти

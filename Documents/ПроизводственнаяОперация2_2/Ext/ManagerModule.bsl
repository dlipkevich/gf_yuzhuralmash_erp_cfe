    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.Идентификатор = "юум_СменноеЗаданиеНаряд";
    КомандаПечати.Представление = "Сменное задание (наряд)";
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	
	// Галфинд dlip  2026/11/24 {
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.Идентификатор = "юум_НарядЗадание";
    КомандаПечати.Представление = "Наряд (задание)";
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.Идентификатор = "юум_НарядОперация";
    КомандаПечати.Представление = "Наряд (операция)";
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	// Галфинд dlip  2026/11/24 }
	
КонецПроцедуры

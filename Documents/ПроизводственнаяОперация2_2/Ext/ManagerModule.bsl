// #юум {
// #04.02.01.04
// Формирование печатной формы связанного сменного задания.
// Галфинд AMotorin 2026/10/22
&После("Печать")
Процедура юум_ПослеПечатиНарядаПоОперации(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)

	Если МассивОбъектов.Количество() = 1 Тогда
		
		Для Каждого ОписаниеОперации Из КоллекцияПечатныхФорм Цикл
			
            Если ОписаниеОперации.ИмяВРЕГ = ВРег("ПроизводственнаяОперация") ИЛИ ОписаниеОперации.ИмяВРЕГ = ВРег("ПроизводственнаяОперацияЭтикетка") ИЛИ ОписаниеОперации.ИмяВРЕГ = ВРег("АктОБраке") Тогда

            	юум_ШтрихкодСПечатаемымКодом(ОписаниеОперации.ТабличныйДокумент, МассивОбъектов[0]);   
									
			КонецЕсли;  
			
		КонецЦикла;    
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "юум_СменноеЗаданиеНаряд") Тогда  
		
		юум_ПечатьСменноеЗаданиеНаряд(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
		
	КонецЕсли;
	
	// Галфинд dlip  2026/11/24 {
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "юум_НарядЗадание") Тогда
		
		юум_ПечатьНарядЗадание(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "юум_НарядОперация") Тогда
		
		юум_ПечатьНарядОперция(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
		
	КонецЕсли;
	// Галфинд dlip  2026/11/24 }

КонецПроцедуры
// } #юум  

#КонецОбласти


#Область СлужебныеПроцедурыИфункции

// #юум {
// #04.02.01.04
// Формирование изображения штрихкода с числовой подписью.
// Галфинд AMotorin 2026/10/22
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - Печатная форма, содержащая рисунки штрихкодов для замены.
//   СсылкаДокумента - ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылка на документ, по которой формируется
//     числовое значение штрихкода.
//
Процедура юум_ШтрихкодСПечатаемымКодом(ТабличныйДокумент, СсылкаДокумента)

    КодШтрихкода = ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(СсылкаДокумента);
    СтрокаШтрихкода = СтрЗаменить(СокрЛП(Строка(КодШтрихкода)), " ", "");

    Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл

        Параметры = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
        Параметры.Ширина = Макс(240, Окр(Рисунок.Ширина / 0.26454));
        Параметры.Высота = Макс(90, Окр(Рисунок.Высота / 0.26454));
        Параметры.Штрихкод = СтрокаШтрихкода;
        Параметры.ТипКода = ?(СтрДлина(СтрокаШтрихкода) = 13, 1, 4);
        Параметры.ОтображатьТекст = Истина;
        Параметры.РазмерШрифта = 12;
        РезультатГенерации = ГенерацияШтрихкода.ИзображениеШтрихкода(Параметры);
        Рисунок.Картинка = РезультатГенерации.Картинка;

    КонецЦикла;

КонецПроцедуры
// } #юум

Функция юум_СменныеЗаданияОпераций(ПроизводственныеОперации)
	
	Запрос = Новый Запрос(
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |    ДокОперации.СменноеЗадание КАК СменноеЗадание
        |ИЗ
        |    Документ.ПроизводственнаяОперация2_2 КАК ДокОперации
        |ГДЕ
        |    ДокОперации.Ссылка В (&Операции)
        |    И ДокОперации.СменноеЗадание <> ЗНАЧЕНИЕ(Документ.СменноеЗадание.ПустаяСсылка)
        |    И НЕ ДокОперации.СменноеЗадание.ПометкаУдаления"); 
	
    Запрос.УстановитьПараметр("Операции", ПроизводственныеОперации);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СменноеЗадание");
	
КонецФункции

Процедура юум_ПечатьСменноеЗаданиеНаряд(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
    Наряды = юум_СменныеЗаданияОпераций(МассивОбъектов);

	Если Наряды.Количество() = 0 Тогда  
		
        ВызватьИсключение "У выбранной производственной операции нет сменного задания (наряда).";  
		
    КонецЕсли;

    КоллекцияНаряда = КоллекцияПечатныхФорм.СкопироватьКолонки();
    ОписаниеНаряда = КоллекцияНаряда.Добавить();
    ОписаниеНаряда.ИмяМакета = "СменноеЗадание";
    ОписаниеНаряда.ИмяВРЕГ = ВРег("СменноеЗадание");

    Документы.СменноеЗадание.Печать(Наряды, ПараметрыПечати, КоллекцияНаряда, ОбъектыПечати, ПараметрыВывода);
    УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "юум_СменноеЗаданиеНаряд", "Сменное задание (наряд)", ОписаниеНаряда.ТабличныйДокумент);

КонецПроцедуры

Процедура юум_ПечатьНарядЗадание(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
    Наряды = юум_СменныеЗаданияОпераций(МассивОбъектов);

	Если Наряды.Количество() = 0 Тогда  
        ВызватьИсключение "У выбранной производственной операции нет сменного задания (наряда).";  
    КонецЕсли;

    КоллекцияНаряда = КоллекцияПечатныхФорм.СкопироватьКолонки();
    ОписаниеНаряда = КоллекцияНаряда.Добавить();
    ОписаниеНаряда.ИмяМакета = "юум_Наряд";
    ОписаниеНаряда.ИмяВРЕГ = ВРег(ОписаниеНаряда.ИмяМакета);

    Документы.СменноеЗадание.Печать(Наряды, ПараметрыПечати, КоллекцияНаряда, ОбъектыПечати, ПараметрыВывода);
	
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "юум_НарядЗадание", "Наряд (задание)", ОписаниеНаряда.ТабличныйДокумент);

КонецПроцедуры

Процедура юум_ПечатьНарядОперция(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	СменныеЗадания = юум_СменныеЗаданияОпераций(МассивОбъектов);

	Если СменныеЗадания.Количество() = 0 Тогда  
        ВызватьИсключение "У выбранной производственной операции нет сменного задания (наряда).";  
	КонецЕсли;
	
	Для Каждого СменноеСсылка Из СменныеЗадания Цикл
		МассивОбъектов.Добавить(СменноеСсылка);
	КонецЦикла;

    КоллекцияПечатныхФормНаряда = КоллекцияПечатныхФорм.СкопироватьКолонки();
    ОписаниеНаряда = КоллекцияПечатныхФормНаряда.Добавить();
    ОписаниеНаряда.ИмяМакета = "юум_Наряд";
    ОписаниеНаряда.ИмяВРЕГ = ВРег(ОписаниеНаряда.ИмяМакета);

    Документы.СменноеЗадание.Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФормНаряда, ОбъектыПечати, ПараметрыВывода);
	
    УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "юум_НарядОперация", "Наряд (операция)", ОписаниеНаряда.ТабличныйДокумент);

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийФормы

// #юум {
// #04.02.01.04
// При создании из АРМ только отмечаем сценарий, пользователь самостоятельно заполняет этап.
// Галфинд AMotorin 2026/10/27
&НаСервере
&Перед("ПриСозданииНаСервере")
Процедура юум_ПриСозданииНаСервере_РежимАРМ(Отказ, СтандартнаяОбработка)

    НовыеРеквизиты = Новый Массив;
    НовыеРеквизиты.Добавить(Новый РеквизитФормы("юум_СозданиеИндивидуальнойИзАРМ", Новый ОписаниеТипов("Булево")));
    ИзменитьРеквизиты(НовыеРеквизиты);

    ДанныеЗаполнения = Неопределено;
    Параметры.Свойство("ЗначенияЗаполнения", ДанныеЗаполнения);
    РежимСозданияИзАРМ = Ложь; 
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда  
		
        ДанныеЗаполнения.Свойство("юум_СозданиеИндивидуальнойИзАРМ", РежимСозданияИзАРМ);    
		
    КонецЕсли;

    ЭтотОбъект["юум_СозданиеИндивидуальнойИзАРМ"] = РежимСозданияИзАРМ;

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Перед записью новой операции из АРМ проверяем этап и передаем признак режиму объекта.
// Галфинд AMotorin 2026/10/27
&НаСервере
&Перед("ПередЗаписьюНаСервере")
Процедура юум_ПередЗаписьюНаСервере_ИндивидуальнаяОперация(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Отказ ИЛИ НЕ ЭтотОбъект["юум_СозданиеИндивидуальнойИзАРМ"] ИЛИ НЕ ТекущийОбъект.ЭтоНовый() Тогда 
		
        Возврат;  
		
    КонецЕсли;

    ТекущийОбъект.ВключенаВТехпроцесс = Истина;
    ТекущийОбъект.Статус = Перечисления.СтатусыПроизводственныхОпераций.Формируется;
    ТекущийОбъект.ДополнительныеСвойства.Вставить("юум_СозданиеИндивидуальнойИзАРМ", Истина);

КонецПроцедуры
// } #юум

#КонецОбласти

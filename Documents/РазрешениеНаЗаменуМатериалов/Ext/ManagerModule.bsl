// #юум {
// #03.01.04.01
// Формирование ПФ "Карта замены" 
// Галфинд  Домнышева 2026/11/20
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.РазрешениеНаЗаменуМатериалов
//  ОбъектыПечати - СписокЗначений - выходные области документов для печати БСП.
//
// Возвращаемое значение:
//  ТабличныйДокумент - ТабличныйДокумент
Функция юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)

    Макет = УправлениеПечатью.МакетПечатнойФормы(
			"Документ.РазрешениеНаЗаменуМатериалов.юум_ПФ_MXL_КартаЗамены");
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.КлючПараметровПечати = "юум_КартаЗамены";
    ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;
	
	ДанныеДокумента = юум_ПолучитьДанныеДляПечати(МассивОбъектов);
	ВыборкаСсылка = ДанныеДокумента.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПерваяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;
		юум_ВывестиКарту(ТабличныйДокумент, Макет, ВыборкаСсылка);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабличныйДокумент, ПерваяСтрока, ОбъектыПечати, ВыборкаСсылка.Ссылка);
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции
// } #юум

// #юум {
// #03.01.04.01
// Получение данных для заполнения ПФ юум_ПФ_MXL_КартаЗамены
// Галфинд Домнышева 2026/11/20
//
// Параметры:
//  МассивОбъектов - Массив - из ссылок ДокументСсылка.РазрешениеНаЗаменуМатериалов
//
// Возвращаемое значение:
//	РезультатЗапроса -  РезультатЗапроса, Неопределено  
//
Функция юум_ПолучитьДанныеДляПечати(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазрешениеНаЗаменуМатериалов.Ссылка КАК Ссылка,
		|	РазрешениеНаЗаменуМатериалов.Номер КАК НомерДокумента,
		|	РазрешениеНаЗаменуМатериалов.Дата КАК ДатаДокумента,
		|	РазрешениеНаЗаменуМатериалов.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	РазрешениеНаЗаменуМатериалов.ДатаОкончанияДействия КАК ДатаДействияПо,
		|	РазрешениеНаЗаменуМатериалов.ВариантЗамены КАК ВариантЗамены,
		|	РазрешениеНаЗаменуМатериалов.Ответственный КАК Ответственный,
		|	РазрешениеНаЗаменуМатериалов.УказаниеПоПрименению КАК Комментарий,
		|	""ОбластьДействия"" КАК ИмяТЧ,
		|	РазрешениеНаЗаменуМатериаловОбластиДействия.Подразделение КАК Подразделение,
		|	РазрешениеНаЗаменуМатериаловОбластиДействия.НаправлениеДеятельности КАК НаправлениеДеятельности,
		|	РазрешениеНаЗаменуМатериаловОбластиДействия.Изделие КАК Изделие,
		|	РазрешениеНаЗаменуМатериаловОбластиДействия.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	NULL КАК Номенклатура,
		|	NULL КАК Код,
		|	NULL КАК Характеристика,
		|	NULL КАК Количество,
		|	NULL КАК Упаковка
		|ИЗ
		|	Документ.РазрешениеНаЗаменуМатериалов.ОбластиДействия КАК РазрешениеНаЗаменуМатериаловОбластиДействия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗаменуМатериалов
		|		ПО РазрешениеНаЗаменуМатериаловОбластиДействия.Ссылка = РазрешениеНаЗаменуМатериалов.Ссылка
		|ГДЕ
		|	РазрешениеНаЗаменуМатериалов.Ссылка В(&МассивОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РазрешениеНаЗаменуМатериалов.Ссылка,
		|	РазрешениеНаЗаменуМатериалов.Номер,
		|	РазрешениеНаЗаменуМатериалов.Дата,
		|	РазрешениеНаЗаменуМатериалов.ДатаНачалаДействия,
		|	РазрешениеНаЗаменуМатериалов.ДатаОкончанияДействия,
		|	РазрешениеНаЗаменуМатериалов.ВариантЗамены,
		|	РазрешениеНаЗаменуМатериалов.Ответственный,
		|	РазрешениеНаЗаменуМатериалов.УказаниеПоПрименению,
		|	""Аналоги"",
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	РазрешениеНаЗаменуМатериаловАналоги.Номенклатура,
		|	СправочникНоменклатура.Код,
		|	РазрешениеНаЗаменуМатериаловАналоги.Характеристика,
		|	РазрешениеНаЗаменуМатериаловАналоги.КоличествоУпаковок,
		|	ВЫБОР
		|		КОГДА РазрешениеНаЗаменуМатериаловАналоги.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СправочникНоменклатура.ЕдиницаИзмерения
		|		ИНАЧЕ РазрешениеНаЗаменуМатериаловАналоги.Упаковка
		|	КОНЕЦ
		|ИЗ
		|	Документ.РазрешениеНаЗаменуМатериалов.Аналоги КАК РазрешениеНаЗаменуМатериаловАналоги
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗаменуМатериалов
		|		ПО РазрешениеНаЗаменуМатериаловАналоги.Ссылка = РазрешениеНаЗаменуМатериалов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО РазрешениеНаЗаменуМатериаловАналоги.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	РазрешениеНаЗаменуМатериалов.Ссылка В(&МассивОбъектов)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РазрешениеНаЗаменуМатериалов.Ссылка,
		|	РазрешениеНаЗаменуМатериалов.Номер,
		|	РазрешениеНаЗаменуМатериалов.Дата,
		|	РазрешениеНаЗаменуМатериалов.ДатаНачалаДействия,
		|	РазрешениеНаЗаменуМатериалов.ДатаОкончанияДействия,
		|	РазрешениеНаЗаменуМатериалов.ВариантЗамены,
		|	РазрешениеНаЗаменуМатериалов.Ответственный,
		|	РазрешениеНаЗаменуМатериалов.УказаниеПоПрименению,
		|	""Материалы"",
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL,
		|	РазрешениеНаЗаменуМатериаловМатериалы.Номенклатура,
		|	СправочникНоменклатура.Код,
		|	РазрешениеНаЗаменуМатериаловМатериалы.Характеристика,
		|	РазрешениеНаЗаменуМатериаловМатериалы.КоличествоУпаковок,
		|	ВЫБОР
		|		КОГДА РазрешениеНаЗаменуМатериаловМатериалы.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СправочникНоменклатура.ЕдиницаИзмерения
		|		ИНАЧЕ РазрешениеНаЗаменуМатериаловМатериалы.Упаковка
		|	КОНЕЦ
		|ИЗ
		|	Документ.РазрешениеНаЗаменуМатериалов.Материалы КАК РазрешениеНаЗаменуМатериаловМатериалы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РазрешениеНаЗаменуМатериалов КАК РазрешениеНаЗаменуМатериалов
		|		ПО РазрешениеНаЗаменуМатериаловМатериалы.Ссылка = РазрешениеНаЗаменуМатериалов.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО РазрешениеНаЗаменуМатериаловМатериалы.Номенклатура = СправочникНоменклатура.Ссылка
		|ГДЕ
		|	РазрешениеНаЗаменуМатериалов.Ссылка В(&МассивОбъектов)
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

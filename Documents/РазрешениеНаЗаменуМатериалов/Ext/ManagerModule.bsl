// #юум {
// #03.01.04.01
// Вывод областей одного документа 
// Галфинд Домнышева 2026/11/20
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  ВыборкаСсылка - ВыборкаДанных - данные обрабатываемого документа.
Процедура юум_ВывестиКарту(ТабличныйДокумент, Макет, ВыборкаСсылка)
	
	Область_Шапка					= Макет.ПолучитьОбласть("Шапка");
	Область_ОбластьДействия			= Макет.ПолучитьОбласть("ОбластьДействия");
	Область_СтрокаДействия			= Макет.ПолучитьОбласть("СтрокаДействия"); 
	ОбластьДействияПустая           = Макет.ПолучитьОбласть("ОбластьДействияПустая");
	Область_ОбластьНабор1   		= Макет.ПолучитьОбласть("ОбластьНабор1");
	Область_СтрокаНабора1   		= Макет.ПолучитьОбласть("СтрокаНабора1");
	Область_ОбластьНабор2   		= Макет.ПолучитьОбласть("ОбластьНабор2");
	Область_СтрокаНабора2   		= Макет.ПолучитьОбласть("СтрокаНабора2");
	Область_ОбластьСписок   		= Макет.ПолучитьОбласть("ОбластьСписок");
	Область_СтрокаСписка   			= Макет.ПолучитьОбласть("СтрокаСписка");
	Область_Подвал   				= Макет.ПолучитьОбласть("Подвал");
	
	Область_Шапка.Параметры.Заполнить(ВыборкаСсылка);
	Область_Шапка.Параметры.ДатаДействияС = Формат(ВыборкаСсылка.ДатаНачалаДействия, "ДФ=dd.MM.yyyy");
	Область_Шапка.Параметры.по = ?(ВыборкаСсылка.ДатаДействияПо = Дата(1, 1, 1), "бессрочно",
									"по " + Формат(ВыборкаСсылка.ДатаДействияПо, "ДФ=dd.MM.yyyy"));
	Область_Шапка.Параметры.ДатаДокумента = Формат(ВыборкаСсылка.ДатаДокумента, "ДФ=dd.MM.yyyy");
	
	ТабличныйДокумент.Вывести(Область_Шапка); 
	
	Выборка = ВыборкаСсылка.Выбрать();
	Выборка.Сбросить();
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИмяТЧ", "ОбластьДействия");
	ВыведенаОбластьДействия = Ложь;
	НомерДействия = 1;
	Пока Выборка.НайтиСледующий(СтруктураПоиска)  Цикл
		
		УсловиеПродолжения = Выборка.Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка() 
			И Выборка.НаправлениеДеятельности = Справочники.НаправленияДеятельности.ПустаяСсылка()
			И Выборка.Изделие = Справочники.Номенклатура.ПустаяСсылка() 
			И Выборка.ЗаказНаПроизводство = Неопределено;
		Если УсловиеПродолжения Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ВыведенаОбластьДействия Тогда
			ТабличныйДокумент.Вывести(Область_ОбластьДействия);
			ВыведенаОбластьДействия = Истина;
		КонецЕсли;
		
		Область_СтрокаДействия.Параметры.Заполнить(Выборка);
		Область_СтрокаДействия.Параметры.НомерСтроки = НомерДействия;
		
		ТабличныйДокумент.Вывести(Область_СтрокаДействия);
		НомерДействия = НомерДействия + 1;
	КонецЦикла; 
	
	Если НЕ ВыведенаОбластьДействия Тогда
		ТабличныйДокумент.Вывести(ОбластьДействияПустая);	
	КонецЕсли;
	
	Если ВыборкаСсылка.ВариантЗамены = Перечисления.ВариантЗаменыАналогов.НаборНаНабор Тогда 
		
		ТабличныйДокумент.Вывести(Область_ОбластьНабор1);
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, "Материалы", Область_СтрокаНабора1);
		
		ТабличныйДокумент.Вывести(Область_ОбластьНабор2);
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, "Аналоги", Область_СтрокаНабора2);
		
	КонецЕсли;
	
	Если ВыборкаСсылка.ВариантЗамены = Перечисления.ВариантЗаменыАналогов.СписокАналогов Тогда 
		
		ТабличныйДокумент.Вывести(Область_ОбластьСписок);
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, "Материалы", Область_СтрокаСписка);
		
	КонецЕсли;
	
	Область_Подвал.Параметры.Заполнить(ВыборкаСсылка);
	ТабличныйДокумент.Вывести(Область_Подвал); 
	
КонецПроцедуры
// } #юум

// #юум {
// #03.01.04.01
// Вывод строк для областей СтрокаНабора1, СтрокаНабора2, СтрокаСписка 
// Галфинд Домнышева 2026/11/23
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Выборка - ВыборкаДанных - данные обрабатываемого документа.
//  ИмяТЧ - Строка - наименование ТЧ для получения нужных строк.
//  ОбластьНаПечать - ТабличныйДокумент - область табличного документа.
Процедура ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, ИмяТЧ, ОбластьНаПечать)
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("ИмяТЧ", ИмяТЧ);
	НомерСтроки = 1;
	
	Пока Выборка.НайтиСледующий(СтруктураПоиска) Цикл
		
		ОбластьНаПечать.Параметры.Заполнить(Выборка);
		ОбластьНаПечать.Параметры.НомерСтроки = НомерСтроки;
		
		ТабличныйДокумент.Вывести(ОбластьНаПечать);
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла; 
	
	Выборка.Сбросить();
	
КонецПроцедуры

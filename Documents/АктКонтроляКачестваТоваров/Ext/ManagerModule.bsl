&После("ДобавитьКомандыПечати")
Процедура юум_ДобавитьКомандыПечати(КомандыПечати)
	// #юум {
	// #03.01.05.03   
	// Добавление новой команды печати
	// Галфинд Домнышева 2026/11/23
	КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.АктКонтроляКачестваТоваров";
    КомандаПечати.Идентификатор = "юум_АктВходногоКонтроля";
    КомандаПечати.Представление = НСтр("ru = 'Акт входного контроля'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	// } #юум

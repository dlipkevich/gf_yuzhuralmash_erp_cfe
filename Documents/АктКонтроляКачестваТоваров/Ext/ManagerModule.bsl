&После("Печать")
Процедура юум_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	// #юум {
	// #03.01.05.03 
	// Добавление формирования новой ПФ
	// Галфинд Домнышева 2026/11/23
	ИмяМакета = "юум_АктВходногоКонтроля";
	Представление = НСтр("ru = 'Акт входного контроля'");
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
		ПечатныйДокумент = юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати);
    	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, Представление, 
						ПечатныйДокумент);

	КонецЕсли;
	// } #юум
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

// #юум {
// #03.01.05.03  
// Формирование ПФ "Акт входного контроля" 
// Галфинд  Домнышева 2026/11/23
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.АктКонтроляКачестваТоваров
//  ОбъектыПечати - СписокЗначений - выходные области документов для печати БСП.
//
// Возвращаемое значение:
//  ТабличныйДокумент - ТабличныйДокумент
Функция юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)

    Макет = УправлениеПечатью.МакетПечатнойФормы(
			"Документ.АктКонтроляКачестваТоваров.юум_ПФ_MXL_АктВходногоКонтроля");
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.КлючПараметровПечати = "юум_АктВходногоКонтроля";
    ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;
	
	ДанныеДокумента = юум_ПолучитьДанныеДляПечати(МассивОбъектов);
	ВыборкаСсылка = ДанныеДокумента.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСсылка.Следующий() Цикл
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПерваяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;
		юум_ВывестиФорму(ТабличныйДокумент, Макет, ВыборкаСсылка);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабличныйДокумент, ПерваяСтрока, ОбъектыПечати, ВыборкаСсылка.Ссылка);
	КонецЦикла;

	Возврат ТабличныйДокумент;

КонецФункции
// } #юум

// #юум {
// #03.01.05.03 
// Получение данных для заполнения ПФ "Акт входного контроля"
// Галфинд Домнышева 2026/11/23
//
// Параметры:
//  МассивОбъектов - Массив - из ссылок ДокументСсылка.РазрешениеНаЗаменуМатериалов
//
// Возвращаемое значение:
//	РезультатЗапроса -  РезультатЗапроса, Неопределено  
//
Функция юум_ПолучитьДанныеДляПечати(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АктКонтроляКачестваТоваров.Ссылка КАК Ссылка,
		|	АктКонтроляКачестваТоваров.КонтролируемаяПартия КАК КонтролируемаяПартия,
		|	АктКонтроляКачестваТоваровТовары.Номенклатура КАК Номенклатура,
		|	СОКРЛП(СправочникНоменклатура.Код) КАК НоменклатураКод,
		|	АктКонтроляКачестваТоваровТовары.КоличествоУпаковок КАК Количество,
		|	ВЫБОР
		|		КОГДА АктКонтроляКачестваТоваровТовары.Упаковка = ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
		|			ТОГДА СправочникНоменклатура.ЕдиницаИзмерения
		|		ИНАЧЕ АктКонтроляКачестваТоваровТовары.Упаковка
		|	КОНЕЦ КАК Упаковка,
		|	ДопРеквизитКомиссия.Значение КАК НаименованиеКомиссии,
		|	ДопРеквизитКомиссия.Значение.ПолноеНаименование КАК СоставКомиссии,
		|	ДопРекРезультатыКонтроля.Значение КАК РезультатыКонтроля,
		|	АктКонтроляКачестваТоваровТовары.РезультатПроверкиКачества КАК РезультатПроверкиКачества,
		|	КонтролируемыеПартии.ДатаПоступления КАК ДатаПоступления,
		|	КонтролируемыеПартии.Контрагент КАК Контрагент
		|ИЗ
		|	Документ.АктКонтроляКачестваТоваров.Товары КАК АктКонтроляКачестваТоваровТовары
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктКонтроляКачестваТоваров КАК АктКонтроляКачестваТоваров
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтролируемыеПартии КАК КонтролируемыеПартии
		|			ПО АктКонтроляКачестваТоваров.КонтролируемаяПартия = КонтролируемыеПартии.Ссылка
		|		ПО АктКонтроляКачестваТоваровТовары.Ссылка = АктКонтроляКачестваТоваров.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
		|		ПО АктКонтроляКачестваТоваровТовары.Номенклатура = СправочникНоменклатура.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктКонтроляКачестваТоваров.ДополнительныеРеквизиты КАК ДопРеквизитКомиссия
		|		ПО (АктКонтроляКачестваТоваров.Ссылка = ДопРеквизитКомиссия.Ссылка)
		|			И (ДопРеквизитКомиссия.Свойство = &СвойствоКомиссия)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктКонтроляКачестваТоваров.ДополнительныеРеквизиты КАК ДопРекРезультатыКонтроля
		|		ПО (АктКонтроляКачестваТоваров.Ссылка = ДопРекРезультатыКонтроля.Ссылка)
		|			И (ДопРекРезультатыКонтроля.Свойство = &СвойствоРезультатыКонтроля)
		|ГДЕ
		|	АктКонтроляКачестваТоваровТовары.Ссылка В(&МассивОбъектов)
		|ИТОГИ
		|	МАКСИМУМ(ДатаПоступления),
		|	МАКСИМУМ(Контрагент),
		|	МАКСИМУМ(НаименованиеКомиссии),
		|	МАКСИМУМ(СоставКомиссии),
		|	МАКСИМУМ(РезультатыКонтроля)
		|ПО
		|	Ссылка,
		|	РезультатПроверкиКачества";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	СвойствоКомиссия = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
						.НайтиПоРеквизиту("ИдентификаторДляФормул", "КомиссияОТК");
	Запрос.УстановитьПараметр("СвойствоКомиссия", СвойствоКомиссия);
	СвойствоРезультатыКонтроля = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения
						.НайтиПоРеквизиту("ИдентификаторДляФормул", "РезультатыКонтроля");
	Запрос.УстановитьПараметр("СвойствоРезультатыКонтроля", СвойствоРезультатыКонтроля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции
// } #юум
	
// #юум {
// #03.01.05.03 
// Вывод областей одного документа 
// Галфинд Домнышева 2026/11/23
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  ВыборкаСсылка - ВыборкаДанных - данные обрабатываемого документа.
Процедура юум_ВывестиФорму(ТабличныйДокумент, Макет, ВыборкаСсылка)
	
	Область_Шапка					= Макет.ПолучитьОбласть("Шапка");
	Область_ОбъектКонтроля1			= Макет.ПолучитьОбласть("ОбъектКонтроля1");
	Область_ОбъектКонтроля2			= Макет.ПолучитьОбласть("ОбъектКонтроля2"); 
	Область_НаименованиеКомиссии    = Макет.ПолучитьОбласть("НаименованиеКомиссии");
	Область_СтрокаСоставления   	= Макет.ПолучитьОбласть("СтрокаСоставления");
	Область_Изделия1   				= Макет.ПолучитьОбласть("Изделия1");
	Область_Изделия2   				= Макет.ПолучитьОбласть("Изделия2");
	Область_Маркировка1   			= Макет.ПолучитьОбласть("Маркировка1");
	Область_Маркировка2   			= Макет.ПолучитьОбласть("Маркировка2");
	Область_Подвал   				= Макет.ПолучитьОбласть("Подвал"); 
		
	ВыборкаРезультатПроверкиКачества = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаРезультатПроверкиКачества.Следующий() Цикл
		
		ТабличныйДокумент.Вывести(Область_Шапка); 
		
		РезультатПроверкиКачества = ВыборкаРезультатПроверкиКачества.РезультатПроверкиКачества;
		
		Выборка = ВыборкаРезультатПроверкиКачества.Выбрать();
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, Область_ОбъектКонтроля1, Область_ОбъектКонтроля2);
		
		Область_НаименованиеКомиссии.Параметры.Заполнить(ВыборкаСсылка);
		ТабличныйДокумент.Вывести(Область_НаименованиеКомиссии);
		ТабличныйДокумент.Вывести(Область_СтрокаСоставления);
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, Область_Изделия1, Область_Изделия2);
		ВывестиОбластьНаПечать(ТабличныйДокумент, Выборка, Область_Маркировка1, Область_Маркировка2);
		
		Область_Подвал.Параметры.Заполнить(ВыборкаСсылка);
		ИсправитьСоответствие(ТабличныйДокумент, РезультатПроверкиКачества, Область_Подвал);
		ТабличныйДокумент.Вывести(Область_Подвал);
		
		ВывестиКомиссию(ТабличныйДокумент, Макет, ВыборкаРезультатПроверкиКачества.СоставКомиссии);
	КонецЦикла;
	
КонецПроцедуры
// } #юум

// #юум {
// #03.01.05.03 
// Вывод строк для областей СтрокаНабора1, СтрокаНабора2, СтрокаСписка 
// Галфинд Домнышева 2026/11/23
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  ВыборкаДокумента - ВыборкаДанных - данные обрабатываемого документа.
//  ОбластьНаПечать1 - ТабличныйДокумент - область табличного документа.
//  ОбластьНаПечать2 - ТабличныйДокумент - область табличного документа.
Процедура ВывестиОбластьНаПечать(ТабличныйДокумент, ВыборкаДокумента, ОбластьНаПечать1, ОбластьНаПечать2)
	
	ПерваяСтрока = Истина;
	Пока ВыборкаДокумента.Следующий() Цикл
		Если ПерваяСтрока Тогда
			ОбластьНаПечать1.Параметры.Заполнить(ВыборкаДокумента);
			ТабличныйДокумент.Вывести(ОбластьНаПечать1);
			ПерваяСтрока = Ложь;
		Иначе 
			ОбластьНаПечать2.Параметры.Заполнить(ВыборкаДокумента);
			ТабличныйДокумент.Вывести(ОбластьНаПечать2);
		КонецЕсли; 
		
	КонецЦикла;
	ВыборкаДокумента.Сбросить();
	
КонецПроцедуры
// } #юум

// #юум {
// #03.01.05.03 
// Вывод строк для областей СтрокаНабора1, СтрокаНабора2, СтрокаСписка 
// Галфинд Домнышева 2026/11/23
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  РезультатПроверкиКачества - ПеречислениеСсылка.РезультатыПроверкиКачестваТоваров - значение из ТЧ документа.
//  Область_Подвал - ТабличныйДокумент - область табличного документа.
Процедура ИсправитьСоответствие(ТабличныйДокумент, РезультатПроверкиКачества, Область_Подвал)
	
	Подчеркнутый = Метаданные.ЭлементыСтиля.юум_ПодчеркнутыйШрифтВПечатнуюФорму.Значение;
	
	Если РезультатПроверкиКачества = Перечисления.РезультатыПроверкиКачестваТоваров.УдовлетворяетТребованиям Тогда
		НоваяСтрока = Новый Массив();
		НоваяСтрока.Добавить("Продукция ");
		НоваяСтрока.Добавить(Новый ФорматированнаяСтрока("соответствует", Подчеркнутый));
		НоваяСтрока.Добавить(" / не соответствует технической документации предприятия изготовителя");
		Область_Подвал.Параметры.Соответствие = Новый ФорматированнаяСтрока(НоваяСтрока);
	КонецЕсли;	
		
	Если РезультатПроверкиКачества = Перечисления.РезультатыПроверкиКачестваТоваров.НеУдовлетворяетТребованиям Тогда
		
		НоваяСтрока = Новый Массив();
		НоваяСтрока.Добавить("Продукция соответствует / ");
		НоваяСтрока.Добавить(Новый ФорматированнаяСтрока("не соответствует", Подчеркнутый));
		НоваяСтрока.Добавить(" технической документации предприятия изготовителя");
		Область_Подвал.Параметры.Соответствие = Новый ФорматированнаяСтрока(НоваяСтрока);

	КонецЕсли;

КонецПроцедуры
// } #юум

// #юум {
// #03.01.05.03 
// Вывод строк для областей СтрокаНабора1, СтрокаНабора2, СтрокаСписка 
// Галфинд Домнышева 2026/11/24
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СоставКомиссии - Строка - значение доп.реквизита "КомиссияОТК".
Процедура ВывестиКомиссию(ТабличныйДокумент, Макет, СоставКомиссии)
	
	Область_Комиссия   				= Макет.ПолучитьОбласть("Комиссия");
	Область_ЧленыКомиссии 			= Макет.ПолучитьОбласть("ЧленыКомиссии");
	Область_ПустаяСтрока   			= Макет.ПолучитьОбласть("ПустаяСтрока");

	СоставМассив = СтрРазделить(СоставКомиссии, Символы.ПС);
	
	Если СоставМассив.Количество() = 0 Тогда
		 ТабличныйДокумент.Вывести(Область_ЧленыКомиссии);
         ТабличныйДокумент.Вывести(Область_ПустаяСтрока);
		 Возврат;
	КонецЕсли;
	
	Область_ЧленыКомиссии.Параметры.СоставКомиссии = СоставМассив[0];
	ТабличныйДокумент.Вывести(Область_ЧленыКомиссии);

	Индекс = 1;
	Пока Индекс <= СоставМассив.ВГраница() Цикл
		ЧленКомиссии = СоставМассив[Индекс];
		Область_Комиссия.Параметры.СоставКомиссии = ЧленКомиссии;
		ТабличныйДокумент.Вывести(Область_Комиссия);
		Индекс = Индекс + 1;
	КонецЦикла;
	ТабличныйДокумент.Вывести(Область_ПустаяСтрока);
	
КонецПроцедуры
// } #юум

#КонецОбласти

#КонецЕсли

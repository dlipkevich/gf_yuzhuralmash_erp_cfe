// Заполнение параметра Листов по всему Табличному документу
// Галфинд Домнышева 2026/10/27
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - формируемый ТабличныйДокумент
//
Процедура ЗаполнитьКоличествоЛистов(ТабличныйДокумент)
	
	ИтогоСтраниц = ТабличныйДокумент.КоличествоСтраниц();

	ОбластьВсегоСтраниц = ТабличныйДокумент.НайтиТекст("%ВсегоЛ%");
	Пока ОбластьВсегоСтраниц <> Неопределено Цикл
		ОбластьВсегоСтраниц.Текст = СтрЗаменить(ОбластьВсегоСтраниц.Текст, "%ВсегоЛ%", "Листов " + ИтогоСтраниц);
		// Ищем следующее вхождение
		ОбластьВсегоСтраниц = ТабличныйДокумент.НайтиТекст("%ВсегоЛ%");
	КонецЦикла;
	
КонецПроцедуры 
// } #юум

#КонецОбласти 

#КонецЕсли
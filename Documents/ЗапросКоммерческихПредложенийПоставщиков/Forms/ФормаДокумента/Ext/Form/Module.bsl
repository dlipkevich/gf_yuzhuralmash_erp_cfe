&НаСервере
Процедура юум_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	юум_РаботаСФормой.СоздатьПолеФормы(Элементы, "юум_Статус", "Статус", "Объект.юум_Статус",
						ВидПоляФормы.ПолеВвода, Элементы["ГруппаНомерДата"]);

	Если Объект.Ссылка.Пустая() Тогда
		Объект.юум_Статус = Перечисления.юум_СтатусыЗапросовКоммерческихПредложений.НаСогласовании;
	Иначе
		Элементы.юум_Статус.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры // #юум }
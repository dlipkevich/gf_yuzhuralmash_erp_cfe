// #юум {
// #04.02.01
// Получение текущего пользователя (роли)
// Галфинд AMotorin 2026/09/28
//
// Возвращаемое значение:
//	Строка - "НачальникСмены" или "Мастер" или "НачальникЦеха" или "ПользовательСПолнымиПравами"
//
&НаСервереБезКонтекста
Функция юум_ПолучитьТекущегоПользователя()

	РольАдминистраторСистемы = Пользователи.ЭтоПолноправныйПользователь(Неопределено, Истина, Истина);
	РольПолныеПрава          = Пользователи.ЭтоПолноправныйПользователь(Неопределено, Ложь,   Истина);

	Если РольАдминистраторСистемы ИЛИ РольПолныеПрава Тогда    
		
		ТекущийПользователь = "ПользовательСПолнымиПравами";
	
	ИначеЕсли Пользователи.РолиДоступны("юум_НачальникСмены") Тогда
		
		ТекущийПользователь = "НачальникСмены";
		
	ИначеЕсли Пользователи.РолиДоступны("юум_Мастер") Тогда  
		
		ТекущийПользователь = "Мастер";
		
	ИначеЕсли Пользователи.РолиДоступны("юум_НачальникЦеха") Тогда
		
		ТекущийПользователь = "НачальникЦеха";
		
	КонецЕсли;

	Возврат ТекущийПользователь; 

КонецФункции	
// } #юум

#КонецОбласти
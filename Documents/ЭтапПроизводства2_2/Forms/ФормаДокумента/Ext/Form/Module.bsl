// #юум {
// #04.02.01
// Установка даты передачи материало в производство для статьи калькуляции "ПолуфабрикатыПроизводимыеВПроцессе" - дата с закладки обеспчение, остальные статьи - дата из документа "Передача материалов в производство"
// Галфинд AMotorin 2026/09/28
&НаКлиенте
Процедура юум_УстановитьДатуРасходаПоПередачеВПроизводство()
	
	СтатьяПолуфабрикаты = ПредопределенноеЗначение("Справочник.СтатьиКалькуляции.ПолуфабрикатыПроизводимыеВПроцессе");
	ДатаДляОстальныхСтатей = юум_ПолучитьДатуПередачиВПроизводство(Объект.Ссылка);
	
	Для Каждого СтрокаТЧ Из Объект.РасходМатериаловИРабот Цикл
		
		Если СтрокаТЧ.СтатьяКалькуляции = СтатьяПолуфабрикаты Тогда 
			
			Продолжить;
			
		Иначе
		
			СтрокаТЧ.ДатаРасхода = ДатаДляОстальныхСтатей;
		
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
// } #юум

// #юум {
// #04.02.01
// Получение даты производсва для строк ТЧ со статьей калькуляции отличной от "Полуфабрикаты, производимые в процессе"
// Галфинд AMotorin 2026/09/28
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.ЭтапПроизводства2_2 - Ссылка на текущий документ
//
// Возвращаемое значение:
//	ДатаПередачиВПроизводство - Дата 
//
&НаСервереБезКонтекста
Функция юум_ПолучитьДатуПередачиВПроизводство(СсылкаНаДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПередачаМатериаловВПроизводство.Дата КАК Дата
		|ИЗ
		|	Документ.ПередачаМатериаловВПроизводство КАК ПередачаМатериаловВПроизводство
		|ГДЕ
		|	ПередачаМатериаловВПроизводство.Распоряжение = &СсылкаНаДокументРаспоряжение";
	
	Запрос.УстановитьПараметр("СсылкаНаДокументРаспоряжение", СсылкаНаДокумент);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		
		ДатаПередачиВПроизводство = ВыборкаДетальныеЗаписи.Дата;
		
	КонецЦикла;
	
	Возврат ДатаПередачиВПроизводство;
	
КонецФункции
// } #юум

// #юум {
// #04.02.01
// Получение текущего пользователя (роли)
// Галфинд AMotorin 2026/09/28
//
// Возвращаемое значение:
//	Строка - "НачальникСмены" или "Мастер"
//
&НаСервереБезКонтекста
Функция юум_ПолучитьТекущегоПользователя()
	
	Если Пользователи.РолиДоступны("юум_НачальникСмены") Тогда
		
		ТекущийПользователь = "НачальникСмены";
		
	ИначеЕсли Пользователи.РолиДоступны("юум_Мастер") Тогда  
		
		ТекущийПользователь = "Мастер";
		
	ИначеЕсли Пользователи.РолиДоступны("юум_НачальникЦеха") Тогда
		
		ТекущийПользователь = "НачальникЦеха";
		
	КонецЕсли;

	Возврат ТекущийПользователь; 

КонецФункции	
// } #юум

#КонецОбласти
// #юум {
// ЧТЗ 02.02.01. Команда БСП для документа и списка заявок.
// Галфинд mr. Cherryman 2026/10/29
&После("ДобавитьКомандыПечати")
Процедура юум_ДобавитьКомандыПечати(КомандыПечати)

    Если Не ПравоДоступа("Чтение", Метаданные.Документы.СписаниеБезналичныхДенежныхСредств) Тогда
        Возврат;
    КонецЕсли;
    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.МенеджерПечати = "Документ.ЗаявкаНаРасходованиеДенежныхСредств";
    КомандаПечати.Идентификатор = "юум_ЗаявкаНаРасходованиеДС";
    КомандаПечати.Представление = НСтр("ru = 'Заявка на расходование ДС'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
КонецПроцедуры // } #юум

// #юум {
// ЧТЗ 02.02.01. Штатная коллекция печатных форм; поддержка нескольких заявок.
// Галфинд mr. Cherryman 2026/10/29
&После("Печать")
Процедура юум_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
    ОбъектыПечати, ПараметрыВывода)

    ИмяМакета = "юум_ЗаявкаНаРасходованиеДС";
    Если Не УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
        Возврат;
    КонецЕсли;
    Если Не ПравоДоступа("Чтение", Метаданные.Документы.СписаниеБезналичныхДенежныхСредств) Тогда
        ВызватьИсключение НСтр("ru = 'Недостаточно прав для печати заявки на расходование ДС.'");
    КонецЕсли;
    ПечатныйДокумент = юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати);
    УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
        ИмяМакета, НСтр("ru = 'Заявка на расходование ДС'"), ПечатныйДокумент);

КонецПроцедуры // } #юум


// #юум {
// ЧТЗ 02.02.01. Печать заявки по макету отдельного расширения.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - заявки.
//  ОбъектыПечати - СписокЗначений - выходные области документов для печати БСП.
//
// Возвращаемое значение:
//  ТабличныйДокумент - сформированный комплект заявок.
Функция юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)

    ПутьКМакету = "Документ.ЗаявкаНаРасходованиеДенежныхСредств.юум_ПФ_MXL_ЗаявкаНаРасходованиеДС";
    Макет = УправлениеПечатью.МакетПечатнойФормы(ПутьКМакету);
    ПечатныйДокумент = Новый ТабличныйДокумент;
    ПечатныйДокумент.КлючПараметровПечати = "юум_ЗаявкаНаРасходованиеДС";
    ПечатныйДокумент.АвтоМасштаб = Истина;
    ПечатныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
    ПечатныйДокумент.РазмерСтраницы = "A4";
    ПечатныйДокумент.ПолеСлева = 8;
    ПечатныйДокумент.ПолеСправа = 8;

    Для Каждого СсылкаЗаявки Из МассивОбъектов Цикл
        Если ПечатныйДокумент.ВысотаТаблицы > 0 Тогда
            ПечатныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПерваяСтрока = ПечатныйДокумент.ВысотаТаблицы + 1;
        Модель = юум_ДанныеЗаявки(СсылкаЗаявки);
        юум_ВывестиЗаявку(ПечатныйДокумент, Макет, Модель);
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
            ПечатныйДокумент, ПерваяСтрока, ОбъектыПечати, СсылкаЗаявки);
    КонецЦикла;
    Возврат ПечатныйДокумент;

КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Вывод областей одной заявки; оформление хранится в макете.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  ПечатныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  Модель - Структура - данные заявки, платежи, итоги валют и лимиты.
Процедура юум_ВывестиЗаявку(ПечатныйДокумент, Макет, Модель)

    Шапка = Модель.Шапка;
    ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
    ОбластьШапки.Параметры.Номер = СокрЛП(Шапка.Номер);
    ОбластьШапки.Параметры.Дата = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy HH:mm:ss");
    ОбластьШапки.Параметры.ХозяйственнаяОперация = Строка(Шапка.ХозяйственнаяОперация);
    ОбластьШапки.Параметры.ИтогиВалют = юум_ИтогиВалютСтрокой(Модель.ИтогиВалют);
    ОбластьШапки.Параметры.Ответственный = Строка(Шапка.КтоЗаявил);
    ОбластьШапки.Параметры.ФормаОплаты = Строка(Шапка.ФормаОплаты);
    ОбластьШапки.Параметры.ДатаРасхода = юум_ДатаСтрокой(Шапка.ДатаПлатежа);
    ОбластьШапки.Параметры.Согласовал = Строка(Шапка.Согласовал);
    ПечатныйДокумент.Вывести(ОбластьШапки);

    Если Шапка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику Тогда
        юум_ВывестиРасчеты(ПечатныйДокумент, Макет, Модель);
    КонецЕсли;
    ОбластьНазначения = Макет.ПолучитьОбласть("Назначение");
    ОбластьНазначения.Параметры.НазначениеПлатежа = Строка(Шапка.НазначениеПлатежа);
    ПечатныйДокумент.Вывести(ОбластьНазначения);
    ПечатныйДокумент.Вывести(Макет.ПолучитьОбласть("Размещение"));

    ОбластьБюджета = Макет.ПолучитьОбласть("Бюджетирование");
    ОбластьБюджета.Параметры.Заполнить(Шапка);
    ПечатныйДокумент.Вывести(ОбластьБюджета);
    юум_ВывестиЛимиты(ПечатныйДокумент, Макет, Модель.Лимиты);
    ПечатныйДокумент.Вывести(Макет.ПолучитьОбласть("Утверждение"));

КонецПроцедуры // } #юум

// #юум {
// ЧТЗ 02.02.01. Шапка расчетов и повторяемая строка по договору/валюте.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  ПечатныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - именованные области расчетов.
//  Модель - Структура - шапка, платежи, основание и дата прихода.
Процедура юум_ВывестиРасчеты(ПечатныйДокумент, Макет, Модель)

    ОбластьШапки = Макет.ПолучитьОбласть("РасчетыШапка");
    ОбластьШапки.Параметры.Заполнить(Модель.Шапка);
    ПечатныйДокумент.Вывести(ОбластьШапки);
    ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаРасчетов");
    Для Каждого СтрокаРасчетов Из Модель.Платежи Цикл
        ОбластьСтроки.Параметры.Договор = юум_ПредставлениеДоговора(СтрокаРасчетов.Договор);
        ОбластьСтроки.Параметры.ОснованиеПлатежа = Модель.ОснованиеПлатежа;
        ОбластьСтроки.Параметры.ДатаПрихода = юум_ДатаСтрокой(Модель.ДатаПрихода);
        ОбластьСтроки.Параметры.СрокОплаты = "";
        ОбластьСтроки.Параметры.Долг = юум_СуммаСтрокой(СтрокаРасчетов.Долг);
        ОбластьСтроки.Параметры.СуммаПлатежа = юум_СуммаСтрокой(СтрокаРасчетов.СуммаПлатежа);
        ОбластьСтроки.Параметры.НДС = юум_СуммаСтрокой(СтрокаРасчетов.НДС);
        ОбластьСтроки.Параметры.Валюта = Строка(СтрокаРасчетов.Валюта);
        ОбластьСтроки.Параметры.Курс = юум_КурсСтрокой(СтрокаРасчетов.Курс);
        ОбластьСтроки.Параметры.СуммаРасчетов = юум_СуммаСтрокой(СтрокаРасчетов.СуммаРасчетов);
        ОбластьСтроки.Параметры.ДолгСУчетомЗаявки = юум_СуммаСтрокой(СтрокаРасчетов.ДолгСУчетомЗаявки);
        ПечатныйДокумент.Вывести(ОбластьСтроки);
    КонецЦикла;

КонецПроцедуры // } #юум

// #юум {
// ЧТЗ 02.02.01. Отдельная область макета хранит жирный ноль отсутствующего лимита.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  ПечатныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - варианты строки лимитов.
//  Лимиты - Структура - Лимит, Исполнение, ПериодКонтроля и ЕстьЛимит.
Процедура юум_ВывестиЛимиты(ПечатныйДокумент, Макет, Лимиты)

    ИмяОбласти = ?(Лимиты.ЕстьЛимит, "СтрокаЛимитов", "СтрокаЛимитовБезЛимита");
    ОбластьЛимитов = Макет.ПолучитьОбласть(ИмяОбласти);
    Если Лимиты.ЕстьЛимит Тогда
        ОбластьЛимитов.Параметры.Лимит = юум_СуммаСтрокой(Лимиты.Лимит);
    КонецЕсли;
    ОбластьЛимитов.Параметры.Исполнение = юум_СуммаСтрокой(Лимиты.Исполнение);
    ОбластьЛимитов.Параметры.Остаток = юум_СуммаСтрокой(Лимиты.Лимит - Лимиты.Исполнение);
    ОбластьЛимитов.Параметры.ПериодКонтроля = Формат(Лимиты.ПериодКонтроля, "ДФ=MM.yyyy");
    ПечатныйДокумент.Вывести(ОбластьЛимитов);

КонецПроцедуры // } #юум

// #юум {
// Галфинд mr. Cherryman 2026/10/29
// Параметры:
//  ИтогиВалют - ТаблицаЗначений - колонки Валюта и СуммаРасчетов.
// Возвращаемое значение:
//  Строка - отдельная сумма каждой валюты.
Функция юум_ИтогиВалютСтрокой(ИтогиВалют)
    ПредставленияВалют = Новый Массив;
    Для Каждого ИтогВалюты Из ИтогиВалют Цикл
        ПредставленияВалют.Добавить(юум_СуммаСтрокой(ИтогВалюты.СуммаРасчетов) + " " + Строка(ИтогВалюты.Валюта));
    КонецЦикла;
    Возврат СтрСоединить(ПредставленияВалют, "; ");
КонецФункции // } #юум

// #юум {
// Галфинд mr. Cherryman 2026/10/29
// Параметры:
//  ЗначениеДаты - Дата, Неопределено - дата либо незаполненное значение.
// Возвращаемое значение:
//  Строка - дата для печати либо пустая строка.
Функция юум_ДатаСтрокой(ЗначениеДаты)
    Возврат ?(ЗначениеЗаполнено(ЗначениеДаты), Формат(ЗначениеДаты, "ДФ=dd.MM.yyyy"), "");
КонецФункции // } #юум

// #юум {
// Галфинд mr. Cherryman 2026/10/29
// Параметры:
//  ЗначениеСуммы - Число - сумма для печати.
// Возвращаемое значение:
//  Строка - сумма с двумя десятичными знаками.
Функция юум_СуммаСтрокой(ЗначениеСуммы)
    Возврат Формат(ЗначениеСуммы, "ЧДЦ=2; ЧН=0,00");
КонецФункции // } #юум

// #юум {
// Галфинд mr. Cherryman 2026/10/29
// Параметры:
//  ЗначениеКурса - Число, Неопределено - рассчитанный курс либо отсутствие курса.
// Возвращаемое значение:
//  Строка - курс с шестью десятичными знаками либо пустая строка.
Функция юум_КурсСтрокой(ЗначениеКурса)
    Возврат ?(ЗначениеКурса = Неопределено, "", Формат(ЗначениеКурса, "ЧДЦ=6; ЧН=0"));
КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Данные отдельной печатной формы заявки.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  Ссылка - ДокументСсылка.ЗаявкаНаРасходованиеДенежныхСредств - сохраненная заявка.
//
// Возвращаемое значение:
//  Структура - шапка, строки расчетов, итоги валют и состояние лимитов.
Функция юум_ДанныеЗаявки(Ссылка)

    Шапка = юум_ШапкаЗаявки(Ссылка);
    Платежи = юум_РасшифровкаЗаявки(Ссылка);
    ИтогиВалют = Платежи.Скопировать(, "Валюта,СуммаРасчетов");
    ИтогиВалют.Свернуть("Валюта", "СуммаРасчетов");
    Платежи.Свернуть("Договор,Валюта", "СуммаПлатежа,НДС,СуммаРасчетов");

    Если Шапка.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику Тогда
        юум_ДополнитьРасчеты(Платежи, Шапка);
    КонецЕсли;

    ОснованиеПлатежа = юум_СчетаФактурыПоОснованию(Шапка.ДокументОснование);
    ДатаПрихода = юум_ДатаВходящегоДокумента(Шапка.ДокументОснование);
    Лимиты = юум_ЛимитыДляПечати(Шапка);
    Возврат Новый Структура("Шапка,Платежи,ИтогиВалют,ОснованиеПлатежа,ДатаПрихода,Лимиты",
        Шапка, Платежи, ИтогиВалют, ОснованиеПлатежа, ДатаПрихода, Лимиты);

КонецФункции // } #юум


// #юум {
// ЧТЗ 02.02.01. Шапка читается без привилегированного режима с учетом прав заявки.
// Галфинд mr. Cherryman 2026/10/29
Функция юум_ШапкаЗаявки(Ссылка)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Заявка.Ссылка КАК Ссылка,
    |   Заявка.Номер КАК Номер,
    |   Заявка.Дата КАК Дата,
    |   Заявка.Проведен КАК Проведен,
    |   Заявка.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
    |   Заявка.КтоЗаявил КАК КтоЗаявил,
    |   Заявка.ФормаОплатыЗаявки КАК ФормаОплаты,
    |   Заявка.ДатаПлатежа КАК ДатаПлатежа,
    |   Заявка.ЖелательнаяДатаПлатежа КАК ЖелательнаяДатаПлатежа,
    |   Заявка.юум_Согласовал КАК Согласовал,
    |   Заявка.Организация КАК Организация,
    |   Заявка.Подразделение КАК Подразделение,
    |   Заявка.СтатьяДвиженияДенежныхСредств КАК СтатьяДДС,
    |   Заявка.Контрагент КАК Контрагент,
    |   Заявка.Контрагент.ИНН КАК ИНН,
    |   Заявка.Контрагент.КПП КАК КПП,
    |   Заявка.БанковскийСчетКонтрагента.Банк КАК Банк,
    |   Заявка.БанковскийСчетКонтрагента.НомерСчета КАК РасчетныйСчет,
    |   Заявка.БанковскийСчетКонтрагента.КоррСчетБанка КАК КоррСчет,
    |   Заявка.БанковскийСчетКонтрагента.БИКБанка КАК БИК,
    |   Заявка.ДокументОснование КАК ДокументОснование,
    |   Заявка.НазначениеПлатежа КАК НазначениеПлатежа
    |ИЗ
    |   Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК Заявка
    |ГДЕ
    |   Заявка.Ссылка = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Данные = Запрос.Выполнить().Выгрузить();
    Если Данные.Количество() = 0 Тогда
        ВызватьИсключение НСтр("ru = 'Заявка не найдена или недоступна для чтения.'");
    КонецЕсли;
    Возврат Данные[0];

КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Договор определяется по объекту расчетов с резервом из шапки.
// Галфинд mr. Cherryman 2026/10/29
Функция юум_РасшифровкаЗаявки(Ссылка)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ВЫБОР
    |       КОГДА ЕСТЬNULL(Расшифровка.ОбъектРасчетов.Договор,
    |           ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) =
    |           ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
    |           ТОГДА Расшифровка.Ссылка.Договор
    |       ИНАЧЕ Расшифровка.ОбъектРасчетов.Договор
    |   КОНЕЦ КАК Договор,
    |   Расшифровка.ВалютаВзаиморасчетов КАК Валюта,
    |   Расшифровка.Сумма КАК СуммаПлатежа,
    |   Расшифровка.СуммаНДС КАК НДС,
    |   Расшифровка.СуммаВзаиморасчетов КАК СуммаРасчетов
    |ИЗ
    |   Документ.ЗаявкаНаРасходованиеДенежныхСредств.РасшифровкаПлатежа КАК Расшифровка
    |ГДЕ
    |   Расшифровка.Ссылка = &Ссылка";
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Остаток долга читается один раз для всех групп договора и валюты.
// Галфинд mr. Cherryman 2026/10/29
Процедура юум_ДополнитьРасчеты(Платежи, Шапка)

    Платежи.Колонки.Добавить("Долг");
    Платежи.Колонки.Добавить("Курс");
    Платежи.Колонки.Добавить("ДолгСУчетомЗаявки");
    Долги = юум_ДолгиПоДоговорам(Шапка, Платежи);
    Для Каждого СтрокаПлатежа Из Платежи Цикл
        ОтборДолга = Новый Структура("Договор,Валюта", СтрокаПлатежа.Договор, СтрокаПлатежа.Валюта);
        НайденныеДолги = Долги.НайтиСтроки(ОтборДолга);
        СтрокаПлатежа.Долг = 0;
        Если НайденныеДолги.Количество() > 0 Тогда
            СтрокаПлатежа.Долг = НайденныеДолги[0].СуммаДолга;
        КонецЕсли;
        СтрокаПлатежа.Курс = Неопределено;
        Если СтрокаПлатежа.СуммаРасчетов <> 0 Тогда
            СтрокаПлатежа.Курс = СтрокаПлатежа.СуммаПлатежа / СтрокаПлатежа.СуммаРасчетов;
        КонецЕсли;
        СтрокаПлатежа.ДолгСУчетомЗаявки = СтрокаПлатежа.Долг - СтрокаПлатежа.СуммаРасчетов;
    КонецЦикла;

КонецПроцедуры // } #юум

// #юум {
// ЧТЗ 02.02.01. Аналитика и граница дня совпадают с правилами отчета задолженности.
// Источник остатка - РасчетыСПоставщиками, прямо указанный в ЧТЗ.
// Галфинд mr. Cherryman 2026/10/29
Функция юум_ДолгиПоДоговорам(Шапка, Платежи)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   Аналитика.Договор КАК Договор,
    |   Остатки.Валюта КАК Валюта,
    |   СУММА(Остатки.СуммаОстаток) КАК СуммаДолга
    |ИЗ
    |   РегистрНакопления.РасчетыСПоставщиками.Остатки(&ГраницаДня,
    |       АналитикаУчетаПоПартнерам В
    |           (ВЫБРАТЬ
    |               Ключи.КлючАналитики
    |            ИЗ
    |               РегистрСведений.АналитикаУчетаПоПартнерам КАК Ключи
    |            ГДЕ
    |               Ключи.Организация = &Организация
    |               И Ключи.Контрагент = &Контрагент
    |               И Ключи.Договор В (&Договоры))) КАК Остатки
    |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК Аналитика
    |       ПО Остатки.АналитикаУчетаПоПартнерам = Аналитика.КлючАналитики
    |СГРУППИРОВАТЬ ПО
    |   Аналитика.Договор,
    |   Остатки.Валюта";
    Запрос.УстановитьПараметр("ГраницаДня", Новый Граница(КонецДня(Шапка.ДатаПлатежа), ВидГраницы.Включая));
    Запрос.УстановитьПараметр("Организация", Шапка.Организация);
    Запрос.УстановитьПараметр("Контрагент", Шапка.Контрагент);
    Запрос.УстановитьПараметр("Договоры", Платежи.ВыгрузитьКолонку("Договор"));
    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Без найденных полученных счетов-фактур поле остается пустым.
// Галфинд mr. Cherryman 2026/10/29
Функция юум_СчетаФактурыПоОснованию(ДокументОснование)

    Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
        Возврат "";
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |   Основания.Ссылка КАК СчетФактура
    |ИЗ
    |   Документ.СчетФактураПолученный.ДокументыОснования КАК Основания
    |ГДЕ
    |   Основания.ДокументОснование = &ДокументОснование
    |   И НЕ Основания.Ссылка.ПометкаУдаления
    |УПОРЯДОЧИТЬ ПО
    |   СчетФактура";
    Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
    ВыборкаСчетов = Запрос.Выполнить().Выбрать();
    ПредставленияСчетов = Новый Массив;
    Пока ВыборкаСчетов.Следующий() Цикл
        ПредставленияСчетов.Добавить(Строка(ВыборкаСчетов.СчетФактура));
    КонецЦикла;
    Возврат СтрСоединить(ПредставленияСчетов, ", ");

КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Дата прихода берется только из прямо указанного основания.
// Галфинд mr. Cherryman 2026/10/29
Функция юум_ДатаВходящегоДокумента(ДокументОснование)

    Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
        Возврат Неопределено;
    КонецЕсли;
    МетаданныеОснования = ДокументОснование.Метаданные();
    Если МетаданныеОснования.Реквизиты.Найти("ДатаВходящегоДокумента") = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДатаВходящегоДокумента");

КонецФункции // } #юум

// #юум {
// ЧТЗ 02.02.01. Только чтение типового регистра при формировании печати.
// Галфинд mr. Cherryman 2026/10/29
//
// Параметры:
//  Шапка - СтрокаТаблицыЗначений - даты и аналитика сохраненной заявки.
//
// Возвращаемое значение:
//  Структура - лимит, исполнение, месяц контроля и признак установленного лимита.
Функция юум_ЛимитыДляПечати(Шапка)

    ДатаКонтроля = Шапка.ДатаПлатежа;
    Если Не ЗначениеЗаполнено(ДатаКонтроля) Тогда
        ДатаКонтроля = Шапка.ЖелательнаяДатаПлатежа;
    КонецЕсли;
    Если Не ЗначениеЗаполнено(ДатаКонтроля) Тогда
        ДатаКонтроля = Шапка.Дата;
    КонецЕсли;
    ПериодКонтроля = НачалоМесяца(ДатаКонтроля);
    ОрганизацияКонтроля = Шапка.Организация;
    ПодразделениеКонтроля = Шапка.Подразделение;
    Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЛимитыРасходаДенежныхСредствПоОрганизациям") Тогда
        ОрганизацияКонтроля = Справочники.Организации.ПустаяСсылка();
    КонецЕсли;
    Если Не ПолучитьФункциональнуюОпцию("ИспользоватьЛимитыРасходаДенежныхСредствПоПодразделениям") Тогда
        ПодразделениеКонтроля = Справочники.СтруктураПредприятия.ПустаяСсылка();
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ЕСТЬNULL(СУММА(Обороты.ЛимитОборот), 0) КАК Лимит,
    |   ЕСТЬNULL(СУММА(Обороты.РасходВПределахЛимитаОборот), 0) КАК Исполнение
    |ИЗ
    |   РегистрНакопления.ЛимитыРасходаДенежныхСредств.Обороты(
    |       &НачалоМесяца,
    |       &КонецМесяца,
    |       ,
    |       Организация = &Организация
    |           И Подразделение = &Подразделение
    |           И СтатьяДвиженияДенежныхСредств = &СтатьяДДС) КАК Обороты";
    Запрос.УстановитьПараметр("НачалоМесяца", ПериодКонтроля);
    Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(ПериодКонтроля));
    Запрос.УстановитьПараметр("Организация", ОрганизацияКонтроля);
    Запрос.УстановитьПараметр("Подразделение", ПодразделениеКонтроля);
    Запрос.УстановитьПараметр("СтатьяДДС", Шапка.СтатьяДДС);
    ВыборкаЛимитов = Запрос.Выполнить().Выбрать();
    ВыборкаЛимитов.Следующий();

    // Проведенная заявка уже учтена типовым регистром; при печати ничего не добавляется.
    Возврат Новый Структура("Лимит,Исполнение,ПериодКонтроля,ЕстьЛимит",
        ВыборкаЛимитов.Лимит, ВыборкаЛимитов.Исполнение, ПериодКонтроля, ВыборкаЛимитов.Лимит <> 0);

КонецФункции // } #юум

#КонецОбласти

#КонецЕсли

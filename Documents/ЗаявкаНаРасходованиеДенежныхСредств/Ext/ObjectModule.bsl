#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// #юум {
// ЧТЗ 02.02.01. Фиксация пользователя при согласовании заявки.
// Галфинд mr. Cherryman 2026/10/29
&После("ПередЗаписью")
Процедура юум_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ОбменДанными.Загрузка Или Отказ Тогда
        Возврат;
    КонецЕсли;

    ПредыдущиеДанные = юум_ПредыдущиеДанныеСогласования();
    СтатусыЗаявок = Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств;
    Если ЭтотОбъект.Статус = СтатусыЗаявок.НеСогласована
        Или ЭтотОбъект.Статус = СтатусыЗаявок.Отклонена Тогда
        юум_Согласовал = Справочники.Пользователи.ПустаяСсылка();
    ИначеЕсли ЭтотОбъект.Статус = СтатусыЗаявок.Согласована
        И ЭтотОбъект.Статус <> ПредыдущиеДанные.Статус Тогда
        юум_Согласовал = Пользователи.ТекущийПользователь();
    Иначе
        юум_Согласовал = ПредыдущиеДанные.юум_Согласовал;
    КонецЕсли;

КонецПроцедуры // } #юум

// #юум {
// ЧТЗ 02.02.01. Согласовавший не переносится в копию заявки.
// Галфинд mr. Cherryman 2026/10/29
&После("ПриКопировании")
Процедура юум_ПриКопировании(ОбъектКопирования)
    юум_Согласовал = Справочники.Пользователи.ПустаяСсылка();
КонецПроцедуры // } #юум

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// #юум {
// ЧТЗ 02.02.01. Чтение состояния согласования до записи.
// Галфинд mr. Cherryman 2026/10/29
//
// Возвращаемое значение:
//  Структура:
//   * Статус - ПеречислениеСсылка.СтатусыЗаявокНаРасходованиеДенежныхСредств,
//     Неопределено - сохраненный статус; для новой заявки Неопределено.
//   * юум_согласовал - СправочникСсылка.Пользователи - сохраненный согласовавший.
Функция юум_ПредыдущиеДанныеСогласования()

    Если ЭтоНовый() Тогда
        ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();
        Возврат Новый Структура("Статус,юум_Согласовал", Неопределено, ПустойПользователь);
    КонецЕсли;

    Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Статус,юум_Согласовал");

КонецФункции // } #юум

#КонецОбласти

#КонецЕсли

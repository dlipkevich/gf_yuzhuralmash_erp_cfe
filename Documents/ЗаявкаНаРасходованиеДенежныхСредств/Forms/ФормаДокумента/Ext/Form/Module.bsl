#Область ОбработчикиСобытийФормы

// #юум {
// ЧТЗ 02.02.01. Поле согласовавшего рядом с заявителем в форме заявки.
// Галфинд mr. Cherryman 2026/10/30
&НаСервере
&После("ПриСозданииНаСервере")
Процедура юум_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Если Элементы.Найти("юум_Согласовал") <> Неопределено Тогда
        Возврат;
    КонецЕсли;

    ПолеЗаявителя = Элементы.Заявитель;
    ПолеСогласовавшего = Элементы.Вставить("юум_Согласовал", Тип("ПолеФормы"),
        ПолеЗаявителя.Родитель, ПолеЗаявителя);
    ПолеСогласовавшего.Вид = ВидПоляФормы.ПолеВвода;
    ПолеСогласовавшего.ПутьКДанным = "Объект.юум_Согласовал";
    ПолеСогласовавшего.Заголовок = НСтр("ru = 'Согласовал'");
    ПолеСогласовавшего.ТолькоПросмотр = Истина;

КонецПроцедуры // } #юум
// #юум {
// #02.02.01
// Установка недоступности реквизита формы "СверхЛимита" для пользователей, у которых нет роли "юум_СозданиеСверхлимитныхЗаявок"
// Галфинд AMotorin 2026/09/17
&НаСервере
&После("ПриСозданииНаСервере")
Процедура юумПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	Если Пользователи.РолиДоступны("юум_СозданиеСверхлимитныхЗаявок") = Ложь Тогда
		Элементы.СверхЛимита.Доступность = Ложь;
	КонецЕсли;
			
КонецПроцедуры // } #юум 

#КонецОбласти

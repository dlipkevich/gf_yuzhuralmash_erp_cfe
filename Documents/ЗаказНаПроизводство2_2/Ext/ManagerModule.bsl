// #04.02.01.06
// Находит первые СБЕ в каждой ветви дерева.
// Галфинд Домнышева 2026/11/09
// 
// Параметры:
//  СтрокиДерева - КоллекцияСтрокДереваЗначений - коллекция строк полученного дерева
//	НайденныеСБЕ - Массив - из строк ДереваЗначений
//
Процедура юум_НайтиСБЕВерхнегоУровня(СтрокиДерева, НайденныеСБЕ)

    Для Каждого СтрокаДерева Из СтрокиДерева Цикл

        Если юум_ЭтоСБЕ(СтрокаДерева) Тогда
            НайденныеСБЕ.Добавить(СтрокаДерева);
        Иначе
            юум_НайтиСБЕВерхнегоУровня(СтрокаДерева.Строки, НайденныеСБЕ);
        КонецЕсли;

    КонецЦикла;

КонецПроцедуры 

// #04.02.01.06
// Вывод областей "Подвал" и "ПустаяСтрока" в табличный документ
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями
Процедура юум_ВывестиПодвалКарточки(ТабличныйДокумент, Макет)

    Область_Подвал = Макет.ПолучитьОбласть("Подвал");
    Область_ПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");

    МассивВыводимыхОбластей = Новый Массив;
    МассивВыводимыхОбластей.Добавить(Область_ПустаяСтрока);
    МассивВыводимыхОбластей.Добавить(Область_Подвал);
	
	Пока ТабличныйДокумент.ПроверитьВывод(МассивВыводимыхОбластей) Цикл              
		ТабличныйДокумент.Вывести(Область_ПустаяСтрока);    
	КонецЦикла;
	ТабличныйДокумент.Вывести(Область_Подвал);

КонецПроцедуры

// #юум {
// #04.02.01.06
// Формирование ПФ "Контрольно-сдаточная карта" 
// Галфинд  Домнышева 2026/11/06
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ЗаказНаПроизводство2_2
//  ОбъектыПечати - СписокЗначений - выходные области документов для печати БСП.
//
// Возвращаемое значение:
//  ТабличныйДокумент - ТабличныйДокумент
Функция юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)

    Макет = УправлениеПечатью.МакетПечатнойФормы(
			"Документ.ЗаказНаПроизводство2_2.юум_ПФ_MXL_КонтрольноСдаточнаяКарта");
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.КлючПараметровПечати = "юум_КонтрольноСдаточнаяКарта";
    ТабличныйДокумент.АвтоМасштаб = Истина;
    ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
    ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;

    Для Каждого Документ Из МассивОбъектов Цикл
         ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
                Документ, "Номер, ТипПроизводственногоПроцесса, Ссылка");

        ДеревоДанных = юум_ПолучитьДеревоЗаказа(Документ, ДанныеДокумента.ТипПроизводственногоПроцесса);

        Если ДеревоДанных = Неопределено Тогда
            ВызватьИсключение "Не удалось получить дерево заказа на производство.";
        КонецЕсли;

       	СБЕВерхнегоУровня = Новый Массив;

        юум_НайтиСБЕВерхнегоУровня(ДеревоДанных.Строки, СБЕВерхнегоУровня);

        Если СБЕВерхнегоУровня.Количество() = 0 Тогда
            ВызватьИсключение
                "В дереве заказа не найдены СБЕ для печати. "
                + "Проверьте параметры построения дерева "
                + "и правило определения СБЕ.";
        КонецЕсли;

        // Разделитель между разными заказами.
        Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;

        ПерваяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;

        ПерваяКарточка = Истина;

        Для Каждого СтрокаСБЕ Из СБЕВерхнегоУровня Цикл

            Если Не ПерваяКарточка Тогда
                ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
            КонецЕсли;

            юум_ВывестиКарточку(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента);
            ПерваяКарточка = Ложь;

        КонецЦикла;

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, ПерваяСтрока, ОбъектыПечати, Документ);
		
	КонецЦикла; 
	
    Возврат ТабличныйДокумент;

КонецФункции
// } #юум

// #юум {
// #04.02.01.06
// Получение дерева разузловки верхнего уровня 
// Галфинд  Домнышева 2026/11/10
//
// Параметры:
//  СсылкаНаДокумент - ДокументСсылка.ЗаказНаПроизводство2_2 - текущий документ
//  ТипПроцесса - ПеречислениеСсылка.ТипыПроизводственныхПроцессов - значение из документа
//
// Возвращаемое значение:
//  ДеревоДанных - ДеревоЗначений
Функция юум_ПолучитьДеревоЗаказа(СсылкаНаДокумент, ТипПроцесса)

    Параметры = юум_ПараметрыЧтенияДереваЗаказа(СсылкаНаДокумент, ТипПроцесса);
    АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);

    Попытка

        Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ПостроитьДеревоЗаказа(Параметры, АдресРезультата);
		ДеревоДанных = ПолучитьИзВременногоХранилища(АдресРезультата);

    Исключение

        УдалитьИзВременногоХранилища(АдресРезультата);
        ВызватьИсключение;

    КонецПопытки;

    УдалитьИзВременногоХранилища(АдресРезультата);

    Возврат ДеревоДанных;

КонецФункции
// } #юум

// #юум {
// #04.02.01.06
// Получение параметров для получения дерева разузловки 
// Галфинд Домнышева 2026/11/09
//
// Параметры:
//  Документ - ДокументСсылка.ЗаказНаПроизводство2_2 - обрабатываемый документ.
//  ТипПроцесса - ПеречислениеСсылка.ТипыПроизводственныхПроцессов - значение из документа
//
// Возвращаемое значение:
//  Параметры - Структура
Функция юум_ПараметрыЧтенияДереваЗаказа(Документ, ТипПроцесса)

	Параметры = Новый Структура;
	Параметры.Вставить("Заказ", Документ);
	Параметры.Вставить("ТипПроцесса", ТипПроцесса);
	Параметры.Вставить("ПоказыватьЭтапы", Ложь);
	Параметры.Вставить("ПоказыватьПеремещения", Ложь);
	Параметры.Вставить("ПоказыватьМатериалы", Ложь);
	Параметры.Вставить("ПоказыватьВыпуски", Ложь);
	Параметры.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	Параметры.Вставить("Этапы", Неопределено);
	Параметры.Вставить("ЭтапыАналитика", Новый  Структура);
		
	Возврат Параметры;
	
КонецФункции

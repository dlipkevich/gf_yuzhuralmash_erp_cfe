// #юум {
// #04.02.2.13. Команда карточки из документа и списка без проведения заказа.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  КомандыПечати - ТаблицаЗначений - команды печати БСП, дополняется новой строкой.
&После("ДобавитьКомандыПечати")
Процедура юум_КГЗДобавитьКомандыПечати(КомандыПечати)

    КомандаПечати = КомандыПечати.Добавить();
    КомандаПечати.Идентификатор = "юум_КарточкаГарантийногоЗаказа";
    КомандаПечати.МенеджерПечати = "Документ.ЗаказНаПроизводство2_2";
    КомандаПечати.Представление = НСтр("ru = 'Карточка гарантийного заказа'");
    КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;

КонецПроцедуры // } #юум

// #юум {
// #04.02.2.13. Дополнение штатной коллекции печати БСП.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - выбранные заказы.
//  ПараметрыПечати - Структура - штатные параметры команды БСП.
//  КоллекцияПечатныхФорм - ТаблицаЗначений - пополняется карточкой.
//  ОбъектыПечати - СписокЗначений - пополняется областями напечатанных заказов.
//  ПараметрыВывода - Структура - штатные параметры вывода БСП.
&После("Печать")
Процедура юум_КГЗПечать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм,
    ОбъектыПечати, ПараметрыВывода)

    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,
        "юум_КарточкаГарантийногоЗаказа") Тогда
        ПечатныйДокумент = юум_КГЗСформироватьКарточки(МассивОбъектов, ОбъектыПечати);
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
            КоллекцияПечатныхФорм, "юум_КарточкаГарантийногоЗаказа",
            НСтр("ru = 'Карточка гарантийного заказа'"), ПечатныйДокумент);
    КонецЕсли;

КонецПроцедуры // } #юум

// #юум {
// #04.02.2.13. Формирование карточек по сохраненным заказам; только чтение ИБ.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - заказы.
//  ОбъектыПечати - СписокЗначений - выходные области документов для БСП.
// Возвращаемое значение:
//  ТабличныйДокумент - карточки выбранных заказов, каждая с новой страницы.
Функция юум_КГЗСформироватьКарточки(Знач МассивОбъектов, ОбъектыПечати) Экспорт

    ИмяМакета = "юум_ПФ_MXL_КарточкаГарантийногоЗаказа";
    Макет = ПолучитьМакет(ИмяМакета);
    ПечатныйДокумент = ПолучитьМакет(ИмяМакета);
    ПечатныйДокумент.Очистить();
    ПечатныйДокумент.АвтоМасштаб = Истина;
    ПечатныйДокумент.ИмяПараметровПечати = "юум_ПараметрыПечатиКарточкаГарантийногоЗаказа";

    ДанныеПечати = юум_КГЗДанныеДляПечати(МассивОбъектов);
    ДанныеПечати.Продукция.Индексы.Добавить("Ссылка");
    ПервыйДокумент = Истина;
    Для Каждого Шапка Из ДанныеПечати.Шапки Цикл
        Если НЕ ПервыйДокумент Тогда
            ПечатныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        ПервыйДокумент = Ложь;
        НомерНачальнойСтроки = ПечатныйДокумент.ВысотаТаблицы + 1;
        ОтборПродукции = Новый Структура("Ссылка", Шапка.Ссылка);
        Продукция = ДанныеПечати.Продукция.НайтиСтроки(ОтборПродукции);
        юум_КГЗВывестиКарточку(ПечатныйДокумент, Макет, Шапка, Продукция);
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
            ПечатныйДокумент, НомерНачальнойСтроки, ОбъектыПечати, Шапка.Ссылка);
    КонецЦикла;

    Возврат ПечатныйДокумент;

КонецФункции // } #юум

// #юум {
// #04.02.2.13. Пакетное чтение шапок и неотмененной продукции всех выбранных заказов.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - выбранные заказы.
// Возвращаемое значение:
//  Структура - Шапки и Продукция типа ТаблицаЗначений; исходные данные печати.
Функция юум_КГЗДанныеДляПечати(Знач Ссылки)

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    Заказы.Ссылка КАК Ссылка,
    |    Заказы.Номер КАК Номер,
    |    Заказы.Дата КАК Дата,
    |    Заказы.Организация.НаименованиеПолное КАК ОрганизацияПолноеНаименование,
    |    Заказы.Организация.Наименование КАК ОрганизацияНаименование,
    |    Заказы.ДатаПотребности КАК ДатаПотребности,
    |    Заказы.ДатаПотребностиУказываетсяВСтроках КАК ДатаПотребностиУказываетсяВСтроках,
    |    ЕСТЬNULL(ОсновныеЗаказы.Номер, """") КАК НомерОсновногоЗаказа,
    |    ЕСТЬNULL(ОсновныеЗаказы.Договор.Наименование, """") КАК ДоговорОсновногоЗаказа,
    |    ЕСТЬNULL(ОсновныеЗаказы.Партнер.Наименование, """") КАК Заказчик,
    |    ЕСТЬNULL(Утверждающий.Должность, """") КАК ДолжностьУтверждающего,
    |    ЕСТЬNULL(ФизлицоУтверждающего.ФИО, """") КАК ФИОУтверждающего,
    |    ЕСТЬNULL(ПодписантКачества.Должность, """") КАК ДолжностьРуководителя,
    |    ЕСТЬNULL(ФизлицоРуководителя.ФИО, """") КАК ФИОРуководителя,
    |    ЕСТЬNULL(ФизлицоИсполнителя.ФИО, """") КАК Исполнитель
    |ИЗ
    |    Документ.ЗаказНаПроизводство2_2 КАК Заказы
    |        ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ОсновныеЗаказы
    |        ПО Заказы.ДокументОснование = ОсновныеЗаказы.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК Утверждающий
    |        ПО Заказы.юум_Утверждающий = Утверждающий.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизлицоУтверждающего
    |        ПО Утверждающий.ФизическоеЛицо = ФизлицоУтверждающего.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК ПодписантКачества
    |        ПО Заказы.юум_РуководительСлужбыКачества = ПодписантКачества.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизлицоРуководителя
    |        ПО ПодписантКачества.ФизическоеЛицо = ФизлицоРуководителя.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОтветственныеЛицаОрганизаций КАК Исполнитель
    |        ПО Заказы.юум_Исполнитель = Исполнитель.Ссылка
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизлицоИсполнителя
    |        ПО Исполнитель.ФизическоеЛицо = ФизлицоИсполнителя.Ссылка
    |ГДЕ
    |    Заказы.Ссылка В (&Ссылки)
    |УПОРЯДОЧИТЬ ПО
    |    Заказы.Дата,
    |    Заказы.Номер
    |;
    |
    |ВЫБРАТЬ
    |    Продукция.Ссылка КАК Ссылка,
    |    Продукция.НомерСтроки КАК НомерСтроки,
    |    ВЫБОР
    |        КОГДА Продукция.Номенклатура.НаименованиеПолное = """"
    |            ТОГДА Продукция.Номенклатура.Наименование
    |        ИНАЧЕ Продукция.Номенклатура.НаименованиеПолное
    |    КОНЕЦ КАК НаименованиеИзделия,
    |    Продукция.Номенклатура.Код КАК НомерЧертежа,
    |    Продукция.Количество КАК Количество,
    |    Продукция.Номенклатура.ВесЧислитель КАК ВесШтуки,
    |    Продукция.Номенклатура.ВесЧислитель * Продукция.Количество КАК ВесОбщий,
    |    Продукция.ДатаПотребности КАК ДатаПотребности,
    |    Продукция.Ссылка.Комментарий КАК Примечание
    |ИЗ
    |    Документ.ЗаказНаПроизводство2_2.Продукция КАК Продукция
    |ГДЕ
    |    Продукция.Ссылка В (&Ссылки)
    |    И НЕ Продукция.Отменено
    |УПОРЯДОЧИТЬ ПО
    |    Продукция.Ссылка,
    |    Продукция.НомерСтроки";
    Запрос.УстановитьПараметр("Ссылки", Ссылки);
    Результаты = Запрос.ВыполнитьПакет();
    ДанныеПечати = Новый Структура;
    ДанныеПечати.Вставить("Шапки", Результаты[0].Выгрузить());
    ДанныеПечати.Вставить("Продукция", Результаты[1].Выгрузить());

    Возврат ДанныеПечати;

КонецФункции // } #юум

// #юум {
// #04.02.2.13. Вывод областей одной карточки; оформление находится в MXL-макете.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  ПечатныйДокумент - ТабличныйДокумент - пополняемый результат печати.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  Шапка - СтрокаТаблицыЗначений - шапка выбранного заказа.
//  Продукция - Массив из СтрокаТаблицыЗначений - неотмененные строки заказа.
Процедура юум_КГЗВывестиКарточку(ПечатныйДокумент, Макет, Шапка, Продукция)

    ПараметрыКарточки = юум_КГЗПараметрыКарточки(Шапка, Продукция);
    ИменаОбластей = СтрРазделить("Организация,Утверждение,Заголовок,Реквизиты,ШапкаТаблицы", ",");
    Для Каждого ИмяОбласти Из ИменаОбластей Цикл
        Область = Макет.ПолучитьОбласть(ИмяОбласти);
        Область.Параметры.Заполнить(ПараметрыКарточки);
        ПечатныйДокумент.Вывести(Область);
    КонецЦикла;

    НомерСтроки = 0;
    ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаТаблицы");
    Для Каждого СтрокаПродукции Из Продукция Цикл
        НомерСтроки = НомерСтроки + 1;
        ОбластьСтроки.Параметры.Заполнить(СтрокаПродукции);
        ОбластьСтроки.Параметры.НомерСтроки = НомерСтроки;
        ПечатныйДокумент.Вывести(ОбластьСтроки);
    КонецЦикла;

    Подвал = Макет.ПолучитьОбласть("Подвал");
    Подвал.Параметры.Заполнить(ПараметрыКарточки);
    ПечатныйДокумент.Вывести(Подвал);

КонецПроцедуры // } #юум

// #юум {
// #04.02.2.13. Параметры представления одной карточки, без записи и повторного чтения ИБ.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  Шапка - СтрокаТаблицыЗначений - поля шапки заказа и существующего прямого основания.
//  Продукция - Массив из СтрокаТаблицыЗначений - неотмененные строки заказа.
// Возвращаемое значение:
//  Структура - текстовые параметры шапки, срок исполнения и подписи для MXL.
Функция юум_КГЗПараметрыКарточки(Шапка, Продукция)

    ОсновнойЗаказ = СокрЛП(Шапка.НомерОсновногоЗаказа);
    Если ЗначениеЗаполнено(Шапка.ДоговорОсновногоЗаказа) Тогда
        ОсновнойЗаказ = ОсновнойЗаказ + " (договор " + Шапка.ДоговорОсновногоЗаказа + ")";
    КонецЕсли;
    СрокИсполнения = юум_КГЗСрокИсполнения(Шапка.ДатаПотребности,
        Шапка.ДатаПотребностиУказываетсяВСтроках, Продукция);
    ПолноеНаименование = СокрЛП(Шапка.ОрганизацияПолноеНаименование);
    КраткоеНаименование = СокрЛП(Шапка.ОрганизацияНаименование);
    Если НЕ ЗначениеЗаполнено(ПолноеНаименование) Тогда
        ПолноеНаименование = КраткоеНаименование;
    КонецЕсли;
    Если НРег(КраткоеНаименование) = НРег(ПолноеНаименование) Тогда
        КраткоеНаименование = "";
    КонецЕсли;
    Если ЗначениеЗаполнено(КраткоеНаименование) Тогда
        КраткоеНаименование = "(" + КраткоеНаименование + ")";
    КонецЕсли;
    ДолжностьРуководителя = СокрЛП(Шапка.ДолжностьРуководителя);
    Если НРег(ДолжностьРуководителя) = "руководитель службы качества" Тогда
        ДолжностьРуководителя = "";
    КонецЕсли;
    ПараметрыКарточки = Новый Структура;
    ПараметрыКарточки.Вставить("ОрганизацияПолноеНаименование", ПолноеНаименование);
    ПараметрыКарточки.Вставить("ОрганизацияНаименование", КраткоеНаименование);
    ПараметрыКарточки.Вставить("Номер", СокрЛП(Шапка.Номер));
    ПараметрыКарточки.Вставить("Дата", Формат(Шапка.Дата, "ДФ=dd.MM.yyyy"));
    ПараметрыКарточки.Вставить("Год", Формат(Шапка.Дата, "ДФ=yyyy"));
    ПараметрыКарточки.Вставить("ОсновнойЗаказ", ОсновнойЗаказ);
    ПараметрыКарточки.Вставить("Заказчик", Шапка.Заказчик);
    ПараметрыКарточки.Вставить("СрокИсполнения", СрокИсполнения);
    ПараметрыКарточки.Вставить("ДолжностьУтверждающего", Шапка.ДолжностьУтверждающего);
    ПараметрыКарточки.Вставить("ФИОУтверждающего", Шапка.ФИОУтверждающего);
    ПараметрыКарточки.Вставить("ДолжностьРуководителя", ДолжностьРуководителя);
    ПараметрыКарточки.Вставить("ФИОРуководителя", Шапка.ФИОРуководителя);
    ПараметрыКарточки.Вставить("Исполнитель", Шапка.Исполнитель);

    Возврат ПараметрыКарточки;

КонецФункции // } #юум

// #юум {
// #04.02.2.13. Уникальные месяцы срока исполнения через запятую в порядке строк.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  ДатаШапки - Дата - желаемая дата выпуска из шапки.
//  ДатыВСтроках - Булево - типовой признак задания сроков по строкам.
//  Продукция - Массив из СтрокаТаблицыЗначений - неотмененные строки с датами.
// Возвращаемое значение:
//  Строка - месяцы и годы без повторов; пустая строка при отсутствии дат.
Функция юум_КГЗСрокИсполнения(Знач ДатаШапки, Знач ДатыВСтроках, Продукция)

    Месяцы = Новый Массив;
    Если ДатыВСтроках Тогда
        Для Каждого СтрокаПродукции Из Продукция Цикл
            МесяцСтрокой = юум_КГЗМесяцСтрокой(СтрокаПродукции.ДатаПотребности);
            Если ЗначениеЗаполнено(МесяцСтрокой) И Месяцы.Найти(МесяцСтрокой) = Неопределено Тогда
                Месяцы.Добавить(МесяцСтрокой);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Месяцы.Количество() = 0 Тогда
        Месяцы.Добавить(юум_КГЗМесяцСтрокой(ДатаШапки));
    КонецЕсли;

    Возврат СтрСоединить(Месяцы, ", ");

КонецФункции // } #юум

// #юум {
// #04.02.2.13. Месяц и год даты в формате образца.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  ЗначениеДаты - Дата - дата потребности.
// Возвращаемое значение:
//  Строка - месяц и год либо пустая строка для незаполненной даты.
Функция юум_КГЗМесяцСтрокой(Знач ЗначениеДаты)

    Если НЕ ЗначениеЗаполнено(ЗначениеДаты) Тогда
        Возврат "";
    КонецЕсли;

    Возврат НРег(Формат(ЗначениеДаты, "ДФ='MMMM yyyy';Л=ru_RU")) + "г.";

КонецФункции // } #юум

// #юум {
// #04.02.01.06 
// Добавление формирования новой ПФ
// Галфинд Домнышева 2026/11/06 
&После("Печать")
Процедура юум_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	ИмяМакета = "юум_КонтрольноСдаточнаяКарта";
	Представление = НСтр("ru = 'Контрольно-сдаточная карта'");
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
		ПечатныйДокумент = юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати);
    	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, Представление, 
						ПечатныйДокумент);

	КонецЕсли;
	    
КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Формирование ПФ "Контрольно-сдаточная карта" 
// Галфинд  Домнышева 2026/11/06
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ЗаказНаПроизводство2_2
//  ОбъектыПечати - СписокЗначений - выходные области документов для печати БСП.
//
// Возвращаемое значение:
//  ТабличныйДокумент - ТабличныйДокумент
Функция юум_СформироватьПечатнуюФорму(МассивОбъектов, ОбъектыПечати)

    Макет = УправлениеПечатью.МакетПечатнойФормы(
			"Документ.ЗаказНаПроизводство2_2.юум_ПФ_MXL_КонтрольноСдаточнаяКарта");
    ТабличныйДокумент = Новый ТабличныйДокумент;
    ТабличныйДокумент.КлючПараметровПечати = "юум_КонтрольноСдаточнаяКарта";
    ТабличныйДокумент.АвтоМасштаб = Истина;
    ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
    ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;

    Для Каждого Документ Из МассивОбъектов Цикл
         ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
                Документ, "Номер, ТипПроизводственногоПроцесса, Ссылка");

        ДеревоДанных = юум_ПолучитьДеревоЗаказа(Документ, ДанныеДокумента.ТипПроизводственногоПроцесса);

        Если ДеревоДанных = Неопределено Тогда
            ВызватьИсключение "Не удалось получить дерево заказа на производство.";
        КонецЕсли;

       	СБЕВерхнегоУровня = Новый Массив;

        юум_НайтиСБЕВерхнегоУровня(ДеревоДанных.Строки, СБЕВерхнегоУровня);

        Если СБЕВерхнегоУровня.Количество() = 0 Тогда
            ВызватьИсключение
                "В дереве заказа не найдены СБЕ для печати. "
                + "Проверьте параметры построения дерева "
                + "и правило определения СБЕ.";
        КонецЕсли;

        // Разделитель между разными заказами.
        Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
            ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;

        ПерваяСтрока = ТабличныйДокумент.ВысотаТаблицы + 1;

        ПерваяКарточка = Истина;

        Для Каждого СтрокаСБЕ Из СБЕВерхнегоУровня Цикл

            Если Не ПерваяКарточка Тогда
                ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
            КонецЕсли;

            юум_ВывестиКарточку(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента);
            ПерваяКарточка = Ложь;

        КонецЦикла;

		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, ПерваяСтрока, ОбъектыПечати, Документ);
		
	КонецЦикла; 
	
    Возврат ТабличныйДокумент;

КонецФункции
// } #юум


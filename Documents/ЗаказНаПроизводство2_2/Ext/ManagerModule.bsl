// #юум {
// #04.02.01.06
// Вывод карточки СБЕ входящего в заказ 
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СтрокаСБЕ - СтрокаДереваЗначений - текущая строка полученного дерева.
//  ДанныеДокумента - Структура - данные из шапки обрабатываемого документа.
Процедура юум_ВывестиКарточку(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента)
	
	Область_Шапка					= Макет.ПолучитьОбласть("Шапка");
	Область_ШапкаТаблицы			= Макет.ПолучитьОбласть("ШапкаТаблицы");
	Область_СтрокаТаблицы			= Макет.ПолучитьОбласть("СтрокаТаблицы");
	Область_Подвал   				= Макет.ПолучитьОбласть("Подвал"); 
	Область_ПустаяСтрока			= Макет.ПолучитьОбласть("ПустаяСтрока");
	
	МассивВыводимыхОбластей 		= Новый Массив;
	
	ДанныеНоменклатуры = юум_ПолучитьДанныеНоменклатуры(СтрокаСБЕ.Номенклатура);

    Область_Шапка.Параметры.Заполнить(ДанныеНоменклатуры);
    Область_Шапка.Параметры.НомерЗаказа = ДанныеДокумента.Номер;

    ТабличныйДокумент.Вывести(Область_Шапка);
    ТабличныйДокумент.Вывести(Область_ШапкаТаблицы);
	
	юум_ВывестиПервыйСоставСБЕ(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента);
    юум_ВывестиСоставСБЕРекурсивно(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента, Истина);

	юум_ВывестиПодвалКарточки(ТабличныйДокумент, Макет);
	
КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Вывод строк в ПФ для СБЕ и ДЛ входящих в состав верхнего уровня
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СтрокаСБЕ - СтрокаДереваЗначений - текущая строка полученного дерева.
//  ДанныеДокумента - Структура - данные из шапки обрабатываемого документа.
Процедура юум_ВывестиПервыйСоставСБЕ(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента)
	
	// Первый проход:
    // печатаем весь непосредственный состав текущей СБЕ.
    Для Каждого СтрокаСостава Из СтрокаСБЕ.Строки Цикл

        Если Не ЗначениеЗаполнено(
                СтрокаСостава.Номенклатура) Тогда
            Продолжить;
        КонецЕсли;

        юум_ВывестиСтрокуНоменклатуры(ТабличныйДокумент, Макет, СтрокаСостава);

	КонецЦикла;
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
	
КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Вывод состава СБЕ и ДЛ в ПФ
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СтрокаСБЕ - СтрокаДереваЗначений - текущая строка полученного дерева.
//  ДанныеДокумента - Структура - данные из шапки обрабатываемого документа.
//  ПервыйПроход - Булево - признак для установки пустой строки.
Процедура юум_ВывестиСоставСБЕРекурсивно(ТабличныйДокумент, Макет, СтрокаСБЕ, ДанныеДокумента, ПервыйПроход)

    // раскрываем вложенные СБЕ отдельными блоками.
    Для Каждого СтрокаСостава Из СтрокаСБЕ.Строки Цикл
		
		юум_ВывестиСтрокуНоменклатуры(ТабличныйДокумент, Макет, СтрокаСостава);
		
		Если СтрокаСостава.Строки.Количество() > 0 Тогда
			
			юум_ВывестиСоставСБЕРекурсивно(ТабличныйДокумент, Макет, СтрокаСостава, ДанныеДокумента, Ложь);
		КонецЕсли;
		
		Если юум_ЭтоСлужебнаяСтрока(СтрокаСостава) Тогда
			
			ПараметрыЧтения = юум_ПараметрыЧтенияДереваЗаказа(ДанныеДокумента.Ссылка, 
										ДанныеДокумента.ТипПроизводственногоПроцесса);
			
			КлючиПартий = Новый Массив;
			КлючиПартий.Добавить(СтрокаСостава.КлючПартия);
			
			Результат = Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ДеревоПолуфабрикатов(
                    ДанныеДокумента.Ссылка,
                    КлючиПартий,
                    СтрокаСостава.ЭтапСсылка,
                    ПараметрыЧтения,
                    Справочники.Назначения.ПустаяСсылка());

			юум_ВывестиСоставДЛВерхний(ТабличныйДокумент, Макет, Результат, ДанныеДокумента); 
			
		КонецЕсли; 
		
		Если ПервыйПроход Тогда	
			ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
			ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		КонецЕсли; 
		
    КонецЦикла;

КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Вывод состава полуфабрикатов верхнего уровня в ПФ
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СтрокаДЛ - СтрокаДереваЗначений - текущая строка дерева полуфабриката.
//  ДанныеДокумента - Структура - данные из шапки обрабатываемого документа.
Процедура юум_ВывестиСоставДЛВерхний(ТабличныйДокумент, Макет, СтрокаДЛ, ДанныеДокумента)

    Для Каждого СтрокаСостава Из СтрокаДЛ.Строки Цикл

        юум_ВывестиСтрокуНоменклатуры(ТабличныйДокумент, Макет, СтрокаСостава);

    КонецЦикла;

КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Заполнение области "СтрокаТаблицы" ПФ данными Номенклатуры
// Галфинд Домнышева 2026/11/10
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - выходной документ.
//  Макет - ТабличныйДокумент - макет с именованными областями.
//  СтрокаДерева - СтрокаДереваЗначений - текущая строка дерева.
Процедура юум_ВывестиСтрокуНоменклатуры(ТабличныйДокумент, Макет, СтрокаДерева)

    ОбластьСтрока =  Макет.ПолучитьОбласть("СтрокаТаблицы");

    ДанныеНоменклатуры = юум_ПолучитьДанныеНоменклатуры(СтрокаДерева.Номенклатура);
	
	Если ДанныеНоменклатуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    ОбластьСтрока.Параметры.Заполнить(ДанныеНоменклатуры);

    ТабличныйДокумент.Вывести(ОбластьСтрока);

КонецПроцедуры
// } #юум

// #юум {
// #04.02.01.06
// Получение данных по Ссылке на Справочник.Номенклатура
// Галфинд Домнышева 2026/11/10
// 
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
//
// Возвращаемое значение:
//  ДанныеНоменклатуры - Неопределено, Структура - если данные получены то заполненная струтктура
Функция юум_ПолучитьДанныеНоменклатуры(Номенклатура)

    ДанныеНоменклатуры = Неопределено;

    Если ЗначениеЗаполнено(Номенклатура) Тогда

        ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование, Код");

    КонецЕсли;

    Возврат ДанныеНоменклатуры;

КонецФункции

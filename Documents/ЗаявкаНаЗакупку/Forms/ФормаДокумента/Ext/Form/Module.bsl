#Область СлужебныеПроцедурыИФункции

// #юум {
// #ЧТЗ 04.02/1 Производственый учет 04.02.01/03.01.01 АРМ «Материальная укомплектованность заказов»
// Галфинд Садомцев 2026/11/16
&НаСервере
Процедура юум_ДоработатьФормуНаСервере()

	//// Создаем новые реквизиты
	//ДобавляемыеРеквизиты = Новый Массив; // Определяем массив добавляемых реквизитов
	//
	//НовыйРеквизит = Новый РеквизитФормы("юум_ЗОЗ", Новый ОписаниеТипов("Булево"), , );
	//ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);	
	//
	//ИзменитьРеквизиты(ДобавляемыеРеквизиты); // Применяем реквизиты
	
	// Создаем новые поля
	НовыйЭлемент = Элементы.Добавить("юум_ЗОЗ", Тип("ПолеФормы"), Элементы.ГруппаОсновное);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным = "Объект.юум_ЗОЗ";
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "юум_ЗОЗПриИзменении");
	
	Колонка = Элементы.Добавить("юум_КодСтрокиПотребности", Тип("ПолеФормы"), Элементы.Товары);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.Товары.юум_КодСтрокиПотребности";
	Колонка.ТолькоПросмотр = Истина;
	
	НовыйЭлемент = Элементы.Добавить("юум_СтраницаПотребностьЗОЗ",Тип("ГруппаФормы"),Элементы.ГруппаСтраницы);
    НовыйЭлемент.Вид = ВидГруппыФормы.Страница;
	НовыйЭлемент.Видимость = Объект.юум_ЗОЗ;
	юум_УстановитьЗаголовокСтраницы();
        
	ТабЧасть = Элементы.Добавить("юум_ПотребностьЗОЗ", Тип("ТаблицаФормы"), Элементы.юум_СтраницаПотребностьЗОЗ);
	ТабЧасть.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ";

	// запретим менять положение строк и сами строки, отключим командную панель
	ТабЧасть.ИзменятьСоставСтрок = Ложь;
	ТабЧасть.ИзменятьПорядокСтрок = Ложь;
	ТабЧасть.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ТабЧасть.ТолькоПросмотр = Истина;

	Колонка = Элементы.Добавить("юум_НомерСтроки", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.НомерСтроки";
	Колонка.Заголовок = "N";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Номенклатура", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Номенклатура";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Характеристика", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Характеристика";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Назначение", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Назначение";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Количество", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Количество";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Упаковка", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Упаковка";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_КоличествоУпаковок", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.КоличествоУпаковок";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_Комментарий", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.Комментарий";
	Колонка.Высота = 1;

	Колонка = Элементы.Добавить("юум_ПроведенаЗамена", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеФлажка;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.ПроведенаЗамена";

	Колонка = Элементы.Добавить("юум_КодСтроки", Тип("ПолеФормы"), ТабЧасть);
	Колонка.Вид = ВидПоляФормы.ПолеВвода;
	Колонка.ПутьКДанным = "Объект.юум_ПотребностьЗОЗ.КодСтроки";
	Колонка.Высота = 1;

	юум_УстановитьУсловноеОформлениеХарактеристикНоменклатуры(ЭтотОбъект,
		"юум_Характеристика",
		"Объект.юум_ПотребностьЗОЗ.Характеристика");
	
КонецПроцедуры // } #юум

Процедура юум_УстановитьУсловноеОформлениеХарактеристикНоменклатуры(Форма,
	                                                            ИмяПоляВводаХарактеристики = "ТоварыХарактеристика",
																ПутьКПолюОтбора = "Объект.Товары.ХарактеристикиИспользуются") Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		Возврат;
	КонецЕсли;
																
	ЭлементыФормы = Форма.Элементы;
	
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
	ПолеФормы    = ЭлементыФормы[ИмяПоляВводаХарактеристики]; // ПолеФормы
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ПолеФормы.Имя);
	
	ОтборЭлемента = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка");

	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<характеристики не используются>';
																					|en = '<variants are not used>'"));
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура юум_ЗОЗПриИзменении(Элемент)
	
	Элементы.юум_КодСтрокиПотребности.Видимость = Объект.юум_ЗОЗ;
	
	Элементы.юум_СтраницаПотребностьЗОЗ.Видимость = Объект.юум_ЗОЗ;
	
КонецПроцедуры

&НаСервере
Процедура юум_УстановитьЗаголовокСтраницы()
	
	Элементы.юум_СтраницаПотребностьЗОЗ.Заголовок = "Потребность ЗОЗ (" + Формат(Объект.юум_ПотребностьЗОЗ.Количество(), "ЧГ=0") + ")";
	
КонецПроцедуры

&НаСервере
Процедура юум_ПослеЗаписиНаСервереПосле(ТекущийОбъект, ПараметрыЗаписи)
	юум_УстановитьЗаголовокСтраницы();
КонецПроцедуры

#КонецОбласти

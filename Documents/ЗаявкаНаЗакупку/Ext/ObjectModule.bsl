#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

&Перед("ПередЗаписью")
Процедура юум_ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Не юум_ЗОЗ Тогда
		юум_ПотребностьЗОЗ.Очистить();
		Возврат;
	КонецЕсли;
	
	МаксимальныйКодСтрокиПотребности = 0;
	Для Каждого СтрокаТЧ Из Товары Цикл
		Если МаксимальныйКодСтрокиПотребности < СтрокаТЧ.юум_КодСтрокиПотребности Тогда
			МаксимальныйКодСтрокиПотребности = СтрокаТЧ.юум_КодСтрокиПотребности;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТЧ Из Товары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.юум_КодСтрокиПотребности) Тогда
			МаксимальныйКодСтрокиПотребности = МаксимальныйКодСтрокиПотребности + 1;
			СтрокаТЧ.юум_КодСтрокиПотребности = МаксимальныйКодСтрокиПотребности;
		КонецЕсли;
	КонецЦикла;
	
	Если юум_ПотребностьЗОЗ.Количество() > 0 Тогда
		// ТЧ юум_ПотребностьЗОЗ заполняем только при "загрузке" документа
		Возврат;
	КонецЕсли;
	
	ТЧ_ПотребностьЗОЗ_Было = юум_ПотребностьЗОЗ.Выгрузить();
	ТЧ_ПотребностьЗОЗ_Стало = юум_ПотребностьЗОЗ.Выгрузить();
	ТЧ_ПотребностьЗОЗ_Стало.Очистить();
	
	Для Каждого СтрокаТЧ Из Товары Цикл
		СтрокаПотребности = ТЧ_ПотребностьЗОЗ_Стало.Добавить();
		
		СтрокаПотребностиБыло = ТЧ_ПотребностьЗОЗ_Было.Найти(СтрокаТЧ.юум_КодСтрокиПотребности, "КодСтроки");
		Если СтрокаПотребностиБыло = Неопределено Тогда
			// такой строки НЕТ в Потребностях
			ЗаполнитьЗначенияСвойств(СтрокаПотребности, СтрокаТЧ);
			СтрокаПотребности.КодСтроки = СтрокаТЧ.юум_КодСтрокиПотребности;
		Иначе
			// такая строка уже ЕСТЬ в Потребностях
			ЗаполнитьЗначенияСвойств(СтрокаПотребности, СтрокаПотребностиБыло);
			Если СтрокаПотребности.Номенклатура = СтрокаТЧ.Номенклатура
				И СтрокаПотребности.Характеристика = СтрокаТЧ.Характеристика Тогда
				СтрокаПотребности.ПроведенаЗамена = Ложь;
				// перезаполняем строку Потребность данными строки Товары
				ЗаполнитьЗначенияСвойств(СтрокаПотребности, СтрокаТЧ);
			Иначе
				СтрокаПотребности.ПроведенаЗамена = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	юум_ПотребностьЗОЗ.Загрузить(ТЧ_ПотребностьЗОЗ_Стало);
	
КонецПроцедуры

&Вместо("ОбработкаПроверкиЗаполнения")
Процедура юум_ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ПродолжитьВызов(Отказ, ПроверяемыеРеквизиты);
	// здесь надо удалить ВСЕ реквизиты "юум_Потребность..." из Проверяемых реквизитов
	юум_ПроверяемыеРеквизиты = Новый Массив;
	Для Каждого ЭлементМассива Из ПроверяемыеРеквизиты Цикл
		Если СтрНайти(ЭлементМассива, "юум_ПотребностьЗОЗ") > 0 Тогда
			юум_ПроверяемыеРеквизиты.Добавить(ЭлементМассива);
		КонецЕсли;
	КонецЦикла;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, юум_ПроверяемыеРеквизиты);
	Если юум_ЗОЗ Тогда
		// здесь надо добавить некоторые реквизиты "юум_Потребность..." в Проверяемые реквизиты
		юум_ПроверяемыеРеквизиты = Новый Массив;
		Для Каждого ЭлементМассива Из ПроверяемыеРеквизиты Цикл
			Если СтрНайти(ЭлементМассива, "Товары") > 0 Тогда
				юум_ЭлементМассива = СтрЗаменить(ЭлементМассива, "Товары", "юум_ПотребностьЗОЗ");
				юум_ПроверяемыеРеквизиты.Добавить(юум_ЭлементМассива);
			КонецЕсли;
		КонецЦикла;
		Для Каждого юум_ЭлементМассива Из юум_ПроверяемыеРеквизиты Цикл
			ПроверяемыеРеквизиты.Добавить(юум_ЭлементМассива);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

&НаСервере
&После("ПриСозданииНаСервере")
Процедура юум_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ПараметрыПоля = юум_РаботаСФормой.КонструкторПараметрыПоляФормы("юум_ПолеВыполнитьДо", "Объект.юум_ВыполнитьДо", Элементы.ГруппаОсновнаяЛево);
    ПараметрыПоля.Вид = ВидПоляФормы.ПолеВвода;
    ПараметрыПоля.Заголовок = "До";
    ПараметрыПоля.ДополнительныеПараметры.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Лево);
    юум_РаботаСФормой.СоздатьПолеФормыПоПараметрам(ЭтотОбъект, ПараметрыПоля);

КонецПроцедуры

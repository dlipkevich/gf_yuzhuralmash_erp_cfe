#Область ОбработчикиСобытийФормы

// #юум {
// #04.02.01.04
// Инициализация формы выбора всех смен без привязки к подразделению АРМ.
// Галфинд AMotorin 2026/11/18
&НаСервере
&ИзменениеИКонтроль("ПриСозданииНаСервере")
Процедура юум_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Подразделение          = Параметры.Подразделение;
	Участок                = Параметры.Участок;
	Статусы                = Параметры.Статусы;
	ВыбранныеРанееСмены    = Параметры.ВыбранныеРанееСмены;
	МножественныйВыбор     = Параметры.МножественныйВыбор;
	ТолькоВыборСмены       = Параметры.ТолькоВыборСмены;
	СкрыватьДокументы      = Параметры.СкрыватьДокументы;
	#Вставка
    // #юум {
    // #04.02.01.04
    // Выбор всех смен (только для вызова из АРМ без подразделения).
    // Галфинд AMotorin 2026/11/18
    юум_ВыборВсехСмен = НЕ ЗначениеЗаполнено(Подразделение) И ТолькоВыборСмены И СкрыватьДокументы;
    // } #юум
	#КонецВставки
	
	УстановитьПараметрыФункциональныхОпцийФормы(Новый Структура("Подразделение", Подразделение));
	
	Если СкрыватьДокументы Тогда
		ИспользоватьУчастки = Ложь;
	Иначе
		Если Статусы.Количество() = 0 Тогда
			// Доступен выбор документов во всех статусах
			Статусы.Добавить(Перечисления.СтатусыСменныхЗаданий.Формируется);
			Статусы.Добавить(Перечисления.СтатусыСменныхЗаданий.Сформировано);
			Статусы.Добавить(Перечисления.СтатусыСменныхЗаданий.Закрыто);
		КонецЕсли;
		ИспользоватьУчастки = ПолучитьФункциональнуюОпциюФормы("ИспользоватьПроизводственныеУчастки");
	КонецЕсли;
	
	#Удаление
	ПараметрыПодразделения = ПроизводствоСервер.ПараметрыПроизводственногоПодразделения(Подразделение);
	ИспользоватьСмены = ПараметрыПодразделения.ИспользоватьСмены;
	#КонецУдаления
	#Вставка
    // #юум {
    // #04.02.01.04
    // При выборе всех смен подразделение не используется для поиска графика.
    // Галфинд AMotorin 2026/11/18
    Если юум_ВыборВсехСмен Тогда
        ИспользоватьСмены = Истина;
    Иначе
        ПараметрыПодразделения = ПроизводствоСервер.ПараметрыПроизводственногоПодразделения(Подразделение);
        ИспользоватьСмены = ПараметрыПодразделения.ИспользоватьСмены;
    КонецЕсли;
    // } #юум
	#КонецВставки
	
	Элементы.Декорация1.Видимость = ИспользоватьУчастки;
	Если НЕ ИспользоватьУчастки ИЛИ ЕстьУчасткиУПодразделения(Подразделение) Тогда
		Элементы.ГруппаНеСозданыУчастки.Видимость = Ложь;
	Иначе
		Элементы.ГруппаНеСозданыУчастки.Видимость = Истина;
	КонецЕсли;
	Элементы.Представление.Заголовок = ?(ИспользоватьУчастки,
		НСтр("ru = 'Смена, Участок';
			|en = 'Shift, Land'"),
		НСтр("ru = 'Смена';
			|en = 'Shift'"));
	
	ЧислоСтрок = 10;
	#Удаление
	НесколькоСменВПодразделении = ПроизводствоСервер.ГрафикиРаботыПодразделений(Подразделение).Количество() > 1;
	#КонецУдаления
	#Вставка
    // #юум {
    // #04.02.01.04
    // Заголовки разных календарей сохраняем в общем списке.
    // Галфинд AMotorin 2026/11/18
    Если юум_ВыборВсехСмен Тогда
        НесколькоСменВПодразделении = Истина;
    Иначе
        НесколькоСменВПодразделении = ПроизводствоСервер.ГрафикиРаботыПодразделений(Подразделение).Количество() > 1;
    КонецЕсли;
    // } #юум
	#КонецВставки
	
	ИнициализироватьСмены();
	НастроитьЭлементыФормы();
	#Вставка
    // #юум {
    // #04.02.01.04
    // Сохраняем привычную календарную форму без строки подразделения.
    // Галфинд AMotorin 2026/11/18
    Если юум_ВыборВсехСмен Тогда
        Элементы.Подразделение.Видимость = Ложь;
        Элементы.ГруппаУчасток.Видимость = Ложь;
    КонецЕсли;
    // } #юум
	#КонецВставки
	
КонецПроцедуры
// } #юум

#КонецОбласти

#Область СлужебныеПроцедурыИфункции

// #юум {
// #04.02.01.04
// Получение графиков всех подразделений при выборе смены из АРМ.
// Галфинд AMotorin 2026/11/18
&НаСервере
&ИзменениеИКонтроль("ВыбратьСменыЗаПериод")
Функция юум_ВыбратьСменыЗаПериод(Начало, Окончание)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	#Удаление
	Графики = ПроизводствоСервер.ГрафикиРаботыПодразделений(Подразделение).ВыгрузитьКолонку("ГрафикРаботы");
	#КонецУдаления
	#Вставка
    // #юум {
    // #04.02.01.04
    // Собираем календари графиков всех подразделений предприятия.
    // Галфинд AMotorin 2026/11/18
    Если НЕ ЗначениеЗаполнено(Подразделение) И ТолькоВыборСмены И СкрыватьДокументы Тогда

        Графики = Новый Массив;
        ЗапросПодразделений = Новый Запрос;
        ЗапросПодразделений.Текст =
        "ВЫБРАТЬ
        |    СтруктураПредприятия.Ссылка КАК Подразделение
        |ИЗ
        |    Справочник.СтруктураПредприятия КАК СтруктураПредприятия
        |ГДЕ
        |    НЕ СтруктураПредприятия.ПометкаУдаления";

        ВыборкаПодразделений = ЗапросПодразделений.Выполнить().Выбрать(); 
		
        Пока ВыборкаПодразделений.Следующий() Цикл

            ГрафикиПодразделения = ПроизводствоСервер.ГрафикиРаботыПодразделений(ВыборкаПодразделений.Подразделение);

			Для Каждого СтрокаГрафика Из ГрафикиПодразделения Цикл  
				
				Если ЗначениеЗаполнено(СтрокаГрафика.ГрафикРаботы) И Графики.Найти(СтрокаГрафика.ГрафикРаботы) = Неопределено Тогда   
					
                    Графики.Добавить(СтрокаГрафика.ГрафикРаботы);
					
				КонецЕсли;           
				
            КонецЦикла;

        КонецЦикла;

	Иначе       
		
        Графики = ПроизводствоСервер.ГрафикиРаботыПодразделений(Подразделение).ВыгрузитьКолонку("ГрафикРаботы");  
		
    КонецЕсли;
    // } #юум
	#КонецВставки
	
	КалендарныеГрафики.СоздатьВТРасписанияРаботыНаПериод(
		МенеджерВременныхТаблиц, Графики, Начало, Окончание, Ложь);
	
	Если СкрыватьДокументы Тогда
		#Область ТекстЗапросаСкрыватьДокументы
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПроизводственныеУчастки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТУчастки
		|ИЗ
		|	Справочник.ПроизводственныеУчастки КАК ПроизводственныеУчастки
		|ГДЕ
		|	&ИспользоватьУчастки
		|	И ПроизводственныеУчастки.Владелец = &Подразделение
		|	И НЕ ПроизводственныеУчастки.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Расписание.ГрафикРаботы КАК Смена,
		|	МИНИМУМ(ВЫБОР
		|		КОГДА НЕ &ИспользоватьСмены
		|			ТОГДА Расписание.ДатаГрафика
		|		ИНАЧЕ ДОБАВИТЬКДАТЕ(Расписание.ДатаГрафика, МИНУТА, ЧАС(ЕСТЬNULL(Расписание.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1))) * 60 +
		|			МИНУТА(ЕСТЬNULL(Расписание.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1))))
		|	КОНЕЦ) КАК Дата
		|ПОМЕСТИТЬ ВТ_Смены
		|ИЗ
		|	ВТРасписанияРаботы КАК Расписание
		|СГРУППИРОВАТЬ ПО
		|	Расписание.ГрафикРаботы,
		|	Расписание.Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Смены.Смена КАК Смена,
		|	ВТ_Смены.Дата КАК Дата,
		|	ВЫРАЗИТЬ(ВТ_Смены.Смена КАК Справочник.Календари).Представление КАК СменаПредставление,
		|	ЕСТЬNULL(ВТУчастки.Ссылка, ЗНАЧЕНИЕ(Справочник.ПроизводственныеУчастки.ПустаяСсылка)) КАК Участок,
		|	ВТУчастки.Ссылка.Представление КАК УчастокПредставление,
		|	ИСТИНА КАК МожноВыбирать
		|ИЗ
		|	ВТ_Смены КАК ВТ_Смены
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТУчастки КАК ВТУчастки
		|		ПО ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Смена,
		|	Участок";
		#КонецОбласти
	Иначе
		#Область ТекстЗапросаВыборСменИСменногоЗадания
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПроизводственныеУчастки.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТУчастки
		|ИЗ
		|	Справочник.ПроизводственныеУчастки КАК ПроизводственныеУчастки
		|ГДЕ
		|	&ИспользоватьУчастки
		|	И ПроизводственныеУчастки.Владелец = &Подразделение
		|	И НЕ ПроизводственныеУчастки.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Расписание.ГрафикРаботы КАК Смена,
		|	ЕСТЬNULL(ВТУчастки.Ссылка, ЗНАЧЕНИЕ(Справочник.ПроизводственныеУчастки.ПустаяСсылка)) КАК Участок,
		|	МИНИМУМ(
		|		ВЫБОР
		|			КОГДА НЕ &ИспользоватьСмены
		|				ТОГДА Расписание.ДатаГрафика
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(Расписание.ДатаГрафика, МИНУТА,
		|					ЧАС(ЕСТЬNULL(Расписание.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1))) * 60
		|					+ МИНУТА(ЕСТЬNULL(Расписание.ВремяНачала, ДАТАВРЕМЯ(1, 1, 1))))
		|		КОНЕЦ) КАК Начало,
		|	МАКСИМУМ(
		|		ВЫБОР
		|			КОГДА НЕ &ИспользоватьСмены
		|					ИЛИ Расписание.ВремяОкончания ЕСТЬ NULL
		|					ИЛИ Расписание.ВремяОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА КОНЕЦПЕРИОДА(Расписание.ДатаГрафика, ДЕНЬ)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(Расписание.ДатаГрафика, МИНУТА,
		|					ЧАС(Расписание.ВремяОкончания) * 60
		|					+ МИНУТА(Расписание.ВремяОкончания))
		|		КОНЕЦ) КАК Окончание
		|ПОМЕСТИТЬ ВТСмены
		|ИЗ
		|	ВТРасписанияРаботы КАК Расписание
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТУчастки КАК ВТУчастки
		|		ПО (ИСТИНА)
		|ГДЕ
		|	(НЕ &ИспользоватьУчастки
		|		ИЛИ ВТУчастки.Ссылка ЕСТЬ НЕ NULL )
		|
		|СГРУППИРОВАТЬ ПО
		|	Расписание.ГрафикРаботы,
		|	Расписание.Период,
		|	ЕСТЬNULL(ВТУчастки.Ссылка, ЗНАЧЕНИЕ(Справочник.ПроизводственныеУчастки.ПустаяСсылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СменноеЗадание.Ссылка                          КАК Ссылка,
		|	СменноеЗадание.Статус                          КАК Статус,
		|	СменноеЗадание.Дата                            КАК Дата,
		|	СменноеЗадание.Смена                           КАК Смена,
		|	СменноеЗадание.Участок                         КАК Участок,
		|	СменноеЗадание.Ссылка В (&ВыбранныеРанееСмены)
		|		И СменноеЗадание.Статус В (&Статусы)       КАК Выбрана,
		|	СменноеЗадание.Статус В (&Статусы)             КАК МожноВыбирать
		|ПОМЕСТИТЬ ВТЗадания
		|ИЗ
		|	Документ.СменноеЗадание КАК СменноеЗадание
		|ГДЕ
		|	СменноеЗадание.Подразделение = &Подразделение
		|	И СменноеЗадание.Проведен
		|	И СменноеЗадание.Дата МЕЖДУ &Начало И &Окончание
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ                          
		|	ВТСмены.Смена                                                  КАК Смена,
		|	ВЫРАЗИТЬ(ВТСмены.Смена КАК Справочник.Календари).Представление КАК СменаПредставление,
		|	ВТСмены.Начало                                                 КАК Дата,
		|	ВТСмены.Участок                                                КАК Участок,
		|	ВТСмены.Участок.Представление                                  КАК УчастокПредставление,
		|	ВТЗадания.Ссылка                                               КАК СменноеЗадание,
		|	ВТЗадания.Статус                                               КАК СтатусЗадания,
		|	ЕСТЬNULL(ВТЗадания.Выбрана, ЛОЖЬ)                              КАК Выбрана,
		|	ЕСТЬNULL(ВТЗадания.МожноВыбирать, ИСТИНА)                      КАК МожноВыбирать
		|ИЗ
		|	ВТСмены КАК ВТСмены
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЗадания КАК ВТЗадания
		|		ПО ВТСмены.Смена = ВТЗадания.Смена
		|			И ВТСмены.Участок = ВТЗадания.Участок
		|			И ВТЗадания.Дата МЕЖДУ ВТСмены.Начало И ВТСмены.Окончание
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТЗадания.Смена,
		|	ВТЗадания.Смена.Представление,
		|	ВТЗадания.Дата,
		|	ВТЗадания.Участок,
		|	ВТЗадания.Участок.Представление,
		|	ВТЗадания.Ссылка,
		|	ВТЗадания.Статус,
		|	ВТЗадания.Выбрана,
		|	ВТЗадания.МожноВыбирать
		|ИЗ
		|	ВТЗадания КАК ВТЗадания
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСмены КАК ВТСмены
		|		ПО ВТЗадания.Смена = ВТСмены.Смена
		|			И ВТЗадания.Участок = ВТСмены.Участок
		|			И ВТЗадания.Дата МЕЖДУ ВТСмены.Начало И ВТСмены.Окончание
		|ГДЕ
		|	ВТСмены.Смена ЕСТЬ NULL
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Смена,
		|	Участок";
		#КонецОбласти
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	Запрос.УстановитьПараметр("ВыбранныеРанееСмены", ВыбранныеРанееСмены.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("Статусы", Статусы.ВыгрузитьЗначения());
	Запрос.УстановитьПараметр("ИспользоватьУчастки", ИспользоватьУчастки);
	Запрос.УстановитьПараметр("ИспользоватьСмены", ИспользоватьСмены);
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции
// } #юум 

#КонецОбласти


// #юум {
// #04.02.01.04
// Обработка сформированных печатных форм сменного задания.
// Галфинд AMotorin 2026/10/22
&После("Печать")
Процедура юум_ПослеПечатиСменногоЗадания(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)

	Для Каждого ОписаниеПФ Из КоллекцияПечатныхФорм Цикл 
		
		Если ОписаниеПФ.ИмяВРЕГ <> ВРег("СменноеЗадание") Тогда  
			
            Продолжить;         
			
        КонецЕсли;

        ТабДок = ОписаниеПФ.ТабличныйДокумент;
        юум_ПереименоватьЗаголовокНаряда(ТабДок);
        юум_ШтрихкодСПечатаемымКодом(ТабДок, МассивОбъектов[0]);

    КонецЦикла;

КонецПроцедуры
// } #юум    

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

// #юум {
// #04.02.01.04
// Переименование заголовка сменного задания в печатной форме.
// Галфинд AMotorin 2026/10/22
// Параметры:
//   ТабДок - ТабличныйДокумент - Табличный документ печатной формы сменного задания, заголовок которого нужно изменить.
//
Процедура юум_ПереименоватьЗаголовокНаряда(ТабДок)
	
    ОбластьЗаголовка = ТабДок.НайтиТекст("Сменное задание");
    ТекстЗаголовка = ОбластьЗаголовка.Текст;   
	
	Если СтрНайти(ВРег(ТекстЗаголовка), "(НАРЯД)") = 0 Тогда   
			
    	ТекстЗаголовка = СтрЗаменить(ТекстЗаголовка, "Сменное задание", "Сменное задание (наряд)");
        ОбластьЗаголовка.Текст = ТекстЗаголовка;   
			
	КонецЕсли;    
		
КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Формирование изображения штрихкода с числовой подписью.
// Галфинд AMotorin 2026/10/22 
//
// Параметры:
//   ТабличныйДокумент - ТабличныйДокумент - Печатная форма, содержащая рисунки штрихкодов для замены.
//   СсылкаДокумента - ДокументСсылка.СменноеЗадание - Ссылка на документ, по которой формируется числовое значение штрихкода.
//
Процедура юум_ШтрихкодСПечатаемымКодом(ТабличныйДокумент, СсылкаДокумента)

    КодШтрихкода = ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(СсылкаДокумента);
    СтрокаШтрихкода = СтрЗаменить(СокрЛП(Строка(КодШтрихкода)), " ", "");

    Для Каждого Рисунок Из ТабличныйДокумент.Рисунки Цикл

        Параметры = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
        Параметры.Ширина = Макс(240, Окр(Рисунок.Ширина / 0.26454));
        Параметры.Высота = Макс(90, Окр(Рисунок.Высота / 0.26454));
        Параметры.Штрихкод = СтрокаШтрихкода;
        Параметры.ТипКода = ?(СтрДлина(СтрокаШтрихкода) = 13, 1, 4);
        Параметры.ОтображатьТекст = Истина;
        Параметры.РазмерШрифта = 12;
        РезультатГенерации = ГенерацияШтрихкода.ИзображениеШтрихкода(Параметры);
        Рисунок.Картинка = РезультатГенерации.Картинка;

    КонецЦикла;

КонецПроцедуры // } #юум 

&После("ДобавитьКомандыПечати")
Процедура юум_ДобавитьКомандыПечати(КомандыПечати)
	
	// Наряд
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "юум_Наряд";
	КомандаПечати.Представление = НСтр("ru = 'Наряд';
									   |en = 'Production order'");
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 4;

КонецПроцедуры

&Перед("Печать")
Процедура юум_Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "юум_Наряд") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"юум_Наряд",
			НСтр("ru = 'Наряд';
				 |en = 'Production order'"),
			юум_СформироватьПечатнуюФормуНаряд(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;

КонецПроцедуры

Функция юум_СформироватьПечатнуюФормуНаряд(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроизводственнаяОперацияТрудозатраты.Ссылка КАК ПроизводственнаяОперация,
	|	МАКСИМУМ(ПроизводственнаяОперацияТрудозатраты.ВидРабот) КАК ВидРабот
	|ПОМЕСТИТЬ ВтВидыРаботОпераций
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2.Трудозатраты КАК ПроизводственнаяОперацияТрудозатраты
	|ГДЕ
	|	(&ВсеОперации ИЛИ ПроизводственнаяОперацияТрудозатраты.Ссылка В(&ПроизводственныеОперации)) 
	|	И ПроизводственнаяОперацияТрудозатраты.Ссылка.СменноеЗадание В(&СменныеЗадания)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроизводственнаяОперацияТрудозатраты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументСменноеЗадание.Ссылка КАК СменноеЗаданиеСсылка,
	|	ДокументСменноеЗадание.Дата КАК СменноеЗаданиеДата1,
	|	ДокументСменноеЗадание.юум_ВыполнитьДо КАК СменноеЗаданиеДата2,
	|	ДокументПроизводственнаяОперация.Этап КАК ЭтапСсылка,
	|	ДокументПроизводственнаяОперация.Этап.Организация.Наименование КАК ОрганизацияПредставление,
	|	ДокументПроизводственнаяОперация.Этап.Распоряжение.Номер КАК ЗаказНомер,
	|	ДокументПроизводственнаяОперация.Этап.ПартияПроизводства.ОсновноеИзделиеНоменклатура.Код КАК НоменклатураКод,
	|	ДокументПроизводственнаяОперация.Этап.ПартияПроизводства.ОсновноеИзделиеНоменклатура.Наименование КАК НоменклатураНаименование,
	|	ДокументПроизводственнаяОперация.Этап.КоличествоУпаковокПлан КАК ЭтапКоличествоПлан,
	|	ДокументПроизводственнаяОперация.Подразделение.Код КАК ПодразделениеКод,
	|	ДокументПроизводственнаяОперация.Участок КАК Участок,
	|	ДокументПроизводственнаяОперация.НомерОперации КАК НомерОперации,
	|	ДокументПроизводственнаяОперация.РабочийЦентр КАК РабочийЦентр,
	|	ВтВидыРаботОпераций.ВидРабот.КвалификационныйРазряд КАК Разряд,
	|	ВтВидыРаботОпераций.ВидРабот.юум_ШифрРабот КАК ШифрРабот,
	|	ВтВидыРаботОпераций.ВидРабот.юум_КодВидаРабот КАК КодВидаРабот,
	|	ДокументПроизводственнаяОперация.Операция.Наименование КАК ОперацияНаименование,
	|	ДокументПроизводственнаяОперация.Ссылка КАК ПроизводственнаяОперацияСсылка,
	|	ДокументПроизводственнаяОперация.ВремяШтучное КАК ВремяШтучное,
	|	ДокументПроизводственнаяОперация.ВремяПЗ КАК ВремяПЗ,
	|	ДокументПроизводственнаяОперация.ВремяВыполнения КАК ВремяВыполнения,
	|	ВЫБОР
	|		КОГДА ДокументПроизводственнаяОперация.Исполнитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА ДокументПроизводственнаяОперация.Исполнитель.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИсполнительКод,
	|	ВЫБОР
	|		КОГДА ДокументПроизводственнаяОперация.Исполнитель ССЫЛКА Справочник.ФизическиеЛица
	|			ТОГДА ДокументПроизводственнаяОперация.Исполнитель.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИсполнительНаименование
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2 КАК ДокументПроизводственнаяОперация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СменноеЗадание КАК ДокументСменноеЗадание
	|		ПО ДокументПроизводственнаяОперация.СменноеЗадание = ДокументСменноеЗадание.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтВидыРаботОпераций КАК ВтВидыРаботОпераций
	|		ПО ДокументПроизводственнаяОперация.Ссылка = ВтВидыРаботОпераций.ПроизводственнаяОперация
	|ГДЕ
	|	НЕ ДокументПроизводственнаяОперация.ПометкаУдаления
	|	И (&ВсеОперации ИЛИ ДокументПроизводственнаяОперация.Ссылка В(&ПроизводственныеОперации)) 
	|	И ДокументСменноеЗадание.Ссылка В(&СменныеЗадания)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СменноеЗаданиеСсылка,
	|	ЭтапСсылка,
	|	НомерОперации
	|ИТОГИ ПО
	|	СменноеЗаданиеСсылка,
	|	ЭтапСсылка";
	
	СменныеЗадания = Новый Массив;
	ПроизводственныеОперации = Новый Массив;
	
	Для Каждого ДокументСсылка Из МассивОбъектов Цикл
		
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СменноеЗадание") Тогда
			СменныеЗадания.Добавить(ДокументСсылка);
			
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПроизводственнаяОперация2_2") Тогда
			ПроизводственныеОперации.Добавить(ДокументСсылка);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.УстановитьПараметр("СменныеЗадания", СменныеЗадания);
	
	Запрос.УстановитьПараметр("ВсеОперации", Не ЗначениеЗаполнено(ПроизводственныеОперации));
	Запрос.УстановитьПараметр("ПроизводственныеОперации", ПроизводственныеОперации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_СменноеЗаданиеНаряд";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СменноеЗадание.юум_ПФ_MXL_Наряд");
	
	КоличествоСменок = 0;
	ВыборкаСменноеЗадание = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСменноеЗадание.Следующий() Цикл
		
		КоличествоСменок = КоличествоСменок + 1;
		Если КоличествоСменок > 1 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		// Заголовок
		Область = Макет.ПолучитьОбласть("Заголовок");
		Если ЗначениеЗаполнено(ВыборкаСменноеЗадание.СменноеЗаданиеДата2)
			И НачалоДня(ВыборкаСменноеЗадание.СменноеЗаданиеДата2) > НачалоДня(ВыборкаСменноеЗадание.СменноеЗаданиеДата1) Тогда
			
			Область.Параметры.Период = СтрШаблон("с %1 по %2",
				Формат(ВыборкаСменноеЗадание.СменноеЗаданиеДата1, "ДЛФ=D"),
				Формат(ВыборкаСменноеЗадание.СменноеЗаданиеДата2, "ДЛФ=D"));
				
		Иначе
			Область.Параметры.Период = Формат(ВыборкаСменноеЗадание.СменноеЗаданиеДата1, "ДЛФ=D");
		КонецЕсли;
		ТабличныйДокумент.Вывести(Область); 
		
		ВыборкаЭтап = ВыборкаСменноеЗадание.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЭтап.Следующий() Цикл
			
			// ШапкаТаблицы
			Область = Макет.ПолучитьОбласть("ШапкаТаблицы");
			Область.Параметры.Заполнить(ВыборкаЭтап);
			
			ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, Область, ВыборкаСменноеЗадание.СменноеЗаданиеСсылка);
				
			ТабличныйДокумент.Вывести(Область); 
	
			ВыборкаОперация = ВыборкаЭтап.Выбрать();
			Пока ВыборкаОперация.Следующий() Цикл
				
				// СтрокаТаблицы
				Область = Макет.ПолучитьОбласть("СтрокаТаблицы");
				Область.Параметры.Заполнить(ВыборкаОперация);
				
				ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, Область, ВыборкаОперация.ПроизводственнаяОперацияСсылка, "КартинкаШтрихкодаОперации");
					
				ТабличныйДокумент.Вывести(Область);
				
			КонецЦикла;
			
		КонецЦикла;
		
		// Подвал
		Область = Макет.ПолучитьОбласть("Подвал");
		ТабличныйДокумент.Вывести(Область);
		
	КонецЦикла;	
	
	Если ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
		
	Возврат ТабличныйДокумент;
		
КонецФункции

Процедура ВывестиШтрихкодВТабличныйДокумент(ТабличныйДокумент, Макет, Знач ОбластьМакета, Ссылка, ИмяКартинки = "КартинкаШтрихкода")
	
	УстановитьПривилегированныйРежим(Истина);
	
	РисунокДляКартинки = Неопределено;
	Для Каждого РисунокОбласти Из ОбластьМакета.Рисунки Цикл
		Если РисунокОбласти.Имя = ИмяКартинки Тогда
			РисунокДляКартинки = РисунокОбласти;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если РисунокДляКартинки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьШтрихкодированиеПечатныхФормОбъектов") Тогда
		ОбластьМакета.Рисунки.Удалить(РисунокДляКартинки);
		Возврат;
	КонецЕсли;
	
	Эталон = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет("Эталон");
	РисунокКвадрат = Эталон.Рисунки.Квадрат100Пикселей; // РисунокТабличногоДокумента
	КоличествоМиллиметровВПикселе = РисунокКвадрат.Высота / 100;
	
	ПараметрыШтрихкода = ГенерацияШтрихкода.ПараметрыГенерацииШтрихкода();
	ПараметрыШтрихкода.Ширина           = Окр(РисунокДляКартинки.Ширина / КоличествоМиллиметровВПикселе);
	ПараметрыШтрихкода.Высота           = Окр(РисунокДляКартинки.Высота / КоличествоМиллиметровВПикселе);
	ПараметрыШтрихкода.Штрихкод         = СокрЛП(ШтрихкодированиеПечатныхФорм.ЧисловойКодПоСсылке(Ссылка));
	ПараметрыШтрихкода.ТипВходныхДанных = 0; // Штрихкод - это строка
	ПараметрыШтрихкода.ТипКода          = 4; // Code128
	ПараметрыШтрихкода.ОтображатьТекст  = Истина; // Ложь
	ПараметрыШтрихкода.РазмерШрифта     = 8; // 6
	ПараметрыШтрихкода.Масштабировать   = Истина;
	ПараметрыШтрихкода.НовыйВызовКомпоненты = Ложь;
	
	РезультатГенерацииШтрихкода = ГенерацияШтрихкода.ИзображениеШтрихкода(ПараметрыШтрихкода);
	Если НЕ РезультатГенерацииШтрихкода.Результат Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'При генерации картинки штрихкода произошла ошибка';
													|en = 'Error generating barcode image'"));
	КонецЕсли;
	
	Если РезультатГенерацииШтрихкода.Картинка <> Неопределено Тогда
		РисунокДляКартинки.Картинка = РезультатГенерацииШтрихкода.Картинка;
	КонецЕсли;
	
КонецПроцедуры

Функция ЕстьКартинкаШтрихкодаВОбластиМакета(ОбластьМакета, ИмяКартинки = "КартинкаШтрихкода")
	
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить(ИмяКартинки, Новый УникальныйИдентификатор);
	СтароеЗначение = СтруктураПоиска[ИмяКартинки];
	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, ОбластьМакета.Рисунки);
	
	Возврат Не СтруктураПоиска[ИмяКартинки] = СтароеЗначение;
	
КонецФункции

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьДеревоЗаказа(Команда)
	СохранитьДеревоЗаказаНаСервере(); 
	Сообщить("Готово");
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура СохранитьДеревоЗаказаНаСервере()
	МассивЗаказов = СписокЗаказов.ВыгрузитьЗначения(); 
	Если МассивЗаказов.Количество() = 0 Тогда
		МассивЗаказов = Неопределено;
	КонецЕсли; 
	юум_ДеревоЗаказа.СохранитьДеревоЗаказа(МассивЗаказов);
КонецПроцедуры
#КонецОбласти


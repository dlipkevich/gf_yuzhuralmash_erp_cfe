		|	
		|	ВЫБОР КОГДА Товары.Склад ССЫЛКА Справочник.СтруктураПредприятия ТОГДА
		|				Товары.Склад
		|			ИНАЧЕ
		|				ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|		КОНЕЦ КАК ПодразделениеПолучатель,
		|	
		|	Товары.Назначение                                      КАК Назначение,
		|	Товары.ЗаказНаОтгрузку                                 КАК Заказ,
		|	Товары.ЖелаемаяДатаОтгрузки                            КАК ДатаОтгрузки,
		|	
		|	ВЫБОР
		|		КОГДА Товары.СостояниеЗапаса = ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен)
		|			ТОГДА Товары.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК НеОбеспечено,
		|	
		|	ВЫБОР
		|		КОГДА Товары.СостояниеЗапаса В(
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ВНаличии),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ВНаличииОжидаетсяРазблокировка),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлению),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.ОжидаетсяКПоступлениюСБлокировкой),
		|				ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НаСогласованииПоставки))
		|			ТОГДА Товары.Количество
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Распределено,
		|	
		|	Товары.СостояниеЗапаса КАК СостояниеЗапаса,
// ++ НЕ УТКА
		|	НЕОПРЕДЕЛЕНО                                           КАК КлючПартия,
// -- НЕ УТКА
		|	СпрСпособ.Ссылка                                       КАК СпособОбеспечения
		|ПОМЕСТИТЬ ПотребностиВсехСкладовПоЗаказам
		|ИЗ
		|	РегистрСведений.РаспределениеЗапасов КАК Товары
		|
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпрСпособ
		|		ПО &ПодстановкаОсновногоСпособаОбеспечения
		|
		|ГДЕ
		|	Товары.ХарактеристикаПотребности В(
		|		ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.РезервироватьПоМереПоступления),
		|		ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.ОтложитьРезервирование),
		|		ЗНАЧЕНИЕ(Перечисление.ХарактеристикиПотребности.КОбеспечению))
		|
		// отборы компоновщика
		|{ГДЕ
		|	Товары.Номенклатура.*                             КАК Номенклатура,
		|	Товары.Характеристика.*                           КАК Характеристика,
		|	Товары.Назначение.*                               КАК Назначение,
		|	ВЫРАЗИТЬ(
		|		ВЫБОР
		|			КОГДА Товары.Склад ССЫЛКА Справочник.СтруктураПредприятия
		|				ТОГДА Товары.Склад
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.Пустаяссылка)
		|		КОНЕЦ КАК Справочник.СтруктураПредприятия).* КАК ПодразделениеПолучатель}
		|
		|{ГДЕ Товары.ЗаказНаОтгрузку В(
		|	ВЫБРАТЬ
		|		ТаблицаОтбора.Заказ КАК Заказ
		|	ИЗ
		|		ОтборПоЗаказам КАК ТаблицаОтбора
		|	ГДЕ
		|		&ИспользуетсяОтборПоЗаказам)}
		|
		|{ГДЕ (Товары.Номенклатура, Товары.Характеристика) В(
		|	ВЫБРАТЬ
		|		ТаблицаОтбора.Номенклатура   КАК Номенклатура,
		|		ТаблицаОтбора.Характеристика КАК Характеристика
		|	ИЗ
		|		ОтборПоСегментам КАК ТаблицаОтбора
		|	ГДЕ
		|		&ИспользуетсяОтборПоСегментуНоменклатуры)}
// ++ НЕ УТКА

		// Потребности по заказам на производство
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Товары.Номенклатура                                           КАК Номенклатура,
		|	Товары.Характеристика                                         КАК Характеристика,
		|	
		|	ВЫБОР КОГДА Товары.Склад ССЫЛКА Справочник.Склады ТОГДА
		|				Товары.Склад
		|			ИНАЧЕ
		|				ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|		КОНЕЦ КАК Склад,
		|	
		|	ВЫБОР КОГДА Товары.Склад ССЫЛКА Справочник.СтруктураПредприятия ТОГДА
		|				Товары.Склад
		|			ИНАЧЕ
		|				ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		|		КОНЕЦ КАК ПодразделениеПолучатель,
		|	
		|	Товары.Назначение                                               КАК Назначение,
		|	Товары.ЗаказНаПроизводство                                      КАК Заказ,
		|	Товары.ЖелаемаяДатаОтгрузки                                     КАК ДатаОтгрузки,
		|	Товары.Количество                                               КАК НеОбеспечено,
		|	0                                                               КАК Распределено,
		|	ЗНАЧЕНИЕ(Перечисление.СостоянияЗапаса.НеОбеспечен)              КАК СостояниеЗапаса,
		|	Товары.КлючПартия                                               КАК КлючПартия,
		|	Товары.СпособОбеспечения                                        КАК СпособОбеспечения
		|ИЗ
		|	(ВЫБРАТЬ
		|
		|		Товары.Номенклатура        КАК Номенклатура,
		|		Товары.Характеристика      КАК Характеристика,
		|		Товары.Склад               КАК Склад,
		|		Товары.Назначение          КАК Назначение,
		|		Товары.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|		Товары.КлючНоменклатура    КАК КлючНоменклатура,
		|
		|		СпрСпособ.Ссылка КАК СпособОбеспечения,
		|
		|		МИНИМУМ(ВЫБОР
		|				КОГДА Товары.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)
		|					ТОГДА Товары.КлючПартия
		|			КОНЕЦ) КАК КлючПартия,
		|		МИНИМУМ(ISNULL(ДатыГрафика.Начало, Товары.ЗаказНаПроизводство.НачатьНеРанее)) КАК ЖелаемаяДатаОтгрузки,
		|
		|		СУММА(Товары.КОбеспечению - Товары.Заменено - Товары.РаспределеноИзЗапасовОбособленно - Товары.РаспределеноИзПартийОбособленно) КАК Количество
		|
		|	ИЗ
		|		РегистрСведений.СтруктураЗаказа КАК Товары
		|
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпрСпособ
		|			ПО &ПодстановкаОсновногоСпособаОбеспечения
		|
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК ДатыГрафика
		|			ПО Товары.ЗаказНаПроизводство = ДатыГрафика.ЗаказНаПроизводство
		|			 И ДатыГрафика.СтатусГрафика = 0
		|			 И Товары.Этап = ДатыГрафика.Этап
		|			 И Товары.КлючПартия = ДатыГрафика.КлючПартия
		|
		|	ГДЕ
		|		Товары.ВидСтроки НЕ В (
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка))
		|
		|	{ГДЕ
		|		Товары.Номенклатура.*   КАК Номенклатура,
		|		Товары.Характеристика.* КАК Характеристика,
		|		Товары.Назначение.*     КАК Назначение,
		|		ВЫРАЗИТЬ(
		|			ВЫБОР
		|				КОГДА Товары.Склад ССЫЛКА Справочник.СтруктураПредприятия
		|					ТОГДА Товары.Склад
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.Пустаяссылка)
		|			КОНЕЦ КАК Справочник.СтруктураПредприятия).* КАК ПодразделениеПолучатель}
		|
		|	{ГДЕ Товары.ЗаказНаПроизводство В (
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Заказ КАК Заказ
		|		ИЗ
		|			ОтборПоЗаказам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоЗаказам)}
		|
		|	{ГДЕ (Товары.Номенклатура, Товары.Характеристика) В(
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Номенклатура   КАК Номенклатура,
		|			ТаблицаОтбора.Характеристика КАК Характеристика
		|		ИЗ
		|			ОтборПоСегментам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоСегментуНоменклатуры)}
		|
		|	СГРУППИРОВАТЬ ПО
		|		Товары.Номенклатура,
		|		Товары.Характеристика,
		|		Товары.Склад,
		|		Товары.Назначение,
		|		Товары.ЗаказНаПроизводство,
		|		Товары.КлючНоменклатура,
		|		СпрСпособ.Ссылка
		|
		|	ИМЕЮЩИЕ
		|		СУММА(Товары.КОбеспечению - Товары.Заменено - Товары.РаспределеноИзЗапасовОбособленно - Товары.РаспределеноИзПартийОбособленно) > 0
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|
		|		Товары.Номенклатура                          КАК Номенклатура,
		|		Товары.Характеристика                        КАК Характеристика,
		|		Товары.Склад                                 КАК Склад,
		|		Товары.НазначениеСтруктуры                   КАК Назначение,
		|		Товары.ЗаказНаПроизводство                   КАК ЗаказНаПроизводство,
		|		Товары.КлючНоменклатура                      КАК КлючНоменклатура,
		|
		|		СпрСпособ.Ссылка КАК СпособОбеспечения,
		|
		|		МИНИМУМ(ВЫБОР
		|				КОГДА Товары.ВидСтроки = ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)
		|					ТОГДА Товары.КлючПартия
		|			КОНЕЦ) КАК КлючПартия,
		|		МИНИМУМ(ISNULL(ДатыГрафика.Начало, Товары.ЗаказНаПроизводство.НачатьНеРанее)) КАК ЖелаемаяДатаОтгрузки,
		|
		|		СУММА(Товары.РаспределеноИзЗапасовОбособленно + Товары.РаспределеноИзПартийОбособленно) КАК Количество
		|
		|	ИЗ
		|		РегистрСведений.СтруктураЗаказа КАК Товары
		|
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпрСпособ
		|			ПО &ПодстановкаОсновногоСпособаОбеспечения
		|
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК ДатыГрафика
		|			ПО Товары.ЗаказНаПроизводство = ДатыГрафика.ЗаказНаПроизводство
		|			 И ДатыГрафика.СтатусГрафика = 0
		|			 И Товары.Этап = ДатыГрафика.Этап
		|			 И Товары.КлючПартия = ДатыГрафика.КлючПартия
		|
		|	ГДЕ
		|		Товары.ВидСтроки НЕ В (
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Продукция),
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
		|			ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка))
		|
		|	{ГДЕ
		|		Товары.Номенклатура.*                        КАК Номенклатура,
		|		Товары.Характеристика.*                      КАК Характеристика,
		|		Товары.НазначениеСтруктуры.*                 КАК Назначение,
		|		ВЫРАЗИТЬ(
		|			ВЫБОР
		|				КОГДА Товары.Склад ССЫЛКА Справочник.СтруктураПредприятия
		|					ТОГДА Товары.Склад
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.Пустаяссылка)
		|			КОНЕЦ КАК Справочник.СтруктураПредприятия).* КАК ПодразделениеПолучатель}
		|
		|	{ГДЕ Товары.ЗаказНаПроизводство В (
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Заказ КАК Заказ
		|		ИЗ
		|			ОтборПоЗаказам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоЗаказам)}
		|
		|	{ГДЕ (Товары.Номенклатура, Товары.Характеристика) В(
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Номенклатура   КАК Номенклатура,
		|			ТаблицаОтбора.Характеристика КАК Характеристика
		|		ИЗ
		|			ОтборПоСегментам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоСегментуНоменклатуры)}
		|
		|	СГРУППИРОВАТЬ ПО
		|		Товары.Номенклатура,
		|		Товары.Характеристика,
		|		Товары.Склад,
		|		Товары.НазначениеСтруктуры,
		|		Товары.ЗаказНаПроизводство,
		|		Товары.КлючНоменклатура,
		|		СпрСпособ.Ссылка
		|
		|	ИМЕЮЩИЕ
		|		СУММА(Товары.РаспределеноИзЗапасовОбособленно + Товары.РаспределеноИзПартийОбособленно) > 0
		// ++ номенклатура "по требованию"
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|
		|		Товары.Номенклатура                          КАК Номенклатура,
		|		Товары.Характеристика                        КАК Характеристика,
		|		Товары.Склад                                 КАК Склад,
		|		Товары.Назначение                   КАК Назначение,
		|		Товары.ЗаказНаПроизводство                   КАК ЗаказНаПроизводство,
		|		НЕОПРЕДЕЛЕНО                      КАК КлючНоменклатура,
		|
		|		СпрСпособ.Ссылка КАК СпособОбеспечения,
		|
		|		НЕОПРЕДЕЛЕНО КАК КлючПартия,
		|		МИНИМУМ(Товары.ЗаказНаПроизводство.НачатьНеРанее) КАК ЖелаемаяДатаОтгрузки,
		|
		|		СУММА(ВЫБОР
		|				КОГДА Товары.Вероятность = 0
		|					ТОГДА Товары.Количество
		|				ИНАЧЕ Товары.Количество * Товары.Вероятность / 100
		|		КОНЕЦ) КАК Количество
		|
		|	ИЗ
		|		РегистрСведений.юум_НоменклатураПоТребованию КАК Товары
		|
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпрСпособ
		|			ПО &ПодстановкаОсновногоСпособаОбеспечения
		|
		|	{ГДЕ
		|		Товары.Номенклатура.*                        КАК Номенклатура,
		|		Товары.Характеристика.*                      КАК Характеристика,
		|		Товары.Назначение.*                 КАК Назначение,
		|		ВЫРАЗИТЬ(
		|			ВЫБОР
		|				КОГДА Товары.Подразделение ССЫЛКА Справочник.СтруктураПредприятия
		|					ТОГДА Товары.Подразделение
		|				ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.Пустаяссылка)
		|			КОНЕЦ КАК Справочник.СтруктураПредприятия).* КАК ПодразделениеПолучатель}
		|
		|	{ГДЕ Товары.ЗаказНаПроизводство В (
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Заказ КАК Заказ
		|		ИЗ
		|			ОтборПоЗаказам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоЗаказам)}
		|
		|	{ГДЕ (Товары.Номенклатура, Товары.Характеристика) В(
		|		ВЫБРАТЬ
		|			ТаблицаОтбора.Номенклатура   КАК Номенклатура,
		|			ТаблицаОтбора.Характеристика КАК Характеристика
		|		ИЗ
		|			ОтборПоСегментам КАК ТаблицаОтбора
		|		ГДЕ
		|			&ИспользуетсяОтборПоСегментуНоменклатуры)}
		|
		|	СГРУППИРОВАТЬ ПО
		|		Товары.Номенклатура,
		|		Товары.Характеристика,
		|		Товары.Склад,
		|		Товары.Назначение,
		|		Товары.ЗаказНаПроизводство,
		|		НЕОПРЕДЕЛЕНО,
		|		СпрСпособ.Ссылка
		|
		|	ИМЕЮЩИЕ
		|		СУММА(Количество) > 0
		// -- номенклатура "по требованию"
		|
		|) КАК Товары
		|
// -- НЕ УТКА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ВтФорматыСкладов";
	
	ТекстЗапроса = РегистрыСведений.СхемыОбеспечения.ПодставитьСоединениеДляПолученияСпособаОбеспечения(
		ТекстЗапроса,
		"ПодстановкаОсновногоСпособаОбеспечения",
		"Товары.Номенклатура,Товары.Характеристика,ВЫРАЗИТЬ(Товары.Склад КАК Справочник.Склады)");
	
	// ++ НЕ УТКА
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	// -- НЕ УТКА
	
	Возврат ТекстЗапроса;
	
КонецФункции // } #юум


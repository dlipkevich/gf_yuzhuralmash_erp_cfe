#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

&ИзменениеИКонтроль("ТаблицаПотребностейПоЗаказамИОстатков")
Процедура юум_ТаблицаПотребностейПоЗаказамИОстатков(Параметры, АдресРезультата) Экспорт
	
	ОптимизироватьЗапасыРаспределительногоЦентра = Константы.ОптимизироватьЗапасыРаспределительногоЦентра.Получить();
	
	ИспользоватьАссортимент = Ложь;
	НачалоДня = НачалоДня(ТекущаяДатаСеанса());
	
	Если Параметры.ТипОтбора = "ОтборПоЗначениям" Тогда
		
		Запрос = Новый Запрос();
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
		Запрос.УстановитьПараметр("СпособОбеспечения", Параметры.Отбор.СпособОбеспечения);
		Запрос.УстановитьПараметр("НачалоТекущегоДня", НачалоДня);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВЫРАЗИТЬ(&СпособОбеспечения КАК Справочник.СпособыОбеспеченияПотребностей) КАК СпособОбеспечения,
			|	&НачалоТекущегоДня КАК ДатаОтсчета
			|ПОМЕСТИТЬ СпособыОбеспечения";
		Запрос.Выполнить();
		
		ТаблицаСпособовОбеспечения = БлижайшийЦиклПоСпособуОбеспечения(Запрос);
		
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("ТаблицаСпособовОбеспечения", ТаблицаСпособовОбеспечения);
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
		Запрос.Текст =
			"ВЫБРАТЬ
			|	&Номенклатура   КАК Номенклатура,
			|	&Характеристика КАК Характеристика,
			|	&Склад          КАК Склад,
			|	&ДатаОтгрузкиЗаказа      КАК ДатаОтгрузкиЗаказа,
			|	&СкладОтгрузкиЗаказа     КАК СкладОтгрузкиЗаказа,
			|	&ПодразделениеПолучатель КАК ПодразделениеПолучатель,
			|	ВЫРАЗИТЬ(&СпособОбеспечения КАК Справочник.СпособыОбеспеченияПотребностей) КАК СпособОбеспечения,
			|	
			|	&Назначение     КАК Назначение,
			|	&Заказ          КАК Заказ,
			|	&ДатаОтгрузки   КАК ДатаОтгрузки,
			|	0 КАК НеОбеспечено,
			|	0 КАК РаспределеноНаСкладе,
			|	0 КАК РаспределеноИзЗаказов
			|ПОМЕСТИТЬ ВтТовары
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)               КАК Номенклатура,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)                     КАК Склад,
			|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)                     КАК Центр
			|ПОМЕСТИТЬ ТопологияСкладов
			|ГДЕ
			|	ЛОЖЬ
			|;
			|ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)               КАК Номенклатура,
			|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка) КАК Характеристика,
			|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)                     КАК Склад,
			|	ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяСсылка)                 КАК Назначение
			|ПОМЕСТИТЬ ТоварыИСкладыПопавшиеВОбработку
			|ГДЕ
			|	ЛОЖЬ";
		
		Для Каждого Свойство Из Параметры.Отбор Цикл
			Запрос.УстановитьПараметр(Свойство.Ключ, Свойство.Значение);
		КонецЦикла;
		Запрос.Выполнить();
		
	Иначе
		
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц();
		
		СхемаКомпоновкиДанных = Обработки.ОбеспечениеПотребностей.ПолучитьМакет("МакетКомпоновкиДляСерверныхОтборов");
		АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных);
		
		ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
		КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
		КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Параметры.Отбор);
		
		// Основной запрос
		Тексты = Новый Массив();
		Тексты.Добавить(ВременнаяТаблицаОтборПоСегментам());
		Тексты.Добавить(ВременнаяТаблицаОтборПоЗаказам());
		#Вставка
		// #юум {
		// #ЧТЗ 03.01 Управление закупками
		// Галфинд Садомцев 2026/09/18        	
		// Проверяем флажок "Включать материалы по требованию"
		юум_ВключатьМатериалыПоТребованию = Неопределено;
		Параметры.Свойство("юум_ВключатьМатериалыПоТребованию", юум_ВключатьМатериалыПоТребованию);
		Если ТипЗнч(юум_ВключатьМатериалыПоТребованию) = Тип("Булево")
			И юум_ВключатьМатериалыПоТребованию Тогда
			// здесь надо дополнить текст запроса номенклатурой " по требованию"
			Тексты.Добавить(юум_ВременнаяТаблицаПотребностиВсехСкладовПоЗаказамПоТребованию());
		Иначе
		// здесь типовой код
		// } #юум
		#КонецВставки
		Тексты.Добавить(ВременнаяТаблицаПотребностиВсехСкладовПоЗаказам());
		#Вставка
		КонецЕсли;
		#КонецВставки
		Тексты.Добавить(
			"ВЫБРАТЬ
			|	Таблица.СпособОбеспечения КАК СпособОбеспечения
			|ПОМЕСТИТЬ СпособыОбеспеченияДляОтборов
			|ИЗ
			|	&ТаблицаСпособовОбеспечения КАК Таблица");
		Тексты.Добавить(ВременнаяТаблицаПотребностиВыбранныхСкладов());
		Тексты.Добавить(ВыборкаПервойЗаписиПотребностейПоЗаказамДляКомпоновкиЗапроса());
		Текст = СтрСоединить(Тексты, ОбщегоНазначения.РазделительПакетаЗапросов());
		
		СхемаКомпоновкиДанных.НаборыДанных.Набор.Запрос = Текст;
		Запрос = ПолучитьЗапросСОтборамиКомпоновкиДанных(АдресСхемыКомпоновкиДанных, КомпоновщикНастроек, "Набор");
		УдалитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
		
		// Отделим часть запроса, которую необходимо выполнить привилегированно.
		ПозицияУдаления = СтрНайти(Запрос.Текст, "УНИЧТОЖИТЬ ВтФорматыСкладов");
		Позиция = СтрНайти(Запрос.Текст, ";", НаправлениеПоиска.СНачала, ПозицияУдаления) + 1;
		ТекстЗапросаПривилегированно = Сред(Запрос.Текст, Позиция);
		Запрос.Текст = Лев(Запрос.Текст, ПозицияУдаления - 1);
		Запрос.УстановитьПараметр("ОптимизироватьЗапасыРаспределительногоЦентра", ОптимизироватьЗапасыРаспределительногоЦентра);
		Запрос.УстановитьПараметр("ФОЗаказыНаПеремещенияВключена",
			ПолучитьФункциональнуюОпцию("ИспользоватьЗаказыНаПеремещение"));
		Запрос.УстановитьПараметр("ФОПроизводство2_2Включена",
			ПолучитьФункциональнуюОпцию("ИспользоватьУправлениеПроизводством2_2"));
		Запрос.УстановитьПараметр("ТаблицаСпособовОбеспечения", Параметры.ТаблицаСпособовОбеспечения);
		//++ НЕ УТКА
		Запрос.УстановитьПараметр("ИспользуетсяГрафикПроизводства",
			УправлениеПроизводствомПовтИсп.ИспользуетсяГрафикПроизводства());
		//-- НЕ УТКА
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Запрос.Выполнить();
		
		// Для части запроса выполняемой в привилегированном режиме нужна временная таблица топологии складов.
		Запрос.Текст = ВременнаяТаблицаРазличнаяНоменклатура("ПотребностиВсехСкладовПоЗаказам");
		Запрос.Выполнить();
		РегистрыСведений.СхемыОбеспечения.ВременнаяТаблицаТопологияСкладов(Запрос, "РазличнаяНоменклатура");
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос.Текст = ТекстЗапросаПривилегированно;
		Запрос.Выполнить();
		
		Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Товары.Номенклатура КАК Номенклатура,
			|	Товары.Характеристика КАК Характеристика,
			|	ВЫБОР
			|		КОГДА ВЫРАЗИТЬ(Товары.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры
			|				= ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
			|			ТОГДА Товары.ПодразделениеПолучатель
			|		ИНАЧЕ Товары.Склад
			|	КОНЕЦ КАК Склад,
			|	Товары.Назначение КАК Назначение
			|ПОМЕСТИТЬ ТоварыИСкладыПопавшиеВОбработку
			|ИЗ
			|	ВтТовары КАК Товары
			|ИНДЕКСИРОВАТЬ ПО
			|	Номенклатура, Характеристика, Склад, Назначение";
		
		Запрос.Выполнить();
		Запрос.УстановитьПараметр("ТаблицаСпособовОбеспечения", Параметры.ТаблицаСпособовОбеспечения);
		
		ИспользоватьАссортимент = ПолучитьФункциональнуюОпцию("ИспользоватьАссортимент");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоТекущегоДня", НачалоДня);
	
	Тексты = Новый Массив();
	
	Текст =
		"ВЫБРАТЬ
		|	Таблица.СпособОбеспечения КАК СпособОбеспечения,
		|	Таблица.ДатаПоставки КАК ДатаПоставки,
		|	Таблица.ДатаПоставкиПоГрафику КАК ДатаПоставкиПоГрафику,
		|	Таблица.ФормироватьЗаказыПоРасписанию КАК ФормироватьЗаказыПоРасписанию,
		|	Таблица.ФормироватьЗаказыПоТочкеЗаказа КАК ФормироватьЗаказыПоТочкеЗаказа,
		|	Таблица.ПлановаяДатаЗаказа КАК ПлановаяДатаЗаказа,
		|	Таблица.КЗаказуТовары КАК КЗаказуТовары
		|ПОМЕСТИТЬ ТаблицаСпособовОбеспечения
		|ИЗ
		|	&ТаблицаСпособовОбеспечения КАК Таблица
		|ИНДЕКСИРОВАТЬ ПО
		|	СпособОбеспечения";
	Тексты.Добавить(Текст);
	
	// Расчет даты заказа от даты отгрузки для всех способов обеспечения.
	Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад КАК Склад,
		|	Таблица.СпособОбеспечения КАК СпособОбеспечения,
		|	Таблица.ДатаОтгрузки КАК ДатаОтсчета
		|ПОМЕСТИТЬ ТоварыДляРасчетаСроков
		|ИЗ
		|	ВтТовары КАК Таблица
		|		
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаСпособовОбеспечения КАК Способы
		|		ПО Способы.СпособОбеспечения = Таблица.СпособОбеспечения
		|		И Способы.ДатаПоставки > ДАТАВРЕМЯ(1, 1, 1)
		|		И Таблица.ДатаОтгрузки > Способы.ДатаПоставки
		|		
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ВариантУпорядочиванияПотребностейПоЗаказамДляОбеспечения КАК ФильтрУпорядочивания
		|		ПО ФильтрУпорядочивания.Значение = ЗНАЧЕНИЕ(Перечисление.ВариантыУпорядочиванияПотребностейПоЗаказамДляОбеспечения.ПриоритетИДатаОтгрузки)
		|ИНДЕКСИРОВАТЬ ПО НАБОРАМ(
		|	(Номенклатура),(Склад),(Номенклатура,Характеристика,Склад,СпособОбеспечения,ДатаОтсчета))";
	Тексты.Добавить(Текст);
	
	// Расчет даты заказа.
	ПараметрыРасчета = ОбеспечениеВДокументахСервер.НовыйПараметрыРасчетаСроков();
	ПараметрыРасчета.Искать = "ДАТА_ЗАКАЗА_ПО_ДАТЕ_ПОСТАВКИ";
	ПараметрыРасчета.ДляКого = "ПОТРЕБИТЕЛЬ";
	ПараметрыРасчета.Товар = "УКАЗАН";
	ПараметрыРасчета.СпособОбеспечения = "УКАЗАН";
	ПараметрыРасчета.СрочнаяПоставка = Ложь;
	ПараметрыРасчета.Искать0ДнейПоКалендарю = Истина;
	ПараметрыРасчета.ИменаТаблиц.Результат = "РасчетДатыЗаказа";
	
	Расчет = ОбеспечениеВДокументахСервер.Сроки(ПараметрыРасчета);
	Тексты.Добавить(Расчет.ТекстЗапроса);
	ОбеспечениеВДокументахСервер.ДобавитьТекстыУничтоженияВременныхТаблиц(Тексты, Расчет.ПромежуточныеТаблицы);
	Тексты.Добавить("УНИЧТОЖИТЬ ТоварыДляРасчетаСроков");
	
	// Расчет даты поставки по найденной дате заказа.
	Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Таблица.Номенклатура КАК Номенклатура,
		|	Таблица.Характеристика КАК Характеристика,
		|	Таблица.Склад КАК Склад,
		|	Таблица.СпособОбеспечения КАК СпособОбеспечения,
		|	Таблица.ДатаЗаказа КАК ДатаОтсчета
		|ПОМЕСТИТЬ ТоварыДляРасчетаСроков
		|ИЗ
		|	РасчетДатыЗаказа КАК Таблица
		|ИНДЕКСИРОВАТЬ ПО НАБОРАМ(
		|	(Номенклатура),(Склад),(Номенклатура,Характеристика,Склад,СпособОбеспечения,ДатаОтсчета))";
	Тексты.Добавить(Текст);
	
	ПараметрыРасчета = ОбеспечениеВДокументахСервер.НовыйПараметрыРасчетаСроков();
	ПараметрыРасчета.Искать = "ДАТА_ПОСТАВКИ_ПО_ДАТЕ_ЗАКАЗА";
	ПараметрыРасчета.ДляКого = "ПОСТАВЩИК";
	ПараметрыРасчета.Товар = "УКАЗАН";
	ПараметрыРасчета.СпособОбеспечения = "УКАЗАН";
	ПараметрыРасчета.СрочнаяПоставка = Ложь;
	ПараметрыРасчета.ИменаТаблиц.Результат = "РасчетДатыПоставки";
	
	Расчет = ОбеспечениеВДокументахСервер.Сроки(ПараметрыРасчета);
	Тексты.Добавить(Расчет.ТекстЗапроса);
	ОбеспечениеВДокументахСервер.ДобавитьТекстыУничтоженияВременныхТаблиц(Тексты, Расчет.ПромежуточныеТаблицы);
	Тексты.Добавить("УНИЧТОЖИТЬ ТоварыДляРасчетаСроков");
	
	// Итоговая таблица с датой отгрузки, датой поставки и датой заказа.
	Текст =
		"ВЫБРАТЬ
		|	ДатыЗаказа.Номенклатура КАК Номенклатура,
		|	ДатыЗаказа.Характеристика КАК Характеристика,
		|	ДатыЗаказа.Склад КАК Склад,
		|	ДатыЗаказа.СпособОбеспечения КАК СпособОбеспечения,
		|	ДатыЗаказа.ДатаОтсчета КАК ДатаОтгрузки,
		|	ДатыЗаказа.ДатаЗаказа КАК ДатаЗаказа,
		|	ДатыПоставки.ДатаПоступления КАК ДатаПоставки,
		|	ДатыПоставки.ДатаПоступленияКалендарьЗаполнен И ДатыЗаказа.ДатаЗаказаКалендарьЗаполнен КАК КалендарьЗаполнен
		|ПОМЕСТИТЬ РасчетСроков
		|ИЗ
		|	РасчетДатыЗаказа КАК ДатыЗаказа
		|		
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РасчетДатыПоставки КАК ДатыПоставки
		|		ПО ДатыПоставки.Номенклатура = ДатыЗаказа.Номенклатура
		|		И ДатыПоставки.Характеристика = ДатыЗаказа.Характеристика
		|		И ДатыПоставки.Склад = ДатыЗаказа.Склад
		|		И ДатыПоставки.СпособОбеспечения = ДатыЗаказа.СпособОбеспечения
		|		И ДатыПоставки.ДатаОтсчета = ДатыЗаказа.ДатаЗаказа
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура, Характеристика, Склад, ДатаОтгрузки";
	Тексты.Добавить(Текст);
	Тексты.Добавить("УНИЧТОЖИТЬ РасчетДатыЗаказа");
	Тексты.Добавить("УНИЧТОЖИТЬ РасчетДатыПоставки");
	

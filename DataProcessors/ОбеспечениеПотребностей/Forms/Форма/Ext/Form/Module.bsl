#Область СлужебныеПроцедурыИФункции

// #юум {
// #ЧТЗ 04.02/1 Производственый учет 04.02.01/03.01.01 АРМ «Материальная укомплектованность заказов»
// Галфинд Садомцев 2026/11/16
&НаСервере
Функция юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, Поле)
	АРМОтбор = АРМПотребностиНоменклатуры.Скопировать();
	АРМОтбор.Свернуть(Поле);
	АРММассив = АРМОтбор.ВыгрузитьКолонку(Поле);
	АРМСписок = Новый СписокЗначений;
	АРМСписок.ЗагрузитьЗначения(АРММассив);
	
	Возврат АРМСписок;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.02/1 Производственый учет 04.02.01/03.01.01 АРМ «Материальная укомплектованность заказов»
// Галфинд Садомцев 2026/11/16
&НаСервере
Процедура юум_ДобавитьОтбор(АРМОтборСписок, Поле)
		ЭО = КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(КомпоновщикНастроекДляОтборов,
			Поле,
			АРМОтборСписок,
			ВидСравненияКомпоновкиДанных.ВСписке);
		ПН = КомпоновщикНастроекДляОтборов.ПользовательскиеНастройки.Элементы.Найти(ЭО.ИдентификаторПользовательскойНастройки);
		Если ТипЗнч(ПН) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ПН.Использование = Истина;
			ПН.ПравоеЗначение = ЭО.ПравоеЗначение;
			ПН.ВидСравнения = ЭО.ВидСравнения;
		КонецЕсли;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.02/1 Производственый учет 04.02.01/03.01.01 АРМ «Материальная укомплектованность заказов»
// Галфинд Садомцев 2026/11/16
&НаСервере
Процедура юум_АРМНастроитьОтборы()

	Для Каждого ПН Из КомпоновщикНастроекДляОтборов.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ПН) = Тип("ОтборКомпоновкиДанных") Тогда
			ПН.Элементы.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	АРМПотребностиНоменклатуры = ПолучитьИзВременногоХранилища(ЭтотОбъект.юум_АРМАдресПотребностиНоменклатуры);
	
	АРМОтборПоЗаказ = юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, "ЗаказНаПроизводство");
	АРМОтборПоНоменклатура = юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, "Номенклатура");
	АРМОтборПоХарактеристика = юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, "Характеристика");
	АРМОтборПоСклад = юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, "Склад");
	АРМОтборПоНазначение = юум_ПолучитьОтборПоПолю(АРМПотребностиНоменклатуры, "Назначение");
	
	Если ЗначениеЗаполнено(АРМОтборПоЗаказ) Тогда
		юум_ДобавитьОтбор(АРМОтборПоЗаказ, "Заказ");
	КонецЕсли;

	Если ЗначениеЗаполнено(АРМОтборПоНоменклатура) Тогда
		юум_ДобавитьОтбор(АРМОтборПоНоменклатура, "Номенклатура");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АРМОтборПоХарактеристика) Тогда
		юум_ДобавитьОтбор(АРМОтборПоХарактеристика, "Характеристика");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АРМОтборПоСклад) Тогда
		юум_ДобавитьОтбор(АРМОтборПоСклад, "Склад");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АРМОтборПоНазначение) Тогда
		юум_ДобавитьОтбор(АРМОтборПоНазначение, "Назначение");
	КонецЕсли;
	
КонецПроцедуры // } #юум


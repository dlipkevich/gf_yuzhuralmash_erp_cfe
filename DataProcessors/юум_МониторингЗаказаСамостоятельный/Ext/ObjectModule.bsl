	Возврат 6;
	
КонецФункции

Процедура ЗаполнитьРассчитываемыеРеквизитыДерева(СтрокаДерева)
	
	СтрокаДерева.НомерКартинки = НомерКартинки(СтрокаДерева.ТипСтроки, СтрокаДерева.ТипПроцесса);
	
	Если СтрокаДерева.ТипСтроки = ТипСтрокиЭтап()
		ИЛИ СтрокаДерева.ТипСтроки = ТипСтрокиПолуфабрикат()
		ИЛИ СтрокаДерева.ТипСтроки = ТипСтрокиПолуфабрикатДругогоЗаказа() Тогда
		
		СтрокаДерева.ВыполненПроизведен = ?(СтрокаДерева.ТипСтроки = ТипСтрокиЭтап(),
			СтрокаДерева.Выполнен,
			(СтрокаДерева.КоличествоПлан - СтрокаДерева.КоличествоОтменено) <= СтрокаДерева.КоличествоФакт);
		
		СтрокаДерева.ВыполненПроизведенРодитель = СтрокаДерева.Родитель.ВыполненПроизведен;
		
	Иначе
		
		СтрокаДерева.ВыполненПроизведен = Ложь;
		
	КонецЕсли;
	
	Если Не (СтрокаДерева.ТипСтроки = ТипСтрокиЭтап()
				И (СтрокаДерева.ЭтапПроизводствоНаСтороне Или СтрокаДерева.ЭтапПроизводствоБезСпецификации)) Тогда
		
		СтрокаДерева.КоличествоДефицит = СтрокаДерева.КоличествоПлан
			- СтрокаДерева.КоличествоОтменено
			- СтрокаДерева.КоличествоФакт;
		
		СтрокаДерева.КоличествоДефицитИтого = СтрокаДерева.КоличествоПланИтого
			- СтрокаДерева.КоличествоОтмененоИтого
			- СтрокаДерева.КоличествоФактИтого;
		
	КонецЕсли;
	
КонецПроцедуры

Функция НомерКартинки(ТипСтроки, ТипПроцесса)
	
	Если ТипСтроки = ТипСтрокиПолуфабрикат()
		ИЛИ ТипСтроки = ТипСтрокиПолуфабрикатДругогоЗаказа() Тогда
		
		Если ТипПроцесса = ПредопределенноеЗначение("Перечисление.ТипыПроизводственныхПроцессов.Сборка") Тогда
			
			Результат = 6;
			
		Иначе
			
			Результат = 2;
			
		КонецЕсли;
		
	ИначеЕсли ТипСтроки = ТипСтрокиЭтап() Тогда
		
		Результат = 1;
		
	Иначе
		
		Результат = 0;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСтрокуНоменклатуры(Данные, Документ, Родитель, Изделие, Обеспечение, ЗаказБезСпецификации)

	НоваяСтрока = НоваяТиповаяСтрока(Родитель.Строки);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Изделие);
	НоваяСтрока.ПредставлениеСтроки = НоменклатураКлиентСервер.ПредставлениеНоменклатуры(
		Изделие.НоменклатураПредставление,
		Изделие.ХарактеристикаПредставление);
	
	Если Родитель.Уровень() = 0 Тогда
		НоваяСтрока.ТипСтроки = ТипСтрокиПродукция();
	ИначеЕсли Изделие.Заказ = Родитель.Заказ Тогда
		НоваяСтрока.ТипСтроки = ТипСтрокиПолуфабрикат();
	Иначе
		НоваяСтрока.ТипСтроки = ТипСтрокиПолуфабрикатДругогоЗаказа();
		НоваяСтрока.ИнформационнаяСтрока = Документы.ЗаказНаПроизводство2_2.ПолноеПредставлениеЗаказа(Изделие.Заказ);
	КонецЕсли;
	
	ИтогиОбеспечения = ЗаполнитьОбеспечениеСтроки(Данные, Документ, НоваяСтрока, Изделие, Обеспечение, ЗаказБезСпецификации);
	ДатаОкончанияФакт = ИтогиОбеспечения.ДатаОкончанияФакт;
	ПартияПроизводства = ИтогиОбеспечения.ПартияПроизводства;

	Если (НоваяСтрока.КоличествоПлан - НоваяСтрока.КоличествоОтменено) <= НоваяСтрока.КоличествоФакт Тогда
		НоваяСтрока.ДатаОкончанияФакт = ДатаОкончанияФакт;
	КонецЕсли;
	Если НоваяСтрока.КоличествоПланИтого = 0 Тогда
		НоваяСтрока.КоличествоПланИтого = НоваяСтрока.КоличествоПлан;
	Иначе
		НоваяСтрока.КоличествоПланИтого = НоваяСтрока.КоличествоПланИтого + НоваяСтрока.КоличествоОтменено;
	КонецЕсли;
	Если НоваяСтрока.КоличествоФактИтого = 0 Тогда
		НоваяСтрока.КоличествоФактИтого = НоваяСтрока.КоличествоФакт;
	КонецЕсли;
	НоваяСтрока.КоличествоОтмененоИтого = НоваяСтрока.КоличествоОтменено;
	НоваяСтрока.ПартияПроизводства = ПартияПроизводства;
	
	ЗаполнитьРассчитываемыеРеквизитыДерева(НоваяСтрока);
	
	Если НоваяСтрока.МожноСоздаватьЭтапы
		И НоваяСтрока.Спецификация.Пустая()
		И (НоваяСтрока.КоличествоПлан - НоваяСтрока.КоличествоОтменено) > НоваяСтрока.КоличествоСоздано Тогда
		
		СтрокаСоздатьЭтапы = НоваяСтрока.Строки.Вставить(0);
		СтрокаСоздатьЭтапы.ТипСтроки = ТипСтрокиСоздатьЭтапы();
		СтрокаСоздатьЭтапы.Заказ = НоваяСтрока.Заказ;
		
	КонецЕсли;

КонецПроцедуры

Функция ЗаполнитьОбеспечениеСтроки(Данные, Документ, НоваяСтрока, Изделие, Обеспечение, ЗаказБезСпецификации)

	ДатаОкончанияФакт = '00010101';
	ПартияПроизводства = Справочники.ПартииПроизводства.ПустаяСсылка();
	
	Для каждого Строка Из Обеспечение Цикл
		
		НоваяСтрока.КоличествоФакт = НоваяСтрока.КоличествоФакт + Строка.КоличествоФакт;
		НоваяСтрока.КоличествоСоздано = НоваяСтрока.КоличествоСоздано + Строка.КоличествоПлан;
		НоваяСтрока.ДатаОкончанияПлан = МАКС(НоваяСтрока.ДатаОкончанияПлан, Строка.ДатаОкончанияПлан);
		ДатаОкончанияФакт = МАКС(ДатаОкончанияФакт, Строка.ДатаОкончанияФакт);
		
		Если Изделие.Заказ = Строка.Заказ Тогда
			
			СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Заказ, Этап");
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка);
			Для каждого СтрокаИтого Из Данные.Обеспечение.НайтиСтроки(СтруктураПоиска) Цикл
				НоваяСтрока.КоличествоПланИтого = НоваяСтрока.КоличествоПланИтого + СтрокаИтого.КоличествоПлан;
				НоваяСтрока.КоличествоФактИтого = НоваяСтрока.КоличествоФактИтого + СтрокаИтого.КоличествоФакт;
			КонецЦикла;
			
			Если ЗаказБезСпецификации Тогда
				ДобавитьЭтапыПоНомеру(Данные, Документ, Строка.Этап, Строка.ТипПроцесса, НоваяСтрока);
			Иначе
				ДобавитьЭтапыПоИД(Данные, Строка.ПартияПроизводства, Строка.ТипПроцесса, НоваяСтрока);
			КонецЕсли;
			
		КонецЕсли;
		
		ПартияПроизводства = ЕдинаяПартияОбеспечения(ПартияПроизводства, Строка.ПартияПроизводства);
		
	КонецЦикла;
	Возврат Новый Структура("ДатаОкончанияФакт,ПартияПроизводства", ДатаОкончанияФакт, ПартияПроизводства);

КонецФункции

Функция ЕдинаяПартияОбеспечения(Знач ТекущаяПартия, КандидатПартии)

	Если ТекущаяПартия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТекущаяПартия.Пустая() Тогда
		Возврат КандидатПартии;
	КонецЕсли;
	Если ТекущаяПартия <> КандидатПартии Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТекущаяПартия;

КонецФункции

Процедура ДобавитьПрочиеЭтапыЗаказа(Данные, Документ, Родитель)

	Строки = Данные.Этапы.НайтиСтроки(Новый Структура("Заказ, Обработан", Документ, Ложь));
	Если Строки.ВГраница() <> -1 Тогда
		
		НоваяСтрока = НоваяТиповаяСтрока(Родитель.Строки);
		НоваяСтрока.Заказ = Документ;
		НоваяСтрока.ПредставлениеСтроки = НСтр("ru = '<Прочее>';
												|en = '<Other>'");
		НоваяСтрока.ТипСтроки = ТипСтрокиПрочиеИзделия();
		ЗаполнитьРассчитываемыеРеквизитыДерева(НоваяСтрока);
		
		ТипПроцесса = Перечисления.ТипыПроизводственныхПроцессов.Сборка;
		
		ДобавитьЭтапы(Данные, Строки, ТипПроцесса, НоваяСтрока);
		
	КонецЕсли;

КонецПроцедуры

Функция ПовторнаяСвязьОбеспечения(Связи, Индекс, ПолеЗначения)

	Связь = Связи[Индекс];
	ЭтоДубль = Ложь;
	Для ИндексПред = 1 - Индекс По 0 Цикл
		
		ИндексПредыдущейСвязи = 0 - ИндексПред;
		ПредыдущаяСвязь = Связи[ИндексПредыдущейСвязи];
		ЭтоДубль = Связь[ПолеЗначения] = ПредыдущаяСвязь[ПолеЗначения]
			И Связь.Назначение = ПредыдущаяСвязь.Назначение;
			
		Если ЭтоДубль Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	Возврат ЭтоДубль;

КонецФункции

// Один исходный алгоритм включается сборщиком в форму и модуль объекта.
// В форме компилируется на клиенте; нативные тесты выполняют тот же код на сервере.
// Параметры:
//  ДиаграммаРаскрытия - ДиаграммаГанта - диаграмма с иерархией точек.
//  НовыйУровень - Число - уровень, до которого раскрываются точки.
Процедура УстановитьУровеньРаскрытияДиаграммы(ДиаграммаРаскрытия, НовыйУровень)

	ИсходноеОбновление = ДиаграммаРаскрытия.Обновление;
	ДиаграммаРаскрытия.Обновление = Ложь;
	Попытка
		РаскрытьТочкиДоУровня(ДиаграммаРаскрытия, ДиаграммаРаскрытия.Точки, НовыйУровень, 0, Новый Соответствие);
		ДиаграммаРаскрытия.Обновление = ИсходноеОбновление;
	Исключение
		ДиаграммаРаскрытия.Обновление = ИсходноеОбновление;
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура РаскрытьТочкиДоУровня(ДиаграммаРаскрытия, Точки, НовыйУровень, Глубина, Посещенные)

	МаксимальнаяГлубинаПредставления = 128;

	Если Глубина > МаксимальнаяГлубинаПредставления Тогда
		ВызватьИсключение "Превышена граница раскрытия диаграммы.";
	КонецЕсли;
	Для каждого Точка Из Точки Цикл
		Если Не НоваяТочкаОбхода(Точка, Посещенные) Тогда
			Продолжить;
		КонецЕсли;
		Если Точка.Значение.Уровень < НовыйУровень Тогда
			ДиаграммаРаскрытия.РазвернутьТочку(Точка, Ложь);
		Иначе
			ДиаграммаРаскрытия.СвернутьТочку(Точка, Ложь);
		КонецЕсли;
		РаскрытьТочкиДоУровня(ДиаграммаРаскрытия, Точка.Точки, НовыйУровень, Глубина + 1, Посещенные);
	КонецЦикла;

КонецПроцедуры

Функция НоваяТочкаОбхода(Точка, Посещенные)

	Если ТипЗнч(Точка.Значение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	КлючТочки = Точка.Значение.Идентификатор;
	Если Посещенные.Получить(КлючТочки) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Посещенные.Вставить(КлючТочки, Истина);
	Возврат Истина;

КонецФункции

Процедура ПроверитьУсловие(Условие, ИмяПроверки, Протокол)

	Протокол.Проверки.Добавить(Новый Структура("Имя,Пройдено", ИмяПроверки, Условие));
	Если Не Условие Тогда
		ВызватьИсключение "Не пройдена проверка: " + ИмяПроверки;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверкаОбщейПартии(Протокол)

	ОжидаемоеКоличествоПервогоВхождения = 4;
	ОжидаемыйСуммарныйВыпуск = 4;
	ОжидаемоеКоличествоВторогоВхождения = 6;
	ОжидаемыйПланРабот = 10;
	ОжидаемыйФактРабот = 13;

	Модель = НоваяТестоваяМодель();
	Партия = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(Модель, Партия, 4, -1);
	ДобавитьТестовыйУзел(Модель, Партия, 6, -1);
	ДобавитьТестовыйОбъем(Модель, Партия, 10, 4);
	ДобавитьТестовыйЭтап(Модель, Партия, 10, 13, Ложь, Новый Массив);
	Модель.Этапы[0].Владельцы.Добавить(0);
	Модель.Этапы[0].Владельцы.Добавить(1);
	РаспределитьКоличества(Модель);
	РаспределитьРаботы(Модель);
	СвернутьПоказатели(Модель);
	УсловиеПроверки = Модель.Узлы[0].Выделено = ОжидаемоеКоличествоПервогоВхождения
		И Модель.Узлы[1].Выделено = ОжидаемоеКоличествоВторогоВхождения;
	ПроверитьУсловие(УсловиеПроверки, "Общая партия 4 + 6 = 10", Протокол);
	УсловиеПроверки = Модель.Узлы[0].ФактКоличество + Модель.Узлы[1].ФактКоличество = ОжидаемыйСуммарныйВыпуск;
	ПроверитьУсловие(УсловиеПроверки, "Частичный выпуск не удвоен", Протокол);
	ПроверитьУсловие(Модель.Узлы[0].ТрудПлан + Модель.Узлы[1].ТрудПлан = ОжидаемыйПланРабот, "Плановые часы партии учтены один раз", Протокол);
	ПроверитьУсловие(Модель.Узлы[0].ТрудФакт + Модель.Узлы[1].ТрудФакт = ОжидаемыйФактРабот, "Фактические часы не ограничены планом", Протокол);

КонецПроцедуры

Процедура ПроверкаВложенногоРаспределения(Протокол)

	ОжидаемаяПерваяПотребность = 8;
	ОжидаемаяВтораяПотребность = 12;
	ОжидаемаяОбщаяПотребность = 20;

	Модель = НоваяТестоваяМодель();
	ПартияРодителя = Новый УникальныйИдентификатор;
	ПартияДетали = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(Модель, ПартияРодителя, 4, -1);
	ДобавитьТестовыйУзел(Модель, ПартияДетали, 20, 0);
	ДобавитьТестовыйУзел(Модель, ПартияРодителя, 6, -1);
	ДобавитьТестовыйУзел(Модель, ПартияДетали, 20, 2);
	ДобавитьТестовыйОбъем(Модель, ПартияРодителя, 10, 0);
	ДобавитьТестовыйОбъем(Модель, ПартияДетали, 20, 0);
	РаспределитьКоличества(Модель);
	УсловиеПроверки = Модель.Узлы[1].ПланКоличество = ОжидаемаяПерваяПотребность
		И Модель.Узлы[3].ПланКоличество = ОжидаемаяВтораяПотребность;
	ПроверитьУсловие(УсловиеПроверки,
		"Подчиненный состав масштабируется по долям родителей 40/60", Протокол);
	ПроверитьУсловие(Модель.Узлы[1].Выделено + Модель.Узлы[3].Выделено = ОжидаемаяОбщаяПотребность,
		"Вложенная общая партия не превышает 20 единиц", Протокол);

КонецПроцедуры

Процедура ПроверкаЦикла(Протокол)

	Модель = НоваяТестоваяМодель();
	Партия = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(Модель, Партия, 1, -1);
	ДобавитьТестовыйУзел(Модель, Партия, 1, 0);
	ДобавитьТестовыйОбъем(Модель, Партия, 1, 0);
	ЦиклОтклонен = Ложь;
	Попытка
		РаспределитьКоличества(Модель);
	Исключение
		ЦиклОтклонен = СтрНайти(ВРег(ИнформацияОбОшибке().Описание), "ЦИКЛ") > 0;

		Если Не ЦиклОтклонен Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	ПроверитьУсловие(ЦиклОтклонен, "Цикл отклоняется до распределения", Протокол);

КонецПроцедуры

Функция НоваяТестоваяМодель()

	Модель = НоваяМодель(Документы.ЗаказНаПроизводство2_2.ПустаяСсылка());
	Модель.ДинамическаяСтруктура = Истина;
	Модель.Вставить("ИндексЭтапов", Новый Соответствие);
	Модель.Вставить("ДокументКЭтапу", Новый Соответствие);
	Модель.Вставить("ДокументыПоСсылке", Новый Соответствие);
	Модель.Вставить("ОбъемыПартий", ТестоваяТаблица("КлючПартия,Номенклатура,Характеристика,Назначение,Объем,Готово"));
	Модель.Вставить("ВыходныеИзделия", ТестоваяТаблица("Этап,Номенклатура,Характеристика,Количество,Произведено,Отменено"));
	Возврат Модель;


Процедура ДобавитьТестовыйУзел(Модель, Партия, КоличествоУзла, Родитель)

	Источник = Новый Структура;
	Источник.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Источник.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Источник.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	Источник.Вставить("ПредставлениеСтроки", "Контрольная ДСЕ " + Строка(Модель.Узлы.Количество() + 1));
	Источник.Вставить("Спецификация", Справочники.РесурсныеСпецификации.ПустаяСсылка());
	Источник.Вставить("НомерСтроки", Модель.Узлы.Количество() + 1);
	Источник.Вставить("Требуется", КоличествоУзла);
	МассивПартий = Новый Массив;
	МассивПартий.Добавить(Партия);
	Источник.Вставить("ОбеспечениеПартии", МассивПартий);
	ДобавитьУзелДСЕ(Модель, Источник, Родитель);


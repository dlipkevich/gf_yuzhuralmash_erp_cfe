	ДиаграммаПроверки = ПостроитьДиаграмму(МодельПроверки, ПараметрыПроверки);
	ДанныеПроверки = ДанныеПредставления(ДиаграммаПроверки, МодельПроверки, 64, 0, 0);
	ПроверитьУсловие(ДанныеПроверки.rows[0].readyText = "33,33"
		И ДанныеПроверки.rows[0].planHours = "24",
		"Неполнота количества не скрывает известный процент труда ДСЕ", Протокол);
	ПроверитьУсловие(ДанныеПроверки.rows[1].readyText = "33,33"
		И ДанныеПроверки.rows[1].planHours = "24" И ДанныеПроверки.rows[1].actualHours = "8",
		"Полный этап показывает 33,33% при неполноте своего узла", Протокол);
	ПроверитьУсловие(ДанныеПроверки.rows[1].intervals[0].color = "green",

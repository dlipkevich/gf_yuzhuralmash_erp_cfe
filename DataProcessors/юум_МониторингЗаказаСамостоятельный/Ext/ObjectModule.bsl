// Исполняет контрольные расчеты в платформе без записи учетных объектов.
// Возвращаемое значение:
//  Строка - протокол JSON; применяются только локальные расчетные модели.
Функция Самопроверка() Экспорт

	Протокол = Новый Структура("Статус,Конфигурация,Проверки,Ошибка", "passed", Метаданные.Версия, Новый Массив, "");
	КонтекстОбхода = НовыйКонтекстОбхода(Документы.ЗаказНаПроизводство2_2.ПустаяСсылка(), "SELFTEST");
	Попытка
		ПроверкаОбщейПартии(Протокол);
		ПроверкаВложенногоРаспределения(Протокол);
		ПроверкаПланаФактаИГанта(Протокол);
		ПроверкаУровнейДерева(Протокол);
		ПроверкаЦикла(Протокол);
		ПроверкаГраницыФакта(Протокол);
		ПроверкаПривязкиНормативногоЭтапа(Протокол);
		ПроверкаЕдиницТрудозатрат(Протокол);
		ПроверкаHTMLПредставления(Протокол);
		ПроверкаПолнотыОтдельногоЭтапа(Протокол);
		ПроверкаИсходногоЧТЗ(Протокол);
		ПроверкаЗапросов(Протокол);
	Исключение
		Протокол.Статус = "failed";
		Протокол.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("МониторингЗаказа.Новый.Самопроверка", УровеньЖурналаРегистрации.Ошибка, , , Протокол.Ошибка);
	КонецПопытки;
	ЗаписьПротокола = Новый ЗаписьJSON;
	ЗаписьПротокола.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьПротокола, Протокол);
	Возврат ЗаписьПротокола.Закрыть();

КонецФункции

Процедура ПроверитьУсловие(Условие, ИмяПроверки, Протокол)


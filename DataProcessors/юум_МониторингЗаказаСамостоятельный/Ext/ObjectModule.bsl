// Исполняет контрольные расчеты в платформе без записи учетных объектов.
// Возвращаемое значение:
//  Строка - протокол JSON; применяются только локальные расчетные модели.
Функция Самопроверка() Экспорт

	Протокол = Новый Структура;
	Протокол.Вставить("Статус", "passed");
	Протокол.Вставить("Конфигурация", Метаданные.Версия);
	Протокол.Вставить("Проверки", Новый Массив);
	Протокол.Вставить("Ошибка", "");
	КонтекстОбхода = НовыйКонтекстОбхода(Документы.ЗаказНаПроизводство2_2.ПустаяСсылка(), "SELFTEST");
	Попытка
		ПроверкаОбщейПартии(Протокол);
		ПроверкаВложенногоРаспределения(Протокол);
		ПроверкаПланаФактаИГанта(Протокол);
		ПроверкаУровнейДерева(Протокол);
		ПроверкаЦикла(Протокол);
		ПроверкаГраницыФакта(Протокол);
		ПроверкаПривязкиНормативногоЭтапа(Протокол);
		ПроверкаЕдиницТрудозатрат(Протокол);
		ПроверкаДанныхПредставления(Протокол);
		ПроверкаПолнотыОтдельногоЭтапа(Протокол);
		ПроверкаИсходногоЧТЗ(Протокол);
		ПроверкаДокументальныхСвязей(Протокол);
		ПроверкаСлужебногоДерева(Протокол);
		ПроверкаПриоритетаСлужебногоИсточника(Протокол);
	Исключение
		Протокол.Статус = "failed";
		Протокол.Ошибка = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("МониторингЗаказа.Новый.Самопроверка", УровеньЖурналаРегистрации.Ошибка, , , Протокол.Ошибка);
	КонецПопытки;
	ЗаписьПротокола = Новый ЗаписьJSON;
	ЗаписьПротокола.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьПротокола, Протокол);
	Возврат ЗаписьПротокола.Закрыть();

КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСвойстваПотребностиДляПроверки(Потребность, Узел)

	Для каждого ИмяПоля Из СтрРазделить("Номенклатура,Характеристика,Спецификация,Назначение", ",") Цикл
		Потребность.Вставить(ИмяПоля, Узел[ИмяПоля]);
	КонецЦикла;

КонецПроцедуры


Функция ВыбратьОднозначныеМаршруты(Узел, ТочныеМаршруты, МаршрутыУзла)

	Если ТочныеМаршруты.Количество() > 0 Тогда
		Возврат ТочныеМаршруты;
	КонецЕсли;
	Если Узел.Свойство("СтрокаИсточника") И МаршрутыУзла.Количество() > 1 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат МаршрутыУзла;

КонецФункции


Процедура ПроверкаНеоднозначныхМаршрутов(Модель, Протокол)

	Узел = Модель.Узлы[0];
	Кандидаты = Новый Массив;
	Для ИндексКандидата = 1 По 2 Цикл
		Маршрут = Новый Структура;
		Маршрут.Вставить("НомерПримера", ИндексКандидата);
		Маршрут.Вставить("КлючПартия", Новый УникальныйИдентификатор);
		Маршрут.Вставить("Партия", Справочники.ПартииПроизводства.ПустаяСсылка());
		Маршрут.Вставить("Назначение", Узел.Назначение);
		Маршрут.Вставить("Спецификация", Узел.Спецификация);
		Маршрут.Вставить("Заказ", Модель.Заказ);
		Кандидаты.Добавить(Маршрут);
	КонецЦикла;
	Маршруты = МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты);
	ПроверитьУсловие(Маршруты.Количество() = 0,
		"Неоднозначные партии требуют точной резервной связи", Протокол);

КонецПроцедуры


Процедура ПроверкаПолногоСлужебногоДерева(Протокол)

	Модель = НоваяТестоваяМодель();
	ТаблицаИсточника = НоваяТестоваяТаблицаСлужебногоДерева();
	Корень = ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Неопределено, Ложь);
	Для ИндексСтроки = 0 По 383 Цикл
		ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Корень.СтрокаИсточника, Истина);
		Модель.ПривязкиЭтапов.Добавить(Новый Структура("Узел", ИндексСтроки));
	КонецЦикла;
	ПостроитьУзлыСлужебногоДерева(Модель, ТаблицаИсточника);
	ПроверитьУсловие(Модель.Узлы.Количество() = 384 И НедостающиеСвязиСлужебногоДерева(Модель).Количество() = 0,
		"384 полностью связанных вхождения не требуют резервного поиска", Протокол);
	Модель.ПривязкиЭтапов.Удалить(10);
	ПроверитьУсловие(НедостающиеСвязиСлужебногоДерева(Модель).Количество() = 1,
		"При пробеле в 384 строках резервный отбор содержит одно вхождение", Протокол);

КонецПроцедуры


Процедура ПроверкаЧастичноОформленнойПартии(Протокол)

	Модель = НоваяТестоваяМодель();
	ДокументыПримера = НоваяТаблицаИсходников("КлючПартия,Спецификация,НомерЭтапа,ПометкаУдаления");
	ДокументПримера = ДокументыПримера.Добавить();
	ДокументПримера.КлючПартия = Новый УникальныйИдентификатор;
	ДокументПримера.Спецификация = Новый УникальныйИдентификатор;
	ДокументПримера.НомерЭтапа = 1;
	ДокументПримера.ПометкаУдаления = Ложь;
	Модель.Вставить("ДокументыЭтапов", ДокументыПримера);
	КлючПартии = КлючЗначения(ДокументПримера.КлючПартия);
	ИндексДокументов = Новый Соответствие;
	ИндексДокументов.Вставить(КлючПартии + "|1", Истина);
	НомераЭтапов = Новый Массив;
	НомераЭтапов.Добавить(1);
	НомераЭтапов.Добавить(2);
	ЭтапыСпецификаций = Новый Соответствие;
	ЭтапыСпецификаций.Вставить(ДокументПримера.Спецификация, НомераЭтапов);
	ПолныеПартии = ПроверитьПолнотуДокументальныхПартий(Модель, ИндексДокументов, ЭтапыСпецификаций);
	ПроверитьУсловие(ПолныеПартии.Получить(КлючПартии) = Ложь,
		"Отсутствующий этап спецификации требует резервного норматива", Протокол);
	ИндексДокументов.Вставить(КлючПартии + "|2", Истина);
	ПолныеПартии = ПроверитьПолнотуДокументальныхПартий(Модель, ИндексДокументов, ЭтапыСпецификаций);
	ПроверитьУсловие(ПолныеПартии.Получить(КлючПартии) = Истина,
		"Полный маршрут не требует резервного норматива", Протокол);
	НедостающиеОбъемы = Новый Соответствие;
	НедостающиеОбъемы.Вставить(КлючПартии, Истина);
	Модель.Вставить("ПартииНедостающихОбъемов", НедостающиеОбъемы);
	ПолныеПартии = ПроверитьПолнотуДокументальныхПартий(Модель, ИндексДокументов, ЭтапыСпецификаций);
	ПроверитьУсловие(ПолныеПартии.Получить(КлючПартии) = Ложь,
		"Неполный оформленный объем требует резервного норматива", Протокол);

КонецПроцедуры


Процедура ПроверкаПриоритетаСлужебногоИсточника(Протокол)

	Модель = НоваяТестоваяМодель();
	ТаблицаИсточника = НоваяТестоваяТаблицаСлужебногоДерева();
	Корень = ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Неопределено, Ложь);
	Изделие = ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Корень.СтрокаИсточника, Истина);
	Изделие.Требуется = 0;
	Изделие.ТребуетсяВсего = 0;
	ПостроитьУзлыСлужебногоДерева(Модель, ТаблицаИсточника);
	ПроверитьУсловие(НедостающиеСвязиСлужебногоДерева(Модель).Количество() = 1,
		"Резервный поиск адресуется только несвязанному вхождению", Протокол);
	Привязка = Новый Структура("Узел,Этап,Партия", 0, Неопределено, Неопределено);
	Модель.ПривязкиЭтапов.Добавить(Привязка);
	ПроверитьУсловие(НедостающиеСвязиСлужебногоДерева(Модель).Количество() = 0,
		"Связанная ветвь не требует чтения типовой структуры", Протокол);
	Потребность = Новый Структура;
	ЗаполнитьСвойстваПотребностиДляПроверки(Потребность, Модель.Узлы[0]);
	Потребность.Вставить("Количество", 10);
	РодительПроверки = Новый Структура("Индекс", -1);
	ДополнитьПотомкаДокументов(Модель, РодительПроверки, Потребность);
	ПроверитьУсловие(Модель.Узлы[0].ИсходныйПлан = 0,
		"Документальное дополнение сохраняет явный ноль служебного источника", Протокол);
	ПроверкаПолногоСлужебногоДерева(Протокол);
	ПроверкаНеоднозначныхМаршрутов(Модель, Протокол);
	ПроверкаЧастичноОформленнойПартии(Протокол);

КонецПроцедуры


Функция НедостающиеПулыСлужебногоДерева(Модель, ПулыДокументов)

	НедостающиеПулы = Новый Соответствие;
	НедостающиеКлючи = Новый Массив;
	Для каждого Узел Из Модель.Узлы Цикл
		ПокрытиеУзла = 0;
		Для каждого КлючПартии Из Узел.КлючиПартий Цикл
			ОбъемПула = ПулыДокументов.Получить(КлючПулаДСЕ(КлючПартии, Узел.Номенклатура, Узел.Характеристика));
			ПокрытиеУзла = ПокрытиеУзла + ?(ОбъемПула = Неопределено, 0, ОбъемПула);
		КонецЦикла;
		Для каждого КлючПартии Из Узел.КлючиПартий Цикл
			КлючПула = КлючПулаДСЕ(КлючПартии, Узел.Номенклатура, Узел.Характеристика);
			Если ПулыДокументов.Получить(КлючПула) = Неопределено Или ПокрытиеУзла < Узел.ИсходныйПлан Тогда
				НедостающиеПулы.Вставить(КлючПула, Истина);
				ДобавитьУникально(НедостающиеКлючи, КлючПартии);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Ключи,Пулы", НедостающиеКлючи, НедостающиеПулы);

КонецФункции


Функция ПулыСДокументальнымВыпуском(Модель)

	ДокументыПоСсылке = Новый Соответствие;
	Для каждого ДокументЭтапа Из Модель.ДокументыЭтапов Цикл
		Если Не ДокументЭтапа.ПометкаУдаления Тогда
			ДокументыПоСсылке.Вставить(ДокументЭтапа.Этап, ДокументЭтапа);
		КонецЕсли;
	КонецЦикла;
	ПулыДокументов = Новый Соответствие;
	ОбъемыЭтапов = Новый Соответствие;
	Для каждого Изделие Из Модель.ВыходныеИзделия Цикл
		ДокументЭтапа = ДокументыПоСсылке.Получить(Изделие.Этап);
		Если ДокументЭтапа <> Неопределено И Не Изделие.Отменено Тогда
			КлючПула = КлючПулаДСЕ(ДокументЭтапа.КлючПартия, Изделие.Номенклатура, Изделие.Характеристика);
			КлючЭтапа = КлючПула + "|" + Строка(ДокументЭтапа.НомерЭтапа);
			ОбъемЭтапа = ОбъемыЭтапов.Получить(КлючЭтапа);
			ОбъемЭтапа = ?(ОбъемЭтапа = Неопределено, 0, ОбъемЭтапа) + Изделие.Количество;
			ОбъемыЭтапов.Вставить(КлючЭтапа, ОбъемЭтапа);
			ОбъемПула = ПулыДокументов.Получить(КлючПула);
			Если ОбъемПула = Неопределено Или ОбъемЭтапа > ОбъемПула Тогда
				ПулыДокументов.Вставить(КлючПула, ОбъемЭтапа);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ПулыДокументов;

КонецФункции


Процедура ПрочитатьНедостающиеОбъемы(Модель)

	ОбъемыПартий = НоваяТаблицаИсходников("КлючПартия,Номенклатура,Характеристика,Назначение,Объем,Готово");
	ПулыДокументов = ПулыСДокументальнымВыпуском(Модель);
	ОтборДополнения = НедостающиеПулыСлужебногоДерева(Модель, ПулыДокументов);
	НеполныеПартии = Новый Соответствие;
	Для каждого КлючПартии Из ОтборДополнения.Ключи Цикл
		НеполныеПартии.Вставить(КлючЗначения(КлючПартии), Истина);
	КонецЦикла;
	Модель.Вставить("ПартииНедостающихОбъемов", НеполныеПартии);
	Если ОтборДополнения.Ключи.Количество() > 0 Тогда
		ЗапросОбъемов = Новый Запрос(ЗапросОбъемовДинамическихПартий());
		ЗапросОбъемов.УстановитьПараметр("КлючиПартий", ОтборДополнения.Ключи);
		Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа = Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа + 1;
		Для каждого ОбъемИсточника Из ВыполнитьЧтение(ЗапросОбъемов, "НедостающиеОбъемыПартий") Цикл
			КлючПула = КлючПулаДСЕ(ОбъемИсточника.КлючПартия, ОбъемИсточника.Номенклатура, ОбъемИсточника.Характеристика);
			Если ОтборДополнения.Пулы.Получить(КлючПула) = Истина Тогда
				ЗаполнитьЗначенияСвойств(ОбъемыПартий.Добавить(), ОбъемИсточника);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Модель.Вставить("ОбъемыПартий", ОбъемыПартий);

КонецПроцедуры


Функция ЗапросНедостающихНормативов()

	Возврат
		"ВЫБРАТЬ Работы.КлючПартия КАК КлючПартия, Работы.КлючВидРабот КАК КлючВидРабот,
		| Работы.Этап КАК Этап, Работы.Этап.НомерСледующегоЭтапа = 0 КАК Выпускающий,
		| Работы.ВидРабот КАК ВидРабот, Работы.Спецификация КАК Спецификация,
		| Работы.Количество КАК Количество,
		| Работы.ВидРабот.ЕдиницаИзмерения.ТипИзмеряемойВеличины = ЗНАЧЕНИЕ(Перечисление.ТипыИзмеряемыхВеличин.Время) КАК ВременнаяЕдиница,
		| Работы.ВидРабот.ЕдиницаИзмерения.Числитель КАК ЧислительВремени,
		| Работы.ВидРабот.ЕдиницаИзмерения.Знаменатель КАК ЗнаменательВремени,
		| Работы.ВидРабот.Трудоемкость КАК Норма, Работы.ВидРабот.КратностьТрудоемкости КАК Кратность,
		| ВЫРАЗИТЬ(Работы.Этап КАК Справочник.ЭтапыПроизводства).Владелец КАК Партия
		|ИЗ РегистрСведений.ТрудозатратыСтруктурыЗаказа КАК Работы
		|ГДЕ Работы.КлючПартия В (&КлючиПартий)";

КонецФункции


Функция ПартииБезДокументальныхНормативов(Модель, ПартииДокументов)

	НедостающиеКлючи = Новый Массив;
	Для каждого Узел Из Модель.Узлы Цикл
		Для каждого КлючПартии Из Узел.КлючиПартий Цикл
			Если ПартииДокументов.Получить(КлючЗначения(КлючПартии)) <> Истина Тогда
				ДобавитьУникально(НедостающиеКлючи, КлючПартии);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат НедостающиеКлючи;

КонецФункции


Функция ПроверитьПолнотуДокументальныхПартий(Модель, ИндексДокументов, ЭтапыСпецификаций)

	Результат = Новый Соответствие;
	Для каждого ДокументЭтапа Из Модель.ДокументыЭтапов Цикл
		Если ДокументЭтапа.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		КлючПартии = КлючЗначения(ДокументЭтапа.КлючПартия);
		НомераЭтапов = ЭтапыСпецификаций.Получить(ДокументЭтапа.Спецификация);
		ПокрытаПартия = НомераЭтапов <> Неопределено;
		Если ПокрытаПартия Тогда
			Для каждого НомерЭтапа Из НомераЭтапов Цикл
				ПокрытаПартия = ПокрытаПартия И ИндексДокументов.Получить(КлючПартии + "|" + Строка(НомерЭтапа)) = Истина;
			КонецЦикла;
		КонецЕсли;
		Если Модель.Свойство("ПартииНедостающихОбъемов") Тогда
			ПокрытаПартия = ПокрытаПартия И Модель.ПартииНедостающихОбъемов.Получить(КлючПартии) <> Истина;
		КонецЕсли;
		Результат.Вставить(КлючПартии, ПокрытаПартия);
	КонецЦикла;
	Возврат Результат;

КонецФункции


Функция ПолностьюДокументальныеПартии(Модель)

	Спецификации = Новый Массив;
	ИндексДокументов = Новый Соответствие;
	Для каждого ДокументЭтапа Из Модель.ДокументыЭтапов Цикл
		Если ДокументЭтапа.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьУникально(Спецификации, ДокументЭтапа.Спецификация);
		КлючДокумента = КлючЗначения(ДокументЭтапа.КлючПартия) + "|" + Строка(ДокументЭтапа.НомерЭтапа);
		ИндексДокументов.Вставить(КлючДокумента, Истина);
	КонецЦикла;
	ЭтапыСпецификаций = Новый Соответствие;
	Если Спецификации.Количество() > 0 Тогда
		ЗапросЭтапов = Новый Запрос("ВЫБРАТЬ Этапы.Владелец КАК Спецификация, Этапы.НомерЭтапа КАК НомерЭтапа
			|ИЗ Справочник.ЭтапыПроизводства КАК Этапы
			|ГДЕ Этапы.Владелец В (&Спецификации) И НЕ Этапы.ПометкаУдаления");
		ЗапросЭтапов.УстановитьПараметр("Спецификации", Спецификации);
		Для каждого СтрокаЭтапа Из ВыполнитьЧтение(ЗапросЭтапов, "СоставЭтаповСпецификаций") Цикл
			НомераЭтапов = ЭтапыСпецификаций.Получить(СтрокаЭтапа.Спецификация);
			Если НомераЭтапов = Неопределено Тогда
				НомераЭтапов = Новый Массив;
				ЭтапыСпецификаций.Вставить(СтрокаЭтапа.Спецификация, НомераЭтапов);
			КонецЕсли;
			НомераЭтапов.Добавить(СтрокаЭтапа.НомерЭтапа);
		КонецЦикла;
	КонецЕсли;
	Возврат ПроверитьПолнотуДокументальныхПартий(Модель, ИндексДокументов, ЭтапыСпецификаций);

КонецФункции


Процедура ДокументальныеНормативы(Модель, НормативныеРаботы, ПолныеПартии)

	ДокументыПоСсылке = Новый Соответствие;
	Для каждого ДокументЭтапа Из Модель.ДокументыЭтапов Цикл
		Если Не ДокументЭтапа.ПометкаУдаления Тогда
			ДокументыПоСсылке.Вставить(ДокументЭтапа.Этап, ДокументЭтапа);
		КонецЕсли;
	КонецЦикла;
	Для каждого РаботаДокумента Из Модель.РаботыДокументов Цикл
		ДокументЭтапа = ДокументыПоСсылке.Получить(РаботаДокумента.Этап);
		Если ДокументЭтапа = Неопределено Или РаботаДокумента.Отменено Тогда
			Продолжить;
		КонецЕсли;
		Если ПолныеПартии.Получить(КлючЗначения(ДокументЭтапа.КлючПартия)) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		Если ДокументЭтапа.Проведен И (ДокументЭтапа.Завершен Или РаботаДокумента.Выполнено) Тогда
			Продолжить;
		КонецЕсли;
		НоваяРабота = НормативныеРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяРабота, РаботаДокумента);
		НоваяРабота.КлючПартия = ДокументЭтапа.КлючПартия;
		НоваяРабота.Партия = ДокументЭтапа.Партия;
		НоваяРабота.Спецификация = ДокументЭтапа.Спецификация;
		НоваяРабота.Выпускающий = ДокументЭтапа.Выпускающий;
	КонецЦикла;

КонецПроцедуры


Процедура ПрочитатьНедостающиеНормативы(Модель)

	Поля = "КлючПартия,КлючВидРабот,Этап,Выпускающий,ВидРабот,Спецификация,Количество,"
		+ "ВременнаяЕдиница,ЧислительВремени,ЗнаменательВремени,Норма,Кратность,Партия";
	НормативныеРаботы = НоваяТаблицаИсходников(Поля);
	ПартииДокументов = ПолностьюДокументальныеПартии(Модель);
	ДокументальныеНормативы(Модель, НормативныеРаботы, ПартииДокументов);
	НедостающиеКлючи = ПартииБезДокументальныхНормативов(Модель, ПартииДокументов);
	Если НедостающиеКлючи.Количество() > 0 Тогда
		ЗапросНормативов = Новый Запрос(ЗапросНедостающихНормативов());
		ЗапросНормативов.УстановитьПараметр("КлючиПартий", НедостающиеКлючи);
		Модель.ЧтениеИсточников.ЗапросыНормативов = Модель.ЧтениеИсточников.ЗапросыНормативов + 1;
		Для каждого РаботаИсточника Из ВыполнитьЧтение(ЗапросНормативов, "НедостающиеНормативы") Цикл
			ЗаполнитьЗначенияСвойств(НормативныеРаботы.Добавить(), РаботаИсточника);
		КонецЦикла;
	КонецЕсли;
	Модель.Вставить("НормативныеРаботы", НормативныеРаботы);

КонецПроцедуры


Функция НоваяТаблицаИсходников(Поля)

	Результат = Новый ТаблицаЗначений;
	Для каждого ИмяПоля Из СтрРазделить(Поля, ",") Цикл
		Результат.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	Возврат Результат;

КонецФункции


Процедура ПрочитатьПоказателиСлужебногоДерева(Модель)

	ЗапросДанных = Новый Запрос;
	ЗапросДанных.УстановитьПараметр("Заказ", Модель.Заказ);
	ЗапросДанных.УстановитьПараметр("Этапы", Модель.ДокументыЭтапов.ВыгрузитьКолонку("Этап"));
	ЗапросДанных.Текст = ЗапросРабочегоГрафика();
	Модель.Вставить("ГрафикЭтапов", ВыполнитьЧтение(ЗапросДанных, "РабочийГрафик"));
	ЗапросДанных.УстановитьПараметр("ДокументыЭтапов", Модель.ДокументыЭтапов.ВыгрузитьКолонку("Этап"));
	ЗапросДанных.Текст = ЗапросРаботДокументов();
	Модель.Вставить("РаботыДокументов", ВыполнитьЧтение(ЗапросДанных, "РаботыДокументов"));
	ПрочитатьНедостающиеНормативы(Модель);
	ПрочитатьНедостающиеОбъемы(Модель);
	ЗапросДанных.УстановитьПараметр("ПартииДокументов", Модель.ДокументыЭтапов.ВыгрузитьКолонку("Партия"));
	ЗапросДанных.Текст = ЗапросВыработки();
	Модель.Вставить("Выработка", ВыполнитьЧтение(ЗапросДанных, "ОборотыВыработки"));
	НаборыКлючей = КлючиЧтения(Модель);
	ЗапросДанных.УстановитьПараметр("Номенклатура", НаборыКлючей.Номенклатура);
	ЗапросДанных.Текст = "ВЫБРАТЬ Товары.Ссылка КАК Номенклатура, Товары.Код КАК Код
		|ИЗ Справочник.Номенклатура КАК Товары ГДЕ Товары.Ссылка В (&Номенклатура)";
	КодыНоменклатуры = ВыполнитьЧтение(ЗапросДанных, "КодыНоменклатуры");
	ИндексКодов = Новый Соответствие;
	Для каждого СтрокаКода Из КодыНоменклатуры Цикл
		ИндексКодов.Вставить(СтрокаКода.Номенклатура, СтрокаКода.Код);
	КонецЦикла;
	Для каждого Узел Из Модель.Узлы Цикл
		КодУзла = ИндексКодов.Получить(Узел.Номенклатура);
		Узел.Код = ?(КодУзла = Неопределено, "", КодУзла);
	КонецЦикла;

КонецПроцедуры


Процедура ПрочитатьДокументыСлужебногоДерева(Модель)

	НаборыКлючей = КлючиЧтения(Модель);
	ЗапросДанных = Новый Запрос(ЗапросДокументовЭтапов());
	ЗапросДанных.УстановитьПараметр("Заказ", Модель.Заказ);
	ЗапросДанных.УстановитьПараметр("Партии", НаборыКлючей.Партии);
	ЗапросДанных.УстановитьПараметр("КлючиПартий", НаборыКлючей.КлючиПартий);
	ЗапросДанных.УстановитьПараметр("Этапы", НаборыКлючей.Этапы);
	ЗапросДанных.УстановитьПараметр("Завершен", Перечисления.СтатусыЭтаповПроизводства2_2.Завершен);
	ДокументыЭтапов = ВыполнитьЧтение(ЗапросДанных, "ДокументыЭтапов");
	ДокументыЭтапов.Сортировать("Партия, НомерЭтапа, Этап");
	Модель.Вставить("ДокументыЭтапов", ДокументыЭтапов);
	ЗапросДанных.УстановитьПараметр("ДокументыЭтапов", ДокументыЭтапов.ВыгрузитьКолонку("Этап"));
	ЗапросДанных.Текст = ЗапросВыходныхИзделий();
	ВыходныеИзделия = ВыполнитьЧтение(ЗапросДанных, "ВыходныеИзделия");
	ВыходныеИзделия.Индексы.Добавить("Этап,Номенклатура,Характеристика");
	Модель.Вставить("ВыходныеИзделия", ВыходныеИзделия);

КонецПроцедуры


Функция НедостающиеСвязиСлужебногоДерева(Модель)

	СвязанныеУзлы = Новый Соответствие;
	Для каждого Привязка Из Модель.ПривязкиЭтапов Цикл
		СвязанныеУзлы.Вставить(Привязка.Узел, Истина);
	КонецЦикла;
	Результат = Новый Массив;
	Для каждого Узел Из Модель.Узлы Цикл
		Если Узел.Свойство("СтрокаИсточника") И СвязанныеУзлы.Получить(Узел.Индекс) <> Истина Тогда
			Результат.Добавить(Узел.СтрокаИсточника);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции


Процедура УдалитьПодменяемыеПривязки(Модель, Узел, СтрокаЭтапа)

	ЧислоПривязок = Модель.ПривязкиЭтапов.Количество();
	Для ОбратныйИндекс = 0 По ЧислоПривязок - 1 Цикл
		ИндексПривязки = ЧислоПривязок - 1 - ОбратныйИндекс;
		Привязка = Модель.ПривязкиЭтапов[ИндексПривязки];
		ПодменяемыйЭтап = Привязка.Этап = СтрокаЭтапа.НормативныйЭтап Или Привязка.Этап = СтрокаЭтапа.Этап;
		Если Привязка.Узел = Узел.Индекс И ПодменяемыйЭтап Тогда
			Модель.ПривязкиЭтапов.Удалить(ИндексПривязки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


Процедура ПроверкаСлужебногоДерева(Протокол)

	ТаблицаИсточника = НоваяТестоваяТаблицаСлужебногоДерева();
	Корень = ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Неопределено, Ложь);
	Изделие = ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Корень.СтрокаИсточника, Истина);
	ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Изделие.СтрокаИсточника, Истина);
	ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, Изделие.СтрокаИсточника, Истина);
	Модель = НоваяТестоваяМодель();
	ПостроитьУзлыСлужебногоДерева(Модель, ТаблицаИсточника);
	ПроверитьУсловие(Модель.Узлы.Количество() = 3, "Служебный корень исключен, повторные ДСЕ сохранены", Протокол);
	ПроверитьУсловие(Модель.Узлы[1].Родитель = 0 И Модель.Узлы[2].Родитель = 0,
		"Иерархия прочитана по исходной ссылке родителя", Протокол);
	ПроверитьУсловие(Модель.Узлы[1].КлючСтроки <> Модель.Узлы[2].КлючСтроки,
		"Одинаковые ДСЕ имеют разные ключи вхождений", Протокол);
	ТаблицаИсточника[3].РодительИсточника = Справочники.юум_ДеревоЗаказаСлужебный.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ОбнаруженРазрыв = Ложь;
	Попытка
		ПостроитьУзлыСлужебногоДерева(НоваяТестоваяМодель(), ТаблицаИсточника);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "Нарушена иерархия") = 0 Тогда
			ВызватьИсключение;
		КонецЕсли;
		ОбнаруженРазрыв = Истина;
	КонецПопытки;
	ПроверитьУсловие(ОбнаруженРазрыв, "Отсутствующий родитель останавливает расчет", Протокол);

КонецПроцедуры

Функция НоваяТестоваяТаблицаСлужебногоДерева()

	Результат = Новый ТаблицаЗначений;
	ИменаКолонок = "СтрокаИсточника,РодительИсточника,Номенклатура,Характеристика,Назначение,Спецификация,"
		+ "КлючНоменклатура,КлючПартия,ИдСтроки,Доля,Требуется,ТребуетсяВсего,СчетчикСтрок,УровеньИсточника,ПредставлениеСтроки";
	Для каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ",") Цикл
		Результат.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДобавитьТестовуюСтрокуСлужебногоДерева(ТаблицаИсточника, РодительИсточника, ЕстьНоменклатура)

	Результат = ТаблицаИсточника.Добавить();
	Результат.СтрокаИсточника = Справочники.юум_ДеревоЗаказаСлужебный.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Результат.РодительИсточника = ?(РодительИсточника = Неопределено,
		Справочники.юум_ДеревоЗаказаСлужебный.ПустаяСсылка(), РодительИсточника);
	Результат.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	Если ЕстьНоменклатура Тогда
		Результат.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000001"));
	КонецЕсли;
	Результат.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	Результат.Назначение = Справочники.Назначения.ПустаяСсылка();
	Результат.Спецификация = Справочники.РесурсныеСпецификации.ПустаяСсылка();
	Результат.КлючНоменклатура = Новый УникальныйИдентификатор;
	Результат.КлючПартия = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Результат.ИдСтроки = Новый УникальныйИдентификатор;
	Результат.Доля = 1;
	Результат.Требуется = 10;
	Результат.ТребуетсяВсего = 10;
	Результат.СчетчикСтрок = ТаблицаИсточника.Количество();
	Результат.УровеньИсточника = 0;
	Результат.ПредставлениеСтроки = "Проверочная ДСЕ";
	Возврат Результат;

КонецФункции

// Основа состава читается из сохраненного служебного справочника.
// Прежняя документальная догрузка дополняет изготовляемые ветви в памяти.
// Исходные ссылки и родители сохраненных строк остаются основой дерева.
Процедура ПостроитьСлужебнуюСтруктуру(Модель)

	НачалоБлока = НачатьБлок("СлужебноеДерево");
	ЗапросДерева = Новый Запрос(ЗапросСлужебногоДерева());
	ЗапросДерева.УстановитьПараметр("Заказ", Модель.Заказ);
	СтрокиИсточника = ВыполнитьЧтение(ЗапросДерева, "СлужебноеДеревоСтроки");
	Если СтрокиИсточника.Количество() > 20000 Тогда
		ВызватьИсключение "Служебное дерево содержит более 20000 строк.";
	КонецЕсли;
	Модель.Вставить("СтрокиСлужебногоДерева", СтрокиИсточника);
	ПостроитьУзлыСлужебногоДерева(Модель, СтрокиИсточника);
	Модель.Вставить("ЧтениеИсточников", Новый Структура);
	Модель.ЧтениеИсточников.Вставить("ЗапросыСтруктурыЗаказа", 0);
	Модель.ЧтениеИсточников.Вставить("ЗапросыНормативов", 0);
	Если Модель.Узлы.Количество() = 0 Тогда
		ПредупреждениеМодели(Модель, "В служебном справочнике нет состава выбранного заказа. Обновление дерева выполняется отдельно от отчета.");
	КонецЕсли;
	ЗавершитьБлок("СлужебноеДерево", НачалоБлока, "ДСЕ=" + Строка(Модель.Узлы.Количество()));

КонецПроцедуры

Функция ЗапросСлужебногоДерева()

	Возврат
		"ВЫБРАТЬ ПЕРВЫЕ 20001
		| Дерево.Ссылка КАК СтрокаИсточника, Дерево.Родитель КАК РодительИсточника,
		| Дерево.Номенклатура КАК Номенклатура, Дерево.Характеристика КАК Характеристика,
		| Дерево.Назначение КАК Назначение, Дерево.Спецификация КАК Спецификация,
		| Дерево.КлючНоменклатура КАК КлючНоменклатура, Дерево.КлючПартия КАК КлючПартия,
		| Дерево.ИдСтроки КАК ИдСтроки, Дерево.Доля КАК Доля,
		| Дерево.Требуется КАК Требуется, Дерево.ТребуетсяВсего КАК ТребуетсяВсего,
		| Дерево.СчетчикСтрок КАК СчетчикСтрок, Дерево.Уровень КАК УровеньИсточника,
		| ПРЕДСТАВЛЕНИЕ(Дерево.Номенклатура) КАК ПредставлениеСтроки
		|ИЗ Справочник.юум_ДеревоЗаказаСлужебный КАК Дерево
		|ГДЕ Дерево.ЗаказНаПроизводство = &Заказ И НЕ Дерево.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Дерево.СчетчикСтрок, Дерево.Ссылка";

КонецФункции

Процедура ПостроитьУзлыСлужебногоДерева(Модель, СтрокиИсточника)

	ДочерниеСтроки = Новый Соответствие;
	Для каждого СтрокаИсточника Из СтрокиИсточника Цикл
		Дочерние = ДочерниеСтроки.Получить(СтрокаИсточника.РодительИсточника);
		Если Дочерние = Неопределено Тогда
			Дочерние = Новый Массив;
			ДочерниеСтроки.Вставить(СтрокаИсточника.РодительИсточника, Дочерние);
		КонецЕсли;
		Дочерние.Добавить(СтрокаИсточника);
	КонецЦикла;
	СтекОбхода = Новый Массив;
	ПустаяСтрокаИсточника = Справочники.юум_ДеревоЗаказаСлужебный.ПустаяСсылка();
	ДобавитьВСтекСлужебногоДерева(СтекОбхода, ДочерниеСтроки.Получить(ПустаяСтрокаИсточника), -1, 0);
	ОбработаноСтрок = 0;
	Модель.Вставить("УзлыПоСтрокамИсточника", Новый Соответствие);
	Для НомерШага = 1 По СтрокиИсточника.Количество() Цикл
		Если СтекОбхода.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		ЭлементОбхода = СтекОбхода[СтекОбхода.Количество() - 1];
		СтекОбхода.Удалить(СтекОбхода.Количество() - 1);
		КонтрольТиповогоОбхода(ЭлементОбхода.Глубина);
		ИсходнаяСтрока = ЭлементОбхода.Строка;
		ИндексРодителя = ЭлементОбхода.Родитель;
		Если ЗначениеЗаполнено(ИсходнаяСтрока.Номенклатура) Тогда
			СвойстваСтроки = СвойстваИсходнойСтроки(ИсходнаяСтрока, СтрокиИсточника.Колонки);
			ИндексРодителя = ДобавитьУзелДСЕ(Модель, СвойстваСтроки, ИндексРодителя);
			Узел = Модель.Узлы[ИндексРодителя];
			Узел.КлючСтроки = "служебное:" + КлючЗначения(ИсходнаяСтрока.СтрокаИсточника);
			Узел.Вставить("СтрокаИсточника", ИсходнаяСтрока.СтрокаИсточника);
			Узел.Вставить("КлючПотребляющейПартии", ИсходнаяСтрока.КлючПартия);
			Узел.Вставить("КлючНоменклатурыИсточника", ИсходнаяСтрока.КлючНоменклатура);
			Узел.Вставить("ДоляИсточника", ИсходнаяСтрока.Доля);
			Модель.УзлыПоСтрокамИсточника.Вставить(ИсходнаяСтрока.СтрокаИсточника, ИндексРодителя);
		Иначе
			Если ЭлементОбхода.Глубина <> 0 Тогда
				ВызватьИсключение "Внутренняя строка служебного дерева не содержит номенклатуру.";
			КонецЕсли;
		КонецЕсли;
		ОбработаноСтрок = НомерШага;
		ДобавитьВСтекСлужебногоДерева(СтекОбхода,
			ДочерниеСтроки.Получить(ИсходнаяСтрока.СтрокаИсточника), ИндексРодителя, ЭлементОбхода.Глубина + 1);
	КонецЦикла;
	Если ОбработаноСтрок <> СтрокиИсточника.Количество() Или СтекОбхода.Количество() > 0 Тогда
		ВызватьИсключение "Нарушена иерархия служебного дерева: цикл или отсутствующий родитель. Расчет остановлен.";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьВСтекСлужебногоДерева(СтекОбхода, ДочерниеСтроки, ИндексРодителя, ГлубинаОбхода)

	Если ДочерниеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для СмещениеСтроки = 1 По ДочерниеСтроки.Количество() Цикл
		СтрокаИсточника = ДочерниеСтроки[ДочерниеСтроки.Количество() - СмещениеСтроки];
		СтекОбхода.Добавить(Новый Структура("Строка,Родитель,Глубина", СтрокаИсточника, ИндексРодителя, ГлубинаОбхода));
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьСвязиПроизводящихПартий(Модель, НедостающиеСтроки)

	Если НедостающиеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа = Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа + 1;

	ЗапросСвязей = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		| Дерево.Ссылка КАК СтрокаИсточника,
		| ПроизводящийЭтап.ПартияПроизводства.УникальныйИдентификатор КАК КлючПроизводящейПартии
		|ИЗ Справочник.юум_ДеревоЗаказаСлужебный КАК Дерево
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК Обеспечение
		| ПО Дерево.ЗаказНаПроизводство = Обеспечение.ЗаказНаПроизводство
		| И Дерево.Номенклатура = Обеспечение.Номенклатура
		| И Дерево.Характеристика = Обеспечение.Характеристика
		| И Дерево.КлючНоменклатура = Обеспечение.КлючНоменклатура
		| И Дерево.КлючПартия = Обеспечение.КлючПартия
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК ПроизводящийЭтап
		| ПО Обеспечение.ЗаказНаПоступление = ПроизводящийЭтап.Ссылка
		|ГДЕ Дерево.Ссылка В (&НедостающиеСтроки)
		| И Дерево.ЗаказНаПроизводство = &Заказ И НЕ Дерево.ПометкаУдаления
		| И НЕ ПроизводящийЭтап.ПометкаУдаления");
	ЗапросСвязей.УстановитьПараметр("Заказ", Модель.Заказ);
	ЗапросСвязей.УстановитьПараметр("НедостающиеСтроки", НедостающиеСтроки);
	Для каждого СвязьИсточника Из ВыполнитьЧтение(ЗапросСвязей, "ПроизводящиеПартииСлужебногоДерева") Цикл
		ИндексУзла = Модель.УзлыПоСтрокамИсточника.Получить(СвязьИсточника.СтрокаИсточника);
		Если ИндексУзла <> Неопределено И ЗначениеЗаполнено(СвязьИсточника.КлючПроизводящейПартии) Тогда
			ДобавитьУникально(Модель.Узлы[ИндексУзла].КлючиПартий, СвязьИсточника.КлючПроизводящейПартии);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Сохраняет прежнюю детализацию по документам после чтения нового источника.
// Дополнение выполняется только в расчетной модели, без записи справочника.
Процедура ПривязатьЭтапыСлужебногоДерева(Модель)

	ВосстановитьДокументальнуюСтруктуру(Модель);
	ИндексыМаршрутов = ИндексыДокументальныхМаршрутов(Модель);
	ПроверитьОхватПартийСлужебнымДеревом(Модель, ИндексыМаршрутов.Партии);

КонецПроцедуры

// Нормативы связываются с сохраненными ДСЕ и собственной партией выпуска.
// Потребляющая партия из строки дерева не назначается изготовителем.
Процедура ПрочитатьПлановыеСвязиСлужебногоДерева(Модель, НедостающиеСтроки)

	Если НедостающиеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа = Модель.ЧтениеИсточников.ЗапросыСтруктурыЗаказа + 1;

	ЗапросСвязей = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ Дерево.Ссылка КАК СтрокаИсточника,
		| Работы.КлючПартия КАК КлючПроизводящейПартии, Работы.Этап КАК Этап
		|ИЗ Справочник.юум_ДеревоЗаказаСлужебный КАК Дерево
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК Выпуск
		| ПО Дерево.ЗаказНаПроизводство = Выпуск.ЗаказНаПроизводство
		| И Дерево.Номенклатура = Выпуск.Номенклатура
		| И Дерево.Характеристика = Выпуск.Характеристика
		| И Дерево.Назначение = Выпуск.Назначение
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ТрудозатратыСтруктурыЗаказа КАК Работы
		| ПО Выпуск.ЗаказНаПроизводство = Работы.ЗаказНаПроизводство
		| И Выпуск.КлючПартия = Работы.КлючПартия
		|ГДЕ Дерево.Ссылка В (&НедостающиеСтроки)
		| И Дерево.ЗаказНаПроизводство = &Заказ И НЕ Дерево.ПометкаУдаления
		| И (Дерево.Спецификация = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
		| ИЛИ Дерево.Спецификация = Работы.Спецификация)
		| И Выпуск.ВидСтроки <> ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление)");
	ЗапросСвязей.УстановитьПараметр("Заказ", Модель.Заказ);
	ЗапросСвязей.УстановитьПараметр("НедостающиеСтроки", НедостающиеСтроки);
	СвязиПлана = ВыполнитьЧтение(ЗапросСвязей, "ПлановыеСвязиСлужебногоДерева");
	ТочныеПартии = Новый Соответствие;
	Для каждого Узел Из Модель.Узлы Цикл
		Если Узел.КлючиПартий.Количество() > 0 Тогда
			ТочныеПартии.Вставить(Узел.Индекс, Истина);
		КонецЕсли;
	КонецЦикла;
	Для каждого СвязьПлана Из СвязиПлана Цикл
		ИндексУзла = Модель.УзлыПоСтрокамИсточника.Получить(СвязьПлана.СтрокаИсточника);
		Если ИндексУзла = Неопределено Или Не ЗначениеЗаполнено(СвязьПлана.КлючПроизводящейПартии) Тогда
			Продолжить;
		КонецЕсли;
		Узел = Модель.Узлы[ИндексУзла];
		Если ТочныеПартии.Получить(ИндексУзла) = Истина
			И Узел.КлючиПартий.Найти(СвязьПлана.КлючПроизводящейПартии) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьУникально(Узел.КлючиПартий, СвязьПлана.КлючПроизводящейПартии);
		ПривязкаПлана = Новый Структура("Узел,Этап,Партия", ИндексУзла, СвязьПлана.Этап, СвязьПлана.КлючПроизводящейПартии);
		Модель.ПривязкиЭтапов.Добавить(ПривязкаПлана);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОхватПартийСлужебнымДеревом(Модель, МаршрутыПартий)

	ПартииСостава = Новый Соответствие;
	Для каждого Узел Из Модель.Узлы Цикл
		Для каждого ПартияУзла Из Узел.КлючиПартий Цикл
			ПартииСостава.Вставить(КлючЗначения(ПартияУзла), Истина);
		КонецЦикла;
	КонецЦикла;
	НеВключеноПартий = 0;
	Для каждого ЭлементМаршрута Из МаршрутыПартий Цикл
		Если ЭлементМаршрута.Значение.Заказ = Модель.Заказ
			И ПартииСостава.Получить(ЭлементМаршрута.Ключ) <> Истина Тогда
			НеВключеноПартий = НеВключеноПартий + 1;
		КонецЕсли;
	КонецЦикла;
	Если НеВключеноПартий > 0 Тогда
		ТекстОхвата = "После чтения служебного дерева и документальной догрузки не связаны ДСЕ для "
			+ Строка(НеВключеноПартий) + " производственных партий этого заказа. Их часы в строки дерева не включены.";
		ПредупреждениеМодели(Модель, ТекстОхвата);
	КонецЕсли;

КонецПроцедуры

Функция НовыйКонтекстОбхода(Заказ, Идентификатор, РежимДиагностики = Ложь)

	Результат = Новый Структура;
	Результат.Вставить("Заказ", Заказ);
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Результат.Вставить("ЧислоСтрок", 0);
	Результат.Вставить("Путь", Новый Соответствие);
	Результат.Вставить("Кэш", Новый Соответствие);
	Результат.Вставить("ПоследняяЗапись", 0);
	Результат.Вставить("РежимДиагностики", РежимДиагностики);
	Возврат Результат;

КонецФункции

Функция НоваяМодель(Заказ)

	Результат = Новый Структура;
	Результат.Вставить("Заказ", Заказ);
	Результат.Вставить("ДинамическаяСтруктура", Ложь);
	Результат.Вставить("Узлы", Новый Массив);
	Результат.Вставить("СчетчикиКлючей", Новый Соответствие);
	Результат.Вставить("ПривязкиЭтапов", Новый Массив);
	Результат.Вставить("Этапы", Новый Массив);
	Результат.Вставить("Пулы", Новый Соответствие);
	Результат.Вставить("Распределение", Новый Массив);
	Результат.Вставить("Предупреждения", Новый Массив);
	Результат.Вставить("Начало", Дата(1, 1, 1));
	Результат.Вставить("Окончание", Дата(1, 1, 1));
	Результат.Вставить("РабочаяДата", ОбщегоНазначения.ТекущаяДатаПользователя());
	Результат.Вставить("МоментОбновления", ТекущаяДатаСеанса());
	Возврат Результат;

КонецФункции

Функция НачатьБлок(Блок)

	ЗаписатьСлед(Блок, "НАЧАЛО", "");
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецФункции

Процедура ЗавершитьБлок(Блок, НачалоБлока, Подробности = "")

	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоБлока;
	ПодробностиЗаписи = "мс=" + Строка(Длительность) + "; " + Подробности;
	ЗаписатьСлед(Блок, "КОНЕЦ", ПодробностиЗаписи);

КонецПроцедуры

Процедура ЗаписатьСлед(Блок, Фаза, Подробности)

	Если Не КонтекстОбхода.РежимДиагностики И Не (Блок = "Расчет" И Фаза = "НАЧАЛО") Тогда
		Возврат;
	КонецЕсли;

	Комментарий = "ID=" + КонтекстОбхода.Идентификатор + "; " + Фаза + "; " + Подробности;
	Событие = "МониторингЗаказа.Новый." + Блок;
	Если Фаза = "ПРЕДУПРЕЖДЕНИЕ" Тогда
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Предупреждение, , КонтекстОбхода.Заказ, Комментарий);
	Иначе
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Информация, , КонтекстОбхода.Заказ, Комментарий);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьОшибкуРасчета(Блок, ИнформацияИсключения)

	Событие = "МониторингЗаказа.Новый." + Блок;
	Комментарий = "ID=" + КонтекстОбхода.Идентификатор + "; ОШИБКА; "
		+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияИсключения);
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , КонтекстОбхода.Заказ, Комментарий);

КонецПроцедуры

Процедура КонтрольТиповогоОбхода(Глубина)

	МаксимальнаяГлубина = 64;
	ПределВремениРасчетаМс = 180000;
	ИнтервалЗаписиПрогрессаМс = 10000;

	Если Глубина > МаксимальнаяГлубина Тогда
		ВызватьИсключение "Превышена глубина структуры 64. Возможен цикл производственных связей.";
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Сейчас - КонтекстОбхода.Начало > ПределВремениРасчетаМс Тогда
		ВызватьИсключение "Расчет остановлен по границе времени 180 секунд. См. журнал регистрации.";
	КонецЕсли;
	Если Сейчас - КонтекстОбхода.ПоследняяЗапись > ИнтервалЗаписиПрогрессаМс Тогда
		ПодробностиЗаписи = "Строк=" + Строка(КонтекстОбхода.ЧислоСтрок)
			+ "; глубина=" + Строка(Глубина);
		ЗаписатьСлед("Обход", "ПРОГРЕСС", ПодробностиЗаписи);
		КонтекстОбхода.ПоследняяЗапись = Сейчас;
	КонецЕсли;

КонецПроцедуры

Функция НоваяТиповаяСтрока(СтрокиПриемник)

	ПредельноеЧислоСтрок = 40000;

	КонтекстОбхода.ЧислоСтрок = КонтекстОбхода.ЧислоСтрок + 1;
	Если КонтекстОбхода.ЧислоСтрок > ПредельноеЧислоСтрок Тогда
		ВызватьИсключение "Превышена граница 40000 строк типовой структуры.";
	КонецЕсли;
	Возврат СтрокиПриемник.Добавить();

КонецФункции

Процедура ВойтиВСтатическуюВетвь(ИсточникСвязи)

	Если КонтекстОбхода.Путь.Получить(ИсточникСвязи) <> Неопределено Тогда
		ВызватьИсключение "Цикл статической структуры: " + Строка(ИсточникСвязи);
	КонецЕсли;
	КонтекстОбхода.Путь.Вставить(ИсточникСвязи, Истина);

КонецПроцедуры

Процедура ВыйтиИзСтатическойВетви(ИсточникСвязи)

	КонтекстОбхода.Путь.Удалить(ИсточникСвязи);

КонецПроцедуры

Процедура ПредупреждениеМодели(Модель, ТекстПредупреждения)

	Если Модель.Предупреждения.Найти(ТекстПредупреждения) = Неопределено Тогда
		Модель.Предупреждения.Добавить(ТекстПредупреждения);
		ЗаписатьСлед("Данные", "ПРЕДУПРЕЖДЕНИЕ", ТекстПредупреждения);
	КонецЕсли;

КонецПроцедуры

Процедура ОтметитьНеполнотуСостава(Модель, СтрокаРаботы)

	Для каждого Узел Из Модель.Узлы Цикл
		Для каждого КлючПартии Из Узел.КлючиПартий Цикл
			Если КлючЗначения(КлючПартии) = КлючЗначения(СтрокаРаботы.КлючПартия)
				Или КлючЗначения(КлючПартии) = КлючЗначения(СтрокаРаботы.Партия) Тогда
				Узел.Полнота = Ложь;
				Узел.ДанныеТрудаПолны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПостроитьСтатическуюСтруктуру(Модель)

	НачалоБлока = НачатьБлок("СтатическаяСтруктура");
	ЗаказыСтруктуры = Новый Массив;
	ЗаказыСтруктуры.Добавить(Модель.Заказ);
	ДанныеСтруктуры = ТиповыеДанныеСтатическойСтруктуры(ЗаказыСтруктуры);
	ДеревоСтруктуры = НовоеСтатическоеДерево();
	КореньСтруктуры = НоваяТиповаяСтрока(ДеревоСтруктуры.Строки);
	КореньСтруктуры.Заказ = Модель.Заказ;
	КореньСтруктуры.ТипСтроки = ТипСтрокиЗаказ();
	ДобавитьНоменклатуру(ДанныеСтруктуры, Модель.Заказ, КореньСтруктуры);
	Для каждого ИсходнаяСтрока Из КореньСтруктуры.Строки Цикл
		ПеренестиСтрокуСтруктуры(Модель, ИсходнаяСтрока, ДеревоСтруктуры.Колонки, -1, 1);
	КонецЦикла;
	ЗавершитьБлок("СтатическаяСтруктура", НачалоБлока);

КонецПроцедуры

Процедура ПостроитьДинамическуюСтруктуру(Модель, ПараметрыЗаказа)

	НачалоБлока = НачатьБлок("ДинамическаяСтруктура");
	ПараметрыСтруктуры = ПараметрыДинамическогоДерева(Модель.Заказ, ПараметрыЗаказа.ТипПроцесса);
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено);
	Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ПостроитьДеревоЗаказа(
		ПараметрыСтруктуры, АдресРезультата);
	ДеревоСтруктуры = ПолучитьИзВременногоХранилища(АдресРезультата);
	УдалитьИзВременногоХранилища(АдресРезультата);
	Модель.Вставить("ПараметрыСтруктуры", ПараметрыСтруктуры);
	Для каждого ИсходнаяСтрока Из ДеревоСтруктуры.Строки Цикл
		ПеренестиСтрокуСтруктуры(Модель, ИсходнаяСтрока, ДеревоСтруктуры.Колонки, -1, 1);
	КонецЦикла;
	Модель.Удалить("ПараметрыСтруктуры");
	ЗавершитьБлок("ДинамическаяСтруктура", НачалоБлока);

КонецПроцедуры

Функция ПараметрыДинамическогоДерева(Заказ, ТипПроцесса)

	Результат = Новый Структура;
	Результат.Вставить("Заказ", Заказ);
	Результат.Вставить("ТипПроцесса", ТипПроцесса);
	Результат.Вставить("ПоказыватьЭтапы", Истина);
	Результат.Вставить("ПоказыватьМатериалы", Ложь);
	Результат.Вставить("ПоказыватьПеремещения", Ложь);
	Результат.Вставить("ПоказыватьВыпуски", Ложь);
	Результат.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	Результат.Вставить("Этапы", Неопределено);
	АналитикаЭтапов = Новый Структура("Номенклатура,Характеристика,Склад,Назначение");
	Результат.Вставить("ЭтапыАналитика", АналитикаЭтапов);
	Возврат Результат;

КонецФункции

Процедура ПеренестиСтрокуСтруктуры(Модель, ИсходнаяСтрока, Колонки, Родитель, Глубина)

	КодПолуфабриката = 2;
	КодПолуфабрикатаДругогоЗаказа = 5;
	КодПродолженияВетки = 7;

	КонтрольТиповогоОбхода(Глубина);
	СвойстваИсточника = СвойстваИсходнойСтроки(ИсходнаяСтрока, Колонки);
	ЭтоДСЕ = СвойстваИсточника.ТипСтроки = 1 Или СвойстваИсточника.ТипСтроки = КодПолуфабриката;
	Если Не Модель.ДинамическаяСтруктура Тогда
		ЭтоДСЕ = ЭтоДСЕ Или СвойстваИсточника.ТипСтроки = КодПолуфабрикатаДругогоЗаказа;
	КонецЕсли;
	НовыйРодитель = Родитель;
	Если ЭтоДСЕ Тогда
		НовыйРодитель = ДобавитьУзелДСЕ(Модель, СвойстваИсточника, Родитель);
	Иначе
		Если Родитель >= 0 Тогда
			ДобавитьПривязкуЭтапа(Модель, СвойстваИсточника, Родитель);
		КонецЕсли;
	КонецЕсли;
	Если Модель.ДинамическаяСтруктура И СвойстваИсточника.ТипСтроки = КодПродолженияВетки Тогда
		Возврат;
	КонецЕсли;
	Для каждого ПотомокСтруктуры Из ИсходнаяСтрока.Строки Цикл
		ПеренестиСтрокуСтруктуры(Модель, ПотомокСтруктуры, Колонки, НовыйРодитель, Глубина + 1);
	КонецЦикла;
	Если Модель.ДинамическаяСтруктура И СвойствоИсточника(СвойстваИсточника, "ДостроитьДерево", Ложь) Тогда
		ДостроитьДинамическуюВетвь(Модель, ИсходнаяСтрока, СвойстваИсточника, НовыйРодитель, Глубина);
	КонецЕсли;

КонецПроцедуры

Процедура ДостроитьДинамическуюВетвь(Модель, ИсходнаяСтрока, СвойстваИсточника, Родитель, Глубина)

	КодПродолженияВетки = 7;

	КлючиПартий = Новый Массив;
	Для каждого СлужебнаяСтрока Из ИсходнаяСтрока.Строки Цикл
		Если СлужебнаяСтрока.ТипСтроки = КодПродолженияВетки И КлючиПартий.Найти(СлужебнаяСтрока.КлючПартия) = Неопределено Тогда
			КлючиПартий.Добавить(СлужебнаяСтрока.КлючПартия);
		КонецЕсли;
	КонецЦикла;
	Если КлючиПартий.Количество() = 0 Тогда
		ВызватьИсключение "Типовая структура требует продолжения, но не содержит ключей партий.";
	КонецЕсли;
	ЭтапВетви = СвойствоИсточника(СвойстваИсточника, "ЭтапСсылка");
	КлючВетви = ЗначениеВСтрокуВнутр(КлючиПартий) + "|" + Строка(ЭтапВетви);
	ВойтиВСтатическуюВетвь(КлючВетви);
	Поддерево = КонтекстОбхода.Кэш.Получить(КлючВетви);
	Если Поддерево = Неопределено Тогда
		ПодробностиЗаписи = "Глубина=" + Строка(Глубина);
		ЗаписатьСлед("ДинамическаяВетвь", "НАЧАЛО", ПодробностиЗаписи);
		Поддерево = Отчеты.СтруктураЗаказаНаПроизводствоДинамическая.ДеревоПолуфабрикатов(
			Модель.Заказ, КлючиПартий, ЭтапВетви, Модель.ПараметрыСтруктуры,
			Модель.ПараметрыСтруктуры.Назначение);
		КонтекстОбхода.Кэш.Вставить(КлючВетви, Поддерево);
		ПодробностиЗаписи = "Строк=" + Строка(Поддерево.Строки.Количество());
		ЗаписатьСлед("ДинамическаяВетвь", "КОНЕЦ", ПодробностиЗаписи);
	КонецЕсли;
	Для каждого ПотомокСтруктуры Из Поддерево.Строки Цикл
		ПеренестиСтрокуСтруктуры(Модель, ПотомокСтруктуры, Поддерево.Колонки, Родитель, Глубина + 1);
	КонецЦикла;
	ВыйтиИзСтатическойВетви(КлючВетви);

КонецПроцедуры

Функция СвойстваИсходнойСтроки(ИсходнаяСтрока, Колонки)

	Результат = Новый Структура;
	Для каждого ИсходнаяКолонка Из Колонки Цикл
		Результат.Вставить(ИсходнаяКолонка.Имя, ИсходнаяСтрока[ИсходнаяКолонка.Имя]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СвойствоИсточника(Источник, ИмяСвойства, Умолчание = Неопределено)

	ЗначениеСвойства = Неопределено;
	Если Источник.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;
	Возврат Умолчание;

КонецФункции

Функция ДобавитьУзелДСЕ(Модель, Источник, Родитель)

	ПредельноеЧислоУзлов = 20000;

	Если Модель.Узлы.Количество() >= ПредельноеЧислоУзлов Тогда
		ВызватьИсключение "Превышена граница 20000 узлов ДСЕ.";
	КонецЕсли;
	Узел = Новый Структура;
	Узел.Вставить("Индекс", Модель.Узлы.Количество());
	НомерСтрокиИсточника = СвойствоИсточника(Источник, "НомерСтроки", 0);
	КлючНоменклатурыИсточника = СвойствоИсточника(Источник, "КлючНоменклатура");
	ПартияИсточника = СвойствоИсточника(Источник, "ПартияПроизводства");
	КлючПартииИсточника = СвойствоИсточника(Источник, "КлючПартия", ПартияИсточника);
	КлючИсточника = КлючЗначения(Источник.Номенклатура) + "|" + КлючЗначения(Источник.Характеристика)
		+ "|" + КлючЗначения(Источник.Назначение) + "|" + Строка(НомерСтрокиИсточника)
		+ "|" + КлючЗначения(КлючНоменклатурыИсточника) + "|" + КлючЗначения(КлючПартииИсточника);
	Если Родитель >= 0 Тогда
		КлючИсточника = Модель.Узлы[Родитель].КлючСтроки + "/" + КлючИсточника;
	КонецЕсли;
	НомерПовторения = Модель.СчетчикиКлючей.Получить(КлючИсточника);
	НомерПовторения = ?(НомерПовторения = Неопределено, 1, НомерПовторения + 1);
	Модель.СчетчикиКлючей.Вставить(КлючИсточника, НомерПовторения);
	Узел.Вставить("КлючСтроки", КлючИсточника + "#" + Формат(НомерПовторения, "ЧГ=0;ЧДЦ=0"));
	Узел.Вставить("Родитель", Родитель);
	Узел.Вставить("Уровень", 1);
	Если Родитель >= 0 Тогда
		Узел.Уровень = Модель.Узлы[Родитель].Уровень + 1;
	КонецЕсли;
	Узел.Вставить("Номенклатура", Источник.Номенклатура);
	Узел.Вставить("Характеристика", Источник.Характеристика);
	Узел.Вставить("Назначение", Источник.Назначение);
	Узел.Вставить("Представление", Источник.ПредставлениеСтроки);
	Узел.Вставить("Код", "");
	Узел.Вставить("Спецификация", Источник.Спецификация);
	Узел.Вставить("КлючиПартий", Новый Массив);
	Узел.Вставить("ПланКоличество", СвойствоИсточника(Источник, "Требуется", СвойствоИсточника(Источник, "КоличествоПлан", 0)));
	Узел.Вставить("ИсходныйПлан", Узел.ПланКоличество);
	Узел.Вставить("ИсходныйФакт", СвойствоИсточника(Источник, "Готово", СвойствоИсточника(Источник, "КоличествоФакт", 0)));
	Узел.Вставить("ЕмкостьИсточника", СвойствоИсточника(Источник, "КоличествоПланИтого", 0));
	Узел.Вставить("ГотовоИсточника", СвойствоИсточника(Источник, "КоличествоФактИтого", 0));
	Узел.Вставить("ФактКоличество", 0);
	Узел.Вставить("Выделено", 0);
	Узел.Вставить("Масштаб", 1);
	Узел.Вставить("ПланСобственный", 0);
	Узел.Вставить("ФактСобственный", 0);
	Узел.Вставить("ЗавершеноПланСобственный", 0);
	Узел.Вставить("ТрудПлан", 0);
	Узел.Вставить("ТрудФакт", 0);
	Узел.Вставить("ЗавершеноПлан", 0);
	Узел.Вставить("Полнота", Истина);
	Узел.Вставить("ДанныеТрудаПолны", Истина);
	Узел.Вставить("Начало", СвойствоИсточника(Источник, "Начало", Дата(1, 1, 1)));
	Узел.Вставить("Окончание", СвойствоИсточника(Источник, "Окончание", СвойствоИсточника(Источник, "ДатаОкончанияПлан", Дата(1, 1, 1))));
	Узел.Вставить("НачалоСобственное", Дата(1, 1, 1));
	Узел.Вставить("ОкончаниеСобственное", Дата(1, 1, 1));
	Узел.Вставить("Работы", Новый Массив);
	Узел.Вставить("ЕстьДети", Ложь);
	Модель.Узлы.Добавить(Узел);
	Если Родитель >= 0 Тогда
		Модель.Узлы[Родитель].ЕстьДети = Истина;
	КонецЕсли;
	ДобавитьКлючиУзла(Модель, Узел, Источник);
	Возврат Узел.Индекс;

КонецФункции

Процедура ДобавитьКлючиУзла(Модель, Узел, Источник)

	Если Модель.ДинамическаяСтруктура Тогда
		ОбеспечениеПартии = СвойствоИсточника(Источник, "ОбеспечениеПартии", Новый Массив);
		Для каждого КлючОбеспечения Из ОбеспечениеПартии Цикл
			ДобавитьУникально(Узел.КлючиПартий, КлючОбеспечения);
		КонецЦикла;
	Иначе
		ПартияУзла = СвойствоИсточника(Источник, "ПартияПроизводства");
		Если ЗначениеЗаполнено(ПартияУзла) Тогда
			Узел.КлючиПартий.Добавить(ПартияУзла);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьПривязкуЭтапа(Модель, Источник, Родитель)

	ИмяПоля = ?(Модель.ДинамическаяСтруктура, "ЭтапСсылка", "Этап");
	СсылкаЭтапа = СвойствоИсточника(Источник, ИмяПоля);
	Если Не ЗначениеЗаполнено(СсылкаЭтапа) Тогда
		Возврат;
	КонецЕсли;
	Привязка = Новый Структура;
	Привязка.Вставить("Узел", Родитель);
	Привязка.Вставить("Этап", СсылкаЭтапа);
	Привязка.Вставить("Партия", Неопределено);
	Если Модель.ДинамическаяСтруктура Тогда
		Привязка.Партия = СвойствоИсточника(Источник, "КлючПартия");
	Иначе
		Привязка.Партия = СвойствоИсточника(Источник, "ПартияПроизводства");
	КонецЕсли;
	Модель.ПривязкиЭтапов.Добавить(Привязка);
	КлючиУзла = Модель.Узлы[Родитель].КлючиПартий;
	Если ЗначениеЗаполнено(Привязка.Партия) И КлючиУзла.Найти(Привязка.Партия) = Неопределено Тогда
		КлючиУзла.Добавить(Привязка.Партия);
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьПараметрыЗаказа(Заказ)

	НачалоБлока = НачатьБлок("ПараметрыЗаказа");
	ЗапросДанных = Новый Запрос;
	ЗапросДанных.Текст =
		"ВЫБРАТЬ
		| Заказы.ДинамическаяСтруктура КАК ДинамическаяСтруктура,
		| Заказы.ТипПроизводственногоПроцесса КАК ТипПроцесса
		|ИЗ Документ.ЗаказНаПроизводство2_2 КАК Заказы
		|ГДЕ Заказы.Ссылка = &Заказ";
	ЗапросДанных.УстановитьПараметр("Заказ", Заказ);
	ТаблицаПараметров = ЗапросДанных.Выполнить().Выгрузить();
	Если ТаблицаПараметров.Количество() <> 1 Тогда
		ВызватьИсключение "Заказ недоступен или не найден.";
	КонецЕсли;
	Результат = Новый Структура("ДинамическаяСтруктура,ТипПроцесса");
	ЗаполнитьЗначенияСвойств(Результат, ТаблицаПараметров[0]);
	ЗавершитьБлок("ПараметрыЗаказа", НачалоБлока);
	Возврат Результат;

КонецФункции

Процедура ПрочитатьПроизводственныеДанные(Модель)

	НачалоБлока = НачатьБлок("Источники");
	ПрочитатьДокументыСлужебногоДерева(Модель);
	ПривязатьЭтапыСлужебногоДерева(Модель);
	НедостающиеСтроки = НедостающиеСвязиСлужебногоДерева(Модель);
	Модель.ЧтениеИсточников.Вставить("ВетвейБезДокументов", НедостающиеСтроки.Количество());
	Если НедостающиеСтроки.Количество() > 0 Тогда
		ПрочитатьСвязиПроизводящихПартий(Модель, НедостающиеСтроки);
		ПрочитатьДокументыСлужебногоДерева(Модель);
		ПривязатьЭтапыСлужебногоДерева(Модель);
		НедостающиеСтроки = НедостающиеСвязиСлужебногоДерева(Модель);
		ПрочитатьПлановыеСвязиСлужебногоДерева(Модель, НедостающиеСтроки);
	КонецЕсли;
	ПрочитатьПоказателиСлужебногоДерева(Модель);
	ПодготовитьЛогическиеЭтапы(Модель);
	ЗавершитьБлок("Источники", НачалоБлока);

КонецПроцедуры

Функция ВыполнитьЧтение(ЗапросДанных, ИмяИсточника)

	НачалоБлока = НачатьБлок(ИмяИсточника);
	Результат = ЗапросДанных.Выполнить().Выгрузить();
	ИтогБлока = "Строк=" + Строка(Результат.Количество());
	ЗавершитьБлок(ИмяИсточника, НачалоБлока, ИтогБлока);
	Возврат Результат;

КонецФункции

Функция КлючиЧтения(Модель)

	Результат = Новый Структура;
	Результат.Вставить("Партии", Новый Массив);
	Результат.Вставить("КлючиПартий", Новый Массив);
	Результат.Вставить("Этапы", Новый Массив);
	Результат.Вставить("Номенклатура", Новый Массив);
	Для каждого Узел Из Модель.Узлы Цикл
		ДобавитьУникально(Результат.Номенклатура, Узел.Номенклатура);
		Для каждого КлючПартии Из Узел.КлючиПартий Цикл
			Если Модель.ДинамическаяСтруктура Тогда
				ДобавитьУникально(Результат.КлючиПартий, КлючПартии);
			Иначе
				ДобавитьУникально(Результат.Партии, КлючПартии);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для каждого Привязка Из Модель.ПривязкиЭтапов Цикл
		ДобавитьУникально(Результат.Этапы, Привязка.Этап);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьУникально(Приемник, ЗначениеЭлемента)

	Если Приемник.Найти(ЗначениеЭлемента) = Неопределено Тогда
		Приемник.Добавить(ЗначениеЭлемента);
	КонецЕсли;

КонецПроцедуры

// Оперативное дерево ERP сокращается после выпуска. Документы сохраняют маршрут
// партии и ее материальный состав. Дополняем дерево до распределения количеств.
// Параметры:
//  Модель - Структура - узлы заказа и документы этапов; дополняется составом производства.
Процедура ВосстановитьДокументальнуюСтруктуру(Модель)

	Если Не Модель.ДинамическаяСтруктура Тогда
		Возврат;
	КонецЕсли;
	НачалоБлока = НачатьБлок("ДокументальнаяСтруктура");
	Индексы = ИндексыДокументальныхМаршрутов(Модель);
	МаршрутыПоИзделиям = Индексы.Изделия;
	ПрочитатьМатериалыМаршрутов(Модель, Индексы);
	// Массив дополняется потомками. Фиксированная граница защищает от циклов.
	Для ИндексУзла = 0 По 19999 Цикл
		Если ИндексУзла >= Модель.Узлы.Количество() Тогда
			Прервать;
		КонецЕсли;
		Узел = Модель.Узлы[ИндексУзла];
		КонтрольТиповогоОбхода(Узел.Уровень);
		Кандидаты = МаршрутыПоИзделиям.Получить(КлючСоставаДокументов(Узел.Номенклатура, Узел.Характеристика));
		Если Кандидаты = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МаршрутыУзла = МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты);
		Если МаршрутыУзла.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для каждого Маршрут Из МаршрутыУзла Цикл
			ПроверитьПутьДокументальнойПартии(Модель, Узел, Маршрут.КлючПартия);
		КонецЦикла;
		ПривязатьМаршрутыДокументов(Модель, Узел, МаршрутыУзла);
		Потребности = ПотребностиДокументальныхМаршрутов(МаршрутыУзла, МаршрутыПоИзделиям);
		Для каждого ЭлементПотребности Из Потребности Цикл
			ДополнитьПотомкаДокументов(Модель, Узел, ЭлементПотребности.Значение);
		КонецЦикла;
	КонецЦикла;
	ИтогБлока = "Узлов=" + Строка(Модель.Узлы.Количество());
	ЗавершитьБлок("ДокументальнаяСтруктура", НачалоБлока, ИтогБлока);

КонецПроцедуры

Функция КлючСоставаДокументов(НоменклатураСостава, ХарактеристикаСостава)
	Возврат КлючЗначения(НоменклатураСостава) + "|" + КлючЗначения(ХарактеристикаСостава);
КонецФункции

Процедура ПроверитьПутьДокументальнойПартии(Модель, Узел, КлючПартии)

	ИндексПредка = Узел.Родитель;
	Для НомерПерехода = 0 По 64 Цикл
		Если ИндексПредка < 0 Тогда
			Возврат;
		КонецЕсли;
		Предок = Модель.Узлы[ИндексПредка];
		Если Предок.КлючиПартий.Найти(КлючПартии) <> Неопределено Тогда
			ВызватьИсключение "Цикл документальных партий, переход " + Строка(НомерПерехода) + ": " + Строка(КлючПартии);
		КонецЕсли;
		ИндексПредка = Предок.Родитель;
	КонецЦикла;
	ВызватьИсключение "Превышена глубина документальной структуры 64.";

КонецПроцедуры

Процедура ПривязатьМаршрутыДокументов(Модель, Узел, МаршрутыУзла)

	// Ветка с реальным маршрутом не должна оставаться привязанной к плановому GUID.
	// Один физический маршрут может обеспечивать несколько вхождений ДСЕ:
	// объем и часы разделяет существующий общий пул, а не отдельный расчет здесь.
	Узел.КлючиПартий.Очистить();
	Для каждого Маршрут Из МаршрутыУзла Цикл
		ДобавитьУникально(Узел.КлючиПартий, Маршрут.КлючПартия);
		Для каждого СтрокаЭтапа Из Маршрут.Этапы Цикл
			УдалитьПодменяемыеПривязки(Модель, Узел, СтрокаЭтапа);
			ПараметрыСтроки = Новый Структура;
			ПараметрыСтроки.Вставить("Узел", Узел.Индекс);
			ПараметрыСтроки.Вставить("Этап", СтрокаЭтапа.Этап);
			ПараметрыСтроки.Вставить("Партия", Маршрут.КлючПартия);
			Модель.ПривязкиЭтапов.Добавить(ПараметрыСтроки);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьПотомкаДокументов(Модель, Узел, Потребность)

	Для каждого Потомок Из Модель.Узлы Цикл
		НазначениеПодходит = Потомок.Назначение = Потребность.Назначение
			Или Не ЗначениеЗаполнено(Потомок.Назначение) Или Не ЗначениеЗаполнено(Потребность.Назначение);
		ПотомокСоответствуетПотребности = Потомок.Родитель = Узел.Индекс И Потомок.Номенклатура = Потребность.Номенклатура
			И Потомок.Характеристика = Потребность.Характеристика
			И Потомок.Спецификация = Потребность.Спецификация
			И НазначениеПодходит;
		Если ПотомокСоответствуетПотребности Тогда
			Если Не Потомок.Свойство("СтрокаИсточника") Тогда
				Потомок.ИсходныйПлан = Потребность.Количество;
				Потомок.ПланКоличество = Потребность.Количество;
			КонецЕсли;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Источник = Новый Структура;
	Источник.Вставить("Номенклатура", Потребность.Номенклатура);
	Источник.Вставить("Характеристика", Потребность.Характеристика);
	Источник.Вставить("Спецификация", Потребность.Спецификация);
	Источник.Вставить("Назначение", Потребность.Назначение);
	Источник.Вставить("ПредставлениеСтроки", Строка(Потребность.Номенклатура));
	Источник.Вставить("Требуется", Потребность.Количество);
	ДобавитьУзелДСЕ(Модель, Источник, Узел.Индекс);

КонецПроцедуры

Функция ИндексыДокументальныхМаршрутов(Модель)

	ПартииМаршрутов = Новый Соответствие;
	МаршрутыПоИзделиям = Новый Соответствие;
	ЭтапыПоСсылкам = Новый Соответствие;
	Для каждого СтрокаЭтапа Из Модель.ДокументыЭтапов Цикл
		Если СтрокаЭтапа.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ЭтапыПоСсылкам.Вставить(СтрокаЭтапа.Этап, СтрокаЭтапа);
		КлючПартии = КлючЗначения(СтрокаЭтапа.КлючПартия);
		Маршрут = ПартииМаршрутов.Получить(КлючПартии);
		Если Маршрут = Неопределено Тогда
			Маршрут = Новый Структура;
			Маршрут.Вставить("Партия", СтрокаЭтапа.Партия);
			Маршрут.Вставить("КлючПартия", СтрокаЭтапа.КлючПартия);
			Маршрут.Вставить("Номенклатура", СтрокаЭтапа.Номенклатура);
			Маршрут.Вставить("Характеристика", СтрокаЭтапа.Характеристика);
			Маршрут.Вставить("Спецификация", СтрокаЭтапа.Спецификация);
			Маршрут.Вставить("Заказ", СтрокаЭтапа.Заказ);
			Маршрут.Вставить("Назначение", СтрокаЭтапа.Назначение);
			Маршрут.Вставить("Этапы", Новый Массив);
			Маршрут.Вставить("Материалы", Новый Массив);
			ПартииМаршрутов.Вставить(КлючПартии, Маршрут);
			КлючИзделия = КлючСоставаДокументов(Маршрут.Номенклатура, Маршрут.Характеристика);
			СписокМаршрутов = МаршрутыПоИзделиям.Получить(КлючИзделия);
			Если СписокМаршрутов = Неопределено Тогда
				СписокМаршрутов = Новый Массив;
				МаршрутыПоИзделиям.Вставить(КлючИзделия, СписокМаршрутов);
			КонецЕсли;
			СписокМаршрутов.Добавить(Маршрут);
		КонецЕсли;
		Маршрут.Этапы.Добавить(СтрокаЭтапа);
	КонецЦикла;
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Партии", ПартииМаршрутов);
	ПараметрыСтроки.Вставить("Изделия", МаршрутыПоИзделиям);
	ПараметрыСтроки.Вставить("Этапы", ЭтапыПоСсылкам);
	Возврат ПараметрыСтроки;

КонецФункции

Процедура ПрочитатьМатериалыМаршрутов(Модель, Индексы)

	ПартииМаршрутов = Индексы.Партии;
	ЭтапыПоСсылкам = Индексы.Этапы;
	ЗапросСостава = Новый Запрос(
		"ВЫБРАТЬ Материалы.Ссылка КАК Этап, Материалы.Номенклатура КАК Номенклатура,
		| Материалы.Характеристика КАК Характеристика, Материалы.Спецификация КАК Спецификация,
		| Материалы.НазначениеОбеспечения КАК Назначение, Материалы.Количество КАК Количество,
		| Материалы.НомерСтроки КАК НомерСтроки
		|ИЗ Документ.ЭтапПроизводства2_2.ОбеспечениеМатериаламиИРаботами КАК Материалы
		|ГДЕ Материалы.Ссылка В (&Этапы) И НЕ Материалы.Отменено
		|УПОРЯДОЧИТЬ ПО Материалы.Ссылка, Материалы.НомерСтроки");
	ЗапросСостава.УстановитьПараметр("Этапы", Модель.ДокументыЭтапов.ВыгрузитьКолонку("Этап"));
	Для каждого МатериалСостава Из ВыполнитьЧтение(ЗапросСостава, "СоставДокументов") Цикл
		ЭтапСостава = ЭтапыПоСсылкам.Получить(МатериалСостава.Этап);
		Если ЭтапСостава <> Неопределено Тогда
			ПартииМаршрутов.Получить(КлючЗначения(ЭтапСостава.КлючПартия)).Материалы.Добавить(МатериалСостава);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты)

	МаршрутыУзла = Новый Массив;
	ТочныеМаршруты = Новый Массив;
	Для каждого Маршрут Из Кандидаты Цикл
		ТочнаяПартия = Узел.КлючиПартий.Найти(Маршрут.КлючПартия) <> Неопределено
			Или Узел.КлючиПартий.Найти(Маршрут.Партия) <> Неопределено;
		РазныеНазначения = ЗначениеЗаполнено(Узел.Назначение) И ЗначениеЗаполнено(Маршрут.Назначение)
			И Узел.Назначение <> Маршрут.Назначение;
		Если Не ТочнаяПартия И РазныеНазначения Тогда
			Продолжить;
		КонецЕсли;
		ДругаяСпецификация = ЗначениеЗаполнено(Узел.Спецификация) И Маршрут.Спецификация <> Узел.Спецификация;
		ЧужойМаршрут = Маршрут.Заказ <> Модель.Заказ Или ДругаяСпецификация;
		Если Не ТочнаяПартия И ЧужойМаршрут Тогда
			Продолжить;
		КонецЕсли;
		МаршрутыУзла.Добавить(Маршрут);
		Если ТочнаяПартия Тогда
			ТочныеМаршруты.Добавить(Маршрут);
		КонецЕсли;
	КонецЦикла;
	Возврат ВыбратьОднозначныеМаршруты(Узел, ТочныеМаршруты, МаршрутыУзла);

КонецФункции

Функция ПотребностиДокументальныхМаршрутов(МаршрутыУзла, МаршрутыПоИзделиям)

	Потребности = Новый Соответствие;
	Для каждого Маршрут Из МаршрутыУзла Цикл
		Для каждого МатериалСостава Из Маршрут.Материалы Цикл
			КлючМатериала = КлючСоставаДокументов(МатериалСостава.Номенклатура, МатериалСостава.Характеристика);
			Если МаршрутыПоИзделиям.Получить(КлючМатериала) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КлючПотребности = КлючМатериала + "|" + КлючЗначения(МатериалСостава.Спецификация)
				+ "|" + КлючЗначения(МатериалСостава.Назначение);
			Потребность = Потребности.Получить(КлючПотребности);
			Если Потребность = Неопределено Тогда
				Потребность = Новый Структура;
				Потребность.Вставить("Номенклатура", МатериалСостава.Номенклатура);
				Потребность.Вставить("Характеристика", МатериалСостава.Характеристика);
				Потребность.Вставить("Спецификация", МатериалСостава.Спецификация);
				Потребность.Вставить("Назначение", МатериалСостава.Назначение);
				Потребность.Вставить("Количество", 0);
				Потребности.Вставить(КлючПотребности, Потребность);
			КонецЕсли;
			Потребность.Количество = Потребность.Количество + МатериалСостава.Количество;
		КонецЦикла;
	КонецЦикла;
	Возврат Потребности;

КонецФункции

Функция ЗапросДокументовЭтапов()

	Возврат
		"ВЫБРАТЬ
		| Этапы.Ссылка КАК Этап,
		| Этапы.Этап КАК НормативныйЭтап,
		| Этапы.ПартияПроизводства КАК Партия,

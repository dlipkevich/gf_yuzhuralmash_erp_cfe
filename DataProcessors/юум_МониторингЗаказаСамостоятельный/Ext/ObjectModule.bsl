	ВладельцыПроверки.Добавить(0);
	ДобавитьТестовыйЭтап(МодельПроверки, ПартияПроверки, 24, 8, Истина, ВладельцыПроверки);
	РаспределитьКоличества(МодельПроверки);
	РаспределитьРаботы(МодельПроверки);
	СвернутьПоказатели(МодельПроверки);
	МодельПроверки.Узлы[0].Полнота = Ложь;
	ПараметрыПроверки = ТестовыеПараметрыПредставления();

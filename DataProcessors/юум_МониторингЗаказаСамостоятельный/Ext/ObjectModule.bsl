Процедура ПроверкаДокументальныхСвязей(Протокол)

	Модель = НоваяТестоваяМодель();
	КлючПартии = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(Модель, КлючПартии, 10, -1);
	Узел = Модель.Узлы[0];
	Маршрут = Новый Структура;
	Маршрут.Вставить("Партия", Справочники.ПартииПроизводства.ПустаяСсылка());
	Маршрут.Вставить("КлючПартия", КлючПартии);
	Маршрут.Вставить("Заказ", Модель.Заказ);
	Маршрут.Вставить("Спецификация", Узел.Спецификация);
	Маршрут.Вставить("Назначение", Узел.Назначение);
	ДругойМаршрут = Новый Структура;
	ДругойМаршрут.Вставить("Партия", Маршрут.Партия);
	ДругойМаршрут.Вставить("КлючПартия", Новый УникальныйИдентификатор);
	ДругойМаршрут.Вставить("Заказ", Модель.Заказ);
	ДругойМаршрут.Вставить("Спецификация", Узел.Спецификация);
	ДругойМаршрут.Вставить("Назначение", Узел.Назначение);
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(ДругойМаршрут);
	Кандидаты.Добавить(Маршрут);
	Выбранные = МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты);
	УсловиеПроверки = Выбранные.Количество() = 1 И Выбранные[0].КлючПартия = КлючПартии;
	ПроверитьУсловие(УсловиеПроверки, "Точная партия имеет приоритет над одинаковым изделием", Протокол);
	Узел.Назначение = Справочники.Назначения.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Маршрут.Назначение = Справочники.Назначения.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Выбранные = МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты);
	УсловиеПроверки = Выбранные.Количество() = 1 И Выбранные[0].КлючПартия = КлючПартии;
	ПроверитьУсловие(УсловиеПроверки, "Точная партия сохраняется при различии назначений контекста", Протокол);
	Узел.Назначение = Маршрут.Назначение;
	Узел.КлючиПартий.Очистить();
	ДругойМаршрут.Заказ = Документы.ЗаказНаПроизводство2_2.ПолучитьСсылку(Новый УникальныйИдентификатор);
	Выбранные = МаршрутыДокументальногоУзла(Модель, Узел, Кандидаты);
	УсловиеПроверки = Выбранные.Количество() = 1 И Выбранные[0].КлючПартия = КлючПартии;
	ПроверитьУсловие(УсловиеПроверки, "Совпадение изделия не присоединяет чужой заказ", Протокол);
	Узел.КлючиПартий.Добавить(КлючПартии);
	ДобавитьТестовыйУзел(Модель, Новый УникальныйИдентификатор, 10, 0);
	ЦиклОбнаружен = Ложь;
	Попытка
		ПроверитьПутьДокументальнойПартии(Модель, Модель.Узлы[1], КлючПартии);
	Исключение
		ЦиклОбнаружен = СтрНайти(ОписаниеОшибки(), "Цикл документальных партий") > 0;

		Если Не ЦиклОбнаружен Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	ПроверитьУсловие(ЦиклОбнаружен, "Повтор партии в предке останавливает документальный обход", Протокол);

КонецПроцедуры


	Параметры.Вставить("КлючиРаскрытия", Новый Массив);
	Параметры.Вставить("СохранятьРаскрытие", Ложь);
	Параметры.Вставить("Идентификатор", "SELFTEST");
	Возврат Параметры;

КонецФункции

Процедура ПроверкаУровнейДерева(Протокол)

	МаксимальнаяГлубина = 64;

	ДиаграммаКонтроля = Новый ДиаграммаГанта;
	ТочкиКонтроля = Новый Массив;
	РодительКонтроля = Неопределено;
	Для ГлубинаКонтроля = 1 По 5 Цикл
		Если РодительКонтроля = Неопределено Тогда
			ТочкаКонтроля = ДиаграммаКонтроля.Точки.Добавить();
		Иначе
			ТочкаКонтроля = РодительКонтроля.Точки.Добавить();
		КонецЕсли;
		КлючКонтроля = "Т/" + Строка(ГлубинаКонтроля);
		ПараметрыСтроки = Новый Структура;
		ПараметрыСтроки.Вставить("Ключ", КлючКонтроля);
		ПараметрыСтроки.Вставить("Уровень", ГлубинаКонтроля);
		ПараметрыСтроки.Вставить("Идентификатор", КлючКонтроля);
		ТочкаКонтроля.Значение = ПараметрыСтроки;
		ТочкаКонтроля.Текст = "Уровень " + Строка(ГлубинаКонтроля);
		ТочкиКонтроля.Добавить(Новый Структура("Точка,Уровень", ТочкаКонтроля, ГлубинаКонтроля));
		РодительКонтроля = ТочкаКонтроля;
	КонецЦикла;
	ТочкаСоседнейВетки = ДиаграммаКонтроля.Точки[0].Точки.Добавить();
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Ключ", "С/2");
	ПараметрыСтроки.Вставить("Уровень", 2);
	ПараметрыСтроки.Вставить("Идентификатор", "С/2");
	ТочкаСоседнейВетки.Значение = ПараметрыСтроки;
	ТочкиКонтроля.Добавить(Новый Структура("Точка,Уровень", ТочкаСоседнейВетки, 2));
	ТочкаЛиста = ТочкаСоседнейВетки.Точки.Добавить();
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Ключ", "С/3");
	ПараметрыСтроки.Вставить("Уровень", 3);
	ПараметрыСтроки.Вставить("Идентификатор", "С/3");
	ТочкаЛиста.Значение = ПараметрыСтроки;
	ТочкиКонтроля.Добавить(Новый Структура("Точка,Уровень", ТочкаЛиста, 3));
	ИсходноеОбновление = ДиаграммаКонтроля.Обновление;
	НомерШага = 0;
	Для каждого УровеньКонтроля Из СтрРазделить("1,2,3,4,64,2,1", ",") Цикл
		НомерШага = НомерШага + 1;
		ГлубинаРаскрытия = Число(УровеньКонтроля);
		УстановитьУровеньРаскрытияДиаграммы(ДиаграммаКонтроля, ГлубинаРаскрытия);
		КорректноеРаскрытие = КорректноРаскрытыТочки(ДиаграммаКонтроля, ТочкиКонтроля, ГлубинаРаскрытия);
		ИмяУровня = ?(ГлубинаРаскрытия = МаксимальнаяГлубина, "Все", УровеньКонтроля);
		ТекстПроверки = "Пять уровней: кнопка " + ИмяУровня + ", шаг " + Строка(НомерШага);
		ПроверитьУсловие(КорректноеРаскрытие И ДиаграммаКонтроля.Обновление = ИсходноеОбновление, ТекстПроверки, Протокол);
	КонецЦикла;

КонецПроцедуры

Функция КорректноРаскрытыТочки(ДиаграммаКонтроля, ТочкиКонтроля, ГлубинаРаскрытия)

	КорректноеРаскрытие = Истина;
	Для каждого ЗаписьКонтроля Из ТочкиКонтроля Цикл
		Если ЗаписьКонтроля.Точка.Точки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ОжидаетсяРаскрытие = ЗаписьКонтроля.Уровень < ГлубинаРаскрытия;
		Если ДиаграммаКонтроля.РазвернутаТочка(ЗаписьКонтроля.Точка) <> ОжидаетсяРаскрытие Тогда
			КорректноеРаскрытие = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат КорректноеРаскрытие;

КонецФункции

Процедура ПроверкаГраницыФакта(Протокол)

	ОжидаемыйПланЭтапа = 28;
	ОжидаемыйФакт = 12;
	ОжидаемоеКоличествоПервогоВхождения = 4;

	Модель = НоваяТестоваяМодель();
	Партия = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(Модель, Партия, 10, -1);
	ДобавитьТестовыйОбъем(Модель, Партия, 10, 0);
	Владельцы = Новый Массив;
	Владельцы.Добавить(0);
	ДобавитьТестовыйЭтап(Модель, Партия, 0, 0, Ложь, Владельцы);
	ПоляЕдиницы = ",ВременнаяЕдиница,ЧислительВремени,ЗнаменательВремени";
	Модель.Вставить("НормативныеРаботы", ТестоваяТаблица("Этап,Партия,КлючПартия,Количество,Норма,Кратность" + ПоляЕдиницы));
	Модель.Вставить("РаботыДокументов", ТестоваяТаблица("Этап,Количество,Норма,Кратность,Выполнено,Отменено" + ПоляЕдиницы));
	Модель.Вставить("Выработка", ТестоваяТаблица("Этап,ВидРабот,Количество,Норма,Кратность,ПоОперации" + ПоляЕдиницы));
	ЗакрытыйДокумент = ДобавитьДокументГраницы(Модель, Партия, Истина, Истина, Ложь);
	ОткрытыйДокумент = ДобавитьДокументГраницы(Модель, Партия, Истина, Ложь, Ложь);
	НепроведенныйДокумент = ДобавитьДокументГраницы(Модель, Партия, Ложь, Истина, Ложь);
	ДобавитьРаботуГраницы(Модель, ЗакрытыйДокумент, 8, 1.5, Ложь);
	ДобавитьРаботуГраницы(Модель, ОткрытыйДокумент, 8, 1, Ложь);
	ДобавитьРаботуГраницы(Модель, НепроведенныйДокумент, 8, 1, Ложь);
	ДобавитьРаботуГраницы(Модель, ЗакрытыйДокумент, 100, 1, Истина);
	ПодсчитатьРаботыЭтапов(Модель);
	ПодсчитатьВыработкуЭтапов(Модель);
	ПроверитьУсловие(Модель.Этапы[0].План = ОжидаемыйПланЭтапа, "Отмененная работа не включена в план", Протокол);
	ПроверитьУсловие(Модель.Этапы[0].Факт = ОжидаемыйФакт, "Факт 1.5 * 8 = 12 только закрытого проведенного документа", Протокол);
	ПроверитьУсловие(Не Модель.Этапы[0].Закрыт И Модель.Этапы[0].ЗавершеноПлан = ОжидаемыйФакт,
		"Открытые документы и документы без проведения не закрывают логический этап", Протокол);
	НормаПроверки = Новый Структура;
	НормаПроверки.Вставить("Количество", 3);
	НормаПроверки.Вставить("Норма", 8);
	НормаПроверки.Вставить("Кратность", 2);
	НормаПроверки.Вставить("ВременнаяЕдиница", Ложь);
	УсловиеПроверки = ЧасыРаботы(НормаПроверки, Модель.Этапы[0]) = ОжидаемыйФакт;
	ПроверитьУсловие(УсловиеПроверки, "Кратность нормы: 3 * 8 / 2 = 12", Протокол);
	Изделие = Модель.ВыходныеИзделия.Добавить();
	Изделие.Этап = ОткрытыйДокумент;
	Изделие.Номенклатура = Модель.Узлы[0].Номенклатура;
	Изделие.Характеристика = Модель.Узлы[0].Характеристика;
	Изделие.Количество = 4;
	Изделие.Произведено = Истина;
	Изделие.Отменено = Ложь;
	РаспределитьКоличества(Модель);
	ПроверитьУсловие(Модель.Узлы[0].ФактКоличество = ОжидаемоеКоличествоПервогоВхождения, "Частичный выпуск виден при незакрытом этапе", Протокол);

КонецПроцедуры

Функция ДобавитьДокументГраницы(Модель, Партия, Проведен, Завершен, ПометкаУдаления)

	СсылкаДокумента = Документы.ЭтапПроизводства2_2.ПолучитьСсылку(Новый УникальныйИдентификатор);
	ДокументПроверки = Новый Структура;
	ДокументПроверки.Вставить("Этап", СсылкаДокумента);
	ДокументПроверки.Вставить("НормативныйЭтап", Справочники.ЭтапыПроизводства.ПустаяСсылка());
	ДокументПроверки.Вставить("Партия", Справочники.ПартииПроизводства.ПустаяСсылка());
	ДокументПроверки.Вставить("КлючПартия", Партия);
	ДокументПроверки.Вставить("ДинамическаяСтруктура", Ложь);
	ДокументПроверки.Вставить("ВыработкаПоОперациям", Ложь);
	ДокументПроверки.Вставить("Проведен", Проведен);
	ДокументПроверки.Вставить("Завершен", Завершен);
	ДокументПроверки.Вставить("Выпускающий", Истина);
	ДокументПроверки.Вставить("ПометкаУдаления", ПометкаУдаления);
	ДокументПроверки.Вставить("ФактическоеНачало", Дата(1, 1, 1));
	ДокументПроверки.Вставить("ФактическоеОкончание", Дата(1, 1, 1));
	Модель.ДокументыПоСсылке.Вставить(СсылкаДокумента, ДокументПроверки);
	ПрисоединитьДокументЭтапа(Модель, Модель.Этапы[0], ДокументПроверки);
	Возврат СсылкаДокумента;

КонецФункции

Процедура ДобавитьРаботуГраницы(Модель, СсылкаДокумента, Количество, Норма, Отменено)

	СтрокаРаботы = Модель.РаботыДокументов.Добавить();
	СтрокаРаботы.Этап = СсылкаДокумента;
	СтрокаРаботы.Количество = Количество;
	СтрокаРаботы.Норма = Норма;
	СтрокаРаботы.ВременнаяЕдиница = Ложь;
	СтрокаРаботы.Кратность = 1;
	СтрокаРаботы.Выполнено = Истина;
	СтрокаРаботы.Отменено = Отменено;

КонецПроцедуры

// Строка этапа может появиться из норматива, без строки этапа в типовом дереве.
// Документ уже прочитан: его надо связать после создания нормативной строки.
// Параметры:
//  Протокол - Массив - результаты проверок, пополняется процедурой.
Процедура ПроверкаПривязкиНормативногоЭтапа(Протокол)

	Для РежимСтруктуры = 0 По 1 Цикл
		Модель = НоваяТестоваяМодель();
		Модель.ДинамическаяСтруктура = РежимСтруктуры = 1;
		КлючПартии = Новый УникальныйИдентификатор;
		ПартияСсылка = Справочники.ПартииПроизводства.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ПартияВладельца = ?(Модель.ДинамическаяСтруктура, КлючПартии, ПартияСсылка);
		ДобавитьТестовыйУзел(Модель, ПартияВладельца, 1, -1);
		Если Не Модель.ДинамическаяСтруктура Тогда
			Модель.Узлы[0].КлючиПартий.Добавить(ПартияСсылка);
		КонецЕсли;
		НормативныйЭтап = Справочники.ЭтапыПроизводства.ПолучитьСсылку(Новый УникальныйИдентификатор);
		СсылкаДокумента = Документы.ЭтапПроизводства2_2.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ПоляДокумента = "Этап,НормативныйЭтап,Партия,КлючПартия,ПометкаУдаления,ДинамическаяСтруктура,"
			+ "ВыработкаПоОперациям,ФактическоеНачало,ФактическоеОкончание,Проведен,Завершен,Выпускающий";
		Модель.Вставить("ДокументыЭтапов", ТестоваяТаблица(ПоляДокумента));
		СтрокаДокумента = Модель.ДокументыЭтапов.Добавить();
		СтрокаДокумента.Этап = СсылкаДокумента;
		СтрокаДокумента.НормативныйЭтап = НормативныйЭтап;
		СтрокаДокумента.Партия = ПартияСсылка;
		СтрокаДокумента.КлючПартия = КлючПартии;
		СтрокаДокумента.ПометкаУдаления = Ложь;
		СтрокаДокумента.ДинамическаяСтруктура = Модель.ДинамическаяСтруктура;
		СтрокаДокумента.ВыработкаПоОперациям = Ложь;
		СтрокаДокумента.ФактическоеНачало = Дата(1, 1, 1);
		СтрокаДокумента.ФактическоеОкончание = Дата(1, 1, 1);
		СтрокаДокумента.Проведен = Истина;
		СтрокаДокумента.Завершен = Ложь;
		ЧужойДокумент = Модель.ДокументыЭтапов.Добавить();
		ЗаполнитьЗначенияСвойств(ЧужойДокумент, СтрокаДокумента);
		ЧужойДокумент.Этап = Документы.ЭтапПроизводства2_2.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ЧужойДокумент.Партия = Справочники.ПартииПроизводства.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ЧужойДокумент.КлючПартия = Новый УникальныйИдентификатор;
		ПоляЕдиницы = ",ВременнаяЕдиница,ЧислительВремени,ЗнаменательВремени";
		Модель.Вставить("НормативныеРаботы", ТестоваяТаблица("Этап,Партия,КлючПартия,Количество,Норма,Кратность" + ПоляЕдиницы));
		НормаРаботы = Модель.НормативныеРаботы.Добавить();
		НормаРаботы.Этап = НормативныйЭтап;
		НормаРаботы.Партия = ПартияСсылка;
		НормаРаботы.КлючПартия = КлючПартии;
		НормаРаботы.Количество = 8;
		НормаРаботы.ВременнаяЕдиница = Истина;
		НормаРаботы.ЧислительВремени = 3600;
		НормаРаботы.ЗнаменательВремени = 1;
		Модель.Вставить("РаботыДокументов", ТестоваяТаблица("Этап,Количество,Норма,Кратность,Выполнено,Отменено" + ПоляЕдиницы));
		Модель.Вставить("Выработка", ТестоваяТаблица("Этап,ВидРабот,Количество,Норма,Кратность,ПоОперации" + ПоляЕдиницы));
		Модель.Вставить("ГрафикЭтапов", ТестоваяТаблица("Этап,КлючПартия,Начало,Окончание"));
		ПодготовитьЛогическиеЭтапы(Модель);
		СуффиксПроверки = ?(Модель.ДинамическаяСтруктура, " (динамическая)", " (статическая)");
		УсловиеПроверки = Модель.Этапы.Количество() = 1;
		ПроверитьУсловие(УсловиеПроверки, "Норматив создал одну строку этапа" + СуффиксПроверки, Протокол);
		ЭтапПроверки = Модель.Этапы[0];
		УсловиеПроверки = ЭтапПроверки.Документы.Найти(СсылкаДокумента) <> Неопределено;
		ПроверитьУсловие(УсловиеПроверки, "Документ связан с этапом, добавленным из норматива" + СуффиксПроверки, Протокол);
		УсловиеПроверки = ЭтапПроверки.Документы.Количество() = 1
			И Модель.ДокументКЭтапу.Получить(ЧужойДокумент.Этап) = Неопределено;
		ПроверитьУсловие(УсловиеПроверки, "Документ другой партии не присоединен" + СуффиксПроверки, Протокол);
		УсловиеПроверки = Модель.ДокументКЭтапу.Получить(СсылкаДокумента) = 0;
		ПроверитьУсловие(УсловиеПроверки, "Индекс документа ведет в нормативный этап" + СуффиксПроверки, Протокол);
		УсловиеПроверки = ЭтапПроверки.План = ?(Модель.ДинамическаяСтруктура, 8, 0);
		ПроверитьУсловие(УсловиеПроверки, "План нормативного этапа по правилу структуры" + СуффиксПроверки, Протокол);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверкаЕдиницТрудозатрат(Протокол)

	ОжидаемыеЧасы = 1.5;
	ОжидаемыеЧасыПоНорме = 12;

	ЭтапПроверки = Новый Структура("Полнота", Истина);
	РаботаПроверки = Новый Структура;
	РаботаПроверки.Вставить("Количество", 5400);
	РаботаПроверки.Вставить("Норма", 1);
	РаботаПроверки.Вставить("Кратность", 3600);
	РаботаПроверки.Вставить("ВременнаяЕдиница", Истина);
	РаботаПроверки.Вставить("ЧислительВремени", 1);
	РаботаПроверки.Вставить("ЗнаменательВремени", 1);
	УсловиеПроверки = ЧасыРаботы(РаботаПроверки, ЭтапПроверки) = ОжидаемыеЧасы;
	ПроверитьУсловие(УсловиеПроверки, "5400 секунд = 1.5 часа", Протокол);
	РаботаПроверки.Количество = 90;
	РаботаПроверки.ЧислительВремени = 60;
	УсловиеПроверки = ЧасыРаботы(РаботаПроверки, ЭтапПроверки) = ОжидаемыеЧасы;
	ПроверитьУсловие(УсловиеПроверки, "90 минут = 1.5 часа независимо от записанной нормы", Протокол);
	РаботаПроверки.Количество = 1.5;
	РаботаПроверки.ЧислительВремени = 3600;
	РаботаПроверки.Кратность = 1;
	УсловиеПроверки = ЧасыРаботы(РаботаПроверки, ЭтапПроверки) = ОжидаемыеЧасы;
	ПроверитьУсловие(УсловиеПроверки, "1.5 часа не делятся на 3600 повторно", Протокол);
	РаботаПроверки.Количество = 3;
	РаботаПроверки.ВременнаяЕдиница = Ложь;
	РаботаПроверки.Норма = 8;
	РаботаПроверки.Кратность = 2;
	УсловиеПроверки = ЧасыРаботы(РаботаПроверки, ЭтапПроверки) = ОжидаемыеЧасыПоНорме;
	ПроверитьУсловие(УсловиеПроверки, "Штучная работа: 3 * 8 человеко-часов / 2 = 12 часов", Протокол);
	РаботаПроверки.ВременнаяЕдиница = Истина;
	РаботаПроверки.ЗнаменательВремени = 0;
	УсловиеПроверки = ЧасыРаботы(РаботаПроверки, ЭтапПроверки) = 0 И Не ЭтапПроверки.Полнота;
	ПроверитьУсловие(УсловиеПроверки, "Неизвестный коэффициент времени помечает неполноту", Протокол);
	ПроверкаСмешанныхЕдиниц(Протокол);

КонецПроцедуры

Процедура ПроверкаСмешанныхЕдиниц(Протокол)

	ОжидаемыеЧасы = 1.5;

	МодельПроверки = НоваяТестоваяМодель();
	ПартияПроверки = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(МодельПроверки, ПартияПроверки, 1, -1);
	ВладельцыПроверки = Новый Массив;
	ВладельцыПроверки.Добавить(0);
	ДобавитьТестовыйЭтап(МодельПроверки, ПартияПроверки, 0, 0, Истина, ВладельцыПроверки);
	ПоляЕдиницы = ",ВременнаяЕдиница,ЧислительВремени,ЗнаменательВремени";
	МодельПроверки.Вставить("НормативныеРаботы", ТестоваяТаблица("Этап,Партия,КлючПартия,Количество,Норма,Кратность" + ПоляЕдиницы));
	МодельПроверки.Вставить("РаботыДокументов", ТестоваяТаблица("Этап,Количество,Норма,Кратность,Выполнено,Отменено" + ПоляЕдиницы));
	МодельПроверки.Вставить("Выработка", ТестоваяТаблица("Этап,ВидРабот,Количество,Норма,Кратность,ПоОперации" + ПоляЕдиницы));
	ДокументПроверки = ДобавитьДокументГраницы(МодельПроверки, ПартияПроверки, Истина, Истина, Ложь);
	ДобавитьРаботуГраницы(МодельПроверки, ДокументПроверки, 90, 1, Ложь);
	СтрокаПлана = МодельПроверки.РаботыДокументов[0];
	СтрокаПлана.ВременнаяЕдиница = Истина;
	СтрокаПлана.ЧислительВремени = 60;
	СтрокаПлана.ЗнаменательВремени = 1;
	СтрокаФакта = МодельПроверки.Выработка.Добавить();
	СтрокаФакта.Этап = ДокументПроверки;
	СтрокаФакта.ВидРабот = Новый УникальныйИдентификатор;
	СтрокаФакта.Количество = 5400;
	СтрокаФакта.Норма = 1;
	СтрокаФакта.Кратность = 3600;
	СтрокаФакта.ВременнаяЕдиница = Истина;
	СтрокаФакта.ЧислительВремени = 1;
	СтрокаФакта.ЗнаменательВремени = 1;
	СтрокаФакта.ПоОперации = Ложь;
	ПодсчитатьРаботыЭтапов(МодельПроверки);
	ПодсчитатьВыработкуЭтапов(МодельПроверки);
	ПроверитьУсловие(МодельПроверки.Этапы[0].План = ОжидаемыеЧасы И МодельПроверки.Этапы[0].Факт = ОжидаемыеЧасы,
		"План 90 минут и факт 5400 секунд дают по 1.5 часа без двойного счета", Протокол);

КонецПроцедуры

// Процент отдельного этапа не зависит от неполноты остального состава узла.
// Параметры:
//  Протокол - Массив - результаты проверок, пополняется процедурой.
Процедура ПроверкаИсходногоЧТЗ(Протокол)

	ОжидаемаяШиринаДня = 32;

	МодельПроверки = НоваяТестоваяМодель();
	ПартияПроверки = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(МодельПроверки, ПартияПроверки, 1, -1);
	ДобавитьТестовыйОбъем(МодельПроверки, ПартияПроверки, 1, 1);
	ВладельцыПроверки = Новый Массив;
	ВладельцыПроверки.Добавить(0);
	ДобавитьТестовыйЭтап(МодельПроверки, ПартияПроверки, 24, 24, Истина, ВладельцыПроверки);
	ВыпускнойЭтап = МодельПроверки.Этапы[0];
	ПромежуточныйЭтап = НайтиСоздатьЭтап(МодельПроверки, ПартияПроверки,
		Новый УникальныйИдентификатор);
	ПромежуточныйЭтап.Представление = "Незавершенный промежуточный этап";
	ПромежуточныйЭтап.Владельцы.Добавить(0);
	ПромежуточныйЭтап.План = 6;
	ПромежуточныйЭтап.Начало = Дата(2026, 10, 21, 8, 0, 0);
	ПромежуточныйЭтап.Окончание = Дата(2026, 10, 22, 18, 0, 0);
	РаспределитьКоличества(МодельПроверки);
	РаспределитьРаботы(МодельПроверки);
	СвернутьПоказатели(МодельПроверки);
	УсловиеПроверки = ДетальПолностьюИзготовлена(МодельПроверки, МодельПроверки.Узлы[0]);
	ПроверитьУсловие(УсловиеПроверки, "ЧТЗ 15.5: закрытый выпускной этап и полный выпуск делают деталь зеленой", Протокол);
	МодельПроверки.Узлы[0].ФактКоличество = 0.5;
	УсловиеПроверки = Не ДетальПолностьюИзготовлена(МодельПроверки, МодельПроверки.Узлы[0]);
	ПроверитьУсловие(УсловиеПроверки, "ЧТЗ 15.5: частичный выпуск остается синим", Протокол);
	МодельПроверки.Узлы[0].ФактКоличество = 1;
	ВыпускнойЭтап.ЗакрытДокументами = Ложь;
	УсловиеПроверки = Не ДетальПолностьюИзготовлена(МодельПроверки, МодельПроверки.Узлы[0]);
	ПроверитьУсловие(УсловиеПроверки, "ЧТЗ 15.5: открытый выпускной этап не делает деталь зеленой", Протокол);
	ВыпускнойЭтап.ЗакрытДокументами = Истина;
	МодельПроверки.Узлы[0].ЕстьДети = Истина;
	ПараметрыПроверки = ТестовыеПараметрыПредставления();
	ДиаграммаПроверки = ПостроитьДиаграмму(МодельПроверки, ПараметрыПроверки);
	ДанныеПроверки = ДанныеПредставления(ДиаграммаПроверки, МодельПроверки, 64, 0, 0, 32);
	ЕстьЗеленый = Ложь;
	ЕстьСиний = Ложь;
	Для каждого ИнтервалПроверки Из ДанныеПроверки.rows[0].intervals Цикл
		ЕстьЗеленый = ЕстьЗеленый Или ИнтервалПроверки.color = "green";
		ЕстьСиний = ЕстьСиний Или ИнтервалПроверки.color = "blue";
	КонецЦикла;
	ПроверитьУсловие(ЕстьЗеленый И ЕстьСиний,
		"ЧТЗ 13,15: собственные этапы сохраняют зеленый и синий цвета на узле", Протокол);
	ПроверитьУсловие(ДанныеПроверки.dayWidth = ОжидаемаяШиринаДня,
		"ЧТЗ 14: масштаб календаря передается в HTML", Протокол);
	НесвязаннаяРабота = Новый Структура("КлючПартия,Партия", Новый УникальныйИдентификатор, Неопределено);
	ОтметитьНеполнотуСостава(МодельПроверки, НесвязаннаяРабота);
	ПроверитьУсловие(МодельПроверки.Узлы[0].ДанныеТрудаПолны,
		"Чужая партия не обесценивает труд независимой ДСЕ", Протокол);
	СвязаннаяРабота = Новый Структура("КлючПартия,Партия", ПартияПроверки, Неопределено);
	ОтметитьНеполнотуСостава(МодельПроверки, СвязаннаяРабота);
	ПроверитьУсловие(Не МодельПроверки.Узлы[0].ДанныеТрудаПолны,
		"Неизвестная работа своей партии влияет на полноту собственного труда", Протокол);

КонецПроцедуры

Процедура ПроверкаПолнотыОтдельногоЭтапа(Протокол)

	МодельПроверки = НоваяТестоваяМодель();
	ПартияПроверки = Новый УникальныйИдентификатор;
	ДобавитьТестовыйУзел(МодельПроверки, ПартияПроверки, 1, -1);
	ДобавитьТестовыйОбъем(МодельПроверки, ПартияПроверки, 1, 1);

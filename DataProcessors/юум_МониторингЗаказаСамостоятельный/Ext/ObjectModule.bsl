// Проверяет ограниченное резервное чтение, удаляя полноту только в копии модели в памяти.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - существующий контрольный заказ.
// Возвращаемое значение:
//  Строка - JSON со счетчиками и количеством прочитанных резервных строк.
Функция ПроверитьРезервныеИсточники(Заказ) Экспорт

	Модель = СформироватьМодель(Заказ, "FALLBACK-" + Строка(Новый УникальныйИдентификатор), Истина);
	Модель.ПривязкиЭтапов.Очистить();
	НедостающиеСтроки = НедостающиеСвязиСлужебногоДерева(Модель);
	ПрочитатьСвязиПроизводящихПартий(Модель, НедостающиеСтроки);
	ПрочитатьПлановыеСвязиСлужебногоДерева(Модель, НедостающиеСтроки);
	Модель.ДокументыЭтапов = Модель.ДокументыЭтапов.СкопироватьКолонки();
	Модель.РаботыДокументов = Модель.РаботыДокументов.СкопироватьКолонки();
	Модель.ВыходныеИзделия = Модель.ВыходныеИзделия.СкопироватьКолонки();
	ПрочитатьНедостающиеОбъемы(Модель);
	ПрочитатьНедостающиеНормативы(Модель);
	Результат = Новый Структура;
	Результат.Вставить("Чтение", Модель.ЧтениеИсточников);
	Результат.Вставить("ОтборСтрок", НедостающиеСтроки.Количество());
	Результат.Вставить("ПрочитаноНормативов", Модель.НормативныеРаботы.Количество());
	Результат.Вставить("ПрочитаноОбъемов", Модель.ОбъемыПартий.Количество());
	ЗаписьРезультата = Новый ЗаписьJSON;
	ЗаписьРезультата.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьРезультата, Результат);
	Возврат ЗаписьРезультата.Закрыть();

КонецФункции


// Возвращает счетчики чтения и итоги модели, не изменяя данные базы.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - проверяемый заказ.
// Возвращаемое значение:
//  Строка - JSON со счетчиками запросов и итогами корня.
Функция ПроверитьПриоритетИсточников(Заказ) Экспорт

	Модель = СформироватьМодель(Заказ, "PRIORITY-" + Строка(Новый УникальныйИдентификатор), Истина);
	Результат = Новый Структура;
	Результат.Вставить("Чтение", Модель.ЧтениеИсточников);
	Результат.Вставить("Узлов", Модель.Узлы.Количество());
	Результат.Вставить("Предупреждения", Модель.Предупреждения);
	Если Модель.Узлы.Количество() > 0 Тогда
		Результат.Вставить("План", Модель.Узлы[0].ТрудПлан);
		Результат.Вставить("Факт", Модель.Узлы[0].ТрудФакт);
	КонецЕсли;
	ЗаписьРезультата = Новый ЗаписьJSON;
	ЗаписьРезультата.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьРезультата, Результат);
	Возврат ЗаписьРезультата.Закрыть();

КонецФункции


// Возвращает контрольные итоги выбранного заказа без записи данных.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - проверяемый заказ.
// Возвращаемое значение:
//  Строка - JSON с составом, часами и предупреждениями.
Функция ПроверитьСлужебныйЗаказ(Заказ) Экспорт

	Модель = СформироватьМодель(Заказ, "CUSTOM-" + Строка(Новый УникальныйИдентификатор));
	Результат = Новый Структура("Узлы,Предупреждения", Новый Массив, Модель.Предупреждения);
	ПоляПроверки = "Индекс,Родитель,Уровень,Представление,ПланКоличество,ФактКоличество,ТрудПлан,ТрудФакт,"
		+ "ПланСобственный,ФактСобственный";
	Для каждого Узел Из Модель.Узлы Цикл
		СтрокаПроверки = Новый Структура(ПоляПроверки);
		ЗаполнитьЗначенияСвойств(СтрокаПроверки, Узел);
		СсылкаИсточника = Неопределено;
		Если Узел.Свойство("СтрокаИсточника", СсылкаИсточника) Тогда
			СтрокаПроверки.Вставить("Источник", Строка(СсылкаИсточника.УникальныйИдентификатор()));
		Иначе
			СтрокаПроверки.Вставить("Источник", "ДокументыЭтапов");
		КонецЕсли;
		СтрокаПроверки.Вставить("Партий", Узел.КлючиПартий.Количество());
		СтрокаПроверки.Вставить("Этапов", Узел.Работы.Количество());
		Результат.Узлы.Добавить(СтрокаПроверки);
	КонецЦикла;
	ЗаписьРезультата = Новый ЗаписьJSON;
	ЗаписьРезультата.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьРезультата, Результат);
	Возврат ЗаписьРезультата.Закрыть();

КонецФункции

// Создает объемный пример в памяти, без документов и движений.
// Возвращаемое значение:
//  Структура - модель 192 ДСЕ для проверки той же формы и построителей.
Функция ПроверочнаяМодельБольшогоДерева() Экспорт

	Модель = НоваяТестоваяМодель();
	КонтекстОбхода = НовыйКонтекстОбхода(Модель.Заказ, Строка(Новый УникальныйИдентификатор));
	ЧислоДочернихДСЕ = 191;
	БольшоеКоличество = 12345678.123;
	БольшойВыпуск = 4938271.249;
	Для ИндексПримера = 0 По ЧислоДочернихДСЕ Цикл
		РодительПримера = ?(ИндексПримера = 0, -1, 0);
		Если ИндексПримера > 0 И ИндексПримера <= 4 Тогда
			РодительПримера = ИндексПримера - 1;
		КонецЕсли;
		ПартияПримера = Новый УникальныйИдентификатор;
		ДобавитьТестовыйУзел(Модель, ПартияПримера, БольшоеКоличество, РодительПримера);
		ДобавитьТестовыйОбъем(Модель, ПартияПримера, БольшоеКоличество, БольшойВыпуск);
		УзелПримера = Модель.Узлы[ИндексПримера];
		УзелПримера.Представление = "ДСЕ " + Строка(ИндексПримера)
			+ " - Сборочная единица привода механизма подачи с редуктором и комплектом монтажных деталей, исполнение 01";
		УзелПримера.Код = "ДЛИННЫЙ-КОД-" + Строка(ИндексПримера);
		ВладельцыПримера = Новый Массив;
		ВладельцыПримера.Добавить(ИндексПримера);
		ПланПримера = 11069.427;
		ФактПримера = 6297.796;
		Если ИндексПримера = 8 Тогда
			ПланПримера = 120;
			ФактПримера = 130;
		ИначеЕсли ИндексПримера = 9 Тогда
			ПланПримера = 0;
			ФактПримера = 0;
		Иначе
			ФактПримера = ?(ИндексПримера % 3 = 0, 0, ФактПримера);
		КонецЕсли;
		ДобавитьТестовыйЭтап(Модель, ПартияПримера, ПланПримера, ФактПримера, ФактПримера > 0, ВладельцыПримера);
		Модель.Этапы[ИндексПримера].Представление = "Этап " + Строка(ИндексПримера)
			+ " - Механическая обработка и контроль геометрии корпусных деталей на оборудовании участка";
	КонецЦикла;
	РаспределитьКоличества(Модель);
	РаспределитьРаботы(Модель);
	СвернутьПоказатели(Модель);
	Возврат Модель;

КонецФункции

// Читает производственные данные и формирует модель без изменения учета.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - выбранный заказ.
//  Идентификатор - Строка - идентификатор диагностического сеанса.
//  РежимДиагностики - Булево - записывать подробную трассировку в журнал регистрации.
// Возвращаемое значение:
//  Структура - узлы, этапы, распределения и предупреждения.
Функция СформироватьМодель(Заказ, Идентификатор, РежимДиагностики = Ложь) Экспорт

	КонтекстОбхода = НовыйКонтекстОбхода(Заказ, Идентификатор, РежимДиагностики);
	НачалоБлока = НачатьБлок("Расчет");
	Попытка
		Модель = НоваяМодель(Заказ);
		ПрочитатьПараметрыЗаказа(Заказ);
		// Служебный источник хранит UUID партий независимо от режима заказа.
		Модель.ДинамическаяСтруктура = Истина;
		ПостроитьСлужебнуюСтруктуру(Модель);
		ПрочитатьПроизводственныеДанные(Модель);
		РаспределитьКоличества(Модель);
		РаспределитьРаботы(Модель);
		СвернутьПоказатели(Модель);
		ИтогБлока = "Узлов=" + Строка(Модель.Узлы.Количество());
		ЗавершитьБлок("Расчет", НачалоБлока, ИтогБлока);
		Возврат Модель;
	Исключение
		ЗаписатьОшибкуРасчета("Расчет", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Записывает этап отображения в тот же диагностический сеанс.
// Параметры:
//  Блок - Строка - имя блока.
//  Фаза - Строка - начало, конец или ошибка.
//  Подробности - Строка - диагностические сведения.
Процедура ДиагностикаПредставления(Блок, Фаза, Подробности) Экспорт

	Если КонтекстОбхода <> Неопределено Тогда
		ЗаписатьСлед(Блок, Фаза, Подробности);
	КонецЕсли;

КонецПроцедуры

// Строит диаграмму по уже рассчитанной модели, не перечитывая учетные источники.
// Параметры:
//  Модель - Структура - результат СформироватьМодель.
//  Параметры - Структура - отборы, глубина и ключи раскрытых ветвей.
// Возвращаемое значение:
//  ДиаграммаГанта - готовое представление.
Функция ПостроитьДиаграмму(Модель, Параметры) Экспорт

	РежимДиагностики = Ложь;
	Если Параметры.Свойство("РежимДиагностики") Тогда
		РежимДиагностики = Параметры.РежимДиагностики;
	КонецЕсли;
	КонтекстОбхода = НовыйКонтекстОбхода(Модель.Заказ, Параметры.Идентификатор, РежимДиагностики);
	НачалоБлока = НачатьБлок("Представление");
	ДиаграммаПредставления = НоваяДиаграммаПредставления();
	ИсходноеОбновление = ДиаграммаПредставления.Обновление;
	ДиаграммаПредставления.Обновление = Ложь;
	Попытка
		СерияРабот = ДиаграммаПредставления.Серии.Добавить();
		СерияРабот.Текст = "";
		ВидимыеУзлы = ОтобратьУзлы(Модель, Параметры);
		Модель.Вставить("КартинкиИндикатора", Новый Соответствие);
		ТочкиУзлов = Новый Соответствие;
		Для каждого Узел Из Модель.Узлы Цикл
			КонтрольТиповогоОбхода(Узел.Уровень);
			Если ВидимыеУзлы.Получить(Узел.Индекс) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьТочкуУзла(Модель, Узел, Параметры, ДиаграммаПредставления, СерияРабот, ТочкиУзлов);
		КонецЦикла;
		Если ЗначениеЗаполнено(Модель.Начало) И ЗначениеЗаполнено(Модель.Окончание) Тогда
			ДиаграммаПредставления.УстановитьПолныйИнтервал(НачалоДня(Модель.Начало), КонецДня(Модель.Окончание));
		КонецЕсли;
		ПоказатьТекущуюДату(ДиаграммаПредставления, Модель.РабочаяДата);
		ДиаграммаПредставления.Обновление = ИсходноеОбновление;
	Исключение
		ДиаграммаПредставления.Обновление = ИсходноеОбновление;
		ЗаписатьОшибкуРасчета("Представление", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьБлок("Представление", НачалоБлока);
	Возврат ДиаграммаПредставления;

КонецФункции

// Преобразует готовую диаграмму в автономный HTML без чтения учетных источников.
// Параметры:
//  ДиаграммаПредставления - ДиаграммаГанта - результат ПостроитьДиаграмму.
//  Модель - Структура - календарные границы и рабочая дата.
//  Уровень - Число - последняя выбранная глубина.
//  ПозицияВертикаль - Число - прокрутка в пикселях.
//  ПозицияГоризонталь - Число - прокрутка в пикселях.
//  ШиринаДня - Число - масштаб календаря в пикселях на день, от 8 до 40.
//  ШириныКолонок - Массив из Число, Неопределено - ширины шести колонок показателей в пикселях.
// Возвращаемое значение:
//  Структура - Документ и СериализованныеКлючиРаскрытия.
Функция СформироватьПредставление(ДиаграммаПредставления, Модель, Уровень,
	ПозицияВертикаль = 0, ПозицияГоризонталь = 0, ШиринаДня = 20, ШириныКолонок = Неопределено) Экспорт

	НачалоБлока = НачатьБлок("HTMLПредставление");
	Попытка
		ДанныеПредставления = ДанныеПредставления(ДиаграммаПредставления, Модель, Уровень,
			ПозицияВертикаль, ПозицияГоризонталь, ШиринаДня);
		ШириныПредставления = НормализованныеШириныКолонок(ШириныКолонок);
		ДанныеПредставления.Вставить("columnWidths", ШириныПредставления);
		МакетПредставления = ПолучитьМакет("ПредставлениеHTML");
		ДокументПредставления = СтрЗаменить(МакетПредставления.ПолучитьТекст(), "__DATA__", БезопасныеДанныеПредставления(ДанныеПредставления));
		КлючиРаскрытия = БезопасныеДанныеПредставления(ДанныеПредставления.expanded);
		Результат = Новый Структура("Документ,СериализованныеКлючиРаскрытия", ДокументПредставления, КлючиРаскрытия);
	Исключение
		ЗаписатьОшибкуРасчета("HTMLПредставление", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	ЗавершитьБлок("HTMLПредставление", НачалоБлока);
	Возврат Результат;

КонецФункции


Процедура ПроверитьДанныеПредставления(ДанныеПредставления, Протокол)

	ОжидаемоеЧислоСтрок = 2;
	ОжидаемаяГотовность = 40;
	ОжидаемоеСмещение = 0.5;
	ОжидаемыеЧасы = 1.5;
	ОжидаемаяВертикальнаяПозиция = 150;
	ОжидаемаяГоризонтальнаяПозиция = 600;
	МаксимальнаяГлубина = 64;

	ПроверитьУсловие(ДанныеПредставления.calendar[0].month = ДанныеПредставления.calendar[1].month,
		"HTML: дни одного месяца имеют общую календарную шапку", Протокол);
	УсловиеПроверки = ДанныеПредставления.rows.Количество() = ОжидаемоеЧислоСтрок И ДанныеПредставления.rows[1].parent = 0
		И ДанныеПредставления.rows[1].stage = 0 И ДанныеПредставления.rows[1].ready = ОжидаемаяГотовность;
	ПроверитьУсловие(УсловиеПроверки, "HTML: дерево, расшифровка этапа и готовность 40% сохранены", Протокол);
	ПроверитьУсловие(ДанныеПредставления.rows[0].planHours = "11069,427" И ДанныеПредставления.rows[0].actualHours = "6297,796"
		И ДанныеПредставления.rows[1].planHours = "120" И ДанныеПредставления.rows[1].actualHours = "48",
		"HTML: часы выведены без звездочек и повторного пересчета", Протокол);
	УсловиеПроверки = ДанныеПредставления.rows[0].intervals[0].start = ОжидаемоеСмещение
		И ДанныеПредставления.rows[0].intervals[0].color = "blue" И ДанныеПредставления.rows[1].intervals[0].color = "green"
		И ДанныеПредставления.calendar.Количество() = ОжидаемоеЧислоСтрок И ДанныеПредставления.today = ОжидаемыеЧасы;
	ПроверитьУсловие(УсловиеПроверки, "HTML: точные плановые даты и цвета сохранены", Протокол);
	УсловиеПроверки = ДанныеПредставления.expanded.Найти("root/key") <> Неопределено
		И ДанныеПредставления.top = ОжидаемаяВертикальнаяПозиция И ДанныеПредставления.left = ОжидаемаяГоризонтальнаяПозиция
		И ДанныеПредставления.level = МаксимальнаяГлубина;
	ПроверитьУсловие(УсловиеПроверки, "HTML: раскрытые ключи и обе позиции прокрутки переданы", Протокол);


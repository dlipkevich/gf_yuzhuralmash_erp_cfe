Процедура ДобавитьТестовыйЭтап(Модель, Партия, План, Факт, Закрыт, Владельцы)

	ЭтапМодели = НайтиСоздатьЭтап(Модель, Партия, Справочники.ЭтапыПроизводства.ПустаяСсылка());
	ЭтапМодели.План = План;
	ЭтапМодели.Факт = Факт;
	ЭтапМодели.Закрыт = Закрыт;
	ЭтапМодели.ЗакрытДокументами = Закрыт;
	ЭтапМодели.Выпускающий = Истина;
	ЭтапМодели.ЗавершеноПлан = ?(Закрыт, План, 0);
	ЭтапМодели.Владельцы = Владельцы;
	ЭтапМодели.Начало = Дата(2026, 10, 1, 8, 0, 0);
	ЭтапМодели.Окончание = Дата(2026, 10, 20, 18, 0, 0);

КонецПроцедуры

Процедура ПроверкаПланаФактаИГанта(Протокол)

	Модель = НоваяТестоваяМодель();
	ПланыЭтапов = Новый Массив;
	ПланыЭтапов.Добавить(20);
	ПланыЭтапов.Добавить(60);
	ПланыЭтапов.Добавить(40);
	Для ИндексУзла = 0 По 2 Цикл
		Партия = Новый УникальныйИдентификатор;
		ДобавитьТестовыйУзел(Модель, Партия, 1, ?(ИндексУзла = 0, -1, 0));
		ДобавитьТестовыйОбъем(Модель, Партия, 1, ?(ИндексУзла = 0, 0, 1));
		Владельцы = Новый Массив;
		Владельцы.Добавить(ИндексУзла);
		План = ПланыЭтапов[ИндексУзла];
		Факт = ?(ИндексУзла = 0, 0, 24);
		ДобавитьТестовыйЭтап(Модель, Партия, План, Факт, ИндексУзла > 0, Владельцы);
	КонецЦикла;
	Модель.Этапы[0].Начало = Дата(2026, 10, 15, 8, 0, 0);
	Модель.Этапы[1].Окончание = Дата(2026, 10, 10, 18, 0, 0);
	Модель.Этапы[2].Окончание = Дата(2026, 10, 14, 18, 0, 0);
	РаспределитьКоличества(Модель);
	РаспределитьРаботы(Модель);
	СвернутьПоказатели(Модель);
	ПроверитьУсловие(Модель.Узлы[0].ТрудПлан = 120 И Модель.Узлы[0].ТрудФакт = 48,
		"20 + 60 + 40 = 120 часов, факт 48", Протокол);
	Параметры = ТестовыеПараметрыПредставления();
	ДиаграммаПроверки = ПостроитьДиаграмму(Модель, Параметры);
	ПроверитьУсловие(ДиаграммаПроверки.ВертикальнаяПрокрутка,
		"Построенная диаграмма разрешает вертикальную прокрутку", Протокол);
	ПроверитьУсловие(Модель.Узлы[0].Индекс = 0 И Модель.Узлы[1].Индекс = 1,
		"Отбор и отображение не изменяют индексы исходной модели", Протокол);
	ПроверитьУсловие(ДиаграммаПроверки.Точки.Количество() > 0 И ДиаграммаПроверки.Серии.Количество() = 1,
		"Диаграмма содержит точки и серию", Протокол);
	ЗначениеКорня = ДиаграммаПроверки.ПолучитьЗначение(ДиаграммаПроверки.Точки[0], ДиаграммаПроверки.Серии[0]);
	ПроверитьУсловие(СтрНачинаетсяС(ЗначениеКорня.Данные.ГотовностьТекст, "40"),
		"Готовность корня 40 процентов", Протокол);
	ПроверитьУсловие(ЗначениеКорня.Количество() = 2, "Неперекрывающиеся зеленый и синий участки", Протокол);
	ПроверитьУсловие(ТипЗнч(ДиаграммаПроверки.Точки[0].Картинка) = Тип("Картинка"),
		"Индикатор сформирован платформой", Протокол);
	ДиаграммаПроверки.СвернутьТочку(ДиаграммаПроверки.Точки[0], Ложь);
	ПроверитьУсловие(Не ДиаграммаПроверки.РазвернутаТочка(ДиаграммаПроверки.Точки[0]),
		"СвернутьТочку с явным вторым параметром скрывает подчиненные строки", Протокол);
	ДиаграммаПроверки.РазвернутьТочку(ДиаграммаПроверки.Точки[0], Ложь);
	ПроверитьУсловие(ДиаграммаПроверки.РазвернутаТочка(ДиаграммаПроверки.Точки[0]),
		"РазвернутьТочку возвращает подчиненные строки после сворачивания", Протокол);
	Модель.Узлы[0].ТрудФакт = 130;
	ДиаграммаПерерасхода = ПостроитьДиаграмму(Модель, Параметры);
	ЗначениеКорня = ДиаграммаПерерасхода.ПолучитьЗначение(ДиаграммаПерерасхода.Точки[0], ДиаграммаПерерасхода.Серии[0]);
	ПроверитьУсловие(СтрНачинаетсяС(ЗначениеКорня.Данные.ГотовностьТекст, "108"),
		"Числовая готовность превышает 100 процентов", Протокол);

КонецПроцедуры


Процедура ДобавитьТестовыйУзел(Модель, Партия, КоличествоУзла, Родитель)

	Источник = Новый Структура;
	Источник.Вставить("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Источник.Вставить("Характеристика", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());

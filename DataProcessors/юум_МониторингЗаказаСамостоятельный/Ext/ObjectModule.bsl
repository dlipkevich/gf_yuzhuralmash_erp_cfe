Функция НоваяТестоваяМодель()

	Модель = НоваяМодель(Документы.ЗаказНаПроизводство2_2.ПустаяСсылка());
	Модель.ДинамическаяСтруктура = Истина;
	Модель.Вставить("ИндексЭтапов", Новый Соответствие);
	Модель.Вставить("ДокументКЭтапу", Новый Соответствие);
	Модель.Вставить("ДокументыПоСсылке", Новый Соответствие);
	Модель.Вставить("ОбъемыПартий", ТестоваяТаблица("КлючПартия,Номенклатура,Характеристика,Назначение,Объем,Готово"));
	Модель.Вставить("ВыходныеИзделия", ТестоваяТаблица("Этап,Номенклатура,Характеристика,Количество,Произведено,Отменено"));

	СтрокаОбъема.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	СтрокаОбъема.Назначение = Справочники.Назначения.ПустаяСсылка();
	СтрокаОбъема.Объем = Объем;
	СтрокаОбъема.Готово = Готово;


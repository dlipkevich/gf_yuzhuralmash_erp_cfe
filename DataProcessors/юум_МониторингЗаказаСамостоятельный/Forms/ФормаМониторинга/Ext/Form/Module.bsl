#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	РежимДиагностики = Ложь;
	Элементы.РежимДиагностикиКнопка.Пометка = РежимДиагностики;
	УровеньРаскрытия = 1;
	ШиринаДня = 20;
	ШириныКолонок = "[]";
	ЗаголовокБезЗаказа = Заголовок;
	ОчиститьПредставление();
	Состояние = "Выберите заказ на производство и нажмите «Сформировать». Рабочий график.";

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ПараметрЗапуска = "MONITORING_CUSTOM_UI" Тогда
		ПоказатьПроверочноеБольшоеДеревоНаСервере();
		Возврат;
	КонецЕсли;

	ПрефиксПроверки = "MONITORING_SELFTEST=";
	Если СтрНачинаетсяС(ПараметрЗапуска, ПрефиксПроверки) Тогда
		КаталогПроверки = Сред(ПараметрЗапуска, СтрДлина(ПрефиксПроверки) + 1);
		СамопроверкаНаСервере(КаталогПроверки);
		Модифицированность = Ложь;
		ЗавершитьРаботуСистемы(Ложь);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗаказПриИзменении(Элемент)

	СброситьРезультатНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	Состояние = "Параметры изменены. Нажмите «Сформировать».";

КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ЧислоЧастейАдреса = 3;
	Если ТипЗнч(ДанныеСобытия) <> Тип("ФиксированнаяСтруктура") Или ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	АдресРасшифровки = Строка(ДанныеСобытия.Href);
	Если Не СтрНачинаетсяС(АдресРасшифровки, "monitoring:detail/") Тогда
		Возврат;
	КонецЕсли;
	ЧастиАдреса = СтрРазделить(АдресРасшифровки, "/", Истина);
	Если ЧастиАдреса.Количество() <> ЧислоЧастейАдреса Тогда
		Возврат;
	КонецЕсли;
	ДанныеРасшифровки = Новый Структура("Узел,Этап", Число(ЧастиАдреса[1]), Число(ЧастиАдреса[2]));
	Варианты = ОбъектыРасшифровки(ДанныеРасшифровки);
	Если Варианты.Количество() = 1 Тогда
		ПоказатьЗначение(, Варианты[0].Значение);
	ИначеЕсли Варианты.Количество() > 1 Тогда
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораРасшифровки", ЭтотОбъект), Варианты);
	Иначе
		Если ДанныеРасшифровки.Этап >= 0 Тогда
			ТекстПредупреждения = "Исходный объект строки этапа недоступен. Нажмите «Сформировать». "
				+ "Подробности: журнал регистрации МониторингЗаказа.Новый.Расшифровка.";
			ПоказатьПредупреждение(, ТекстПредупреждения);
		Иначе
			ПоказатьПредупреждение(, "Нет доступных документов этапов или ресурсной спецификации.");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РежимДиагностикиПереключить(Команда)

	РежимДиагностики = Не РежимДиагностики;
	Элементы.РежимДиагностикиКнопка.Пометка = РежимДиагностики;

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьНаСервере(РаскрытыеКлючи(), Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПоказатьПроверочноеБольшоеДеревоНаСервере()

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	МодельПримера = ОбъектОбработки.ПроверочнаяМодельБольшогоДерева();
	АдресДанных = ПоместитьВоВременноеХранилище(МодельПримера, УникальныйИдентификатор);
	ИдентификаторРасчета = "ПРОВЕРКА-ИНТЕРФЕЙСА";
	УровеньРаскрытия = 65;
	ПоказыватьЭтапы = Истина;
	ПостроитьПредставление(МодельПримера, Новый Массив, Ложь);
	Заголовок = ЗаголовокБезЗаказа + ". ПРОВЕРОЧНЫЙ ПРИМЕР В ПАМЯТИ";
	Состояние = "Проверочный пример: 192 ДСЕ, длинные названия, большие числа, 108,33% и нулевая норма. Данные базы не изменяются.";

КонецПроцедуры


&НаСервере
Процедура ОбновитьНаСервере(Знач КлючиРаскрытия, Знач СохранитьРаскрытие)

	Если ЗначениеЗаполнено(АдресДанных) Тогда
		УдалитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	АдресДанных = "";
	ИдентификаторРасчета = Строка(Новый УникальныйИдентификатор);
	ОчиститьПредставление();
	Заголовок = ЗаголовокБезЗаказа;
	Если Не ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
		Состояние = "Выберите заказ на производство.";
		Возврат;
	КонецЕсли;
	Попытка
		ОбъектОбработки = РеквизитФормыВЗначение("Объект");
		Модель = ОбъектОбработки.СформироватьМодель(ЗаказНаПроизводство, ИдентификаторРасчета, РежимДиагностики);
		АдресДанных = ПоместитьВоВременноеХранилище(Модель, УникальныйИдентификатор);
		КлючиПредставления = ?(СохранитьРаскрытие, ДесериализоватьМассивПредставления(КлючиРаскрытия), Новый Массив);
		ПостроитьПредставление(Модель, КлючиПредставления, СохранитьРаскрытие);
		Заголовок = ЗаголовокБезЗаказа + ". " + Строка(ЗаказНаПроизводство);
	Исключение
		ОчиститьПредставление();
		Состояние = "Ошибка формирования. ID=" + ИдентификаторРасчета + ". См. журнал регистрации.";
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КомментарийОшибки = "ID=" + ИдентификаторРасчета + "; " + ТекстОшибки;
		ЗаписьЖурналаРегистрации("МониторингЗаказа.Новый.Форма", УровеньЖурналаРегистрации.Ошибка, , ЗаказНаПроизводство,
			КомментарийОшибки);
	КонецПопытки;

КонецПроцедуры

&НаСервере
Процедура СброситьРезультатНаСервере()

	Если ЗначениеЗаполнено(АдресДанных) Тогда
		УдалитьИзВременногоХранилища(АдресДанных);
	КонецЕсли;
	АдресДанных = "";
	ИдентификаторРасчета = "";
	ПозицияВертикаль = 0;
	ПозицияГоризонталь = 0;
	Заголовок = ЗаголовокБезЗаказа;
	ОчиститьПредставление();
	Состояние = "Выберите заказ на производство и нажмите «Сформировать».";
	Если ЗначениеЗаполнено(ЗаказНаПроизводство) Тогда
		Состояние = "Заказ выбран. Нажмите «Сформировать».";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция РаскрытыеКлючи()

	МинимальнаяШиринаДня = 8;
	МаксимальнаяШиринаДня = 40;
	ТекстКлючей = НачальныеКлючиРаскрытия;
	ДокументПредставления = Элементы.ПолеПредставления.Документ;
	Если ДокументПредставления <> Неопределено Тогда
		СостояниеПредставления = ДокументПредставления.getElementById("monitoringState");
		Если СостояниеПредставления <> Неопределено Тогда
			ШириныКолонок = СостояниеПредставления.getAttribute("data-column-widths");
			КлючиИзПредставления = СостояниеПредставления.getAttribute("data-expanded");
			Если ЗначениеЗаполнено(КлючиИзПредставления) Тогда
				ТекстКлючей = КлючиИзПредставления;
				УровеньРаскрытия = Число(СостояниеПредставления.getAttribute("data-level"));
				ПозицияВертикаль = Число(СостояниеПредставления.getAttribute("data-top"));
				ПозицияГоризонталь = Число(СостояниеПредставления.getAttribute("data-left"));
				ШиринаИзПредставления = Число(СостояниеПредставления.getAttribute("data-day-width"));
				Если ШиринаИзПредставления >= МинимальнаяШиринаДня И ШиринаИзПредставления <= МаксимальнаяШиринаДня Тогда
					ШиринаДня = ШиринаИзПредставления;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ТекстКлючей;

КонецФункции

&НаСервере
Функция ДесериализоватьМассивПредставления(ТекстДанных)

	Если ПустаяСтрока(ТекстДанных) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	ЧтениеДанных = Новый ЧтениеJSON;
	ЧтениеДанных.УстановитьСтроку(ТекстДанных);
	Результат = ПрочитатьJSON(ЧтениеДанных);
	ЧтениеДанных.Закрыть();
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ОчиститьПредставление()

	ТекстПредставления = "<!doctype html><html lang=""ru""><head><meta charset=""utf-8""></head>"
		+ "<body style=""font:13px Arial;color:#52677d"">Выберите заказ и нажмите «Сформировать».</body></html>";
	НачальныеКлючиРаскрытия = "[]";

КонецПроцедуры

&НаСервере
Процедура ПостроитьПредставление(Модель, КлючиРаскрытия, СохранятьРаскрытие = Истина)

	ПараметрыПредставления = Новый Структура;
	ПараметрыПредставления.Вставить("Номенклатура", Номенклатура);
	ПараметрыПредставления.Вставить("Код", Код);
	ПараметрыПредставления.Вставить("ПоказыватьЭтапы", ПоказыватьЭтапы);
	ПараметрыПредставления.Вставить("Уровень", УровеньРаскрытия);
	ПараметрыПредставления.Вставить("КлючиРаскрытия", КлючиРаскрытия);
	ПараметрыПредставления.Вставить("СохранятьРаскрытие", СохранятьРаскрытие);
	ПараметрыПредставления.Вставить("Идентификатор", ИдентификаторРасчета);
	ПараметрыПредставления.Вставить("РежимДиагностики", РежимДиагностики);
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ДиаграммаПредставления = ОбъектОбработки.ПостроитьДиаграмму(Модель, ПараметрыПредставления);
	НастройкиКолонок = ДесериализоватьМассивПредставления(ШириныКолонок);
	ПредставлениеГипертекста = ОбъектОбработки.СформироватьПредставление(ДиаграммаПредставления, Модель, УровеньРаскрытия,
		ПозицияВертикаль, ПозицияГоризонталь, ШиринаДня, НастройкиКолонок);
	ТекстПредставления = ПредставлениеГипертекста.Документ;
	НачальныеКлючиРаскрытия = ПредставлениеГипертекста.СериализованныеКлючиРаскрытия;
	Состояние = "Обновлено: " + Формат(Модель.МоментОбновления, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ ". Узлов: " + Строка(Модель.Узлы.Количество()) + ". ID=" + ИдентификаторРасчета;
	Если Модель.Предупреждения.Количество() > 0 Тогда
		Состояние = Состояние + ". Есть предупреждения; подробности в подсказке.";
	КонецЕсли;
	Элементы.ПолеСостояние.Подсказка = "План и факт трудозатрат указаны в часах. Временные единицы пересчитываются по коэффициенту ERP."
		+ Символы.ПС + СтрСоединить(Модель.Предупреждения, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРасшифровки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбъектыРасшифровки(Знач ДанныеРасшифровки)

	Результат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(АдресДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	Модель = ПолучитьИзВременногоХранилища(АдресДанных);
	Если Модель = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ИндексУзла = ДанныеРасшифровки.Узел;
	ИндексЭтапа = ДанныеРасшифровки.Этап;
	НекорректныйУзел = ИндексУзла < 0 Или ИндексУзла >= Модель.Узлы.Количество() Или ИндексУзла <> Цел(ИндексУзла);
	НекорректныйЭтап = ИндексЭтапа < -1 Или ИндексЭтапа >= Модель.Этапы.Количество() Или ИндексЭтапа <> Цел(ИндексЭтапа);
	Если НекорректныйУзел Или НекорректныйЭтап Тогда
		Возврат Результат;
	КонецЕсли;
	Если ДанныеРасшифровки.Этап >= 0 Тогда
		ДобавитьДоступнуюСсылку(Результат, Модель.Этапы[ИндексЭтапа].СсылкаПредставления);
		Если Результат.Количество() = 0 Тогда
			ЭтапРасшифровки = Модель.Этапы[ИндексЭтапа];
			КомментарийРасшифровки = "ID=" + Строка(ИдентификаторРасчета)
				+ "; Исходный объект строки недоступен; Узел=" + Строка(ИндексУзла)
				+ "; Этап=" + Строка(ИндексЭтапа);
			Если РежимДиагностики Тогда
				КомментарийРасшифровки = КомментарийРасшифровки
					+ "; Партия=" + ЗначениеВСтрокуВнутр(ЭтапРасшифровки.Партия)
					+ "; НормативныйЭтап=" + ЗначениеВСтрокуВнутр(ЭтапРасшифровки.НормативныйЭтап)
					+ "; ПрочитаноДокументов=" + Строка(Модель.ДокументыЭтапов.Количество())
					+ "; СвязаноДокументов=" + Строка(ЭтапРасшифровки.Документы.Количество()) + "; Доступных=0";
			КонецЕсли;
			ЗаписьЖурналаРегистрации("МониторингЗаказа.Новый.Расшифровка", УровеньЖурналаРегистрации.Предупреждение, ,
				Модель.Заказ, КомментарийРасшифровки);
		КонецЕсли;
	Иначе
		ДобавитьДокументыВетви(Результат, Модель, ИндексУзла);
		ДобавитьДоступнуюСсылку(Результат, Модель.Узлы[ИндексУзла].Спецификация);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ДобавитьДокументыВетви(Результат, Модель, ИндексУзла)

	Для каждого Узел Из Модель.Узлы Цикл
		Если Не ВходитВВетвь(Модель, Узел.Индекс, ИндексУзла) Тогда
			Продолжить;
		КонецЕсли;
		Для каждого РаботаУзла Из Узел.Работы Цикл
			ДобавитьДокументыРасшифровки(Результат, Модель.Этапы[РаботаУзла.Этап]);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ВходитВВетвь(Модель, Знач ИндексПредка, ИндексУзла)

	МаксимальноеЧислоПереходов = 65;
	Для Переход = 1 По МаксимальноеЧислоПереходов Цикл
		Если ИндексПредка < 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ИндексПредка = ИндексУзла Тогда
			Возврат Истина;
		КонецЕсли;
		ИндексПредка = Модель.Узлы[ИндексПредка].Родитель;
		Если Переход = МаксимальноеЧислоПереходов Тогда
			ВызватьИсключение "Превышена граница обхода расшифровки.";
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ДобавитьДокументыРасшифровки(Результат, ЭтапМодели)

	Для каждого СсылкаЭтапа Из ЭтапМодели.Документы Цикл
		ДобавитьДоступнуюСсылку(Результат, СсылкаЭтапа);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьДоступнуюСсылку(Результат, СсылкаОбъекта)

	Если ЗначениеЗаполнено(СсылкаОбъекта) И Результат.НайтиПоЗначению(СсылкаОбъекта) = Неопределено Тогда
		ОписаниеМетаданных = СсылкаОбъекта.Метаданные();
		Если ПравоДоступа("Просмотр", ОписаниеМетаданных) Тогда
			Результат.Добавить(СсылкаОбъекта);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СамопроверкаНаСервере(Знач КаталогПроверки)

	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	Протокол = ОбъектОбработки.Самопроверка();
	ТекстПротокола = Новый ТекстовыйДокумент;
	ТекстПротокола.УстановитьТекст(Протокол);
	ТекстПротокола.Записать(КаталогПроверки + "\runtime-selftest.json", КодировкаТекста.UTF8);

КонецПроцедуры

#КонецОбласти

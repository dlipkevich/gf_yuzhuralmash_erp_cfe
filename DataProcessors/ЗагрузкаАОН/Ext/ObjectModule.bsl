Функция Подключение() Экспорт 

	Connection = Новый COMОбъект("ADODB.Connection");
	сс = СформироватьСтрокуСоединения();
	Connection.ConnectionString = сс;

	Попытка
		Connection.Open();
	Исключение
		Сообщить ("Проблемы с подключением к SQL !" );
		текст = ОписаниеОшибки();
		Сообщить(текст);
		Connection = Неопределено;
		Возврат Ложь;	
	КонецПопытки;

	Возврат Истина;
	
КонецФункции 

Процедура Отключение(Сообщить = Истина) Экспорт 

	Если Connection <> Неопределено Тогда
		Connection.Close();	
		Connection = Неопределено;	
	КонецЕсли;	
	
КонецПроцедуры 

Функция СформироватьСтрокуСоединения() Экспорт
	
	//Возврат "Provider=SQLNCLI11.1;Initial Catalog=IndustriCS_Orsk;Data Source=ugo-db01;User ID=gf;Password=15426378"; 
	Возврат юум_ОбщегоНазначения.ПолучитьГлобальноеЗначение("СтрокаСоединенияTechnologiCS");
	
	Струк = юум_ОбщегоНазначения.ПолучитьГлобальноеЗначениеСАвторизацией("СтрокаСоединенияСЭСА");
	Если Струк.ЕстьДанные Тогда
		Значение = СтрЗаменить(Струк.Значение, "%usr%", Струк.Логин);
		Значение = СтрЗаменить(Значение, "%psw%", Струк.Пароль);
	Иначе
		Значение = "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция Поле(RS, Имя)

	п = RS.Fields(Имя);	
	Если п.Type = 200 Тогда
		//строка
		Возврат СокрЛП(п.Value);		
	ИначеЕсли п.Type = 139 Тогда		
		// число
		Возврат Формат(п.Value, "ЧГ=0");
	КонецЕсли;
	
КонецФункции

Функция НайтиПодразделение(ИД)

	Если ПустаяСтрока(ИД) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	подр = КЭШ.ствПодразделения[ИД];
	Если ЗначениеЗаполнено(подр) Тогда
		Возврат подр;
	КонецЕсли;
	подр = Справочники.СтруктураПредприятия.НайтиПоКоду(ИД);
	Если ЗначениеЗаполнено(подр) Тогда
		КЭШ.ствПодразделения[ИД] = подр;
	КонецЕсли;

	Возврат подр;
	
КонецФункции

Функция НайтиСоздатьНоменклатуру(Код)

	Если ПустаяСтрока(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	сс = КЭШ.ствНоменклатура[Код];
	Если ЗначениеЗаполнено(сс) Тогда
		Возврат сс;
	КонецЕсли;
	
	сс = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если ЗначениеЗаполнено(сс) Тогда
		КЭШ.ствНоменклатура[Код] = сс;
		Возврат сс;
	КонецЕсли;

	сс = СоздатьНоменклатуру(Код);
	Если ЗначениеЗаполнено(сс) Тогда
		КЭШ.ствНоменклатура[Код] = сс;
		Возврат сс;
	КонецЕсли;

	ЗапроситьНоменклатуру(Код);
	сс = СоздатьНоменклатуру(Код);
	
	Возврат сс;
	
КонецФункции

Процедура ЗапроситьНоменклатуру(Код)

	Command = Новый COMObject("ADODB.Command");
	Command.ActiveConnection = Connection;
	ТекстЗапроса = "EXEC ('begin user1C.getnmk_1c_byCode(''" + Код + "''); end;') AT INTR";
	
	Command.CommandText = ТекстЗапроса; 
	Command.CommandType = 1;
	Command.Execute();

КонецПроцедуры

Функция СоздатьНоменклатуру(Код)
   
	RS = Новый COMОбъект("ADODB.Recordset");
	
	ТекстЗапроса = "SELECT * FROM OPENQUERY(INTR, 'SELECT  
	| S_ID, DESIGNATIO, NAME, P750M, P750ED, H580, P750, WIDTH, LENGTH, DIAM, MATERIAL, STP, 
	| GOST_M, GOST_S, AWT, GROUP_CODE, GROUP_NAME, TYPSIZE, DOP_COND, DOP_TREB, APPLICABILITY_SIGN, 
	| F_NEED_ITT, F_ITT_IN_BASE, F_OBOZN_ITT, F_FILE_ITT, VID_NOMENKL, F_KEZ_IN_BASE, F_OBOZN_KEZ, 
	| F_FILE_KEZ, MAKE_AS_METALLURG, GAUN, F_PASPORT, F_NEED_TZ, F_TZ_IN_BASE, F_OBOZN_TZ, F_FILE_TZ, 
	| F_FULL_NAME, F_FULL_NAME_2, F_KOD_IZK, SOURCE_NAME, SOURCE_MARKA, SOURCE_RAZMER, SOURCE_GOST_S, 
	| SOURCE_GOST_M, SOURCE_STP, FULL_NAME_1C
	| FROM USER1C.NMK_SEARCH_night where DESIGNATIO = "
	+ "''" + Код + "'' ') ";
	
	Попытка
		RS.Open(ТекстЗапроса, Connection);
	Исключение
		Сообщить ("Проблемы с выполнением запроса к SQL !");
		Сообщить (ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если RS.EOF() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	об = юум_Интеграция.ОбъектНоменклатуры(КЭШН, RS, Ложь);
	об.Записать();
	Возврат об.Ссылка;
	
КонецФункции


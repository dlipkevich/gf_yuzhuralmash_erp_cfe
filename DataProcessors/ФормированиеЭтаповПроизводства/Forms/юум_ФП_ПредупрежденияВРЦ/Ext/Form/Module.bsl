#Область ОбработчикиСобытийФормы

// Инициализирует понятный перечень и скрытые технические подробности.
// Параметры:
//  Отказ - Булево - признак отказа открытия формы.
//  СтандартнаяОбработка - Булево - признак стандартной обработки открытия.
// #юум {
// #ЧТЗ 04.01
// Загрузка отчета, частичный прогноз и отдельные предупреждения.
// Галфинд mr. Cherryman 2026/11/13
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ТекстПредупреждений = Параметры.ТекстПредупреждений;
    ТехническиеПодробности = Параметры.ТехническиеПодробности;
    Заголовок = "Предупреждения загрузки ВРЦ";
    АвтоЗаголовок = Ложь;
    Для Каждого ИмяПоля Из СтрРазделить("Предупреждения,Подробности", ",") Цикл
        ПолеТекста = Элементы[ИмяПоля];
        ПолеТекста.ТолькоПросмотр = Истина;
        ПолеТекста.МногострочныйРежим = Истина;
        ПолеТекста.АвтоПереносСтрок = Истина;
        ПолеТекста.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
        ПолеТекста.РастягиватьПоГоризонтали = Истина;
        ПолеТекста.Ширина = 100;
        ПолеТекста.АвтоМаксимальнаяШирина = Ложь;
        ПолеТекста.МаксимальнаяШирина = 0;
        ПолеТекста.Высота = 12;
    КонецЦикла;
    Элементы.ПоказатьТехническиеПодробности.Заголовок = "Показать технические подробности для специалиста";
    Элементы.ПоказатьТехническиеПодробности.Видимость = ЗначениеЗаполнено(ТехническиеПодробности);
    Элементы.Подробности.Видимость = Ложь;
КонецПроцедуры // } #юум

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Показывает технические подробности по явному выбору пользователя.
// Параметры:
//  Элемент - ПолеФормы - флажок показа подробностей.
// #юум {
// #ЧТЗ 04.01
// Загрузка отчета, частичный прогноз и отдельные предупреждения.
// Галфинд mr. Cherryman 2026/11/13
&НаКлиенте
Процедура ПоказатьПодробностиПриИзменении(Элемент)
    Элементы.Подробности.Видимость = ПоказатьПодробности;
КонецПроцедуры // } #юум

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
// Загружает локальную справочную страницу обработки без чтения заказов.
//
// Параметры:
//  Отказ - Булево - Отказ от создания формы.
//  СтандартнаяОбработка - Булево - Признак штатной обработки.
//
// #юум {
// #ЧТЗ 04.01
// Явная справочная страница вместо неработающей подмены типовой справки.
// Галфинд mr. Cherryman 2026/11/13
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    МакетСправки = Обработки.ФормированиеЭтаповПроизводства.ПолучитьМакет("юум_ФП_СправкаВРЦ");
    ТекстСправки = МакетСправки.ПолучитьТекст();
    Заголовок = "Справка: загрузка ВРЦ";
    АвтоЗаголовок = Ложь;
    Элементы.СодержимоеСправки.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
    Элементы.СодержимоеСправки.РастягиватьПоГоризонтали = Истина;
    Элементы.СодержимоеСправки.РастягиватьПоВертикали = Истина;
КонецПроцедуры // } #юум

#КонецОбласти

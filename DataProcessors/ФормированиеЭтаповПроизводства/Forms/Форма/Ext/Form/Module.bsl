// Параметры:
//    ИдУзла - Строка - Устойчивый идентификатор вхождения в модели запуска.
//    СпецификацияРасшифровки - СправочникСсылка.РесурсныеСпецификации, Неопределено - Выбранная спецификация или отсутствие дополнительного
//        отбора.
//
// Возвращаемое значение:
//    Структура - Параметры штатной расшифровки, варианты спецификаций и пояснение.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ПодготовитьОбеспечение(Знач ИдУзла, Знач СпецификацияРасшифровки)
	Варианты = Новый СписокЗначений;
	РезультатРасшифровки = Новый Структура("Параметры,Варианты,Сообщение", Неопределено, Варианты, "");
	Модель = юум_ФП_ТекущаяМодель();
	ПланРасшифровки = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ПланУзлаДляРасшифровки(Модель, ИдУзла);
	Если ПланРасшифровки = Неопределено Тогда
		РезультатРасшифровки.Сообщение = "У выбранной строки нет самостоятельных расчетных данных обеспечения."
			+ " Выберите производственную позицию в рабочем составе.";
		Возврат РезультатРасшифровки;
	КонецЕсли;
	Если ПланРасшифровки.Итог("КЗапуску") > 0 Тогда
		ПланРасшифровки = ПланРасшифровки.Скопировать(Новый Структура("Отметка", Истина));
	КонецЕсли;
	Для Каждого ПозицияРасшифровки Из ПланРасшифровки Цикл
		Если Варианты.НайтиПоЗначению(ПозицияРасшифровки.Спецификация) = Неопределено Тогда
			Варианты.Добавить(ПозицияРасшифровки.Спецификация);
		КонецЕсли;
	КонецЦикла;
	Если СпецификацияРасшифровки = Неопределено И Варианты.Количество() > 1 Тогда
		Возврат РезультатРасшифровки;
	КонецЕсли;
	Если СпецификацияРасшифровки = Неопределено Тогда
		СпецификацияРасшифровки = Варианты[0].Значение;
	КонецЕсли;
	Варианты.Очистить();
	ПланРасшифровки = ПланРасшифровки.Скопировать(Новый Структура("Спецификация", СпецификацияРасшифровки));
	Если ПланРасшифровки.Количество() = 0 Тогда
		РезультатРасшифровки.Сообщение = "Выбранный состав изменился. Повторно откройте расшифровку позиции.";
		Возврат РезультатРасшифровки;
	КонецЕсли;
	РезультатРасшифровки.Параметры = юум_ФП_ТиповыеПараметрыОбеспечения(ПланРасшифровки);
	Возврат РезультатРасшифровки;
КонецФункции // } #юум

&НаСервере

// Параметры:
//    ПланРасшифровки - ТаблицаЗначений - План выбранной позиции в схеме штатной расшифровки обеспечения.
//
// Возвращаемое значение:
//    Структура - Параметры типовой формы обеспечения для переданного плана.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ТиповыеПараметрыОбеспечения(ПланРасшифровки)
	ДанныеСтроки = Новый Структура("НомерГруппы,Номенклатура,Характеристика,Спецификация,НаправлениеДеятельности");
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПланРасшифровки[0]);
	ДанныеСтроки.Вставить("ПланВХранилище", Истина);
	ДанныеСтроки.Вставить("КЗапуску", ПланРасшифровки.Итог("КЗапуску"));
	ДанныеСтроки.Вставить("Требуется", ПланРасшифровки.Итог("Требуется"));
	ДанныеСтроки.Вставить("Отметка", ДанныеСтроки.КЗапуску > 0);
	АдресРасшифровки = ЭтотОбъект["юум_ФП_АдресПланаРасшифровки"];
	Если Не ЗначениеЗаполнено(АдресРасшифровки) Тогда
		АдресРасшифровки = УникальныйИдентификатор;
	КонецЕсли;
	АдресРасшифровки = ПоместитьВоВременноеХранилище(ПланРасшифровки, АдресРасшифровки);
	ЭтотОбъект["юум_ФП_АдресПланаРасшифровки"] = АдресРасшифровки;
	Возврат ПараметрыРасшифровки(ДанныеСтроки, АдресРасшифровки,
		ЭтотОбъект["АдресПользовательскиеОтборы"], ЭтотОбъект["ОбособитьВыпускПолуфабрикатов"]);
КонецФункции // } #юум

&НаСервере

// Параметры:
//    ДобавляемыеРеквизиты - Массив - Накопитель реквизитов, создаваемых одним изменением формы.
//    ИмяТаблицы - Строка - Имя реквизита формы с таблицей детализации.
//    СхемаТаблицы - ТаблицаЗначений - Схема колонок создаваемого табличного реквизита формы.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, Знач ИмяТаблицы, СхемаТаблицы)
	ТипРеквизита = Новый ОписаниеТипов("ТаблицаЗначений");
	ДобавляемыйРеквизит = Новый РеквизитФормы(
		ИмяТаблицы, ТипРеквизита);
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	Для Каждого КолонкаСхемы Из СхемаТаблицы.Колонки Цикл
		ДобавляемыйРеквизит = Новый РеквизитФормы(
			КолонкаСхемы.Имя, КолонкаСхемы.ТипЗначения, ИмяТаблицы);
		ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	КонецЦикла;
КонецПроцедуры // } #юум


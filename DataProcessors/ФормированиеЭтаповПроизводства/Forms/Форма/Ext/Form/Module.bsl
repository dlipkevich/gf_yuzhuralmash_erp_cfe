// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ОтметкаПриИзменении(Элемент)
	ТекущаяПозиция = Элементы.юум_ФП_Дерево.ТекущиеДанные;
	Если ТекущаяПозиция = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст = юум_ФП_КонтекстДерева();
	Если ТекущаяПозиция.ДопустимЗапуск Тогда
		КоличествоЗапуска = ?(ТекущаяПозиция.Отметка, ТекущаяПозиция.Требуется, 0);
		ТекстПредупреждения = юум_ФП_ИзменитьКоличествоНаСервере(ТекущаяПозиция.ИдУзла, КоличествоЗапуска);
	Иначе
		ИдентификаторыУзлов = Новый Массив;
		ИдентификаторыУзлов.Добавить(ТекущаяПозиция.ИдУзла);
		Режим = ?(ТекущаяПозиция.Отметка, "Требуется", "Снять");
		ТекстПредупреждения = юум_ФП_ЗаполнитьВыборНаСервере(ИдентификаторыУзлов, Режим);
	КонецЕсли;
	юум_ФП_ВосстановитьКонтекстДерева(Контекст);
	юум_ФП_ПоказатьПредупреждение(ТекстПредупреждения);
КонецПроцедуры // } #юум


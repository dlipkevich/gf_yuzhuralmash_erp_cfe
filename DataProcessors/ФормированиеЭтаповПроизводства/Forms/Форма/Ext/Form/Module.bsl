// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПослеСоздания(Отказ, СтандартнаяОбработка)
	Если Не Отказ Тогда
		юум_ФП_СоздатьИнтерфейс();
        // #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/13
        юум_ФП_СоздатьКомандуСправки();
        // } #юум
		юум_ФП_НастроитьРедактирование();
	КонецЕсли;

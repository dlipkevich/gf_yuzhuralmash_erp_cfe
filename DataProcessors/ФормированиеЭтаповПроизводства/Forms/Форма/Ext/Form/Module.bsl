// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ОбновитьЗагрузкуНаСервере(Знач Перечитать = Ложь)
	Элементы.юум_ФП_БлокЗагрузки.Видимость = ЭтаФорма["юум_ФП_ПоказатьЗагрузку"];
	Если Не ЭтаФорма["юум_ФП_ПоказатьЗагрузку"] Тогда
		Возврат;
	КонецЕсли;
	Элементы.юум_ФП_ДиаграммаЗагрузки.Видимость = Ложь;
	НачалоЗагрузки = ЭтаФорма["юум_ФП_НачалоПериода"];
	КонецЗагрузки = ЭтаФорма["юум_ФП_КонецПериода"];
	Если Не ЗначениеЗаполнено(НачалоЗагрузки) Или Не ЗначениеЗаполнено(КонецЗагрузки) Тогда
		ЭтаФорма["юум_ФП_СостояниеЗагрузки"] = "Укажите обе даты периода загрузки.";
		Возврат;
	КонецЕсли;
	Если НачалоДня(НачалоЗагрузки) > КонецДня(КонецЗагрузки) Тогда
		ЭтаФорма["юум_ФП_СостояниеЗагрузки"] = "Начало периода загрузки позже окончания.";
		Возврат;
	КонецЕсли;
	Попытка
		РезультатЗагрузки = юум_ФП_РассчитатьЗагрузкуФормы(Перечитать, НачалоЗагрузки, КонецЗагрузки);
		ЭтаФорма["юум_ФП_СостояниеЗагрузки"] = РезультатЗагрузки.Состояние;
		Если Не РезультатЗагрузки.Полный Тогда
			Возврат;
		КонецЕсли;
		ДанныеЗагрузки = РезультатЗагрузки.Данные;
		ЭтаФорма["юум_ФП_ДиаграммаЗагрузки"] = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПостроитьДиаграмму(
			ДанныеЗагрузки, НачалоЗагрузки, КонецЗагрузки);
		Элементы.юум_ФП_ДиаграммаЗагрузки.Видимость = Истина;
	Исключение
		СведенияОбОшибке = ИнформацияОбОшибке();
		ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке);
		КомментарийЖурнала = "Период " + Строка(НачалоЗагрузки) + " - " + Строка(КонецЗагрузки)
			+ Символы.ПС + ПодробностиОшибки;
		ЗаписьЖурналаРегистрации("юум_ФП_ФормированиеПартий.ЗагрузкаВРЦ",
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеЭтаповПроизводства,, КомментарийЖурнала);
		ЭтаФорма["юум_ФП_СостояниеЗагрузки"] = "Загрузка ВРЦ не рассчитана. Подробности сохранены в журнале регистрации.";
	КонецПопытки;
КонецПроцедуры // } #юум


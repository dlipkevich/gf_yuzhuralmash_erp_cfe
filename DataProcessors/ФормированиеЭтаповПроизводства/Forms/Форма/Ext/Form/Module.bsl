	Заголовки.Вставить("КоличествоРабот", "Работ к запуску");
	Заголовки.Вставить("Трудоемкость", "Норма работы, н/ч");
	Заголовки.Вставить("ЧасыПредставление", "Собственные часы, н/ч");
	Заголовки.Вставить("Кратность", "Кратность нормы работы");
	Заголовки.Вставить("СостояниеДоговора", "Выбор договора");
	Заголовки.Вставить("НомерЭтапа", "№ этапа");
	Заголовки.Вставить("ВидРабот", "Вид работ");
	Заголовок = Заголовки.Получить(ИмяКолонки);
	Возврат ?(Заголовок = Неопределено, ИмяКолонки, Заголовок);

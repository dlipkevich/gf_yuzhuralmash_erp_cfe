// Параметры:
//    ИдУзла - Строка - Устойчивый идентификатор вхождения в модели запуска.
//    КоличествоЗапуска - Число - Введенное пользователем количество для выбранного узла.
//
// Возвращаемое значение:
//    Строка - Предупреждение о выборе; пустая строка при отсутствии замечаний.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ИзменитьКоличествоНаСервере(Знач ИдУзла, Знач КоличествоЗапуска)
	Модель = юум_ФП_ТекущаяМодель();
	Если КоличествоЗапуска <= 0 Тогда
		ИдентификаторыУзлов = Новый Массив;
		ИдентификаторыУзлов.Добавить(ИдУзла);
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ЗаполнитьВыбор(Модель.Дерево, ИдентификаторыУзлов, "Снять");
	Иначе
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ИзменитьКоличествоЗапуска(Модель.Дерево, ИдУзла, КоличествоЗапуска);
	КонецЕсли;
	ЭтотОбъект["юум_ФП_Изменено"] = Истина;
	ТекстПредупреждения = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ПредупреждениеВыбора(Модель.Дерево);
	ЭтотОбъект["юум_ФП_Сообщение"] = ТекстПредупреждения;
	юум_ФП_СохранитьИПоказатьМодель(Модель);
	Возврат ТекстПредупреждения;
КонецФункции // } #юум


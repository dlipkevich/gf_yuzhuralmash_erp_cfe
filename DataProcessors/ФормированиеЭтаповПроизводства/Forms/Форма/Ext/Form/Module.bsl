// Параметры:
//    Контекст - Структура - Текущий узел, выделение, раскрытие и комментарий дерева формы.
//    ВосстановитьРаскрытие - Булево - Восстанавливать сохраненное раскрытие узлов после обновления.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ВосстановитьКонтекстДерева(Знач Контекст, Знач ВосстановитьРаскрытие = Истина)
	НовыеИдентификаторы = Новый Соответствие;
	КорневыеСтроки = ЭтотОбъект["юум_ФП_Дерево"].ПолучитьЭлементы();
	юум_ФП_ВосстановитьКонтекстСтрок(КорневыеСтроки,
	    Контекст.Раскрытие, НовыеИдентификаторы, ВосстановитьРаскрытие);
	Элементы.юум_ФП_Дерево.ВыделенныеСтроки.Очистить();
	Для Каждого ИдУзла Из Контекст.Выделенные Цикл
		ИдентификаторСтроки = НовыеИдентификаторы.Получить(ИдУзла);
		Если ИдентификаторСтроки <> Неопределено Тогда
			Элементы.юум_ФП_Дерево.ВыделенныеСтроки.Добавить(ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИдПредка Из Контекст.ПредкиТекущей Цикл
		ИдентификаторСтроки = НовыеИдентификаторы.Получить(ИдПредка);
		Если ИдентификаторСтроки <> Неопределено Тогда
			Элементы.юум_ФП_Дерево.ТекущаяСтрока = ИдентификаторСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум


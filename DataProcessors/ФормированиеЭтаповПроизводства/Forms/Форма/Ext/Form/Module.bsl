// Параметры:
//    Модель - Структура - Дерево, исходный План, Связи, Структура и Нормативы сеанса.
//    ПересчитатьПоказатели - Булево - Пересчитать нормативы модели перед отображением.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_СохранитьИПоказатьМодель(Модель, Знач ПересчитатьПоказатели = Истина)
	Если Модель.Свойство("Нормативы") И ПересчитатьПоказатели Тогда
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_ПересчитатьПоказатели(Модель, Модель.Дерево);
	КонецЕсли;
	Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ОбновитьАдресатовКомментариев(Модель.Дерево);
	АдресМодели = ЭтотОбъект["юум_ФП_АдресМодели"];
	Если Не ЗначениеЗаполнено(АдресМодели) Тогда
		АдресМодели = УникальныйИдентификатор;
	КонецЕсли;
	ЭтотОбъект["юум_ФП_АдресМодели"] = ПоместитьВоВременноеХранилище(Модель, АдресМодели);
	ПредставлениеДерева = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ДеревоДляПоиска(
		Модель.Дерево, ТолькоОтмеченные, ЭтотОбъект["юум_ФП_Поиск"]);
	ЗначениеВРеквизитФормы(ПредставлениеДерева, "юум_ФП_Дерево");
	Если ПересчитатьПоказатели Тогда
		юум_ФП_ОбновитьЗагрузкуНаСервере();
	КонецЕсли;
	ЭтотОбъект["юум_ФП_УзелДетализации"] = "";
	Если ЭтотОбъект["юум_ФП_ПоказатьДетализацию"] Тогда
		юум_ФП_ЗаполнитьДетализациюНаСервере(ЭтотОбъект["юум_ФП_УзелКомментария"]);
	КонецЕсли;
КонецПроцедуры // } #юум


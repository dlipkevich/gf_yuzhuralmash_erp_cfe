// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_РассчитатьЗагрузкуФормы(Знач Перечитать, Знач НачалоЗагрузки, Знач КонецЗагрузки)
	МодельЗагрузки = Неопределено;
	АдресМодели = ЭтаФорма["юум_ФП_АдресМодели"];
	Если ЗначениеЗаполнено(АдресМодели) Тогда
		МодельЗагрузки = ПолучитьИзВременногоХранилища(АдресМодели);
	КонецЕсли;
	Если МодельЗагрузки <> Неопределено И Не МодельЗагрузки.Свойство("План") Тогда
		МодельЗагрузки = Неопределено;
	КонецЕсли;
	АдресЗагрузки = ЭтаФорма["юум_ФП_АдресЗагрузки"];
	СнимокЗагрузки = Неопределено;
	Если ЗначениеЗаполнено(АдресЗагрузки) Тогда
		СнимокЗагрузки = ПолучитьИзВременногоХранилища(АдресЗагрузки);
	КонецЕсли;
	Если юум_ФП_НуженСнимокЗагрузки(СнимокЗагрузки, Перечитать, НачалоЗагрузки, КонецЗагрузки, АдресМодели) Тогда
		СнимокЗагрузки = Новый Структура;
		СнимокЗагрузки.Вставить("Начало", НачалоЗагрузки);
		СнимокЗагрузки.Вставить("Конец", КонецЗагрузки);
		СнимокЗагрузки.Вставить("АдресМодели", АдресМодели);
		СнимокЗагрузки.Вставить("Движения", Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПрочитатьЗагрузку(НачалоЗагрузки, КонецЗагрузки));
		СнимокЗагрузки.Вставить("Объемы", Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПрочитатьОбъемыПлана(СнимокЗагрузки.Движения));
		Если ЗначениеЗаполнено(АдресЗагрузки) Тогда
			ПоместитьВоВременноеХранилище(СнимокЗагрузки, АдресЗагрузки);
		Иначе
			ЭтаФорма["юум_ФП_АдресЗагрузки"] = ПоместитьВоВременноеХранилище(СнимокЗагрузки, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	ДеревоЗагрузки = Неопределено;
	Если МодельЗагрузки <> Неопределено Тогда
		ДеревоЗагрузки = МодельЗагрузки.Дерево;

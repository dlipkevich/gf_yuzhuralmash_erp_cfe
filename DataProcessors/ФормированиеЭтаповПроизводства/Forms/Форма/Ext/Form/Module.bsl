// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗагрузитьМодельЗапуска()
	ТаблицаОтбор = НовыйОтборДетальныеЗаписи();
	Для Каждого ГруппаПлана Из Объект.ПланИтоги Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОтбор.Добавить(), ГруппаПлана);
	КонецЦикла;
	ДетальныйПлан = ДетальныеЗаписиПакетно(ТаблицаОтбор, АдресПользовательскиеОтборы,
		ОбособитьВыпускПолуфабрикатов);
	МодельЗапуска = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ПостроитьМодельЗапуска(ДетальныйПлан);
	ЭтаФорма["юум_ФП_АдресМодели"] = ПоместитьВоВременноеХранилище(МодельЗапуска, УникальныйИдентификатор);
	юум_ФП_СохранитьИПоказатьМодель(МодельЗапуска, Ложь);
	ЭтаФорма["юум_ФП_Комментарий"] = "";
	ЭтаФорма["юум_ФП_Изменено"] = Ложь;
	Элементы.ГруппаПланИтоги.Видимость = Ложь;
	Элементы.ГруппаПлан.Видимость = Ложь;
	юум_ФП_ОбновитьЗагрузкуНаСервере(Истина);
КонецПроцедуры // } #юум


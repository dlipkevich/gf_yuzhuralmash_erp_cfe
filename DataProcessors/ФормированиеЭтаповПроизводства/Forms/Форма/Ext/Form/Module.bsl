// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ОформитьВидСтроки(Знач ВидСтроки)
	ПравилоОформления = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Код,Представление,ЕдиницаИзмерения,Требуется,КЗапуску,Обеспечено,"
		+ "Маршрут,ДоговорПереработчик,Трудоемкость,СуммаПоГруппе", ",") Цикл
		ПравилоОформления.Поля.Элементы.Добавить().Поле =
			Новый ПолеКомпоновкиДанных("юум_ФП_Дерево" + ИмяКолонки);
	КонецЦикла;
	ОтборВида = ПравилоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборВида.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("юум_ФП_Дерево.ВидСтроки");
	ОтборВида.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборВида.ПравоеЗначение = ВидСтроки;
	ШрифтСтроки = ШрифтыСтиля.ВажнаяНадписьШрифт;
	ПравилоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтСтроки);
	Если ВидСтроки = "Изделие" Тогда
		ПравилоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Бежевый);
	КонецЕсли;
КонецПроцедуры // } #юум


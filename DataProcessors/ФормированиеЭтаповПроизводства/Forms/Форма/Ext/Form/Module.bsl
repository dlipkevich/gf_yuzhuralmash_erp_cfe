// Параметры:
//    Перечитать - Булево - Принудительно обновить исходный снимок загрузки.
// #юум {
// #ЧТЗ 04.01
// Загрузка по набору отчета, частичный прогноз и предупреждения.
// Галфинд mr. Cherryman 2026/11/13
Процедура юум_ФП_ОбновитьЗагрузкуНаСервере(Знач Перечитать = Ложь)
    Элементы.юум_ФП_БлокЗагрузки.Видимость = ЭтотОбъект["юум_ФП_ПоказатьЗагрузку"];
    Если Не ЭтотОбъект["юум_ФП_ПоказатьЗагрузку"] Тогда
        Возврат;
    КонецЕсли;
    ЭтотОбъект["юум_ФП_Предупреждения"] = "";
    ЭтотОбъект["юум_ФП_ПодробностиЗагрузки"] = "";
    Элементы.юум_ФП_ОткрытьПредупрежденияКнопка.Видимость = Ложь;
    Элементы.юум_ФП_ДиаграммаЗагрузки.Видимость = Ложь;
    НачалоЗагрузки = ЭтотОбъект["юум_ФП_НачалоПериода"];
    КонецЗагрузки = ЭтотОбъект["юум_ФП_КонецПериода"];
    Если Не ЗначениеЗаполнено(НачалоЗагрузки) Или Не ЗначениеЗаполнено(КонецЗагрузки) Тогда
        ЭтотОбъект["юум_ФП_СостояниеЗагрузки"] = "Укажите обе даты периода загрузки.";
        юум_ФП_ПоказатьПредупрежденияЗагрузки("[ВРЦ-П01] Укажите обе даты периода загрузки.", "", 1);
        Возврат;
    КонецЕсли;
    Если НачалоДня(НачалоЗагрузки) > КонецДня(КонецЗагрузки) Тогда
        ЭтотОбъект["юум_ФП_СостояниеЗагрузки"] = "Исправьте границы периода загрузки.";
        юум_ФП_ПоказатьПредупрежденияЗагрузки("[ВРЦ-П02] Начало периода позже окончания.", "", 1);
        Возврат;
    КонецЕсли;
    Попытка
        РезультатЗагрузки = юум_ФП_РассчитатьЗагрузкуФормы(Перечитать, НачалоЗагрузки, КонецЗагрузки);
        ЭтотОбъект["юум_ФП_СостояниеЗагрузки"] = РезультатЗагрузки.Состояние;
        ТекстПредупреждений = СтрСоединить(РезультатЗагрузки.Ошибки, Символы.ПС + Символы.ПС);
        КоличествоПредупреждений = РезультатЗагрузки.Ошибки.Количество();
        юум_ФП_ПоказатьПредупрежденияЗагрузки(ТекстПредупреждений,
            РезультатЗагрузки.Подробности, КоличествоПредупреждений);
        ЭтотОбъект["юум_ФП_ДиаграммаЗагрузки"] = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПостроитьДиаграмму(
            РезультатЗагрузки.Данные, НачалоЗагрузки, КонецЗагрузки);
        Элементы.юум_ФП_ДиаграммаЗагрузки.Видимость = Истина;
    Исключение
        СведенияОбОшибке = ИнформацияОбОшибке();
        ПодробностиОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке);
        КомментарийЖурнала = "Период " + Строка(НачалоЗагрузки) + " - " + Строка(КонецЗагрузки)
            + Символы.ПС + ПодробностиОшибки;
        ЗаписьЖурналаРегистрации("юум_ФП_ФормированиеПартий.ЗагрузкаВРЦ",
            УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ФормированиеЭтаповПроизводства,, КомментарийЖурнала);
        ЭтотОбъект["юум_ФП_СостояниеЗагрузки"] = "Не удалось получить данные загрузки. Откройте предупреждения.";
        ТекстПредупреждения = "[ВРЦ-Т01] Не удалось прочитать записанную загрузку или построить диаграмму."
            + Символы.ПС + "Передайте специалисту технические подробности. Данные НСИ наугад не изменяйте.";
        юум_ФП_ПоказатьПредупрежденияЗагрузки(ТекстПредупреждения, ПодробностиОшибки, 1);
    КонецПопытки;
КонецПроцедуры // } #юум

&НаСервере

// Параметры:
//    Перечитать - Булево - Принудительно обновить исходный снимок загрузки.
//    НачалоЗагрузки - Дата - Начало выбранного периода загрузки.
//    КонецЗагрузки - Дата - Конец выбранного периода загрузки.
//
// Возвращаемое значение:
//    Структура - Данные диаграммы, Полный, Состояние и Ошибки расчета.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьЗагрузкуФормы(Знач Перечитать, Знач НачалоЗагрузки, Знач КонецЗагрузки)
	МодельЗагрузки = Неопределено;
	АдресМодели = ЭтотОбъект["юум_ФП_АдресМодели"];
	Если ЗначениеЗаполнено(АдресМодели) Тогда
		МодельЗагрузки = ПолучитьИзВременногоХранилища(АдресМодели);
	КонецЕсли;
	Если МодельЗагрузки <> Неопределено И Не МодельЗагрузки.Свойство("План") Тогда
		МодельЗагрузки = Неопределено;
	КонецЕсли;
	АдресЗагрузки = ЭтотОбъект["юум_ФП_АдресЗагрузки"];
	СнимокЗагрузки = Неопределено;
	Если ЗначениеЗаполнено(АдресЗагрузки) Тогда
		СнимокЗагрузки = ПолучитьИзВременногоХранилища(АдресЗагрузки);
	КонецЕсли;
	Если юум_ФП_НуженСнимокЗагрузки(СнимокЗагрузки, Перечитать, НачалоЗагрузки, КонецЗагрузки, АдресМодели) Тогда
		СнимокЗагрузки = Новый Структура;
		СнимокЗагрузки.Вставить("Начало", НачалоЗагрузки);
		СнимокЗагрузки.Вставить("Конец", КонецЗагрузки);
		СнимокЗагрузки.Вставить("АдресМодели", АдресМодели);
		ДвиженияЗагрузки = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПрочитатьЗагрузку(НачалоЗагрузки, КонецЗагрузки);
		СнимокЗагрузки.Вставить("Движения", ДвиженияЗагрузки);
		СнимокЗагрузки.Вставить("Объемы", Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_ПрочитатьОбъемыПлана(СнимокЗагрузки.Движения));
		Если ЗначениеЗаполнено(АдресЗагрузки) Тогда
			ПоместитьВоВременноеХранилище(СнимокЗагрузки, АдресЗагрузки);
		Иначе
			ЭтотОбъект["юум_ФП_АдресЗагрузки"] = ПоместитьВоВременноеХранилище(СнимокЗагрузки, УникальныйИдентификатор);
		КонецЕсли;
	КонецЕсли;
	ДеревоЗагрузки = Неопределено;
	Если МодельЗагрузки <> Неопределено Тогда
		ДеревоЗагрузки = МодельЗагрузки.Дерево;
	КонецЕсли;
	Возврат Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Загрузка_РассчитатьТочнуюЗагрузку(
		СнимокЗагрузки, МодельЗагрузки, ДеревоЗагрузки);
КонецФункции // } #юум

&НаСервере

// Параметры:
//    СнимокЗагрузки - Структура, Неопределено - Кэш исходной загрузки, периода и адреса модели.
//    Перечитать - Булево - Принудительно обновить исходный снимок загрузки.
//    НачалоЗагрузки - Дата - Начало выбранного периода загрузки.
//    КонецЗагрузки - Дата - Конец выбранного периода загрузки.
//    АдресМодели - Строка - Адрес временного хранилища модели текущей формы.
//
// Возвращаемое значение:
//    Булево - Истина при отсутствии снимка, смене периода/модели или принудительном чтении.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_НуженСнимокЗагрузки(Знач СнимокЗагрузки, Знач Перечитать,
	Знач НачалоЗагрузки, Знач КонецЗагрузки, Знач АдресМодели)
	Если Перечитать Или СнимокЗагрузки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СнимокЗагрузки.Начало <> НачалоЗагрузки Или СнимокЗагрузки.Конец <> КонецЗагрузки
		Или СнимокЗагрузки.АдресМодели <> АдресМодели;
КонецФункции // } #юум


// Параметры:
//    Элемент - ПолеФормы, ТаблицаФормы - Элемент, вызвавший событие ввода или выбора строки.
//    ВыбраннаяСтрока - Число, Массив - Идентификатор строки либо выделенные идентификаторы таблицы.
//    Поле - ПолеФормы - Колонка, в которой пользователь выбрал значение.
//    СтандартнаяОбработка - Булево - Разрешение стандартного действия; сбрасывается при собственной расшифровке.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура Подключаемый_юум_ФП_ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПоляРасшифровки = СтрРазделить(
		"юум_ФП_ДеревоОбеспечено,юум_ФП_ДеревоИндикатор,юум_ФП_ДеревоМаршрут,"
		+ "юум_ФП_ДеревоДоговорПереработчик,юум_ФП_ДеревоТрудоемкость", ",");
	Если ПоляРасшифровки.Найти(Поле.Имя) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	ИдентификаторСтроки = ВыбраннаяСтрока;
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("Массив") Тогда
		ИдентификаторСтроки = Элемент.ТекущаяСтрока;
		Если ВыбраннаяСтрока.Найти(ИдентификаторСтроки) = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	СтрокаРасшифровки = ЭтотОбъект["юум_ФП_Дерево"].НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаРасшифровки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле.Имя = "юум_ФП_ДеревоОбеспечено" Или Поле.Имя = "юум_ФП_ДеревоИндикатор" Тогда
		юум_ФП_ОткрытьОбеспечение(СтрокаРасшифровки.ИдУзла);
		Возврат;
	КонецЕсли;
	ЭтотОбъект["юум_ФП_ПоказатьДетализацию"] = Истина;
	Элементы.юум_ФП_СтраницыДетализации.Видимость = Истина;
	юум_ФП_ЗаполнитьДетализациюНаСервере(СтрокаРасшифровки.ИдУзла);
	Если Поле.Имя = "юум_ФП_ДеревоТрудоемкость" Тогда
		Элементы.юум_ФП_СтраницыДетализации.ТекущаяСтраница = Элементы.юум_ФП_СтраницаНормативы;
	Иначе
		Элементы.юум_ФП_СтраницыДетализации.ТекущаяСтраница = Элементы.юум_ФП_СтраницаМаршруты;
	КонецЕсли;
КонецПроцедуры // } #юум


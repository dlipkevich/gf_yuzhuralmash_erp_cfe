// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ОбновитьДетализациюОтложенно()
	Если Не ЭтаФорма["юум_ФП_ПоказатьДетализацию"] Тогда
		Возврат;
	КонецЕсли;
	СтрокаДерева = Элементы.юум_ФП_Дерево.ТекущиеДанные;
	ИдУзла = ?(СтрокаДерева = Неопределено, "", СтрокаДерева.ИдУзла);
	Если ИдУзла <> ЭтаФорма["юум_ФП_УзелДетализации"] Тогда
		юум_ФП_ЗаполнитьДетализациюНаСервере(ИдУзла);
	КонецЕсли;
КонецПроцедуры // } #юум


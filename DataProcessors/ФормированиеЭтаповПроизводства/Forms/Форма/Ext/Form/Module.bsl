// Параметры:
//    ИмяТаблицы - Строка - Имя реквизита формы с таблицей детализации.
//    Страница - ГруппаФормы - Страница, на которой размещается таблица детализации.
//    ИменаКолонок - Строка - Имена отображаемых колонок, разделенные запятыми.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_СоздатьТаблицуДетализации(Знач ИмяТаблицы, Страница, Знач ИменаКолонок)
	ТаблицаДетализации = Элементы.Добавить(ИмяТаблицы, Тип("ТаблицаФормы"), Страница);
	ТаблицаДетализации.ПутьКДанным = ИмяТаблицы;
	ТаблицаДетализации.ТолькоПросмотр = Истина;
	ТаблицаДетализации.ИзменятьСоставСтрок = Ложь;
	ТаблицаДетализации.Высота = 5;
	ТаблицаДетализации.РастягиватьПоГоризонтали = Истина;
	ТаблицаДетализации.РастягиватьПоВертикали = Ложь;
	ТаблицаДетализации.УстановитьДействие("Выбор", "Подключаемый_юум_ФП_ДетализацияВыбор");
	СсылочныеКолонки = СтрРазделить(
		"Номенклатура,Характеристика,Спецификация,Этап,Подразделение,Переработчик,Договор,ВидРабот", ",");
	Для Каждого ИмяКолонки Из СтрРазделить(ИменаКолонок, ",") Цикл
		ЗаголовокКолонки = юум_ФП_ЗаголовокДетализации(ИмяКолонки);
		ПолеКолонки = юум_ФП_ДобавитьПоле(ИмяТаблицы + ИмяКолонки,
		    ЗаголовокКолонки, ТаблицаДетализации, ИмяТаблицы + "." + ИмяКолонки, Истина);
		ПолеКолонки.Ширина = 18;
		Если СсылочныеКолонки.Найти(ИмяКолонки) <> Неопределено Тогда
			ПолеКолонки.ГиперссылкаЯчейки = Истина;
		КонецЕсли;
		Если ИмяКолонки = "Номенклатура" Или ИмяКолонки = "Основание"
			Или ИмяКолонки = "НормаНаЕдиницу" Тогда
			ПолеКолонки.Ширина = 40;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум


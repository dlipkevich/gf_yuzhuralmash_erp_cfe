&НаСервере
&Перед("СоздатьДокументыНаСервере")

// Параметры:
//    Отказ - Булево - Признак отмены штатного действия; Истина прекращает его выполнение.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗафиксироватьКомментарииЗапуска(Отказ)
	Если Отказ Или Не ЗначениеЗаполнено(ЭтотОбъект["юум_ФП_АдресМодели"]) Тогда
		Возврат;
	КонецЕсли;
	Модель = юум_ФП_ТекущаяМодель();
	Если Не Модель.Свойство("План") Тогда
		Возврат;
	КонецЕсли;
	ПараметрыЗапуска = Новый Структура;
	Для Каждого ПараметрЗапуска Из ЭтотОбъект["ПараметрыСозданияДокументов"] Цикл
		Если ПараметрЗапуска.Ключ <> "юум_ФП_Комментарии" Тогда
			ПараметрыЗапуска.Вставить(ПараметрЗапуска.Ключ, ПараметрЗапуска.Значение);
		КонецЕсли;
	КонецЦикла;
	КомментарииЗапуска = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_КомментарииДляПередачи(Модель);
	ПараметрыЗапуска.Вставить("юум_ФП_Комментарии", КомментарииЗапуска);
	ЭтотОбъект["ПараметрыСозданияДокументов"] = ПараметрыЗапуска;
КонецПроцедуры // } #юум

#КонецОбласти


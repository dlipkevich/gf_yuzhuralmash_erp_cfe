// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_КонтекстДерева()
	Контекст = Новый Структура;
	Контекст.Вставить("Идентификаторы", Новый Соответствие);
	Контекст.Вставить("Раскрытие", Новый Соответствие);
	Контекст.Вставить("Выделенные", Новый Массив);
	Контекст.Вставить("ПредкиТекущей", Новый Массив);
	юум_ФП_СобратьКонтекстСтрок(ЭтотОбъект["юум_ФП_Дерево"].ПолучитьЭлементы(), Контекст);
	Для Каждого ИдентификаторСтроки Из Элементы.юум_ФП_Дерево.ВыделенныеСтроки Цикл
		СтрокаВыбора = ЭтотОбъект["юум_ФП_Дерево"].НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаВыбора <> Неопределено Тогда
			Контекст.Выделенные.Добавить(СтрокаВыбора.ИдУзла);
		КонецЕсли;
	КонецЦикла;
	ТекущийПредок = Элементы.юум_ФП_Дерево.ТекущиеДанные;
	ОставшиесяПереходы = Контекст.Идентификаторы.Количество();
	Пока ТекущийПредок <> Неопределено И ОставшиесяПереходы > 0 Цикл
		Контекст.ПредкиТекущей.Добавить(ТекущийПредок.ИдУзла);
		ТекущийПредок = ТекущийПредок.ПолучитьРодителя();
		ОставшиесяПереходы = ОставшиесяПереходы - 1;
	КонецЦикла;
	Возврат Контекст;
КонецФункции // } #юум


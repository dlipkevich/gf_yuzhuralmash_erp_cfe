// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ЗаголовокДетализации(Знач ИмяКолонки)
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("ПредставлениеНормы", "Количество в изделии");
	Заголовки.Вставить("ЕдиницаИзмерения", "Ед. измерения");
	Заголовки.Вставить("ПоСтруктуре", "В исходном составе");

Процедура юум_ФП_СоздатьДействияДерева()
	ГруппаДействий = Элементы.Добавить("юум_ФП_ДействияДерева", Тип("ГруппаФормы"), Элементы.ШагНоменклатурныйПлан);
	ГруппаДействий.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаДействий.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаДействий.ОтображатьЗаголовок = Ложь;
	ПолеПоиска = юум_ФП_ДобавитьПоле("юум_ФП_Поиск", "Поиск", ГруппаДействий, "юум_ФП_Поиск", Ложь);
	ПолеПоиска.Ширина = 35;
	ПолеПоиска.РастягиватьПоГоризонтали = Ложь;
	ПолеПоиска.Подсказка = "Фрагмент кода или наименования. Поиск меняет только отображение, сохраняя выбор скрытых позиций.";
	ПолеПоиска.УстановитьДействие("ПриИзменении", "Подключаемый_юум_ФП_ПоискПриИзменении");
	юум_ФП_ДобавитьКомандуДерева("юум_ФП_РазвернутьДерево", "Развернуть", ГруппаДействий);
	юум_ФП_ДобавитьКомандуДерева("юум_ФП_СвернутьДерево", "Свернуть", ГруппаДействий);
	ПолеДетализации = юум_ФП_ДобавитьПоле("юум_ФП_ПоказатьДетализацию", "Состав, маршруты и комментарий",
		ГруппаДействий, "юум_ФП_ПоказатьДетализацию", Ложь);
	ПолеДетализации.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеДетализации.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
	ПолеДетализации.УстановитьДействие("ПриИзменении", "Подключаемый_юум_ФП_ДетализацияПриИзменении");
	ГруппаДействий.РастягиватьПоГоризонтали = Истина;
	ГруппаДействий.РастягиватьПоВертикали = Ложь;
	ПолеДетализации.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	Элементы.Переместить(Элементы.юум_ФП_Период, Элементы.ШагНоменклатурныйПлан);
КонецПроцедуры // } #юум


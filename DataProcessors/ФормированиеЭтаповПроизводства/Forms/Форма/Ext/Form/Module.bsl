	Если РезультатРасшифровки.Варианты.Количество() > 0 Тогда
		ОповещениеВыбора = Новый ОписаниеОповещения("Подключаемый_юум_ФП_ПослеВыбораСпецификации", ЭтаФорма, ИдУзла);

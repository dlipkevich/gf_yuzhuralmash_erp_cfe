// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьДетализациюНаСервере(Знач ИдУзла)
	Состав = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_НоваяТаблицаСостава();
	Маршруты = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаМаршрута();
	Работы = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаРабот();
	Модель = юум_ФП_ТекущаяМодель();
	Если Модель <> Неопределено И ЗначениеЗаполнено(ИдУзла) Тогда
		Состав = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_СоставВыбраннойПозиции(Модель, ИдУзла);
		Маршруты = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_МаршрутПозиции(Модель, ИдУзла);
		Работы = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_РаботыПозиции(Модель, ИдУзла);
	КонецЕсли;
	ЗначениеВРеквизитФормы(Состав, "юум_ФП_Состав");
	ЗначениеВРеквизитФормы(Маршруты, "юум_ФП_Маршруты");
	ЗначениеВРеквизитФормы(Работы, "юум_ФП_Работы");
	ЭтаФорма["юум_ФП_УзелДетализации"] = ИдУзла;
КонецПроцедуры // } #юум


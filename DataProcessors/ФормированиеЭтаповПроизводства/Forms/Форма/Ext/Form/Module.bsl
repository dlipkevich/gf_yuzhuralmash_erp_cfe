	юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, "юум_ФП_Работы", СхемаРабот);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, Новый Массив);
	ЗначениеВРеквизитФормы(СхемаДерева, "юум_ФП_Дерево");
	ЭтотОбъект["юум_ФП_НачалоПериода"] = НачалоМесяца(ТекущаяДатаСеанса());
	ЭтотОбъект["юум_ФП_КонецПериода"] = КонецМесяца(ЭтотОбъект["юум_ФП_НачалоПериода"]);


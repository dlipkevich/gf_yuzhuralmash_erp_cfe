Процедура юум_ФП_ЗаполнитьВыделенные(Знач Режим)
	Контекст = юум_ФП_КонтекстДерева();
	Если Контекст.Выделенные.Количество() = 0 Тогда
		юум_ФП_ПоказатьПредупреждение("Выделите строки для заполнения количества к запуску.");
		Возврат;
	КонецЕсли;
	ТекстПредупреждения = юум_ФП_ЗаполнитьВыборНаСервере(Контекст.Выделенные, Режим);
	юум_ФП_ВосстановитьКонтекстДерева(Контекст);
	юум_ФП_ПоказатьПредупреждение(ТекстПредупреждения);
КонецПроцедуры // } #юум


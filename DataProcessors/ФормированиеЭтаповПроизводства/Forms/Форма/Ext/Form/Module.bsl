// Параметры:
//    Отказ - Булево - Признак отмены штатного действия; Истина прекращает его выполнение.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПередПредварительнымПросмотром(Отказ)
	Если Отказ Или Не ЗначениеЗаполнено(ЭтотОбъект["юум_ФП_АдресМодели"]) Тогда
		Возврат;
	КонецЕсли;
	МодельЗапуска = ПолучитьИзВременногоХранилища(ЭтотОбъект["юум_ФП_АдресМодели"]);
	Если МодельЗапуска = Неопределено Или Не МодельЗапуска.Свойство("План") Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Данные состава запуска устарели. Обновите состав.";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ДеревоЗапуска = МодельЗапуска.Дерево;
	ОшибкаКомплектности = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ОшибкаКомплектностиЗапуска(ДеревоЗапуска);
	Если ЗначениеЗаполнено(ОшибкаКомплектности) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОшибкаКомплектности;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
	ПланЗапуска = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_ПланДляФормирования(МодельЗапуска, ДеревоЗапуска);
	Для Каждого ГруппаПлана Из Объект.ПланИтоги Цикл
		ОтборГруппы = Новый Структура("НомерГруппы,Номенклатура,Характеристика");
		ЗаполнитьЗначенияСвойств(ОтборГруппы, ГруппаПлана);
		СтрокиГруппы = ПланЗапуска.Скопировать(ОтборГруппы);
		ГруппаПлана.КЗапуску = СтрокиГруппы.Итог("КЗапуску");
		ГруппаПлана.Отметка = ГруппаПлана.КЗапуску > 0;
		ГруппаПлана.ОтметкаФорма = ?(ГруппаПлана.Отметка, 1, 0);
		ГруппаПлана.ПланВХранилище = ГруппаПлана.Отметка;
		ГруппаПлана.АвтоПересчет = Ложь;
	КонецЦикла;
	ПоместитьВоВременноеХранилище(ПланЗапуска, АдресПланХранилище);
КонецПроцедуры // } #юум


// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ОбновитьДетализациюСОтсрочкой()
	Если Не ЭтотОбъект["юум_ФП_ПоказатьДетализацию"] Тогда
		Возврат;
	КонецЕсли;
	СтрокаДерева = Элементы.юум_ФП_Дерево.ТекущиеДанные;
	ИдУзла = ?(СтрокаДерева = Неопределено, "", СтрокаДерева.ИдУзла);
	Если ИдУзла <> ЭтотОбъект["юум_ФП_УзелДетализации"] Тогда
		юум_ФП_ЗаполнитьДетализациюНаСервере(ИдУзла);
	КонецЕсли;
КонецПроцедуры // } #юум

&НаСервере

// Параметры:
//    ИдУзла - Строка - Устойчивый идентификатор вхождения в модели запуска.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗаполнитьДетализациюНаСервере(Знач ИдУзла)
	Состав = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_НоваяТаблицаСостава();
	Маршруты = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаМаршрута();
	Работы = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаРабот();
	Модель = юум_ФП_ТекущаяМодель();
	Если Модель <> Неопределено И ЗначениеЗаполнено(ИдУзла) Тогда
		Состав = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_СоставВыбраннойПозиции(Модель, ИдУзла);
		Маршруты = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_МаршрутПозиции(Модель, ИдУзла);
		Работы = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_РаботыПозиции(Модель, ИдУзла);
	КонецЕсли;
	ЗначениеВРеквизитФормы(Состав, "юум_ФП_Состав");
	ЗначениеВРеквизитФормы(Маршруты, "юум_ФП_Маршруты");
	ЗначениеВРеквизитФормы(Работы, "юум_ФП_Работы");
	ЭтотОбъект["юум_ФП_УзелДетализации"] = ИдУзла;
КонецПроцедуры // } #юум

&НаСервере

// Параметры:
//    ВидСтроки - Строка - Вид позиции для оформления изделия и агрегата.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ОформитьВидСтроки(Знач ВидСтроки)
	ПравилоОформления = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Код,Представление,ЕдиницаИзмерения,Требуется,КЗапуску,Обеспечено,"
		+ "Маршрут,ДоговорПереработчик,Трудоемкость,СуммаПоГруппе", ",") Цикл
		ПравилоОформления.Поля.Элементы.Добавить().Поле =
			Новый ПолеКомпоновкиДанных("юум_ФП_Дерево" + ИмяКолонки);
	КонецЦикла;
	ОтборВида = ПравилоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборВида.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("юум_ФП_Дерево.ВидСтроки");
	ОтборВида.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборВида.ПравоеЗначение = ВидСтроки;
	ШрифтСтроки = ШрифтыСтиля.ВажнаяНадписьШрифт;
	ПравилоОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтСтроки);
	Если ВидСтроки = "Изделие" Тогда
		ПравилоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.Бежевый);
	КонецЕсли;
КонецПроцедуры // } #юум


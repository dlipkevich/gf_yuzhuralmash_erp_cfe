// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_СоздатьИнтерфейс()

	СхемаДерева = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_НовоеДеревоЗапуска();
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"юум_ФП_Дерево", Новый ОписаниеТипов("ДеревоЗначений")));
	Для Каждого КолонкаСхемы Из СхемаДерева.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			КолонкаСхемы.Имя, КолонкаСхемы.ТипЗначения, "юум_ФП_Дерево"));
	КонецЦикла;
	Для Каждого ИмяРеквизита Из СтрРазделить(
		"юум_ФП_УзелДетализации,юум_ФП_АдресМодели,юум_ФП_Сообщение,юум_ФП_Комментарий,юум_ФП_АдресЗагрузки,юум_ФП_СостояниеЗагрузки,юум_ФП_Поиск,юум_ФП_УзелКомментария,юум_ФП_АдресатыКомментария,юум_ФП_АдресПланаРасшифровки", ",") Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			ИмяРеквизита, Новый ОписаниеТипов("Строка")));
	КонецЦикла;
	Для Каждого ИмяРеквизита Из СтрРазделить(
		"юум_ФП_Изменено,юум_ФП_ПоказатьЗагрузку,юум_ФП_ФормированиеВыполняется,юум_ФП_ПоказатьДетализацию", ",") Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			ИмяРеквизита, Новый ОписаниеТипов("Булево")));
	КонецЦикла;
	Для Каждого ИмяРеквизита Из СтрРазделить(
		"юум_ФП_НачалоПериода,юум_ФП_КонецПериода", ",") Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
			ИмяРеквизита, Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата))));
	КонецЦикла;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"юум_ФП_ДиаграммаЗагрузки", Новый ОписаниеТипов("Диаграмма")));
	юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, "юум_ФП_Состав",
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_НоваяТаблицаСостава());
	юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, "юум_ФП_Маршруты",
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаМаршрута());
	юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, "юум_ФП_Работы",
		Обработки.ФормированиеЭтаповПроизводства.юум_ФП_Нормативы_НоваяТаблицаРабот());
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, Новый Массив);
	ЗначениеВРеквизитФормы(СхемаДерева, "юум_ФП_Дерево");
	ЭтаФорма["юум_ФП_НачалоПериода"] = НачалоМесяца(ТекущаяДатаСеанса());
	ЭтаФорма["юум_ФП_КонецПериода"] = КонецМесяца(ЭтаФорма["юум_ФП_НачалоПериода"]);

	юум_ФП_СоздатьПериод();
	юум_ФП_СоздатьДействияДерева();
	юум_ФП_СоздатьТаблицу();
	юум_ФП_ОформитьВидСтроки("Изделие");
	юум_ФП_ОформитьВидСтроки("Агрегат");
	юум_ФП_СоздатьСтраницыДетализации();
	юум_ФП_СоздатьКомментарий();
	юум_ФП_СоздатьБлокЗагрузки();
КонецПроцедуры // } #юум


// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ДобавитьКолонку(Знач ИмяКолонки, Знач Заголовок, Знач Ширина, Знач ТолькоПросмотр)

	ИмяРеквизита = ИмяКолонки;
	Если ИмяКолонки = "Трудоемкость" Или ИмяКолонки = "СуммаПоГруппе" Тогда
		ИмяРеквизита = ИмяКолонки + "Представление";
	КонецЕсли;
	ИмяЭлемента = "юум_ФП_Дерево" + ИмяКолонки;
	ПолеКолонки = юум_ФП_ДобавитьПоле(ИмяЭлемента, Заголовок,
		Элементы.юум_ФП_Дерево, "юум_ФП_Дерево." + ИмяРеквизита, ТолькоПросмотр);
	ПолеКолонки.Ширина = Ширина;
	ПолеКолонки.АвтоМаксимальнаяШирина = Ложь;
	ПолеКолонки.МаксимальнаяШирина = Ширина;
	Возврат ПолеКолонки;

КонецФункции // } #юум


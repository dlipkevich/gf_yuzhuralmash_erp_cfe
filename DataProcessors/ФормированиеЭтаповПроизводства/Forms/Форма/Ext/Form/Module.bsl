// Параметры:
//    СтрокиФормы - ДанныеФормыКоллекцияЭлементовДерева - Строки текущего уровня дерева формы.
//    Контекст - Структура - Текущий узел, выделение, раскрытие и комментарий дерева формы.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_СобратьКонтекстСтрок(СтрокиФормы, Контекст)
	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		ИдентификаторСтроки = СтрокаФормы.ПолучитьИдентификатор();
		Контекст.Идентификаторы.Вставить(СтрокаФормы.ИдУзла, ИдентификаторСтроки);
		ДочерниеСтроки = СтрокаФормы.ПолучитьЭлементы();
		Если ДочерниеСтроки.Количество() > 0 Тогда
			УзелРаскрыт = Элементы.юум_ФП_Дерево.Развернут(ИдентификаторСтроки);
			Контекст.Раскрытие.Вставить(СтрокаФормы.ИдУзла, УзелРаскрыт);
		КонецЕсли;
		юум_ФП_СобратьКонтекстСтрок(ДочерниеСтроки, Контекст);
	КонецЦикла;
КонецПроцедуры // } #юум


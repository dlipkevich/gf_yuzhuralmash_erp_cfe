// Параметры:
//    СтрокиФормы - ДанныеФормыКоллекцияЭлементовДерева - Строки текущего уровня дерева формы.
//    Раскрытие - Соответствие - Сохраненные признаки раскрытия по идентификаторам узлов.
//    НовыеИдентификаторы - Соответствие - Новые идентификаторы строк формы по устойчивым ключам модели.
//    ВосстановитьРаскрытие - Булево - Восстанавливать сохраненное раскрытие узлов после обновления.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ВосстановитьКонтекстСтрок(СтрокиФормы, Раскрытие, НовыеИдентификаторы, Знач ВосстановитьРаскрытие)
	Для Каждого СтрокаФормы Из СтрокиФормы Цикл
		ИдентификаторСтроки = СтрокаФормы.ПолучитьИдентификатор();
		НовыеИдентификаторы.Вставить(СтрокаФормы.ИдУзла, ИдентификаторСтроки);
		ДочерниеСтроки = СтрокаФормы.ПолучитьЭлементы();
		юум_ФП_ВосстановитьКонтекстСтрок(ДочерниеСтроки,
		    Раскрытие, НовыеИдентификаторы, ВосстановитьРаскрытие);
		Если Не ВосстановитьРаскрытие Тогда
			Продолжить;
		КонецЕсли;
		БылРазвернут = Раскрытие.Получить(СтрокаФормы.ИдУзла);
		Если БылРазвернут = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если БылРазвернут Тогда
			Элементы.юум_ФП_Дерево.Развернуть(ИдентификаторСтроки);
		Иначе
			Элементы.юум_ФП_Дерево.Свернуть(ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум


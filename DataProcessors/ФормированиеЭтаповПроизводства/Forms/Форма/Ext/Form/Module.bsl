// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_СоздатьПериод()
	СтрокаШага = Элементы.Добавить("юум_ФП_СтрокаШага", Тип("ГруппаФормы"), Элементы.СтраницаЭлементы);
	СтрокаШага.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	СтрокаШага.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СтрокаШага.ОтображатьЗаголовок = Ложь;
	СтрокаШага.РастягиватьПоГоризонтали = Истина;
	СтрокаШага.РастягиватьПоВертикали = Ложь;
	Элементы.Переместить(СтрокаШага, Элементы.СтраницаЭлементы, Элементы.СтраницыПомощника);
	Элементы.Переместить(Элементы.НадписьШаг, СтрокаШага);
	Элементы.НадписьШаг.РастягиватьПоГоризонтали = Истина;
	СлужебныеКоманды = Элементы.Добавить("юум_ФП_СлужебныеКоманды", Тип("ГруппаФормы"), СтрокаШага);
	СлужебныеКоманды.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	СлужебныеКоманды.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	СлужебныеКоманды.ОтображатьЗаголовок = Ложь;
	СлужебныеКоманды.РастягиватьПоГоризонтали = Ложь;
	СлужебныеКоманды.Видимость = Элементы.СтраницыПомощника.ТекущаяСтраница = Элементы.ШагНоменклатурныйПлан;
	Элементы.Переместить(Элементы.ГруппаКоманднаяПанельНоменклатурныйПланЕще, СлужебныеКоманды);
	Элементы.Переместить(Элементы.ПоказатьНастройки, СлужебныеКоманды);
	Элементы.Переместить(Элементы.ПланГруппаДействия,
		Элементы.ГруппаКоманднаяПанельНоменклатурныйПлан, Элементы.ПланГруппаФлажки);
	ГруппаПериода = Элементы.Добавить("юум_ФП_Период", Тип("ГруппаФормы"), Элементы.ШагНоменклатурныйПлан);
	ГруппаПериода.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПериода.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаПериода.ОтображатьЗаголовок = Ложь;
	ГруппаПериода.РастягиватьПоВертикали = Ложь;
	НачалоПериодаПоле = юум_ФП_ДобавитьПоле(
		"юум_ФП_НачалоПериода", "Период загрузки", ГруппаПериода, "юум_ФП_НачалоПериода", Ложь);
	НачалоПериодаПоле.Ширина = 10;
	КонецПериодаПоле = юум_ФП_ДобавитьПоле(
		"юум_ФП_КонецПериода", "по", ГруппаПериода, "юум_ФП_КонецПериода", Ложь);
	КонецПериодаПоле.Ширина = 10;
	ПолеВидимости = юум_ФП_ДобавитьПоле("юум_ФП_ПоказатьЗагрузку", "Показать загрузку цехов",
		ГруппаПериода, "юум_ФП_ПоказатьЗагрузку", Ложь);
	ПолеВидимости.Вид = ВидПоляФормы.ПолеФлажка;
	ПолеВидимости.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
КонецПроцедуры // } #юум


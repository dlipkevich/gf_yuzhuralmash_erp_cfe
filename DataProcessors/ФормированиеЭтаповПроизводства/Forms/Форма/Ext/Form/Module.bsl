	КонецПериодаПоле.Ширина = 10;
	ПолеВидимости = юум_ФП_ДобавитьПоле("юум_ФП_ПоказатьЗагрузку", "Показать загрузку цехов",
		ГруппаПериода, "юум_ФП_ПоказатьЗагрузку", Ложь);

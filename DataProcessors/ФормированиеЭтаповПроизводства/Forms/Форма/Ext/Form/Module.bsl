// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Процедура Подключаемый_юум_ФП_ДетализацияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ИмяКолонки = Сред(Поле.Имя, СтрДлина(Элемент.Имя) + 1);
	СсылочныеКолонки = СтрРазделить(
		"Номенклатура,Характеристика,Спецификация,Этап,Подразделение,Переработчик,Договор,ВидРабот", ",");
	Если СсылочныеКолонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ВыбраннаяСтрока) = Тип("Массив") Тогда
		Если ВыбраннаяСтрока.Найти(Элемент.ТекущаяСтрока) = Неопределено Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если ВыбраннаяСтрока <> Элемент.ТекущаяСтрока Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ДанныеСтроки = Элемент.ТекущиеДанные;
	Если ДанныеСтроки <> Неопределено Тогда
		ИсходнаяСсылка = ДанныеСтроки[ИмяКолонки];
		Если ЗначениеЗаполнено(ИсходнаяСсылка) Тогда
			ПоказатьЗначение(, ИсходнаяСсылка);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры // } #юум


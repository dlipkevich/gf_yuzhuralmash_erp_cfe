// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ДобавитьПоле(Знач ИмяЭлемента, Знач Заголовок, Родитель, Знач ПутьКДанным, Знач ТолькоПросмотр)

	ПолеФормы = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
	ПолеФормы.Вид = ВидПоляФормы.ПолеВвода;
	ПолеФормы.Заголовок = Заголовок;
	ПолеФормы.ПутьКДанным = ПутьКДанным;
	ПолеФормы.ТолькоПросмотр = ТолькоПросмотр;
	Возврат ПолеФормы;

КонецФункции // } #юум


	ДобавляемыйРеквизит = Новый РеквизитФормы(
		"юум_ФП_ДиаграммаЗагрузки", ТипРеквизита);
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);
	СхемаСостава = Обработки.ФормированиеЭтаповПроизводства.юум_ФП_НоваяТаблицаСостава();
	юум_ФП_ДобавитьСхемуТаблицы(ДобавляемыеРеквизиты, "юум_ФП_Состав", СхемаСостава);

// Создает одну команду справки и ее кнопки на существующих панелях шагов.
// #юум {
// #ЧТЗ 04.01
// Сохраняется расположение служебных команд, новые общие модули не нужны.
// Галфинд mr. Cherryman 2026/11/13
Процедура юум_ФП_СоздатьКомандуСправки()
    КомандаСправки = Команды.Добавить("юум_ФП_ОткрытьСправкуВРЦ");
    КомандаСправки.Действие = "юум_ФП_ОткрытьСправкуВРЦ";
    КомандаСправки.Заголовок = "Справка: загрузка ВРЦ";
    КомандаСправки.Картинка = БиблиотекаКартинок.СправкаФормы;
    ПанелиСправки = СтрРазделить("ВсеДействияШагОтборКоманднаяПанельФормы,"
        + "ГруппаКоманднаяПанельНоменклатурныйПланЕще,КоманднаяПанельПредварительныйПросмотрЕще,"
        + "ГруппаДействияРезультатФормированияЕще", ",");
    Для Каждого ИмяПанели Из ПанелиСправки Цикл
        РодительКнопки = Элементы[ИмяПанели];
        ИмяКнопки = "юум_ФП_СправкаВРЦ" + ИмяПанели;
        КнопкаСправки = Элементы.Добавить(ИмяКнопки, Тип("КнопкаФормы"), РодительКнопки);
        КнопкаСправки.ИмяКоманды = КомандаСправки.Имя;
        КнопкаСправки.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
        КнопкаСправки.Отображение = ОтображениеКнопки.Картинка;
    КонецЦикла;
КонецПроцедуры // } #юум

// Обновляет видимую кнопку и данные отдельного окна предупреждений.
// Параметры:
//  ТекстПредупреждений - Строка - понятный пользователю перечень проблем.
//  Подробности - Строка - полный технический контекст для специалиста.
//  Количество - Число - количество проблем в текущем результате.
// #юум {
// #ЧТЗ 04.01
// Загрузка отчета, частичный прогноз и отдельные предупреждения.
// Галфинд mr. Cherryman 2026/11/13
&НаСервере
Процедура юум_ФП_ПоказатьПредупрежденияЗагрузки(Знач ТекстПредупреждений, Знач Подробности, Знач Количество)
    ЭтотОбъект["юум_ФП_Предупреждения"] = ТекстПредупреждений;
    ЭтотОбъект["юум_ФП_ПодробностиЗагрузки"] = Подробности;
    КнопкаПредупреждений = Элементы.юум_ФП_ОткрытьПредупрежденияКнопка;
    КнопкаПредупреждений.Заголовок = "Предупреждения (" + Строка(Количество) + ")";
    КнопкаПредупреждений.Видимость = Количество > 0;
КонецПроцедуры // } #юум


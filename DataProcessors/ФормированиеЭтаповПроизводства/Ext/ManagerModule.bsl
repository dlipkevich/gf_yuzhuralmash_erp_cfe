	ВкладыРабот = Новый Соответствие;
	СтрокиРабот = Новый Соответствие;
	Для Каждого ПозицияПлана Из ПланПозиции Цикл
		юум_ФП_Нормативы_ДобавитьРасшифровкуРабот(ПозицияПлана, Модель.Нормативы,
			Результат, СтрокиРабот, ВкладыРабот);
	КонецЦикла;
	Для Каждого Работа Из Результат Цикл
		ВкладыВыпусков = ВкладыРабот.Получить(Работа.КлючРаботы);
		Для Каждого ВкладВыпуска Из ВкладыВыпусков Цикл
			Работа.КоличествоРабот = Макс(Работа.КоличествоРабот, ВкладВыпуска.Значение);
		КонецЦикла;
		Если Работа.Кратность > 0 И Работа.Состояние = "" Тогда
			Работа.Часы = Работа.КоличествоРабот * Работа.Трудоемкость / Работа.Кратность;
			Работа.ЧасыПредставление = Формат(Работа.Часы, "ЧДЦ=3;ЧН=0");
		Иначе
			Работа.ЧасыПредставление = "Не рассчитано";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции // } #юум

// Читает используемый типовым отчетом регистр, без отбора только по заказам формы.
// Параметры:
//  НачалоПериода - Дата - начало пользовательского периода.
//  КонецПериода - Дата - окончание пользовательского периода.
// Возвращаемое значение:
//  ТаблицаЗначений - исходные движения ВРЦ с идентичностью партии и этапа.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ПрочитатьЗагрузку(Знач НачалоПериода, Знач КонецПериода) Экспорт
	юум_ФП_Загрузка_ПроверитьПериод(НачалоПериода, КонецПериода);
	ЗапросЗагрузки = Новый Запрос;
	ЗапросЗагрузки.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Загрузка.Регистратор КАК Регистратор,
	|	Загрузка.НомерСтроки КАК НомерСтроки,
	|	Загрузка.ДатаИнтервала КАК ДатаИнтервала,
	|	Загрузка.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ВидыЦентров.Подразделение КАК Подразделение,
	|	Загрузка.ВариантНаладки КАК ВариантНаладки,
	|	Загрузка.КлючПартия КАК КлючПартия,
	|	ВЫБОР
	|		КОГДА Этапы.Ссылка ЕСТЬ НЕ NULL ТОГДА Этапы.Распоряжение
	|		КОГДА Загрузка.Регистратор ССЫЛКА Документ.ЗаказНаПроизводство
	|			ТОГДА Загрузка.Регистратор
	|		КОГДА Загрузка.Регистратор ССЫЛКА Документ.МаршрутныйЛистПроизводства
	|			ТОГДА ВЫРАЗИТЬ(Загрузка.Регистратор КАК Документ.МаршрутныйЛистПроизводства).Распоряжение
	|		ИНАЧЕ Загрузка.Распоряжение
	|	КОНЕЦ КАК ЗаказНаПроизводство,
	|	ЕСТЬNULL(Этапы.ПартияПроизводства,
	|		ЗНАЧЕНИЕ(Справочник.ПартииПроизводства.ПустаяСсылка)) КАК ПартияПроизводства,
	|	ВЫБОР КОГДА Этапы.Ссылка ЕСТЬ НЕ NULL ТОГДА Этапы.Этап
	|		ИНАЧЕ ВЫРАЗИТЬ(Загрузка.Этап КАК Справочник.ЭтапыПроизводства)
	|	КОНЕЦ КАК ЭтапСпецификации,
	|	Этапы.Ссылка ЕСТЬ НЕ NULL КАК ЕстьДокумент,
	|	ВЫБОР
	|		КОГДА Загрузка.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2 ТОГДА 3
	|		КОГДА Этапы.Ссылка ЕСТЬ НЕ NULL ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет,
	|	ЕСТЬNULL(Этапы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен)
	|		ИЛИ Этапы.ПометкаУдаления, ЛОЖЬ) КАК Завершено,
	|	Загрузка.Занято КАК ЗанятоСекунд
	|ИЗ
	|	РегистрНакопления.ДоступностьВидовРабочихЦентров КАК Загрузка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРабочихЦентров КАК ВидыЦентров
	|		ПО Загрузка.ВидРабочегоЦентра = ВидыЦентров.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
	|		ПО ВЫБОР
	|			КОГДА Загрузка.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	|				ТОГДА Загрузка.Регистратор
	|			ИНАЧЕ Загрузка.Этап
	|		КОНЕЦ = Этапы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК Заказы
	|		ПО ВЫБОР КОГДА Этапы.Ссылка ЕСТЬ НЕ NULL ТОГДА Этапы.Распоряжение
	|			ИНАЧЕ Загрузка.Распоряжение КОНЕЦ = Заказы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство.Продукция КАК ПродукцияПрежнихЗаказов
	|		ПО ВЫБОР КОГДА Загрузка.Регистратор ССЫЛКА Документ.ЗаказНаПроизводство
	|			ТОГДА Загрузка.Регистратор
	|			ИНАЧЕ ВЫРАЗИТЬ(Загрузка.Регистратор КАК Документ.МаршрутныйЛистПроизводства).Распоряжение
	|		КОНЕЦ = ПродукцияПрежнихЗаказов.Ссылка
	|			И Загрузка.КодСтрокиПродукция = ПродукцияПрежнихЗаказов.КодСтроки
	|ГДЕ
	|	Загрузка.Активность
	|	И (Заказы.Ссылка ЕСТЬ NULL
	|		ИЛИ НЕ Заказы.ПометкаУдаления
	|			И Заказы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство2_2.КПроизводству))
	|	И (НЕ Загрузка.Регистратор ССЫЛКА Документ.ЗаказНаПроизводство
	|			И НЕ Загрузка.Регистратор ССЫЛКА Документ.МаршрутныйЛистПроизводства
	|		ИЛИ ПродукцияПрежнихЗаказов.ГрафикРассчитан
	|			И ПродукцияПрежнихЗаказов.Ссылка.Статус
	|				<> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовНаПроизводство.Закрыт))
	|	И (Загрузка.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	|		ИЛИ Загрузка.Регистратор ССЫЛКА Документ.РегистраторГрафикаПроизводства
	|		ИЛИ Загрузка.Регистратор ССЫЛКА Документ.ЗаказНаПроизводство
	|		ИЛИ Загрузка.Регистратор ССЫЛКА Документ.МаршрутныйЛистПроизводства)
	|	И ВЫБОР
	|		КОГДА ВидыЦентров.Подразделение.ИнтервалПланирования
	|			= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Неделя)
	|			ТОГДА Загрузка.ДатаИнтервала МЕЖДУ &НачалоНедели И &КонецНедели
	|		КОГДА ВидыЦентров.Подразделение.ИнтервалПланирования
	|			= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Месяц)
	|			ТОГДА Загрузка.ДатаИнтервала МЕЖДУ &НачалоМесяца И &КонецМесяца
	|		ИНАЧЕ Загрузка.ДатаИнтервала МЕЖДУ &НачалоДня И &КонецДня
	|	КОНЕЦ";
	ЗапросЗагрузки.УстановитьПараметр("НачалоДня", НачалоДня(НачалоПериода));
	ЗапросЗагрузки.УстановитьПараметр("КонецДня", КонецДня(КонецПериода));
	ЗапросЗагрузки.УстановитьПараметр("НачалоНедели", НачалоНедели(НачалоПериода));
	ЗапросЗагрузки.УстановитьПараметр("КонецНедели", КонецНедели(КонецПериода));
	ЗапросЗагрузки.УстановитьПараметр("НачалоМесяца", НачалоМесяца(НачалоПериода));
	ЗапросЗагрузки.УстановитьПараметр("КонецМесяца", КонецМесяца(КонецПериода));
	Возврат ЗапросЗагрузки.Выполнить().Выгрузить();
КонецФункции // } #юум

// Полный остаток производства по заказам формы без ее номенклатурных отборов.
// Параметры:
//  План - ТаблицаЗначений - исходные детальные строки типового плана.
// Возвращаемое значение:
//  ТаблицаЗначений - заказ, ключ партии, ключ номенклатуры, Требуется.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ПрочитатьОбъемыПлана(Знач План) Экспорт
	ЗапросОбъемов = Новый Запрос;
	ЗапросОбъемов.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Производство.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	Производство.КлючПартия КАК КлючПартия,
	|	Производство.КлючНоменклатура КАК КлючНоменклатура,
	|	СУММА(Производство.Запланировано + Производство.РазборкаЗапланировано) КАК Требуется
	|ИЗ РегистрСведений.СтруктураЗаказа КАК Производство
	|ГДЕ Производство.ЗаказНаПроизводство В (&Заказы)
	|	И Производство.ВидСтроки В (
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка))
	|СГРУППИРОВАТЬ ПО Производство.ЗаказНаПроизводство,
	|	Производство.КлючПартия, Производство.КлючНоменклатура";
	ЗапросОбъемов.УстановитьПараметр("Заказы", План.ВыгрузитьКолонку("ЗаказНаПроизводство"));
	Возврат ЗапросОбъемов.Выполнить().Выгрузить();
КонецФункции // } #юум

// Создает новый объект диаграммы; существующая диаграмма формы не меняется.
// Параметры:
//  ЗагрузкаПоДням - ТаблицаЗначений - День, Подразделение, ЗанятоЧасов.
//  НачалоПериода - Дата - первый отображаемый день.
//  КонецПериода - Дата - последний отображаемый день.
// Возвращаемое значение:
//  Диаграмма - вертикальная гистограмма с накоплением, часы загрузки ВРЦ.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ПостроитьДиаграмму(Знач ЗагрузкаПоДням, Знач НачалоПериода, Знач КонецПериода) Экспорт
	юум_ФП_Загрузка_ПроверитьПериод(НачалоПериода, КонецПериода);
	ДиаграммаЗагрузки = Новый Диаграмма;
	ДиаграммаЗагрузки.ТипДиаграммы = ТипДиаграммы.ГистограммаСНакоплением;
	ДиаграммаЗагрузки.АвтоТранспонирование = Ложь;
	СекундВСутках = 24 * 60 * 60;
	КоличествоДней = Цел((КонецДня(КонецПериода) - НачалоДня(НачалоПериода)) / СекундВСутках);
	Для СмещениеДня = 0 По КоличествоДней Цикл
		ДеньТочки = НачалоДня(НачалоПериода) + СмещениеДня * СекундВСутках;
		ТочкаПериода = ДиаграммаЗагрузки.УстановитьТочку(ДеньТочки);
		ТочкаПериода.Текст = Формат(ДеньТочки, "ДФ=dd.MM");
	КонецЦикла;
	Для Каждого СтрокаЗагрузки Из ЗагрузкаПоДням Цикл
		ТочкаЗагрузки = ДиаграммаЗагрузки.УстановитьТочку(СтрокаЗагрузки.День);
		СерияЗагрузки = ДиаграммаЗагрузки.УстановитьСерию(СтрокаЗагрузки.Подразделение);
		РасшифровкаЗначения = Новый Структура("День,Подразделение",
			СтрокаЗагрузки.День, СтрокаЗагрузки.Подразделение);
		ДиаграммаЗагрузки.УстановитьЗначение(ТочкаЗагрузки, СерияЗагрузки,
			СтрокаЗагрузки.ЗанятоЧасов, РасшифровкаЗначения);
	КонецЦикла;
	Возврат ДиаграммаЗагрузки;
КонецФункции // } #юум

// Читает остатки всех доступных активных заказов для единой очереди ВРЦ.
// Возвращаемое значение:
//  ТаблицаЗначений - заказ, ключи выхода и оставшийся объем.
// Временный метод удален после приемки: ПрочитатьОбъемыОчереди.

// Считает очередь штатным алгоритмом ERP в памяти; записи графика отсутствуют.
// Параметры:
//  Снимок - Структура - Начало, Конец, Движения, Объемы.
//  Модель - Структура, Неопределено - модель выбора формы.
//  Дерево - ДеревоЗначений, Неопределено - текущий выбор.
// Возвращаемое значение:
//  Структура - Данные, Полный, Состояние, Ошибки.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_РассчитатьТочнуюЗагрузку(Знач Снимок, Знач Модель, Знач Дерево) Экспорт
    ОбъемыОчереди = юум_ФП_Загрузка_ОбъемыТочногоВыбора(Снимок.Объемы, Модель, Дерево);
    ЗаказыОчереди = ГрафикПроизводстваСтруктурыЗаказа.юум_ФП_ПорядокЗаказов(
        ОбъемыОчереди.ВыгрузитьКолонку("ЗаказНаПроизводство"));
    КонтекстОчереди = юум_ФП_Загрузка_НовыйКонтекстОчереди();
    ЗагрузкаОчереди = Снимок.Движения.СкопироватьКолонки();
    ОшибкиОчереди = Новый Массив;
    Для Каждого ЗаказОчереди Из ЗаказыОчереди Цикл
        ОбъемыЗаказа = ОбъемыОчереди.Скопировать(Новый Структура("ЗаказНаПроизводство", ЗаказОчереди));
        Если ОбъемыЗаказа.Итог("Выбрано") = 0 Тогда
            КонтекстОчереди.Заказы.Добавить(ЗаказОчереди);
            Продолжить;
        КонецЕсли;
        РасчетЗаказа = ГрафикПроизводстваСтруктурыЗаказа.юум_ФП_РассчитатьПоОчереди(
            ЗаказОчереди, ОбъемыЗаказа, КонтекстОчереди);
        Если Не РасчетЗаказа.ГрафикЗапланирован Тогда
            юум_ФП_Загрузка_ДобавитьОшибкиОчереди(ОшибкиОчереди, ЗаказОчереди, РасчетЗаказа.Ошибки);
            Продолжить;
        КонецЕсли;
        юум_ФП_Загрузка_ДобавитьЗагрузкуРасчета(ЗагрузкаОчереди, КонтекстОчереди, РасчетЗаказа.ДанныеРасчета.ЗагрузкаВРЦ);
        КонтекстОчереди.Заказы.Добавить(ЗаказОчереди);
    КонецЦикла;
    ОбъединеннаяЗагрузка = юум_ФП_Загрузка_ОбъединитьЗагрузкуОчереди(Снимок.Движения, ЗагрузкаОчереди, КонтекстОчереди.Заказы);
    ДанныеДиаграммы = юум_ФП_Загрузка_СвернутьЗагрузкуПоДням(ОбъединеннаяЗагрузка,
        Снимок.Начало, Снимок.Конец);
    ПолныйРезультат = ОшибкиОчереди.Количество() = 0;
    СостояниеРасчета = "ВРЦ: расчет очереди заказов в памяти, без записи графика. Загрузка в часах.";
    Если ПолныйРезультат И ДанныеДиаграммы.Количество() = 0 Тогда
        СостояниеРасчета = "ВРЦ: в выбранном периоде рассчитанной загрузки нет.";
    КонецЕсли;
    Если Не ПолныйРезультат Тогда
        СостояниеРасчета = "ВРЦ не рассчитаны полностью. " + СтрСоединить(ОшибкиОчереди, Символы.ПС);
    КонецЕсли;
    Возврат Новый Структура("Данные,Полный,Состояние,Ошибки",
        ДанныеДиаграммы, ПолныйРезультат, СостояниеРасчета, ОшибкиОчереди);
КонецФункции // } #юум


// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ЕдинственныйДоговорПереработчика(Знач КандидатыДоговоров)
	// В спецификации задан партнер. Пока контрагент не уточнен документом,
	// выбор безопасен только при одном договоре по всем его контрагентам.
	// Несколько договоров: оставляем пусто по согласованному правилу заказчика.
	Если КандидатыДоговоров.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДоговорПереработчика = КандидатыДоговоров[0];
	Если Не ЗначениеЗаполнено(ДоговорПереработчика.Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДоговорПереработчика;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_СпецификацииПоУзлам(Модель)
	Результат = Новый Соответствие;
	Для Каждого Связь Из Модель.Связи Цикл
		СпецификацииУзла = Результат.Получить(Связь.ИдУзла);
		Если СпецификацииУзла = Неопределено Тогда
			СпецификацииУзла = Новый Массив;
			Результат.Вставить(Связь.ИдУзла, СпецификацииУзла);
		КонецЕсли;
		СпецификацияПлана = Модель.План[Связь.ИндексПлана].Спецификация;
		Если ЗначениеЗаполнено(СпецификацияПлана)
			И СпецификацииУзла.Найти(СпецификацияПлана) = Неопределено Тогда
			СпецификацииУзла.Добавить(СпецификацияПлана);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ДобавитьРасшифровкуРабот(ПозицияПлана, Нормативы, Результат, СтрокиРабот, ВкладыРабот)
	ОтборПартии = Новый Структура("ЗаказНаПроизводство,КлючПартия");
	ЗаполнитьЗначенияСвойств(ОтборПартии, ПозицияПлана);
	ОтборВыпуска = Новый Структура("ЗаказНаПроизводство,КлючПартия,Номенклатура,Характеристика");
	ЗаполнитьЗначенияСвойств(ОтборВыпуска, ПозицияПлана);
	Выпуски = Нормативы.Выпуски.НайтиСтроки(ОтборВыпуска);
	НормаВыпуска = ?(Выпуски.Количество() = 1, Выпуски[0].КоличествоНаПартию, 0);
	КлючВыпуска = Строка(ПозицияПлана.Номенклатура.УникальныйИдентификатор())
		+ "|" + Строка(ПозицияПлана.Характеристика.УникальныйИдентификатор());
	Для Каждого Работа Из Нормативы.Работы.НайтиСтроки(ОтборПартии) Цикл
		СтрокаРаботы = СтрокиРабот.Получить(Работа.КлючРаботы);
		Если СтрокаРаботы = Неопределено Тогда
			СтрокаРаботы = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРаботы, Работа);
			СтрокиРабот.Вставить(Работа.КлючРаботы, СтрокаРаботы);
			ВкладыРабот.Вставить(Работа.КлючРаботы, Новый Соответствие);
		КонецЕсли;
		Если НормаВыпуска <= 0 Или Работа.Кратность <= 0 Тогда
			СтрокаРаботы.Состояние = "Не рассчитано: отсутствует норма выпуска или кратность работ.";
			Продолжить;
		КонецЕсли;
		НормаЧасов = Работа.КоличествоНаПартию / НормаВыпуска * Работа.Трудоемкость / Работа.Кратность;
		СтрокаРаботы.НормаНаЕдиницу = СтрокаРаботы.НормаНаЕдиницу
			+ ?(СтрокаРаботы.НормаНаЕдиницу = "", "", "; ")
			+ Строка(ПозицияПлана.Номенклатура) + ": " + Формат(НормаЧасов, "ЧДЦ=6;ЧН=0") + " н/ч";
		СтрокаРаботы.Основание = "Собственные работы партии. Норма выпуска: "
			+ Формат(НормаВыпуска, "ЧДЦ=6;ЧН=0")
			+ ". Сопряженные выпуски учитываются по максимальному вкладу.";
		ВкладыВыпусков = ВкладыРабот.Получить(Работа.КлючРаботы);
		ПредыдущийВклад = ВкладыВыпусков.Получить(КлючВыпуска);
		Если ПредыдущийВклад = Неопределено Тогда
			ПредыдущийВклад = 0;
		КонецЕсли;
		КоличествоРабот = ПозицияПлана.Требуется / НормаВыпуска * Работа.КоличествоНаПартию;
		ВкладыВыпусков.Вставить(КлючВыпуска, ПредыдущийВклад + КоличествоРабот);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {

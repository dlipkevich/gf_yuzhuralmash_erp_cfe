Функция юум_ФП_Загрузка_ОбъемыТекущегоВыбора(Знач Модель, Знач Дерево)
	ОбъемыВыбора = Новый Соответствие;
	Для Каждого ПозицияПлана Из Модель.План Цикл
		КлючВыхода = юум_ФП_КлючПозиции(ПозицияПлана);
		ОбъемВыхода = ОбъемыВыбора.Получить(КлючВыхода);
		Если ОбъемВыхода = Неопределено Тогда
			ОбъемВыхода = Новый Структура("Требуется,Выбрано", 0, 0);
			ОбъемыВыбора.Вставить(КлючВыхода, ОбъемВыхода);
		КонецЕсли;
		ОбъемВыхода.Требуется = ОбъемВыхода.Требуется + ПозицияПлана.Требуется;
	КонецЦикла;
	СвязиВыбора = юум_ФП_ВыбранныеСвязи(Модель, Дерево);
	Для Каждого СвязьВыбора Из СвязиВыбора Цикл
		ПозицияПлана = Модель.План[СвязьВыбора.ИндексПлана];
		КлючВыхода = юум_ФП_КлючПозиции(ПозицияПлана);
		ОбъемВыхода = ОбъемыВыбора.Получить(КлючВыхода);
		ОбъемВыхода.Выбрано = ОбъемВыхода.Выбрано + СвязьВыбора.КЗапуску;
	КонецЦикла;
	Возврат ОбъемыВыбора;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ОбъемыТочногоВыбора(Знач ПолныеОбъемы, Знач Модель, Знач Дерево)
    ОбъемыВыбора = Новый Соответствие;
    Если Модель <> Неопределено Тогда
        ОбъемыВыбора = юум_ФП_Загрузка_ОбъемыТекущегоВыбора(Модель, Дерево);
    КонецЕсли;
    ОбъемыОснования = юум_ФП_Загрузка_ПолныеОбъемыСУчетомФормы(ПолныеОбъемы, Модель);
    ОбъемыОчереди = ОбъемыОснования.СкопироватьКолонки();
    ОбъемыОчереди.Колонки.Добавить("Выбрано", Новый ОписаниеТипов("Число",
        Новый КвалификаторыЧисла(18, 6)));
    Для Каждого ПолныйОбъем Из ОбъемыОснования Цикл
        Если ПолныйОбъем.Требуется <= 0 Тогда
            Продолжить;
        КонецЕсли;
        ОбъемОчереди = ОбъемыОчереди.Добавить();
        ЗаполнитьЗначенияСвойств(ОбъемОчереди, ПолныйОбъем);
        ОбъемОчереди.Выбрано = ПолныйОбъем.Требуется;
        КлючВыхода = юум_ФП_КлючПозиции(ПолныйОбъем);
        ВыборВыхода = ОбъемыВыбора.Получить(КлючВыхода);
        Если ВыборВыхода <> Неопределено Тогда
            ВнеФормы = Макс(0, ПолныйОбъем.Требуется - ВыборВыхода.Требуется);
            ОбъемОчереди.Выбрано = Мин(ПолныйОбъем.Требуется, ВнеФормы + ВыборВыхода.Выбрано);
        КонецЕсли;
    КонецЦикла;
    Возврат ОбъемыОчереди;
КонецФункции // } #юум


Процедура юум_ФП_ДобавитьНеповторяющийсяКомментарий(КомментарииПозиции, Знач ТекстПозиции)
	Если Не ПустаяСтрока(ТекстПозиции) И КомментарииПозиции.Найти(ТекстПозиции) = Неопределено Тогда
		КомментарииПозиции.Добавить(ТекстПозиции);
	КонецЕсли;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьАдресатовКомментариев(СтрокиДерева)
	Для Каждого УзелКомментария Из СтрокиДерева Цикл
		Адресаты = Новый Массив;
		юум_ФП_ДобавитьАдресатаКомментария(УзелКомментария, Адресаты);
		УзелКомментария.АдресатыКомментария = "Выбрано: " + УзелКомментария.Представление
			+ Символы.ПС + "Адресаты (текст группы дополняет личные комментарии позиций):"
			+ Символы.ПС + СтрСоединить(Адресаты, Символы.ПС);
		юум_ФП_ЗаполнитьАдресатовКомментариев(УзелКомментария.Строки);

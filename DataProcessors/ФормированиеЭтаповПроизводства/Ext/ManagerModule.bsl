// Возвращает детальные записи только одного вхождения для типовой расшифровки.
// Параметры:
//  Модель - Структура - полный план, дерево и связи вхождений.
//  ИдУзла - Строка - устойчивый идентификатор выбранной строки.
// Возвращаемое значение:
//  ТаблицаЗначений - аналитики исходного плана и количества вхождения;
//  Неопределено - у выбранной строки нет самостоятельного производственного объема.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПланУзлаДляРасшифровки(Знач Модель, Знач ИдУзла) Экспорт
	Если Не Модель.Свойство("План") Тогда
		Возврат Неопределено;
	КонецЕсли;
	УзелРасшифровки = юум_ФП_НайтиУзелКомментария(Модель.Дерево.Строки, ИдУзла);
	Если УзелРасшифровки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СвязиУзла = Модель.Связи.НайтиСтроки(Новый Структура("ИдУзла", ИдУзла));
	Если СвязиУзла.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПланРасшифровки = Модель.План.СкопироватьКолонки();
	РабочийПлан = Модель.План.Скопировать();
	РабочийПлан.ЗаполнитьЗначения(0, "КЗапуску");
	ЕстьВыбор = УзелРасшифровки.Отметка И УзелРасшифровки.КЗапуску > 0;
	Если ЕстьВыбор Тогда
		юум_ФП_РаспределитьСтрокуВПлан(УзелРасшифровки, Модель.Связи, РабочийПлан);
	КонецЕсли;
	Для Каждого СвязьУзла Из СвязиУзла Цикл
		ПозицияРасшифровки = ПланРасшифровки.Добавить();
		ЗаполнитьЗначенияСвойств(ПозицияРасшифровки, РабочийПлан[СвязьУзла.ИндексПлана]);
		ПозицияРасшифровки.Требуется = СвязьУзла.Требуется;
		ПозицияРасшифровки.Отметка = ЕстьВыбор И ПозицияРасшифровки.КЗапуску > 0;
		// Номер нужен только локальному отбору типового отчета, исходный план не меняется.
		ПозицияРасшифровки.НомерГруппы = 0;
	КонецЦикла;
	Возврат ПланРасшифровки;
КонецФункции // } #юум


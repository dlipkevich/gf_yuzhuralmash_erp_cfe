// Создает схему данных дерева запуска, общую для формы и проверок.
//
// Возвращаемое значение:
//  ДеревоЗначений - дерево производственных позиций без строк.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_НовоеДеревоЗапуска() Экспорт

	ДеревоЗапуска = Новый ДеревоЗначений;
	ТипТекста = Новый ОписаниеТипов("Строка");
	ТипФлага = Новый ОписаниеТипов("Булево");
	ТипКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));
	ТипИндекса = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0));

	Для Каждого ИмяКолонки Из СтрРазделить(
		"ИдУзла,Код,Представление,ЕдиницаИзмерения,Индикатор,СостояниеОбеспечения,"
		+ "Маршрут,ДоговорПереработчик,ВидСтроки,Комментарий,АдресатыКомментария,Пояснение,ТрудоемкостьПредставление,СуммаПоГруппеПредставление", ",") Цикл
		ДеревоЗапуска.Колонки.Добавить(ИмяКолонки, ТипТекста);
	КонецЦикла;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Требуется,КЗапуску,Обеспечено,Трудоемкость,СуммаПоГруппе,НормативНаЕдиницу,"
		+ "КоличествоВИзделии,ИсходнаяПотребность", ",") Цикл
		ДеревоЗапуска.Колонки.Добавить(ИмяКолонки, ТипКоличества);
	КонецЦикла;
	Для Каждого ИмяКолонки Из СтрРазделить(
		"Отметка,ЕстьЧастичноеОбеспечение,ОбеспечениеРассчитано,НормативРассчитан,"
		+ "ДопустимЗапуск,ЕстьПотомки,ТрудоемкостьРассчитана,СуммаРассчитана", ",") Цикл
		ДеревоЗапуска.Колонки.Добавить(ИмяКолонки, ТипФлага);
	КонецЦикла;
	ДеревоЗапуска.Колонки.Добавить("ИндексПлана", ТипИндекса);
	ДеревоЗапуска.Колонки.Добавить("НомерГруппы", ТипИндекса);
	ДеревоЗапуска.Колонки.Добавить("ЗаказНаПроизводство",
		Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство2_2"));
	ДеревоЗапуска.Колонки.Добавить("Номенклатура",
		Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДеревоЗапуска.Колонки.Добавить("Характеристика",
		Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДеревоЗапуска.Колонки.Добавить("Спецификация",
		Новый ОписаниеТипов("СправочникСсылка.РесурсныеСпецификации"));
	ДеревоЗапуска.Колонки.Добавить("СсылкаСтруктуры",
		Новый ОписаниеТипов("СправочникСсылка.юум_ДеревоЗаказаСлужебный"));

	Возврат ДеревоЗапуска;
КонецФункции // } #юум

// Детальный план получен типовой обработкой ERP. Количества служебного дерева
// используются только для распределения между вхождениями и норм подчиненности.
// Параметры:
//  ДетальныйПлан - ТаблицаЗначений - детальные строки типового плана запуска.
//
// Возвращаемое значение:
//  Структура - дерево представления, исходный план и таблица связи вхождений.
//
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПостроитьМодельЗапуска(Знач ДетальныйПлан) Экспорт
	ДеревоЗапуска = юум_ФП_НовоеДеревоЗапуска();
	Структура = юум_ФП_СтруктураЗаказов(ДетальныйПлан.ВыгрузитьКолонку("ЗаказНаПроизводство"));
	Структура.Индексы.Добавить("Ссылка");
	Структура.Индексы.Добавить("ЗаказНаПроизводство,Родитель");
	Связи = юум_ФП_НоваяТаблицаСвязей();
	УзлыПоСсылкам = Новый Соответствие;
	Для ИндексПлана = 0 По ДетальныйПлан.Количество() - 1 Цикл
		ПозицияПлана = ДетальныйПлан[ИндексПлана];
		Если ПозицияПлана.Требуется <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты = юум_ФП_КандидатыСтруктуры(ПозицияПлана, Структура);
		Если Кандидаты.Количество() = 0 Тогда
			Узел = юум_ФП_ДобавитьНесвязаннуюПозицию(ДеревоЗапуска, ПозицияПлана, ИндексПлана);
			юум_ФП_ДобавитьСвязьПлана(Связи, Узел, ПозицияПлана, ИндексПлана,
				ПозицияПлана.Требуется, юум_ФП_ОбеспечениеПлана(ПозицияПлана));
		Иначе
			юум_ФП_РаспределитьПозициюПлана(ДеревоЗапуска, ПозицияПлана, ИндексПлана,
				Кандидаты, Структура, УзлыПоСсылкам, Связи);
		КонецЕсли;
	КонецЦикла;
	юум_ФП_ЗаполнитьНедостающиеПредставления(ДеревоЗапуска, ДетальныйПлан.ВыгрузитьКолонку("Номенклатура"));
	юум_ФП_ОбновитьСостоянияДерева(ДеревоЗапуска.Строки);
	Модель = Новый Структура("Дерево,План,Связи", ДеревоЗапуска, ДетальныйПлан, Связи);
	Модель.Вставить("Структура", Структура);
	Модель.Вставить("Нормативы", юум_ФП_Нормативы_ПрочитатьНормативы(ДетальныйПлан));
	юум_ФП_Нормативы_ПересчитатьПоказатели(Модель, ДеревоЗапуска);
	Возврат Модель;
КонецФункции // } #юум

// Изменяет выбор позиции и пересчитывает доступные подчиненные позиции.
// Параметры:
//  Дерево - ДеревоЗначений - редактируемый состав запуска.
//  ИдУзла - Строка - идентификатор вхождения.
//  НовыйОбъем - Число - количество, введенное пользователем.
// Возвращаемое значение:
//  Строка - предупреждение, не запрещающее выбор.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ИзменитьКоличествоЗапуска(Дерево, Знач ИдУзла, Знач НовыйОбъем) Экспорт
	Узел = Дерево.Строки.Найти(ИдУзла, "ИдУзла", Истина);
	Если Узел = Неопределено Тогда
		ВызватьИсключение "Не найдена изменяемая строка дерева запуска";
	КонецЕсли;
	Узел.КЗапуску = ?(Узел.ДопустимЗапуск, Макс(0, Мин(Узел.Требуется, НовыйОбъем)), 0);
	Предупреждение = "";
	Если Узел.КЗапуску > 0 Тогда
		юум_ФП_ЗаполнитьПотомковКЗапуску(Узел.Строки, Узел.КЗапуску, Предупреждение);
	Иначе
		РодительУзла = юум_ФП_РодительПоИдентификатору(Дерево.Строки, ИдУзла);
		Если РодительУзла <> Неопределено И РодительУзла.КЗапуску > 0 Тогда
			Предупреждение = "Деталь исключена из запуска при выбранном агрегате. Запуск агрегата разрешен; проверьте комплектность.";
		КонецЕсли;
	КонецЕсли;
	юум_ФП_ОбновитьСостоянияДерева(Дерево.Строки);
	Возврат Предупреждение;
КонецФункции // } #юум

// Готовит выбранные количества в исходной схеме типового детального плана.
// Параметры:
//  Модель - Структура - исходные строки и связи вхождений.
//  Дерево - ДеревоЗначений - текущие отметки и количества.
// Возвращаемое значение:
//  ТаблицаЗначений - план для стандартного предварительного просмотра.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПланДляФормирования(Знач Модель, Знач Дерево) Экспорт
	ОшибкаКомплектности = юум_ФП_ОшибкаКомплектностиЗапуска(Дерево);
	Если ЗначениеЗаполнено(ОшибкаКомплектности) Тогда
		ВызватьИсключение ОшибкаКомплектности;
	КонецЕсли;
	План = Модель.План.Скопировать();
	План.ЗаполнитьЗначения(Ложь, "Отметка");
	План.ЗаполнитьЗначения(0, "КЗапуску");
	юум_ФП_РаспределитьВыборВПлан(Дерево.Строки, Модель.Связи, План);
	Для Каждого ПозицияПлана Из План Цикл
		Если ПозицияПлана.КЗапуску > ПозицияПлана.Требуется Тогда
			ВызватьИсключение "Выбранный объем превышает типовую потребность. Обновите состав запуска.";
		КонецЕсли;
		ПозицияПлана.Отметка = ПозицияПлана.КЗапуску > 0;
	КонецЦикла;
	Возврат План;
КонецФункции // } #юум

// Заполняет выделенные позиции и их поддеревья выбранным типовым вариантом.
// Параметры:
//  Дерево - ДеревоЗначений - изменяемый полный состав.
//  ИдентификаторыУзлов - Массив из Строка - идентификаторы выделенных вхождений.
//  Режим - Строка - Требуется, Обеспечено или Снять.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьВыбор(Дерево, Знач ИдентификаторыУзлов, Знач Режим) Экспорт
	Если Режим <> "Требуется" И Режим <> "Обеспечено" И Режим <> "Снять" Тогда
		ВызватьИсключение "Неизвестный вариант заполнения количества к запуску";
	КонецЕсли;
	Для Каждого ИдУзла Из ИдентификаторыУзлов Цикл
		Узел = Дерево.Строки.Найти(ИдУзла, "ИдУзла", Истина);
		Если Узел <> Неопределено Тогда
			юум_ФП_ЗаполнитьКоличествоУзла(Узел, Режим);
		КонецЕсли;
	КонецЦикла;
	юум_ФП_ОбновитьСостоянияДерева(Дерево.Строки);
КонецПроцедуры // } #юум

// Отбирает представление дерева; исходный состав и выбор не меняются.
// Параметры:
//  Дерево - ДеревоЗначений - полная модель выбора.
//  ТолькоОтмеченные - Булево - показывать выбранные позиции и родителей.
//  СтрокаПоиска - Строка - фрагмент кода или наименования; пустой снимает поиск.
// Возвращаемое значение:
//  ДеревоЗначений - новое дерево с сохраненными идентификаторами вхождений.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ДеревоДляПоиска(Знач Дерево, Знач ТолькоОтмеченные, Знач СтрокаПоиска) Экспорт
	Представление = юум_ФП_НовоеДеревоЗапуска();
	юум_ФП_СкопироватьОтображаемыеСтроки(Дерево.Строки, Представление.Строки,
		ТолькоОтмеченные, НРег(СокрЛП(СтрокаПоиска)));
	Возврат Представление;
КонецФункции // } #юум

// Предупреждает о комплектности текущего выбора без запрета запуска.
// Параметры:
//  Дерево - ДеревоЗначений - полный состав выбора.
// Возвращаемое значение:
//  Строка - пояснения по снятым деталям и обеспечению; пустая при отсутствии замечаний.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПредупреждениеВыбора(Знач Дерево) Экспорт
	Признаки = Новый Структура("СнятыДетали,НеОбеспечено,НетРасчета", Ложь, Ложь, Ложь);
	юум_ФП_СобратьПредупрежденияВыбора(Дерево.Строки, Ложь, Признаки);
	Сообщения = Новый Массив;
	Если Признаки.СнятыДетали Тогда
		Сообщения.Добавить("При выбранном агрегате сняты входящие детали. Формирование запрещено: выберите детали или снимите запуск агрегата.");
	КонецЕсли;
	Если Признаки.НеОбеспечено Тогда
		Сообщения.Добавить("Выбран объем сверх текущего обеспечения материалами. Проверьте комплектность перед запуском.");
	КонецЕсли;
	Если Признаки.НетРасчета Тогда
		Сообщения.Добавить("Для части выбранных позиций материальная обеспеченность не рассчитана.");
	КонецЕсли;
	Возврат СтрСоединить(Сообщения, Символы.ПС);
КонецФункции // } #юум

// Сохраняет текст только в модели сеанса. Комментарии потомков не заменяет.
// Параметры:
//  Дерево - ДеревоЗначений - полный состав запуска.
//  ИдУзла - Строка - устойчивый идентификатор позиции.
//  ТекстКомментария - Строка - личный текст выбранного узла.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_УстановитьКомментарий(Дерево, Знач ИдУзла, Знач ТекстКомментария) Экспорт
	УзелКомментария = юум_ФП_НайтиУзелКомментария(Дерево.Строки, ИдУзла);
	Если УзелКомментария = Неопределено Тогда
		ВызватьИсключение "Позиция комментария отсутствует. Обновите состав запуска.";
	КонецЕсли;
	УзелКомментария.Комментарий = ТекстКомментария;
КонецПроцедуры // } #юум

// Связывает комментарии исходных позиций с типовыми изделиями перед формированием.
// Параметры:
//  Изделия - ТаблицаЗначений - результат типовой подготовки и деления партий.
//  КлючиПартий - ТаблицаЗначений - исходные заказы и ключи каждой группы.
//  Параметры - Структура - параметры типового формирования.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ПодготовитьКомментарииИзделий(Изделия, Знач КлючиПартий, Знач Параметры) Экспорт
	ТаблицаКомментариев = Неопределено;
	Если Не Параметры.Свойство("юум_ФП_Комментарии", ТаблицаКомментариев) Тогда
		Возврат;
	КонецЕсли;
	ТаблицаКомментариев = юум_ФП_ТаблицаПереданныхКомментариев(ТаблицаКомментариев);
	Если Изделия.Колонки.Найти("юум_ФП_Комментарий") = Неопределено Тогда
		Изделия.Колонки.Добавить("юум_ФП_Комментарий", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Для Каждого ИзделиеКЗапуску Из Изделия Цикл
		ИсходныеПартии = КлючиПартий.Скопировать(Новый Структура("НомерГруппы", ИзделиеКЗапуску.НомерГруппы));
		ИзделиеКЗапуску.юум_ФП_Комментарий = юум_ФП_КомментарииИзделия(ИзделиеКЗапуску,
			ИсходныеПартии, ТаблицаКомментариев);
	КонецЦикла;
КонецПроцедуры // } #юум

// Дополняет данные спецификации комментарием только при наличии нашего маркера.
// Параметры:
//  ДанныеСпецификаций - Массив - типовые данные выбранных партий.
//  Изделия - ТаблицаЗначений - типовые изделия с полем юум_ФП_Комментарий.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ДополнитьКомментарииСпецификаций(ДанныеСпецификаций, Знач Изделия) Экспорт
	Если Изделия.Колонки.Найти("юум_ФП_Комментарий") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ДанныеСпецификации Из ДанныеСпецификаций Цикл
		Если ДанныеСпецификации = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОтборПартии = Новый Структура("НомерГруппы,НомерПартииВГруппе,Спецификация");
		ЗаполнитьЗначенияСвойств(ОтборПартии, ДанныеСпецификации);
		КомментарииПартии = Новый Массив;
		Для Каждого ИзделиеПартии Из Изделия.НайтиСтроки(ОтборПартии) Цикл
			юум_ФП_ДобавитьНеповторяющийсяКомментарий(КомментарииПартии, ИзделиеПартии.юум_ФП_Комментарий);
		КонецЦикла;

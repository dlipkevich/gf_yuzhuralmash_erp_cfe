// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_КандидатыСтруктуры(Знач ПозицияПлана, Знач Структура)

	Кандидаты = Новый Массив;
	ПустойКлюч = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Для Каждого УзелСтруктуры Из Структура Цикл
		Если УзелСтруктуры.ЗаказНаПроизводство <> ПозицияПлана.ЗаказНаПроизводство
			Или УзелСтруктуры.Номенклатура <> ПозицияПлана.Номенклатура
			Или УзелСтруктуры.Характеристика <> ПозицияПлана.Характеристика Тогда
			Продолжить;
		КонецЕсли;
		СовпадаетКлюч = УзелСтруктуры.КлючНоменклатура <> ПустойКлюч
			И УзелСтруктуры.КлючНоменклатура = ПозицияПлана.КлючНоменклатура;
		СовпадаетПроизводство = УзелСтруктуры.КлючиПроизводства.Найти(ПозицияПлана.КлючПартия) <> Неопределено;
		ЕдинственныйКореньЗаказа = УзелСтруктуры.ОдинКорень И ПозицияПлана.ПродукцияЗаказа;
		Если СовпадаетКлюч Или СовпадаетПроизводство Или ЕдинственныйКореньЗаказа Тогда
			Кандидаты.Добавить(УзелСтруктуры);
		КонецЕсли;
	КонецЦикла;
	Возврат Кандидаты;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_РаспределитьПозициюПлана(ДеревоЗапуска, ПозицияПлана, ИндексПлана,
	Кандидаты, Структура, УзлыПоСсылкам, Связи)
	СуммаВесов = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		СуммаВесов = СуммаВесов + юум_ФП_ВесВхождения(Кандидат);
	КонецЦикла;
	Остаток = ПозицияПлана.Требуется;
	ОстатокОбеспечения = юум_ФП_ОбеспечениеПлана(ПозицияПлана);
	Для НомерКандидата = 0 По Кандидаты.Количество() - 1 Цикл
		Кандидат = Кандидаты[НомерКандидата];
		Если НомерКандидата = Кандидаты.Количество() - 1 Тогда
			КоличествоВхождения = Остаток;
		Иначе
			КоличествоВхождения = Мин(Остаток,
				Окр(ПозицияПлана.Требуется * юум_ФП_ВесВхождения(Кандидат) / СуммаВесов, 3));
		КонецЕсли;
		ОбеспеченоВхождения = ?(НомерКандидата = Кандидаты.Количество() - 1, ОстатокОбеспечения,
			Мин(КоличествоВхождения, ОстатокОбеспечения,
				Окр(юум_ФП_ОбеспечениеПлана(ПозицияПлана) * КоличествоВхождения / ПозицияПлана.Требуется, 3)));
		Остаток = Остаток - КоличествоВхождения;
		ОстатокОбеспечения = ОстатокОбеспечения - ОбеспеченоВхождения;
		Узел = юум_ФП_ПолучитьУзелДерева(ДеревоЗапуска, Кандидат, Структура, УзлыПоСсылкам);
		юум_ФП_ДобавитьСвязьПлана(Связи, Узел, ПозицияПлана, ИндексПлана, КоличествоВхождения, ОбеспеченоВхождения);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ВесВхождения(Знач УзелСтруктуры)
	Возврат ?(УзелСтруктуры.ТребуетсяСтруктуры > 0, УзелСтруктуры.ТребуетсяСтруктуры, 1);
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПолучитьУзелДерева(ДеревоЗапуска, Знач УзелСтруктуры, Структура, УзлыПоСсылкам)
	ГотовыйУзел = УзлыПоСсылкам.Получить(УзелСтруктуры.Ссылка);
	Если ГотовыйУзел <> Неопределено Тогда
		Возврат ГотовыйУзел;
	КонецЕсли;
	Цепочка = Новый Массив;
	Посещенные = Новый Соответствие;
	ТекущийУзел = УзелСтруктуры;
	РодительДерева = Неопределено;
	Для НомерПерехода = 0 По Структура.Количество() Цикл
		Если НомерПерехода = Структура.Количество() Тогда
			ВызватьИсключение "Превышена длина цепочки родителей служебного дерева";
		КонецЕсли;
		РодительДерева = УзлыПоСсылкам.Получить(ТекущийУзел.Ссылка);
		Если РодительДерева <> Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Посещенные.Получить(ТекущийУзел.Ссылка) <> Неопределено Тогда
			ВызватьИсключение "Цикл родителей в служебном дереве заказа: " + Строка(ТекущийУзел.Ссылка);
		КонецЕсли;
		Посещенные.Вставить(ТекущийУзел.Ссылка, Истина);
		// Строка заказа уровня 0 не является изделием и не выводится как партия.
		Если ЗначениеЗаполнено(ТекущийУзел.Номенклатура) Тогда
			Цепочка.Добавить(ТекущийУзел);
		КонецЕсли;
		ТекущийУзел = Структура.Найти(ТекущийУзел.Родитель, "Ссылка");
		Если ТекущийУзел = Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Для ОбратныйИндекс = 1 По Цепочка.Количество() Цикл
		ИсточникУзла = Цепочка[Цепочка.Количество() - ОбратныйИндекс];
		КоллекцияСтрок = ?(РодительДерева = Неопределено, ДеревоЗапуска.Строки, РодительДерева.Строки);
		НовыйУзел = КоллекцияСтрок.Добавить();
		юум_ФП_ЗаполнитьУзелСтруктуры(НовыйУзел, ИсточникУзла, РодительДерева);
		УзлыПоСсылкам.Вставить(ИсточникУзла.Ссылка, НовыйУзел);
		РодительДерева = НовыйУзел;
	КонецЦикла;
	Возврат РодительДерева;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьУзелСтруктуры(Узел, ИсточникУзла, РодительДерева)
	ЗаполнитьЗначенияСвойств(Узел, ИсточникУзла, "ЗаказНаПроизводство,Номенклатура,Характеристика,Спецификация,ЕдиницаИзмерения");
	Узел.ИдУзла = Строка(ИсточникУзла.Ссылка.УникальныйИдентификатор());
	Узел.СсылкаСтруктуры = ИсточникУзла.Ссылка;
	Узел.Код = ИсточникУзла.КодНоменклатуры;
	Узел.Представление = ИсточникУзла.ПредставлениеНоменклатуры;
	Узел.ВидСтроки = ?(РодительДерева = Неопределено, "Изделие", "Деталь");
	Узел.КоличествоВИзделии = ИсточникУзла.ТребуетсяСтруктуры;
	Если РодительДерева <> Неопределено Тогда
		РодительДерева.ЕстьПотомки = Истина;
		Если РодительДерева.ВидСтроки <> "Изделие" Тогда
			РодительДерева.ВидСтроки = "Агрегат";
		КонецЕсли;
		Если РодительДерева.КоличествоВИзделии > 0 Тогда
			Узел.НормативНаЕдиницу = Узел.КоличествоВИзделии / РодительДерева.КоличествоВИзделии;
			Узел.НормативРассчитан = Истина;
		КонецЕсли;
	КонецЕсли;
	Узел.Пояснение = Строка(ИсточникУзла.ЗаказНаПроизводство);
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ДобавитьНесвязаннуюПозицию(ДеревоЗапуска, ПозицияПлана, ИндексПлана)
	Узел = ДеревоЗапуска.Строки.Добавить();
	ЗаполнитьЗначенияСвойств(Узел, ПозицияПлана, "ЗаказНаПроизводство,Номенклатура,Характеристика,Спецификация");
	Узел.ИдУзла = "План-" + Строка(ИндексПлана);
	Узел.Представление = Строка(ПозицияПлана.Номенклатура);
	Узел.ВидСтроки = "Вне дерева";
	Узел.Пояснение = "Нет связи со служебным деревом. " + Строка(ПозицияПлана.ЗаказНаПроизводство);
	Возврат Узел;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ДобавитьСвязьПлана(Связи, Узел, ПозицияПлана, ИндексПлана, КоличествоВхождения, ОбеспеченоВхождения)
	Если КоличествоВхождения <= 0 Тогда
		Возврат;
	КонецЕсли;
	Связь = Связи.Добавить();
	Связь.ИдУзла = Узел.ИдУзла;
	Связь.ИндексПлана = ИндексПлана;
	Связь.Требуется = КоличествоВхождения;
	Связь.Обеспечено = Мин(КоличествоВхождения, ОбеспеченоВхождения);
	Узел.Требуется = Узел.Требуется + Связь.Требуется;
	Узел.Обеспечено = Узел.Обеспечено + Связь.Обеспечено;
	Узел.ИсходнаяПотребность = Узел.Требуется;
	Узел.ОбеспечениеРассчитано = Истина;
	Узел.ЕстьЧастичноеОбеспечение = Узел.ЕстьЧастичноеОбеспечение Или ПозицияПлана.ЕстьЧастичноеОбеспечение;
	Узел.ДопустимЗапуск = Истина;
	Узел.НомерГруппы = ПозицияПлана.НомерГруппы;
	Узел.Спецификация = ПозицияПлана.Спецификация;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ОбновитьСостоянияДерева(СтрокиДерева) 
	Для Каждого Узел Из СтрокиДерева Цикл
		Узел.СостояниеОбеспечения = юум_ФП_СостояниеОбеспеченияПозиции(Узел);
		Узел.Индикатор = ?(Узел.ОбеспечениеРассчитано, "⬤", "?");
		Узел.Отметка = Узел.КЗапуску > 0;
		юум_ФП_ОбновитьСостоянияДерева(Узел.Строки);
		Узел.СуммаПоГруппе = Узел.Трудоемкость;
		Для Каждого ДочернийУзел Из Узел.Строки Цикл
			Узел.СуммаПоГруппе = Узел.СуммаПоГруппе + ДочернийУзел.СуммаПоГруппе;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ОбеспечениеПлана(Знач ПозицияПлана)
	Возврат Макс(0, Мин(ПозицияПлана.Требуется,
		?(ПозицияПлана.ТребуетсяОбеспечение, ПозицияПлана.Обеспечено, ПозицияПлана.Требуется)));
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьПотомковКЗапуску(СтрокиДерева, Знач ОбъемРодителя, Предупреждение)
	Для Каждого Узел Из СтрокиДерева Цикл
		Если Не Узел.НормативРассчитан Тогда
			Предупреждение = "Для части позиций не определена норма вхождения. Укажите их количество вручную.";
			Продолжить;
		КонецЕсли;
		РасчетныйОбъем = Окр(ОбъемРодителя * Узел.НормативНаЕдиницу, 3);
		Узел.КЗапуску = ?(Узел.ДопустимЗапуск, Мин(Узел.Требуется, РасчетныйОбъем), 0);
		// Норматив потомков рассчитывается до ограничения остатком промежуточного узла.
		юум_ФП_ЗаполнитьПотомковКЗапуску(Узел.Строки, РасчетныйОбъем, Предупреждение);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {

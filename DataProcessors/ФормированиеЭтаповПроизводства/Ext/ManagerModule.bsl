КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ДобавитьСоставПозиции(Источник, Структура, Состав, Знач КоличествоОснования,
	Знач УровеньСостава, Посещенные)
	Если Посещенные.Получить(Источник.Ссылка) <> Неопределено Тогда
		ВызватьИсключение "В сохраненном составе обнаружено циклическое подчинение.";
	КонецЕсли;
	Посещенные.Вставить(Источник.Ссылка, Истина);
	НоваяСтрока = Состав.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Источник,
		"Номенклатура,Характеристика,Спецификация,ЕдиницаИзмерения,ЗаказНаПроизводство");
	НоваяСтрока.СсылкаСтруктуры = Источник.Ссылка;
	НоваяСтрока.Код = Источник.КодНоменклатуры;
	НоваяСтрока.Представление = Источник.ПредставлениеНоменклатуры;
	НоваяСтрока.Уровень = УровеньСостава;
	НоваяСтрока.ПоСтруктуре = Источник.ТребуетсяСтруктуры;
	НоваяСтрока.КоличествоОснования = КоличествоОснования;
	НоваяСтрока.НормаРассчитана = КоличествоОснования > 0;
	Если НоваяСтрока.НормаРассчитана Тогда
		НоваяСтрока.КоличествоВИзделии = Источник.ТребуетсяСтруктуры / КоличествоОснования;
		НоваяСтрока.ПредставлениеНормы = Формат(НоваяСтрока.КоличествоВИзделии, "ЧДЦ=6;ЧН=0");
		НоваяСтрока.Основание = "Сохраненный состав заказа; исходное количество выбранного узла: "
			+ Формат(КоличествоОснования, "ЧДЦ=3;ЧН=0")
			+ ". Для нелинейной нормы это основание исходного объема, а не пересчет новой партии.";
	Иначе
		НоваяСтрока.ПредставлениеНормы = "Не рассчитано";
		НоваяСтрока.Основание = "В сохраненном дереве отсутствует положительное количество выбранного узла.";
	КонецЕсли;
	ОтборПотомков = Новый Структура("ЗаказНаПроизводство,Родитель",
		Источник.ЗаказНаПроизводство, Источник.Ссылка);
	Для Каждого Потомок Из Структура.НайтиСтроки(ОтборПотомков) Цикл
		юум_ФП_ДобавитьСоставПозиции(Потомок, Структура, Состав,
			КоличествоОснования, УровеньСостава + 1, Посещенные);
	КонецЦикла;
КонецПроцедуры // } #юум


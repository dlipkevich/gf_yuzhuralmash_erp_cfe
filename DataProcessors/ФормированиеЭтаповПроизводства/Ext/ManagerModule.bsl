// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ТаблицаПереданныхКомментариев(Знач ДанныеКомментариев)
	Если ТипЗнч(ДанныеКомментариев) = Тип("ТаблицаЗначений") Тогда
		// Совместимость с серверными потребителями исходного интерфейса.
		Возврат ДанныеКомментариев;
	КонецЕсли;
	Если ТипЗнч(ДанныеКомментариев) <> Тип("Массив") Тогда
		ВызватьИсключение "Неверный формат переданных комментариев запуска.";
	КонецЕсли;
	Результат = Новый ТаблицаЗначений;
	Для Каждого ИмяПоля Из СтрРазделить(юум_ФП_ПоляПередачиКомментариев(), ",") Цикл
		Результат.Колонки.Добавить(ИмяПоля);
	КонецЦикла;
	Для Каждого ПередаваемыйКомментарий Из ДанныеКомментариев Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), ПередаваемыйКомментарий);
	КонецЦикла;
	Возврат Результат;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ОшибкаКомплектностиПоддерева(СтрокиДерева, Знач ВыбранаСборка)
    Для Каждого УзелКомплектности Из СтрокиДерева Цикл
        ДопустимЗапускУзла = УзелКомплектности.ДопустимЗапуск И УзелКомплектности.Требуется > 0;
        ВыбранУзел = ДопустимЗапускУзла И УзелКомплектности.Отметка И УзелКомплектности.КЗапуску > 0;
        Если ВыбранаСборка И ДопустимЗапускУзла И Не ВыбранУзел Тогда
            Возврат "Выбран агрегат без запуска детали «" + УзелКомплектности.Представление
                + "». Выберите входящие детали или снимите запуск агрегата.";
        КонецЕсли;
        ВыбранаРодительскаяСборка = ВыбранаСборка Или (ВыбранУзел И УзелКомплектности.ЕстьПотомки);
        ОшибкаПотомков = юум_ФП_ОшибкаКомплектностиПоддерева(УзелКомплектности.Строки, ВыбранаРодительскаяСборка);
        Если ЗначениеЗаполнено(ОшибкаПотомков) Тогда
            Возврат ОшибкаПотомков;
        КонецЕсли;
    КонецЦикла;
    Возврат "";
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьНедостающиеПредставления(Дерево, Знач НоменклатураПлана)
    Если НоменклатураПлана.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    ЗапросПредставлений = Новый Запрос;
    ЗапросПредставлений.Текст =
        "ВЫБРАТЬ РАЗРЕШЕННЫЕ
        | ПозицииНоменклатуры.Ссылка КАК Номенклатура,
        | ПозицииНоменклатуры.Код КАК Код,
        | ПРЕДСТАВЛЕНИЕ(ПозицииНоменклатуры.ЕдиницаИзмерения) КАК ЕдиницаИзмерения
        |ИЗ Справочник.Номенклатура КАК ПозицииНоменклатуры
        |ГДЕ ПозицииНоменклатуры.Ссылка В (&НоменклатураПлана)";
    ЗапросПредставлений.УстановитьПараметр("НоменклатураПлана", НоменклатураПлана);
    Представления = Новый Соответствие;
    Для Каждого СтрокаПредставления Из ЗапросПредставлений.Выполнить().Выгрузить() Цикл
        Представления.Вставить(СтрокаПредставления.Номенклатура, СтрокаПредставления);
    КонецЦикла;
    юум_ФП_ЗаполнитьПредставленияСтрок(Дерево.Строки, Представления);
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьПредставленияСтрок(СтрокиДерева, Представления)
    Для Каждого УзелПредставления Из СтрокиДерева Цикл
        ДанныеПредставления = Представления.Получить(УзелПредставления.Номенклатура);
        Если ДанныеПредставления <> Неопределено Тогда
            Если Не ЗначениеЗаполнено(УзелПредставления.Код) Тогда
                УзелПредставления.Код = ДанныеПредставления.Код;
            КонецЕсли;
            Если Не ЗначениеЗаполнено(УзелПредставления.ЕдиницаИзмерения) Тогда
                УзелПредставления.ЕдиницаИзмерения = ДанныеПредставления.ЕдиницаИзмерения;
            КонецЕсли;
        КонецЕсли;
        юум_ФП_ЗаполнитьПредставленияСтрок(УзелПредставления.Строки, Представления);
    КонецЦикла;
КонецПроцедуры // } #юум

// Читает нормативы рассчитанной динамической структуры, не изменяя регистры.
// Параметры:
//  План - ТаблицаЗначений - типовые детальные записи запуска.
// Возвращаемое значение:
//  Структура - работы, нормы выпуска и этапы спецификаций.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПрочитатьНормативы(Знач План) 
	Заказы = План.ВыгрузитьКолонку("ЗаказНаПроизводство");
	Данные = Новый Структура;
	Данные.Вставить("Работы", юум_ФП_Нормативы_ПрочитатьРаботы(Заказы));
	Данные.Вставить("Выпуски", юум_ФП_Нормативы_ПрочитатьВыпуски(Заказы));
	Данные.Вставить("Маршруты", юум_ФП_Нормативы_ПрочитатьМаршруты(План.ВыгрузитьКолонку("Спецификация")));
	Возврат Данные;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПрочитатьРаботы(Знач Заказы)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Работы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		| Работы.КлючПартия КАК КлючПартия,
		| Работы.КлючВидРабот КАК КлючВидРабот,
		| Работы.КлючНабор КАК КлючНабор,
		| Работы.Разделитель КАК Разделитель,
		| Работы.ВидРабот КАК ВидРабот,
		| Работы.Этап КАК Этап,
		| Работы.Подразделение КАК Подразделение,
		| Работы.Спецификация КАК Спецификация,
		| Работы.КоличествоНаЕдиницуПартииЗапуска КАК КоличествоНаПартию,
		| НормыРабот.Трудоемкость КАК Трудоемкость,
		| НормыРабот.КратностьТрудоемкости КАК Кратность
		|ИЗ РегистрСведений.ТрудозатратыСтруктурыЗаказа КАК Работы
		| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРаботСотрудников КАК НормыРабот
		| ПО Работы.ВидРабот = НормыРабот.Ссылка
		|ГДЕ Работы.ЗаказНаПроизводство В (&Заказы)
		| И НЕ Работы.ДополнительнаяЗапись
		| И Работы.Этап ССЫЛКА Справочник.ЭтапыПроизводства";
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Работы = Запрос.Выполнить().Выгрузить();
	Работы.Колонки.Добавить("КлючРаботы", Новый ОписаниеТипов("Строка"));
	Для Каждого Работа Из Работы Цикл
		Работа.КлючРаботы = Строка(Работа.ЗаказНаПроизводство.УникальныйИдентификатор())
			+ "|" + Строка(Работа.КлючПартия) + "|" + Строка(Работа.КлючВидРабот)
			+ "|" + Строка(Работа.КлючНабор) + "|" + Строка(Работа.Разделитель)
			+ "|" + Строка(Работа.ВидРабот.УникальныйИдентификатор());
	КонецЦикла;
	Работы.Индексы.Добавить("ЗаказНаПроизводство,КлючПартия");
	Возврат Работы;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПрочитатьВыпуски(Знач Заказы)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Выпуски.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		| Выпуски.КлючПартия КАК КлючПартия,
		| Выпуски.Номенклатура КАК Номенклатура,
		| Выпуски.Характеристика КАК Характеристика,
		| МАКСИМУМ(Выпуски.КоличествоНаЕдиницуПартииЗапуска) КАК КоличествоНаПартию
		|ИЗ РегистрСведений.СтруктураЗаказа КАК Выпуски
		|ГДЕ Выпуски.ЗаказНаПроизводство В (&Заказы)
		| И Выпуски.ВидСтроки В (&ВидыПроизводства)
		|СГРУППИРОВАТЬ ПО
		| Выпуски.ЗаказНаПроизводство, Выпуски.КлючПартия,
		| Выпуски.Номенклатура, Выпуски.Характеристика";
	ВидыПроизводства = Новый Массив;
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции);
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката);
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка);
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.УстановитьПараметр("ВидыПроизводства", ВидыПроизводства);
	Выпуски = Запрос.Выполнить().Выгрузить();
	Выпуски.Индексы.Добавить("ЗаказНаПроизводство,КлючПартия,Номенклатура,Характеристика");
	Возврат Выпуски;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПрочитатьМаршруты(Знач Спецификации)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Этапы.Владелец КАК Спецификация,
		| Этапы.Ссылка КАК Этап,
		| Этапы.НомерЭтапа КАК НомерЭтапа,
		| Этапы.НомерСледующегоЭтапа КАК НомерСледующегоЭтапа,
		| Этапы.Подразделение КАК Подразделение,
		| Цехи.Код КАК КодПодразделения,
		| Этапы.ПроизводствоНаСтороне КАК ПроизводствоНаСтороне,
		| Этапы.Партнер КАК Переработчик,
		| ПРЕДСТАВЛЕНИЕ(Этапы.Партнер) КАК ПредставлениеПереработчика
		|ИЗ Справочник.ЭтапыПроизводства КАК Этапы
		| ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтруктураПредприятия КАК Цехи
		| ПО Этапы.Подразделение = Цехи.Ссылка
		|ГДЕ Этапы.Владелец В (&Спецификации) И НЕ Этапы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО Этапы.Владелец, Этапы.НомерЭтапа";
	Запрос.УстановитьПараметр("Спецификации", Спецификации);
	Маршруты = Запрос.Выполнить().Выгрузить();
	юум_ФП_Нормативы_ДополнитьДоговорыМаршрутов(Маршруты);
	Маршруты.Индексы.Добавить("Спецификация");
	Возврат Маршруты;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ЗаполнитьМаршрутыСтрок(СтрокиДерева, Маршруты, СпецификацииУзлов)
	Для Каждого Узел Из СтрокиДерева Цикл
		МаршрутыСпецификаций = Новый Массив;
		Переработчики = Новый Массив;
		СпецификацииУзла = СпецификацииУзлов.Получить(Узел.ИдУзла);
		Если СпецификацииУзла = Неопределено Тогда
			СпецификацииУзла = Новый Массив;
			СпецификацииУзла.Добавить(Узел.Спецификация);
		КонецЕсли;
		Для Каждого СпецификацияУзла Из СпецификацииУзла Цикл
			Коды = Новый Массив;
			СтрокиМаршрута = юум_ФП_Нормативы_УпорядоченныйМаршрут(
				Маршруты.НайтиСтроки(Новый Структура("Спецификация", СпецификацияУзла)));
			Для Каждого Этап Из СтрокиМаршрута Цикл
				Коды.Добавить(СокрЛП(Этап.КодПодразделения));
				юум_ФП_Нормативы_ДобавитьПредставлениеПереработчика(Этап, Переработчики);
			КонецЦикла;
			ПредставлениеМаршрута = СтрСоединить(Коды, " - ");
			Если ПредставлениеМаршрута <> ""
				И МаршрутыСпецификаций.Найти(ПредставлениеМаршрута) = Неопределено Тогда
				МаршрутыСпецификаций.Добавить(ПредставлениеМаршрута);
			КонецЕсли;
		КонецЦикла;
		Узел.Маршрут = СтрСоединить(МаршрутыСпецификаций, "; ");
		Узел.ДоговорПереработчик = СтрСоединить(Переработчики, ", ");
		юум_ФП_Нормативы_ЗаполнитьМаршрутыСтрок(Узел.Строки, Маршруты, СпецификацииУзлов);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_УпорядоченныйМаршрут(Знач Этапы)
	Результат = Новый Массив;
	Посещенные = Новый Соответствие;
	Пока Результат.Количество() < Этапы.Количество() Цикл
		КоличествоДоПрохода = Результат.Количество();
		Для Каждого Этап Из Этапы Цикл
			Если Посещенные.Получить(Этап.НомерЭтапа) = Неопределено
				И юум_ФП_Нормативы_ВсеПредыдущиеЭтапыВыведены(Этап, Этапы, Посещенные) Тогда
				Результат.Добавить(Этап);
				Посещенные.Вставить(Этап.НомерЭтапа, Истина);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = Этапы.Количество() Тогда
			Возврат Результат;
		КонецЕсли;
		Если Результат.Количество() = КоличествоДоПрохода Тогда
			ВызватьИсключение "В маршруте спецификации обнаружен цикл этапов.";
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ВсеПредыдущиеЭтапыВыведены(Знач Этап, Этапы, Посещенные)
	Для Каждого ПредыдущийЭтап Из Этапы Цикл
		Если ПредыдущийЭтап.НомерСледующегоЭтапа = Этап.НомерЭтапа
			И Посещенные.Получить(ПредыдущийЭтап.НомерЭтапа) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПересчитатьЧасыУзла(Узел, Модель, Выбор)
	РаботыУзла = Новый Соответствие;
	Узел.ТрудоемкостьРассчитана = Истина;
	Для Каждого Связь Из Выбор.НайтиСтроки(Новый Структура("ИдУзла", Узел.ИдУзла)) Цикл
		юум_ФП_Нормативы_ДобавитьРаботыВыбора(Модель.План[Связь.ИндексПлана], Связь.Требуется,
			Модель.Нормативы, РаботыУзла, Узел.ТрудоемкостьРассчитана);
	КонецЦикла;
	Узел.Трудоемкость = юум_ФП_Нормативы_СуммаРабот(РаботыУзла);
	Узел.ТрудоемкостьПредставление = юум_ФП_Нормативы_ПредставлениеЧасов(
		Узел.Трудоемкость, Узел.ТрудоемкостьРассчитана);
	Узел.СуммаРассчитана = Узел.ТрудоемкостьРассчитана;
	Для Каждого ДочернийУзел Из Узел.Строки Цикл
		РаботыПотомка = юум_ФП_Нормативы_ПересчитатьЧасыУзла(ДочернийУзел, Модель, Выбор);
		юум_ФП_Нормативы_ОбъединитьРаботы(РаботыУзла, РаботыПотомка);
		Узел.СуммаРассчитана = Узел.СуммаРассчитана И ДочернийУзел.СуммаРассчитана;
	КонецЦикла;
	Узел.СуммаПоГруппе = юум_ФП_Нормативы_СуммаРабот(РаботыУзла);
	Узел.СуммаПоГруппеПредставление = юум_ФП_Нормативы_ПредставлениеЧасов(
		Узел.СуммаПоГруппе, Узел.СуммаРассчитана);
	Возврат РаботыУзла;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ДобавитьРаботыВыбора(ПозицияПлана, Знач Объем, Нормативы, РаботыУзла, Рассчитано)
	ОтборПартии = Новый Структура("ЗаказНаПроизводство,КлючПартия");
	ЗаполнитьЗначенияСвойств(ОтборПартии, ПозицияПлана);
	РаботыПартии = Нормативы.Работы.НайтиСтроки(ОтборПартии);
	Если РаботыПартии.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОтборВыпуска = Новый Структура("ЗаказНаПроизводство,КлючПартия,Номенклатура,Характеристика");
	ЗаполнитьЗначенияСвойств(ОтборВыпуска, ПозицияПлана);
	Выпуски = Нормативы.Выпуски.НайтиСтроки(ОтборВыпуска);
	Если Выпуски.Количество() <> 1 Тогда
		Рассчитано = Ложь;
		Возврат;
	КонецЕсли;
	НормаВыпуска = Выпуски[0].КоличествоНаПартию;
	Если НормаВыпуска <= 0 Тогда
		Рассчитано = Ложь;
		Возврат;
	КонецЕсли;
	КлючВыпуска = Строка(ПозицияПлана.Номенклатура.УникальныйИдентификатор())
		+ "|" + Строка(ПозицияПлана.Характеристика.УникальныйИдентификатор());
	Для Каждого Работа Из РаботыПартии Цикл
		Если Работа.Кратность <= 0 Тогда
			Рассчитано = Ложь;
			Продолжить;
		КонецЕсли;
		ЧасыРаботы = Объем / НормаВыпуска * Работа.КоличествоНаПартию
			* Работа.Трудоемкость / Работа.Кратность;
		юум_ФП_Нормативы_ДобавитьЧасыРаботы(РаботыУзла, Работа.КлючРаботы, КлючВыпуска, ЧасыРаботы);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПредставлениеЧасов(Знач Часы, Знач Рассчитано)
	Возврат ?(Рассчитано, Формат(Часы, "ЧДЦ=3"), "Не рассчитано");
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ДобавитьЧасыРаботы(Работы, Знач КлючРаботы, Знач КлючВыпуска, Знач Часы)
	ВыпускиРаботы = Работы.Получить(КлючРаботы);
	Если ВыпускиРаботы = Неопределено Тогда
		ВыпускиРаботы = Новый Соответствие;
		Работы.Вставить(КлючРаботы, ВыпускиРаботы);
	КонецЕсли;
	ПредыдущиеЧасы = ВыпускиРаботы.Получить(КлючВыпуска);
	ВыпускиРаботы.Вставить(КлючВыпуска, Часы + ?(ПредыдущиеЧасы = Неопределено, 0, ПредыдущиеЧасы));
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ОбъединитьРаботы(Работы, ДобавляемыеРаботы)
	Для Каждого Работа Из ДобавляемыеРаботы Цикл
		Для Каждого ВыпускРаботы Из Работа.Значение Цикл
			юум_ФП_Нормативы_ДобавитьЧасыРаботы(Работы, Работа.Ключ, ВыпускРаботы.Ключ, ВыпускРаботы.Значение);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_СуммаРабот(Знач Работы)
	Итог = 0;
	Для Каждого Работа Из Работы Цикл
		// Несколько выходов одной партии используют один и тот же физический труд.
		// Доли одного выхода складываются; между сопряженными выходами берется максимум.
		ЧасыРаботы = 0;
		Для Каждого ВыпускРаботы Из Работа.Значение Цикл
			ЧасыРаботы = Макс(ЧасыРаботы, ВыпускРаботы.Значение);
		КонецЦикла;
		Итог = Итог + ЧасыРаботы;
	КонецЦикла;
	Возврат Итог;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Нормативы_ДополнитьДоговорыМаршрутов(Маршруты)
	Маршруты.Колонки.Добавить("Договор");
	Маршруты.Колонки.Добавить("Контрагент");
	Маршруты.Колонки.Добавить("ПредставлениеДоговора", Новый ОписаниеТипов("Строка"));
	Маршруты.Колонки.Добавить("СостояниеДоговора", Новый ОписаниеТипов("Строка"));
	Переработчики = Новый Массив;
	Для Каждого Этап Из Маршруты Цикл
		Если Этап.ПроизводствоНаСтороне И ЗначениеЗаполнено(Этап.Переработчик)
			И Переработчики.Найти(Этап.Переработчик) = Неопределено Тогда
			Переработчики.Добавить(Этап.Переработчик);
		КонецЕсли;
	КонецЦикла;
	Если Переработчики.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ДоговорыПереработчиков = юум_ФП_Нормативы_ПрочитатьДоговорыПереработчиков(Переработчики);
	Для Каждого Этап Из Маршруты Цикл
		Если Не Этап.ПроизводствоНаСтороне Или Не ЗначениеЗаполнено(Этап.Переработчик) Тогда
			Продолжить;
		КонецЕсли;
		ОтборПереработчика = Новый Структура("Переработчик", Этап.Переработчик);
		КандидатыДоговоров = ДоговорыПереработчиков.НайтиСтроки(ОтборПереработчика);
		ЕдинственныйДоговор = юум_ФП_Нормативы_ЕдинственныйДоговорПереработчика(КандидатыДоговоров);
		Если ЕдинственныйДоговор <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Этап, ЕдинственныйДоговор,
				"Договор,Контрагент,ПредставлениеДоговора");
			Этап.СостояниеДоговора = "Единственный договор на переработку";
		ИначеЕсли КандидатыДоговоров.Количество() = 0 Тогда
			Этап.СостояниеДоговора = "Договор на переработку не найден";
		Иначе
			Этап.СостояниеДоговора = "Несколько договоров или неоднозначный контрагент: договор не выбран";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_НормативыЗапускаСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Нормативы_ПрочитатьДоговорыПереработчиков(Знач Переработчики)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		| Договоры.Партнер КАК Переработчик,
		| Договоры.Контрагент КАК Контрагент,
		| Договоры.Ссылка КАК Договор,
		| ПРЕДСТАВЛЕНИЕ(Договоры.Ссылка) КАК ПредставлениеДоговора
		|ИЗ Справочник.ДоговорыКонтрагентов КАК Договоры
		|ГДЕ Договоры.Партнер В (&Переработчики)
		| И НЕ Договоры.ПометкаУдаления
		| И Договоры.ТипДоговора В (
		|  ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком),
		|  ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком2_5),
		|  ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком2_5_ЕАЭС))
		|УПОРЯДОЧИТЬ ПО Договоры.Партнер, Договоры.Контрагент, Договоры.Ссылка";
	Запрос.УстановитьПараметр("Переработчики", Переработчики);
	ДоговорыПереработчиков = Запрос.Выполнить().Выгрузить();
	ДоговорыПереработчиков.Индексы.Добавить("Переработчик");
	Возврат ДоговорыПереработчиков;
КонецФункции // } #юум


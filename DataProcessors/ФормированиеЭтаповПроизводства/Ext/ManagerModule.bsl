КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_РаспределитьСтрокуВПлан(Узел, Связи, План)
	СвязиУзла = Связи.Скопировать(Новый Структура("ИдУзла", Узел.ИдУзла));
	СвязиУзла.Колонки.Добавить("КЗапуску", Новый ОписаниеТипов("Число"));
	Остаток = Узел.КЗапуску;
	Для НомерПрохода = 1 По 2 Цикл
		Для Каждого Связь Из СвязиУзла Цикл
			Лимит = ?(НомерПрохода = 1, Связь.Обеспечено, Связь.Требуется);
			КоличествоПоСвязи = Макс(0, Мин(Остаток, Лимит - Связь.КЗапуску));
			Связь.КЗапуску = Связь.КЗапуску + КоличествоПоСвязи;
			Остаток = Остаток - КоличествоПоСвязи;
			ПозицияПлана = План[Связь.ИндексПлана];
			ПозицияПлана.КЗапуску = ПозицияПлана.КЗапуску + КоличествоПоСвязи;
		КонецЦикла;
	КонецЦикла;
	Если Остаток > 0 Тогда
		ВызватьИсключение "Объем строки не связан с типовым планом. Обновите состав запуска.";
	КонецЕсли;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ПодготовитьКлючиПроизводства(Структура, Знач Заказы)
	Структура.Индексы.Добавить("Родитель");
	Структура.Индексы.Добавить("ЗаказНаПроизводство,Номенклатура,Характеристика,Уровень");
	Структура.Колонки.Добавить("КлючиПроизводства");
	Структура.Колонки.Добавить("ОдинКорень", Новый ОписаниеТипов("Булево"));
	КлючиПроизводства = юум_ФП_ПроизводственныеКлючиЗаказов(Заказы);
	КлючиПроизводства.Индексы.Добавить("ЗаказНаПроизводство,Номенклатура,Характеристика,КлючНоменклатура");
	Для Каждого УзелСтруктуры Из Структура Цикл
		УзелСтруктуры.КлючиПроизводства = юум_ФП_КлючиСобственныхПартий(УзелСтруктуры, Структура, КлючиПроизводства);
		Если УзелСтруктуры.Уровень = 1 Тогда
			ОтборКорней = Новый Структура("ЗаказНаПроизводство,Номенклатура,Характеристика,Уровень");
			ЗаполнитьЗначенияСвойств(ОтборКорней, УзелСтруктуры);
			УзелСтруктуры.ОдинКорень = Структура.НайтиСтроки(ОтборКорней).Количество() = 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_КлючиСобственныхПартий(Знач УзелСтруктуры, Структура, КлючиПроизводства)
	КлючиУзла = Новый Массив;
	ПустойКлюч = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	// Дочерняя строка содержит ключ партии, потребляющей ее номенклатуру.
	Для Каждого ДочерняяСтрока Из Структура.НайтиСтроки(Новый Структура("Родитель", УзелСтруктуры.Ссылка)) Цикл
		Если ДочерняяСтрока.КлючПартия <> ПустойКлюч
			И КлючиУзла.Найти(ДочерняяСтрока.КлючПартия) = Неопределено Тогда
			КлючиУзла.Добавить(ДочерняяСтрока.КлючПартия);
		КонецЕсли;
	КонецЦикла;
	Если УзелСтруктуры.КлючНоменклатура = ПустойКлюч Тогда
		Возврат КлючиУзла;
	КонецЕсли;
	ОтборПроизводства = Новый Структура("ЗаказНаПроизводство,Номенклатура,Характеристика,КлючНоменклатура");
	ЗаполнитьЗначенияСвойств(ОтборПроизводства, УзелСтруктуры);
	Для Каждого ПроизводственныйКлюч Из КлючиПроизводства.НайтиСтроки(ОтборПроизводства) Цикл
		Если КлючиУзла.Найти(ПроизводственныйКлюч.КлючПартия) = Неопределено Тогда
			КлючиУзла.Добавить(ПроизводственныйКлюч.КлючПартия);
		КонецЕсли;
	КонецЦикла;
	Возврат КлючиУзла;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ПроизводственныеКлючиЗаказов(Знач Заказы)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПроизводственныеПозиции.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	ПроизводственныеПозиции.Номенклатура КАК Номенклатура,
		|	ПроизводственныеПозиции.Характеристика КАК Характеристика,
		|	ПроизводственныеПозиции.КлючНоменклатура КАК КлючНоменклатура,
		|	ПроизводственныеПозиции.КлючПартия КАК КлючПартия
		|ИЗ РегистрСведений.СтруктураЗаказа КАК ПроизводственныеПозиции
		|ГДЕ ПроизводственныеПозиции.ЗаказНаПроизводство В (&Заказы)
		|	И ПроизводственныеПозиции.ВидСтроки В (&ВидыПроизводства)
		|СГРУППИРОВАТЬ ПО
		|	ПроизводственныеПозиции.ЗаказНаПроизводство,
		|	ПроизводственныеПозиции.Номенклатура,
		|	ПроизводственныеПозиции.Характеристика,
		|	ПроизводственныеПозиции.КлючНоменклатура,
		|	ПроизводственныеПозиции.КлючПартия";
	ВидыПроизводства = Новый Массив;
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции);
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката);
	ВидыПроизводства.Добавить(Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.Разборка);
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.УстановитьПараметр("ВидыПроизводства", ВидыПроизводства);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции // } #юум

// Возвращает распределение выбора по исходным детальным строкам.
// Использует тот же порядок: сначала обеспеченное количество, затем остаток.
// Параметры:
//  Модель - Структура - исходный план и связи вхождений.
//  Дерево - ДеревоЗначений - текущий выбор.
// Возвращаемое значение:
//  ТаблицаЗначений - связи с положительным количеством КЗапуску.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_ВыбранныеСвязи(Знач Модель, Знач Дерево) 
	Распределение = Модель.Связи.СкопироватьКолонки();
	Распределение.Колонки.Добавить("КЗапуску", Новый ОписаниеТипов("Число"));
	РабочийПлан = Модель.План.Скопировать();
	РабочийПлан.ЗаполнитьЗначения(0, "КЗапуску");
	юум_ФП_ДобавитьВыбранныеСвязи(Дерево.Строки, Модель.Связи, РабочийПлан, Распределение);
	Возврат Распределение;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ДобавитьВыбранныеСвязи(СтрокиДерева, Связи, РабочийПлан, Распределение)
	Для Каждого Узел Из СтрокиДерева Цикл
		Если Узел.Отметка И Узел.КЗапуску > 0 Тогда
			юум_ФП_РаспределитьСтрокуВПлан(Узел, Связи, РабочийПлан);
			Для Каждого Связь Из Связи.НайтиСтроки(Новый Структура("ИдУзла", Узел.ИдУзла)) Цикл
				ПозицияПлана = РабочийПлан[Связь.ИндексПлана];
				Если ПозицияПлана.КЗапуску > 0 Тогда
					СтрокаРаспределения = Распределение.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРаспределения, Связь);
					СтрокаРаспределения.КЗапуску = ПозицияПлана.КЗапуску;
					ПозицияПлана.КЗапуску = 0;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		юум_ФП_ДобавитьВыбранныеСвязи(Узел.Строки, Связи, РабочийПлан, Распределение);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_СкопироватьОтображаемыеСтроки(ИсточникСтрок, ПриемникСтрок, Знач ТолькоОтмеченные, Знач СтрокаПоиска)
	Для Каждого СтрокаИсточника Из ИсточникСтрок Цикл
		КопияСтроки = ПриемникСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(КопияСтроки, СтрокаИсточника);
		ПредставлениеПозиции = НРег(СтрокаИсточника.Код + " " + СтрокаИсточника.Представление);
		СовпалаСтрока = ПустаяСтрока(СтрокаПоиска) Или СтрНайти(ПредставлениеПозиции, СтрокаПоиска) > 0;
		ПоискПотомков = ?(СовпалаСтрока, "", СтрокаПоиска);
		юум_ФП_СкопироватьОтображаемыеСтроки(СтрокаИсточника.Строки, КопияСтроки.Строки,
			ТолькоОтмеченные, ПоискПотомков);
		ВыбранаСтрока = СтрокаИсточника.Отметка И СтрокаИсточника.КЗапуску > 0;
		ПоказатьСтроку = СовпалаСтрока И (Не ТолькоОтмеченные Или ВыбранаСтрока);
		Если Не ПоказатьСтроку И КопияСтроки.Строки.Количество() = 0 Тогда
			ПриемникСтрок.Удалить(КопияСтроки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ЗаполнитьКоличествоУзла(Узел, Знач Режим)
	КоличествоЗапуска = 0;
	Если Узел.ДопустимЗапуск И Режим <> "Снять" Тогда
		КоличествоЗапуска = Узел.Требуется;
		Если Режим = "Обеспечено" Тогда
			КоличествоЗапуска = Мин(КоличествоЗапуска, Узел.Обеспечено);
		КонецЕсли;
	КонецЕсли;
	Узел.КЗапуску = Макс(0, КоличествоЗапуска);
	Для Каждого ДочернийУзел Из Узел.Строки Цикл
		юум_ФП_ЗаполнитьКоличествоУзла(ДочернийУзел, Режим);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_СобратьПредупрежденияВыбора(СтрокиДерева, Знач ВыбранРодитель, Признаки)
	Для Каждого УзелВыбора Из СтрокиДерева Цикл
		юум_ФП_УточнитьКомплектностьВыбора(УзелВыбора, ВыбранРодитель, Признаки);
		ВыбранУзел = УзелВыбора.Отметка И УзелВыбора.КЗапуску > 0;
		юум_ФП_СобратьПредупрежденияВыбора(УзелВыбора.Строки, ВыбранРодитель Или ВыбранУзел, Признаки);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_УточнитьКомплектностьВыбора(Знач УзелВыбора, Знач ВыбранРодитель, Признаки)
	Если Не УзелВыбора.ДопустимЗапуск Тогда
		Возврат;
	КонецЕсли;
	ВыбранУзел = УзелВыбора.Отметка И УзелВыбора.КЗапуску > 0;
	Если ВыбранРодитель И Не ВыбранУзел Тогда
		Признаки.СнятыДетали = Истина;
	КонецЕсли;
	Если Не ВыбранУзел Тогда
		Возврат;
	КонецЕсли;
	Если Не УзелВыбора.ОбеспечениеРассчитано Тогда
		Признаки.НетРасчета = Истина;
	Иначе
		Признаки.НеОбеспечено = Признаки.НеОбеспечено Или УзелВыбора.КЗапуску > УзелВыбора.Обеспечено;
	КонецЕсли;
КонецПроцедуры // } #юум

// Фиксирует комментарии только для реально выбранных связей исходного плана.
// Параметры:
//  Модель - Структура - полная модель с полями План, Связи, Дерево.
// Возвращаемое значение:
//  ТаблицаЗначений - исходные аналитики и поле юум_ФП_Комментарий.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_КомментарииДляЗапуска(Знач Модель) 
	ТаблицаКомментариев = Модель.План.СкопироватьКолонки();
	ТаблицаКомментариев.Колонки.Добавить("юум_ФП_Комментарий", Новый ОписаниеТипов("Строка"));
	ТекстыУзлов = Новый Соответствие;
	юум_ФП_СобратьТекстыКомментариев(Модель.Дерево.Строки, "", ТекстыУзлов);
	Для Каждого СвязьВыбора Из юум_ФП_ВыбранныеСвязи(Модель, Модель.Дерево) Цикл
		ТекстПозиции = ТекстыУзлов.Получить(СвязьВыбора.ИдУзла);
		Если Не ЗначениеЗаполнено(ТекстПозиции) Тогда
			Продолжить;
		КонецЕсли;
		ИсходнаяПозиция = Модель.План[СвязьВыбора.ИндексПлана];
		СтрокаКомментария = ТаблицаКомментариев.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКомментария, ИсходнаяПозиция);
		СтрокаКомментария.юум_ФП_Комментарий = ТекстПозиции;
	КонецЦикла;
	Возврат ТаблицаКомментариев;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_НайтиУзелКомментария(СтрокиДерева, Знач ИдУзла)
	Для Каждого УзелКомментария Из СтрокиДерева Цикл
		Если УзелКомментария.ИдУзла = ИдУзла Тогда
			Возврат УзелКомментария;
		КонецЕсли;
		НайденныйУзел = юум_ФП_НайтиУзелКомментария(УзелКомментария.Строки, ИдУзла);
		Если НайденныйУзел <> Неопределено Тогда
			Возврат НайденныйУзел;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_ДобавитьАдресатаКомментария(УзелКомментария, Адресаты)
	Если УзелКомментария.ДопустимЗапуск Тогда
		СостояниеВыбора = ?(УзелКомментария.Отметка И УзелКомментария.КЗапуску > 0,
			" - выбран к запуску", " - будет адресатом при выборе к запуску");
		Адресаты.Добавить(УзелКомментария.Код + " " + УзелКомментария.Представление + СостояниеВыбора);
	КонецЕсли;
	Для Каждого ДочернийУзел Из УзелКомментария.Строки Цикл
		юум_ФП_ДобавитьАдресатаКомментария(ДочернийУзел, Адресаты);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_СобратьТекстыКомментариев(СтрокиДерева, Знач ОбщийТекст, ТекстыУзлов)
	Для Каждого УзелКомментария Из СтрокиДерева Цикл
		ТекстПозиции = ОбщийТекст;
		Если Не ПустаяСтрока(СокрЛП(УзелКомментария.Комментарий)) Тогда
			ТекстУзла = "[" + УзелКомментария.Код + " " + УзелКомментария.Представление + "]"
				+ Символы.ПС + УзелКомментария.Комментарий;
			ТекстПозиции = ТекстПозиции + ?(ПустаяСтрока(ТекстПозиции), "", Символы.ПС) + ТекстУзла;
		КонецЕсли;
		Если Не ПустаяСтрока(ТекстПозиции) Тогда
			ТекстыУзлов.Вставить(УзелКомментария.ИдУзла,
				"Заказ: " + Строка(УзелКомментария.ЗаказНаПроизводство) + Символы.ПС + ТекстПозиции);
		КонецЕсли;
		юум_ФП_СобратьТекстыКомментариев(УзелКомментария.Строки, ТекстПозиции, ТекстыУзлов);
	КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_КомментарииИзделия(Знач ИзделиеКЗапуску, Знач ИсходныеПартии, Знач ТаблицаКомментариев)
	ОтборИзделия = Новый Структура("Номенклатура,Характеристика,Спецификация,Назначение,Получатель");
	ЗаполнитьЗначенияСвойств(ОтборИзделия, ИзделиеКЗапуску);
	КомментарииПозиции = Новый Массив;
	Для Каждого СтрокаКомментария Из ТаблицаКомментариев.НайтиСтроки(ОтборИзделия) Цикл
		Если ЗначениеЗаполнено(ИзделиеКЗапуску.КлючПартия)
			И ИзделиеКЗапуску.КлючПартия <> СтрокаКомментария.КлючПартия Тогда
			Продолжить;
		КонецЕсли;
		ОтборИсточника = Новый Структура("ЗаказНаПроизводство,КлючПартия");
		ЗаполнитьЗначенияСвойств(ОтборИсточника, СтрокаКомментария);
		Если ИсходныеПартии.НайтиСтроки(ОтборИсточника).Количество() > 0 Тогда
			юум_ФП_ДобавитьНеповторяющийсяКомментарий(КомментарииПозиции, СтрокаКомментария.юум_ФП_Комментарий);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(КомментарииПозиции, Символы.ПС);
КонецФункции // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.

// Читает существующую иерархию. Заполнение справочника не вызывается.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - заказы формы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - ссылки и родители, ключи вхождений и нормы структуры.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_СтруктураЗаказов(Знач Заказы) 

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Дерево.Ссылка КАК Ссылка,
		|	Дерево.Родитель КАК Родитель,
		|	Дерево.Наименование КАК Наименование,
		|	Дерево.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Дерево.Номенклатура КАК Номенклатура,
		|	ПозицииНоменклатуры.Код КАК КодНоменклатуры,
		|	ПозицииНоменклатуры.Наименование КАК ПредставлениеНоменклатуры,
		|	ПРЕДСТАВЛЕНИЕ(ПозицииНоменклатуры.ЕдиницаИзмерения) КАК ЕдиницаИзмерения,
		|	Дерево.Характеристика КАК Характеристика,
		|	Дерево.Назначение КАК Назначение,
		|	Дерево.КлючНоменклатура КАК КлючНоменклатура,
		|	Дерево.КлючПартия КАК КлючПартия,
		|	Дерево.КлючНабор КАК КлючНабор,
		|	Дерево.Разделитель КАК Разделитель,
		|	Дерево.Спецификация КАК Спецификация,
		|	Дерево.Уровень КАК Уровень,
		|	Дерево.Доля КАК Доля,
		|	Дерево.ИдСтроки КАК ИдСтроки,
		|	Дерево.Требуется КАК ТребуетсяСтруктуры,
		|	Дерево.ТребуетсяВсего КАК ТребуетсяВсего,
		|	Дерево.СчетчикСтрок КАК СчетчикСтрок
		|ИЗ
		|	Справочник.юум_ДеревоЗаказаСлужебный КАК Дерево
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ПозицииНоменклатуры
		|		ПО Дерево.Номенклатура = ПозицииНоменклатуры.Ссылка
		|ГДЕ
		|	Дерево.ЗаказНаПроизводство В (&Заказы)
		|	И НЕ Дерево.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Дерево.ЗаказНаПроизводство,
		|	Дерево.Уровень,
		|	Дерево.СчетчикСтрок,
		|	Дерево.Код";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	СохраненнаяСтруктура = Запрос.Выполнить().Выгрузить();
	юум_ФП_ПодготовитьКлючиПроизводства(СохраненнаяСтруктура, Заказы);
	Возврат СохраненнаяСтруктура;
КонецФункции // } #юум

// Возвращает состояние для индикатора без подмены неизвестного расчета нулем.
//
// Параметры:
//  Позиция - Структура, СтрокаДереваЗначений, ДанныеФормыЭлементДерева -
//   Требуется, КЗапуску, Обеспечено, ЕстьЧастичноеОбеспечение,
//   ОбеспечениеРассчитано.
//
// Возвращаемое значение:
//  Строка - Полное, Частичное, Отсутствует или Не рассчитано.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_СостояниеОбеспеченияПозиции(Знач Позиция) 

	Если Не Позиция.ОбеспечениеРассчитано Тогда
		Возврат "Не рассчитано";
	КонецЕсли;
	КоличествоПроверки = ?(Позиция.КЗапуску > 0, Позиция.КЗапуску, Позиция.Требуется);
	Если Позиция.Обеспечено >= КоличествоПроверки Тогда
		Возврат "Полное";
	КонецЕсли;
	Если Позиция.Обеспечено > 0 Или Позиция.ЕстьЧастичноеОбеспечение Тогда
		Возврат "Частичное";
	КонецЕсли;

	Возврат "Отсутствует";

КонецФункции // } #юум

// Формирует технический ключ физической производственной позиции.
//
// Параметры:
//  Позиция - Структура, СтрокаТаблицыЗначений - заказ и ключи партии/номенклатуры.
//
// Возвращаемое значение:
//  Строка - ключ; представления номенклатуры в нем не используются.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ФормированиеПартийСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_КлючПозиции(Знач Позиция) 

	Возврат Строка(Позиция.ЗаказНаПроизводство.УникальныйИдентификатор())
		+ "|" + Строка(Позиция.КлючПартия)
		+ "|" + Строка(Позиция.КлючНоменклатура);

КонецФункции // } #юум


            Продолжить;
        КонецЕсли;
        СтрокаКонтекста = КонтекстОчереди.Загрузка.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаКонтекста, НагрузкаЭтапа);
        ДвижениеОчереди = ЗагрузкаОчереди.Добавить();
        ЗаполнитьЗначенияСвойств(ДвижениеОчереди, НагрузкаЭтапа);
        ДвижениеОчереди.ЗаказНаПроизводство = НагрузкаЭтапа.Распоряжение;
        ДвижениеОчереди.ЭтапСпецификации = НагрузкаЭтапа.Этап;
        ДвижениеОчереди.ЕстьДокумент = Ложь;
        ДвижениеОчереди.Приоритет = 1;
        ДвижениеОчереди.Завершено = Ложь;
        ДвижениеОчереди.ЗанятоСекунд = НагрузкаЭтапа.Занято;
    КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Процедура юум_ФП_Загрузка_ДобавитьОшибкиОчереди(ОшибкиОчереди, Знач ЗаказОчереди, Знач ОшибкиРасчета)
    Если ОшибкиРасчета.Количество() = 0 Тогда
        ОшибкиОчереди.Добавить(Строка(ЗаказОчереди) + ": ERP не сформировала график оставшегося объема.");
        Возврат;
    КонецЕсли;
    Для Каждого ОшибкаРасчета Из ОшибкиРасчета Цикл
        ОшибкиОчереди.Добавить(Строка(ЗаказОчереди) + ": " + ОшибкаРасчета.Описание);
    КонецЦикла;
КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ОбъединитьЗагрузкуОчереди(Знач ИсходнаяЗагрузка, Знач ЗагрузкаОчереди, Знач ЗамененныеЗаказы)
    ОбъединеннаяЗагрузка = ИсходнаяЗагрузка.СкопироватьКолонки();
    Для Каждого ДвижениеИсточника Из ИсходнаяЗагрузка Цикл
        Если Не ДвижениеИсточника.ЕстьДокумент
            И ЗамененныеЗаказы.Найти(ДвижениеИсточника.ЗаказНаПроизводство) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ЗаполнитьЗначенияСвойств(ОбъединеннаяЗагрузка.Добавить(), ДвижениеИсточника);
    КонецЦикла;
    Для Каждого ДвижениеОчереди Из ЗагрузкаОчереди Цикл
        ЗаполнитьЗначенияСвойств(ОбъединеннаяЗагрузка.Добавить(), ДвижениеОчереди);
    КонецЦикла;
    Возврат ОбъединеннаяЗагрузка;
КонецФункции // } #юум

// Дополняет плановую очередь остатками заказов, открытых в форме.
// Входные таблицы не изменяет; ключ выхода учитывает заказ, партию и номенклатуру.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_ПолныеОбъемыСУчетомФормы(Знач ПолныеОбъемы, Знач Модель)
	ОбъемыОснования = ПолныеОбъемы.Скопировать();
	Если Модель = Неопределено Тогда
		Возврат ОбъемыОснования;
	КонецЕсли;
	ИзвестныеВыходы = Новый Соответствие;
	Для Каждого ОбъемОснования Из ОбъемыОснования Цикл
		КлючВыхода = юум_ФП_КлючПозиции(ОбъемОснования);
		ИзвестныеВыходы.Вставить(КлючВыхода, ОбъемОснования);
	КонецЦикла;
	ПотребностиФормы = Новый Соответствие;
	Для Каждого ПозицияФормы Из Модель.План Цикл
		КлючВыхода = юум_ФП_КлючПозиции(ПозицияФормы);
		ПотребностьВыхода = ПотребностиФормы.Получить(КлючВыхода);
		Если ПотребностьВыхода = Неопределено Тогда
			ПотребностьВыхода = 0;
		КонецЕсли;
		ПотребностьВыхода = ПотребностьВыхода + ПозицияФормы.Требуется;
		ПотребностиФормы.Вставить(КлючВыхода, ПотребностьВыхода);
		ОбъемОснования = ИзвестныеВыходы.Получить(КлючВыхода);
		Если ОбъемОснования = Неопределено Тогда
			ОбъемОснования = ОбъемыОснования.Добавить();
			ЗаполнитьЗначенияСвойств(ОбъемОснования, ПозицияФормы);
			ОбъемОснования.Требуется = 0;
			ИзвестныеВыходы.Вставить(КлючВыхода, ОбъемОснования);
		КонецЕсли;
		// Текущий остаток формы включает еще не запланированный запуск.
		// Реестровое Запланировано не должно обнулять выбранную потребность.
		ОбъемОснования.Требуется = Макс(ОбъемОснования.Требуется, ПотребностьВыхода);
	КонецЦикла;
	Возврат ОбъемыОснования;
КонецФункции // } #юум

// Сворачивает рассчитанную загрузку по дням с приоритетом документов этапов.
// Параметры:
//  ИсходнаяЗагрузка - ТаблицаЗначений - движения с приоритетом и занятым временем.
//  НачалоПериода - Дата - начало видимого периода.
//  КонецПериода - Дата - окончание видимого периода.
// Возвращаемое значение:
//  ТаблицаЗначений - День, Подразделение, ЗанятоЧасов.
// #юум {
// #ЧТЗ 04.01
// V2: перенос логики обработки из юум_ФП_ЗагрузкаЦеховСервер.
// Галфинд mr. Cherryman 2026/11/09
Функция юум_ФП_Загрузка_СвернутьЗагрузкуПоДням(Знач ИсходнаяЗагрузка,
	Знач НачалоПериода, Знач КонецПериода)
	юум_ФП_Загрузка_ПроверитьПериод(НачалоПериода, КонецПериода);
	РаботыВРЦ = Новый Соответствие;
	Для Каждого ДвижениеВРЦ Из ИсходнаяЗагрузка Цикл
		КлючРаботы = юум_ФП_Загрузка_КлючРаботыВРЦ(ДвижениеВРЦ);
		РаботаВРЦ = РаботыВРЦ.Получить(КлючРаботы);
		Если РаботаВРЦ = Неопределено Или РаботаВРЦ.Приоритет < ДвижениеВРЦ.Приоритет Тогда
			РаботаВРЦ = Новый Структура("Строка,Приоритет,ЗанятоСекунд",
				ДвижениеВРЦ, ДвижениеВРЦ.Приоритет, 0);
			РаботыВРЦ.Вставить(КлючРаботы, РаботаВРЦ);
		КонецЕсли;
		Если РаботаВРЦ.Приоритет = ДвижениеВРЦ.Приоритет И Не ДвижениеВРЦ.Завершено Тогда
			РаботаВРЦ.ЗанятоСекунд = РаботаВРЦ.ЗанятоСекунд + ДвижениеВРЦ.ЗанятоСекунд;
		КонецЕсли;
	КонецЦикла;
	СводнаяЗагрузка = юум_ФП_Загрузка_НоваяСводнаяЗагрузка();
	СтрокиПоКлючам = Новый Соответствие;
	СекундВЧасе = 60 * 60;
	Для Каждого ЭлементРабот Из РаботыВРЦ Цикл
		РаботаВРЦ = ЭлементРабот.Значение;
		ДвижениеВРЦ = РаботаВРЦ.Строка;
		ДеньЗагрузки = НачалоДня(ДвижениеВРЦ.ДатаИнтервала);
		Если ДеньЗагрузки < НачалоДня(НачалоПериода) Или ДеньЗагрузки > КонецДня(КонецПериода) Тогда
			Продолжить;
		КонецЕсли;
		юум_ФП_Загрузка_ДобавитьСводнуюЗагрузку(СводнаяЗагрузка, СтрокиПоКлючам, ДеньЗагрузки,
			ДвижениеВРЦ.Подразделение, Макс(0, РаботаВРЦ.ЗанятоСекунд) / СекундВЧасе);
	КонецЦикла;
	СводнаяЗагрузка.Сортировать("День,Подразделение");
	Возврат СводнаяЗагрузка;
КонецФункции // } #юум

#КонецОбласти

#КонецЕсли

Функция юум_ФП_РодительПоИдентификатору(СтрокиДерева, Знач ИдУзла)
	Для Каждого Узел Из СтрокиДерева Цикл
		Для Каждого ДочернийУзел Из Узел.Строки Цикл
			Если ДочернийУзел.ИдУзла = ИдУзла Тогда
				Возврат Узел;
			КонецЕсли;
		КонецЦикла;
		НайденныйРодитель = юум_ФП_РодительПоИдентификатору(Узел.Строки, ИдУзла);
		Если НайденныйРодитель <> Неопределено Тогда
			Возврат НайденныйРодитель;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции // } #юум

// #юум {

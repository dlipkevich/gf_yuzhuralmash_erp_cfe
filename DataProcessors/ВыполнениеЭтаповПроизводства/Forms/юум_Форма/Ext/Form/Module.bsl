&НаКлиенте
Процедура РазвернутьДерево(Команда)
	ЭлементыДерева = Список.ПолучитьЭлементы();
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		ИДСтроки = ЭлементДерева.ПолучитьИдентификатор();
		Элементы.Список.Развернуть(ИДСтроки, Истина);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СвернутьДерево(Команда)
	ЭлементыДерева = Список.ПолучитьЭлементы();
	Для Каждого ЭлементДерева Из ЭлементыДерева Цикл
		ИДСтроки = ЭлементДерева.ПолучитьИдентификатор();
		Элементы.Список.Свернуть(ИДСтроки);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СостояниеОбеспеченияДинамическаяСтруктура(Команда)
	
	МассивДокументов = СобратьМассивДокументовПоДереву(ЭтотОбъект);  
	
	Если МассивДокументов.Количество() > 0 Тогда
		
		ОткрытьСостояниеОбеспеченияДляЭтаповДинамическойСтруктуры(МассивДокументов);
		
	КонецЕсли;
	
КонецПроцедуры


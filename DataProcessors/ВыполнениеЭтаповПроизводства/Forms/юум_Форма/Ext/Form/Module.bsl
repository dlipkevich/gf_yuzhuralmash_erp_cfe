&НаСервере
Функция ПолучитьОсновноеЗначениеСтроки(СтрокаДереваЗаказа)
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаДереваЗаказа, "ЗаказНаПроизводство, Номенклатура");
    Если ЗначениеЗаполнено(Реквизиты.Номенклатура) Тогда
	     ОсновноеЗначениеСтроки = Реквизиты.Номенклатура;
	Иначе	
	     ОсновноеЗначениеСтроки = Реквизиты.ЗаказНаПроизводство;
	КонецЕсли;
	
    Возврат ОсновноеЗначениеСтроки;
КонецФункции // ()

&НаКлиентеНаСервереБезКонтекста
Функция СобратьМассивДокументовПоДереву(Форма) 
	ВыделенныеСтроки = Форма.Элементы.Список.ВыделенныеСтроки; 
	Список = Форма.Список;
	МассивДокументов = Новый Массив;
	Для каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаДерева = Список.НайтиПоИдентификатору(ИдСтроки);   
		СобратьДокументыПоДеревуРекурсивно(Список, МассивДокументов, СтрокаДерева);
	КонецЦикла;
	
    Возврат МассивДокументов;
КонецФункции // ()

&НаКлиентеНаСервереБезКонтекста
Процедура СобратьДокументыПоДеревуРекурсивно(Список, МассивДокументов, ИсходныйУзел)
	Если ЗначениеЗаполнено(ИсходныйУзел.Ссылка) Тогда
		Если МассивДокументов.Найти(ИсходныйУзел.Ссылка) = Неопределено Тогда
			МассивДокументов.Добавить(ИсходныйУзел.Ссылка);
		КонецЕсли;
	Иначе
		СтрокиДерева = ИсходныйУзел.ПолучитьЭлементы();
		Для Каждого ДочерняяСтрока Из СтрокиДерева Цикл
			СобратьДокументыПоДеревуРекурсивно(Список, МассивДокументов, ДочерняяСтрока);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьТаблицуПослеФормирования(ТаблицаРезультат)
	ТаблицаРезультат.Колонки.Добавить("Распределено", Новый ОписаниеТипов("Булево"));
	МассивЗаказов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаРезультат.ВыгрузитьКолонку("ЗаказНаПроизводство"));
	Для каждого Заказ Из МассивЗаказов Цикл
		СтруктураОтбора = Новый Структура("Распределять, ЗаказНаПроизводство", Истина, Заказ);
		СтрокиКРаспределению = ТаблицаРезультат.НайтиСтроки(СтруктураОтбора);
		МассивЭтапов = Новый Массив;
		Для каждого Строка Из СтрокиКРаспределению Цикл 
			Если МассивЭтапов.Найти(Строка.Ссылка) = Неопределено Тогда
			     МассивЭтапов.Добавить(Строка.Ссылка);
			КонецЕсли;
		КонецЦикла;
		Для каждого Этап Из МассивЭтапов Цикл
			СтруктураОтбора.Вставить("Ссылка", Этап); 
			СтруктураОтбора.Вставить("Распределено", ЛОжь); 
			СтрокиКРаспределению = ТаблицаРезультат.НайтиСтроки(СтруктураОтбора);
			Если СтрокиКРаспределению.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			СтрокаПараметров = СтрокиКРаспределению[0]; 
			ИзделийВЭтапе = СтрокаПараметров.ИзделийВЭтапе;
			ОкруглятьДо = СтрокаПараметров.ОкруглятьДо;
			МассивДоли = Новый Массив;
			Для каждого СтрокаКРаспределению Из СтрокиКРаспределению Цикл
				МассивДоли.Добавить(СтрокаКРаспределению.ТребуетсяПоСтрокеЗаказа);
			КонецЦикла;
			МассивКоличество = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(ИзделийВЭтапе,
				МассивДоли, ОкруглятьДо); 
			
			Для Индекс = 0 По СтрокиКРаспределению.Количество() - 1 Цикл 
				Количество = МассивКоличество[Индекс];
				Если ЗначениеЗаполнено(МассивКоличество) Тогда
		    		СтрокиКРаспределению[Индекс].Изделий = Количество;
		    		СтрокиКРаспределению[Индекс].ТребуетсяПоСтрокеЗаказа = СтрокиКРаспределению[Индекс].ТребуетсяПоСтрокеЗаказа - Количество;
					СтрокиКРаспределению[Индекс].Распределено = (СтрокиКРаспределению[Индекс].ТребуетсяПоСтрокеЗаказа = 0);
				КонецЕсли;	
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры


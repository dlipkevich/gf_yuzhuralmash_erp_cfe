&Насервере
Функция НоваяТаблицаПотребностиНоменклатуры()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЗаказНаПроизводство", Новый ОписаниеТипов("ДокументСсылка.ЗаказНаПроизводство2_2"));
	Результат.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия, СправочникСсылка.Склады"));
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	Результат.Колонки.Добавить("Назначение", Новый ОписаниеТипов("СправочникСсылка.Назначения"));
	Результат.Колонки.Добавить("ЕдиницаИзмеренияЗакупки", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	Результат.Колонки.Добавить("КЗакупкеКоличество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла));
	Возврат Результат;
КонецФункции

&Насервере
Функция ПолучитьАдресПотребности()
	ТаблицаПотребностиНоменклатуры = НоваяТаблицаПотребностиНоменклатуры();
	
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Если Не Строка2Уровня.Отметка Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка2уровня.КЗакупкеКоличество) Тогда
				Продолжить;
			КонецЕсли;
			Если Строка2уровня.флПолуфабрикат Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаПотребности = ТаблицаПотребностиНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПотребности, Строка2уровня);
		КонецЦикла;
	КонецЦикла;

	Если ТаблицаПотребностиНоменклатуры.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат ПоместитьВоВременноеХранилище(ТаблицаПотребностиНоменклатуры, Новый УникальныйИдентификатор);
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СоздатьЗаявкаНаЗакупку(Команда)
	АдресПотребности = ПолучитьАдресПотребности();
	Если АдресПотребности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("АРММатериальнаяУкомплектованность", Истина);
	ПараметрыОткрытия.Вставить("АРМАдресПотребностиНоменклатуры", АдресПотребности);
	АдресНастроек = ПолучитьАдресНастроек();
	ПараметрыОткрытия.Вставить("АРМАдресНастроек", АдресНастроек);
	ПараметрыОткрытия.Вставить("АРМВключатьМатериалыПоТребованию", ВключатьМатериалыПоТребованию);
	ПараметрыОткрытия.Вставить("КлючНазначенияИспользования", "ФормированиеЗаявокПоПотребностям");
	ПараметрыОткрытия.Вставить("ОтборПоТипуОбеспечения", ПредопределенноеЗначение("Перечисление.ТипыОбеспечения.Покупка"));
	
	ПараметрыОбработчика = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьЗаявкаНаЗакупкуЗавершение", ЭтотОбъект, ПараметрыОбработчика);
	
	ОткрытьФорму("Обработка.ОбеспечениеПотребностей.Форма.Форма",
		ПараметрыОткрытия,,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры


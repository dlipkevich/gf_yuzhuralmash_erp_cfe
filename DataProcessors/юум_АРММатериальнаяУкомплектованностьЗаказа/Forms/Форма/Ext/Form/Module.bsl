
#Область УкомплектованностьЗаказов

&НаСервере
Процедура УкомплектованностьЗаказовНастроитьПараметрыОтборы(ОтчетОбъект)
	
	СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("СхемаКомпоновкиДанных");

	НастройкиОтчета = СхемаКомпоновкиДанных.ВариантыНастроек.ПоЗаказу.Настройки;
	
	НастройкиКомпоновщика = КомпоновщикНастроекОбработка.ПолучитьНастройки();
	
	// сначала "убираем" использование типовых отборов
	Для Каждого ЭлементОтбора Из НастройкиОтчета.Отбор.Элементы Цикл
		ЭлементОтбора.Использование = Ложь;
	КонецЦикла;
	
	Для Каждого ОтборКомпоновщика Из НастройкиКомпоновщика.Отбор.Элементы Цикл
		Если Не ОтборКомпоновщика.Использование Тогда
			Продолжить;
		КонецЕсли;

		Если Не ОтборКомпоновщика.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура")
			И Не ОтборКомпоновщика.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика")
			И Не ОтборКомпоновщика.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Назначение") Тогда
			// применяем отборы только по Номенклатуре / Характеристике / Назначению
			Продолжить;
		КонецЕсли;
		
		флЭлементОтбораНайден = Ложь;
		Для Каждого ЭлементОтбора Из НастройкиОтчета.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ОтборКомпоновщика.ЛевоеЗначение Тогда
				флЭлементОтбораНайден = Истина;
				ЭлементОтбора.ПравоеЗначение = ОтборКомпоновщика.ПравоеЗначение;
				ЭлементОтбора.Использование = ОтборКомпоновщика.Использование;
				ЭлементОтбора.ВидСравнения = ОтборКомпоновщика.ВидСравнения;
			КонецЕсли;
		КонецЦикла;
		
		Если Не флЭлементОтбораНайден
			И ОтборКомпоновщика.Использование Тогда
			ЭлементОтбора = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = ОтборКомпоновщика.ЛевоеЗначение;
			ЭлементОтбора.ПравоеЗначение = ОтборКомпоновщика.ПравоеЗначение;
			ЭлементОтбора.Использование = ОтборКомпоновщика.Использование;
			ЭлементОтбора.ВидСравнения = ОтборКомпоновщика.ВидСравнения;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементПараметр Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если ЭлементПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ИсключитьПроизводимыеПолуфабрикаты") Тогда
			ЭлементПараметр.Значение = ИсключитьПроизводимыеПолуфабрикаты;
		КонецЕсли;
	КонецЦикла;
	
	ОтчетОбъект.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
КонецПроцедуры

&НаСервере
Функция ОтчетУкомплектованностьЗаказовНаСервере()

	ОтчетОбъект = Отчеты.УкомплектованностьЗаказов.Создать();
	
	УкомплектованностьЗаказовНастроитьПараметрыОтборы(ОтчетОбъект);
	
	ДанныеРасшифровки = Неопределено;
	
	СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("СхемаКомпоновкиДанных");
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("НаборДанных");
	
	ТекстЗапроса = НаборДанных.Запрос;
	
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	
	НаборДанных.Запрос = ТекстЗапроса;
	
	ТабДок = Новый ТабличныйДокумент;
	
	НастройкиОтчета = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанных(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
		
	ВнешниеНаборыДанных = Неопределено;
	// Создадим и инициализируем процессор компоновки.
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабДок);
		
	// Обозначим начало вывода
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Возврат Табдок;
	
КонецФункции

&НаКлиенте
Процедура ОтчетУкомплектованностьЗаказов(Команда)
	ТабДок = ОтчетУкомплектованностьЗаказовНаСервере();
	ТабДок.Показать("ОТЧЕТ Укомплектованность заказов");
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СКД = ОбработкаОбъект.ПолучитьМакет("СКД");
	АдресСхемы = ПоместитьВоВременноеХранилище(СКД, УникальныйИдентификатор);
	КомпоновщикНастроекОбработка.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));	
	
	НастройкиОтчета = СКД.ВариантыНастроек.ГруппировкаПоСкладу.Настройки;
	КомпоновщикНастроекОбработка.ЗагрузитьНастройки(НастройкиОтчета);
	
КонецПроцедуры

#Область МатериальнаяУкомплектованность

&НаСервере
Процедура ЗаполнитьПотребностьЗОЗ(ТаблицаИзмерений)
	
	НастройкиКомпоновщика = КомпоновщикНастроекОбработка.ПолучитьНастройки();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СКДПотребностьЗОЗ = ОбработкаОбъект.ПолучитьМакет("СКДПотребностьЗОЗ");
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СКДПотребностьЗОЗ, УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	НастройкиОтчета = СКДПотребностьЗОЗ.ВариантыНастроек.Основной.Настройки;
	Для Каждого ЭлементОтбора Из НастройкиКомпоновщика.Отбор.Элементы Цикл
		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ЗаказНаПроизводство") Тогда
			// Отбор по Заказу на производство в СКДПотребностьЗОЗ не используется
			Продолжить;
		КонецЕсли;
			
		Если Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура")
			И Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика")
			И Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Назначение") Тогда
			// применяем отборы только по Номенклатуре / Характеристике / Назначению
			Продолжить;
		КонецЕсли;
		
		ЭО = КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(НастройкиОтчета,
			ЭлементОтбора.ЛевоеЗначение,
			ЭлементОтбора.ПравоеЗначение,
			ЭлементОтбора.ВидСравнения);
	КонецЦикла;
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	ДанныеРасшифровки = Неопределено;
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(СКДПотребностьЗОЗ, НастройкиОтчета, ДанныеРасшифровки);
		
	ВнешниеНаборыДанных = Неопределено;
	// Создадим и инициализируем процессор компоновки.
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаОтчета);
		
	// Обозначим начало вывода
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	ЗначениеВРеквизитФормы(ТаблицаОтчета, "ПотребностьЗОЗ");
	
	СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
	Для Каждого СтрокаПотребностьЗОЗ Из ТаблицаОтчета Цикл
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаПотребностьЗОЗ);
		МассивСтрок = ТаблицаИзмерений.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество() = 0 Тогда
			НоваяСтрокаТЗ  = ТаблицаИзмерений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТЗ, СтрокаПотребностьЗОЗ);
			НоваяСтрокаТЗ.ЗаказНаПоступление = СтрокаПотребностьЗОЗ.ЗаявкаНаЗакупку;
			НоваяСтрокаТЗ.ПотребностьЗОЗ = СтрокаПотребностьЗОЗ.ЗОЗКоличество;
			НоваяСтрокаТЗ.Требуется = 0;
		Иначе
			Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
				НайденнаяСтрока.ЗаказНаПоступление = СтрокаПотребностьЗОЗ.ЗаявкаНаЗакупку;
				НайденнаяСтрока.ПотребностьЗОЗ = СтрокаПотребностьЗОЗ.ЗОЗКоличество;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВключитьМатериалыПоТребованию(ТаблицаИзмерений)
	//КолонкиГруппировок = "ЗаказНаПроизводство, ДатаПотребности, Номенклатура, НоменклатураЕдиницаИзмерения, Характеристика, Назначение, Склад";
	////КолонкиГруппировок = "ЗаказНаПроизводство, ДатаПотребности, Номенклатура, НоменклатураЕдиницаИзмерения, Характеристика, Назначение, Склад, Этап";

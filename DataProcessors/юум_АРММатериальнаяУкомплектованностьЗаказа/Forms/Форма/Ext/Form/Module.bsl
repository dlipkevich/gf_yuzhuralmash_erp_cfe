Функция СоздатьПеремещениеТоваровПоОрганизации(СтрокаОрганизация)
	ДокОбъект = Документы.ПеремещениеТоваров.СоздатьДокумент();
	ДокОбъект.Дата = ТекущаяДатаСеанса();
	ДокОбъект.Организация = СтрокаОрганизация.Организация;
	ДокОбъект.БанковскийСчетОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаОрганизация.Организация, "ОсновнойБанковскийСчет");
	ДокОбъект.СкладПолучатель = СтрокаОрганизация.Склад;
	ДокОбъект.Статус = Перечисления.СтатусыПеремещенийТоваров.Отгружено;
	ДокОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
	ДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
	ДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
	ОтветственныеЛица = ОтветственныеЛицаСервер.ПолучитьОтветственныеЛицаОрганизации(СтрокаОрганизация.Организация, ТекущаяДатаСеанса());
	Если ТипЗнч(ОтветственныеЛица) = Тип("Структура")
		И ОтветственныеЛица.Свойство("ГлавныйБухгалтерСсылка") Тогда
		ДокОбъект.ГлавныйБухгалтер = ОтветственныеЛица.ГлавныйБухгалтерСсылка;
	КонецЕсли;
	ДокОбъект.НаправлениеДеятельности = СтрокаОрганизация.НаправлениеДеятельности;
	ДокОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
	ДокОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	ДокОбъект.Комментарий = "Создан из обработки ""АРМ Материальная укомплектованность заказа""";
	
	ТЗНоменклатураПеремещениеТоваров = РеквизитФормыВЗначение("НоменклатураПеремещениеТоваров");
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Организация", СтрокаОрганизация.Организация);
	СтруктураПоиска.Вставить("НаправлениеДеятельности", СтрокаОрганизация.НаправлениеДеятельности);
	СтруктураПоиска.Вставить("Склад", СтрокаОрганизация.Склад);
	СтрокиДокумента = ТЗНоменклатураПеремещениеТоваров.НайтиСтроки(СтруктураПоиска);
	Для Каждого СтрокаДокумента Из СтрокиДокумента Цикл
		СтрокаТЧ = ДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаДокумента);
		СтрокаТЧ.НазначениеОтправителя = СтрокаДокумента.Назначение;
		СтрокаТЧ.ПодлежитРазблокировке = Истина;
	КонецЦикла;
	
	Попытка
		ДокОбъект.Записать();
		Возврат ДокОбъект.Ссылка;
	Исключение
		Сообщить("Ошибка при записи Перемещение товаров:" + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;
КонецФункции


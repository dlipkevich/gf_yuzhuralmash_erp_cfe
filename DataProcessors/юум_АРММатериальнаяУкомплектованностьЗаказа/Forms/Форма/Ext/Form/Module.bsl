&НаКлиенте
Процедура ДеревоУкомплектованностьЗаказовПриАктивизацииСтроки(Элемент)
	ТД = Элементы.ДеревоУкомплектованностьЗаказов.ТекущиеДанные;
	Если ТД <> Неопределено Тогда
		Элементы.ДеревоУкомплектованностьЗаказовЕдиницаИзмеренияЗакупки.СписокВыбора.Очистить();
		Если ЗначениеЗаполнено(ТД.Номенклатура) Тогда
			ЕдиницаИзмеренияЗакупкиУстановитьСписокВыбора(ТД.Номенклатура);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияЗакупкиУстановитьСписокВыбора(Номенклатура)
	Элементы.ДеревоУкомплектованностьЗаказовЕдиницаИзмеренияЗакупки.СписокВыбора.ЗагрузитьЗначения(ЕдиницаИзмеренияЗакупкиПолучитьСписокВыборка(Номенклатура));
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЕдиницаИзмеренияЗакупкиПолучитьСписокВыборка(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УпаковкиЕдиницыИзмерения.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.УпаковкиЕдиницыИзмерения КАК УпаковкиЕдиницыИзмерения
	               |ГДЕ
	               |	УпаковкиЕдиницыИзмерения.Владелец = &Владелец";
	Результат = Запрос.Выполнить();
	МассивЗначений = Новый Массив;
	Если Результат.Пустой() Тогда
		Возврат МассивЗначений;
	КонецЕсли;
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомераСтрокиЗаявкиНаЗакупку(Строка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Строка.ЗаказНаПоступление);
	Запрос.УстановитьПараметр("Номенклатура", Строка.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Строка.Характеристика);
	Запрос.УстановитьПараметр("Назначение", Строка.Назначение);
	Запрос.УстановитьПараметр("Склад", Строка.Склад);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаявкаНаЗакупкуТовары.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	Документ.ЗаявкаНаЗакупку.Товары КАК ЗаявкаНаЗакупкуТовары
	               |ГДЕ
	               |	НЕ ЗаявкаНаЗакупкуТовары.Отменено
	               |	И ЗаявкаНаЗакупкуТовары.Ссылка = &Ссылка
	               |	И ЗаявкаНаЗакупкуТовары.Номенклатура = &Номенклатура
	               |	И ЗаявкаНаЗакупкуТовары.Характеристика = &Характеристика
	               |	И ЗаявкаНаЗакупкуТовары.Назначение = &Назначение
	               |	И ЗаявкаНаЗакупкуТовары.Склад = &Склад";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("НомерСтроки");
КонецФункции

&НаКлиенте
Процедура СоздатьЗаказПоставщику(Команда)
	
	// сначала соберем Соответствие Заявка на закупку - Номера строк (Массив)
	СоответствиеЗаявкаНаЗакупку = Новый Соответствие;
	
	СтруктураПоиска = Новый Структура("ЗаказНаПроизводство, ДатаПотребности, Номенклатура, Характеристика, Назначение, Склад");
	
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Если Не Строка2Уровня.Отметка Тогда
				Продолжить;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка2уровня);
			НайденныеСтроки = УкомплектованностьЗаказовДетальныеЗаписи.НайтиСтроки(СтруктураПоиска);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Если Не ЗначениеЗаполнено(НайденнаяСтрока.ЗаказНаПоступление) Тогда
					Продолжить;
				КонецЕсли;
				Если ТипЗнч(НайденнаяСтрока.ЗаказНаПоступление) = Тип("ДокументСсылка.ЗаявкаНаЗакупку") Тогда
					СтруктураСтроки = Новый Структура("ЗаказНаПоступление, Номенклатура, Характеристика, Назначение, Склад");
					ЗаполнитьЗначенияСвойств(СтруктураСтроки, НайденнаяСтрока);
					НомераСтрокЗаявки = ПолучитьНомераСтрокиЗаявкиНаЗакупку(СтруктураСтроки);
					Если НомераСтрокЗаявки.Количество() > 0 Тогда
						НомераСтрок = СоответствиеЗаявкаНаЗакупку.Получить(НайденнаяСтрока.ЗаказНаПоступление);
						Если НомераСтрок = Неопределено Тогда
							НомераСтрок = Новый Массив;
						КонецЕсли;
						Для Каждого НомерСтроки Из НомераСтрокЗаявки Цикл
							Если ЗначениеЗаполнено(НомераСтрок.Найти(НомерСтроки)) Тогда
								Продолжить;
							КонецЕсли;
							НомераСтрок.Добавить(НомерСтроки);
						КонецЦикла;
						СоответствиеЗаявкаНаЗакупку.Вставить(НайденнаяСтрока.ЗаказНаПоступление, НомераСтрок);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// сохраняем количество заказов поставщику
	ЗаказыПоставщикуКоличество = СоответствиеЗаявкаНаЗакупку.Количество();
	ЗаказыПоставщику.Очистить();
	
	Для Каждого Заявка Из СоответствиеЗаявкаНаЗакупку Цикл
		ОписаниеЗаказаКСозданию = ОписаниеЗаказаКСозданию(Заявка.Ключ, Заявка.Значение);
	
		Если ОписаниеЗаказаКСозданию.ДанныеЗаказа = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'По выделенным строкам не требуется ввод новых заказов.';
										|en = 'No new orders are required for the selected lines.'"));
			Продолжить;
		КонецЕсли;
	
		ПараметрыОткрытияФормы = Новый Структура("ЗначенияЗаполнения", ОписаниеЗаказаКСозданию.ДанныеЗаказа);
		ПараметрыОткрытияФормы.Вставить("АРММатериальнаяУкомплектованность", Истина);
		
		ОткрытьФорму("Документ.ЗаказПоставщику.ФормаОбъекта",
			ПараметрыОткрытияФормы,
			ЭтотОбъект,
			Истина);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОписаниеЗаказаКСозданию(ЗаявкаКлюч, Знач ЗаявкаЗначение)
	
	ОписаниеЗаказаКСозданию = Документы.ЗаявкаНаЗакупку.ОписаниеЗаказаКСозданию(ЗаявкаКлюч, ЗаявкаЗначение);
	
	Если ОписаниеЗаказаКСозданию.ДанныеЗаказа <> Неопределено Тогда
		
		ОписаниеЗаказаКСозданию.ДанныеЗаказа.Товары = ПоместитьВоВременноеХранилище(
			ОписаниеЗаказаКСозданию.ДанныеЗаказа.Товары);
		
	КонецЕсли;
	
	Возврат ОписаниеЗаказаКСозданию;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "АРМСозданЗаказПоставщику" Тогда
		Если ЗначениеЗаполнено(Параметр) Тогда
			ЗаказыПоставщику.Добавить(Параметр);
		КонецЕсли;
		Если ЗаказыПоставщику.Количество() >= ЗаказыПоставщикуКоличество Тогда
			ОтчетЗаказыПоставщику = ПодготовитьОтчетЗаказыПоставщику();
			ОтчетЗаказыПоставщику.Показать("Созданы Заказы поставщику");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПодготовитьОтчетЗаказыПоставщику()
	
	Протокол = Новый ТабличныйДокумент;
	Протокол.АвтоМасштаб = Истина;
	Протокол.ОтображатьСетку = Ложь;
	Протокол.ОтображатьЗаголовки = Ложь;
	Протокол.ТолькоПросмотр = Истина;
	Протокол.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("МакетНовыеДокументы");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапка.Параметры.ТекущаяДата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.ТипДокумента = "Заказ поставщику";
	Протокол.Вывести(ОбластьШапка);
	
	Для Каждого Строка Из ЗаказыПоставщику Цикл
		
		ОбластьСтрока.Параметры.ДокументСсылка = Строка.Значение;
		
		Протокол.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Возврат Протокол;
	
КонецФункции

&НаКлиенте
Процедура УровеньДерева(Команда)
	Если Не ЗначениеЗаполнено(УровеньДереваФормы) Тогда
		Возврат;
	КонецЕсли;
	Если УровеньДереваФормы = 1 Тогда
		Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
		Для Каждого Строка1уровня Из Строки1уровня Цикл
    		// получаем идентификатор строки в таблице формы
    		СтрокаДереваИД = Строка1уровня.ПолучитьИдентификатор();
    		// проверяем состояние строки
    		Если Элементы.ДеревоУкомплектованностьЗаказов.Развернут(СтрокаДереваИД) = Ложь Тогда
        		// разворачиваем строку дерева
        		Элементы.ДеревоУкомплектованностьЗаказов.Развернуть(СтрокаДереваИД);
    		КонецЕсли;
		КонецЦикла;
		
		УровеньДереваФормы = 2;
		УстановитьЗаголовокКнопкиУровеньДерева();
		
	ИначеЕсли УровеньДереваФормы = 2 Тогда
		Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
		Для Каждого Строка1уровня Из Строки1уровня Цикл
    		// получаем идентификатор строки в таблице формы
    		СтрокаДереваИД = Строка1уровня.ПолучитьИдентификатор();
    		// проверяем состояние строки
    		Если Элементы.ДеревоУкомплектованностьЗаказов.Развернут(СтрокаДереваИД) = Ложь Тогда
        		// разворачиваем строку дерева
        		Элементы.ДеревоУкомплектованностьЗаказов.Развернуть(СтрокаДереваИД);
			КонецЕсли;
			
			Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
			Для Каждого Строка2уровня Из Строки2Уровня Цикл
    			// получаем идентификатор строки в таблице формы
    			СтрокаДереваИД = Строка2уровня.ПолучитьИдентификатор();
    			// проверяем состояние строки
    			Если Элементы.ДеревоУкомплектованностьЗаказов.Развернут(СтрокаДереваИД) = Ложь Тогда
        			// разворачиваем строку дерева
        			Элементы.ДеревоУкомплектованностьЗаказов.Развернуть(СтрокаДереваИД);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		УровеньДереваФормы = 3;
		УстановитьЗаголовокКнопкиУровеньДерева();
	Иначе
		
		// Свернуть
		Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
		Для Каждого Строка1уровня Из Строки1уровня Цикл
			Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
			Для Каждого Строка2уровня Из Строки2Уровня Цикл
    			// получаем идентификатор строки в таблице формы
    			СтрокаДереваИД = Строка2уровня.ПолучитьИдентификатор();
    			// проверяем состояние строки
    			Если Элементы.ДеревоУкомплектованностьЗаказов.Развернут(СтрокаДереваИД) Тогда
        			// сворачиваем строку дерева
        			Элементы.ДеревоУкомплектованностьЗаказов.Свернуть(СтрокаДереваИД);
				КонецЕсли;
			КонецЦикла;
			
    		// получаем идентификатор строки в таблице формы
    		СтрокаДереваИД = Строка1уровня.ПолучитьИдентификатор();
    		// проверяем состояние строки
    		Если Элементы.ДеревоУкомплектованностьЗаказов.Развернут(СтрокаДереваИД) Тогда
        		// сворачиваем строку дерева
        		Элементы.ДеревоУкомплектованностьЗаказов.Свернуть(СтрокаДереваИД);
			КонецЕсли;
		КонецЦикла;
		УровеньДереваФормы = 1;
		УстановитьЗаголовокКнопкиУровеньДерева();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗаголовокКнопкиУровеньДерева()
	Если Не ЗначениеЗаполнено(УровеньДереваФормы) Тогда
		Элементы.ДеревоУкомплектованностьЗаказовУровеньДерева.Заголовок = "Уровень";
	Иначе
		Элементы.ДеревоУкомплектованностьЗаказовУровеньДерева.Заголовок = "Уровень " + Формат(УровеньДереваФормы, "ЧГ=0");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуВсем(Значение)
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Строка2Уровня.Отметка = Значение;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометку(Команда)
	УстановитьПометкуВсем(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометку(Команда)
	УстановитьПометкуВсем(Ложь);
КонецПроцедуры

&Насервере
Функция ПолучитьСписокНоменкладуры()
	СпискокНоменклатуры = Новый СписокЗначений;
	
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Если Не Строка2Уровня.Отметка Тогда
				Продолжить;
			КонецЕсли;
			
			СпискокНоменклатуры.Добавить(Строка2уровня.Номенклатура);
		КонецЦикла;
	КонецЦикла;

	Если СпискокНоменклатуры.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат СпискокНоменклатуры;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ОтчетОстаткиИДоступностьТоваровПоОтметкам(Команда)
	
	СписокНоменклатуры = ПолучитьСписокНоменкладуры();
	Если СписокНоменклатуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ПоНоменклатуреКонтекст");
	ПараметрыФормы.Вставить("Неконтекстный", Ложь);
	ДополнительныеПараметры = Новый Структура("ИмяКоманды", "ОстаткиИДоступность");
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДополнительныеПараметры);
	ПараметрыФормы.Вставить("ОписаниеКоманды", ОписаниеКоманды);
	ПараметрыФормы.Вставить("ПараметрКоманды", СписокНоменклатуры);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("Отбор",                   Новый Структура("ПоказатьОбособленныеТовары", Ложь));
	
	ОткрытьФорму("Отчет.ОстаткиИДоступностьТоваров.Форма", ПараметрыФормы, ЭтотОбъект, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКорректировкаНазначения(Команда)
	
	// сначала соберем отмеченные строки дерева
	НоменклатураКорректировкаНазначения.Очистить();
	
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Если Не Строка2Уровня.Отметка Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(Строка2уровня.ЗаказНаПроизводство) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТЗ = 	НоменклатураКорректировкаНазначения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЗ, Строка2уровня);

		КонецЦикла;
	КонецЦикла;
	
	Если НоменклатураКорректировкаНазначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отчет = СоздатьКорректировкаНазначенияНаСервере();
	Отчет.Показать("Созданы Корректировки назначения");

КонецПроцедуры


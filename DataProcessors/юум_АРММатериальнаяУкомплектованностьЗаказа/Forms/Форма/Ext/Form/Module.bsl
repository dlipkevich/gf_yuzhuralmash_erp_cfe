	Возврат ПоместитьВоВременноеХранилище(ВидимостьКолонок.Выгрузить(), Новый УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура НастроитьВидимостьКолонок(Команда)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = Новый Структура;
	Адрес = ПолучитьАдресВидимостьКолонок();
	ПараметрыОткрытия.Вставить("Адрес", Адрес);
	
	ПараметрыОбработчика = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("НастроитьВидимостьКолонокЗавершение", ЭтотОбъект, ПараметрыОбработчика);
	
	ОткрытьФорму("ВнешняяОбработка.юум_АРММатериальнаяУкомплектованностьЗаказа.Форма.ФормаНастроек",
		ПараметрыОткрытия,,,,,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьКолонокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьРезультатНаСервере(Результат);
	УправлениеВидимостьКолонок();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатНаСервере(Результат)
	ТЗВидимостьКолонок = ПолучитьИзВременногоХранилища(Результат.Адрес);
	ВидимостьКолонок.Загрузить(ТЗВидимостьКолонок);
КонецПроцедуры

&НаКлиенте
Процедура УправлениеВидимостьКолонок()
	Для Каждого СтрокаТЗ Из ВидимостьКолонок Цикл
		УстановитьВидимостьГруппыКолонок(СтрокаТЗ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьГруппыКолонок(СтрокаТЗ)
	Если СтрокаТЗ.Имя = "Вес" Тогда
		Элементы.ДеревоУкомплектованностьЗаказовВесДетали.Видимость = СтрокаТЗ.Видимость;
		Элементы.ДеревоУкомплектованностьЗаказовВесДеталиЧерный.Видимость = СтрокаТЗ.Видимость;
		Элементы.ДеревоУкомплектованностьЗаказовВесПотребностиОбщий.Видимость = СтрокаТЗ.Видимость;
	КонецЕсли;
	Если СтрокаТЗ.Имя = "Покрытие" Тогда
		Элементы.ГруппаПокрытие.Видимость = СтрокаТЗ.Видимость;
	КонецЕсли;
	Если СтрокаТЗ.Имя = "Заказано" Тогда
		Элементы.ГруппаЗаказано.Видимость = СтрокаТЗ.Видимость;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеВидимостьКолонок();
	УстановитьЗаголовокКнопкиУровеньДерева();
КонецПроцедуры


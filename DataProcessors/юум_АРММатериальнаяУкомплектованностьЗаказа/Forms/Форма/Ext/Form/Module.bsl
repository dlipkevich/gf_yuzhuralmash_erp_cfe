	               |	МАКСИМУМ(т.НомерСтроки) КАК НомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение
	               |ПОМЕСТИТЬ втМаксимальныйНомерСтроки
	               |ИЗ
	               |	втПотребности КАК т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Номенклатура,
	               |	т.Характеристика,
	               |	т.Назначение";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втМаксимальныйНомерСтроки")
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.НомерСтроки КАК НомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Требуется КАК Требуется,
	               |	СУММА(ЕСТЬNULL(т2.Требуется, 0)) КАК ТребуетсяНакопленная
	               |ПОМЕСТИТЬ втПотребностиСНакоплением
	               |ИЗ
	               |	втПотребности КАК т
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПотребности КАК т2
	               |		ПО (т.Номенклатура = т2.Номенклатура)
	               |			И (т.Характеристика = т2.Характеристика)
	               |			И (т.Назначение = т2.Назначение)
	               |			И т.НомерСтроки > т2.НомерСтроки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.НомерСтроки,
	               |	т.Характеристика,
	               |	т.Номенклатура,
	               |	т.Назначение,
	               |	т.Требуется";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втПотребностиСНакоплением")
	
	ТЗОстаткиИДоступностьТоваров = РеквизитФормыВЗначение("ОстаткиИДоступностьТоваров");
	Запрос.УстановитьПараметр("Остатки", ТЗОстаткиИДоступностьТоваров);
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.ВНаличии КАК ВНаличии
	               |ПОМЕСТИТЬ втОстаткиДетали
	               |ИЗ
	               |	&Остатки КАК т
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	СУММА(т.ВНаличии) КАК ВНаличии
	               |ПОМЕСТИТЬ втОстатки
	               |ИЗ
	               |	втОстаткиДетали КАК т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Назначение,
	               |	т.Номенклатура,
	               |	т.Характеристика";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втОстатки")
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.НомерСтроки КАК НомерСтроки,
	               |	втМаксимальныйНомерСтроки.НомерСтроки КАК МаксимальныйНомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	ВЫБОР
	               |		КОГДА т.НомерСтроки < втМаксимальныйНомерСтроки.НомерСтроки
	               |			ТОГДА ВЫБОР
	               |					КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная < 0
	               |						ТОГДА 0
	               |					КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная > т.Требуется
	               |						ТОГДА т.Требуется
	               |					ИНАЧЕ ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная < 0
	               |					ТОГДА 0
	               |				ИНАЧЕ ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ПокрытиеОбеспечено,
	               |	ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная КАК ВНаличии_ТребуетсяНакопленная,
	               |	т.Требуется КАК Требуется,
	               |	т.ТребуетсяНакопленная КАК ТребуетсяНакопленная,
	               |	ЕСТЬNULL(Остатки.ВНаличии, 0) КАК ВНаличии
	               |ИЗ
	               |	втПотребностиСНакоплением КАК т
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК Остатки
	               |		ПО т.Номенклатура = Остатки.Номенклатура
	               |			И т.Характеристика = Остатки.Характеристика
	               |			И т.Назначение = Остатки.Назначение
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втМаксимальныйНомерСтроки КАК втМаксимальныйНомерСтроки
	               |		ПО т.Номенклатура = втМаксимальныйНомерСтроки.Номенклатура
	               |			И т.Характеристика = втМаксимальныйНомерСтроки.Характеристика
	               |			И т.Назначение = втМаксимальныйНомерСтроки.Назначение";
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	Для Каждого СтрокаПотребности Из ТЗ Цикл
		СтрокаТЗ = ТаблицаИзмерений.Найти(СтрокаПотребности.НомерСтроки, "НомерСтроки");
		Если СтрокаТЗ <> Неопределено Тогда
			
			// - Обеспечено кол-во
			СтрокаТЗ.ПокрытиеОбеспечено = СтрокаПотребности.ПокрытиеОбеспечено;
			
			// - % покрытия
			Если ЗначениеЗаполнено(СтрокаТЗ.Требуется) Тогда
				СтрокаТЗ.ПокрытиеПроцент = СтрокаТЗ.ПокрытиеОбеспечено / СтрокаТЗ.Требуется * 100;
			КонецЕсли;
			
			// - Дефицит
			СтрокаТЗ.ПокрытиеДефицит = СтрокаТЗ.Требуется - СтрокаТЗ.ПокрытиеОбеспечено;
			Если СтрокаТЗ.ПокрытиеДефицит < 0 Тогда
				СтрокаТЗ.ПокрытиеДефицит = 0;
			КонецЕсли;
			
			// - Избыток
			СтрокаТЗ.ПокрытиеИзбыток = СтрокаТЗ.ПокрытиеОбеспечено - СтрокаТЗ.Требуется;
			Если СтрокаТЗ.ПокрытиеИзбыток < 0 Тогда
				СтрокаТЗ.ПокрытиеИзбыток = 0;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СвободныйОстатокНаВсехСкладахБезНазначения(Строка)
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
	СтруктураПоиска.Вставить("Назначение", Справочники.Назначения.ПустаяСсылка());
	НайденныеСтроки = ОстаткиИДоступностьТоваров.НайтиСтроки(СтруктураПоиска);
	ВсегоДоступно = 0;
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		ВсегоДоступно = ВсегоДоступно + НайденнаяСтрока.Доступно;
	КонецЦикла;
	Возврат ВсегоДоступно;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиАналоги(Номенклатура)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
	Запрос.Текст = "ВЫБРАТЬ
	               |	Материал.Период КАК Период,
	               |	Материал.Регистратор КАК Регистратор,
	               |	Материал.Номенклатура КАК НоменклатураМатериал,
	               |	Материал.Характеристика КАК ХарактеристикаМатериал,
	               |	Аналоги.Номенклатура КАК НоменклатураАналог,
	               |	Аналоги.Характеристика КАК ХарактеристикаАналог
	               |ИЗ
	               |	РегистрСведений.АналогиМатериалов.СрезПоследних(
	               |			&ТекущаяДата,
	               |			(ПериодЗавершения = ДАТАВРЕМЯ(1, 1, 1)
	               |				ИЛИ ПериодЗавершения >= &ТекущаяДата)
	               |				И РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Материал)
	               |				И Номенклатура = &Номенклатура) КАК Материал
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналогиМатериалов.СрезПоследних(
	               |				&ТекущаяДата,
	               |				(ПериодЗавершения = ДАТАВРЕМЯ(1, 1, 1)
	               |					ИЛИ ПериодЗавершения >= &ТекущаяДата)
	               |					И РольНоменклатуры = ЗНАЧЕНИЕ(Перечисление.РолиАналогов.Аналог)) КАК Аналоги
	               |		ПО (Аналоги.Регистратор = Материал.Регистратор)";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Возврат Результат.Выгрузить().ВыгрузитьКолонку("НоменклатураАналог");
КонецФункции

&НаКлиенте
Процедура ДеревоУкомплектованностьЗаказовНомерКартинкиНажатие(Элемент, СтандартнаяОбработка)
	ТД = Элементы.ДеревоУкомплектованностьЗаказов.ТекущиеДанные;
	Если ТД.НомерКартинки <> 0 Тогда

&НаСервере
Процедура ЗаписатьКомментарийВРегистр(Строка)
	Набор = РегистрыСведений.юум_КомментарийПотребностьЗаказа.СоздатьНаборЗаписей();
	Набор.Отбор.Номенклатура.Установить(Строка.Номенклатура);
	Набор.Отбор.Характеристика.Установить(Строка.Характеристика);
	Набор.Отбор.Склад.Установить(Строка.Склад);
	Набор.Отбор.Назначение.Установить(Строка.Назначение);
	Набор.Отбор.ЗаказНаПроизводство.Установить(Строка.ЗаказНаПроизводство);
	Набор.Отбор.Период.Установить(НачалоДня(ТекущаяДатаСеанса()));
	
	Запись = Набор.Добавить();
	Запись.Номенклатура = Строка.Номенклатура;
	Запись.Характеристика = Строка.Характеристика;
	Запись.Склад = Строка.Склад;
	Запись.Назначение = Строка.Назначение;
	Запись.ЗаказНаПроизводство = Строка.ЗаказНаПроизводство;
	Запись.Период = НачалоДня(ТекущаяДатаСеанса());

	Запись.Комментарий = Строка.Комментарий;
	Запись.Автор = ПараметрыСеанса.ТекущийПользователь;
	
	Набор.Записать();
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКомментарийНаСервере()
	Строки1уровня = ДеревоУкомплектованностьЗаказов.ПолучитьЭлементы();
	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			Если Не Строка2Уровня.Отметка Тогда
				Продолжить;
			КонецЕсли;
			ЗаписатьКомментарийВРегистр(Строка2уровня);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьКомментарий(Команда)
	ЗаписатьКомментарийНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ТЗВидимостьКолонок = Настройки.Получить("ВидимостьКолонок");
	Если ТЗВидимостьКолонок = Неопределено Тогда
		ВидимостьКолонок.Очистить();
		
		нс = ВидимостьКолонок.Добавить();
		нс.Имя = "Вес";
		нс.Видимость = Истина;
		
		нс = ВидимостьКолонок.Добавить();
		нс.Имя = "Покрытие";
		нс.Видимость = Истина;
		
		нс = ВидимостьКолонок.Добавить();
		нс.Имя = "Заказано";
		нс.Видимость = Истина;
	Иначе
		ВидимостьКолонок.Загрузить(ТЗВидимостьКолонок);
	КонецЕсли;
	
КонецПроцедуры


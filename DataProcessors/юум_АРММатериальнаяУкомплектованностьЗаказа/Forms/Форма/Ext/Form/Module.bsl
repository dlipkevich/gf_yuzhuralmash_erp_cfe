&НаСервере
Функция НайтиСтрокиПоСтруктуреЗаказа(Строка, СтруктураПоиска = Неопределено)
	Если СтруктураПоиска = Неопределено Тогда
		СтруктураПоиска = Новый Структура();
		СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
		СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
		СтруктураПоиска.Вставить("ЗаказНаПроизводство", Строка.ЗаказНаПроизводство);
		СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
		СтруктураПоиска.Вставить("Склад", Строка.Склад);
		СтруктураПоиска.Вставить("ВидСтроки", Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление);
	КонецЕсли;
	НайденныеСтроки = СтруктураЗаказаПотребление.НайтиСтроки(СтруктураПоиска);
	Возврат НайденныеСтроки;
КонецФункции

&НаСервере
Функция ПолуфабрикатВСтроке(Строка)
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
	СтруктураПоиска.Вставить("ЗаказНаПроизводство", Строка.ЗаказНаПроизводство);
	СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
	СтруктураПоиска.Вставить("Склад", Строка.Склад);
	НайденныеСтроки = Полуфабрикаты.НайтиСтроки(СтруктураПоиска);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ДобавитьСтрокиПоСтруктуреЗаказа(ДеревоИерархии)
	Для Каждого СтрокаДерева Из ДеревоИерархии.Строки Цикл
		Для Каждого Строка Из СтрокаДерева.Строки Цикл
			Строка.Уровень = 2;
			ВесДетали = 0;
			ВесДеталиЧерный = 0;
			ВесПотребностиОбщий = 0;
			Запланировано = 0;
			Если ПолуфабрикатВСтроке(Строка) Тогда
				Строка.флПолуфабрикат = Истина;
				// ============
				// Полуфабрикат
				// ============
				СтруктураПоиска = Новый Структура();
				СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
				СтруктураПоиска.Вставить("ЗаказНаПроизводство", Строка.ЗаказНаПроизводство);
				СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
				СтруктураПоиска.Вставить("ВидСтроки", Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката);
				НайденныеСтроки = НайтиСтрокиПоСтруктуреЗаказа(Строка, СтруктураПоиска);
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					ВесДетали = ВесДетали + НайденнаяСтрока.ВесДетали;
					ВесДеталиЧерный = ВесДеталиЧерный + НайденнаяСтрока.ВесДеталиЧерный;
					ВесПотребностиОбщий = ВесПотребностиОбщий + НайденнаяСтрока.Запланировано * НайденнаяСтрока.ВесДеталиЧерный;
					Запланировано = Запланировано + НайденнаяСтрока.Запланировано;
				КонецЦикла;
				Строка.ВесДетали = ВесДетали;
				Строка.ВесДеталиЧерный = ВесДеталиЧерный;
				Строка.ВесПотребностиОбщий = ВесПотребностиОбщий;
				Строка.КоличествоДеталейНаЗаказ = Запланировано;
				Продолжить;
			КонецЕсли;
			
			// ===============
			// НЕ Полуфабрикат
			// ===============
			НайденныеСтроки = НайтиСтрокиПоСтруктуреЗаказа(Строка);
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				НоваяСтрока = Строка.Строки.Добавить();
				НоваяСтрока.Уровень = 3;
				НоваяСтрока.Номенклатура = НайденнаяСтрока.ОсновноеИзделиеНоменклатура;
				НоваяСтрока.Характеристика = НайденнаяСтрока.ОсновноеИзделиеХарактеристика;
				НоваяСтрока.Требуется = НайденнаяСтрока.КОбеспечению;
				НоваяСтрока.План = НайденнаяСтрока.План;
				НоваяСтрока.ВесДетали = НайденнаяСтрока.ВесДетали;
				НоваяСтрока.ВесДеталиЧерный = НайденнаяСтрока.ВесДеталиЧерный;
				НоваяСтрока.ВесПотребностиОбщий = НайденнаяСтрока.ВесПотребностиОбщий;
				НоваяСтрока.НомерКартинки = -1;
				НоваяСтрока.Спецификация = НайденнаяСтрока.Спецификация;
				// Количество деталей на заказ
				СтруктураПоиска = Новый Структура();
				СтруктураПоиска.Вставить("Номенклатура", НоваяСтрока.Номенклатура);
				СтруктураПоиска.Вставить("Характеристика", НоваяСтрока.Характеристика);
				СтруктураПоиска.Вставить("ЗаказНаПроизводство", Строка.ЗаказНаПроизводство);
				СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
				СтруктураПоиска.Вставить("ВидСтроки", Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката);
				Строки = НайтиСтрокиПоСтруктуреЗаказа(Строка, СтруктураПоиска);
				Если Строки.Количество() > 0 Тогда
					// Вес детали для 2 уровня = Сумма произведений из строк 3 уровня:
					// Кол-во дет. на заказ * Вес числитель при условии Вид строки = Производство полуфабриката.
					ВесДетали = ВесДетали + Строки[0].Запланировано * НайденнаяСтрока.ВесДетали;
					// Вес детали черный для 2 уровня = Сумма произведений из строк 3 уровня:
					// Кол-во дет. на заказ * Вес черный спецификации при условии Вид строки = Производство полуфабриката.			
					ВесДеталиЧерный = ВесДеталиЧерный + Строки[0].Запланировано * НайденнаяСтрока.ВесДеталиЧерный;
					// Вес потребности общий для 2 уровня = Сумма произведений из строк 3 уровня:
					// Кол-во дет. на заказ * Вес потребности общий при условии Вид строки = Производство полуфабриката.
					ВесПотребностиОбщий = ВесПотребностиОбщий + Строки[0].Запланировано * НайденнаяСтрока.ВесПотребностиОбщий;
				Иначе
					СтруктураПоиска.Вставить("ВидСтроки", Перечисления.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции);
					Строки = НайтиСтрокиПоСтруктуреЗаказа(Строка, СтруктураПоиска);
				КонецЕсли;
				Если Строки.Количество() > 0 Тогда
					НоваяСтрока.КоличествоДеталейНаЗаказ = Строки[0].Запланировано;
				КонецЕсли;
			КонецЦикла;
			Строка.ВесДетали = ВесДетали;
			Строка.ВесДеталиЧерный = ВесДеталиЧерный;
			Строка.ВесПотребностиОбщий = ВесПотребностиОбщий;
			
			// Свободный остаток на всех складах без назначения
			Строка.СвободныйОстатокНаВсехСкладахБезНазначения = СвободныйОстатокНаВсехСкладахБезНазначения(Строка);
			
			// К закупке кол-во
			Строка.КЗакупкеКоличество = Строка.ПокрытиеДефицит - Строка.Заказано;
			Если Строка.КЗакупкеКоличество < 0 Тогда
				Строка.КЗакупкеКоличество = 0;
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ДатаПоставкиПоставщикДоговор(Строка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Строка.ЗаказНаПоступление);
	Запрос.УстановитьПараметр("Номенклатура", Строка.Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", Строка.Характеристика);
	Запрос.УстановитьПараметр("Назначение", Строка.Назначение);
	Запрос.УстановитьПараметр("Склад", Строка.Склад);
	Если ТипЗнч(Строка.ЗаказНаПоступление) = Тип("ДокументСсылка.ЗаявкаНаЗакупку") Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ВЫБОР
		               |		КОГДА ЗаявкаНаЗакупкуТовары.Ссылка.ПоступлениеОднойДатой
		               |			ТОГДА ЗаявкаНаЗакупкуТовары.Ссылка.ЖелаемаяДатаПоступления
		               |		ИНАЧЕ ЗаявкаНаЗакупкуТовары.ЖелаемаяДатаПоступления
		               |	КОНЕЦ КАК ДатаПоставки,
		               |	ЗаявкаНаЗакупкуТовары.Контрагент КАК Поставщик,
		               |	ЗаявкаНаЗакупкуТовары.Договор КАК Договор
		               |ИЗ
		               |	Документ.ЗаявкаНаЗакупку.Товары КАК ЗаявкаНаЗакупкуТовары
		               |ГДЕ
		               |	ЗаявкаНаЗакупкуТовары.Ссылка = &Ссылка
		               |	И ЗаявкаНаЗакупкуТовары.Номенклатура = &Номенклатура
		               |	И ЗаявкаНаЗакупкуТовары.Характеристика = &Характеристика
		               |	И ЗаявкаНаЗакупкуТовары.Назначение = &Назначение
		               |	И ЗаявкаНаЗакупкуТовары.Склад = &Склад";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ВЫБОР
		               |		КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой
		               |			ТОГДА ЗаказПоставщикуТовары.Ссылка.ЖелаемаяДатаПоступления
		               |		ИНАЧЕ ЗаказПоставщикуТовары.ДатаПоступления
		               |	КОНЕЦ КАК ДатаПоставки,
		               |	ЗаказПоставщикуТовары.Ссылка.Контрагент КАК Поставщик,
		               |	ЗаказПоставщикуТовары.Ссылка.Договор КАК Договор
		               |ИЗ
		               |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		               |ГДЕ
		               |	ЗаказПоставщикуТовары.Ссылка = &Ссылка
		               |	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
		               |	И ЗаказПоставщикуТовары.Характеристика = &Характеристика
		               |	И ЗаказПоставщикуТовары.Назначение = &Назначение
		               |	И ЗаказПоставщикуТовары.Склад = &Склад";
	КонецЕсли;
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьВсегоПоСтрокамПокрытиеОбеспечено(СтрокиУкомплектованности, Всего)
	ТЗУкомплектованностьЗаказов = УкомплектованностьЗаказов.Выгрузить();
	ТЗУкомплектованностьЗаказов.Очистить();
	ТЗУкомплектованностьЗаказов.Колонки.Добавить("ИндексМассива");
	ИндексМассива = 0;
	Для Каждого СтрокаУкомплектованности Из СтрокиУкомплектованности Цикл
		СтрокаТЗ = ТЗУкомплектованностьЗаказов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаУкомплектованности);
		СтрокаТЗ.ИндексМассива = ИндексМассива;
		ИндексМассива = ИндексМассива + 1;
	КонецЦикла;
	ТЗУкомплектованностьЗаказов.Сортировать("ДатаПотребности ВОЗР, Очередь ВОЗР");
	ВсегоСтрок = ТЗУкомплектованностьЗаказов.Количество();
	НомерСтрокиТЗ = 0;
	Для Каждого СтрокаТЗ Из ТЗУкомплектованностьЗаказов Цикл
		НомерСтрокиТЗ = НомерСтрокиТЗ + 1;
		СтрокаТЗ.ПокрытиеОбеспечено = Всего;
		Если НомерСтрокиТЗ = ВсегоСтрок Тогда
			// это последняя строка ТЗ
		Иначе
			// это НЕ последняя строка ТЗ
			Если СтрокаТЗ.ПокрытиеОбеспечено > СтрокаТЗ.Требуется Тогда
				СтрокаТЗ.ПокрытиеОбеспечено = СтрокаТЗ.Требуется;
			КонецЕсли;
			Всего = Всего - СтрокаТЗ.ПокрытиеОбеспечено;
		КонецЕсли;
		
		СтрокаУкомплектованности = СтрокиУкомплектованности[СтрокаТЗ.ИндексМассива];
		СтрокаУкомплектованности.ПокрытиеОбеспечено = СтрокаТЗ.ПокрытиеОбеспечено;
		СтрокаУкомплектованности.ПокрытиеОбеспеченоРаспределено = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПокрытиеОбеспечено(Строка)
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
	СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
	НайденныеСтроки = ОстаткиИДоступностьТоваров.НайтиСтроки(СтруктураПоиска);
	Всего = 0;
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Всего = Всего + НайденнаяСтрока.ВНаличии;
	КонецЦикла;
	// распределение Всего по строкам с учетом Даты потребности и Очереди заказа на производство
	СтрокиУкомплектованности = УкомплектованностьЗаказов.НайтиСтроки(СтруктураПоиска);
	РаспределитьВсегоПоСтрокамПокрытиеОбеспечено(СтрокиУкомплектованности, Всего);
	Возврат Всего;
КонецФункции

&НаСервере
Процедура РаспределитьВсегоПоСтрокамОбеспеченоНаСкладеПотребности(СтрокиУкомплектованности, Всего)
	ТЗУкомплектованностьЗаказов = УкомплектованностьЗаказов.Выгрузить();
	ТЗУкомплектованностьЗаказов.Очистить();
	ТЗУкомплектованностьЗаказов.Колонки.Добавить("ИндексМассива");
	ИндексМассива = 0;
	Для Каждого СтрокаУкомплектованности Из СтрокиУкомплектованности Цикл
		СтрокаТЗ = ТЗУкомплектованностьЗаказов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, СтрокаУкомплектованности);
		СтрокаТЗ.ИндексМассива = ИндексМассива;
		ИндексМассива = ИндексМассива + 1;
	КонецЦикла;
	ТЗУкомплектованностьЗаказов.Сортировать("ДатаПотребности ВОЗР, Очередь ВОЗР");
	ВсегоСтрок = ТЗУкомплектованностьЗаказов.Количество();
	НомерСтрокиТЗ = 0;
	Для Каждого СтрокаТЗ Из ТЗУкомплектованностьЗаказов Цикл
		НомерСтрокиТЗ = НомерСтрокиТЗ + 1;
		СтрокаТЗ.ОбеспеченоНаСкладеПотребности = Всего;
		Если НомерСтрокиТЗ = ВсегоСтрок Тогда
			// это последняя строка ТЗ
		Иначе
			// это НЕ последняя строка ТЗ
			Если СтрокаТЗ.ОбеспеченоНаСкладеПотребности > СтрокаТЗ.Требуется Тогда
				СтрокаТЗ.ОбеспеченоНаСкладеПотребности = СтрокаТЗ.Требуется;
			КонецЕсли;
			Всего = Всего - СтрокаТЗ.ОбеспеченоНаСкладеПотребности;
		КонецЕсли;
		
		СтрокаУкомплектованности = СтрокиУкомплектованности[СтрокаТЗ.ИндексМассива];
		СтрокаУкомплектованности.ОбеспеченоНаСкладеПотребности = СтрокаТЗ.ОбеспеченоНаСкладеПотребности;
		СтрокаУкомплектованности.ОбеспеченоНаСкладеПотребностиРаспределено = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОбеспеченоНаСкладеПотребности(Строка)
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("Номенклатура", Строка.Номенклатура);
	СтруктураПоиска.Вставить("Характеристика", Строка.Характеристика);
	СтруктураПоиска.Вставить("Назначение", Строка.Назначение);
	СтруктураПоиска.Вставить("Склад", Строка.Склад);
	НайденныеСтроки = ОстаткиИДоступностьТоваров.НайтиСтроки(СтруктураПоиска);
	Всего = 0;
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Всего = Всего + НайденнаяСтрока.ВНаличии;
	КонецЦикла;
	// распределение Всего по строкам с учетом Даты потребности и Очереди заказа на производство
	СтрокиУкомплектованности = УкомплектованностьЗаказов.НайтиСтроки(СтруктураПоиска);
	РаспределитьВсегоПоСтрокамОбеспеченоНаСкладеПотребности(СтрокиУкомплектованности, Всего);
	Возврат Всего;
КонецФункции

&НаСервере
Процедура РаспределитьОстаткиВЗапросе(ТаблицаИзмерений)
	ТаблицаИзмерений.Сортировать("ДатаПотребности ВОЗР, Очередь ВОЗР");
	// заполняем НомерСтроки чтобы понять что строка является последней в "группе"
	НомерСтроки = 0;
	Для Каждого СтрокаТЗ Из ТаблицаИзмерений Цикл
		НомерСтроки = НомерСтроки + 1;
		СтрокаТЗ.НомерСтроки = НомерСтроки;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Потребности", ТаблицаИзмерений);
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.НомерСтроки КАК НомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад,
	               |	т.Требуется КАК Требуется
	               |ПОМЕСТИТЬ втПотребности
	               |ИЗ
	               |	&Потребности КАК т";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втПотребности")
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(т.НомерСтроки) КАК НомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад
	               |ПОМЕСТИТЬ втМаксимальныйНомерСтроки
	               |ИЗ
	               |	втПотребности КАК т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Номенклатура,
	               |	т.Характеристика,
	               |	т.Назначение,
	               |	т.Склад";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втМаксимальныйНомерСтроки")
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.НомерСтроки КАК НомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад,
	               |	т.Требуется КАК Требуется,
	               |	СУММА(ЕСТЬNULL(т2.Требуется, 0)) КАК ТребуетсяНакопленная
	               |ПОМЕСТИТЬ втПотребностиСНакоплением
	               |ИЗ
	               |	втПотребности КАК т
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втПотребности КАК т2
	               |		ПО (т.Номенклатура = т2.Номенклатура)
	               |			И (т.Характеристика = т2.Характеристика)
	               |			И (т.Назначение = т2.Назначение)
	               |			И (т.Склад = т2.Склад)
	               |			И т.НомерСтроки > т2.НомерСтроки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.НомерСтроки,
	               |	т.Характеристика,
	               |	т.Номенклатура,
	               |	т.Назначение,
	               |	т.Склад,
	               |	т.Требуется";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втПотребностиСНакоплением")
	
	ТЗОстаткиИДоступностьТоваров = РеквизитФормыВЗначение("ОстаткиИДоступностьТоваров");
	Запрос.УстановитьПараметр("Остатки", ТЗОстаткиИДоступностьТоваров);
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад,
	               |	т.ВНаличии КАК ВНаличии
	               |ПОМЕСТИТЬ втОстаткиДетали
	               |ИЗ
	               |	&Остатки КАК т
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад,
	               |	СУММА(т.ВНаличии) КАК ВНаличии
	               |ПОМЕСТИТЬ втОстатки
	               |ИЗ
	               |	втОстаткиДетали КАК т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	т.Назначение,
	               |	т.Номенклатура,
	               |	т.Характеристика,
	               |	т.Склад";
	Запрос.Выполнить();
	// пример вызова: _омОтладка.ПолучитьСодержимоеВременнойТаблицы(Запрос, "втОстатки")
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.НомерСтроки КАК НомерСтроки,
	               |	втМаксимальныйНомерСтроки.НомерСтроки КАК МаксимальныйНомерСтроки,
	               |	т.Номенклатура КАК Номенклатура,
	               |	т.Характеристика КАК Характеристика,
	               |	т.Назначение КАК Назначение,
	               |	т.Склад КАК Склад,
	               |	ВЫБОР
	               |		КОГДА т.НомерСтроки < втМаксимальныйНомерСтроки.НомерСтроки
	               |			ТОГДА ВЫБОР
	               |					КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная < 0
	               |						ТОГДА 0
	               |					КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная > т.Требуется
	               |						ТОГДА т.Требуется
	               |					ИНАЧЕ ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная
	               |				КОНЕЦ
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная < 0
	               |					ТОГДА 0
	               |				ИНАЧЕ ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ОбеспеченоНаСкладеПотребности,
	               |	ЕСТЬNULL(Остатки.ВНаличии, 0) - т.ТребуетсяНакопленная КАК ВНаличии_ТребуетсяНакопленная,
	               |	т.Требуется КАК Требуется,
	               |	т.ТребуетсяНакопленная КАК ТребуетсяНакопленная,
	               |	ЕСТЬNULL(Остатки.ВНаличии, 0) КАК ВНаличии
	               |ИЗ
	               |	втПотребностиСНакоплением КАК т
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втОстатки КАК Остатки
	               |		ПО т.Номенклатура = Остатки.Номенклатура
	               |			И т.Характеристика = Остатки.Характеристика
	               |			И т.Назначение = Остатки.Назначение
	               |			И т.Склад = Остатки.Склад
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втМаксимальныйНомерСтроки КАК втМаксимальныйНомерСтроки
	               |		ПО т.Номенклатура = втМаксимальныйНомерСтроки.Номенклатура
	               |			И т.Характеристика = втМаксимальныйНомерСтроки.Характеристика
	               |			И т.Назначение = втМаксимальныйНомерСтроки.Назначение
	               |			И т.Склад = втМаксимальныйНомерСтроки.Склад";
	Результат = Запрос.Выполнить();
	ТЗ = Результат.Выгрузить();
	Для Каждого СтрокаТЗ Из ТЗ Цикл
		СтрокаПотребности = ТаблицаИзмерений.Найти(СтрокаТЗ.НомерСтроки, "НомерСтроки");
		Если СтрокаПотребности <> Неопределено Тогда
			СтрокаПотребности.ОбеспеченоНаСкладеПотребности = СтрокаТЗ.ОбеспеченоНаСкладеПотребности;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура РаспределитьПокрытиеОбеспечено(ТаблицаИзмерений)
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Потребности", ТаблицаИзмерений);
	Запрос.Текст = "ВЫБРАТЬ

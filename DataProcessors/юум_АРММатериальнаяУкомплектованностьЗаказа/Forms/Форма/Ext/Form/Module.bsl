	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ПоНоменклатуреКонтекст");
	ПараметрыФормы.Вставить("Неконтекстный", Ложь);
	ПараметрыФормы.Вставить("ПараметрКоманды", НайтиАналоги(ТД.Номенклатура));
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	
	ОткрытьФорму("Отчет.ОстаткиИДоступностьТоваров.Форма", ПараметрыФормы, ЭтотОбъект, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетОстаткиИДоступностьТоваровАналоги(Команда)
	

	Для Каждого Строка1уровня Из Строки1уровня Цикл
		Строки2Уровня = Строка1уровня.ПолучитьЭлементы();
		Для Каждого Строка2уровня Из Строки2уровня Цикл
			СтрокаДерева = ДеревоЗначений.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка2уровня);
			Строки3Уровня = Строка2уровня.ПолучитьЭлементы();
			Для Каждого Строка3уровня Из Строки3уровня Цикл
				СтрокаДерева = ДеревоЗначений.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка3уровня);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(ДеревоЗначений, "ДеревоУкомплектованностьЗаказов");
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппировкаПоСкладу(Команда)
	
	Если Элементы.ДеревоУкомплектованностьЗаказовГруппировкаПоСкладу.Пометка Тогда
		// здесь надо показать дерево в виде "списка"
		ГруппировкаПоСкладуНаСервере();
	Иначе
		ЗаполнитьПотребность(Неопределено);
	КонецЕсли;
	
	Элементы.ДеревоУкомплектованностьЗаказовГруппировкаПоСкладу.Пометка = Не Элементы.ДеревоУкомплектованностьЗаказовГруппировкаПоСкладу.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетВедомостьПоТоварамНаСкладахПоОтметкам(Команда)
	
	СписокНоменклатуры = ПолучитьСписокНоменкладуры();
	Если СписокНоменклатуры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "ВедомостьПоТоварамНаСкладах");
	ПараметрыФормы.Вставить("Неконтекстный", Истина); // Ложь
	ДополнительныеПараметры = Новый Структура("ИмяКоманды", "ДвиженияТовара");
	ОписаниеКоманды = Новый Структура("ДополнительныеПараметры", ДополнительныеПараметры);
	ПараметрыФормы.Вставить("ОписаниеКоманды", ОписаниеКоманды);
	ПараметрыФормы.Вставить("ПараметрКоманды", СписокНоменклатуры);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	
	ОткрытьФорму("Отчет.ВедомостьПоТоварамНаСкладах.Форма", ПараметрыФормы, ЭтотОбъект, Истина);
	
КонецПроцедуры

&НаСервере
Функция СформироватьОтчетПотребностьЗОЗ(СтруктураПоиска)
	
	ТЗПотребностьЗОЗ = РеквизитФормыВЗначение("ПотребностьЗОЗ");
	МассивСтрок = ТЗПотребностьЗОЗ.НайтиСтроки(СтруктураПоиска);

	Протокол = Новый ТабличныйДокумент;
	Протокол.АвтоМасштаб = Истина;
	Протокол.ОтображатьСетку = Ложь;
	Протокол.ОтображатьЗаголовки = Ложь;
	Протокол.ТолькоПросмотр = Истина;
	Протокол.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("МакетПотребностьЗОЗ");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапка.Параметры.Номенклатура = СтруктураПоиска.Номенклатура;
	Протокол.Вывести(ОбластьШапка);
	
	Для Каждого Строка Из МассивСтрок Цикл
		
		ОбластьСтрока.Параметры.ДокументСсылка = Строка.ЗаявкаНаЗакупку;
		ОбластьСтрока.Параметры.Количество = Строка.ЗОЗКоличество;
		ОбластьСтрока.Параметры.КоличествоУпаковок = Строка.ЗОЗКоличествоУпаковок;
		
		Протокол.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Возврат Протокол;
	
КонецФункции

&НаКлиенте
Процедура ДеревоУкомплектованностьЗаказовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "ДеревоУкомплектованностьЗаказовПотребностьЗОЗ" Тогда
		СтандартнаяОбработка = Ложь;
		ТД = Элементы.ДеревоУкомплектованностьЗаказов.ТекущиеДанные;
		Если ТД = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ТД.ПотребностьЗОЗ) Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("Номенклатура, Характеристика, Назначение, Склад");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ТД);
	
		ТабДок = СформироватьОтчетПотребностьЗОЗ(СтруктураПоиска);
		ТабДок.Показать("Потребность ЗОЗ по Заявкам");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

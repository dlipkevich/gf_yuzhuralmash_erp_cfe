&НаСервере
Функция СоздатьКорректировкаНазначенияНаСервере()
	
	ТЗНоменклатураКорректировкаНазначения = РеквизитФормыВЗначение("НоменклатураКорректировкаНазначения");
	ТЗНоменклатураКорректировкаНазначения.Свернуть("Номенклатура, Характеристика, Назначение, ЗаказНаПроизводство, Организация");
	Для Каждого СтрокаТЗ Из ТЗНоменклатураКорректировкаНазначения Цикл
		СтрокаТЗ.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЗ.ЗаказНаПроизводство, "Организация");
	КонецЦикла;
	ЗначениеВРеквизитФормы(ТЗНоменклатураКорректировкаНазначения, "НоменклатураКорректировкаНазначения");
	
	ТЗОрганизации = ТЗНоменклатураКорректировкаНазначения.Скопировать();
	ТЗОрганизации.Свернуть("Организация");
	
	КорректировкиНазначения.Очистить();
	
	Для Каждого СтрокаОрганизация Из ТЗОрганизации Цикл
		НовыйДокумент = СоздатьКорректировкуНазначенияПоОрганизации(СтрокаОрганизация.Организация);
		Если ЗначениеЗаполнено(НовыйДокумент) Тогда
			КорректировкиНазначения.Добавить(НовыйДокумент);
		КонецЕсли;
	КонецЦикла;
	
	Протокол = Новый ТабличныйДокумент;
	Протокол.АвтоМасштаб = Истина;
	Протокол.ОтображатьСетку = Ложь;
	Протокол.ОтображатьЗаголовки = Ложь;
	Протокол.ТолькоПросмотр = Истина;
	Протокол.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("МакетНовыеДокументы");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	ОбластьШапка.Параметры.ТекущаяДата = ТекущаяДатаСеанса();
	ОбластьШапка.Параметры.ТипДокумента = "Корректировка назначения";
	Протокол.Вывести(ОбластьШапка);
	
	Для Каждого Строка Из КорректировкиНазначения Цикл
		
		ОбластьСтрока.Параметры.ДокументСсылка = Строка.Значение;
		
		Протокол.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Возврат Протокол;
	
КонецФункции


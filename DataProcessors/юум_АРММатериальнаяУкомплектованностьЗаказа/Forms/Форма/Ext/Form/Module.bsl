КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуУкомплектованностьЗаказов()
	
	ОтчетОбъект = Отчеты.УкомплектованностьЗаказов.Создать();
	
	УкомплектованностьЗаказовНастроитьПараметрыОтборы(ОтчетОбъект);
	
	СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("СхемаКомпоновкиДанных");
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Найти("НаборДанных");
	
	ТекстЗапроса = НаборДанных.Запрос;
	
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	
	НаборДанных.Запрос = ТекстЗапроса;
	
	НастройкиОтчета = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	
	НастройкиОтчета.Структура.Очистить();
	
	// Добавим в отчет детальные записи, вложенные в группировку.
	ДетальныеЗаписи = НастройкиОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	// Укажем, что поля, которые нужно выводить в детальных записях, система должна определять самостоятельно.
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ЗаказНаПроизводство");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ДатаПотребности");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Номенклатура");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Номенклатура.ЕдиницаИзмерения");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Характеристика");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Назначение");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Склад");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Требуется");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ВНаличии");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Заказано");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ЗаказНаПоступление");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ДатаПоступления");
	ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Этап");
	
	ДанныеРасшифровки = Неопределено;
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
		
	ВнешниеНаборыДанных = Неопределено;
	// Создадим и инициализируем процессор компоновки.
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаОтчета);
		
	// Обозначим начало вывода
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	МассивУдалитьСтроки = ТаблицаОтчета.НайтиСтроки(Новый Структура("Номенклатура", Неопределено));
	Для Каждого УдалитьСтроку Из МассивУдалитьСтроки Цикл
		ТаблицаОтчета.Удалить(УдалитьСтроку);
	КонецЦикла;
	
	УкомплектованностьЗаказовДетальныеЗаписи.Загрузить(ТаблицаОтчета);
	
	// сворачивание строк
	КолонкиГруппировок = "ЗаказНаПроизводство, ДатаПотребности, Номенклатура, НоменклатураЕдиницаИзмерения, Характеристика, Назначение, Склад";
	КолонкиСуммирования = "Требуется, ВНаличии, Заказано";
	ТаблицаИзмерений = ТаблицаОтчета.Скопировать();
	ТаблицаИзмерений.Свернуть(КолонкиГруппировок, КолонкиСуммирования);

	ТаблицаИзмерений.Колонки.Добавить("флНоменклатураПоТребованию", Новый ОписаниеТипов("Булево"));
	Если ВключатьМатериалыПоТребованию Тогда
		ВключитьМатериалыПоТребованию(ТаблицаИзмерений);
	КонецЕсли;
	
	ТаблицаИзмерений.Колонки.Добавить("Отметка", Новый ОписаниеТипов("Булево"));
	ТаблицаИзмерений.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ТаблицаИзмерений.Колонки.Добавить("ВесДетали", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ВесДеталиЧерный", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ВесПотребностиОбщий", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("КоличествоДеталейНаЗаказ", Новый ОписаниеТипов("Число"));
	
	ТаблицаИзмерений.Колонки.Добавить("ЗаказНаПоступление",
		Новый ОписаниеТипов("ДокументСсылка.ЗаказПоставщику, ДокументСсылка.ЗаявкаНаЗакупку"));
	ТаблицаИзмерений.Колонки.Добавить("ДатаПоставки", Новый ОписаниеТипов("Дата"));
	ТаблицаИзмерений.Колонки.Добавить("КЗакупкеКоличество", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ЕдиницаИзмеренияЗакупки", Новый ОписаниеТипов("СправочникСсылка.УпаковкиЕдиницыИзмерения"));
	ТаблицаИзмерений.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаИзмерений.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));

	ТаблицаИзмерений.Колонки.Добавить("ЗаказаноПоЗаявкеНаЗакупку", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ЗаказаноПоЗаказуПоставщику", Новый ОписаниеТипов("Число"));
	
	ТаблицаИзмерений.Колонки.Добавить("Очередь", Новый ОписаниеТипов("Число"));

	ТаблицаИзмерений.Колонки.Добавить("ПотребностьЗОЗ", Новый ОписаниеТипов("Число"));
	ЗаполнитьПотребностьЗОЗ(ТаблицаИзмерений);
	
	СтруктураПоиска = Новый Структура("ЗаказНаПроизводство, ДатаПотребности, Номенклатура, Характеристика, Назначение, Склад");
	Для Каждого СтрокаТЗ Из ТаблицаИзмерений Цикл
		СтрокаТЗ.Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЗ.Склад, "Подразделение");
		
		ЗаказаноПоЗаявкеНаЗакупку = 0;
		ЗаказаноПоЗаказуПоставщику = 0;
		
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, СтрокаТЗ);
		МассивСтрок = ТаблицаОтчета.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из МассивСтрок Цикл
			Если ЗначениеЗаполнено(НайденнаяСтрока.ЗаказНаПоступление) Тогда
				СтрокаТЗ.ЗаказНаПоступление = НайденнаяСтрока.ЗаказНаПоступление;
				СтрокаТЗ.ДатаПоставки = НайденнаяСтрока.ДатаПоступления;
				
				Если ТипЗнч(НайденнаяСтрока.ЗаказНаПоступление) = Тип("ДокументСсылка.ЗаявкаНаЗакупку") Тогда
					ЗаказаноПоЗаявкеНаЗакупку = ЗаказаноПоЗаявкеНаЗакупку + НайденнаяСтрока.Заказано;
				ИначеЕсли ТипЗнч(НайденнаяСтрока.ЗаказНаПоступление) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
					ЗаказаноПоЗаказуПоставщику = ЗаказаноПоЗаказуПоставщику + НайденнаяСтрока.Заказано;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		СтрокаТЗ.ЗаказаноПоЗаявкеНаЗакупку = ЗаказаноПоЗаявкеНаЗакупку;
		СтрокаТЗ.ЗаказаноПоЗаказуПоставщику = ЗаказаноПоЗаказуПоставщику;
		
		Если ЗначениеЗаполнено(СтрокаТЗ.ЗаказНаПроизводство) Тогда
			СтрокаТЗ.Очередь = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЗ.ЗаказНаПроизводство, "Очередь");
		Иначе
			СтрокаТЗ.Очередь = 999999999999999;
		КонецЕсли;
		
	КонецЦикла;		
		
	ТаблицаИзмерений.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ОбеспеченоНаСкладеПотребности", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ПокрытиеОбеспечено", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ПокрытиеПроцент", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ПокрытиеДефицит", Новый ОписаниеТипов("Число"));
	ТаблицаИзмерений.Колонки.Добавить("ПокрытиеИзбыток", Новый ОписаниеТипов("Число"));
	
	РаспределитьОстаткиВЗапросе(ТаблицаИзмерений);
	
	РаспределитьПокрытиеОбеспечено(ТаблицаИзмерений);
	
	ТаблицаИзмерений.Сортировать("Склад, Номенклатура, Характеристика, Назначение, ДатаПотребности ВОЗР, Очередь ВОЗР");

	УкомплектованностьЗаказов.Загрузить(ТаблицаИзмерений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуТрудоемкостьЗаказов()
	
	ОтчетОбъект = Отчеты.ТрудоемкостьЗаказаНаПроизводство.Создать();
	
	СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	
	НастройкиОтчета = СхемаКомпоновкиДанных.ВариантыНастроек.ТрудоемкостьПоЗаказу.Настройки;
	
	ТрудоемкостьПоЗаказуНастроитьПараметрыОтборы(НастройкиОтчета);

// Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	ПлановыеСроки = СхемаКомпоновкиДанных.НаборыДанных.Найти("ПлановыеСроки");
	
	ТекстЗапроса = ПлановыеСроки.Запрос;
	
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	
	ПлановыеСроки.Запрос = ТекстЗапроса;
	
// КонецПроцедуры
	
	ДобавитьВыбранноеПоле(НастройкиОтчета, "ПартияПроизводства");
	
	НастройкиОтчета.Структура.Очистить();

	// Добавим в отчет детальные записи, вложенные в группировку.
	ДетальныеЗаписи = НастройкиОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	// Укажем, что поля, которые нужно выводить в детальных записях, система должна определять самостоятельно.
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	ДанныеРасшифровки = Неопределено;
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
		
	ВнешниеНаборыДанных = Неопределено;
	// Создадим и инициализируем процессор компоновки.
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаОтчета);
		
	// Обозначим начало вывода
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	// сворачивание строк
	КолонкиГруппировок = "ЗаказНаПроизводство, Изделие";
	КолонкиСуммирования = "План";
	ТаблицаИзмерений = ТаблицаОтчета.Скопировать();
	ТаблицаИзмерений.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ТрудоемкостьЗаказовНаПроизводство.Загрузить(ТаблицаИзмерений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОстаткиИДоступностьТоваров()
	
	ОтчетОбъект = Отчеты.ОстаткиИДоступностьТоваров.Создать();
	
	СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

	НастройкиОтчета = СхемаКомпоновкиДанных.ВариантыНастроек.ИспользоватьНазначенияБезЗаказа.Настройки;
	
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	ДанныеРасшифровки = Неопределено;

// Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПользовательскиеНастройкиМодифицированы = Ложь;
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСейчас");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'В наличии';
											|en = 'In stock'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСейчасКонтрольКачестваВыключен");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'В наличии';
											|en = 'In stock'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаСПодтвержденнымКачеством");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'С подтвержденным качеством';
											|en = 'With confirmed quality'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаНаКонтролеКачества");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'На контроле качества';
											|en = 'Under quality control'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаНеПодлежитРазблокировке");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Не подлежит разблокировке';
											|en = 'Not subject to unlocking'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаОжидается");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Ожидается';
											|en = 'Expected'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаОжидаетсяНеПодлежитРазблокировке");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Ожидается, не подлежит разблокировке';
											|en = 'Expected, not subject to unlocking'");
	
	ЗначениеПоиска = Новый ПараметрКомпоновкиДанных("СтрокаВсего");
	ЭлементПараметрыДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ЗначениеПоиска);
	ЭлементПараметрыДанных.Значение = НСтр("ru = 'Всего';
											|en = 'Total'");
	
	// УстановитьОбязательныеНастройки(ПользовательскиеНастройкиМодифицированы);
	
	// Вызов из самообслуживания.
	Если ОбщегоНазначенияУТКлиентСервер.АвторизованВнешнийПользователь() Тогда
		ПараметрВыводитьОтбор = КомпоновщикНастроек.Настройки.ПараметрыВывода.Элементы.Найти("ВыводитьОтбор");
		Если ПараметрВыводитьОтбор <> Неопределено Тогда
			ПараметрВыводитьОтбор.Использование = Истина;
			ПараметрВыводитьОтбор.Значение = ТипВыводаТекстаКомпоновкиДанных.НеВыводить;
		КонецЕсли;
	КонецЕсли;

	// Стандартная компоновка отчета.
	НастройкиОтчета = КомпоновщикНастроек.ПолучитьНастройки();
	
	ТекстЗапроса = СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос;
	
	ИменаТаблиц = ОбеспечениеВДокументахСервер.НовыеИменаТаблицДляРаспределенияЗапасов();
	ИменаТаблиц.Остатки = "ЗапасыИПотребностиОстатки"; // @query-part-1
	ИменаТаблиц.ОстаткиКонтролируемыхПартий = "ЗапасыИПотребностиОстаткиКонтролируемыхПартий"; // @query-part-1
	ИменаТаблиц.Результат = "ПодстановкаРасчетРезервов"; // @query-part-1
	
	ОбеспечениеВДокументахСервер.РаспределениеЗапасов(ТекстЗапроса, ИменаТаблиц);
	
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса, 
		"&ТекстЗапросаВесНоменклатуры", 
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаВесУпаковки("Таблица.Номенклатура.ЕдиницаИзмерения", "Таблица.Номенклатура"));
		
	ТекстЗапроса = СтрЗаменить(
		ТекстЗапроса, 
		"&ТекстЗапросаОбъемНоменклатуры", 
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаОбъемУпаковки("Таблица.Номенклатура.ЕдиницаИзмерения", "Таблица.Номенклатура"));

	// ++ НЕ УТКА
	УправлениеПроизводством.ПодстановкаАктуальногоРегистраГрафика(ТекстЗапроса);
	// -- НЕ УТКА
	
	СхемаКомпоновкиДанных.НаборыДанных.Основной.Запрос = ТекстЗапроса;
	
	// ++ ПоказатьОбособленныеТовары
	Для Каждого ЭлементПараметр Из НастройкиОтчета.ПараметрыДанных.Элементы Цикл
		Если ЭлементПараметр.Параметр = Новый ПараметрКомпоновкиДанных("ПоказатьОбособленныеТовары") Тогда
			ЭлементПараметр.Использование = Истина;
			ЭлементПараметр.Значение = Истина; // все Назначения
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлементОтбора Из КомпоновщикНастроекОбработка.Настройки.Отбор.Элементы Цикл
		Если Не ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Номенклатура")
			И Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Характеристика")
			И Не ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Назначение") Тогда
			// применяем отборы только по Номенклатуре / Характеристике / Назначению
			Продолжить;
		КонецЕсли;
		
		ЭО = КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(НастройкиОтчета,
			ЭлементОтбора.ЛевоеЗначение,
			ЭлементОтбора.ПравоеЗначение,
			ЭлементОтбора.ВидСравнения);
	КонецЦикла;
	// --

	НастройкиОтчета.Структура.Очистить();
	
	// Добавим в отчет детальные записи, вложенные в группировку.
	ДетальныеЗаписи = НастройкиОтчета.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	// Укажем, что поля, которые нужно выводить в детальных записях, система должна определять самостоятельно.
	ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Назначение");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Склад");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Номенклатура");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Характеристика");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Доступно");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "КОбеспечению");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Дефицит");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "Излишек");
    ДобавитьВыбранноеПоле(ДетальныеЗаписи, "ВНаличии");
	
	ДанныеРасшифровки = Неопределено;
	МакетКомпоновки = ЗарплатаКадрыОтчеты.МакетКомпоновкиДанныхДляКоллекцииЗначений(СхемаКомпоновкиДанных, НастройкиОтчета, ДанныеРасшифровки);
		
	ВнешниеНаборыДанных = Неопределено;
	// Создадим и инициализируем процессор компоновки.
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровки, Истина);
		
	ТаблицаОтчета = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаОтчета);
		
	// Обозначим начало вывода
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	// сворачивание строк
	КолонкиГруппировок = "Назначение, Склад, Номенклатура, Характеристика";
	КолонкиСуммирования = "Доступно, КОбеспечению, Дефицит, Излишек, ВНаличии";
	ТаблицаИзмерений = ТаблицаОтчета.Скопировать();
	ТаблицаИзмерений.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ОстаткиИДоступностьТоваров.Загрузить(ТаблицаИзмерений);
	
// КонецПроцедуры

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПотребностьЗаказов();
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СКД = ОбработкаОбъект.ПолучитьМакет("СКД");
	
	// Инициализация компоновщиков.
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
	НастройкиОтчета = СКД.ВариантыНастроек.ГруппировкаПоСкладу.Настройки;
	
	НастройкиКомпоновщика = КомпоновщикНастроекОбработка.ПолучитьНастройки();
	
	Для Каждого ОтборКомпоновщика Из НастройкиКомпоновщика.Отбор.Элементы Цикл
		Если Не ОтборКомпоновщика.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		флЭлементОтбораНайден = Ложь;
		Для Каждого ЭлементОтбора Из НастройкиОтчета.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ОтборКомпоновщика.ЛевоеЗначение Тогда
				флЭлементОтбораНайден = Истина;
				ЭлементОтбора.ПравоеЗначение = ОтборКомпоновщика.ПравоеЗначение;
				ЭлементОтбора.Использование = ОтборКомпоновщика.Использование;
				ЭлементОтбора.ВидСравнения = ОтборКомпоновщика.ВидСравнения;
			КонецЕсли;
		КонецЦикла;
		
		Если Не флЭлементОтбораНайден
			И ОтборКомпоновщика.Использование Тогда
			ЭлементОтбора = НастройкиОтчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = ОтборКомпоновщика.ЛевоеЗначение;
			ЭлементОтбора.ПравоеЗначение = ОтборКомпоновщика.ПравоеЗначение;
			ЭлементОтбора.Использование = ОтборКомпоновщика.Использование;
			ЭлементОтбора.ВидСравнения = ОтборКомпоновщика.ВидСравнения;
		КонецЕсли;
	КонецЦикла;
	
	// Период потребности
	Если ЗначениеЗаполнено(ПериодПотребности) Тогда
		ДопПараметры = Новый Структура("ЗаменятьСуществующий", Ложь);
//		*ВПользовательскиеНастройки - Булево - признак добавления в пользовательские настройки компоновки данных (по умолчанию: ложь).
//		*ЗаменятьСуществующий - Булево - признак полной замены существующего отбора по полю (по умолчанию: истина).
		
		КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(НастройкиОтчета,	"ДатаПотребности",
			ПериодПотребности.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Истина, ДопПараметры);
		КомпоновкаДанныхКлиентСервер.ДобавитьОтбор(НастройкиОтчета, "ДатаПотребности",
			КонецДня(ПериодПотребности.ДатаОкончания), ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, Истина, ДопПараметры);
	КонецЕсли;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтчета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки,,,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

	ТЗУкомплектованностьЗаказов = УкомплектованностьЗаказов.Выгрузить();
	ВнешниеНаборыДанных = Новый Структура("ТЗУкомплектованностьЗаказов", ТЗУкомплектованностьЗаказов);
	
	ТЗТрудоемкостьЗаказовНаПроизводство = ТрудоемкостьЗаказовНаПроизводство.Выгрузить();
	ВнешниеНаборыДанных.Вставить("ТЗТрудоемкостьЗаказовНаПроизводство", ТЗТрудоемкостьЗаказовНаПроизводство);
	
	ТЗОстаткиИДоступностьТоваров = ОстаткиИДоступностьТоваров.Выгрузить();
	ВнешниеНаборыДанных.Вставить("ТЗОстаткиИДоступностьТоваров", ТЗОстаткиИДоступностьТоваров);
	
	ТЗЗаказаноНоменклатура = ЗаказаноНоменклатура.Выгрузить();
	ВнешниеНаборыДанных.Вставить("ТЗЗаказаноНоменклатура", ТЗЗаказаноНоменклатура);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,  ВнешниеНаборыДанных); 
	
	ДеревоИерархии = Новый ДеревоЗначений;
	
	ПроцессорВывода = Новый  ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ДеревоИерархии);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ЗаполнитьНомерКартинки(ДеревоИерархии);
	
	ДобавитьСтрокиПоСтруктуреЗаказа(ДеревоИерархии);
	
	ЗначениеВРеквизитФормы(ДеревоИерархии, "ДеревоУкомплектованностьЗаказов"); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСтруктураЗаказаПотребление()
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТрудоемкостьЗаказовНаПроизводство", ТрудоемкостьЗаказовНаПроизводство.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	т.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	               |	т.Изделие КАК Изделие,
	               |	т.План КАК План
	               |ПОМЕСТИТЬ втТрудоемкостьЗаказовНаПроизводство
	               |ИЗ
	               |	&ТрудоемкостьЗаказовНаПроизводство КАК т";
	Запрос.Выполнить();
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтруктураЗаказа.Номенклатура КАК Номенклатура,
	               |	СтруктураЗаказа.Характеристика КАК Характеристика,
	               |	СтруктураЗаказа.Спецификация КАК Спецификация,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура КАК ОсновноеИзделиеНоменклатура,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура.Код КАК Шифр,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура.ВесЧислитель КАК ВесДетали,
	               |	СтруктураЗаказа.Спецификация.юум_ЧерныйВес КАК ВесДеталиЧерный,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура.ЕдиницаДляОтчетов КАК ЕдиницаДляОтчетов,
	               |	СтруктураЗаказа.КоличествоНаЕдиницуПартииЗапуска КАК КоличествоНаЕдиницуПартииЗапуска,
	               |	СтруктураЗаказа.Спецификация.ОсновноеИзделиеХарактеристика КАК ОсновноеИзделиеХарактеристика,
	               |	СтруктураЗаказа.КОбеспечению КАК КОбеспечению,
	               |	ЕСТЬNULL(ТрудоемкостьЗаказов.План, 0) КАК План,
	               |	СтруктураЗаказа.Склад КАК Склад,
	               |	СтруктураЗаказа.Назначение КАК Назначение,
	               |	СтруктураЗаказа.НазначениеСтруктуры КАК НазначениеСтруктуры,
	               |	СтруктураЗаказа.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	               |	СтруктураЗаказа.КлючНоменклатура КАК КлючНоменклатура,
	               |	СтруктураЗаказа.КлючПартия КАК КлючПартия,
	               |	СтруктураЗаказа.ВидСтроки КАК ВидСтроки,
	               |	СтруктураЗаказа.ЗаказНаПоступление КАК ЗаказНаПоступление,
	               |	СтруктураЗаказа.ДатаПоступления КАК ДатаПоступления,
	               |	СтруктураЗаказа.КлючНабор КАК КлючНабор,
	               |	СтруктураЗаказа.Разделитель КАК Разделитель,
	               |	СтруктураЗаказа.Заказано КАК Заказано,
	               |	СтруктураЗаказа.Запланировано КАК Запланировано,
	               |	СтруктураЗаказа.РаспределеноИзЗапасовОбособленно КАК РаспределеноИзЗапасовОбособленно,
	               |	СтруктураЗаказа.РаспределеноИзЗапасов КАК РаспределеноИзЗапасов,
	               |	СтруктураЗаказа.РаспределеноИзПартийОбособленно КАК РаспределеноИзПартийОбособленно,
	               |	СтруктураЗаказа.РаспределеноИзПартий КАК РаспределеноИзПартий,
	               |	СтруктураЗаказа.Запущено КАК Запущено,
	               |	СтруктураЗаказа.РазборкаЗапланировано КАК РазборкаЗапланировано,
	               |	СтруктураЗаказа.РазборкаЗапущена КАК РазборкаЗапущена,
	               |	СтруктураЗаказа.Готово КАК Готово,
	               |	СтруктураЗаказа.НеОбеспечивать КАК НеОбеспечивать,
	               |	СтруктураЗаказа.Заменено КАК Заменено,
	               |	СтруктураЗаказа.Уровень КАК Уровень,
	               |	СтруктураЗаказа.ДополнительнаяЗапись КАК ДополнительнаяЗапись,
	               |	СтруктураЗаказа.Подразделение КАК Подразделение,
	               |	СтруктураЗаказа.Этап КАК Этап,
	               |	СтруктураЗаказа.ИдентификаторВерсииДанных КАК ИдентификаторВерсииДанных,
	               |	СтруктураЗаказа.КлючСвязиСтрокаСпецификации КАК КлючСвязиСтрокаСпецификации,
	               |	СтруктураЗаказа.КлючСвязиПеремещение КАК КлючСвязиПеремещение,
	               |	СтруктураЗаказа.СпецификацияПолуфабриката КАК СпецификацияПолуфабриката,
	               |	СтруктураЗаказа.ДлительностьДоВыпуска КАК ДлительностьДоВыпуска,
	               |	СтруктураЗаказа.ГруппаИзделий КАК ГруппаИзделий,
	               |	СтруктураЗаказа.ИдентификаторВГруппеИзделий КАК ИдентификаторВГруппеИзделий,
	               |	СтруктураЗаказа.РазрешениеНаЗамену КАК РазрешениеНаЗамену,
	               |	СтруктураЗаказа.СтатьяКалькуляции КАК СтатьяКалькуляции,
	               |	СтруктураЗаказа.КоличествоНаЕдиницуПартииЗапуска * СтруктураЗаказа.Номенклатура.ВесЧислитель КАК ВесПотребностиОбщий,
	               |	СтруктураЗаказа.Номенклатура.ВесЧислитель КАК НоменклатураВесЧислитель
	               |ИЗ
	               |	РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	               |		ЛЕВОЕ СОЕДИНЕНИЕ втТрудоемкостьЗаказовНаПроизводство КАК ТрудоемкостьЗаказов
	               |		ПО СтруктураЗаказа.ЗаказНаПроизводство = ТрудоемкостьЗаказов.ЗаказНаПроизводство
	               |			И СтруктураЗаказа.Спецификация.ОсновноеИзделиеНоменклатура = ТрудоемкостьЗаказов.Изделие
	               |ГДЕ
	               |	СтруктураЗаказа.ВидСтроки В (ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.Потребление), ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката), ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции))";
	Результат = Запрос.Выполнить();
	
	СтруктураЗаказаПотребление.Загрузить(Результат.Выгрузить()); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПолуфабрикаты()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КэшНСИСтруктурыЗаказа.Номенклатура КАК Номенклатура,
	               |	КэшНСИСтруктурыЗаказа.Характеристика КАК Характеристика,
	               |	КэшНСИСтруктурыЗаказа.Склад КАК Склад,
	               |	КэшНСИСтруктурыЗаказа.Назначение КАК Назначение,
	               |	КэшНСИСтруктурыЗаказа.ЗаказНаПроизводство КАК ЗаказНаПроизводство
	               |ИЗ
	               |	РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИСтруктурыЗаказа
	               |ГДЕ
	               |	КэшНСИСтруктурыЗаказа.ТипОбеспечения = ЗНАЧЕНИЕ(Перечисление.ТипыОбеспечения.Производство)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаказНаПроизводство";
	Результат = Запрос.Выполнить();
	
	Полуфабрикаты.Загрузить(Результат.Выгрузить()); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗаказаноНоменклатура()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗаказНаПоступление", УкомплектованностьЗаказов.Выгрузить(, "ЗаказНаПоступление"));
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗаявкаНаЗакупкуТовары.Ссылка КАК ЗаказНаПоступление,
	               |	МАКСИМУМ(ЗаявкаНаЗакупкуТовары.Контрагент) КАК Поставщик,
	               |	МАКСИМУМ(ЗаявкаНаЗакупкуТовары.Договор) КАК Договор,
	               |	ЗаявкаНаЗакупкуТовары.Номенклатура КАК Номенклатура,
	               |	ЗаявкаНаЗакупкуТовары.Характеристика КАК Характеристика,
	               |	ЗаявкаНаЗакупкуТовары.Назначение КАК Назначение,
	               |	ЗаявкаНаЗакупкуТовары.Склад КАК Склад,
	               |	МАКСИМУМ(ЗаявкаНаЗакупкуТовары.Упаковка) КАК ЕдиницаИзмеренияЗакупки,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЗаявкаНаЗакупкуТовары.Ссылка.ПоступлениеОднойДатой
	               |				ТОГДА ЗаявкаНаЗакупкуТовары.Ссылка.ЖелаемаяДатаПоступления
	               |			ИНАЧЕ ЗаявкаНаЗакупкуТовары.ЖелаемаяДатаПоступления
	               |		КОНЕЦ) КАК ДатаПоставки
	               |ИЗ
	               |	Документ.ЗаявкаНаЗакупку.Товары КАК ЗаявкаНаЗакупкуТовары
	               |ГДЕ
	               |	ЗаявкаНаЗакупкуТовары.Ссылка В(&ЗаказНаПоступление)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаявкаНаЗакупкуТовары.Ссылка,
	               |	ЗаявкаНаЗакупкуТовары.Номенклатура,
	               |	ЗаявкаНаЗакупкуТовары.Характеристика,
	               |	ЗаявкаНаЗакупкуТовары.Назначение,
	               |	ЗаявкаНаЗакупкуТовары.Склад
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗаказПоставщикуТовары.Ссылка,
	               |	МАКСИМУМ(ЗаказПоставщикуТовары.Ссылка.Контрагент),
	               |	МАКСИМУМ(ЗаказПоставщикуТовары.Ссылка.Договор),
	               |	ЗаказПоставщикуТовары.Номенклатура,
	               |	ЗаказПоставщикуТовары.Характеристика,
	               |	ЗаказПоставщикуТовары.Назначение,
	               |	ЗаказПоставщикуТовары.Склад,
	               |	МАКСИМУМ(ЗаказПоставщикуТовары.Упаковка),
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЗаказПоставщикуТовары.Ссылка.ПоступлениеОднойДатой
	               |				ТОГДА ЗаказПоставщикуТовары.Ссылка.ЖелаемаяДатаПоступления
	               |			ИНАЧЕ ЗаказПоставщикуТовары.ДатаПоступления
	               |		КОНЕЦ)
	               |ИЗ
	               |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	               |ГДЕ
	               |	ЗаказПоставщикуТовары.Ссылка В(&ЗаказНаПоступление)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказПоставщикуТовары.Ссылка,
	               |	ЗаказПоставщикуТовары.Номенклатура,
	               |	ЗаказПоставщикуТовары.Характеристика,
	               |	ЗаказПоставщикуТовары.Назначение,
	               |	ЗаказПоставщикуТовары.Склад";
	Результат = Запрос.Выполнить();
	
	ЗаказаноНоменклатура.Загрузить(Результат.Выгрузить()); 
	
КонецПроцедуры


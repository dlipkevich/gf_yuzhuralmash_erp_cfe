		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Товары.Номенклатура КАК Номенклатура,
	Товары.Номенклатура.ЕдиницаИзмерения КАК НоменклатураЕдиницаИзмерения,
	Товары.Характеристика КАК Характеристика,
	Товары.Склад КАК Склад,
	Товары.Назначение КАК Назначение,
	Товары.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	МИНИМУМ(Товары.ЗаказНаПроизводство.НачатьНеРанее) КАК ДатаПотребности,
	СУММА(ВЫБОР
			КОГДА Товары.Вероятность = 0
				ТОГДА Товары.Количество
			ИНАЧЕ Товары.Количество * Товары.Вероятность / 100
		КОНЕЦ) КАК Требуется,
	ИСТИНА КАК флНоменклатураПоТребованию
ИЗ
	РегистрСведений.юум_НоменклатураПоТребованию КАК Товары
{ГДЕ
	Товары.Номенклатура.* КАК Номенклатура,
	Товары.Характеристика.* КАК Характеристика,
	Товары.Назначение.* КАК Назначение,
	Товары.Склад.* КАК Склад,
	Товары.ЗаказНаПроизводство.* КАК ЗаказНаПроизводство}

СГРУППИРОВАТЬ ПО
	Товары.Номенклатура,
	Товары.Характеристика,
	Товары.Склад,
	Товары.Назначение,
	Товары.ЗаказНаПроизводство,
	Товары.Номенклатура.ЕдиницаИзмерения

ИМЕЮЩИЕ
	СУММА(Товары.Количество) &gt; 0</query>

// #04.02.01.04
// Формирование группы, надписи и поля отбора.
// Галфинд AMotorin 2026/10/15 
//
// Параметры:
//   Родитель - ГруппаФормы - Родительская группа, в которую добавляется создаваемый элемент формы.
//   ИмяГруппы - Строка - Имя создаваемой группы отбора.
//   ЗаголовокГруппы - Строка - Заголовок группы отбора.
//   ИмяДекорации - Строка - Имя создаваемой надписи внутри группы.
//   ЗаголовокДекорации - Строка - Текст надписи отбора.
//   ИмяПоля - Строка - Имя поля формы либо поле динамического списка, используемое для отбора.
//   ПутьКДанным - Строка - Путь к реквизиту формы, с которым связывается поле ввода.
//   ИмяОбработчика - Строка - Имя процедуры, назначаемой обработчиком действия элемента формы.
//
&НаСервере
Процедура юум_СоздатьГруппуОтбора(Родитель, ИмяГруппы, ЗаголовокГруппы, ИмяДекорации, ЗаголовокДекорации, ИмяПоля, ПутьКДанным, ИмяОбработчика)

	ПараметрыГруппы = юум_РаботаСФормой.КонструкторПараметрыГруппаФормы(ИмяГруппы, ЗаголовокГруппы, Родитель);
	НастройкиГруппы = ПараметрыГруппы.ДополнительныеПараметры;
	НастройкиГруппы.Вставить("Отображение", ОтображениеОбычнойГруппы.Нет);
	НастройкиГруппы.Вставить("Группировка", ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
	НастройкиГруппы.Вставить("ОтображатьЗаголовок", Ложь);
	НастройкиГруппы.Вставить("Видимость", Истина);
	НастройкиГруппы.Вставить("Доступность", Истина);
	НастройкиГруппы.Вставить("Объединенная", Ложь);

	Группа = юум_РаботаСФормой.СоздатьГруппуФормыПереопределяемая(ЭтотОбъект, ПараметрыГруппы);

	НастройкиДекорации = Новый Структура;
	НастройкиДекорации.Вставить("Видимость", Истина);
	НастройкиДекорации.Вставить("Доступность", Истина);
	юум_РаботаСФормой.СоздатьДекорациюФормы(Элементы, ИмяДекорации, ЗаголовокДекорации, ВидДекорацииФормы.Надпись, Группа,,НастройкиДекорации);

	ПараметрыПоля = юум_РаботаСФормой.КонструкторПараметрыПоляФормы(ИмяПоля, ПутьКДанным, Группа);
	НастройкиПоля = ПараметрыПоля.ДополнительныеПараметры;

	НастройкиПоля.Вставить("Видимость", Истина);
	НастройкиПоля.Вставить("Доступность", Истина);
	НастройкиПоля.Вставить("ТолькоПросмотр", Ложь);
	НастройкиПоля.Вставить("ПоложениеЗаголовка", ПоложениеЗаголовкаЭлементаФормы.Нет);
	НастройкиПоля.Вставить("КнопкаВыпадающегоСписка", Истина);
	НастройкиПоля.Вставить("КнопкаОчистки", Истина);
	НастройкиПоля.Вставить("КнопкаОткрытия", Ложь);
	НастройкиПоля.Вставить("РедактированиеТекста", Истина);
	НастройкиПоля.Вставить("ПодсказкаВвода", "<без отбора>");
	ПараметрыПоля.События.Вставить("ПриИзменении", ИмяОбработчика);
	юум_РаботаСФормой.СоздатьПолеФормыПоПараметрам(ЭтотОбъект, ПараметрыПоля);

КонецПроцедуры 

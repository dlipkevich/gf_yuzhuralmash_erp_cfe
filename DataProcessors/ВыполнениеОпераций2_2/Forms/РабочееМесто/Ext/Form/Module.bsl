	юум_РаботаСФормой.ДобавитьРеквизитФормы(ЭтотОбъект, РеквизитыФормы.Добавляемые, "юум_ДатаКонец", "Дата");
    юум_РаботаСФормой.ДобавитьРеквизитФормы(ЭтотОбъект, РеквизитыФормы.Добавляемые, "юум_СменаНазначения", "СправочникСсылка.Календари");
	юум_РаботаСФормой.ДобавитьРеквизитФормы(ЭтотОбъект, РеквизитыФормы.Добавляемые, "юум_РежимШтрихкода", "Строка");

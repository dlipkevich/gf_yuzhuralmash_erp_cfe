    СтандартнаяОбработка = Ложь;

	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда 
		
        ПоказатьПредупреждение(, "Сначала выберите подразделение для выбора смены.");
        Возврат;  
		
    КонецЕсли;

    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("Подразделение", Неопределено);
    ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
    ПараметрыФормы.Вставить("ТолькоВыборСмены", Истина);
    ПараметрыФормы.Вставить("СкрыватьДокументы", Истина);

    ОткрытьФорму("Документ.СменноеЗадание.Форма.ФормаВыбораПоКалендарю", ПараметрыФормы, ЭтотОбъект, УникальныйИдентификатор,,, Новый ОписаниеОповещения("юум_ПослеВыбораСменыНазначения", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

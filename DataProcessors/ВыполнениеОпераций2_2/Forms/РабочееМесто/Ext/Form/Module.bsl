// #юум {
// #04.02.01.04
// Подбор выбранной номенклатуры и материалов спецификаций по наименованию.
// Галфинд AMotorin 2026/11/06
//
// Параметры:
//   НоменклатураЧертежа - СправочникСсылка.Номенклатура - Номенклатура верхнего уровня, по наименованию которой ищутся ресурсные спецификации.
//
// Возвращаемое значение:
//   Структура - результат поиска спецификаций:
//     * НайденаСпецификация - Булево - Истина, если найдена ресурсная спецификация с указанным наименованием.
//     * Номенклатура - Массив из СправочникСсылка.Номенклатура - исходная номенклатура и найденные материалы спецификаций.
//
&НаСервереБезКонтекста
Функция юум_ПолучитьНоменклатуруЧертежаНаСервере(НоменклатураЧертежа)

    Результат = Новый Структура("НайденаСпецификация,Номенклатура", Ложь, Новый Массив);
    Результат.Номенклатура.Добавить(НоменклатураЧертежа);

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ 
    |    РесСпец.Ссылка КАК Спецификация,
    |    ЕСТЬNULL(СтрокиМатериалов.Номенклатура,
    |        ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура
    |ИЗ
    |    Справочник.РесурсныеСпецификации КАК РесСпец
    |        ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РесурсныеСпецификации.МатериалыИУслуги КАК СтрокиМатериалов
    |        ПО РесСпец.Ссылка = СтрокиМатериалов.Ссылка
    |ГДЕ
    |    РесСпец.Наименование = &НаименованиеСпецификации
    |    И НЕ РесСпец.ПометкаУдаления";  
	
    Запрос.УстановитьПараметр("НаименованиеСпецификации", НоменклатураЧертежа.Наименование);
    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл

        Результат.НайденаСпецификация = Истина; 
		
		Если ЗначениеЗаполнено(Выборка.Номенклатура) И Результат.Номенклатура.Найти(Выборка.Номенклатура) = Неопределено Тогда  
			
            Результат.Номенклатура.Добавить(Выборка.Номенклатура);     
			
        КонецЕсли;

    КонецЦикла;

    Возврат Результат;

КонецФункции
// } #юум


// #юум {
// #04.02.01.04
// Установка или снятие дополнительного отбора списка.
// Галфинд AMotorin 2026/10/15
//
// Параметры:
//   ИмяПоля - Строка - Имя поля формы либо поле динамического списка, используемое для отбора.
//   ЗначениеОтбора - Произвольный - Значение дополнительного отбора, если не заполнено, отбор снимается.
//   ПредставлениеОтбора - Строка - Идентификатор группы дополнительного отбора динамического списка.
//
&НаКлиенте
Процедура юум_УстановитьДополнительныйОтбор(ИмяПоля, ЗначениеОтбора, ПредставлениеОтбора)

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(ВыполнениеОпераций,,ПредставлениеОтбора);

	Если ЗначениеЗаполнено(ЗначениеОтбора) Тогда

		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ВыполнениеОпераций, ИмяПоля, ЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно, ПредставлениеОтбора, Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

	КонецЕсли;

	Элементы.ВыполнениеОпераций.Обновить();

КонецПроцедуры 

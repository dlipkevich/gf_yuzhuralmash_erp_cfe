// #юум {
// #04.02.01.04
// Проверяет возможность выполнения операций вне технологической очереди только в сформированном наряде.
// Галфинд AMotorin 2026/11/12   
//
// Параметры:
//   СсылкиОпераций - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Полный список производственных операций, выбранных для отметки выполнения.
//   ОперацииВнеОчереди - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Операции с ожиданием предшественников, для которых требуется дополнительная проверка.
//
// Возвращаемое значение:
//   Структура - результат проверки допустимости выполнения вне очереди:
//     * Разрешено - Булево - Истина, если проверенные операции допускают отметку выполнения.
//     * Сообщение - Строка - пояснение причины отказа в выполнении.
//
&НаСервереБезКонтекста
Функция юум_ПроверитьОтметкуОперацийВНарядеНаСервере(СсылкиОпераций, ОперацииВнеОчереди)

	Результат = Новый Структура("Разрешено,Сообщение", Ложь, "");
	Если ОперацииВнеОчереди.Количество() = 0 Тогда
		Результат.Разрешено = Истина;
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|    ДокОперация.Ссылка КАК Ссылка,
	|    ДокОперация.Проведен КАК Проведен,
	|    ДокОперация.ПометкаУдаления КАК ПометкаУдаления,
	|    ДокОперация.Статус КАК Статус,
	|    ДокОперация.СменноеЗадание КАК СменноеЗадание,
	|    ДокОперация.СменноеЗадание.Статус КАК СтатусНаряда,
	|    ДокОперация.СменноеЗадание.Проведен КАК ПроведенНаряд,
	|    ДокОперация.СменноеЗадание.ПометкаУдаления КАК ПометкаУдаленияНаряда,
	|    ДокОперация.Количество КАК Количество,
	|    ДокОперация.КоличествоФакт КАК КоличествоФакт,
	|    ДокОперация.КоличествоБрак КАК КоличествоБрак,
	|    ДокОперация.КоличествоОтменено КАК КоличествоОтменено,
	|    ДокОперация.КоличествоНаКонтроле КАК КоличествоНаКонтроле,
	|    ДокОперация.КоличествоНаДоработке КАК КоличествоНаДоработке
	|ИЗ
	|    Документ.ПроизводственнаяОперация2_2 КАК ДокОперация
	|ГДЕ
	|    ДокОперация.Ссылка В (&СсылкиОпераций)";
	Запрос.УстановитьПараметр("СсылкиОпераций", ОперацииВнеОчереди);
	ТаблицаОпераций = Запрос.Выполнить().Выгрузить();

	ПроверенныеСсылки = Новый Массив;
	Для Каждого Операция Из ТаблицаОпераций Цикл
		ПроверенныеСсылки.Добавить(Операция.Ссылка);

		Если НЕ Операция.Проведен ИЛИ Операция.ПометкаУдаления Тогда 
			
			Результат.Сообщение = СтрШаблон("Операция %1 не проведена или помечена на удаление.", Операция.Ссылка);
			Возврат Результат;
			
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Операция.СменноеЗадание) Тогда  
			
			Результат.Сообщение = СтрШаблон("Операция %1 ожидает предшественников и не включена в наряд.", Операция.Ссылка);
			Возврат Результат;     
			
		КонецЕсли;

		Если НЕ Операция.ПроведенНаряд ИЛИ Операция.ПометкаУдаленияНаряда ИЛИ Операция.СтатусНаряда <> Перечисления.СтатусыСменныхЗаданий.Сформировано Тогда    
			
			Результат.Сообщение = СтрШаблон("Операция %1: сменное задание должно быть проведено и иметь статус «Сформировано».", Операция.Ссылка);
			Возврат Результат;  
			
		КонецЕсли;

		Если Операция.Статус <> Перечисления.СтатусыПроизводственныхОпераций.Создана И Операция.Статус <> Перечисления.СтатусыПроизводственныхОпераций.Выполняется Тогда 
			
			Результат.Сообщение = СтрШаблон("Операция %1: для выполнения требуется статус «Создана» или «Выполняется».", Операция.Ссылка);
			Возврат Результат;   
			
		КонецЕсли;

		КоличествоКВыполнению = Операция.Количество - Операция.КоличествоФакт - Операция.КоличествоБрак - Операция.КоличествоОтменено - Операция.КоличествоНаКонтроле - Операция.КоличествоНаДоработке;
		Если КоличествоКВыполнению <= 0 Тогда     
			
			Результат.Сообщение = СтрШаблон("Операция %1: отсутствует количество, доступное для выполнения.", Операция.Ссылка);
			Возврат Результат;    
			
		КонецЕсли;     
		
	КонецЦикла;

	Для Каждого СсылкаОперации Из ОперацииВнеОчереди Цикл  
		
		Если ПроверенныеСсылки.Найти(СсылкаОперации) = Неопределено Тогда      
			
			Результат.Сообщение = СтрШаблон("Операция %1 не найдена для отметки выполнения.", СсылкаОперации);
			Возврат Результат;    
			
		КонецЕсли;     
		
	КонецЦикла;

	Результат.Разрешено = Истина;
	Возврат Результат;

КонецФункции
// } #юум


// #юум {
// #04.02.01.04
// Выявление операций с незаполненным исполнителем.
// Галфинд AMotorin 2026/10/15
//
// Параметры:
//   ОперацииСсылки - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылки на производственные операции для проверки и установки статуса.
//
// Возвращаемое значение:
//   Булево - Истина, если хотя бы у одной из переданных операций исполнитель не заполнен, иначе Ложь.
//
&НаСервереБезКонтекста
Функция юум_ЕстьОперацииБезИсполнителя(ОперацииСсылки)

	Если ОперацииСсылки.Количество() = 0 Тогда     
		
		Возврат Ложь;     
		
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроизводственнаяОперация.Исполнитель КАК Исполнитель
	|ИЗ
	|	Документ.ПроизводственнаяОперация2_2 КАК ПроизводственнаяОперация
	|ГДЕ
	|	ПроизводственнаяОперация.Ссылка В (&ОперацииСсылки)";

	Запрос.УстановитьПараметр("ОперацииСсылки", ОперацииСсылки);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если НЕ ЗначениеЗаполнено(Выборка.Исполнитель) Тогда
			
			Возврат Истина;       
			
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции 
// } #юум


// #юум {
// #04.02.01.04
// Запуск выполнения с проверкой заполнения исполнителя.
// Галфинд AMotorin 2026/10/15  
//
// Параметры:
//   ОперацииСсылки - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылки на производственные операции для проверки и установки статуса.
//   ОперацииВнеОчереди - Массив из ДокументСсылка.ПроизводственнаяОперация2_2, Неопределено - Операции, ожидающие
//     предшественников, для которых допускается выполнение внутри сформированного наряда.
//
&НаКлиенте
Процедура юум_ОтметитьВыполнениеСВыборомИсполнителя(ОперацииСсылки, ОперацииВнеОчереди = Неопределено)

	Если ОперацииСсылки.Количество() = 0 Тогда  
		
		Возврат;   
		
	КонецЕсли;

	Если ОперацииВнеОчереди = Неопределено Тогда 
		
		ОперацииВнеОчереди = Новый Массив;    
		
	КонецЕсли;

	Если юум_ЕстьОперацииБезИсполнителя(ОперацииСсылки) Тогда

		юум_ОткрытьВыборИсполнителяПриВыполнении(ОперацииСсылки, ОперацииВнеОчереди);

	Иначе

		Если ОперацииВнеОчереди.Количество() > 0 Тогда    
			
			ПроверкаДопуска = юум_ПроверитьОтметкуОперацийВНарядеНаСервере(ОперацииСсылки, ОперацииВнеОчереди); 
			
			Если НЕ ПроверкаДопуска.Разрешено Тогда       
				
				ПоказатьПредупреждение(, ПроверкаДопуска.Сообщение);
				Возврат;        
				
			КонецЕсли;    
			
		КонецЕсли;

		ОперативныйУчетПроизводстваКлиент.УстановитьСтатусПроизводственнойОперации(ОперацииСсылки, "Выполнена", Подразделение);

	КонецЕсли;

КонецПроцедуры 

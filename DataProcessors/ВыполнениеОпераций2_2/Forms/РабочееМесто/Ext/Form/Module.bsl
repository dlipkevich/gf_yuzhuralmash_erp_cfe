//
// Параметры:
//   Команда - КомандаФормы - Команда формы, инициировавшая действие.
//
&НаКлиенте
Процедура юум_ОтменитьНазначениеРабочегоЦентра(Команда)

	ОперацияСсылка = юум_ПолучитьВыделеннуюПроизводственнуюОперацию();  
	
	Если ОперацияСсылка = Неопределено Тогда  
		
		Возврат;        
		
	КонецЕсли;

	Результат = юум_ОтменитьНазначениеВидаРабочегоЦентраНаСервере(ОперацияСсылка);

	
	Если Результат = "ВидНеНазначен" Тогда   
	
		ПоказатьПредупреждение(, "Для выбранной операции вид рабочего центра не назначен.");


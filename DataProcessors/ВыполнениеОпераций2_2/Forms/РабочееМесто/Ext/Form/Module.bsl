// #юум {
// #04.02.01.04
// Обработка ввода кода или сброса поиска.
// Галфинд AMotorin 2026/10/22 
//
// Параметры:
//   ВведенныйКод - Строка, Неопределено - Введенный код; Неопределено, если пользователь отменил ввод.
//   ДополнительныеПараметры - Произвольный - Дополнительные данные оповещения о вводе штрихкода.
//
&НаКлиенте
Процедура юум_ПослеВводаКода(ВведенныйКод, ДополнительныеПараметры) Экспорт

	Если ВведенныйКод = Неопределено Тогда 
		
        Возврат;   
		
    КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ВведенныйКод)) Тогда   
		
        юум_СброситьПоискШтрихкода(Неопределено);  
		
        Возврат;   
		
    КонецЕсли;

    юум_ОбработатьПоискКода(ВведенныйКод);

КонецПроцедуры
// } #юум



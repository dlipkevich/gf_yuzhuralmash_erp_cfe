// #юум {
// #04.02.01.04
// Открытие типовой формы выбора исполнителя.
// Галфинд AMotorin 2026/10/15
//
// Параметры:
//   ОперацииСсылки - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылки на производственные операции для
//     проверки и установки статуса.
//   ОперацииВнеОчереди - Массив из ДокументСсылка.ПроизводственнаяОперация2_2, Неопределено - Операции, ожидающие
//     предшественников, для которых допускается выполнение внутри сформированного наряда.
//
&НаКлиенте
Процедура юум_ОткрытьВыборИсполнителяПриВыполнении(ОперацииСсылки, ОперацииВнеОчереди = Неопределено)

	Если ОперацииСсылки.Количество() = 0 Тогда       
		
		Возврат;       
		
	КонецЕсли;

	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ОперацииСсылки", ОперацииСсылки);
	ПараметрыОповещения.Вставить("Подразделение", Подразделение);

	Если ОперацииВнеОчереди <> Неопределено И ОперацииВнеОчереди.Количество() > 0 Тогда 
		
		ПараметрыОповещения.Вставить("юум_ОперацииВнеОчереди", ОперацииВнеОчереди); 
		
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("юум_ВыборИсполнителяЗавершение", ЭтотОбъект, ПараметрыОповещения);

	ПроизводствоКлиент.ОткрытьФормуВыбораИсполнителя(Неопределено, Неопределено, Неопределено, Неопределено, Ложь, Оповещение);

КонецПроцедуры 

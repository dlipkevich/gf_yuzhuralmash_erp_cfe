    юум_РаботаСФормой.СоздатьДекорациюФормы(Элементы, "юум_НадписьСменаНазначения", "Смена:", ВидДекорацииФормы.Надпись, ГруппаСмены);
    ПараметрыСмены = юум_РаботаСФормой.КонструкторПараметрыПоляФормы("юум_ПолеСменаНазначения", "юум_СменаНазначения", ГруппаСмены);

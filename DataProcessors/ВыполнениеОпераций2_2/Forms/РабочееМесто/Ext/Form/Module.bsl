// #юум {
// #04.02.01.04
// Проверка выделения и отметка выполнения с выбором исполнителя.
// Галфинд AMotorin 2026/10/27  
//
// Параметры:
//   Команда - КомандаФормы - Команда формы, инициировавшая действие.
//
&НаКлиенте
&ИзменениеИКонтроль("ВыполнениеОпераций_ОтметитьВыполнение")
Процедура юум_ВыполнениеОпераций_ОтметитьВыполнение(Команда)

	ВыделенныеОперации = ПроверитьПолучитьВыделенныеВСпискеОперации(?(ИспользоватьСменныеЗадания, "Документы", ""));

	Если ВыделенныеОперации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОчиститьСообщения();

	#Вставка
	// #юум {
	// #04.02.01.04
	// Проверка возможности завершения ожидающих предшественников операций сформированного наряда.
	// Галфинд AMotorin 2026/11/12
	ОперацииВнеОчереди = Новый Массив;
	КоличествоДопущенныхВнеОчереди = 0;

	Если ВыделенныеОперации.ДанныеСтрок.Количество() <> ВыделенныеОперации.Счетчики.МожноОтметитьВыполнение Тогда
		Для Каждого ДанныеСтроки Из ВыделенныеОперации.ДанныеСтрок Цикл   
			
			Если ДанныеСтроки.МожноВыполнять + ДанныеСтроки.КоличествоВРаботе - ДанныеСтроки.КоличествоНаКонтроле > 0 Тогда 
				
				Продолжить;  
				
			КонецЕсли;

			Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ПроизводственнаяОперация) Тогда   
				
				ПоказатьПредупреждение(, "Отметка вне очереди допускается только для производственных операций, включенных в наряд.");
				Возврат;   
				
			КонецЕсли;

			КоличествоДопущенныхВнеОчереди = КоличествоДопущенныхВнеОчереди + 1;   
			
			Если ОперацииВнеОчереди.Найти(ДанныеСтроки.ПроизводственнаяОперация) = Неопределено Тогда 
				
				ОперацииВнеОчереди.Добавить(ДанныеСтроки.ПроизводственнаяОперация);   
				
			КонецЕсли;   
			
		КонецЦикла;    
		
	КонецЕсли;

	Если ОперацииВнеОчереди.Количество() > 0 И ВыделенныеОперации.Счетчики.Неназначенные = 0 Тогда    
		
		ПроверкаДопуска = юум_ПроверитьОтметкуОперацийВНарядеНаСервере(ВыделенныеОперации.ОперацииСсылки, ОперацииВнеОчереди);  
		
		Если НЕ ПроверкаДопуска.Разрешено Тогда 
			
			ПоказатьПредупреждение(, ПроверкаДопуска.Сообщение);
			Возврат;   
			
		КонецЕсли;     
		
	КонецЕсли;
	// } #юум
	#КонецВставки

	#Удаление
	Если ВыделенныеОперации.ДанныеСтрок.Количество() <> ВыделенныеОперации.Счетчики.МожноОтметитьВыполнение Тогда
	#КонецУдаления
	#Вставка
	// #юум {
	// #04.02.01.04
	// К типовому числу доступных строк добавляются только проверенные операции наряда вне очереди.
	// Галфинд AMotorin 2026/11/12
	Если ВыделенныеОперации.ДанныеСтрок.Количество()
		<> ВыделенныеОперации.Счетчики.МожноОтметитьВыполнение + КоличествоДопущенныхВнеОчереди Тогда
	// } #юум
	#КонецВставки
		Если ВыделенныеОперации.ДанныеСтрок.Количество() > 1 Тогда
			ТекстСообщения = НСтр("ru = 'В выделенных строках есть операции, которые нельзя отметить выполненными';
									|en = 'The selected rows have operations that cannot be marked as completed'");
		Иначе
			ТекстСообщения = НСтр("ru = 'Операцию в выделенной строке нельзя отметить выполненной';
									|en = 'The operation in the selected row cannot be marked as completed'");
		КонецЕсли;
		ПоказатьПредупреждение(, ТекстСообщения);
	ИначеЕсли ВыделенныеОперации.Счетчики.Неназначенные > 0 Тогда

		#Вставка
		// #юум {
		// #04.02.01.04
		// Исключение типового открытия формы назначения операций при выполнении команды отметки выполнения.
		// Галфинд AMotorin 2026/10/12
		// } #юум
		#КонецВставки

		#Удаление
		ОткрытьФормуНазначениеОпераций(
			ВыделенныеОперации.КлючиОпераций, "ОтметитьВыполнение");
		#КонецУдаления

		#Вставка
		// #юум {
		// #04.02.01.04
		// Предупреждение о необходимости предварительного принятия производственных операций в работу.
		// Галфинд AMotorin 2026/10/12
		ПоказатьПредупреждение(, "Сначала необходимо принять выбранные производственные операции в работу.");
		// } #юум
		#КонецВставки

	Иначе

		#Вставка
		// #юум {
		// #04.02.01.04
		// Исключение типовой установки статуса без предварительной проверки заполнения исполнителя.
		// Галфинд AMotorin 2026/10/12
		// } #юум
		#КонецВставки

		#Удаление
		ОперативныйУчетПроизводстваКлиент.УстановитьСтатусПроизводственнойОперации(
			ВыделенныеОперации.ОперацииСсылки, "Выполнена", Подразделение);
		#КонецУдаления

		#Вставка
		// #юум {
		// #04.02.01.04
		// Проверка необходимости выбора исполнителя перед отметкой выполнения производственных операций.
		// Галфинд AMotorin 2026/10/12
		юум_ОтметитьВыполнениеСВыборомИсполнителя(ВыделенныеОперации.ОперацииСсылки, ОперацииВнеОчереди);
		// } #юум
		#КонецВставки

	КонецЕсли;

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Принятие в работу назначенных документов и операций из спецификации без документов.
// Галфинд AMotorin 2026/11/05
//
// Параметры:
//   Команда - КомандаФормы - Команда формы, инициировавшая действие.
//
&НаКлиенте
&ИзменениеИКонтроль("ВыполнениеОпераций_ПринятьВРаботу")
Процедура юум_ВыполнениеОпераций_ПринятьВРаботу(Команда)

    #Вставка
    // #юум {
    // #04.02.01.04
    // Удаление отбора только документов: нужно разрешить выбор операций спецификации без документа производственная операция.
    // Галфинд AMotorin 2026/11/05
    // } #юум
    #КонецВставки

    #Удаление
    ВыделенныеОперации = ПроверитьПолучитьВыделенныеВСпискеОперации(?(ИспользоватьСменныеЗадания, "Документы", ""));
    #КонецУдаления

    #Вставка
    // #юум {
    // #04.02.01.04
    // Получение выбранных операций вместе с неназначенными строками спецификации.
    // Галфинд AMotorin 2026/11/05
    ВыделенныеОперации = ПроверитьПолучитьВыделенныеВСпискеОперации("");
    // } #юум
    #КонецВставки

    Если ВыделенныеОперации = Неопределено Тогда
        Возврат;
    КонецЕсли;

    ОчиститьСообщения();

    #Вставка
    // #юум {
    // #04.02.01.04
    // Удаление типового сценария: операции спецификации принимаются с формированием нарядов, а не через окно назначения.
    // Галфинд AMotorin 2026/11/05
    // } #юум
    #КонецВставки

    #Удаление
    Если ВыделенныеОперации.ДанныеСтрок.Количество() <> ВыделенныеОперации.Счетчики.МожноПринятьВРаботу Тогда
        Если ВыделенныеОперации.ДанныеСтрок.Количество() > 1 Тогда
            ТекстСообщения = НСтр("ru = 'В выделенных строках есть операции, которые нельзя принять в работу';
                                    |en = 'The selected rows have operations that can be started'");
        Иначе
            ТекстСообщения = НСтр("ru = 'Операцию в выделенной строке нельзя принять в работу';
                                    |en = 'The operation in the selected row cannot be started'");
        КонецЕсли;
        ПоказатьПредупреждение(, ТекстСообщения);
        Возврат;
    ИначеЕсли ВыделенныеОперации.Счетчики.Неназначенные > 0 Тогда
        ОткрытьФормуНазначениеОпераций(
            ВыделенныеОперации.КлючиОпераций, "ПринятьВРаботу");
    Иначе
        ОперативныйУчетПроизводстваКлиент.УстановитьСтатусПроизводственнойОперации(
            ВыделенныеОперации.ОперацииСсылки, "Выполняется", Подразделение);
    КонецЕсли;
    #КонецУдаления

    #Вставка
    // #юум {
    // #04.02.01.04
    // Принятие операций в работу с группировкой по участкам и созданием сменных заданий.
    // Галфинд AMotorin 2026/11/05
	Если НЕ ЭтотОбъект["юум_ИспользоватьПериод"] Тогда  
		
        ПоказатьПредупреждение(, "Включите отбор «Период» для формирования сменных заданий.");  
		
        Возврат;  
		
    КонецЕсли;

    ДатаНачала = НачалоДня(ЭтотОбъект["юум_ДатаНачало"]);
    ДатаКонца = КонецДня(ЭтотОбъект["юум_ДатаКонец"]);        
	
	Если ДатаКонца < ДатаНачала Или НачалоМесяца(ДатаНачала) <> НачалоМесяца(ДатаКонца) Тогда 
		
        ПоказатьПредупреждение(, "Период должен быть корректным и находиться в пределах одного календарного месяца.");
        Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект["юум_СменаНазначения"]) Тогда  
		
        ПоказатьПредупреждение(, "Выберите смену для назначения операций в сменное задание (наряд).");
        Возврат;    
		
    КонецЕсли;

	
	ЕстьОперацииВСменномЗадании = Ложь;
	ЕстьОперацииБезСменногоЗадания = Ложь;
	
	Для Каждого ДанныеСтроки Из ВыделенныеОперации.ДанныеСтрок Цикл
		
		Если ЗначениеЗаполнено(ДанныеСтроки.СменноеЗадание) Тогда 
			
			ЕстьОперацииВСменномЗадании = Истина;
			
		Иначе      
			
			ЕстьОперацииБезСменногоЗадания = Истина;   
			
		КонецЕсли;     
		
	КонецЦикла;
	
	Если ЕстьОперацииВСменномЗадании Тогда
		
		Если ЕстьОперацииБезСменногоЗадания Тогда   
			
			ПоказатьПредупреждение(, "Нельзя одним действием назначить новые операции и запустить уже включенные в наряд. Выделите их отдельно.");
			Возврат; 
			
		КонецЕсли;
		
		ОперацииКПодготовке = Новый Массив; 
		
		Для Каждого ДанныеСтроки Из ВыделенныеОперации.ДанныеСтрок Цикл

			Если НЕ ЗначениеЗаполнено(ДанныеСтроки.ПроизводственнаяОперация) Тогда 
				
				ПоказатьПредупреждение(, "Повторное принятие производственных операций в сменное задание (наряд) недоступно.");
				Возврат;  
				
			КонецЕсли;

			Если ОперацииКПодготовке.Найти(ДанныеСтроки.ПроизводственнаяОперация) = Неопределено Тогда   
				
				ОперацииКПодготовке.Добавить(ДанныеСтроки.ПроизводственнаяОперация); 
				
			КонецЕсли;

		КонецЦикла;

		ИтогиПодготовки = юум_ПодготовитьИЗапуститьОперацииНарядаНаСервере(ОперацииКПодготовке); 
		
		Если ИтогиПодготовки.Подготовлено > 0 Тогда 
			
			Элементы.ВыполнениеОпераций.Обновить(); 
			
		КонецЕсли;    
		
		Возврат;
		
	КонецЕсли;
	
    ВсеГруппы = Новый Массив; 
	
    Для Каждого ДанныеСтроки Из ВыделенныеОперации.ДанныеСтрок Цикл

        НайденнаяГруппа = Неопределено; 
		
		Для Каждого Группа Из ВсеГруппы Цикл   
			
			Если Группа.Подразделение = Подразделение И Группа.Участок = ДанныеСтроки.Участок Тогда   
				
                НайденнаяГруппа = Группа;  
				
                Прервать;  
				
			КонецЕсли;  
			
        КонецЦикла;

		Если НайденнаяГруппа = Неопределено Тогда   
			
            НайденнаяГруппа = Новый Структура;
            НайденнаяГруппа.Вставить("Подразделение", Подразделение);
            НайденнаяГруппа.Вставить("Участок", ДанныеСтроки.Участок);
            НайденнаяГруппа.Вставить("ОперацииСсылки", Новый Массив);
            НайденнаяГруппа.Вставить("ОперацииБезДокументов", Новый Массив);
            НайденнаяГруппа.Вставить("ПричиныОтказа", Новый Массив);
            ВсеГруппы.Добавить(НайденнаяГруппа);    
			
        КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеСтроки.ПроизводственнаяОперация) Тогда
		
			Если НайденнаяГруппа.ОперацииСсылки.Найти(ДанныеСтроки.ПроизводственнаяОперация) = Неопределено Тогда  
					
				НайденнаяГруппа.ОперацииСсылки.Добавить(ДанныеСтроки.ПроизводственнаяОперация);  
				
			КонецЕсли;

        Иначе
            				
        	ДанныеОперации = Новый Структура;
            ДанныеОперации.Вставить("Этап", ДанныеСтроки.Этап);
            ДанныеОперации.Вставить("Операция", ДанныеСтроки.Операция);
            ДанныеОперации.Вставить("ИдентификаторОперации", ДанныеСтроки.ИдентификаторОперации);
            НайденнаяГруппа.ОперацииБезДокументов.Добавить(ДанныеОперации);     
			
		КонецЕсли; 
		
    КонецЦикла;

    КорректныеГруппы = Новый Массив;  
	
	Для Каждого Группа Из ВсеГруппы Цикл   
		
		Если Группа.ПричиныОтказа.Количество() > 0 Тогда    
			
			Для Каждого Причина Из Группа.ПричиныОтказа Цикл    
				
				Если НЕ ЗначениеЗаполнено(Группа.Участок) Тогда
					
					Сообщить(СтрШаблон("Для группы документов с подразделением %1, участком %2: не было создано сменное задание (наряд), так как: %3", 
					Группа.Подразделение, "<Не используется для данного подразделения>", Причина));		
					
				КонецЕсли;  
				
                	Сообщить(СтрШаблон("Для группы документов с подразделением %1, участком %2: не было создано сменное задание (наряд), так как: %3",
					Группа.Подразделение, Группа.Участок, Причина));     
				
			КонецЦикла; 
			
		Иначе     
			
            КорректныеГруппы.Добавить(Группа); 
			
		КонецЕсли;   
		
    КонецЦикла;

	Если КорректныеГруппы.Количество() = 0 Тогда   
		
        Возврат;   
		
    КонецЕсли;

    ПараметрыФормирования = Новый Структура;
    ПараметрыФормирования.Вставить("Группы", КорректныеГруппы);
    ПараметрыФормирования.Вставить("ДатаНачала", ДатаНачала);
    ПараметрыФормирования.Вставить("ДатаКонца", ДатаКонца);
    ПараметрыФормирования.Вставить("Смена", ЭтотОбъект["юум_СменаНазначения"]); 
	
    Оповещение = Новый ОписаниеОповещения("юум_ПослеВопросаОбИсполнителеНаряда", ЭтотОбъект, ПараметрыФормирования);
    ПоказатьВопрос(Оповещение, "Указывать исполнителя в формируемых нарядах?", РежимДиалогаВопрос.ДаНетОтмена);
    // } #юум
    #КонецВставки

КонецПроцедуры

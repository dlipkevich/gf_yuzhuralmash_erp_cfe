// Завершение серверного принятия в работу.
// Галфинд AMotorin 2026/11/05
//
// Параметры:
//   ПараметрыФормирования - Структура - Набор параметров формирования сменных заданий:
//     * Группы - Массив из Структура - группы операций по подразделениям и участкам.
//     * ДатаНачала - Дата - дата начала периода.
//     * ДатаКонца - Дата - дата окончания периода.
//     * Смена - СправочникСсылка.Календари - календарь выбранной смены.
//   Исполнитель - Произвольный - Ссылка на выбранного исполнителя, Неопределено, если исполнитель не указан.
//
&НаКлиенте
Процедура юум_ЗапуститьФормированиеНарядов(ПараметрыФормирования, Исполнитель)

    Результат = юум_СформироватьНарядыНаСервере(ПараметрыФормирования.Группы, ПараметрыФормирования.ДатаНачала, ПараметрыФормирования.ДатаКонца, ПараметрыФормирования.Смена, Исполнитель);

	Если Результат.СозданныеЗадания.Количество() > 0 Тогда    
		
        Сообщить(СтрШаблон("Сформировано сменных заданий: %1.", Результат.СозданныеЗадания.Количество())); 
		
    КонецЕсли;

	Для Каждого ОшибкаФормирования Из Результат.Ошибки Цикл 
		
        Сообщить(ОшибкаФормирования);
		
    КонецЦикла;

    Элементы.ВыполнениеОпераций.Обновить();

КонецПроцедуры

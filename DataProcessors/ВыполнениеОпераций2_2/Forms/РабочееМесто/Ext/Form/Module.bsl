// #юум {
// #04.02.01.04
// Распознавание кода и применение отбора по документу.
// Галфинд AMotorin 2026/10/22
//
// Параметры:
//   Код - Строка - Введенный или считанный штрихкод для поиска документа. Передается по значению.
//
&НаКлиенте
Процедура юум_ОбработатьПоискКода(Знач Код)

    Код = СокрЛП(Код);    
	
	Если ПустаяСтрока(Код) Тогда  
		
        юум_ПустойРезультатПоКодуНаСервере();
        Элементы.ВыполнениеОпераций.Обновить();
        ПоказатьПредупреждение(, "Введите или отсканируйте код наряда либо операции."); 
		
        Возврат;    
		
    КонецЕсли;

    Менеджеры = Новый Массив;
    Менеджеры.Добавить(ПредопределенноеЗначение("Документ.СменноеЗадание.ПустаяСсылка"));
    Менеджеры.Добавить(ПредопределенноеЗначение("Документ.ПроизводственнаяОперация2_2.ПустаяСсылка"));
    МассивСсылок = ШтрихкодированиеПечатныхФормКлиент.ПолучитьСсылкуПоШтрихкодуТабличногоДокумента(Код, Менеджеры);

	Если МассивСсылок.Количество() <> 1 Тогда 
		
        юум_ПустойРезультатПоКодуНаСервере();
        Элементы.ВыполнениеОпераций.Обновить();
		
		Если МассивСсылок.Количество() = 0 Тогда  
			
            ПоказатьПредупреждение(,"Производственные операции не найдены.");    
			
		КонецЕсли;   
		
        Возврат;   
		
    КонецЕсли;

    Ссылка = МассивСсылок[0];
    Результат = юум_УстановитьПоискПоСсылкеНаСервере(Ссылка);
    Элементы.ВыполнениеОпераций.Обновить(); 
	
	Если НЕ Результат.Успех Тогда     
		
        ПоказатьПредупреждение(, Результат.Сообщение);  
		
    КонецЕсли;

КонецПроцедуры
// } #юум



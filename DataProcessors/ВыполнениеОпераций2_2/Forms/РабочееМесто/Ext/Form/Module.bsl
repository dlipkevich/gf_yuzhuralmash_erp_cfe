// #юум {
// #04.02.01.04
// Проверка документа и установка отбора по ссылке.
// Галфинд AMotorin 2026/10/22 
//
// Параметры:
//   Ссылка - ДокументСсылка.СменноеЗадание, ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылка на документ, определенный по штрихкоду и используемый для установки отбора.
//
// Возвращаемое значение:
//   Структура - результат установки отбора:
//     * Успех - Булево - Истина, если соответствующий документ найден и отбор установлен.
//     * Сообщение - Строка - причина невозможности установить отбор.
//
&НаСервере
Функция юум_УстановитьПоискПоСсылкеНаСервере(Ссылка)

    Результат = Новый Структура("Успех,Сообщение", Ложь, "");
    юум_ПустойРезультатПоКодуНаСервере();

	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда  
		
        Результат.Сообщение = "Для поиска по наряду выберите подразделение.";  
	
        Возврат Результат;        
		
    КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СменноеЗадание") Тогда      
		
        Режим = "Наряд"; 
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПроизводственнаяОперация2_2") Тогда  
		
        Режим = "Операция";      
		
	Иначе    
		
        Результат.Сообщение = "Считанный код не относится к сменному заданию или производственной операции."; 
		
        Возврат Результат; 
		
    КонецЕсли;

	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Подразделение") <> Подразделение Тогда   
		
        Результат.Сообщение = "Наряд или операция не относится к выбранному подразделению.";  
		
        Возврат Результат;  
		
    КонецЕсли;

    Запрос = Новый Запрос;
    ТекстЗапроса =
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    Очередь.ПроизводственнаяОперация КАК ПроизводственнаяОперация
    |ИЗ
    |    РегистрСведений.ОчередьПроизводственныхОпераций КАК Очередь
    |ГДЕ
    |    НЕ Очередь.ВАрхиве
    |    И Очередь.Подразделение = &Подразделение
    |    И Очередь.ПроизводственнаяОперация <> ЗНАЧЕНИЕ(Документ.ПроизводственнаяОперация2_2.ПустаяСсылка)
    |    И Очередь.ПроизводственнаяОперация.Проведен
    |    И НЕ Очередь.ПроизводственнаяОперация.ПометкаУдаления";
	

	Если Режим = "Наряд" Тогда

    	ТекстЗапроса = ТекстЗапроса + Символы.ПС
        + "    И Очередь.ПроизводственнаяОперация.СменноеЗадание = &Ссылка"
        + Символы.ПС
        + "    И НЕ (Очередь.ПроизводственнаяОперация.Статус В (&КонечныеСтатусы))";

	Иначе

    	ТекстЗапроса = ТекстЗапроса + Символы.ПС
        + "    И Очередь.ПроизводственнаяОперация = &Ссылка";

	КонецЕсли;

	Если ЭтотОбъект["юум_ИспользоватьПериод"] Тогда   
		
        ТекстЗапроса = ТекстЗапроса + Символы.ПС
            + "    И Очередь.ПроизводственнаяОперация.Дата >= &ДатаНачало"
            + Символы.ПС
            + "    И Очередь.ПроизводственнаяОперация.Дата <= &ДатаКонец";
        Запрос.УстановитьПараметр("ДатаНачало", ЭтотОбъект["юум_ДатаНачало"]);
        Запрос.УстановитьПараметр("ДатаКонец", ЭтотОбъект["юум_ДатаКонец"]);
		
    КонецЕсли;

    КонечныеСтатусы = Новый Массив;
    КонечныеСтатусы.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Выполнена);

    Запрос.Текст = ТекстЗапроса;
    Запрос.УстановитьПараметр("Подразделение", Подразделение);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Запрос.УстановитьПараметр("КонечныеСтатусы", КонечныеСтатусы);
    Выборка = Запрос.Выполнить().Выбрать();      
	
	Если НЕ Выборка.Следующий() Тогда  
		
        Результат.Сообщение = ?(Режим = "Наряд", "В наряде нет невыполненных операций выбранного подразделения, которые проходят отбор по периоду.", "Операция выполнена или скрыта отбором по периоду."); 
		
        Возврат Результат;         
		
    КонецЕсли;

    ЭтотОбъект["юум_РежимШтрихкода"] = Режим;
    ЭтотОбъект["юум_НарядПоШтрихкоду"] = Документы.СменноеЗадание.ПустаяСсылка();
    ЭтотОбъект["юум_ОперацияПоШтрихкоду"] = Документы.ПроизводственнаяОперация2_2.ПустаяСсылка(); 
	
	Если Режим = "Наряд" Тогда         
		
        ЭтотОбъект["юум_НарядПоШтрихкоду"] = Ссылка;    
		
	Иначе      
		
        ЭтотОбъект["юум_ОперацияПоШтрихкоду"] = Ссылка;    
		
	КонецЕсли;    
	
    юум_УстановитьОтборПоШтрихкодуНаСервере();
    Результат.Успех = Истина;      
	
    Возврат Результат;

КонецФункции
// } #юум


// #юум {
// #04.02.01.04
// Формирование отбора по наряду или операции.
// Галфинд AMotorin 2026/10/22
&НаСервере
Процедура юум_УстановитьОтборПоШтрихкодуНаСервере()

    Корень = ВыполнениеОпераций.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
    Группа = Неопределено;   
	
	Для Каждого Элемент Из Корень.Элементы Цикл   
		
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") И Элемент.Представление = "юум_ОтборПоШтрихкоду" Тогда   
			
            Группа = Элемент;
			
            Прервать;    
			
		КонецЕсли;  
		
    КонецЦикла;

	Если Группа = Неопределено Тогда   
		
        Группа = Корень.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
        Группа.Представление = "юум_ОтборПоШтрихкоду";
        Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
        Группа.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

		Для Каждого ИмяПоля Из СтрРазделить("СменноеЗадание,ПроизводственнаяОперация,ПроизводственнаяОперацияСтатус,ПроизводственнаяОперацияНазначена", ",") Цикл  
			
            ЭлементОтбора = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
            ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
            ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;         
			
		КонецЦикла;  
		
    КонецЕсли;

    Режим = ЭтотОбъект["юум_РежимШтрихкода"];
    Группа.Использование = НЕ ПустаяСтрока(Режим);   
	
	Если НЕ Группа.Использование Тогда   
		
        Возврат;                            
		
    КонецЕсли;

	Для Каждого ЭлементОтбора Из Группа.Элементы Цикл   
		
        ЭлементОтбора.Использование = Ложь;  
		
    КонецЦикла;

	Если Режим = "Наряд" Тогда  
		
        Группа.Элементы[0].ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        Группа.Элементы[0].ПравоеЗначение = ЭтотОбъект["юум_НарядПоШтрихкоду"];
        Группа.Элементы[0].Использование = Истина;    
		
	ИначеЕсли Режим = "Операция" Тогда     
		
        Группа.Элементы[1].ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        Группа.Элементы[1].ПравоеЗначение = ЭтотОбъект["юум_ОперацияПоШтрихкоду"];
        Группа.Элементы[1].Использование = Истина;          
		
	ИначеЕсли Режим = "Пусто" Тогда   
		
        Группа.Элементы[1].ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        Группа.Элементы[1].ПравоеЗначение = Документы.ПроизводственнаяОперация2_2.ПустаяСсылка();
        Группа.Элементы[1].Использование = Истина;    
		
    КонецЕсли;

	Если Режим = "Наряд" Тогда    
		
        КонечныеСтатусы = Новый СписокЗначений;
        КонечныеСтатусы.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Выполнена);
        Группа.Элементы[2].ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
        Группа.Элементы[2].ПравоеЗначение = КонечныеСтатусы;
        Группа.Элементы[2].Использование = Истина;      
		
    КонецЕсли;

	Если Режим = "Наряд" ИЛИ Режим = "Операция" ИЛИ Режим = "Пусто" Тогда     
		
        Группа.Элементы[3].ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        Группа.Элементы[3].ПравоеЗначение = Истина;
        Группа.Элементы[3].Использование = Истина;      
		
    КонецЕсли;

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Формирование отбора по датам операции.
// Галфинд AMotorin 2026/10/16
&НаСервере
Процедура юум_УстановитьОтборПериодаНаСервере()

    КореньОтбора = ВыполнениеОпераций.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
    ГруппаПериода = Неопределено;

	Для Каждого ЭлементОтбора Из КореньОтбора.Элементы Цикл   
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") И ЭлементОтбора.Представление = "юум_ОтборПериода" Тогда 
			
            ГруппаПериода = ЭлементОтбора;
            Прервать;  
			
		КонецЕсли; 
		
    КонецЦикла;

	Если ГруппаПериода = Неопределено Тогда 
		
        ГруппаПериода = КореньОтбора.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
        ГруппаПериода.Представление = "юум_ОтборПериода";
        ГруппаПериода.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
        ГруппаПериода.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

        ОтборБезДокумента = ГруппаПериода.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ОтборБезДокумента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроизводственнаяОперацияНазначена");
        ОтборБезДокумента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
        ОтборБезДокумента.ПравоеЗначение = Ложь;
        ОтборБезДокумента.Использование = Истина;
        ОтборБезДокумента.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

        ГруппаДат = ГруппаПериода.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
        ГруппаДат.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
        ГруппаДат.Использование = Истина;
        ГруппаДат.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

        ОтборНачало = ГруппаДат.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ОтборНачало.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("юум_ДатаПроизводственнойОперации");
        ОтборНачало.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
        ОтборНачало.Использование = Истина;
        ОтборНачало.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

        ОтборКонец = ГруппаДат.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        ОтборКонец.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("юум_ДатаПроизводственнойОперации");
        ОтборКонец.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
        ОтборКонец.Использование = Истина;
        ОтборКонец.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
		
    КонецЕсли;

    ГруппаПериода.Использование = ЭтотОбъект["юум_ИспользоватьПериод"];  
	
	Если НЕ ГруппаПериода.Использование Тогда  
		
        Возврат;    
		
    КонецЕсли;

    ГруппаПериода.Элементы[1].Элементы[0].ПравоеЗначение = ЭтотОбъект["юум_ДатаНачало"];
    ГруппаПериода.Элементы[1].Элементы[1].ПравоеЗначение = ЭтотОбъект["юум_ДатаКонец"];

КонецПроцедуры
// } #юум


// #юум {
// #04.02.01.04
// Проверка границ периода и обновление списка.
// Галфинд AMotorin 2026/10/16
&НаКлиенте
Процедура юум_ПрименитьПериод()

	Если ЭтотОбъект["юум_ИспользоватьПериод"] Тогда

		Если НЕ ЗначениеЗаполнено(ЭтотОбъект["юум_ДатаНачало"]) ИЛИ НЕ ЗначениеЗаполнено(ЭтотОбъект["юум_ДатаКонец"]) Тогда  
			
			ПоказатьПредупреждение(, "Заполните начало и конец периода.");    
			
			Возврат;                
			
		КонецЕсли;

		Если ЭтотОбъект["юум_ДатаНачало"] > ЭтотОбъект["юум_ДатаКонец"] Тогда  
			
			ПоказатьПредупреждение(, "Начало периода не может быть позже его конца."); 
			
			Возврат;                                   
			
		КонецЕсли;

		Если НачалоМесяца(ЭтотОбъект["юум_ДатаНачало"])  <> НачалоМесяца(ЭтотОбъект["юум_ДатаКонец"]) Тогда  
			
            ПоказатьПредупреждение(, "Период должен находиться в пределах одного календарного месяца.");  
			
            Возврат;            
			
        КонецЕсли;

	КонецЕсли;

	юум_УстановитьОтборПериодаНаСервере();
	Элементы.ВыполнениеОпераций.Обновить();

КонецПроцедуры

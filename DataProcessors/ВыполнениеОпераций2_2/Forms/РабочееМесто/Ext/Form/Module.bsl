	Если Данные.Свойство("Штрихкод", Штрихкод) Тогда 
		
        юум_ОбработатьПоискКода(Штрихкод);  
		
	Иначе        
		
        ПоказатьПредупреждение(, "Сканер не передал поле Штрихкод.");   
		
    КонецЕсли;

КонецПроцедуры

// #юум {
// #04.02.01.04
// Изменение партии по выбранной операции, включая индивидуальную, через типовой механизм АРМ.
// Галфинд AMotorin 2026/11/04  
//
// Параметры:
//   Команда - КомандаФормы - Команда формы, инициировавшая действие.
//
&НаКлиенте
Процедура юум_ИзменитьПартию(Команда)

    ВыделенныеСтроки = Элементы.ВыполнениеОпераций.ВыделенныеСтроки;

	Если ВыделенныеСтроки.Количество() <> 1 Тогда  
		
        ПоказатьПредупреждение(, "Для изменения партии выберите одну производственную операцию.");
        Возврат;   
		
    КонецЕсли;

    ДанныеСтроки = Элементы.ВыполнениеОпераций.ДанныеСтроки(ВыделенныеСтроки[0]);

	Если ДанныеСтроки = Неопределено Тогда  
		
        ПоказатьПредупреждение(, "Выберите строку производственной операции.");
        Возврат;    
		
    КонецЕсли;

    ОткрытьФормуДеленияПартияПроизводства();

КонецПроцедуры
// } #юум



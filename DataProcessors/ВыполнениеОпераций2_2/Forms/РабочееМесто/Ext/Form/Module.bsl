// #юум {
// #04.02.01.04
// Дополнение типового запроса полями расширения.
// Галфинд AMotorin 2026/10/08
//
// Возвращаемое значение:
//   Строка - текст типового запроса динамического списка с дополнительными полями расширения.
//
&НаСервере
&Вместо("ТекстЗапросаСпискаВыполнениеОпераций")
Функция юум_ТекстЗапросаСпискаВыполнениеОпераций()

    ТекстЗапроса = ПродолжитьВызов();

    ТекстЗапроса = СтрЗаменить(
        ТекстЗапроса,
        "КАК Номенклатура,",
        "КАК Номенклатура,
        | Очередь.Этап.ПартияПроизводства.ОсновноеИзделиеНоменклатура.Код 	КАК юум_НоменклатураКод,
        | Очередь.ПроизводственнаяОперация 									КАК юум_ПроизводственнаяОперация,
        | Очередь.ПроизводственнаяОперация.Дата 							КАК юум_ДатаПроизводственнойОперации,
        | Очередь.Распоряжение 												КАК юум_ЗаказНаПроизводство2_2,"); 
					
    Возврат ТекстЗапроса;

КонецФункции

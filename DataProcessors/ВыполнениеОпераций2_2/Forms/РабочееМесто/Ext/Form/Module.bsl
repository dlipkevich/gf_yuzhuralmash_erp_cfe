// #юум {
// #04.02.01.04
// Очистка назначения вида рабочего центра с сохранением проведения.
// Галфинд AMotorin 2026/10/27 
//
// Параметры:
//   ОперацияСсылка - ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылка на производственную операцию, для которой изменяется назначение рабочего центра.
//
// Возвращаемое значение:
//   Строка - результат отмены назначения:
//     * "ВидНеНазначен" - вид рабочего центра у операции не был указан.
//     * "Отменено" - назначение очищено, документ записан.
//
&НаСервере
Функция юум_ОтменитьНазначениеВидаРабочегоЦентраНаСервере(ОперацияСсылка)

	ОбъектОперации = ОперацияСсылка.ПолучитьОбъект();

	ТекущийРабочийЦентр = ОбъектОперации.РабочийЦентр;   
	
	Если НЕ ЗначениеЗаполнено(ТекущийРабочийЦентр) Тогда 
		
		Возврат "ВидНеНазначен";  
		
	КонецЕсли;

	ОбъектОперации.РабочийЦентр = Справочники.ВидыРабочихЦентров.ПустаяСсылка();
	ОбъектОперации.Записать(РежимЗаписиДокумента.Проведение);

	Элементы.ВыполнениеОпераций.Обновить();

	Возврат "Отменено";

КонецФункции

    НоменклатураЧертежа = ЭтотОбъект["юум_ВходитВЧертеж"];

    ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбораДинамическогоСписка(ВыполнениеОпераций, , "юум_ОтборВходитВЧертеж");

    Если ЗначениеЗаполнено(НоменклатураЧертежа) Тогда

        РезультатПоиска = юум_ПолучитьНоменклатуруЧертежаНаСервере(НоменклатураЧертежа);

		Если НЕ РезультатПоиска.НайденаСпецификация Тогда 
			
            ПоказатьПредупреждение(,СтрШаблон("Не найдена ресурсная спецификация с наименованием «%1».", Строка(НоменклатураЧертежа)));
			
        КонецЕсли;

        ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ВыполнениеОпераций, "Номенклатура", РезультатПоиска.Номенклатура, ВидСравненияКомпоновкиДанных.ВСписке, "юум_ОтборВходитВЧертеж", Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);

    КонецЕсли;

    Элементы.ВыполнениеОпераций.Обновить();

КонецПроцедуры

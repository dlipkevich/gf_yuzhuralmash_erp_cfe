// #юум {
// #04.02.01.04
// Формирование нарядов с подбором операций без документов и получением документов к запуску.
// Галфинд AMotorin 2026/11/05
//
// Параметры:
//   КорректныеГруппы - Массив из Структура - Группы операций по подразделениям и участкам:
//     * Подразделение - СправочникСсылка.СтруктураПредприятия - подразделение группы.
//     * Участок - СправочникСсылка.ПроизводственныеУчастки - участок группы.
//     * ОперацииСсылки - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - операции с документами.
//     * ОперацииБезДокументов - Массив из Структура - ключи Этап, Операция, ИдентификаторОперации.
//     * ПричиныОтказа - Массив из Строка - сообщения о причинах невозможности формирования.
//   ДатаНачала - Дата - Дата начала периода, используемая как дата нового сменного задания.
//   ДатаКонца - Дата - Дата окончания периода, записываемая в срок выполнения сменного задания.
//   СменаНазначения - СправочникСсылка.Календари - Календарь смены, указываемый в формируемых нарядах.
//   Исполнитель - Произвольный - Ссылка на выбранного исполнителя, Неопределено, если исполнитель не указан.
//
// Возвращаемое значение:
//   Структура - итоги формирования сменных заданий:
//     * Ошибки - Массив из Строка - сообщения об ошибках формирования.
//     * СозданныеЗадания - Массив из ДокументСсылка.СменноеЗадание - ссылки на созданные наряды.
//
&НаСервере
Функция юум_СформироватьНарядыНаСервере(КорректныеГруппы, ДатаНачала, ДатаКонца, СменаНазначения, Исполнитель)

    Результат = Новый Структура("Ошибки, СозданныеЗадания", Новый Массив, Новый Массив);	
    Ответственный = Пользователи.ТекущийПользователь();
    ЭтапыБезДокументов = Новый Массив;

	Для Каждого Группа Из КорректныеГруппы Цикл 
		
		Для Каждого ОперацияИзОчереди Из Группа.ОперацииБезДокументов Цикл   
			
			Если ЭтапыБезДокументов.Найти(ОперацияИзОчереди.Этап) = Неопределено Тогда   
				
                ЭтапыБезДокументов.Добавить(ОперацияИзОчереди.Этап);  
				
			КонецЕсли;   
			
		КонецЦикла;   
		
    КонецЦикла;

    ЗаписиДляНазначения = Новый ТаблицаЗначений;
	
	//Для операций по спецификации тех. процесса этапа
    Если ЭтапыБезДокументов.Количество() > 0 Тогда

        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |    ДанныеРегистра.Подразделение КАК Подразделение,
        |    ДанныеРегистра.Этап КАК Этап,
        |    ДанныеРегистра.Операция КАК Операция,
        |    ДанныеРегистра.ИдентификаторОперации КАК ИдентификаторОперации,
        |    ДанныеРегистра.СменноеЗадание КАК СменноеЗадание,
        |    ДанныеРегистра.Исполнитель КАК Исполнитель,
        |    ДанныеРегистра.РабочийЦентр КАК РабочийЦентр,
        |    ДанныеРегистра.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
        |    ДанныеРегистра.НазначатьНеРанее КАК НазначатьНеРанее
        |ИЗ
        |    РегистрСведений.ОперацииКСозданиюСменныхЗаданий КАК ДанныеРегистра
        |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПроизводственныхОпераций КАК Очередь
        |        ПО ДанныеРегистра.Этап = Очередь.Этап
        |         И ДанныеРегистра.Операция = Очередь.Операция
        |         И ДанныеРегистра.ИдентификаторОперации = Очередь.ИдентификаторОперации
        |         И Очередь.ОсновнаяЗапись
        |ГДЕ
        |    ДанныеРегистра.Этап В (&ЭтапыБезДокументов)
        |    И ДанныеРегистра.СменноеЗадание = ЗНАЧЕНИЕ(Документ.СменноеЗадание.ПустаяСсылка)
        |    И (Очередь.МожноВыполнять > 0
        |        ИЛИ Очередь.ОжиданиеПредшествующих > 0
        |        ИЛИ Очередь.НачатыПредшествующие > 0)
        |    И Очередь.ПроизводственнаяОперация = ЗНАЧЕНИЕ(Документ.ПроизводственнаяОперация2_2.ПустаяСсылка)"; 
		
        Запрос.УстановитьПараметр("ЭтапыБезДокументов", ЭтапыБезДокументов);
        ЗаписиДляНазначения = Запрос.Выполнить().Выгрузить();
        ЗаписиДляНазначения.Индексы.Добавить("Подразделение,Этап,Операция,ИдентификаторОперации");

    КонецЕсли;

    Для Каждого Группа Из КорректныеГруппы Цикл

        ЕстьОперацииБезДокументов = Группа.ОперацииБезДокументов.Количество() > 0;
        КлючиРегистра = Новый Массив;
        ОперацииНайдены = Истина;

		Если ЕстьОперацииБезДокументов Тогда 
			
            Для Каждого ОперацияИзОчереди Из Группа.ОперацииБезДокументов Цикл

                КлючПоиска = Новый Структура("Подразделение,Этап,Операция,ИдентификаторОперации", Группа.Подразделение, ОперацияИзОчереди.Этап, ОперацияИзОчереди.Операция, ОперацияИзОчереди.ИдентификаторОперации);
                НайденныеСтроки = ЗаписиДляНазначения.НайтиСтроки(КлючПоиска);

				Для Каждого СтрокаРегистра Из НайденныеСтроки Цикл  
					
                    КлючиРегистра.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаРегистра)); 
					
                КонецЦикла;

			КонецЦикла;  
			
        КонецЕсли;

		Если ЕстьОперацииБезДокументов И (НЕ ОперацииНайдены Или КлючиРегистра.Количество() = 0) Тогда  
			
            Продолжить; 
			
        КонецЕсли;

        Задание = Документы.СменноеЗадание.СоздатьДокумент();
        Задание.Дата = ДатаНачала;
        Задание.юум_ВыполнитьДо = ДатаКонца;
        Задание.ПлановаяДатаЗавершения = ДатаКонца;
        Задание.Подразделение = Группа.Подразделение;
        Задание.Участок = Группа.Участок;
        Задание.Смена = СменаНазначения;
        Задание.Ответственный = Ответственный;
        Задание.Статус = ?(ЕстьОперацииБезДокументов, Перечисления.СтатусыСменныхЗаданий.Формируется, Перечисления.СтатусыСменныхЗаданий.Сформировано);

        Если ЗначениеЗаполнено(Исполнитель) Тогда
            Задание.Исполнитель = Исполнитель;
        КонецЕсли;

        Задание.Записать(РежимЗаписиДокумента.Проведение);  

		Если ЕстьОперацииБезДокументов Тогда 
			
            ПараметрыНазначения = РегистрыСведений.ОперацииКСозданиюСменныхЗаданий.ПараметрыНазначенияОпераций();
            ПараметрыНазначения.Измерения.СменноеЗадание = Задание.Ссылка;

			Если ЗначениеЗаполнено(Исполнитель) Тогда   
				
                ПараметрыНазначения.Измерения.Исполнитель = Исполнитель; 
				
            КонецЕсли;

            РегистрыСведений.ОперацииКСозданиюСменныхЗаданий.НазначитьОперации(КлючиРегистра, ПараметрыНазначения);
            Документы.СменноеЗадание.УстановитьСтатус(Задание.Ссылка, Перечисления.СтатусыСменныхЗаданий.Сформировано);
			
        КонецЕсли;

		Для Каждого ОперацияСсылка Из Группа.ОперацииСсылки Цикл

			ОперацияОбъект = ОперацияСсылка.ПолучитьОбъект(); 
			ОперацияОбъект.СменноеЗадание = Задание.Ссылка;
			ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);

		КонецЦикла;

        Результат.СозданныеЗадания.Добавить(Задание.Ссылка);

    КонецЦикла;

	Если Результат.СозданныеЗадания.Количество() = 0 Тогда 
		
        Возврат Результат;  
		
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    ДокОперация.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ПроизводственнаяОперация2_2 КАК ДокОперация
    |ГДЕ
    |    ДокОперация.СменноеЗадание В (&СменныеЗадания)
    |    И НЕ ДокОперация.ПометкаУдаления
    |    И ДокОперация.Статус В (&СтатусыДляПодготовки)";

    СтатусыДляПодготовки = Новый Массив;
    СтатусыДляПодготовки.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Формируется);
    СтатусыДляПодготовки.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Создана);
    Запрос.УстановитьПараметр("СменныеЗадания", Результат.СозданныеЗадания);
    Запрос.УстановитьПараметр("СтатусыДляПодготовки", СтатусыДляПодготовки);

    ОперацииКПодготовке = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");  
	
	Если ОперацииКПодготовке.Количество() > 0 Тогда  
		
        юум_ПодготовитьИЗапуститьОперацииНарядаНаСервере(ОперацииКПодготовке); 
		
    КонецЕсли;

    Возврат Результат;

КонецФункции
// } #юум   


// #юум {
// #04.02.01.04
// Подготавливает назначенные операции наряда и запускает операции, доступные по очереди.
// Галфинд AMotorin 2026/11/10   
//
// Параметры:
//   СсылкиОпераций - Массив из ДокументСсылка.ПроизводственнаяОперация2_2 - Ссылки на выбранные производственные
//     операции.
//
// Возвращаемое значение:
//   Структура - количественные итоги обработки:
//     * Подготовлено - Число - количество обработанных операций, подходящих для подготовки.
//     * Запущено - Число - количество операций, для которых установлен статус «Выполняется».
//     * Ожидают - Число - количество подготовленных операций, не попавших в список запуска.
//
&НаСервере
Функция юум_ПодготовитьИЗапуститьОперацииНарядаНаСервере(СсылкиОпераций)

    Результат = Новый Структура("Подготовлено,Запущено,Ожидают", 0, 0, 0); 
	
	Если СсылкиОпераций.Количество() = 0 Тогда    
		
        Возврат Результат;  
		
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |    ДокОперация.Ссылка КАК Ссылка,
    |    ДокОперация.Статус КАК Статус,
    |    ДокОперация.Исполнитель КАК Исполнитель,
    |    ДокОперация.СменноеЗадание.Исполнитель КАК ИсполнительНаряда
    |ИЗ
    |    Документ.ПроизводственнаяОперация2_2 КАК ДокОперация
    |ГДЕ
    |    ДокОперация.Ссылка В (&СсылкиОпераций)
    |    И ДокОперация.СменноеЗадание <> ЗНАЧЕНИЕ(Документ.СменноеЗадание.ПустаяСсылка)
    |    И НЕ ДокОперация.ПометкаУдаления
    |    И ДокОперация.Статус В (&СтатусыДляПодготовки)"; 
	
    Запрос.УстановитьПараметр("СсылкиОпераций", СсылкиОпераций);
    СтатусыДляПодготовки = Новый Массив;
    СтатусыДляПодготовки.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Формируется);
    СтатусыДляПодготовки.Добавить(Перечисления.СтатусыПроизводственныхОпераций.Создана);
    Запрос.УстановитьПараметр("СтатусыДляПодготовки", СтатусыДляПодготовки);

    ТаблицаОпераций = Запрос.Выполнить().Выгрузить();  
	
    Для Каждого СтрокаОперации Из ТаблицаОпераций Цикл

        Если СтрокаОперации.Статус = Перечисления.СтатусыПроизводственныхОпераций.Формируется Или (НЕ ЗначениеЗаполнено(СтрокаОперации.Исполнитель) И ЗначениеЗаполнено(СтрокаОперации.ИсполнительНаряда)) Тогда

            ОперацияОбъект = СтрокаОперации.Ссылка.ПолучитьОбъект();  
			
			Если НЕ ЗначениеЗаполнено(ОперацияОбъект.Исполнитель) И ЗначениеЗаполнено(СтрокаОперации.ИсполнительНаряда) Тогда  
				
                ОперацияОбъект.Исполнитель = СтрокаОперации.ИсполнительНаряда; 
				
			КонецЕсли;     
			
			Если ОперацияОбъект.Статус = Перечисления.СтатусыПроизводственныхОпераций.Формируется Тогда  
				
				Если НЕ ОперацияОбъект.УстановитьСтатус("Создана", Новый Структура) Тогда  
					
                    ВызватьИсключение СтрШаблон("Не удалось установить статус Создана для производственной операции %1.", СтрокаОперации.Ссылка); 
					
				КонецЕсли;   
				
			КонецЕсли;    
			
            ОперацияОбъект.Записать(РежимЗаписиДокумента.Проведение);

        КонецЕсли;

        Результат.Подготовлено = Результат.Подготовлено + 1;

    КонецЦикла;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ РАЗЛИЧНЫЕ
    |    ДокОперация.Ссылка КАК Ссылка
    |ИЗ
    |    Документ.ПроизводственнаяОперация2_2 КАК ДокОперация
    |        ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОчередьПроизводственныхОпераций КАК Очередь
    |        ПО Очередь.ПроизводственнаяОперация = ДокОперация.Ссылка
    |            И Очередь.ОсновнаяЗапись
    |ГДЕ
    |    ДокОперация.Ссылка В (&СсылкиОпераций)
    |    И ДокОперация.СменноеЗадание <> ЗНАЧЕНИЕ(Документ.СменноеЗадание.ПустаяСсылка)
    |    И ДокОперация.Проведен
    |    И НЕ ДокОперация.ПометкаУдаления
    |    И ДокОперация.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПроизводственныхОпераций.Создана)
    |    И Очередь.МожноВыполнять > 0
    |    И Очередь.ОжиданиеПредшествующих = 0
    |    И Очередь.НачатыПредшествующие = 0"; 
	
    Запрос.УстановитьПараметр("СсылкиОпераций", СсылкиОпераций);
    ОперацииЗапустить = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
    Результат.Ожидают = Результат.Подготовлено - ОперацииЗапустить.Количество(); 
	
	Если ОперацииЗапустить.Количество() > 0 Тогда 
		
		Результат.Запущено = ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(ОперацииЗапустить, "Выполняется", Новый Структура); 
		
    КонецЕсли;

    Возврат Результат;

КонецФункции
// } #юум

#КонецОбласти

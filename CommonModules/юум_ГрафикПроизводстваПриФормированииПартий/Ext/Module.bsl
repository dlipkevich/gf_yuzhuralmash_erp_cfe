// Предоставляет исходные тексты запросов этапов текущего релиза ERP.
// Параметры:
//  ПараметрыРасчета - Структура - настройки и диагностика штатного калькулятора.
// Возвращаемое значение:
//  Структура - именованные тексты запросов этапов, партий, связей и нормативов.
// #юум {
// #ЧТЗ 04.01
// Доступ к закрытым функциям ERP; правила прогноза находятся в собственном модуле.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Калькулятор_ТекстыЭтаповПрогноза(ПараметрыРасчета)
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: юум_ТекстыЭтаповПрогноза.
    ТекстыШтатногоРасчета = Новый Структура;
    ТекстЗапроса = юум_ФП_Калькулятор_ТекстЗапросаВТВыпускПартий();
    ТекстыШтатногоРасчета.Вставить("ВТВыпускПартий", ТекстЗапроса);

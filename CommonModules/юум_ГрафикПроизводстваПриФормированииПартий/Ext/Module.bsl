		|			И Виды1.ВидРабочегоЦентра.КоличествоРабочихЦентров > 0
		|			ТОГДА Виды1.ВидРабочегоЦентра.КоличествоРабочихЦентров
		|		ИНАЧЕ ЕСТЬNULL(КоличествоРЦ.КоличествоРабочихЦентров, 1)
		|	КОНЕЦ                                    КАК КоличествоРЦКЗагрузке,
		|	0                                        КАК КоэффициентРасчетаПоФормуле,
		|	&ТекстЭтоАльтернативный                  КАК ЭтоАльтернативный,
		|	ЕСТЬNULL(Виды2.КлючСвязиВидыРабочихЦентров, Виды1.КлючСвязи) КАК КлючСвязи
		|ИЗ
		|	ВТПартии КАК Партии
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСвязиПартийИЭтаповДокумент КАК Связи
		|	ПО Партии.Ссылка = Связи.ПартияСсылка
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
		|	ПО Связи.Ссылка = Этапы.Ссылка
		|
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.ВидыРабочихЦентров КАК Виды1
		|	ПО Этапы.Ссылка = Виды1.Ссылка
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.АльтернативныеВидыРабочихЦентров КАК Виды2
		|	ПО Этапы.Ссылка = Виды2.Ссылка
		|		И Виды1.КлючСвязи = Виды2.КлючСвязиВидыРабочихЦентров
		|		И НЕ Виды1.Использовать И Виды2.Использовать
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2.АльтернативныеВидыРабочихЦентров КАК Виды3
		|	ПО &ТекстЭтоАльтернативный
		|		И Этапы.Ссылка = Виды3.Ссылка
		|		И Виды1.КлючСвязи = Виды3.КлючСвязиВидыРабочихЦентров
		|		И Виды3.Использовать
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоРЦ КАК КоличествоРЦ
		|	ПО ЕСТЬNULL(Виды2.ВидРабочегоЦентра, Виды1.ВидРабочегоЦентра) = КоличествоРЦ.ВидРабочегоЦентра
		|
		|ГДЕ
		|	&ТекстОтбор
		|	И &ТекстАльтернативныеОтбор
		|	И Этапы.Проведен
		|	И НЕ Этапы.Статус В (
		|		ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат),
		|		ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Завершен))
		|	И (&ОтменитьРучныеИзмененияГрафика ИЛИ НЕ Этапы.РучноеРазмещениеВГрафике)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстОтбор",
		СтрЗаменить(ТекстЗапросаОтбор, "&ТекстИмяТаблицы", "Партии"));
	
	Если НЕ СоздатьВТ Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТВидыРЦ", "");
		ТекстЗапроса = ТекстЗапроса + юум_ФП_Калькулятор_ТекстПодстановкиПорядокВидыРЦ();
	ИначеЕсли ПолучитьАльтернативные Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ ВТВидыРЦ", "ПОМЕСТИТЬ ВТАльтернативныеВидыРЦ");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстЭтоАльтернативный",
		?(ПолучитьАльтернативные, "ИСТИНА", "ЛОЖЬ"));
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстКлючСвязиВедущаяТаблица",
		?(ПолучитьАльтернативные, "Виды.КлючСвязиВидыРабочихЦентров", "Виды.КлючСвязи"));
	
	Если ПолучитьАльтернативные Тогда
		// Подстановки справочник
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"Справочник.ЭтапыПроизводства.ВидыРабочихЦентров КАК Виды",
			"Справочник.ЭтапыПроизводства.АльтернативныеВидыРабочихЦентров КАК Виды");
		
		// Подстановки документ
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"И НЕ Виды1.Использовать И Виды2.Использовать",
			"И НЕ Виды1.Использовать И НЕ Виды2.Использовать");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстАльтернативныеОтбор",
			"(Виды2.ВидРабочегоЦентра ЕСТЬ НЕ NULL И Виды3.ВидРабочегоЦентра ЕСТЬ NULL)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстАльтернативныеОтбор",
			"ИСТИНА");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаДанныеЗаказа(ТекстЗапросаОтбор, УпорядочитьРезультат)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаДанныеЗаказа.
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	Заказы.Ссылка          КАК ЗаказНаПроизводство,
		|	Заказы.Номер           КАК Номер,
		|	Заказы.ТипПроизводственногоПроцесса
		|		= ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.Сборка)                   КАК ЭтоСборка,
		|	Заказы.ТипПроизводственногоПроцесса
		|		= ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот) КАК ЭтоРемонт,
		|	Заказы.ЗадействоватьРезервДоступности КАК ЗадействоватьРезервДоступности,
		|	Заказы.ИспользоватьАльтернативныеВРЦ  КАК ИспользоватьАльтернативныеВРЦ,
		|	Заказы.НачатьНеРанее   КАК НачатьНеРанее,
		|	Заказы.ДатаПотребности КАК ДатаПотребности,
		|	ВЫБОР
		|		КОГДА Заказы.ДатаПотребности = ДАТАВРЕМЯ(1,1,1)
		|			ТОГДА 0
		|		ИНАЧЕ РАЗНОСТЬДАТ(Заказы.НачатьНеРанее, Заказы.ДатаПотребности, МЕСЯЦ)
		|	КОНЕЦ                 КАК РазностьДатВМесяцах
		|ИЗ
		|	Документ.ЗаказНаПроизводство2_2 КАК Заказы
		|ГДЕ
		|	&ТекстЗапросаОтбор";
	
	Если УпорядочитьРезультат Тогда
		ТекстЗапросаПорядок = "
			|УПОРЯДОЧИТЬ ПО
			|	Заказы.Приоритет.РеквизитДопУпорядочивания,
			|	Заказы.Подразделение.РеквизитДопУпорядочивания,
			|	Заказы.Очередь";//@Query-part
		ТекстЗапроса = ТекстЗапроса + ТекстЗапросаПорядок;
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаОтбор",
		СтрЗаменить(ТекстЗапросаОтбор, "&ТекстИмяТаблицы", "Заказы"));
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаИзделияКРасчетуВидовРЦПоФормуле()
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаИзделияКРасчетуВидовРЦПоФормуле.
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Партии.КлючПартия                 КАК КлючПартия,
		|	Партии.Ссылка                     КАК Спецификация,
		|	ДанныеПартии.Номенклатура         КАК Номенклатура,
		|	ДанныеПартии.Характеристика       КАК Характеристика,
		|	ДанныеПартии.КоличествоЕдиниц     КАК Количество,
		|	Партии.ЗаказНаПроизводство        КАК Распоряжение,
		|	Заказ.Подразделение               КАК ПодразделениеДиспетчер,
		|	Заказ.НаправлениеДеятельности     КАК НаправлениеДеятельности,
		|	ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) КАК ПодразделениеИсполнитель,
		|	ДАТАВРЕМЯ(1,1,1)                  КАК НачалоПроизводства,
		|	0                                 КАК ДнейОтПотребности
		|ИЗ
		|	ВТПартии КАК Партии
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоПартий КАК ДанныеПартии
		|	ПО Партии.КлючПартия = ДанныеПартии.КлючПартия
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК Заказ
		|	ПО Партии.ЗаказНаПроизводство = Заказ.Ссылка
		|ГДЕ
		|	Партии.Ссылка В (
		|		ВЫБРАТЬ
		|			Т.Ссылка КАК Ссылка
		|		ИЗ
		|			ВТСпецификацииКРасчетуВидовРЦПоФормуле КАК Т)";
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаСвязи(ОтменитьРучныеИзмененияГрафика)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаСвязи.
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Связи.КлючПартия               КАК КлючПартия,
		|	Связи.Этап                     КАК Этап,
		|	Связи.КлючПартияПредшественник КАК КлючПартияПредшественник,
		|	Связи.ЭтапПредшественник       КАК ЭтапПредшественник
		|ИЗ
		|	ВТСвязи КАК Связи
		|ГДЕ
		|	&ТекстЗапросаИсключитьЭтапыСРучнымРазмещением";
	Если ОтменитьРучныеИзмененияГрафика Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаИсключитьЭтапыСРучнымРазмещением",
			"ИСТИНА");
	Иначе
		// Даты предшественников с ручным размещением учитываются при выборке этапов
		// (см. ВТДатыНепланируемыхПредшественников)
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаИсключитьЭтапыСРучнымРазмещением",
			"НЕ ИСТИНА В (
			|	ВЫБРАТЬ ПЕРВЫЕ 1
			|		ИСТИНА
			|	ИЗ
			|		ВТЭтапыСРучнымРазмещением КАК Т
			|	ГДЕ 
			|		Т.Ссылка = Связи.ЭтапПредшественник)");
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаСвязиРемонтов()
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаСвязиРемонтов.
	ТекстЗапроса = 

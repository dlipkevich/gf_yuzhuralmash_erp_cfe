	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтВсеКлючиПартий.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтВсеКлючиПартий.КлючПартия КАК КлючПартия,
	|	СтруктураЗаказа.КлючНоменклатура КАК КлючНоменклатура
	|ПОМЕСТИТЬ ВтСтруктураЗаказов
	|ИЗ
	|	ВтВсеКлючиПартий КАК ВтВсеКлючиПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	|		ПО ВтВсеКлючиПартий.ЗаказНаПроизводство = СтруктураЗаказа.ЗаказНаПроизводство
	|			И ВтВсеКлючиПартий.КлючПартия = СтруктураЗаказа.КлючПартия
	|			И (СтруктураЗаказа.ВидСтроки В (ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката), ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции)))
	|			И (НЕ СтруктураЗаказа.ДополнительнаяЗапись)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтСтруктураЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтСтруктураЗаказов.КлючПартия КАК КлючПартия,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Ссылка, ЗНАЧЕНИЕ(Справочник.юум_ДеревоЗаказаСлужебный.ПустаяСсылка)) КАК юум_ЭлементДерева,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Уровень, 0) КАК Уровень,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Доля, 0) КАК Доля
	|ПОМЕСТИТЬ ВтДеревоЗаказов
	|ИЗ
	|	ВтСтруктураЗаказов КАК ВтСтруктураЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.юум_ДеревоЗаказаСлужебный КАК ДеревоЗаказовПодробное
	|		ПО ВтСтруктураЗаказов.ЗаказНаПроизводство = ДеревоЗаказовПодробное.ЗаказНаПроизводство
	|			И ВтСтруктураЗаказов.КлючНоменклатура = ДеревоЗаказовПодробное.КлючНоменклатура
	|			И (НЕ ДеревоЗаказовПодробное.ПометкаУдаления)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтДеревоЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия КАК КлючПартия,
	|	СУММА(ВтДеревоЗаказов.Доля) КАК Доля,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВтДеревоЗаказов.юум_ЭлементДерева) КАК КоличествоЭлементовДерева
	|ПОМЕСТИТЬ ВтПодозрительныеДоли
	|ИЗ
	|	ВтДеревоЗаказов КАК ВтДеревоЗаказов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтДеревоЗаказов.ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВтДеревоЗаказов.Доля) <> 1
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтДеревоЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия КАК КлючПартия,
	|	ВтДеревоЗаказов.юум_ЭлементДерева КАК юум_ЭлементДерева,
	|	ВтДеревоЗаказов.Уровень КАК Уровень,
	|	ВтДеревоЗаказов.Доля КАК Доля
	|ПОМЕСТИТЬ ВтДеревоЗаказовОкончательное
	|ИЗ
	|	ВтДеревоЗаказов КАК ВтДеревоЗаказов
	|ГДЕ
	|	ВтДеревоЗаказов.Доля <> 0	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВтПодозрительныеДоли.ЗаказНаПроизводство,
	|	ВтПодозрительныеДоли.КлючПартия,
	|	ЕСТЬNULL(ДеревоЗаказовПодробноеНулевогоУровня.Ссылка, ЗНАЧЕНИЕ(Справочник.юум_ДеревоЗаказаСлужебный.ПустаяСсылка)),
	|	0,
	|	(1 - ВтПодозрительныеДоли.Доля)
	|ИЗ
	|	ВтПодозрительныеДоли КАК ВтПодозрительныеДоли
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.юум_ДеревоЗаказаСлужебный КАК ДеревоЗаказовПодробноеНулевогоУровня
	|		ПО ВтПодозрительныеДоли.ЗаказНаПроизводство = ДеревоЗаказовПодробноеНулевогоУровня.ЗаказНаПроизводство
	|			И (ДеревоЗаказовПодробноеНулевогоУровня.Уровень = 0)
	|ГДЕ
	|	(1 - ВтПодозрительныеДоли.Доля) <> 0
	|;
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // } #юум

// Параметры:
//  ДанныеОЗагрузке - ТаблицаЗначений - заполняемый набор отчета.
//  ВыборкаДанных - СтрокаТаблицыЗначений - строка занятости или вида рабочего центра.
//  ТекущийПериод - Дата - начало интервала результата.
//  ИнтервалПериодичности - ПеречислениеСсылка.ТочностьГрафикаПроизводства - точность периода.
//  НайденнаяДоступностьВРЦ - Массив из СтрокаТаблицыЗначений - доступность в интервале.
//  НайденнаяСводнаяЗанятостьВРЦ - Массив из СтрокаТаблицыЗначений - сводная занятость.
//  НайденнаяСводнаяДоступностьВРЦ - Массив из СтрокаТаблицыЗначений - сводная доступность.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Процедура юум_ФП_Загрузка_СтрокаОтчета(ДанныеОЗагрузке, ВыборкаДанных, ТекущийПериод, ИнтервалПериодичности,
	НайденнаяДоступностьВРЦ, НайденнаяСводнаяЗанятостьВРЦ, НайденнаяСводнаяДоступностьВРЦ)
	
	СтрокаДанные = ДанныеОЗагрузке.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаДанные, ВыборкаДанных);
	
	СтрокаДанные.ПериодГрафика = ТекущийПериод;
	
	СтрокаДанные.ПериодГрафикаПредставление = ОперативныйУчетПроизводства.ИнтервалПланированияСтрокой(
		СтрокаДанные.ПериодГрафика, 
		ИнтервалПериодичности);
	
	Если НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.Доступно = НайденнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли;
	
	Если НайденнаяСводнаяЗанятостьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ЗанятоСводно = НайденнаяСводнаяЗанятостьВРЦ[0].Занято;
	КонецЕсли; 
	
	Если НайденнаяСводнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ДоступноСводно = НайденнаяСводнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли; 

КонецПроцедуры // } #юум

// Параметры:
//  НастройкиОсновнойСхемы - НастройкиКомпоновкиДанных - настройки отчета.
// Возвращаемое значение:
//  Структура - списки подразделений и ВРЦ, границы периода и периодичность.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ОтборыОтчета(НастройкиОсновнойСхемы) Экспорт

	Период = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиОсновнойСхемы, "Период").Значение; 
	ПериодичностьОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиОсновнойСхемы, "ПериодичностьОтчета").Значение;
	
	ЭлементыОтбора = НастройкиОсновнойСхемы.Отбор.Элементы;
	
	СписокПодразделений = Новый СписокЗначений;
	СписокВидовРабочихЦентров = Новый СписокЗначений;
	
	Если ЭлементыОтбора <> Неопределено Тогда
		Подразделение  = юум_ФП_Загрузка_ЗначениеОтбора("Подразделение", ЭлементыОтбора);
		Если Подразделение <> Неопределено И ТипЗнч(Подразделение) = Тип("СписокЗначений") Тогда
			СписокПодразделений.ЗагрузитьЗначения(Подразделение.ВыгрузитьЗначения());
		Иначе
			Если Подразделение <> Неопределено Тогда
				СписокПодразделений.Добавить(Подразделение);
			КонецЕсли;
		КонецЕсли;
		
		ВидРабочегоЦентра = юум_ФП_Загрузка_ЗначениеОтбора("ВидРабочегоЦентра", ЭлементыОтбора);
		Если ВидРабочегоЦентра <> Неопределено И ТипЗнч(ВидРабочегоЦентра) = Тип("СписокЗначений") Тогда
			СписокВидовРабочихЦентров.ЗагрузитьЗначения(ВидРабочегоЦентра.ВыгрузитьЗначения());
		Иначе
			Если ВидРабочегоЦентра <> Неопределено Тогда
				СписокВидовРабочихЦентров.Добавить(ВидРабочегоЦентра);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	ЗначенияОтбораДанных = Новый Структура;
	ЗначенияОтбораДанных.Вставить("СписокПодразделений",          СписокПодразделений);
	ЗначенияОтбораДанных.Вставить("СписокВидовРабочихЦентров",    СписокВидовРабочихЦентров);
	ЗначенияОтбораДанных.Вставить("НачалоПериода",                Период.ДатаНачала);
	ЗначенияОтбораДанных.Вставить("ОкончаниеПериода",             Период.ДатаОкончания);
	ЗначенияОтбораДанных.Вставить("ПериодичностьОтчета", 		  ПериодичностьОтчета);
	
	Возврат ЗначенияОтбораДанных;
	
КонецФункции // } #юум

// Параметры:
//  ИмяПоля - Строка - имя поля отбора.
//  ЭлементыОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - элементы отбора.
// Возвращаемое значение:
//  Произвольный - правое значение активного отбора либо Неопределено.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ЗначениеОтбора(ИмяПоля, ЭлементыОтбора)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементКоллекции.ЛевоеЗначение = Поле 
			И ЭлементКоллекции.Использование Тогда
			
			Возврат ЭлементКоллекции.ПравоеЗначение;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Неопределено;

КонецФункции // } #юум

// Параметры:
//  Периодичность - ПеречислениеСсылка.Периодичность - периодичность отчета.
// Возвращаемое значение:
//  ПеречислениеСсылка.ТочностьГрафикаПроизводства - день, неделя или месяц.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ИнтервалОтчета(Периодичность)
	
	Результат = Перечисления.ТочностьГрафикаПроизводства.День;
	
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Неделя;
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц 
		Или Периодичность = Перечисления.Периодичность.Квартал Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Месяц;
		
	Иначе
		Результат = Перечисления.ТочностьГрафикаПроизводства.День;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // } #юум

Функция юум_ФП_Калькулятор_ДочитатьДоступность(ДанныеРасчета, ПараметрыРасчета, Интервал, ИмяТаблицы)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ДочитатьДоступность.
	СтруктураПоиска = Новый Структура;
	ИмяПоляСсылка = "";
	Если ИмяТаблицы = "РасписаниеПодразделенийДень"
		Или ИмяТаблицы = "РасписаниеПодразделенийСекунда" Тогда
		СтруктураПоиска.Вставить("Подразделение");
		СтруктураПоиска.Вставить("Дата");
		СтруктураПоиска.Вставить("Начало");
		СтруктураПоиска.Вставить("Окончание");
		СтруктураПоиска.Вставить("ЭтоИндекс");
		ИмяПоляСсылка = "Подразделение";
	ИначеЕсли ИмяТаблицы = "ДоступностьВРЦ" Тогда
		СтруктураПоиска.Вставить("ВидРабочегоЦентра");
		СтруктураПоиска.Вставить("ДатаИнтервала");
		СтруктураПоиска.Вставить("НачалоИнтервала");
		СтруктураПоиска.Вставить("ОкончаниеИнтервала");
		СтруктураПоиска.Вставить("ЭтоИндекс");
		ИмяПоляСсылка = "ВидРабочегоЦентра"
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, Интервал);
	
	Если ПараметрыРасчета.КруглосуточнаяРаботаБезВыходных Тогда
		ГраницаДоступности = Новый Структура("Граница", '39990101');
	Иначе
		ГраницаДоступности = ДанныеРасчета.ГраницыДоступности.Найти(Интервал[ИмяПоляСсылка], "Ссылка");
		Если ГраницаДоступности = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Пока ГраницаДоступности.Граница > ПараметрыРасчета.ДоступностьГраницаВыборки Цикл
		юум_ФП_Калькулятор_ПрочитатьДоступность(ПараметрыРасчета.Заказ, ДанныеРасчета, ПараметрыРасчета);
		
		НайденныеСтроки = ДанныеРасчета[ИмяТаблицы].НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Интервал = НайденныеСтроки[0]; // Текущий интервал в новой таблице может использоваться в вызывающем методе
		Индекс = ДанныеРасчета[ИмяТаблицы].Индекс(Интервал) + 1;
		
		Пока Индекс < ДанныеРасчета[ИмяТаблицы].Количество() Цикл
			Если ДанныеРасчета[ИмяТаблицы][Индекс][ИмяПоляСсылка] <> Интервал[ИмяПоляСсылка] Тогда
				Прервать;
			ИначеЕсли Не ДанныеРасчета[ИмяТаблицы][Индекс].ЭтоИндекс Тогда
				Возврат Истина;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ДочитатьДоступностьИНайтиИнтервал(ДанныеРасчета, ПараметрыРасчета, Ссылка, ИмяТаблицы, СтруктураПоиска, Дата)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ДочитатьДоступностьИНайтиИнтервал.
	Если ПараметрыРасчета.КруглосуточнаяРаботаБезВыходных Тогда
		ГраницаДоступности = Новый Структура("Граница", '39990101');
	Иначе
		ГраницаДоступности = ДанныеРасчета.ГраницыДоступности.Найти(Ссылка, "Ссылка");
		Если ГраницаДоступности = Неопределено
			ИЛИ ГраницаДоступности.Граница < Дата Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Граница = Мин(КонецМесяца(ДобавитьМесяц(Дата, 2)), ГраницаДоступности.Граница);
	юум_ФП_Калькулятор_ПрочитатьДоступность(ПараметрыРасчета.Заказ, ДанныеРасчета, ПараметрыРасчета, Граница);
	
	НайденныеСтроки = ДанныеРасчета[ИмяТаблицы].НайтиСтроки(СтруктураПоиска);
	
	Возврат НайденныеСтроки;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ЗагрузитьГруппуВРЦ(ДанныеРасчета, ПараметрыРасчета, Этап, ВидыРабочихЦентров)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ЗагрузитьГруппуВРЦ.
	ЕстьАльтернативы = Ложь;
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыРасчета.КлючПартияЭтап, Этап, "КлючПартия, Этап");
		ЕстьАльтернативы = ДанныеРасчета.АльтернативныеВидыРЦ.НайтиСтроки(ПараметрыРасчета.КлючПартияЭтап).Количество() <> 0;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидыРабочихЦентров) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	юум_СтрокаВидов = ВидыРабочихЦентров[0];
	
	Если Не ЗначениеЗаполнено(юум_СтрокаВидов.ВремяЗагрузка) Тогда // попался Null
		юум_СтрокаВидов.ВремяЗагрузка = 0;	
	КонецЕсли;
	
	МаксимальнаяДоступностьВРЦ = юум_ФП_Калькулятор_ПолучитьМаксимальнуюДоступностьВРЦ(юум_СтрокаВидов);
	
	Если ЕстьАльтернативы Тогда
		Результат = юум_ФП_Калькулятор_ПодобратьГруппуИзАльтернативныхВРЦ(ДанныеРасчета, ПараметрыРасчета, Этап, ВидыРабочихЦентров);
		Если Результат = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
		ВидыРабочихЦентров = Результат.Группа;
		ВедущийВидРЦ = ВидыРабочихЦентров[0];
		ИнтервалРазмещения = Результат.ИнтервалРазмещения;
	Иначе
		ВедущийВидРЦ = ВидыРабочихЦентров[0];
		
		ИнтервалРазмещения = юум_ФП_Калькулятор_НачальныйИнтервалРазмещенияВРЦ(ДанныеРасчета, ПараметрыРасчета, Этап, ВедущийВидРЦ);
		Если ИнтервалРазмещения = Неопределено Тогда
			юум_ФП_Калькулятор_ОбработатьОшибкуНеНайденаДоступностьВРЦ(ПараметрыРасчета, Этап, ВедущийВидРЦ);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ОсталосьРазместить = ВедущийВидРЦ.ВремяЗагрузка;
	Начало = '00010101';
	Окончание = '00010101';
	КоличествоИнтервалов = 0;
	Интервалы = Новый Массив;
	
	Пока Истина Цикл
		Интервалы.Добавить(ИнтервалРазмещения);
		ВремяЗагрузка = МИН(ОсталосьРазместить,
			ИнтервалРазмещения.МаксимумВремяЗагрузка * ВедущийВидРЦ.КоличествоРЦКЗагрузке,
			ИнтервалРазмещения.ДоступноВремяЗагрузка);
		
		// Подбор интервалов дополнительных видов РЦ
		Пока Интервалы.Количество() <> ВидыРабочихЦентров.Количество() Цикл
			Для ИндексВидыРЦ = 1 По ВидыРабочихЦентров.Количество()-1 Цикл
				ДопВидРЦ = ВидыРабочихЦентров[ИндексВидыРЦ];
				
				ПараметрыРасчета.ПоискВРЦНеИндекс.ВидРабочегоЦентра = ДопВидРЦ.ВидРабочегоЦентра;
				ПараметрыРасчета.ПоискВРЦНеИндекс.ДатаИнтервала = ИнтервалРазмещения.ДатаИнтервала;
				НайденныеСтроки = ДанныеРасчета.ДоступностьВРЦ.НайтиСтроки(ПараметрыРасчета.ПоискВРЦНеИндекс);
				
				Если НайденныеСтроки.Количество() > 0
					И НайденныеСтроки[0].ДоступноВремяЗагрузка > 0 Тогда
					// Интервал дополнительного вида найден и доступен
					ВремяЗагрузка = МИН(ВремяЗагрузка,
					 	НайденныеСтроки[0].ДоступноВремяЗагрузка, МаксимальнаяДоступностьВРЦ);
					Интервалы.Добавить(НайденныеСтроки[0]);
				Иначе
					// Интервал дополнительного вида не найден или недоступен
					Если Этап.Непрерывный Тогда
						// Откат размещения
						Для Счетчик = 1 По КоличествоИнтервалов Цикл
							СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1];
							СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка = СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка + СтрокаЗагрузка.ЗанятоВремяЗагрузка;
							СтрокаЗагрузка.Интервал.ДоступноВремя = СтрокаЗагрузка.Интервал.ДоступноВремя + СтрокаЗагрузка.Занято;
							ДанныеРасчета.ЗагрузкаВРЦ.Удалить(СтрокаЗагрузка);
						КонецЦикла;
						
						Этап.ОграниченПоОборудованию = Истина;
						
						ОсталосьРазместить = ВедущийВидРЦ.ВремяЗагрузка;
						Начало = '00010101';
						КоличествоИнтервалов = 0;
					ИначеЕсли ОсталосьРазместить = ВедущийВидРЦ.ВремяЗагрузка Тогда
						Этап.ОграниченПоОборудованию = Истина;
					КонецЕсли;
					
					// Поиск нового интервала основного вида РЦ
					Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
					КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
					Пока Индекс < КоличествоСтрок Цикл
						// Дочитать доступность
						Если Индекс = КоличествоСтрок - 1
							ИЛИ ДанныеРасчета.ДоступностьВРЦ[Индекс + 1].ВидРабочегоЦентра <> ВедущийВидРЦ.ВидРабочегоЦентра Тогда
							ЕстьЗаписи = юум_ФП_Калькулятор_ДочитатьДоступность(ДанныеРасчета, ПараметрыРасчета, ИнтервалРазмещения, "ДоступностьВРЦ");
							Если Не ЕстьЗаписи Тогда
								юум_ФП_Калькулятор_ОбработатьОшибкуНеНайденаДоступностьВРЦ(ПараметрыРасчета, Этап, ВедущийВидРЦ);
								Возврат Ложь;
							КонецЕсли;
							
							Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
							КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
						КонецЕсли;
						
						Индекс = Индекс + 1;
						ИнтервалРазмещения = ДанныеРасчета.ДоступностьВРЦ[Индекс];
						Если ИнтервалРазмещения.ДоступноВремяЗагрузка > 0 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Интервалы.Очистить();
					Интервалы.Добавить(ИнтервалРазмещения);
					
					ВремяЗагрузка = МИН(ОсталосьРазместить,
						ИнтервалРазмещения.МаксимумВремяЗагрузка * ВедущийВидРЦ.КоличествоРЦКЗагрузке,
						ИнтервалРазмещения.ДоступноВремяЗагрузка);
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Для Индекс = 0 По ВидыРабочихЦентров.Количество()-1 Цикл
			ТекущийВидРЦ = ВидыРабочихЦентров[Индекс];
			Интервал = Интервалы[Индекс];
			
			НоваяСтрока = ДанныеРасчета.ЗагрузкаВРЦ.Добавить();
			НоваяСтрока.Распоряжение = Этап.ЗаказНаПроизводство;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Этап, "Этап, КлючПартия, Подразделение");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Интервал, "ВидРабочегоЦентра, ДатаИнтервала, Смена");
			
			НоваяСтрока.ЗанятоВремяЗагрузка = ВремяЗагрузка;
			Если НЕ ТекущийВидРЦ.ПараллельнаяЗагрузка Тогда
				НоваяСтрока.Занято = ВремяЗагрузка;
			Иначе
				НоваяСтрока.Занято = ?(ВремяЗагрузка = Интервал.ДоступноВремяЗагрузка,
					Интервал.ДоступноВремя,
					Окр(ВремяЗагрузка / ТекущийВидРЦ.МаксимальнаяЗагрузка));
			КонецЕсли;
			
			НоваяСтрока.Интервал = Интервал;
			КоличествоИнтервалов = КоличествоИнтервалов + 1;
			
			Интервал.ДоступноВремяЗагрузка = Интервал.ДоступноВремяЗагрузка - НоваяСтрока.ЗанятоВремяЗагрузка;
			Интервал.ДоступноВремя = Интервал.ДоступноВремя - НоваяСтрока.Занято;
		КонецЦикла;
		Интервалы.Очистить();
		
		ОсталосьРазместить = ОсталосьРазместить - ВремяЗагрузка;
		Если Начало = '00010101' Тогда
			Начало = ИнтервалРазмещения.НачалоИнтервала;
		КонецЕсли;
		
		Если ОсталосьРазместить = 0 Тогда
			Окончание = ИнтервалРазмещения.ОкончаниеИнтервала;
			Прервать;
		КонецЕсли;
		
		// Подбор следующего интервала
		Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
		КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
		Пока Индекс < КоличествоСтрок Цикл
			// Дочитать доступность
			Если Индекс = КоличествоСтрок - 1
				ИЛИ ДанныеРасчета.ДоступностьВРЦ[Индекс + 1].ВидРабочегоЦентра <> ВедущийВидРЦ.ВидРабочегоЦентра Тогда
				ЕстьЗаписи = юум_ФП_Калькулятор_ДочитатьДоступность(ДанныеРасчета, ПараметрыРасчета, ИнтервалРазмещения, "ДоступностьВРЦ");
				Если Не ЕстьЗаписи Тогда
					юум_ФП_Калькулятор_ОбработатьОшибкуНеНайденаДоступностьВРЦ(ПараметрыРасчета, Этап, ВедущийВидРЦ);
					Возврат Ложь;
				КонецЕсли;
				
				Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
				КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
			КонецЕсли;
			
			Индекс = Индекс + 1;
			ИнтервалРазмещения = ДанныеРасчета.ДоступностьВРЦ[Индекс];
			Если ИнтервалРазмещения.ДоступноВремяЗагрузка > 0 Тогда
				Прервать;
			ИначеЕсли НЕ ИнтервалРазмещения.ЭтоИндекс И Этап.Непрерывный Тогда
				// Откат размещения
				Для Счетчик = 1 По КоличествоИнтервалов Цикл
					СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1];
					СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка = СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка + СтрокаЗагрузка.ЗанятоВремяЗагрузка;
					СтрокаЗагрузка.Интервал.ДоступноВремя = СтрокаЗагрузка.Интервал.ДоступноВремя + СтрокаЗагрузка.Занято;
					ДанныеРасчета.ЗагрузкаВРЦ.Удалить(СтрокаЗагрузка);
				КонецЦикла;
				
				Этап.ОграниченПоОборудованию = Истина;
				
				ОсталосьРазместить = ВедущийВидРЦ.ВремяЗагрузка;
				Начало = '00010101';
				КоличествоИнтервалов = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Этап.НачалоЗагрузкиВРЦ = Начало;
	Этап.ОкончаниеЗагрузкиВРЦ = Окончание;
	Этап.ВидРабочегоЦентра = ВедущийВидРЦ.ВидРабочегоЦентра;
	
	Возврат Истина;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ЗагрузитьОдиночныйВРЦ(ДанныеРасчета, ПараметрыРасчета, Этап, ВидРЦ, ЭтоАльтернативный = Ложь)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ЗагрузитьОдиночныйВРЦ.
	Отказ = Ложь;
	
	ИнтервалРазмещения = юум_ФП_Калькулятор_НачальныйИнтервалРазмещенияВРЦ(ДанныеРасчета, ПараметрыРасчета, Этап, ВидРЦ);
	Если ИнтервалРазмещения = Неопределено Тогда
		юум_ФП_Калькулятор_ОбработатьОшибкуНеНайденаДоступностьВРЦ(ПараметрыРасчета, Этап, ВидРЦ);
		Отказ = Истина;
	КонецЕсли;
	
	ОсталосьРазместить = ВидРЦ.ВремяЗагрузка;
	Начало = '00010101';
	Окончание = '00010101';
	КоличествоИнтервалов = 0;
	ВидРабочегоЦентра = Неопределено;
	МаксимальнаяДоступностьВРЦ = юум_ФП_Калькулятор_ПолучитьМаксимальнуюДоступностьВРЦ(ВидРЦ);
	
	Пока НЕ Отказ Цикл
		ВремяЗагрузка = МИН(ОсталосьРазместить,
			 ИнтервалРазмещения.ДоступноВремяЗагрузка, МаксимальнаяДоступностьВРЦ);
		
		Если ИнтервалРазмещения.НачалоИнтервала < ПараметрыРасчета.ТекущаяДата
			И ИнтервалРазмещения.ОкончаниеИнтервала > ПараметрыРасчета.ТекущаяДата Тогда
			ВремяЗагрузка = Мин(ВремяЗагрузка,
				?(НЕ ВидРЦ.ПараллельнаяЗагрузка,
					(ИнтервалРазмещения.ОкончаниеИнтервала - ПараметрыРасчета.ТекущаяДата)
						* ВидРЦ.КоличествоРЦКЗагрузке,
					(ИнтервалРазмещения.ОкончаниеИнтервала - ПараметрыРасчета.ТекущаяДата)
						* ВидРЦ.КоличествоРЦКЗагрузке
						* ВидРЦ.МаксимальнаяЗагрузка));
		КонецЕсли;
		
		НоваяСтрока = ДанныеРасчета.ЗагрузкаВРЦ.Добавить();
		НоваяСтрока.Распоряжение = Этап.ЗаказНаПроизводство;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Этап, "Этап, КлючПартия, Подразделение");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ИнтервалРазмещения, "ВидРабочегоЦентра, ДатаИнтервала, Смена");
		
		НоваяСтрока.ЗанятоВремяЗагрузка = ВремяЗагрузка;
		Если НЕ ВидРЦ.ПараллельнаяЗагрузка Тогда
			НоваяСтрока.Занято = ВремяЗагрузка;
		Иначе
			НоваяСтрока.Занято = ?(ВремяЗагрузка = ИнтервалРазмещения.ДоступноВремяЗагрузка,
				ИнтервалРазмещения.ДоступноВремя,
				Окр(ВремяЗагрузка / ВидРЦ.МаксимальнаяЗагрузка));
		КонецЕсли;
		
		НоваяСтрока.Интервал = ИнтервалРазмещения;
		КоличествоИнтервалов = КоличествоИнтервалов + 1;
		
		ИнтервалРазмещения.ДоступноВремяЗагрузка = ИнтервалРазмещения.ДоступноВремяЗагрузка - НоваяСтрока.ЗанятоВремяЗагрузка;
		ИнтервалРазмещения.ДоступноВремя = ИнтервалРазмещения.ДоступноВремя - НоваяСтрока.Занято;
		
		ОсталосьРазместить = ОсталосьРазместить - ВремяЗагрузка;
		Если Начало = '00010101' Тогда
			Начало = ИнтервалРазмещения.НачалоИнтервала;
		КонецЕсли;
		
		Если ОсталосьРазместить = 0 Тогда
			Окончание = ИнтервалРазмещения.ОкончаниеИнтервала;
			ВидРабочегоЦентра = ВидРЦ.ВидРабочегоЦентра;
			Прервать;
		КонецЕсли;
		
		// Подбор следующего интервала
		Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
		КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
		Пока Индекс < КоличествоСтрок Цикл
			// Дочитать доступность
			Если Индекс = КоличествоСтрок - 1
				ИЛИ ДанныеРасчета.ДоступностьВРЦ[Индекс + 1].ВидРабочегоЦентра <> ВидРЦ.ВидРабочегоЦентра Тогда
				ЕстьЗаписи = юум_ФП_Калькулятор_ДочитатьДоступность(ДанныеРасчета, ПараметрыРасчета, ИнтервалРазмещения, "ДоступностьВРЦ");
				Если Не ЕстьЗаписи Тогда
					юум_ФП_Калькулятор_ОбработатьОшибкуНеНайденаДоступностьВРЦ(ПараметрыРасчета, Этап, ВидРЦ);
					Отказ = Истина;
					Прервать;
				КонецЕсли;
				
				Индекс = ДанныеРасчета.ДоступностьВРЦ.Индекс(ИнтервалРазмещения);
				КоличествоСтрок = ДанныеРасчета.ДоступностьВРЦ.Количество();
			КонецЕсли;
			
			Индекс = Индекс + 1;
			ИнтервалРазмещения = ДанныеРасчета.ДоступностьВРЦ[Индекс];
			Если ИнтервалРазмещения.ДоступноВремяЗагрузка > 0 Тогда
				Прервать;
			ИначеЕсли НЕ ИнтервалРазмещения.ЭтоИндекс И Этап.Непрерывный Тогда
				// Откат размещения
				Для Счетчик = 1 По КоличествоИнтервалов Цикл
					СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1];
					СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка = СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка + СтрокаЗагрузка.ЗанятоВремяЗагрузка;
					СтрокаЗагрузка.Интервал.ДоступноВремя = СтрокаЗагрузка.Интервал.ДоступноВремя + СтрокаЗагрузка.Занято;
					ДанныеРасчета.ЗагрузкаВРЦ.Удалить(СтрокаЗагрузка);
				КонецЦикла;
				
				Этап.ОграниченПоОборудованию = Истина;
				
				ОсталосьРазместить = ВидРЦ.ВремяЗагрузка;
				Начало = '00010101';
				КоличествоИнтервалов = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ
		И НЕ ЭтоАльтернативный Тогда
		
		ДатаПервогоИнтервала = '00010101';
		Если ВидРЦ.ИнтервалПланирования = Перечисления.ТочностьГрафикаПроизводства.Неделя Тогда
			ДатаПервогоИнтервала = НачалоНедели(Этап.НачалоРазмещения);
		ИначеЕсли ВидРЦ.ИнтервалПланирования = Перечисления.ТочностьГрафикаПроизводства.Месяц Тогда
			ДатаПервогоИнтервала = НачалоМесяца(Этап.НачалоРазмещения);
		Иначе
			ДатаПервогоИнтервала = НачалоДня(Этап.НачалоРазмещения);
		КонецЕсли;
		
		РазмещенВПервомИнтервале = Ложь;
		Если НЕ Отказ И КоличествоИнтервалов = 1 Тогда
			СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1];
			РазмещенВПервомИнтервале = СтрокаЗагрузка.Интервал.ДатаИнтервала = ДатаПервогоИнтервала;
		КонецЕсли;
		
		Если НЕ РазмещенВПервомИнтервале Тогда
			ЭтапКопия = ДанныеРасчета.ЭтапКопия;
			ЗаполнитьЗначенияСвойств(ЭтапКопия, Этап);
			
			ЗаполнитьЗначенияСвойств(ПараметрыРасчета.ЭтапКлючСвязи, ВидРЦ);
			Альтернативы = ДанныеРасчета.АльтернативныеВидыРЦ.НайтиСтроки(ПараметрыРасчета.ЭтапКлючСвязи);
			
			Для каждого Альтернатива Из Альтернативы Цикл
				ЭтапКопия.ОграниченПоОборудованию = Ложь;
				ЭтапКопия.НачалоЗагрузкиВРЦ = '00010101';
				ЭтапКопия.ОкончаниеЗагрузкиВРЦ = '00010101';
				
				ИндексЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1;
				
				ЭтапРазмещен = юум_ФП_Калькулятор_ЗагрузитьОдиночныйВРЦ(ДанныеРасчета, ПараметрыРасчета, ЭтапКопия, Альтернатива, Истина);
				
				Если ЭтапРазмещен
					И (ЭтапКопия.ОкончаниеЗагрузкиВРЦ < Окончание
						ИЛИ Окончание = '00010101') Тогда
					Отказ = Ложь;
					Начало = ЭтапКопия.НачалоЗагрузкиВРЦ;
					Окончание = ЭтапКопия.ОкончаниеЗагрузкиВРЦ;
					ВидРабочегоЦентра = Альтернатива.ВидРабочегоЦентра;
					
					Этап.ОграниченПоОборудованию = ЭтапКопия.ОграниченПоОборудованию;
					
					// Откат предыдущего размещения
					Для Счетчик = 1 По КоличествоИнтервалов Цикл
						СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ИндексЗагрузка];
						СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка = СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка + СтрокаЗагрузка.ЗанятоВремяЗагрузка;
						СтрокаЗагрузка.Интервал.ДоступноВремя = СтрокаЗагрузка.Интервал.ДоступноВремя + СтрокаЗагрузка.Занято;
						ДанныеРасчета.ЗагрузкаВРЦ.Удалить(СтрокаЗагрузка);
						ИндексЗагрузка = ИндексЗагрузка - 1;
					КонецЦикла;
					
					КоличествоИнтервалов = ДанныеРасчета.ЗагрузкаВРЦ.Количество() - 1 - ИндексЗагрузка;
					
					Если КоличествоИнтервалов = 1 Тогда
						СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ДанныеРасчета.ЗагрузкаВРЦ.Количество()-1];
						РазмещенВПервомИнтервале = СтрокаЗагрузка.Интервал.ДатаИнтервала = ДатаПервогоИнтервала;
						Если РазмещенВПервомИнтервале Тогда
							Прервать;
						КонецЕсли;
					КонецЕсли;
				Иначе
					// Откат размещения альтернативного
					КоличествоКУдалению = ДанныеРасчета.ЗагрузкаВРЦ.Количество() - 1 - ИндексЗагрузка;
					Для Счетчик = 1 По КоличествоКУдалению Цикл
						СтрокаЗагрузка = ДанныеРасчета.ЗагрузкаВРЦ[ИндексЗагрузка+1];
						СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка = СтрокаЗагрузка.Интервал.ДоступноВремяЗагрузка + СтрокаЗагрузка.ЗанятоВремяЗагрузка;
						СтрокаЗагрузка.Интервал.ДоступноВремя = СтрокаЗагрузка.Интервал.ДоступноВремя + СтрокаЗагрузка.Занято;
						ДанныеРасчета.ЗагрузкаВРЦ.Удалить(СтрокаЗагрузка);
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Этап.НачалоЗагрузкиВРЦ = Начало;
		Этап.ОкончаниеЗагрузкиВРЦ = Окончание;
		Этап.ВидРабочегоЦентра = ВидРабочегоЦентра;
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ИнтервалВыборкиДоступности(ДанныеРасчета)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ИнтервалВыборкиДоступности.
	РеквизитыЗаказа = ДанныеРасчета.РеквизитыЗаказа;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	МАКСИМУМ(СтруктураПредприятия.ИнтервалПланирования
		|		= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Месяц))  КАК ЕстьМесяц,
		|	МАКСИМУМ(СтруктураПредприятия.ИнтервалПланирования
		|		= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Неделя)) КАК ЕстьНеделя,
		|	МАКСИМУМ(СтруктураПредприятия.ИнтервалПланирования
		|		= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Смена))  КАК ЕстьСмена,
		|	МАКСИМУМ(СтруктураПредприятия.ИнтервалПланирования
		|		= ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Час))    КАК ЕстьЧас
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
		|ГДЕ
		|	НЕ СтруктураПредприятия.ПометкаУдаления
		|	И СтруктураПредприятия.ПроизводственноеПодразделение
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(СтруктураПредприятия.Ссылка) > 0");
	ВыборкаПодразделения = Запрос.Выполнить().Выбрать();
	
	Начало = ?(РеквизитыЗаказа.НачатьНеРанее < ТекущаяДатаСеанса(),
		НачалоДня(ТекущаяДатаСеанса()),
		НачалоДня(РеквизитыЗаказа.НачатьНеРанее));
	ЕстьИнтервалЧас = Ложь;
	
	Если ВыборкаПодразделения.Следующий() Тогда
		НачалоМесяца = ?(ВыборкаПодразделения.ЕстьМесяц, НачалоМесяца(Начало), Начало);
		НачалоНедели = ?(ВыборкаПодразделения.ЕстьНеделя, НачалоНедели(Начало), Начало);
		НачалоСмены = ?(ВыборкаПодразделения.ЕстьСмена, НачалоДня(Начало - 86400), Начало);
		Начало = Мин(НачалоМесяца, НачалоНедели, НачалоСмены);
		
		ЕстьИнтервалЧас = ВыборкаПодразделения.ЕстьЧас;
	КонецЕсли;
	
	Окончание = '00010101';
	Если Начало > РеквизитыЗаказа.ДатаПотребности Тогда
		Окончание = КонецМесяца(ДобавитьМесяц(Начало, 3));
	ИначеЕсли ЕстьИнтервалЧас
		И РеквизитыЗаказа.РазностьДатВМесяцах > 6 Тогда
		Окончание = КонецМесяца(ДобавитьМесяц(Начало, 6));
	ИначеЕсли РеквизитыЗаказа.РазностьДатВМесяцах > 18 Тогда
		Окончание = КонецМесяца(ДобавитьМесяц(Начало, 18));
	Иначе
		Окончание = КонецМесяца(ДобавитьМесяц(РеквизитыЗаказа.ДатаПотребности, 3));
	КонецЕсли;
	
	Возврат Новый Структура("Начало, Окончание", Начало, Окончание);
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_НачальныйИнтервалПодразделенияВДнях(ДанныеРасчета, ПараметрыРасчета, Подразделение, НачалоРазмещения, РазмещатьКНачалу)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: НачальныйИнтервалПодразделенияВДнях.
	Если РазмещатьКНачалу Тогда
		ПараметрыРасчета.ПодразделениеДата.Подразделение = Подразделение;
		ПараметрыРасчета.ПодразделениеДата.Дата = НачалоДня(НачалоРазмещения);
		
		НайденныеСтроки = ДанныеРасчета.РасписаниеПодразделенийДень.НайтиСтроки(ПараметрыРасчета.ПодразделениеДата);
		Если НайденныеСтроки.Количество() = 0 Тогда
			НайденныеСтроки = юум_ФП_Калькулятор_ДочитатьДоступностьИНайтиИнтервал(
				ДанныеРасчета, ПараметрыРасчета, Подразделение, "РасписаниеПодразделенийДень", ПараметрыРасчета.ПодразделениеДата, НачалоРазмещения);
			Если НайденныеСтроки = Неопределено
				ИЛИ НайденныеСтроки.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ НайденныеСтроки[0].ЭтоИндекс
			И НачалоРазмещения <= НайденныеСтроки[0].Начало Тогда
			Возврат НайденныеСтроки[0];
		Иначе
			Интервал = НайденныеСтроки[0];
			Индекс = ДанныеРасчета.РасписаниеПодразделенийДень.Индекс(Интервал);
			КоличествоСтрок = ДанныеРасчета.РасписаниеПодразделенийДень.Количество();
			Пока Индекс < КоличествоСтрок Цикл
				// Дочитать доступность
				Если Индекс = КоличествоСтрок - 1
					ИЛИ ДанныеРасчета.РасписаниеПодразделенийДень[Индекс + 1].Подразделение <> Подразделение Тогда
					ЕстьЗаписи = юум_ФП_Калькулятор_ДочитатьДоступность(ДанныеРасчета, ПараметрыРасчета, Интервал, "РасписаниеПодразделенийДень");
					Если Не ЕстьЗаписи Тогда
						Возврат Неопределено;
					КонецЕсли;
					
					Индекс = ДанныеРасчета.РасписаниеПодразделенийДень.Индекс(Интервал);
					КоличествоСтрок = ДанныеРасчета.РасписаниеПодразделенийДень.Количество();
				КонецЕсли;
				
				Индекс = Индекс + 1;
				Интервал = ДанныеРасчета.РасписаниеПодразделенийДень[Индекс];
				Если НЕ Интервал.ЭтоИндекс
					И НачалоРазмещения <= Интервал.Начало Тогда
					Возврат Интервал;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ПараметрыРасчета.ПодразделениеДата.Подразделение = Подразделение;
		ПараметрыРасчета.ПодразделениеДата.Дата = ?(НачалоРазмещения = НачалоДня(НачалоРазмещения),
			НачалоРазмещения - 86400,
			НачалоДня(НачалоРазмещения));
		
		НайденныеСтроки = ДанныеРасчета.РасписаниеПодразделенийДень.НайтиСтроки(ПараметрыРасчета.ПодразделениеДата);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат Неопределено;
		ИначеЕсли НЕ НайденныеСтроки[НайденныеСтроки.ВГраница()].ЭтоИндекс
			И НачалоРазмещения >= НайденныеСтроки[НайденныеСтроки.ВГраница()].Окончание Тогда
			Возврат НайденныеСтроки[НайденныеСтроки.ВГраница()];
		Иначе
			Интервал = НайденныеСтроки[НайденныеСтроки.ВГраница()];
			Индекс = ДанныеРасчета.РасписаниеПодразделенийДень.Индекс(Интервал);
			Пока Индекс > 0 Цикл
				Индекс = Индекс - 1;
				Интервал = ДанныеРасчета.РасписаниеПодразделенийДень[Индекс];
				Если Интервал.Подразделение <> Подразделение Тогда
					Возврат Неопределено;
				ИначеЕсли НЕ Интервал.ЭтоИндекс
					И НачалоРазмещения >= Интервал.Окончание Тогда
					Возврат Интервал;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;
	
// } #юум
КонецФункции


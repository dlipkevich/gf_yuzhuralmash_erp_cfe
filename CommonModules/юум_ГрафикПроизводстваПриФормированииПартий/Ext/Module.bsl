				ДанныеРасчета, ПараметрыРасчета, Этап, Этап.ДлительностьЭтапа, Этап.НачалоРазмещения, РазмещатьКНачалу);
		Иначе
			ЭтапРазмещен = юум_ФП_Калькулятор_РазместитьПоРасписаниюПодразделенияВСекундах(
				ДанныеРасчета, ПараметрыРасчета, Этап, Этап.ДлительностьЭтапа, Этап.НачалоРазмещения, РазмещатьКНачалу);
		КонецЕсли;
		
		Если НЕ ЭтапРазмещен Тогда
			Возврат;
		КонецЕсли;
		
		Этап.Начало = ПараметрыРасчета.НачалоОкончание.Начало;
		Этап.Окончание = ПараметрыРасчета.НачалоОкончание.Окончание - 1;
	КонецЕсли;
	
	Этап.ГрафикИзменен = Этап.НачалоДоИзменения <> Этап.Начало
		ИЛИ Этап.ОкончаниеДоИзменения <> Этап.Окончание;
	
// } #юум
КонецПроцедуры

Процедура юум_ФП_Калькулятор_РассчитатьВремяВидовРЦПоФормулам(ВидыРЦ, ИзделияКРасчетуВидовРЦПоФормуле)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: РассчитатьВремяВидовРЦПоФормулам.
	Если ИзделияКРасчетуВидовРЦПоФормуле.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВидыРЦ.Индексы.Добавить("КлючПартия, Этап, ВидРабочегоЦентра");
	СтруктураПоиска = Новый Структура("КлючПартия, Этап, ВидРабочегоЦентра");
	
	ДанныеСпецификаций = Справочники.РесурсныеСпецификации.ДанныеСпецификацииПоСпискуНоменклатуры(
		ИзделияКРасчетуВидовРЦПоФормуле,
		Справочники.РесурсныеСпецификации.ПараметрыВыборкиДанных("ВидыРабочихЦентров"),
		Истина,
		"КлючПартия");
	
	Для каждого ДанныеСпецификации Из ДанныеСпецификаций Цикл
		СтруктураПоиска.КлючПартия = ДанныеСпецификации.КлючПартия;
		Для каждого Строка Из ДанныеСпецификации.ВидыРабочихЦентров Цикл
			Если ПустаяСтрока(Строка.АлгоритмРасчетаКоличества) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Строка, "Этап, ВидРабочегоЦентра");
			НайденныеСтроки = ВидыРЦ.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() <> 0 Тогда
				НайденныеСтроки[0].ВремяЗагрузка = Строка.ВремяРаботы * НайденныеСтроки[0].КоэффициентРасчетаПоФормуле;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
// } #юум
КонецПроцедуры

// Рассчитать порядок ремонта.
// 
// Параметры:
//  ДанныеРасчета - Структура:
//   * Этапы - ТаблицаЗначений
//   * Связи - ТаблицаЗначений
//  ПартииРемонтаКРасчетуПорядка - ТаблицаЗначений
//
Процедура юум_ФП_Калькулятор_РассчитатьПорядокРемонта(ДанныеРасчета, ПартииРемонтаКРасчетуПорядка)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: РассчитатьПорядокРемонта.
	СвязиКопия = ДанныеРасчета.Связи.Скопировать();
	СвязиКопия.Индексы.Добавить("КлючПартия, Этап");
	СвязиКопия.Индексы.Добавить("КлючПартия, Этап, КлючПартияПредшественник");
	
	ДанныеРасчета.Этапы.Индексы.Добавить("КлючПартия, ЭтоНачальныйЭтапРемонта");
	ПартииРемонтаКРасчетуПорядка.Индексы.Добавить("КлючПартияПредшественник");
	
	ПоискЭтап = Новый Структура("КлючПартия, Этап");
	ПоискВнутренняяСвязь = Новый Структура("КлючПартия, Этап, КлючПартияПредшественник");
	ПоискПартияПредшественник = Новый Структура("КлючПартияПредшественник");
	ПоискНачальныйЭтап = Новый Структура("КлючПартия, ЭтоНачальныйЭтапРемонта", Неопределено, Истина);
	
	// Наследование реквизита Ресурсоемкость вложенных ремонтов вверх по дереву
	Для Индекс = 0 По ПартииРемонтаКРасчетуПорядка.Количество()-1 Цикл
		
		СтрокаПартия = ПартииРемонтаКРасчетуПорядка[Индекс];
		ЗаполнитьЗначенияСвойств(ПоискЭтап, СтрокаПартия);
		НайденныеСтроки = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтап);
		Если НайденныеСтроки.Количество() = 0
			ИЛИ НайденныеСтроки[0].Ресурсоемкость >= СтрокаПартия.Ресурсоемкость Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаЭтап = НайденныеСтроки[0];
		РесурсоемкостьЭтапаДоИзменения = СтрокаЭтап.Ресурсоемкость;
		СтрокаЭтап.Ресурсоемкость = СтрокаПартия.Ресурсоемкость;
		
		ПоискПартияПредшественник.КлючПартияПредшественник = СтрокаЭтап.КлючПартия;
		НайденныеСтроки = ПартииРемонтаКРасчетуПорядка.НайтиСтроки(ПоискПартияПредшественник);
		Для каждого СтрокаПартияПоследователь Из НайденныеСтроки Цикл
			СтрокаПартияПоследователь.Ресурсоемкость = СтрокаПартияПоследователь.Ресурсоемкость
				- РесурсоемкостьЭтапаДоИзменения
				+ СтрокаЭтап.Ресурсоемкость;
		КонецЦикла;
		
	КонецЦикла;
	
	// Обход этапов справа - налево
	Для Индекс = 0 По ДанныеРасчета.Этапы.Количество()-1 Цикл
		СтрокаЭтап = ДанныеРасчета.Этапы[Индекс];
		Порядок = СтрокаЭтап.Порядок + СтрокаЭтап.Ресурсоемкость;
		
		ЗаполнитьЗначенияСвойств(ПоискЭтап, СтрокаЭтап);
		
		Для каждого СтрокаСвязь Из СвязиКопия.НайтиСтроки(ПоискЭтап) Цикл
			ПоискЭтап.КлючПартия = СтрокаСвязь.КлючПартияПредшественник;
			ПоискЭтап.Этап = СтрокаСвязь.ЭтапПредшественник;
			
			// Расчет порядка этапов
			Для каждого СтрокаЭтапПредшественник Из ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтап) Цикл
				Если СтрокаЭтап.ЭтоПланированиеРабот
					И СтрокаЭтап.КлючПартия <> СтрокаЭтапПредшественник.КлючПартия Тогда
					СтрокаЭтапПредшественник.Порядок = СтрокаЭтап.Порядок;
				ИначеЕсли СтрокаЭтапПредшественник.Порядок < Порядок Тогда
					СтрокаЭтапПредшественник.Порядок = Порядок;
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаЭтап.ЭтоПланированиеРабот
				И СтрокаЭтап.КлючПартия <> СтрокаСвязь.КлючПартияПредшественник Тогда
				ПоискНачальныйЭтап.КлючПартия = СтрокаСвязь.КлючПартияПредшественник;
				
				Для каждого СтрокаНачальныйЭтап Из ДанныеРасчета.Этапы.НайтиСтроки(ПоискНачальныйЭтап) Цикл
					// Заполнение Планировать не ранее
					Если СтрокаЭтап.ЭтоНачальныйЭтапРемонта
						И ЗначениеЗаполнено(СтрокаЭтап.ПланироватьНеРанееЭтап) Тогда
						СтрокаНачальныйЭтап.ПланироватьНеРанееЭтап = СтрокаЭтап.ПланироватьНеРанееЭтап;
						СтрокаНачальныйЭтап.ПланироватьНеРанееКлючПартия = СтрокаЭтап.ПланироватьНеРанееКлючПартия;
					Иначе
						СтрокаНачальныйЭтап.ПланироватьНеРанееЭтап = СтрокаЭтап.Этап;
						СтрокаНачальныйЭтап.ПланироватьНеРанееКлючПартия = СтрокаЭтап.КлючПартия;
					КонецЕсли;
					
					// Корректировка начала размещения
					Если СтрокаЭтап.ПланироватьНеРанее > СтрокаНачальныйЭтап.НачалоРазмещения Тогда
						СтрокаНачальныйЭтап.НачалоРазмещения = СтрокаЭтап.ПланироватьНеРанее;
					КонецЕсли;
					
					// Добавление связей
					ПоискВнутренняяСвязь.КлючПартия = СтрокаНачальныйЭтап.ПланироватьНеРанееКлючПартия;
					ПоискВнутренняяСвязь.КлючПартияПредшественник = СтрокаНачальныйЭтап.ПланироватьНеРанееКлючПартия;
					ПоискВнутренняяСвязь.Этап = СтрокаНачальныйЭтап.ПланироватьНеРанееЭтап;
					
					Для каждого СтрокаВнутренняяСвязь Из СвязиКопия.НайтиСтроки(ПоискВнутренняяСвязь) Цикл
						НоваяСтрока = ДанныеРасчета.Связи.Добавить();
						НоваяСтрока.КлючПартия = СтрокаНачальныйЭтап.КлючПартия;
						НоваяСтрока.Этап = СтрокаНачальныйЭтап.Этап;
						НоваяСтрока.КлючПартияПредшественник = СтрокаВнутренняяСвязь.КлючПартияПредшественник;
						НоваяСтрока.ЭтапПредшественник = СтрокаВнутренняяСвязь.ЭтапПредшественник;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрокаЭтап.ПланироватьНеРанееЭтап) Тогда
			ПоискЭтап.КлючПартия = СтрокаЭтап.ПланироватьНеРанееКлючПартия;
			ПоискЭтап.Этап = СтрокаЭтап.ПланироватьНеРанееЭтап;
			
			НайденныеСтроки = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтап);
			Если НайденныеСтроки.Количество() <> 0 Тогда
				СтрокаЭтапПланированияРабот = НайденныеСтроки[0];
				СтрокаЭтапПланированияРабот.Порядок = 
					Макс(СтрокаЭтапПланированияРабот.Порядок, СтрокаЭтап.Порядок + 0.0001);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеРасчета.Этапы.Сортировать("Порядок Убыв, НомерЭтапа");
	
// } #юум
КонецПроцедуры

Процедура юум_ФП_Калькулятор_СместитьЭтапыПоДлительности(ДанныеРасчета, ПараметрыРасчета)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: СместитьЭтапыПоДлительности.
	Этапы = ДанныеРасчета.Этапы; // ТаблицаЗначений
	Связи = ДанныеРасчета.Связи; // ТаблицаЗначений
	
	Этапы.ЗаполнитьЗначения('00010101', "НачалоРазмещения");
	
	СтруктураПоиска = Новый Структура("ЕстьПраваяГраница, СмещатьВправо", Истина, Истина);
	Для каждого СтрокаЭтап Из Этапы.НайтиСтроки(СтруктураПоиска) Цикл
		СтрокаЭтап.НачалоРазмещения = СтрокаЭтап.ПраваяГраница;
	КонецЦикла;
	
	СтруктураПоиска = ПараметрыРасчета.КлючПартияЭтап;
	
	Для Индекс = -(Этапы.Количество()-1) По 0 Цикл
		СтрокаЭтап = Этапы[-Индекс];
		
		Если СтрокаЭтап.СмещатьВправо
			И СтрокаЭтап.НачалоРазмещения <> '00010101'
			И СтрокаЭтап.НачалоРазмещения > СтрокаЭтап.Окончание + 1 Тогда
			ОкончаниеДоИзменения = СтрокаЭтап.Окончание;
			юум_ФП_Калькулятор_РазместитьЭтапПоДлительности(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап, Ложь);
			СтрокаЭтап.СмещенКПоследователю = СтрокаЭтап.Окончание > ОкончаниеДоИзменения;
		КонецЕсли;
		
		СтруктураПоиска.КлючПартия = СтрокаЭтап.КлючПартия;
		СтруктураПоиска.Этап = СтрокаЭтап.Этап;
		Для каждого СтрокаСвязь Из Связи.НайтиСтроки(СтруктураПоиска) Цикл
			СтруктураПоиска.КлючПартия = СтрокаСвязь.КлючПартияПредшественник;
			СтруктураПоиска.Этап = СтрокаСвязь.ЭтапПредшественник;
			
			СтрокиПредшественники = Этапы.НайтиСтроки(СтруктураПоиска);
			Если СтрокиПредшественники.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаПредшественник = СтрокиПредшественники[0];
			
			СтрокаПредшественник.НачалоСледующегоЭтапа = ?(СтрокаПредшественник.НачалоСледующегоЭтапа = '00010101',
				СтрокаЭтап.Начало,
				Мин(СтрокаПредшественник.НачалоСледующегоЭтапа, СтрокаЭтап.Начало));
			
			Если НЕ СтрокаПредшественник.СмещатьВправо Тогда
				Продолжить;
			ИначеЕсли СтрокаПредшественник.НачалоРазмещения = '00010101' Тогда
				СтрокаПредшественник.НачалоРазмещения = СтрокаЭтап.Начало;
			Иначе
				СтрокаПредшественник.НачалоРазмещения = Мин(
					СтрокаПредшественник.НачалоРазмещения,
					СтрокаЭтап.Начало);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
// } #юум
КонецПроцедуры

Функция юум_ФП_Калькулятор_ТекстЗапросаВТВыпускПартий()
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаВТВыпускПартий.
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СтруктураЗаказа.КлючПартия              КАК КлючПартия,
		|	СтруктураЗаказа.Спецификация            КАК Спецификация,
		|	СтруктураЗаказа.Номенклатура            КАК Номенклатура,
		|	СтруктураЗаказа.Характеристика          КАК Характеристика,
		|	СУММА(СтруктураЗаказа.Запланировано + СтруктураЗаказа.Запущено) КАК КоличествоЕдиниц,
		|	МАКСИМУМ(
		|		СпецификацииИзделий.КоличествоУпаковокНаЕдиницуПартииЗапуска
		|		* ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1))            КАК КоличествоЕдиницВПартии,
		|	АВТОНОМЕРЗАПИСИ()                       КАК Порядок
		|ПОМЕСТИТЬ ВТВыпускПартий
		|ИЗ
		|	ВТСтруктураЗаказа КАК СтруктураЗаказа
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СпецификацииИзделий КАК СпецификацииИзделий
		|	ПО СтруктураЗаказа.Спецификация = СпецификацииИзделий.Спецификация
		|		И СтруктураЗаказа.ВидНоменклатуры = СпецификацииИзделий.ВидНоменклатуры
		|		И СпецификацииИзделий.Номенклатура   В (СтруктураЗаказа.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
		|		И СпецификацииИзделий.Характеристика В (СтруктураЗаказа.Характеристика, ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
		|ГДЕ
		|	СтруктураЗаказа.ЭтоВыпуск
		|	И НЕ СтруктураЗаказа.ЭтоПеремещение
		|	
		|СГРУППИРОВАТЬ ПО
		|	СтруктураЗаказа.КлючПартия,
		|	СтруктураЗаказа.Спецификация,
		|	СтруктураЗаказа.Номенклатура,
		|	СтруктураЗаказа.Характеристика
		|	
		|ИМЕЮЩИЕ
		|	СУММА(СтруктураЗаказа.Запланировано + СтруктураЗаказа.Запущено) <> 0
		|	И МАКСИМУМ(
		|		ЕСТЬNULL(СпецификацииИзделий.КоличествоУпаковокНаЕдиницуПартииЗапуска, 1)
		|		* ЕСТЬNULL(&ТекстЗапросаКоэффициентУпаковки, 1)) <> 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючПартия";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаКоэффициентУпаковки",
		Справочники.УпаковкиЕдиницыИзмерения.ТекстЗапросаКоэффициентаУпаковки(
			"СпецификацииИзделий.Упаковка",
			"СпецификацииИзделий.Номенклатура"));
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаВТДатыНепланируемыхПредшественников(ТекстЗапросаОтбор)
	
// #юум { #ЧТЗ 04.01 Галфинд mr. Cherryman 2026/11/16
// Локальная зависимость прогноза: ТекстЗапросаВТДатыНепланируемыхПредшественников.
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Связи.КлючПартия           КАК КлючПартия,
		|	Связи.Этап                 КАК Этап,
		|	МАКСИМУМ(График.Окончание) КАК Окончание
		|ПОМЕСТИТЬ ВТДатыНепланируемыхПредшественников
		|ИЗ
		|	ВТСвязи КАК Связи
		|	
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
		|	ПО Связи.ЗаказНаПроизводствоПредшественник = График.ЗаказНаПроизводство
		|		И График.СтатусГрафика = 0
		|		И Связи.ЭтапПредшественник = График.Этап
		|		И Связи.КлючПартияПредшественник = График.КлючПартия
		|ГДЕ
		|	Связи.ЭтапПредшественник В (
		|		ВЫБРАТЬ
		|			Этапы.Ссылка
		|		ИЗ
		|			ВТЭтапыСРучнымРазмещением КАК Этапы
		|		ГДЕ
		|			НЕ &ОтменитьРучныеИзмененияГрафика
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			Этапы.Ссылка
		|		ИЗ
		|			Документ.ЭтапПроизводства2_2 КАК Этапы
		|		ГДЕ
		|			&ТекстЗапросаОтбор
		|			И Этапы.Проведен
		|			И Этапы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат))
		|
		|СГРУППИРОВАТЬ ПО
		|	Связи.КлючПартия,
		|	Связи.Этап
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КлючПартия, Этап";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаОтбор",
		СтрЗаменить(ТекстЗапросаОтбор, "&ТекстИмяТаблицы", "Этапы"));
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции

Функция юум_ФП_Калькулятор_ТекстЗапросаВТЗаказыНаРемонт(ТекстЗапросаОтбор)
	

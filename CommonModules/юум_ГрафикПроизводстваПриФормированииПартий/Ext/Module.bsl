// Изолированная проверка контекста заимствованного калькулятора.
// Не читает заказы, не рассчитывает график и не записывает данные.
// Возвращаемое значение:
// Структура - штатные параметры расчета графика без дополнительных настроек.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ПроверитьДоступККалькулятору() Экспорт
	МодельПрогноза = ГрафикПроизводстваСтруктурыЗаказа.юум_НоваяМодельПрогноза();
	Возврат МодельПрогноза.ПараметрыРасчета;
КонецФункции // } #юум

// Рассчитывает график с объемами формы без записи заказов, графика и заданий.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - доступный пользователю заказ.
//  ОбъемыФормы - ТаблицаЗначений - уникальные строки заказа, партии и ключа
//   номенклатуры; Требуется - весь запланированный остаток, Выбрано - новый
//   остаток с сохранением объема вне отборов формы. Запущенное не изменяется.
// Возвращаемое значение:
//  Структура - ГрафикЗапланирован, Ошибки, Оповещения, КоличествоЭтапов,
//   ДанныеРасчета - штатная модель с рассчитанной таблицей ЗагрузкаВРЦ.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьВПамяти(Знач Заказ, Знач ОбъемыФормы) Экспорт
    юум_ФП_ПроверитьОбъемы(Заказ, ОбъемыФормы);
    НастройкиПредварительногоПросмотра = Новый Структура;
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_ОбъемыФормы", ОбъемыФормы);
    Возврат юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Заказ, НастройкиПредварительногоПросмотра);
КонецФункции // } #юум

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Рассчитывает заказ с учетом уже рассчитанных более приоритетных заказов.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - текущий доступный заказ.
//  ОбъемыФормы - ТаблицаЗначений - остатки по ключам партии и номенклатуры.
//  КонтекстОчереди - Структура - Заказы: Массив ранее рассчитанных заказов;
//   Загрузка: ТаблицаЗначений с ВРЦ, датой, распоряжением, этапом и Занято.
// Возвращаемое значение:
//  Структура - график и диагностика без записи данных.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьПоОчереди(Знач Заказ, Знач ОбъемыФормы, Знач КонтекстОчереди) Экспорт
    юум_ФП_ПроверитьОбъемы(Заказ, ОбъемыФормы);
    НастройкиПредварительногоПросмотра = Новый Структура;
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_ОбъемыФормы", ОбъемыФормы);
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_КонтекстОчереди", КонтекстОчереди);
    Возврат юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Заказ, НастройкиПредварительногоПросмотра);
КонецФункции // } #юум

// Возвращает доступные заказы в том же порядке, что штатный график.
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - заказы формы.
// Возвращаемое значение:
//  Массив - приоритет, подразделение, очередь.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ПорядокЗаказов(Знач Заказы) Экспорт
    ТекстПорядка = ГрафикПроизводстваСтруктурыЗаказа.юум_ТекстДанныхЗаказаПрогноза("&ТекстИмяТаблицы.Ссылка В (&Заказы)", Истина);
    ТекстПорядка = СтрЗаменить(ТекстПорядка, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
    ЗапросПорядка = Новый Запрос(ТекстПорядка);
    ЗапросПорядка.УстановитьПараметр("Заказы", Заказы);
    Возврат ЗапросПорядка.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказНаПроизводство");
КонецФункции // } #юум

// Возвращает записанную дневную загрузку без вызовов методов объекта отчета.
// Параметры:
//  НачалоПериода - Дата - начало периода диаграммы.
//  КонецПериода - Дата - окончание периода диаграммы.
//  СхемаЗагрузки - СхемаКомпоновкиДанных - схема отчета с параметрами Период и ПериодичностьОтчета.
// Возвращаемое значение:
//  ТаблицаЗначений - ДанныеОЗагрузке, занятость и доступность в секундах.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ДанныеЗаПериод(Знач НачалоПериода, Знач КонецПериода, Знач СхемаЗагрузки) Экспорт
    НастройкиЗагрузки = СхемаЗагрузки.НастройкиПоУмолчанию;
    ПериодЗагрузки = Новый СтандартныйПериод(ВариантСтандартногоПериода.ПроизвольныйПериод);
    ПериодЗагрузки.ДатаНачала = НачалоДня(НачалоПериода);
    ПериодЗагрузки.ДатаОкончания = КонецДня(КонецПериода);
    ПараметрПериода = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиЗагрузки, "Период");
    ПараметрПериода.Значение = ПериодЗагрузки;
    ПараметрПериода.Использование = Истина;
    ПараметрПериодичности = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиЗагрузки, "ПериодичностьОтчета");
    ПараметрПериодичности.Значение = Перечисления.Периодичность.День;
    ПараметрПериодичности.Использование = Истина;
    НастройкиЗагрузки.Отбор.Элементы.Очистить();
    ВнешниеНаборы = юум_ФП_Загрузка_НаборыОтчета(НастройкиЗагрузки);
    Возврат ВнешниеНаборы.ДанныеОЗагрузке;
КонецФункции // } #юум

// Возвращает внешние наборы тем же алгоритмом, что отчет загрузки ВРЦ.
// Параметры:
//  НастройкиОсновнойСхемы - НастройкиКомпоновкиДанных - период, периодичность и отборы отчета.
// Возвращаемое значение:
//  Структура - ДанныеОЗагрузке: ТаблицаЗначений, занятость и доступность в секундах.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_НаборыОтчета(НастройкиОсновнойСхемы) Экспорт
	
	ДанныеОЗагрузке = юум_ФП_Загрузка_ТаблицаОтчета();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = юум_ФП_Загрузка_ЗапросОтчета();
	
	ЗначенияОтбораДанных = юум_ФП_Загрузка_ОтборыОтчета(НастройкиОсновнойСхемы);
	
	Запрос.УстановитьПараметр("СписокПодразделений",       ЗначенияОтбораДанных.СписокПодразделений);
	Запрос.УстановитьПараметр("ЛюбоеПодразделение",        ЗначенияОтбораДанных.СписокПодразделений.Количество() = 0);
	
	Запрос.УстановитьПараметр("ЛюбойВидРабочегоЦентра",    ЗначенияОтбораДанных.СписокВидовРабочихЦентров.Количество() = 0);
	Запрос.УстановитьПараметр("СписокВидовРабочихЦентров", ЗначенияОтбораДанных.СписокВидовРабочихЦентров);
	
	Запрос.УстановитьПараметр("ПериодичностьОтчета",  ЗначенияОтбораДанных.ПериодичностьОтчета); 
	
	// В зависимости от интервала планирования используется нужный период
	Запрос.УстановитьПараметр("НачалоДня",    НачалоДня(ЗначенияОтбораДанных.НачалоПериода));
	Запрос.УстановитьПараметр("КонецДня",     КонецДня(ЗначенияОтбораДанных.ОкончаниеПериода));
	
	ПериодНачалоНедели = НачалоНедели(ЗначенияОтбораДанных.НачалоПериода);
	ПериодКонецНедели = КонецНедели(ЗначенияОтбораДанных.ОкончаниеПериода);
	Запрос.УстановитьПараметр("НачалоНедели", ПериодНачалоНедели);
	Запрос.УстановитьПараметр("КонецНедели",  ПериодКонецНедели);
	
	ПериодНачалоМесяца = НачалоМесяца(ЗначенияОтбораДанных.НачалоПериода);
	ПериодКонецМесяца = КонецМесяца(ЗначенияОтбораДанных.ОкончаниеПериода);
	Запрос.УстановитьПараметр("НачалоМесяца", ПериодНачалоМесяца);
	Запрос.УстановитьПараметр("КонецМесяца",  ПериодКонецМесяца);
	
	Запрос.УстановитьПараметр("НачалоПериода", Мин(ПериодНачалоНедели, ПериодНачалоМесяца));
	Запрос.УстановитьПараметр("КонецПериода", Макс(ПериодКонецНедели, ПериодКонецМесяца));
	
	Результат = Запрос.ВыполнитьПакет();  
	
	ДоступностьВРЦ = Результат[1].Выгрузить();
	ДоступностьВРЦ.Индексы.Добавить("ВидРабочегоЦентра,ПериодГрафика");
	
	ЗанятостьВРЦ = Результат[8].Выгрузить();
	ЗанятостьВРЦ.Индексы.Добавить("ВидРабочегоЦентра,ПериодГрафика");

	СводнаяДоступностьВРЦ = ДоступностьВРЦ.Скопировать();
	СводнаяДоступностьВРЦ.Свернуть("ВидРабочегоЦентра, ПериодГрафика", "Доступно");
	СводнаяДоступностьВРЦ.Индексы.Добавить("ВидРабочегоЦентра,ПериодГрафика");
	
	СводнаяЗанятостьВРЦ = ЗанятостьВРЦ.Скопировать();
	СводнаяЗанятостьВРЦ.Свернуть("ВидРабочегоЦентра, ПериодГрафика", "Занято");
	СводнаяЗанятостьВРЦ.Индексы.Добавить("ВидРабочегоЦентра,ПериодГрафика");
	
	СписокВидовРЦ = ЗанятостьВРЦ.Скопировать(, "Подразделение,ВидРабочегоЦентра,ИнтервалПланирования,ПараллельнаяЗагрузка,УчитыватьДоступность");
	СписокВидовРЦ.Свернуть("Подразделение,ВидРабочегоЦентра,ИнтервалПланирования,ПараллельнаяЗагрузка,УчитыватьДоступность");
	
	Для каждого СтрокаВидРЦ Из СписокВидовРЦ Цикл
		
		ИнтервалПериодичности = юум_ФП_Загрузка_ИнтервалОтчета(ЗначенияОтбораДанных.ПериодичностьОтчета);
		ТекущийПериод = ПланированиеПроизводстваКлиентСервер.НачалоИнтервалаПланирования(
										ЗначенияОтбораДанных.НачалоПериода, 
										ИнтервалПериодичности);
										
		Пока ТекущийПериод <= ЗначенияОтбораДанных.ОкончаниеПериода Цикл
			
			СтруктураПоиска = Новый Структура("ВидРабочегоЦентра,ПериодГрафика", СтрокаВидРЦ.ВидРабочегоЦентра, ТекущийПериод);
	
			НайденнаяЗанятостьВРЦ = ЗанятостьВРЦ.НайтиСтроки(СтруктураПоиска);
			НайденнаяДоступностьВРЦ = ДоступностьВРЦ.НайтиСтроки(СтруктураПоиска);
			НайденнаяСводнаяЗанятостьВРЦ = СводнаяЗанятостьВРЦ.НайтиСтроки(СтруктураПоиска);
			НайденнаяСводнаяДоступностьВРЦ = СводнаяДоступностьВРЦ.НайтиСтроки(СтруктураПоиска);
			
			Если НайденнаяЗанятостьВРЦ.Количество() <> 0 Тогда
				
				Для каждого ВыборкаЗанятостьВРЦ Из НайденнаяЗанятостьВРЦ Цикл
					
					юум_ФП_Загрузка_СтрокаОтчета(ДанныеОЗагрузке, ВыборкаЗанятостьВРЦ, ТекущийПериод, ИнтервалПериодичности,
						НайденнаяДоступностьВРЦ, НайденнаяСводнаяЗанятостьВРЦ, НайденнаяСводнаяДоступностьВРЦ);
					
				КонецЦикла;
				
			КонецЕсли; 
			
			юум_ФП_Загрузка_СтрокаОтчета(ДанныеОЗагрузке, СтрокаВидРЦ, ТекущийПериод, ИнтервалПериодичности,
				НайденнаяДоступностьВРЦ, НайденнаяСводнаяЗанятостьВРЦ, НайденнаяСводнаяДоступностьВРЦ);
			
			ТекущийПериод = ПланированиеПроизводстваКлиентСервер.ОкончаниеИнтервалаПланирования(ТекущийПериод,
				ИнтервалПериодичности) + 1;
			
		КонецЦикла;
		
	КонецЦикла;

	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ДанныеОЗагрузке", ДанныеОЗагрузке);
	
	Возврат ВнешниеНаборыДанных;

КонецФункции // } #юум

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ОбъемыФормы - ТаблицаЗначений - Ключи заказа/партии/номенклатуры, Требуется и Выбрано.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПроверитьОбъемы(Знач Заказ, Знач ОбъемыФормы)
    Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказНаПроизводство2_2")
        Или Не ЗначениеЗаполнено(Заказ) Тогда
        ВызватьИсключение "Для расчета ВРЦ необходим заказ на производство.";
    КонецЕсли;
    Если ТипЗнч(ОбъемыФормы) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение "Объемы расчета ВРЦ должны быть таблицей значений.";
    КонецЕсли;
    КлючиВыходов = Новый Соответствие;
    Для Каждого ОбъемВыхода Из ОбъемыФормы Цикл
        НекорректенОбъем = ОбъемВыхода.ЗаказНаПроизводство <> Заказ;
        Если Не НекорректенОбъем Тогда
            НекорректенОбъем = ОбъемВыхода.Требуется <= 0
                Или ОбъемВыхода.Выбрано < 0
                Или ОбъемВыхода.Выбрано > ОбъемВыхода.Требуется;
        КонецЕсли;
        Если НекорректенОбъем Тогда
            ВызватьИсключение "Некорректные объемы остатка для расчета ВРЦ.";
        КонецЕсли;
        КлючВыхода = Строка(ОбъемВыхода.КлючПартия) + "|" + Строка(ОбъемВыхода.КлючНоменклатура);
        Если КлючиВыходов.Получить(КлючВыхода) <> Неопределено Тогда
            ВызватьИсключение "Повтор ключа выхода партии в расчете ВРЦ.";
        КонецЕсли;
        КлючиВыходов.Вставить(КлючВыхода, Истина);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПрочитатьРеквизитыБезЗаписи(Знач Заказ, ДанныеРасчета, ПараметрыРасчета)
    ТекстЧтенияЗаказа = ГрафикПроизводстваСтруктурыЗаказа.юум_ТекстДанныхЗаказаПрогноза("&ТекстИмяТаблицы.Ссылка = &Заказ", Ложь);
    ТекстЧтенияЗаказа = СтрЗаменить(ТекстЧтенияЗаказа, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
    ЗапросЗаказа = Новый Запрос(ТекстЧтенияЗаказа);
    ЗапросЗаказа.УстановитьПараметр("Заказ", Заказ);
    ВыборкаЗаказа = ЗапросЗаказа.Выполнить().Выбрать();
    Если Не ВыборкаЗаказа.Следующий() Тогда
        ВызватьИсключение "Заказ не найден или недоступен для расчета ВРЦ.";
    КонецЕсли;
    ЗаполнитьЗначенияСвойств(ДанныеРасчета.РеквизитыЗаказа, ВыборкаЗаказа);
    ПараметрыРасчета.ЗадействоватьРезервДоступности = ВыборкаЗаказа.ЗадействоватьРезервДоступности;
    ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ = ВыборкаЗаказа.ИспользоватьАльтернативныеВРЦ;
КонецПроцедуры // } #юум

// Параметры:
//    МенеджерТаблиц - МенеджерВременныхТаблиц - Менеджер временных таблиц текущего расчета графика.
//    ОбъемыФормы - ТаблицаЗначений - Ключи заказа/партии/номенклатуры, Требуется и Выбрано.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПоместитьОбъемыВыбора(МенеджерТаблиц, Знач ОбъемыФормы)
    ЗапросОбъемов = Новый Запрос;
    ЗапросОбъемов.МенеджерВременныхТаблиц = МенеджерТаблиц;
    ЗапросОбъемов.Текст =
    "ВЫБРАТЬ
    | ВыборФормы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
    | ВыборФормы.КлючПартия КАК КлючПартия,
    | ВыборФормы.КлючНоменклатура КАК КлючНоменклатура,
    | ВыборФормы.Требуется КАК Требуется,
    | ВыборФормы.Выбрано КАК Выбрано
    |ПОМЕСТИТЬ юум_ФП_ОбъемыВыбора
    |ИЗ &ОбъемыФормы КАК ВыборФормы
    |ИНДЕКСИРОВАТЬ ПО ЗаказНаПроизводство, КлючПартия, КлючНоменклатура";
    ЗапросОбъемов.УстановитьПараметр("ОбъемыФормы", ОбъемыФормы);
    ЗапросОбъемов.Выполнить();
КонецПроцедуры // } #юум

// Параметры:
//    ШтатныйТекст - Строка - Исходный запрос структуры, в который подключается объем формы.
//
// Возвращаемое значение:
//    Структура - ИсходнаяСтруктура и ВыбраннаяСтруктура - части пакета запросов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_СтруктураЗаказаПоВыбору(Знач ШтатныйТекст)
    ИсходныйТекст = СтрЗаменить(ШтатныйТекст, "ВТСтруктураЗаказа", "юум_ФП_ИсходнаяСтруктураЗаказа");
    ТекстОбъемов =
    "ВЫБРАТЬ
    | Основа.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
    | Основа.КлючНоменклатура КАК КлючНоменклатура,
    | Основа.КлючПартия КАК КлючПартия,
    | Основа.Этап КАК Этап,
    | Основа.Номенклатура КАК Номенклатура,
    | Основа.Характеристика КАК Характеристика,
    | Основа.ЭтоВыпуск КАК ЭтоВыпуск,
    | Основа.ЭтоПеремещение КАК ЭтоПеремещение,
    | Основа.ЭтоПроизводствоПродукции КАК ЭтоПроизводствоПродукции,
    | Основа.ВидНоменклатуры КАК ВидНоменклатуры,
    | Основа.Спецификация КАК Спецификация,
    | Основа.Подразделение КАК Подразделение,
    | Основа.СкладПеремещения КАК СкладПеремещения,
    | Основа.НазначениеПеремещения КАК НазначениеПеремещения,
    | ВЫБОР
    |  КОГДА ВыборФормы.КлючНоменклатура ЕСТЬ НЕ NULL
    |   И Основа.ЭтоВыпуск И НЕ Основа.ЭтоПеремещение
    |  ТОГДА Основа.Запланировано * ВыборФормы.Выбрано / ВыборФормы.Требуется
    |  ИНАЧЕ Основа.Запланировано
    | КОНЕЦ КАК Запланировано,
    | Основа.Запущено КАК Запущено,
    | Основа.ДлительностьДоВыпуска КАК ДлительностьДоВыпуска,
    | Основа.ИдентификаторВГруппеИзделий КАК ИдентификаторВГруппеИзделий,
    | Основа.Уровень КАК Уровень
    |ПОМЕСТИТЬ ВТСтруктураЗаказа
    |ИЗ юум_ФП_ИсходнаяСтруктураЗаказа КАК Основа
    | ЛЕВОЕ СОЕДИНЕНИЕ юум_ФП_ОбъемыВыбора КАК ВыборФормы
    | ПО Основа.ЗаказНаПроизводство = ВыборФормы.ЗаказНаПроизводство
    |  И Основа.КлючПартия = ВыборФормы.КлючПартия
    |  И Основа.КлючНоменклатура = ВыборФормы.КлючНоменклатура
    |ИНДЕКСИРОВАТЬ ПО ЗаказНаПроизводство, КлючНоменклатура";
    Возврат Новый Структура("ИсходнаяСтруктура,ВыбраннаяСтруктура", ИсходныйТекст, ТекстОбъемов);
КонецФункции // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    Настройки - Структура - Параметры объема формы и необязательный контекст очереди расчета.
//
// Возвращаемое значение:
//    Структура - Результат размещения: ГрафикЗапланирован, Ошибки, Оповещения и ДанныеРасчета.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Знач Заказ, Знач Настройки)
    МодельПрогноза = ГрафикПроизводстваСтруктурыЗаказа.юум_НоваяМодельПрогноза();
    ПараметрыРасчета = МодельПрогноза.ПараметрыРасчета;
    ПараметрыРасчета.Заказ = Заказ;
    ПараметрыРасчета.Вставить("юум_ФП_ОбъемыФормы", Настройки.юум_ФП_ОбъемыФормы);
    ДанныеРасчета = МодельПрогноза.ДанныеРасчета;
    юум_ФП_ПрочитатьРеквизитыБезЗаписи(Заказ, ДанныеРасчета, ПараметрыРасчета);
    юум_ФП_ПрочитатьЭтапыПредварительногоПросмотра(Заказ, ДанныеРасчета, ПараметрыРасчета);
    Если Настройки.Свойство("юум_ФП_КонтекстОчереди") Тогда
        РазницыОчереди = юум_ФП_РазницыЗагрузкиОчереди(Заказ, Настройки.юум_ФП_КонтекстОчереди);
        ПараметрыРасчета.Вставить("юум_ФП_РазницыЗагрузки", РазницыОчереди);
        ПараметрыРасчета.Вставить("юум_ФП_УчтенныеИнтервалы", Новый Соответствие);
    КонецЕсли;
    ГрафикПроизводстваСтруктурыЗаказа.юум_ПрочитатьДоступностьПрогноза(Заказ, ДанныеРасчета, ПараметрыРасчета);
    юум_ФП_РазместитьЭтапыПредварительногоПросмотра(ДанныеРасчета, ПараметрыРасчета);
    ГрафикЗапланирован = ДанныеРасчета.Этапы.Количество() > 0
        И ПараметрыРасчета.Ошибки.Найти(Истина, "Критичная") = Неопределено;
    Если ГрафикЗапланирован И ДанныеРасчета.РеквизитыЗаказа.ЭтоСборка Тогда
        ГрафикПроизводстваСтруктурыЗаказа.юум_СместитьЭтапыПрогноза(ДанныеРасчета, ПараметрыРасчета);
    КонецЕсли;
    РезультатПредварительногоПросмотра = Новый Структура;
    РезультатПредварительногоПросмотра.Вставить("ГрафикЗапланирован", ГрафикЗапланирован);
    РезультатПредварительногоПросмотра.Вставить("Ошибки", ПараметрыРасчета.Ошибки);
    РезультатПредварительногоПросмотра.Вставить("Оповещения", ПараметрыРасчета.Оповещения);
    РезультатПредварительногоПросмотра.Вставить("КоличествоЭтапов", ДанныеРасчета.Этапы.Количество());
    РезультатПредварительногоПросмотра.Вставить("ДанныеРасчета", ДанныеРасчета);
    Возврат РезультатПредварительногоПросмотра;
КонецФункции // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Прогноз: партии без выбранного или запущенного выпуска не передаются на размещение ВРЦ.
// Галфинд mr. Cherryman 2026/11/13
Процедура юум_ФП_ПрочитатьЭтапыПредварительногоПросмотра(Заказ, ДанныеРасчета, ПараметрыРасчета)
	
	ТекстыШтатногоРасчета = ГрафикПроизводстваСтруктурыЗаказа.юум_ТекстыЭтаповПрогноза(ПараметрыРасчета);
	ТекстыЗапроса = Новый СписокЗначений;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    юум_ФП_ОбъемыФормы = Неопределено;
    Если ПараметрыРасчета.Свойство("юум_ФП_ОбъемыФормы", юум_ФП_ОбъемыФормы) Тогда
        юум_ФП_ПоместитьОбъемыВыбора(МенеджерВременныхТаблиц, юум_ФП_ОбъемыФормы);
    КонецЕсли;

	// ВТСтруктураЗаказа
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСтруктураЗаказа;
    Если ПараметрыРасчета.Свойство("юум_ФП_ОбъемыФормы") Тогда
        ЗапросыСтруктуры = юум_ФП_СтруктураЗаказаПоВыбору(ТекстЗапроса);
        ТекстыЗапроса.Добавить(ЗапросыСтруктуры.ИсходнаяСтруктура, "юум_ФП_ИсходнаяСтруктураЗаказа");
        ТекстЗапроса = ЗапросыСтруктуры.ВыбраннаяСтруктура;
    КонецЕсли;

	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСтруктураЗаказа");
	
	// ВТВыпускПартий
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТВыпускПартий;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТВыпускПартий");
	
	// ВТКоличествоПартий
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТКоличествоПартий;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТКоличествоПартий");
	
	// ВТЗаказыНаРемонт
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТЗаказыНаРемонт;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонт");
	
	#Область ВТОграниченияГрафикаПроизводстваПоМатериалам
	
	Если ПараметрыРасчета.ВсеМатериалыВНаличии Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка) КАК ЗаказНаПроизводство,
			|	&ПустойКлючСвязи                                       КАК КлючПартия,
			|	ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)    КАК Этап,
			|	ДАТАВРЕМЯ(1, 1, 1)                                     КАК ДатаДоступности
			|ПОМЕСТИТЬ ВТОграниченияГрафикаПроизводстваПоМатериалам";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОграниченияГрафикаПроизводстваПоМатериалам");
		
	Иначе
		
		УправлениеПроизводством.СоздатьВТОграниченияГрафикаПроизводстваПоМатериаламДинамическаяСтруктура(
			МенеджерВременныхТаблиц,
			Заказ,
			Ложь,
			Истина);
		
	КонецЕсли;
	
	#КонецОбласти
	
	// ВТСвязиМеждуПартиями
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСвязиМеждуПартиями;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиМеждуПартиями");
	
	// ВТПартии
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТПартии;
	// В прогнозе снятые позиции имеют нулевой объем: для них нет количества партий.
	// Исключаем пустые партии до чтения этапов и ВРЦ, сохраняя выбранные и запущенные.
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"ЛЕВОЕ СОЕДИНЕНИЕ ВТКоличествоПартий",
		"ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКоличествоПартий");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТПартии");
	
	// ВТСвязиПартийИЭтаповСправочник
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСвязиПартийИЭтаповСправочник;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиПартийИЭтаповСправочник");
	
	// ВТЭтапыСправочник
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТЭтапыСправочник;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЭтапыСправочник");
	
	// ВТСвязиПартийИЭтаповДокумент
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСвязиПартийИЭтаповДокумент;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиПартийИЭтаповДокумент");

    юум_ФП_ЗапросыЭтаповПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ПараметрыРасчета, ТекстыШтатногоРасчета);
    юум_ФП_ЗапросыРемонтаПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ТекстыШтатногоРасчета);
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("СтатусГрафика", ПараметрыРасчета.СтатусГрафика);
	Запрос.УстановитьПараметр("ПустойКлючСвязи", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("ОсновнойКалендарь", Константы.ОсновнойКалендарьПредприятия.Получить());
	Запрос.УстановитьПараметр("ТекущаяДата", ПараметрыРасчета.ТекущаяДата);
	Запрос.УстановитьПараметр("НеограниченныйПаркОборудования", ПараметрыРасчета.НеограниченныйПаркОборудования);
	Запрос.УстановитьПараметр("ОтменитьРучныеИзмененияГрафика", ПараметрыРасчета.ОтменитьРучныеИзмененияГрафика);
	Запрос.УстановитьПараметр("ИспользоватьАльтернативныеВРЦ", ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ);
	ИспользоватьПараметризацию = ПолучитьФункциональнуюОпцию("ИспользоватьПараметризациюРесурсныхСпецификаций");
	Запрос.УстановитьПараметр("ИспользоватьПараметризациюСпецификаций", ИспользоватьПараметризацию);
	
	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Таблицы = ОбщегоНазначенияУТ.ВыгрузитьРезультатыЗапроса(Запрос, ТекстыЗапроса,, Истина, Ложь);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	
	Этапы = Таблицы.Этапы; // ТаблицаЗначений
	Этапы.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.Этапы = Этапы;
	
	Для каждого Колонка Из Этапы.Колонки Цикл
		ДанныеРасчета.ЭтапКопия.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Связи = Таблицы.Связи; // ТаблицаЗначений
	Связи.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.Связи = Связи;
	
	ВидыРЦ = Таблицы.ВидыРЦ; // ТаблицаЗначений
	ГрафикПроизводстваСтруктурыЗаказа.юум_РассчитатьНормативыПрогноза(ВидыРЦ, Таблицы.ИзделияКРасчетуВидовРЦПоФормуле);
	ВидыРЦ.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.ВидыРЦ = ВидыРЦ;
	
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ Тогда
		АльтернативныеВидыРЦ = Таблицы.АльтернативныеВидыРЦ; // ТаблицаЗначений
		ГрафикПроизводстваСтруктурыЗаказа.юум_РассчитатьНормативыПрогноза(АльтернативныеВидыРЦ, Таблицы.ИзделияКРасчетуВидовРЦПоФормуле);
		АльтернативныеВидыРЦ.Индексы.Добавить("КлючПартия, Этап");
		АльтернативныеВидыРЦ.Индексы.Добавить("КлючПартия, Этап, КлючСвязи");
		ДанныеРасчета.АльтернативныеВидыРЦ = АльтернативныеВидыРЦ;
	КонецЕсли;
	
	ДанныеРасчета.Задания = Таблицы.Задания;
	ДанныеРасчета.ЭтапыСРучнымРазмещением = Таблицы.ЭтапыСРучнымРазмещением.ВыгрузитьКолонку("Ссылка");
	
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		СвязиРемонтов = Таблицы.СвязиРемонтов; // ТаблицаЗначений
		СвязиРемонтов.Индексы.Добавить("КлючПартияРемонт");
		ДанныеРасчета.СвязиРемонтов = СвязиРемонтов;
		
		Если Таблицы.ПартииРемонтаКРасчетуПорядка.Количество() > 0 Тогда
			ГрафикПроизводстваСтруктурыЗаказа.юум_РассчитатьПорядокРемонтаПрогноза(ДанныеРасчета, Таблицы.ПартииРемонтаКРасчетуПорядка);
		КонецЕсли;
	КонецЕсли;
	
	// Контроль видов РЦ
	СтруктураПоиска = Новый Структура("ЕстьОшибкаНеЗаполненаЗагрузка", Истина);
	ТаблицаОшибок = ВидыРЦ.Скопировать(СтруктураПоиска, "ВидРабочегоЦентра");
	ТаблицаОшибок.Свернуть("ВидРабочегоЦентра");
	Для каждого Строка Из ТаблицаОшибок Цикл
		ШаблонОповещения = НСтр("ru = 'Для вида РЦ ""%1"" не задана максимальная загрузка. "
			+ "Реквизит обязателен к заполнению для видов РЦ с параллельной загрузкой.'; "
			+ "en = 'The maximum load is not set for the ""%1"" work center type. "
			+ "The attribute is required for work center types with parallel load.'");
		ТекстОповещения = СтрШаблон(
			ШаблонОповещения,
			Строка.ВидРабочегоЦентра);
		ПараметрыРасчета.Оповещения.Вставить(ТекстОповещения, Строка.ВидРабочегоЦентра);
	КонецЦикла;
	
КонецПроцедуры // } #юум

// Параметры:
//    ТекстыЗапроса - СписокЗначений - Именованные части пакета запросов штатного расчета графика.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    ТекстыШтатногоРасчета - Структура - Тексты запросов текущего релиза штатного калькулятора.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗапросыЭтаповПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ПараметрыРасчета, ТекстыШтатногоРасчета)
	#Область ВТЗаказыНаРемонтКРасчетуПорядка
	
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	&Заказ КАК ЗаказНаПроизводство
			|ПОМЕСТИТЬ ВТЗаказыНаРемонтКРасчетуПорядка
			|ГДЕ
			|	ИСТИНА В (
			|		ВЫБРАТЬ ПЕРВЫЕ 1
			|			ИСТИНА
			|		ИЗ
			|			ВТПартии КАК Партии
			|			
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК Этапы
			|			ПО Партии.Ссылка = Этапы.Владелец
			|				И Партии.ЭтоПеремещение = ЛОЖЬ
			|		ГДЕ
			|			НЕ Этапы.ПометкаУдаления
			|			И НЕ ИСТИНА В (
			|				ВЫБРАТЬ ПЕРВЫЕ 1
			|					ИСТИНА
			|				ИЗ
			|					РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
			|				ГДЕ
			|					График.ЗаказНаПроизводство = Партии.ЗаказНаПроизводство
			|					И График.СтатусГрафика = 0
			|					И График.Этап = Этапы.Ссылка
			|					И График.КлючПартия = Партии.КлючПартия)
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ ПЕРВЫЕ 1
			|			ИСТИНА
			|		ИЗ
			|			ВТПартии КАК Партии
			|			
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
			|			ПО Партии.Ссылка = Этапы.ПартияПроизводства
			|				И Партии.ЭтоПеремещение = ЛОЖЬ
			|		ГДЕ
			|			Этапы.Проведен
			|			И НЕ ИСТИНА В (
			|				ВЫБРАТЬ ПЕРВЫЕ 1
			|					ИСТИНА
			|				ИЗ
			|					РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
			|				ГДЕ
			|					График.ЗаказНаПроизводство = Партии.ЗаказНаПроизводство
			|					И График.СтатусГрафика = 0
			|					И График.Этап = Этапы.Ссылка
			|					И График.КлючПартия = Партии.КлючПартия))";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонтКРасчетуПорядка");
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ ПЕРВЫЕ 0
			|	ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка) КАК ЗаказНаПроизводство
			|ПОМЕСТИТЬ ВТЗаказыНаРемонтКРасчетуПорядка";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонтКРасчетуПорядка");
		
	КонецЕсли;
	
	#КонецОбласти
	
	// ВТСвязи
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСвязи;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязи");
	
	// ВТЭтапыСРучнымРазмещением
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТЭтапыСРучнымРазмещением;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЭтапыСРучнымРазмещением");
	
	// ВТДатыНепланируемыхПредшественников
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТДатыНепланируемыхПредшественников;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТДатыНепланируемыхПредшественников");
	
	// ВТОтборПоСвойствамНастройки
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТОтборПоСвойствамНастройки;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОтборПоСвойствамНастройки");
	
	// ВТОтборПоСвойствам
	ТекстЗапроса = УправлениеДаннымиОбИзделиях.ТекстЗапросаВТОтборПоСвойствам("ВТОтборПоСвойствамНастройки");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОтборПоСвойствам");
	
	// ВТКоличествоРЦ
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТКоличествоРЦ;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТКоличествоРЦ");
	
	// Этапы
	ТекстЗапроса = ТекстыШтатногоРасчета.Этапы;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Этапы");
	
	// Связи
	ТекстЗапроса = ТекстыШтатногоРасчета.Связи;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Связи");
	
	// ВидыРЦ
	ТекстЗапроса = ТекстыШтатногоРасчета.ВидыРЦ;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВидыРЦ");
	
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ Тогда
		ТекстЗапроса = ТекстыШтатногоРасчета.АльтернативныеВидыРЦ;
		ТекстыЗапроса.Добавить(ТекстЗапроса, "АльтернативныеВидыРЦ");
	КонецЕсли;
	
	// ВТСпецификацииКРасчетуВидовРЦПоФормуле
	ТекстЗапроса = ТекстыШтатногоРасчета.ВТСпецификацииКРасчетуВидовРЦПоФормуле;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСпецификацииКРасчетуВидовРЦПоФормуле");
	
	// ИзделияКРасчетуВидовРЦПоФормуле
	ТекстЗапроса = ТекстыШтатногоРасчета.ИзделияКРасчетуВидовРЦПоФормуле;
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ИзделияКРасчетуВидовРЦПоФормуле");
	
	#Область Задания
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Задания.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Задания.Разделитель         КАК Разделитель,
		|	Задания.ЭтапПроизводства    КАК ЭтапПроизводства,
		|	Задания.КлючПартия          КАК КлючПартия
		|ИЗ
		|	РегистрСведений.ЗаданияКРасчетуСтруктурыЗаказаГрафикПроизводства КАК Задания
		|ГДЕ
		|	Задания.ЗаказНаПроизводство = &Заказ";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Задания");
	
	#КонецОбласти
	
	#Область ЭтапыСРучнымРазмещением
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Этапы.Ссылка КАК Ссылка
		|ИЗ
		|	ВТЭтапыСРучнымРазмещением КАК Этапы";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ЭтапыСРучнымРазмещением");
	
	#КонецОбласти

КонецПроцедуры // } #юум

// Параметры:
//    ТекстыЗапроса - СписокЗначений - Именованные части пакета запросов штатного расчета графика.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ТекстыШтатногоРасчета - Структура - Тексты запросов текущего релиза штатного калькулятора.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗапросыРемонтаПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ТекстыШтатногоРасчета)
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		
		// СвязиРемонтов
		ТекстЗапроса = ТекстыШтатногоРасчета.СвязиРемонтов;
		ТекстыЗапроса.Добавить(ТекстЗапроса, "СвязиРемонтов");
		
		#Область ВТПартииРемонтаКРасчетуПорядка
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	СУММА(
			|		ВЫБОР
			|			КОГДА ЕСТЬNULL(ДлительностьЭтапов.ДлительностьВСекундах, 0) = 0
			|				ТОГДА 0.0001
			|			ИНАЧЕ ЕСТЬNULL(ДлительностьЭтапов.ДлительностьВСекундах, 0)
			|		КОНЕЦ)        КАК Ресурсоемкость
			|ПОМЕСТИТЬ ВТПартииРемонтаКРасчетуПорядка
			|ИЗ
			|	ВТПартии КАК Партии
			|	
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК Этапы
			|	ПО Партии.Ссылка = Этапы.Владелец
			|		И Партии.ЭтоПеремещение = ЛОЖЬ
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НормативнаяДлительностьЭтаповПроизводства КАК ДлительностьЭтапов
			|	ПО Этапы.Ссылка = ДлительностьЭтапов.Этап
			|		И Партии.Ссылка = ДлительностьЭтапов.Спецификация
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И НЕ Этапы.ПометкаУдаления
			|
			|СГРУППИРОВАТЬ ПО
			|	Партии.КлючПартия,
			|	Партии.Уровень
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	СУММА(
			|		ВЫБОР
			|			КОГДА Этапы.ДлительностьЭтапа = 0
			|				ТОГДА 0.0001
			|			ИНАЧЕ 
			|				ВЫБОР Этапы.ЕдиницаИзмеренияДлительностиЭтапа
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.День)
			|						ТОГДА Этапы.ДлительностьЭтапа * 86400
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Минута)
			|						ТОГДА Этапы.ДлительностьЭтапа * 60
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Час)
			|						ТОГДА Этапы.ДлительностьЭтапа * 3600
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Секунда)
			|						ТОГДА Этапы.ДлительностьЭтапа
			|				КОНЕЦ
			|		КОНЕЦ)        КАК Ресурсоемкость
			|ИЗ
			|	ВТПартии КАК Партии
			|	
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
			|	ПО Партии.Ссылка = Этапы.ПартияПроизводства
			|		И Партии.ЭтоПеремещение = ЛОЖЬ
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И Этапы.Проведен
			|
			|СГРУППИРОВАТЬ ПО
			|	Партии.КлючПартия,
			|	Партии.Уровень
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) = 0
			|			ТОГДА 0.0001
			|		ИНАЧЕ ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) * 86400
			|	КОНЕЦ             КАК Ресурсоемкость
			|ИЗ
			|	ВТПартии КАК Партии
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИ
			|	ПО Партии.НоменклатураПеремещения = КэшНСИ.Номенклатура
			|		И Партии.ХарактеристикаПеремещения = КэшНСИ.Характеристика
			|		И Партии.СкладПеремещения = КэшНСИ.Склад
			|		И Партии.НазначениеПеремещения = КэшНСИ.Назначение
			|		И Партии.ЗаказНаПроизводство = КэшНСИ.ЗаказНаПроизводство
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И Партии.ЭтоПеремещение
			|	И Партии.Ссылка = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	КлючПартия";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТПартииРемонтаКРасчетуПорядка");
		
		#КонецОбласти
		
		#Область ПартииРемонтаКРасчетуПорядка
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Партии.КлючПартия     КАК КлючПартияПредшественник,
			|	Партии.Ресурсоемкость КАК Ресурсоемкость,
			|	ЕСТЬNULL(Связи.КлючПартия, &ПустойКлючСвязи)                              КАК КлючПартия,
			|	ЕСТЬNULL(Связи.Этап, ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)) КАК Этап
			|ИЗ
			|	ВТПартииРемонтаКРасчетуПорядка КАК Партии
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ ВТСвязиМеждуПартиями КАК Связи
			|	ПО Партии.КлючПартия = Связи.КлючПартияПредшественник
			|
			|УПОРЯДОЧИТЬ ПО
			|	Партии.Уровень УБЫВ";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ПартииРемонтаКРасчетуПорядка");
		
		#КонецОбласти
		
	КонецЕсли;

КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_РазместитьЭтапыПредварительногоПросмотра(ДанныеРасчета, ПараметрыРасчета)
    Для Каждого СтрокаЭтап Из ДанныеРасчета.Этапы Цикл
        Если Не СтрокаЭтап.Планировать Тогда
            Продолжить;
        КонецЕсли;
        юум_ФП_НаследоватьДатыПредшественников(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
        ГрафикПроизводстваСтруктурыЗаказа.юум_РазместитьЭтапПрогноза(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
        Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт
            И СтрокаЭтап.Окончание <> '00010101' Тогда
            Если СтрокаЭтап.ЭтоНачальныйЭтапРемонта
                Или СтрокаЭтап.НомерСледующегоЭтапа = 0 И Не СтрокаЭтап.ЭтоПеремещение Тогда
                юум_ФП_НаследоватьДатыРемонтов(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    КонтекстОчереди - Структура - Уже рассчитанные Заказы и их интервальная Загрузка.
//
// Возвращаемое значение:
//    ТаблицаЗначений - Разница исходной и рассчитанной загрузки предыдущих заказов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РазницыЗагрузкиОчереди(Знач Заказ, Знач КонтекстОчереди)
    Разницы = Новый ТаблицаЗначений;
    ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.ВидыРабочихЦентров");
    Разницы.Колонки.Добавить("ВидРабочегоЦентра", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Дата");
    Разницы.Колонки.Добавить("ДатаИнтервала", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Число");
    Разницы.Колонки.Добавить("РазницаВремени", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Число");
    Разницы.Колонки.Добавить("КоэффициентЗагрузки", ТипКолонки);
    Если КонтекстОчереди.Заказы.Количество() = 0 Тогда
        Возврат Разницы;
    КонецЕсли;
    МенеджерПриоритета = Новый МенеджерВременныхТаблиц;
    Документы.ЗаказНаПроизводство2_2.СоздатьВТЗаказыСБольшимПриоритетом(
        МенеджерПриоритета, "юум_ФП_ПриоритетОчереди", Заказ);
    ЗапросРазницы = Новый Запрос;
    ЗапросРазницы.МенеджерВременныхТаблиц = МенеджерПриоритета;
    ЗапросРазницы.Текст = юум_ФП_ТекстРазницыЗагрузки();
    ЗапросРазницы.УстановитьПараметр("ПредыдущиеЗаказы", КонтекстОчереди.Заказы);
    ЗапросРазницы.УстановитьПараметр("НоваяЗагрузка", КонтекстОчереди.Загрузка);
    Разницы = ЗапросРазницы.Выполнить().Выгрузить();
    Разницы.Индексы.Добавить("ВидРабочегоЦентра,ДатаИнтервала");
    Возврат Разницы;
КонецФункции // } #юум

//
//
//
// Возвращаемое значение:
//    Строка - Запрос интервалов с разницей загрузки ВРЦ для очереди.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ТекстРазницыЗагрузки()
    Возврат
    "ВЫБРАТЬ
    | Источник.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    | Источник.ДатаИнтервала КАК ДатаИнтервала,
    | Источник.Распоряжение КАК Распоряжение,
    | Источник.Этап КАК Этап,
    | Источник.Занято КАК Занято
    |ПОМЕСТИТЬ юум_ФП_НоваяЗагрузкаОчереди
    |ИЗ &НоваяЗагрузка КАК Источник
    |;
    |ВЫБРАТЬ
    | Разницы.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    | Разницы.ДатаИнтервала КАК ДатаИнтервала,
    | СУММА(Разницы.РазницаВремени) КАК РазницаВремени,
    | МАКСИМУМ(ВЫБОР КОГДА Разницы.ВидРабочегоЦентра.ПараллельнаяЗагрузка
    |  И Разницы.ВидРабочегоЦентра.МаксимальнаяЗагрузка <> 0
    |  ТОГДА Разницы.ВидРабочегоЦентра.МаксимальнаяЗагрузка
    |  ИНАЧЕ 1 КОНЕЦ) КАК КоэффициентЗагрузки
    |ИЗ (
    | ВЫБРАТЬ
    |  БазоваяЗагрузка.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    |  БазоваяЗагрузка.ДатаИнтервала КАК ДатаИнтервала,
    |  БазоваяЗагрузка.Занято КАК РазницаВремени
    | ИЗ РегистрНакопления.ДоступностьВидовРабочихЦентров КАК БазоваяЗагрузка
    |  ВНУТРЕННЕЕ СОЕДИНЕНИЕ юум_ФП_ПриоритетОчереди КАК Приоритет
    |  ПО БазоваяЗагрузка.Распоряжение = Приоритет.Ссылка
    | ГДЕ БазоваяЗагрузка.Активность
    |  И БазоваяЗагрузка.Распоряжение В (&ПредыдущиеЗаказы)
    |  И БазоваяЗагрузка.Этап ССЫЛКА Справочник.ЭтапыПроизводства
    | ОБЪЕДИНИТЬ ВСЕ
    | ВЫБРАТЬ
    |  ТекущаяЗагрузка.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    |  ТекущаяЗагрузка.ДатаИнтервала КАК ДатаИнтервала,
    |  -ТекущаяЗагрузка.Занято КАК РазницаВремени
    | ИЗ юум_ФП_НоваяЗагрузкаОчереди КАК ТекущаяЗагрузка
    |  ВНУТРЕННЕЕ СОЕДИНЕНИЕ юум_ФП_ПриоритетОчереди КАК Приоритет
    |  ПО ТекущаяЗагрузка.Распоряжение = Приоритет.Ссылка
    | ГДЕ ТекущаяЗагрузка.Этап ССЫЛКА Справочник.ЭтапыПроизводства
    |) КАК Разницы
    |СГРУППИРОВАТЬ ПО Разницы.ВидРабочегоЦентра, Разницы.ДатаИнтервала
    |ИМЕЮЩИЕ СУММА(Разницы.РазницаВремени) <> 0";
КонецФункции // } #юум

// Нормальные вызовы ERP не имеют служебного контекста и проходят без изменений.
// При дочитывании исходная функция сохраняет ранее измененные строки таблицы.

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    Граница - Дата, Неопределено - Необязательная граница интервалов учитываемой загрузки.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_УчестьЗагрузкуОчереди(Заказ, ДанныеРасчета, ПараметрыРасчета, Граница = Неопределено) Экспорт
    Если Не ПараметрыРасчета.Свойство("юум_ФП_РазницыЗагрузки") Тогда
        Возврат;
    КонецЕсли;
    Разницы = ПараметрыРасчета.юум_ФП_РазницыЗагрузки;
    Если Разницы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    УчтенныеИнтервалы = ПараметрыРасчета.юум_ФП_УчтенныеИнтервалы;
    КлючПоиска = Новый Структура("ВидРабочегоЦентра,ДатаИнтервала");
    Для Каждого ИнтервалДоступности Из ДанныеРасчета.ДоступностьВРЦ Цикл
        Если ИнтервалДоступности.ЭтоИндекс Тогда
            Продолжить;
        КонецЕсли;
        КлючИнтервала = юум_ФП_КлючИнтервалаДоступности(ИнтервалДоступности);
        Если УчтенныеИнтервалы.Получить(КлючИнтервала) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ЗаполнитьЗначенияСвойств(КлючПоиска, ИнтервалДоступности);
        НайденныеРазницы = Разницы.НайтиСтроки(КлючПоиска);
        Если НайденныеРазницы.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Разница = НайденныеРазницы[0];
        ИнтервалДоступности.ДоступноВремя = ИнтервалДоступности.ДоступноВремя
            + Разница.РазницаВремени;
        ИнтервалДоступности.ДоступноВремяЗагрузка = ИнтервалДоступности.ДоступноВремяЗагрузка
            + Разница.РазницаВремени * Разница.КоэффициентЗагрузки;
        УчтенныеИнтервалы.Вставить(КлючИнтервала, Истина);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ИнтервалДоступности - СтрокаТаблицыЗначений - Вид рабочего центра, дата и границы интервала доступности.
//
// Возвращаемое значение:
//    Строка - Составной ключ ВРЦ, даты и границ интервала доступности.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_КлючИнтервалаДоступности(Знач ИнтервалДоступности)
    Возврат Строка(ИнтервалДоступности.ВидРабочегоЦентра.УникальныйИдентификатор())
        + "|" + Формат(ИнтервалДоступности.ДатаИнтервала, "ДФ=yyyyMMddHHmmss")
        + "|" + Формат(ИнтервалДоступности.НачалоИнтервала, "ДФ=yyyyMMddHHmmss")
        + "|" + Формат(ИнтервалДоступности.ОкончаниеИнтервала, "ДФ=yyyyMMddHHmmss");
КонецФункции // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    СтрокаЭтап - СтрокаТаблицыЗначений - Текущий этап штатной модели графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_НаследоватьДатыПредшественников(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап)
    ПоискЭтапа = ПараметрыРасчета.КлючПартияЭтап;
    ПоискЭтапа.КлючПартия = СтрокаЭтап.КлючПартия;
    ПоискЭтапа.Этап = СтрокаЭтап.Этап;
    Для Каждого СтрокаСвязи Из ДанныеРасчета.Связи.НайтиСтроки(ПоискЭтапа) Цикл
        ПоискЭтапа.КлючПартия = СтрокаСвязи.КлючПартияПредшественник;
        ПоискЭтапа.Этап = СтрокаСвязи.ЭтапПредшественник;
        Предшественники = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтапа);
        Если Предшественники.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Предшественник = Предшественники[0];
        СмещениеПредшественника = ?(Предшественник.Начало <> Предшественник.Окончание, 1, 0);
        СтрокаЭтап.НачалоРазмещения = Макс(СтрокаЭтап.НачалоРазмещения,
            Предшественник.Окончание + СмещениеПредшественника);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    ИсходныйЭтап - СтрокаТаблицыЗначений - Этап, от которого начинается обход связей ремонтов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_НаследоватьДатыРемонтов(ДанныеРасчета, ПараметрыРасчета, Знач ИсходныйЭтап)
    ОчередьРемонтов = Новый Массив;
    ОчередьРемонтов.Добавить(ИсходныйЭтап);
    ИндексОчереди = 0;
    ЧислоСвязей = ДанныеРасчета.СвязиРемонтов.Количество();
    ГраницаОбхода = Макс(1, ДанныеРасчета.Этапы.Количество() * (ЧислоСвязей + 1));
    Пока ИндексОчереди < ОчередьРемонтов.Количество() Цикл
        Если ИндексОчереди >= ГраницаОбхода Тогда
            ВызватьИсключение "Предпросмотр ВРЦ: превышена граница обхода связей ремонтов.";
        КонецЕсли;
        ЭлементРемонта = ОчередьРемонтов[ИндексОчереди];
        ИндексОчереди = ИндексОчереди + 1;
        ПоискРемонта = Новый Структура("КлючПартияРемонт", ЭлементРемонта.КлючПартия);
        Для Каждого СвязьРемонта Из ДанныеРасчета.СвязиРемонтов.НайтиСтроки(ПоискРемонта) Цикл
            юум_ФП_ОбновитьДатыРемонтногоЭтапа(ДанныеРасчета, ПараметрыРасчета,
                СвязьРемонта, ЭлементРемонта, ОчередьРемонтов);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    СвязьРемонта - СтрокаТаблицыЗначений - Связь текущего этапа с зависимой партией ремонта.
//    ЭлементРемонта - СтрокаТаблицыЗначений - Ремонтный этап, даты которого наследует зависимый этап.
//    ОчередьРемонтов - Массив - Обрабатываемые ремонтные этапы; пополняется найденными потомками.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ОбновитьДатыРемонтногоЭтапа(ДанныеРасчета, ПараметрыРасчета,
    Знач СвязьРемонта, Знач ЭлементРемонта, ОчередьРемонтов)
    ПоискЭтапа = ПараметрыРасчета.КлючПартияЭтап;
    ЗаполнитьЗначенияСвойств(ПоискЭтапа, СвязьРемонта);
    ЭтапыРемонта = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтапа);
    Если ЭтапыРемонта.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    ЭтапРемонта = ЭтапыРемонта[0];
    ПрежнееНачало = ЭтапРемонта.Начало;
    ПрежнееОкончание = ЭтапРемонта.Окончание;
    Если ЭтапРемонта.Начало = '00010101' Тогда
        ЗаполнитьЗначенияСвойств(ЭтапРемонта, ЭлементРемонта, "Начало,Окончание");
    Иначе
        ЭтапРемонта.Начало = Мин(ЭтапРемонта.Начало, ЭлементРемонта.Начало);
        ЭтапРемонта.Окончание = Макс(ЭтапРемонта.Окончание, ЭлементРемонта.Окончание);
    КонецЕсли;
    Если ЭтапРемонта.ЭтоНачальныйЭтапРемонта
        И (ПрежнееНачало <> ЭтапРемонта.Начало Или ПрежнееОкончание <> ЭтапРемонта.Окончание) Тогда
        ОчередьРемонтов.Добавить(ЭтапРемонта);
    КонецЕсли;
КонецПроцедуры // } #юум

// Возвращаемое значение:
//  ТаблицаЗначений - типизированные колонки записанной загрузки отчета.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ТаблицаОтчета()
	
	ДанныеОЗагрузке = Новый ТаблицаЗначений;
	ДанныеОЗагрузке.Колонки.Добавить("Подразделение",              Новый ОписаниеТипов("СправочникСсылка.СтруктураПредприятия"));
	ДанныеОЗагрузке.Колонки.Добавить("ВидРабочегоЦентра",          Новый ОписаниеТипов("СправочникСсылка.ВидыРабочихЦентров"));
	ДанныеОЗагрузке.Колонки.Добавить("ВариантНаладки",             Новый ОписаниеТипов("СправочникСсылка.ВариантыНаладки"));
	ДанныеОЗагрузке.Колонки.Добавить("Доступно",                   Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15)));
	ДанныеОЗагрузке.Колонки.Добавить("Занято",                     Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15)));
	ДанныеОЗагрузке.Колонки.Добавить("ДоступноСводно",             Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15)));
	ДанныеОЗагрузке.Колонки.Добавить("ЗанятоСводно",               Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15)));
	ДанныеОЗагрузке.Колонки.Добавить("Номенклатура",               Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ДанныеОЗагрузке.Колонки.Добавить("Характеристика",             Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ДанныеОЗагрузке.Колонки.Добавить("Количество",                 Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	ДанныеОЗагрузке.Колонки.Добавить("ПериодГрафика",              Новый ОписаниеТипов("Дата"));
	ДанныеОЗагрузке.Колонки.Добавить("ПериодГрафикаПредставление", Новый ОписаниеТипов("Строка"));
	ДанныеОЗагрузке.Колонки.Добавить("ПараллельнаяЗагрузка",       Новый ОписаниеТипов("Булево"));
	ДанныеОЗагрузке.Колонки.Добавить("УчитыватьДоступность",       Новый ОписаниеТипов("Булево"));
	
	ОписаниеТиповЭтапа = Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2, СправочникСсылка.ЭтапыПроизводства");
	ДанныеОЗагрузке.Колонки.Добавить("Этап", ОписаниеТиповЭтапа);
	
	ОписаниеТиповРаспоряжения = Новый ОписаниеТипов("ДокументСсылка.ЭтапПроизводства2_2, ДокументСсылка.ЗаказНаПроизводство2_2"); 
	ДанныеОЗагрузке.Колонки.Добавить("Распоряжение", ОписаниеТиповРаспоряжения);
	
	ДанныеОЗагрузке.Колонки.Добавить("юум_ЭлементДерева", Новый ОписаниеТипов("СправочникСсылка.юум_ДеревоЗаказаСлужебный"));
	
	Возврат ДанныеОЗагрузке; 
	
КонецФункции // } #юум

// Возвращаемое значение:
//  Строка - исходный пакет запросов доступности и записанной занятости ВРЦ.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ЗапросОтчета()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДоступностьВидовРабочихЦентровОбороты.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала КАК ДатаИнтервала,
	|	ДоступностьВидовРабочихЦентровОбороты.ДоступностьПоВидуРЦОборот КАК ДоступностьПоВидуРЦОборот,
	|	ДоступностьВидовРабочихЦентровОбороты.ДоступностьПоВидуРЦОборот КАК ДоступностьПоРЦОборот
	|ПОМЕСТИТЬ ВтДоступностьВидовРабочихЦентров
	|ИЗ
	|	РегистрНакопления.ДоступностьВидовРабочихЦентров.Обороты(
	|			,
	|			,
	|			,
	|			ДатаИнтервала МЕЖДУ &НачалоПериода И &КонецПериода
	|				И (&ЛюбойВидРабочегоЦентра
	|					ИЛИ ВидРабочегоЦентра В (&СписокВидовРабочихЦентров))) КАК ДоступностьВидовРабочихЦентровОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДоступностьВидовРабочихЦентровОбороты.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ВЫБОР &ПериодичностьОтчета
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.День) ТОГДА
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, ДЕНЬ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя) ТОГДА
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, НЕДЕЛЯ)
	|		ИНАЧЕ
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, МЕСЯЦ)
	|	КОНЕЦ КАК ПериодГрафика,	
	|	ВидыРабочихЦентров.ПараллельнаяЗагрузка КАК ПараллельнаяЗагрузка,
	|	ВидыРабочихЦентров.УчитыватьДоступностьПоГрафикуРаботы КАК УчитыватьДоступность,
	|	СУММА(ВЫБОР
	|			КОГДА ВидыРабочихЦентров.ВводитьДоступностьДляВидаРЦ
	|				ТОГДА ДоступностьВидовРабочихЦентровОбороты.ДоступностьПоВидуРЦОборот
	|			ИНАЧЕ ДоступностьВидовРабочихЦентровОбороты.ДоступностьПоРЦОборот
	|		КОНЕЦ) КАК Доступно
	|ИЗ
	|	ВтДоступностьВидовРабочихЦентров КАК ДоступностьВидовРабочихЦентровОбороты
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
	|	ПО ВидыРабочихЦентров.Ссылка = ДоступностьВидовРабочихЦентровОбороты.ВидРабочегоЦентра
	|ГДЕ
	|	(&ЛюбоеПодразделение
	|			ИЛИ ВидыРабочихЦентров.Подразделение В (&СписокПодразделений))
	|	И ВЫБОР
	|			КОГДА (ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Час)
	|					ИЛИ ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Смена)
	|					ИЛИ ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.День))
	|					И (ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала МЕЖДУ &НачалоДня И &КонецДня)
	|				ТОГДА ИСТИНА
	|			КОГДА ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Неделя)
	|					И (ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала МЕЖДУ &НачалоНедели И &КонецНедели)
	|				ТОГДА ИСТИНА
	|			КОГДА ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Месяц)
	|					И (ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала МЕЖДУ &НачалоМесяца И &КонецМесяца)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ДоступностьВидовРабочихЦентровОбороты.ВидРабочегоЦентра,
	|	ВидыРабочихЦентров.ПараллельнаяЗагрузка,
	|	ВидыРабочихЦентров.УчитыватьДоступностьПоГрафикуРаботы,
	|	ВЫБОР &ПериодичностьОтчета
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.День) ТОГДА
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, ДЕНЬ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя) ТОГДА
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, НЕДЕЛЯ)
	|		ИНАЧЕ
	|			НАЧАЛОПЕРИОДА(ДоступностьВидовРабочихЦентровОбороты.ДатаИнтервала, МЕСЯЦ)
	|	КОНЕЦ	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗанятостьВидовРабочихЦентров.Распоряжение КАК Распоряжение,
	|	ТаблицаЗанятостьВидовРабочихЦентров.Этап КАК Этап,
	|	ТаблицаЗанятостьВидовРабочихЦентров.КлючПартия КАК КлючПартия,
	|	ТаблицаЗанятостьВидовРабочихЦентров.КодСтрокиПродукция КАК КодСтрокиПродукция,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВариантНаладки КАК ВариантНаладки,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала КАК ДатаИнтервала,
	|	ВидыРабочихЦентров.ПараллельнаяЗагрузка КАК ПараллельнаяЗагрузка,
	|	ВидыРабочихЦентров.УчитыватьДоступностьПоГрафикуРаботы КАК УчитыватьДоступность,
	|	СУММА(ТаблицаЗанятостьВидовРабочихЦентров.Занято) КАК Занято
	|ПОМЕСТИТЬ ЗанятостьВидовРабочихЦентров
	|ИЗ
	|	РегистрНакопления.ДоступностьВидовРабочихЦентров КАК ТаблицаЗанятостьВидовРабочихЦентров
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРабочихЦентров КАК ВидыРабочихЦентров
	|	ПО ВидыРабочихЦентров.Ссылка = ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра
	|ГДЕ
	|	(ТаблицаЗанятостьВидовРабочихЦентров.Регистратор ССЫЛКА Документ.ЭтапПроизводства2_2
	|			ИЛИ ТаблицаЗанятостьВидовРабочихЦентров.Регистратор ССЫЛКА Документ.РегистраторГрафикаПроизводства
	|	)
	|	И (&ЛюбойВидРабочегоЦентра
	|			ИЛИ ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра В (&СписокВидовРабочихЦентров))
	|	И ВЫБОР
	|			КОГДА (ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Час)
	|					ИЛИ ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Смена)
	|					ИЛИ ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.День))
	|					И (ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала МЕЖДУ &НачалоДня И &КонецДня)
	|				ТОГДА ИСТИНА
	|			КОГДА ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Неделя)
	|					И (ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала МЕЖДУ &НачалоНедели И &КонецНедели)
	|				ТОГДА ИСТИНА
	|			КОГДА ВидыРабочихЦентров.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Месяц)
	|					И (ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала МЕЖДУ &НачалоМесяца И &КонецМесяца)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЗанятостьВидовРабочихЦентров.Распоряжение,
	|	ТаблицаЗанятостьВидовРабочихЦентров.Этап,
	|	ТаблицаЗанятостьВидовРабочихЦентров.КлючПартия,
	|	ТаблицаЗанятостьВидовРабочихЦентров.КодСтрокиПродукция,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВариантНаладки,
	|	ВидыРабочихЦентров.ПараллельнаяЗагрузка,
	|	ВидыРабочихЦентров.УчитыватьДоступностьПоГрафикуРаботы,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала
	|;
	|";
	
	ТекстЗапроса = ТекстЗапроса + юум_ФП_Загрузка_ЗапросДереваОтчета();
	
	ТекстЗапроса = ТекстЗапроса + "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЗанятостьВидовРабочихЦентров.Распоряжение КАК Распоряжение,
	|	ТаблицаЗанятостьВидовРабочихЦентров.Этап КАК Этап,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВариантНаладки КАК ВариантНаладки,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра.Подразделение КАК Подразделение,
	|	ТаблицаЗанятостьВидовРабочихЦентров.ПараллельнаяЗагрузка КАК ПараллельнаяЗагрузка,
	|	ТаблицаЗанятостьВидовРабочихЦентров.УчитыватьДоступность КАК УчитыватьДоступность,
	|	ВЫБОР
	|		КОГДА ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Час)
	|				ИЛИ ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра.Подразделение.ИнтервалПланирования = ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.Смена)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ТочностьГрафикаПроизводства.День)
	|		ИНАЧЕ ТаблицаЗанятостьВидовРабочихЦентров.ВидРабочегоЦентра.Подразделение.ИнтервалПланирования
	|	КОНЕЦ КАК ИнтервалПланирования,
	|	ВЫБОР &ПериодичностьОтчета
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.День) ТОГДА
	|			НАЧАЛОПЕРИОДА(ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала, ДЕНЬ)
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.Периодичность.Неделя) ТОГДА
	|			НАЧАЛОПЕРИОДА(ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала, НЕДЕЛЯ)
	|		ИНАЧЕ
	|			НАЧАЛОПЕРИОДА(ТаблицаЗанятостьВидовРабочихЦентров.ДатаИнтервала, МЕСЯЦ)
	|	КОНЕЦ КАК ПериодГрафика,
	|	НЕОПРЕДЕЛЕНО КАК Номенклатура,
	|	НЕОПРЕДЕЛЕНО КАК Характеристика,
	|	ЕСТЬNULL(ВтДеревоЗаказов.юум_ЭлементДерева, ЗНАЧЕНИЕ(Справочник.юум_ДеревоЗаказаСлужебный.ПустаяСсылка)) КАК юум_ЭлементДерева,
	|	0 КАК Количество, 
	|	ВЫРАЗИТЬ(ТаблицаЗанятостьВидовРабочихЦентров.Занято * ЕСТЬNULL(ВтДеревоЗаказов.Доля, 1) КАК ЧИСЛО(15, 3)) КАК Занято
	|ИЗ
	|	ЗанятостьВидовРабочихЦентров КАК ТаблицаЗанятостьВидовРабочихЦентров
	// Галфинд dlip 2026/10/26 {
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВтДеревоЗаказовОкончательное КАК ВтДеревоЗаказов
	|		ПО ТаблицаЗанятостьВидовРабочихЦентров.Распоряжение = ВтДеревоЗаказов.ЗаказНаПроизводство
	|			И ТаблицаЗанятостьВидовРабочихЦентров.КлючПартия = ВтДеревоЗаказов.КлючПартия
	// Галфинд dlip }
	|ГДЕ
	|	ТаблицаЗанятостьВидовРабочихЦентров.Распоряжение ССЫЛКА Документ.ЗаказНаПроизводство2_2
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // } #юум

// Возвращаемое значение:
//  Строка - исходный запрос связей загрузки со служебным деревом заказа.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ЗапросДереваОтчета()
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтДанные.Распоряжение КАК ЗаказНаПроизводство,
	|	ВтДанные.КлючПартия КАК КлючПартия
	|ПОМЕСТИТЬ ВтВсеКлючиПартий
	|ИЗ
	|	ЗанятостьВидовРабочихЦентров КАК ВтДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтВсеКлючиПартий.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтВсеКлючиПартий.КлючПартия КАК КлючПартия,
	|	СтруктураЗаказа.КлючНоменклатура КАК КлючНоменклатура
	|ПОМЕСТИТЬ ВтСтруктураЗаказов
	|ИЗ
	|	ВтВсеКлючиПартий КАК ВтВсеКлючиПартий
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтруктураЗаказа КАК СтруктураЗаказа
	|		ПО ВтВсеКлючиПартий.ЗаказНаПроизводство = СтруктураЗаказа.ЗаказНаПроизводство
	|			И ВтВсеКлючиПартий.КлючПартия = СтруктураЗаказа.КлючПартия
	|			И (СтруктураЗаказа.ВидСтроки В (ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПолуфабриката), ЗНАЧЕНИЕ(Перечисление.ВидыСтрокСтруктурыЗаказаНаПроизводство.ПроизводствоПродукции)))
	|			И (НЕ СтруктураЗаказа.ДополнительнаяЗапись)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтСтруктураЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтСтруктураЗаказов.КлючПартия КАК КлючПартия,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Ссылка, ЗНАЧЕНИЕ(Справочник.юум_ДеревоЗаказаСлужебный.ПустаяСсылка)) КАК юум_ЭлементДерева,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Уровень, 0) КАК Уровень,
	|	ЕСТЬNULL(ДеревоЗаказовПодробное.Доля, 0) КАК Доля
	|ПОМЕСТИТЬ ВтДеревоЗаказов
	|ИЗ
	|	ВтСтруктураЗаказов КАК ВтСтруктураЗаказов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.юум_ДеревоЗаказаСлужебный КАК ДеревоЗаказовПодробное
	|		ПО ВтСтруктураЗаказов.ЗаказНаПроизводство = ДеревоЗаказовПодробное.ЗаказНаПроизводство
	|			И ВтСтруктураЗаказов.КлючНоменклатура = ДеревоЗаказовПодробное.КлючНоменклатура
	|			И (НЕ ДеревоЗаказовПодробное.ПометкаУдаления)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтДеревоЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия КАК КлючПартия,
	|	СУММА(ВтДеревоЗаказов.Доля) КАК Доля,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВтДеревоЗаказов.юум_ЭлементДерева) КАК КоличествоЭлементовДерева
	|ПОМЕСТИТЬ ВтПодозрительныеДоли
	|ИЗ
	|	ВтДеревоЗаказов КАК ВтДеревоЗаказов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтДеревоЗаказов.ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВтДеревоЗаказов.Доля) <> 1
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВтДеревоЗаказов.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
	|	ВтДеревоЗаказов.КлючПартия КАК КлючПартия,
	|	ВтДеревоЗаказов.юум_ЭлементДерева КАК юум_ЭлементДерева,
	|	ВтДеревоЗаказов.Уровень КАК Уровень,
	|	ВтДеревоЗаказов.Доля КАК Доля
	|ПОМЕСТИТЬ ВтДеревоЗаказовОкончательное
	|ИЗ
	|	ВтДеревоЗаказов КАК ВтДеревоЗаказов
	|ГДЕ
	|	ВтДеревоЗаказов.Доля <> 0	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВтПодозрительныеДоли.ЗаказНаПроизводство,
	|	ВтПодозрительныеДоли.КлючПартия,
	|	ЕСТЬNULL(ДеревоЗаказовПодробноеНулевогоУровня.Ссылка, ЗНАЧЕНИЕ(Справочник.юум_ДеревоЗаказаСлужебный.ПустаяСсылка)),
	|	0,
	|	(1 - ВтПодозрительныеДоли.Доля)
	|ИЗ
	|	ВтПодозрительныеДоли КАК ВтПодозрительныеДоли
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.юум_ДеревоЗаказаСлужебный КАК ДеревоЗаказовПодробноеНулевогоУровня
	|		ПО ВтПодозрительныеДоли.ЗаказНаПроизводство = ДеревоЗаказовПодробноеНулевогоУровня.ЗаказНаПроизводство
	|			И (ДеревоЗаказовПодробноеНулевогоУровня.Уровень = 0)
	|ГДЕ
	|	(1 - ВтПодозрительныеДоли.Доля) <> 0
	|;
	|";
	
	Возврат ТекстЗапроса;
	
КонецФункции // } #юум

// Параметры:
//  ДанныеОЗагрузке - ТаблицаЗначений - заполняемый набор отчета.
//  ВыборкаДанных - СтрокаТаблицыЗначений - строка занятости или вида рабочего центра.
//  ТекущийПериод - Дата - начало интервала результата.
//  ИнтервалПериодичности - ПеречислениеСсылка.ТочностьГрафикаПроизводства - точность периода.
//  НайденнаяДоступностьВРЦ - Массив из СтрокаТаблицыЗначений - доступность в интервале.
//  НайденнаяСводнаяЗанятостьВРЦ - Массив из СтрокаТаблицыЗначений - сводная занятость.
//  НайденнаяСводнаяДоступностьВРЦ - Массив из СтрокаТаблицыЗначений - сводная доступность.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Процедура юум_ФП_Загрузка_СтрокаОтчета(ДанныеОЗагрузке, ВыборкаДанных, ТекущийПериод, ИнтервалПериодичности,
	НайденнаяДоступностьВРЦ, НайденнаяСводнаяЗанятостьВРЦ, НайденнаяСводнаяДоступностьВРЦ)
	
	СтрокаДанные = ДанныеОЗагрузке.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаДанные, ВыборкаДанных);
	
	СтрокаДанные.ПериодГрафика = ТекущийПериод;
	
	СтрокаДанные.ПериодГрафикаПредставление = ОперативныйУчетПроизводства.ИнтервалПланированияСтрокой(
		СтрокаДанные.ПериодГрафика, 
		ИнтервалПериодичности);
	
	Если НайденнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.Доступно = НайденнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли;
	
	Если НайденнаяСводнаяЗанятостьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ЗанятоСводно = НайденнаяСводнаяЗанятостьВРЦ[0].Занято;
	КонецЕсли; 
	
	Если НайденнаяСводнаяДоступностьВРЦ.Количество() <> 0 Тогда
		СтрокаДанные.ДоступноСводно = НайденнаяСводнаяДоступностьВРЦ[0].Доступно;
	КонецЕсли; 

КонецПроцедуры // } #юум

// Параметры:
//  НастройкиОсновнойСхемы - НастройкиКомпоновкиДанных - настройки отчета.
// Возвращаемое значение:
//  Структура - списки подразделений и ВРЦ, границы периода и периодичность.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ОтборыОтчета(НастройкиОсновнойСхемы) Экспорт

	Период = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиОсновнойСхемы, "Период").Значение; 
	ПериодичностьОтчета = КомпоновкаДанныхКлиентСервер.ПолучитьПараметр(НастройкиОсновнойСхемы, "ПериодичностьОтчета").Значение;
	
	ЭлементыОтбора = НастройкиОсновнойСхемы.Отбор.Элементы;
	
	СписокПодразделений = Новый СписокЗначений;
	СписокВидовРабочихЦентров = Новый СписокЗначений;
	
	Если ЭлементыОтбора <> Неопределено Тогда
		Подразделение  = юум_ФП_Загрузка_ЗначениеОтбора("Подразделение", ЭлементыОтбора);
		Если Подразделение <> Неопределено И ТипЗнч(Подразделение) = Тип("СписокЗначений") Тогда
			СписокПодразделений.ЗагрузитьЗначения(Подразделение.ВыгрузитьЗначения());
		Иначе
			Если Подразделение <> Неопределено Тогда
				СписокПодразделений.Добавить(Подразделение);
			КонецЕсли;
		КонецЕсли;
		
		ВидРабочегоЦентра = юум_ФП_Загрузка_ЗначениеОтбора("ВидРабочегоЦентра", ЭлементыОтбора);
		Если ВидРабочегоЦентра <> Неопределено И ТипЗнч(ВидРабочегоЦентра) = Тип("СписокЗначений") Тогда
			СписокВидовРабочихЦентров.ЗагрузитьЗначения(ВидРабочегоЦентра.ВыгрузитьЗначения());
		Иначе
			Если ВидРабочегоЦентра <> Неопределено Тогда
				СписокВидовРабочихЦентров.Добавить(ВидРабочегоЦентра);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	ЗначенияОтбораДанных = Новый Структура;
	ЗначенияОтбораДанных.Вставить("СписокПодразделений",          СписокПодразделений);
	ЗначенияОтбораДанных.Вставить("СписокВидовРабочихЦентров",    СписокВидовРабочихЦентров);
	ЗначенияОтбораДанных.Вставить("НачалоПериода",                Период.ДатаНачала);
	ЗначенияОтбораДанных.Вставить("ОкончаниеПериода",             Период.ДатаОкончания);
	ЗначенияОтбораДанных.Вставить("ПериодичностьОтчета", 		  ПериодичностьОтчета);
	
	Возврат ЗначенияОтбораДанных;
	
КонецФункции // } #юум

// Параметры:
//  ИмяПоля - Строка - имя поля отбора.
//  ЭлементыОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - элементы отбора.
// Возвращаемое значение:
//  Произвольный - правое значение активного отбора либо Неопределено.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ЗначениеОтбора(ИмяПоля, ЭлементыОтбора)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для каждого ЭлементКоллекции Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементКоллекции) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементКоллекции.ЛевоеЗначение = Поле 
			И ЭлементКоллекции.Использование Тогда
			
			Возврат ЭлементКоллекции.ПравоеЗначение;
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Неопределено;

КонецФункции // } #юум

// Параметры:
//  Периодичность - ПеречислениеСсылка.Периодичность - периодичность отчета.
// Возвращаемое значение:
//  ПеречислениеСсылка.ТочностьГрафикаПроизводства - день, неделя или месяц.
// #юум {
// #ЧТЗ 04.01
// Единый источник записанной загрузки для отчета и формирования партий.
// Галфинд mr. Cherryman 2026/11/16
Функция юум_ФП_Загрузка_ИнтервалОтчета(Периодичность)
	
	Результат = Перечисления.ТочностьГрафикаПроизводства.День;
	
	Если Периодичность = Перечисления.Периодичность.Неделя Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Неделя;
		
	ИначеЕсли Периодичность = Перечисления.Периодичность.Месяц 
		Или Периодичность = Перечисления.Периодичность.Квартал Тогда
		Результат = Перечисления.ТочностьГрафикаПроизводства.Месяц;
		
	Иначе
		Результат = Перечисления.ТочностьГрафикаПроизводства.День;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // } #юум

#КонецОбласти

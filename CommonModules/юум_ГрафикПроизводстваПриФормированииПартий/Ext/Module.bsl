		|					И ЕСТЬNULL(Партии.НоменклатураПеремещения.КонтролироватьКачествоПоступившегоТовара, ЛОЖЬ)
		|				ТОГДА Партии.НоменклатураПеремещения.СрокКонтроляКачества
		|			ИНАЧЕ 0
		|		КОНЕЦ                     КАК ДлительностьЭтапа,
		|	ИСТИНА                        КАК РазмещатьВДнях,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) = 0
		|			ТОГДА 0.0001
		|		ИНАЧЕ ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) * 86400
		|	КОНЕЦ                         КАК Ресурсоемкость,
		|	0                             КАК БуферДо,
		|	ЛОЖЬ                          КАК БуферДоРазмещатьВДнях,
		|	0                             КАК БуферПосле,
		|	ЛОЖЬ                          КАК БуферПослеРазмещатьВДнях,
		|	ЛОЖЬ                          КАК Непрерывный,
		|	ВЫБОР
		|		КОГДА &ТекстЗапросаДатаДоступности >= &ТекстЗапросаДатаПредшественников
		|			И &ТекстЗапросаДатаДоступности >= ДанныеЗаказа.НачатьНеРанее
		|			И &ТекстЗапросаДатаДоступности >= &ТекстЗапросаЭтапРемонтаПланироватьНеРанее
		|			И &ТекстЗапросаДатаДоступности >= &ТекущаяДата
		|			ТОГДА &ТекстЗапросаДатаДоступности
		|		КОГДА &ТекстЗапросаДатаПредшественников >= ДанныеЗаказа.НачатьНеРанее
		|			И &ТекстЗапросаДатаПредшественников >= &ТекстЗапросаЭтапРемонтаПланироватьНеРанее
		|			И &ТекстЗапросаДатаПредшественников >= &ТекущаяДата
		|			ТОГДА &ТекстЗапросаДатаПредшественников
		|		КОГДА ДанныеЗаказа.НачатьНеРанее >= &ТекстЗапросаЭтапРемонтаПланироватьНеРанее
		|			И ДанныеЗаказа.НачатьНеРанее >= &ТекущаяДата
		|			ТОГДА ДанныеЗаказа.НачатьНеРанее
		|		КОГДА &ТекстЗапросаЭтапРемонтаПланироватьНеРанее >= &ТекущаяДата
		|			ТОГДА &ТекстЗапросаЭтапРемонтаПланироватьНеРанее
		|		ИНАЧЕ &ТекущаяДата
		|	КОНЕЦ                         КАК НачалоРазмещения,
		|
		|	ИСТИНА                        КАК Планировать,
		|	ЛОЖЬ                          КАК ЭтоДокумент,
		|	ИСТИНА                        КАК ЭтоПеремещение,
		|	Партии.ЭтоПроизводствоПродукции КАК ЭтоПроизводствоПродукции,
		|	ЛОЖЬ                          КАК ЭтоПланированиеРабот,
		|	ЛОЖЬ                          КАК ЭтоНачальныйЭтапРемонта,
		|	ДАТАВРЕМЯ(1,1,1)              КАК ПланироватьНеРанее,
		|	ДАТАВРЕМЯ(1,1,1)              КАК ПраваяГраница,
		|	ЛОЖЬ                          КАК ЕстьПраваяГраница,
		|	ДанныеЗаказа.ТипПроизводственногоПроцесса
		|		= ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.Сборка) КАК СмещатьВправо,
		|	ДАТАВРЕМЯ(1,1,1,0,0,0)                               КАК НачалоЗагрузкиВРЦ,
		|	ДАТАВРЕМЯ(1,1,1,0,0,0)                               КАК ОкончаниеЗагрузкиВРЦ,
		|	ЕСТЬNULL(График.Начало, ДАТАВРЕМЯ(1,1,1))            КАК НачалоДоИзменения,
		|	ЕСТЬNULL(График.Окончание, ДАТАВРЕМЯ(1,1,1))         КАК ОкончаниеДоИзменения,
		|	ЗНАЧЕНИЕ(Справочник.ВидыРабочихЦентров.ПустаяСсылка) КАК ВидРабочегоЦентраДоИзменения,
		|	ЛОЖЬ                                                 КАК ГрафикИзменен,
		|	ВЫБОР
		|		КОГДА ЗаказыНаРемонтКРасчетуПорядка.ЗаказНаПроизводство ЕСТЬ НЕ NULL
		|			ТОГДА Партии.Уровень
		|		КОГДА ДанныеЗаказа.ТипПроизводственногоПроцесса = ЗНАЧЕНИЕ(Перечисление.ТипыПроизводственныхПроцессов.ВыполнениеРемонтныхРабот)
		|			ТОГДА -ЕСТЬNULL(График.Порядок, 0)
		|		ИНАЧЕ Партии.Порядок
		|	КОНЕЦ                                                КАК Порядок1,
		|	0                                                    КАК Порядок2
		|ИЗ
		|	ВТПартии КАК Партии
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИ
		|	ПО Партии.НоменклатураПеремещения = КэшНСИ.Номенклатура
		|		И Партии.ХарактеристикаПеремещения = КэшНСИ.Характеристика
		|		И Партии.СкладПеремещения = КэшНСИ.Склад
		|		И Партии.НазначениеПеремещения = КэшНСИ.Назначение
		|		И Партии.ЗаказНаПроизводство = КэшНСИ.ЗаказНаПроизводство
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТОграниченияГрафикаПроизводстваПоМатериалам КАК Обеспечение
		|	ПО Партии.ЗаказНаПроизводство = Обеспечение.ЗаказНаПроизводство
		|		И Партии.КлючПартия = Обеспечение.КлючПартия
		|		И Обеспечение.Этап = ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТДатыНепланируемыхПредшественников КАК ДатыПредшественников
		|	ПО Партии.КлючПартия = ДатыПредшественников.КлючПартия
		|		И ДатыПредшественников.Этап = ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказНаПроизводство2_2 КАК ДанныеЗаказа
		|	ПО Партии.ЗаказНаПроизводство = ДанныеЗаказа.Ссылка
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ ВТЗаказыНаРемонтКРасчетуПорядка КАК ЗаказыНаРемонтКРасчетуПорядка
		|	ПО Партии.ЗаказНаПроизводство = ЗаказыНаРемонтКРасчетуПорядка.ЗаказНаПроизводство
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
		|	ПО Партии.ЗаказНаПроизводство = График.ЗаказНаПроизводство
		|		И График.СтатусГрафика = 0
		|		И График.Этап = ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)
		|		И Партии.КлючПартия = График.КлючПартия
		|ГДЕ
		|	Партии.Ссылка = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаДатаДоступности",
		"ЕСТЬNULL(Обеспечение.ДатаДоступности, ДАТАВРЕМЯ(1,1,1))");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаЭтапПланироватьНеРанее",
		"ЕСТЬNULL(ВЫРАЗИТЬ(Этапы.ПланироватьНеРанее КАК ДАТА), ДАТАВРЕМЯ(1,1,1))");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаЭтапРемонтаПланироватьНеРанее",
		"ЕСТЬNULL(ВЫРАЗИТЬ(ВЫРАЗИТЬ(График.ПланироватьНеРанееЭтап КАК Документ.ЭтапПроизводства2_2).ПланироватьНеРанее КАК ДАТА), ДАТАВРЕМЯ(1,1,1))");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТекстЗапросаДатаПредшественников",
		"ЕСТЬNULL(ДатыПредшественников.Окончание, ДАТАВРЕМЯ(1,1,1))");
	
	ТекстЗапросаПорядок = 
		"
		|УПОРЯДОЧИТЬ ПО
		|	Порядок1,
		|	Порядок2";//@Query-part
	
	Если СоздатьВТ Тогда
		ТекстЗапросаВТ = 
			"ВЫБРАТЬ ПЕРВЫЕ 10000000
			|	*,
			|	АВТОНОМЕРЗАПИСИ() КАК НомерЗаписи
			|ПОМЕСТИТЬ ВТЭтапы
			|ИЗ
			|	(&ТекстЗапросаВыборка) КАК ВложенныйЗапрос
			|
			|&ТекстЗапросаПорядок
			|
			|ИНДЕКСИРОВАТЬ ПО НАБОРАМ (
			|	(ЗаказНаПроизводство, НомерЗаписи),
			|	(ЗаказНаПроизводство, КлючПартия, Этап)
			|)
			|";//@Query-part
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапросаВТ,
			"&ТекстЗапросаВыборка",
			ТекстЗапроса);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаПорядок",
			ТекстЗапросаПорядок);
	Иначе
		ТекстЗапроса = ТекстЗапроса + ТекстЗапросаПорядок;
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
// } #юум
КонецФункции


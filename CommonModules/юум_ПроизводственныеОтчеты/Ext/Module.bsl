#Область ПрограммныйИнтерфейс

// Подсчитывает количество для текущего родительского узла иерархии.
// из переданной таблицы значений выбираются строки с нужным уровнем вложенности.
//
// Параметры:
//   ТаблицаДанных - ТаблицаЗначений - Таблица с данными подчиненных элементов и их уровней вложенности, 
//                                     сформированная функцией СКД ТаблицаЗначений()
//                                     Обязательные колонки таблицы:
//                                       * Количество - Число - количество (шт.) изделий;
//                                       * Уровень    - Число - юум_ЭлементДерева.Уровень
//
//   Уровень  - Число - текущий уровень иерархической ветки отчета СКД (СистемныеПоля.Уровень).
//   УровеньВГруппировке  - Число - текущий уровень в группировке отчета СКД, УровеньВГруппировке().
//
// Возвращаемое значение:
//   Число - Количество для текущего узла, если таблица пуста, возвращает 0.
// 
Функция ПолучитьЗначениеУзлаЭлементДереваИерархия(Знач ТаблицаДанных, Уровень, УровеньВГруппировке) Экспорт 
	
    Если Не ЗначениеЗаполнено(ТаблицаДанных) Тогда
        Возврат 0;
	КонецЕсли; 
	
	ПараметрыОтбора = Новый Структура("Уровень", УровеньВГруппировке);
	ТаблицаСНужнымУровнем = ТаблицаДанных.Скопировать(ПараметрыОтбора); 
	
	Если Не ЗначениеЗаполнено(ТаблицаСНужнымУровнем) И УровеньВГруппировке = 0 Тогда
		
		ПараметрыОтбора = Новый Структура("Уровень", 1);
		ТаблицаСНужнымУровнем = ТаблицаДанных.Скопировать(ПараметрыОтбора);
		
	КонецЕсли; 
	
    Возврат ТаблицаСНужнымУровнем.Итог("Количество");
    
КонецФункции

// Склеивает представление элемента справочника Дерево заказа служебный
// 
// Парамтеры:
//   ЭлементДерева - СправочникСсылка.юум_ДеревоЗаказаСлужебный - элемент для которого нужно склеить представление
//
// Возвращаемое значение:
//   Строка - прдставление элемента
// 
Функция ПредставлениеУзлаДереваЗаказа(ЭлементДерева) Экспорт
	
	РеквизитыЭлементаДерева = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементДерева, "Уровень, ЗаказНаПроизводство");
	
	Если РеквизитыЭлементаДерева.Уровень = 0 Тогда
		
		РеквизитыЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЭлементаДерева.ЗаказНаПроизводство, "Номер, ДатаПотребности");
		
		Возврат НСтр("ru = 'Заказ №'; en = 'Order #'") + СокрЛП(РеквизитыЗаказа.Номер) + "; "
			+ НСтр("ru = 'дата потребности:'; en = 'demand date:'") + " " + Формат(РеквизитыЗаказа.ДатаПотребности, "ДФ='dd.MM.yyyy (ddd)'");		
		
	Иначе
		
		Возврат ""+ЭлементДерева;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура юум_ЗаполнитьПравилаКонвертацииОбъектов(НаправлениеОбмена, ПравилаКонвертации)
	Если Метаданные.Имя = "УправлениеПредприятием" Тогда
		Если НаправлениеОбмена = "Отправка" Тогда
			ДобавитьПКО_Справочник_умЗаказы_Отправка(ПравилаКонвертации);
			ДобавитьПКО_Документ_умИсходныеДанныеСделок_Отправка(ПравилаКонвертации);
			
		ИначеЕсли НаправлениеОбмена = "Получение" Тогда
			ДобавитьПКО_Справочник_умБригады_Получение(ПравилаКонвертации);
			ДобавитьПКО_Справочник_юумФизическиеЛица_Получение(ПравилаКонвертации);
			//ДобавитьПКО_Справочник_юумПодразделения_Получение(ПравилаКонвертации);
			ДобавитьПКО_Регистр_юумКоличествоВРЦ_Получение(ПравилаКонвертации);
			ДобавитьПКО_Регистр_РасценкиРаботСотрудников_Получение(ПравилаКонвертации);
			ДобавитьПКО_Справочник_РазрядыКатегорииДолжностей_Получение(ПравилаКонвертации);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#Область Справочник_умЗаказы

Процедура ДобавитьПКО_Справочник_умЗаказы_Отправка(ПравилаКонвертации)
	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Справочник_умЗаказы_Отправка";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ЗаказНаПроизводство2_2;
	ПравилоКонвертации.ОбъектФормата                = "Справочник.умЗаказы";
	ПравилоКонвертации.ПриОтправкеДанных			= "ПКО_Справочник_умЗаказы_Отправка_ПриОтправкеДанных";
	//ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Справочник_Банки_ПриКонвертацииДанныхXDTO";

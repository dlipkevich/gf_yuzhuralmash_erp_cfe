&ИзменениеИКонтроль("ПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение_ПриКонвертацииДанныхXDTO")
Процедура юум_ПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	ПолученныеДанные.Проведен = Истина;

	// Сводно, ПроводкиПоРаботникам
	ПолученныеДанные.Сводно               = Истина;
	ПолученныеДанные.ПроводкиПоРаботникам = Ложь;

	ВидыОперацийПоЗарплатеЗначения         = Метаданные.Перечисления.ВидыОперацийПоЗарплате.ЗначенияПеречисления;
	ВидыНачисленияОплатыТрудаДляНУЗначения = Метаданные.Перечисления.ВидыНачисленийОплатыТрудаДляНУ.ЗначенияПеречисления;
	СпособыРасчетовСФизическимиЛицами      = Метаданные.Перечисления.СпособыРасчетовСФизическимиЛицами.ЗначенияПеречисления;

	// НачисленнаяЗарплатаИВзносы
	НачисленнаяЗарплатаИВзносыXDTO = Неопределено;

	Если ДанныеXDTO.Свойство("НачисленнаяЗарплатаИВзносы", НачисленнаяЗарплатаИВзносыXDTO)
		И ЗначениеЗаполнено(НачисленнаяЗарплатаИВзносыXDTO) Тогда

		МассивНачисленнаяЗарплатаИВзносы = Новый Массив; 

		Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда 
			Если ДанныеXDTO.AdditionalInfo.Свойство("ВзносыПоЕдиномуТарифу") Тогда
				ТЗВзносыПоЕдиномуТарифу = ДанныеXDTO.AdditionalInfo.ВзносыПоЕдиномуТарифу;
			КонецЕсли;
		КонецЕсли;    

		Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда 
			Если ДанныеXDTO.AdditionalInfo.Свойство("ВзносыПоМеждународнымДоговорам") Тогда
				ТЗВзносыПоМеждународнымДоговорам = ДанныеXDTO.AdditionalInfo.ВзносыПоМеждународнымДоговорам;
			КонецЕсли;
		КонецЕсли; 

		#Вставка
		// реализовал поиск элемента спр-ка СтруктураПредприятия по Коду БУ
		ТЗКодыБУ = Неопределено;
		Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
			Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда 
				Если ДанныеXDTO.AdditionalInfo.Свойство("КодыБУ") Тогда
					ТЗКодыБУ = ДанныеXDTO.AdditionalInfo.КодыБУ;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли; 
		#КонецВставки
		Для Каждого СтрокаНачисленнаяЗарплатаИВзносыXDTO Из НачисленнаяЗарплатаИВзносыXDTO Цикл

			СтрокаНачисленнаяЗарплатаИВзносы = Новый Структура(
			"ПодразделениеПредприятия,
			|ВидОперации,
			|СпособОтраженияЗарплатыВБухучете,
			|ОблагаетсяЕНВД,
			|Сумма,
			|ВзносыВсего,
			|ВидНачисленияОплатыТрудаДляНУ,
			|ПФРСтраховая,
			|ПФРНакопительная,
			|ПФРПоСуммарномуТарифу,
			|ПФРНаДоплатуЛетчикам,
			|ПФРНаДоплатуШахтерам,
			|ПФРЗаЗанятыхНаПодземныхИВредныхРаботах,
			|ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах,
			|ФСС,
			|ФФОМС,
			|ТФОМС,
			|ФССНесчастныеСлучаи,
			|ПФРДоПредельнойВеличины,
			|ПФРСПревышения,
			|ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки,
			|ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка,
			|ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки,
			|ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка,
			|ВзносыПоЕдиномуТарифу,
			|СпособРасчетов,
			|Резерв,
			|РезервБУ,
			|РезервНУ,
			|СпособРасчетов,
			|ОПСпоМеждународнымДоговорам,
			|ОПСпоМеждународнымДоговорамСПревышения,
			|ОМСпоМеждународнымДоговорам,
			|ОМСпоМеждународнымДоговорамСПревышения,
			|ОССпоМеждународнымДоговорам,
			|ОССпоМеждународнымДоговорамСПревышения");

			ЗаполнитьЗначенияСвойств(СтрокаНачисленнаяЗарплатаИВзносы, СтрокаНачисленнаяЗарплатаИВзносыXDTO);
			СтрокаНачисленнаяЗарплатаИВзносы.СпособОтраженияЗарплатыВБухучете = СтрокаНачисленнаяЗарплатаИВзносыXDTO.СпособОтраженияЗарплатыВФинансовомУчете;

			СтрокаПодразделениеXDTO = Новый Структура("Подразделение");
			ЗаполнитьЗначенияСвойств(СтрокаПодразделениеXDTO, СтрокаНачисленнаяЗарплатаИВзносыXDTO);
			Если ЗначениеЗаполнено(СтрокаПодразделениеXDTO.Подразделение)
				И ТипЗнч(СтрокаПодразделениеXDTO.Подразделение) = Тип("Структура") Тогда
				Если Не СтрокаПодразделениеXDTO.Подразделение.Свойство("Ссылка") Тогда
					СтрокаНачисленнаяЗарплатаИВзносы.ПодразделениеПредприятия = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
				Иначе
					СтрокаНачисленнаяЗарплатаИВзносы.ПодразделениеПредприятия = Новый Структура("Значение, ИмяПКО",
					СтрокаПодразделениеXDTO.Подразделение, "Справочник_Подразделения_Получение");
				КонецЕсли;
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаНачисленнаяЗарплатаИВзносы.ВидОперации) Тогда
				ВидОперацииМД = ВидыОперацийПоЗарплатеЗначения.Найти(СтрокаНачисленнаяЗарплатаИВзносы.ВидОперации);
				Если Не ВидОперацииМД = Неопределено Тогда
					СтрокаНачисленнаяЗарплатаИВзносы.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.Получить(ВидыОперацийПоЗарплатеЗначения.Индекс(ВидОперацииМД));
				КонецЕсли;
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаНачисленнаяЗарплатаИВзносы.ВидНачисленияОплатыТрудаДляНУ) Тогда
				ВидНачисленияОплатыТрудаДляНУМД = ВидыНачисленияОплатыТрудаДляНУЗначения.Найти(СтрокаНачисленнаяЗарплатаИВзносы.ВидНачисленияОплатыТрудаДляНУ);
				Если Не ВидНачисленияОплатыТрудаДляНУМД = Неопределено Тогда
					СтрокаНачисленнаяЗарплатаИВзносы.ВидНачисленияОплатыТрудаДляНУ =
					Перечисления.ВидыНачисленийОплатыТрудаДляНУ.Получить(ВидыНачисленияОплатыТрудаДляНУЗначения.Индекс(ВидНачисленияОплатыТрудаДляНУМД));
				КонецЕсли;
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаНачисленнаяЗарплатаИВзносы.СпособРасчетов) Тогда
				СпособРасчетовМД = СпособыРасчетовСФизическимиЛицами.Найти(СтрокаНачисленнаяЗарплатаИВзносы.СпособРасчетов);
				Если Не СпособРасчетовМД = Неопределено Тогда
					СтрокаНачисленнаяЗарплатаИВзносы.СпособРасчетов = 
					Перечисления.СпособыРасчетовСФизическимиЛицами.Получить(СпособыРасчетовСФизическимиЛицами.Индекс(СпособРасчетовМД));
				КонецЕсли;
			КонецЕсли;

			КолонкиДляСуммированияСтрокой = Документы.ОтражениеЗарплатыВФинансовомУчете.КолонкиДляСуммирования();
			КолонкиДляСуммирования = Новый Структура(КолонкиДляСуммированияСтрокой);

			СтрокаНачисленнаяЗарплатаИВзносы.ВзносыВсего = 0;
			Для Каждого Колонка Из КолонкиДляСуммирования Цикл
				Если СтрокаНачисленнаяЗарплатаИВзносы[Колонка.Ключ] = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				СтрокаНачисленнаяЗарплатаИВзносы.ВзносыВсего = СтрокаНачисленнаяЗарплатаИВзносы.ВзносыВсего
				+ СтрокаНачисленнаяЗарплатаИВзносы[Колонка.Ключ];
			КонецЦикла;

			Если Не ТЗВзносыПоЕдиномуТарифу = Неопределено Тогда  
				Отбор = Новый Структура("ИдентификаторСтроки", СтрокаНачисленнаяЗарплатаИВзносыXDTO.ИдентификаторСтроки);
				МассивВзносыПоЕдиномуТарифу = ТЗВзносыПоЕдиномуТарифу.НайтиСтроки(Отбор);	
				Если НЕ МассивВзносыПоЕдиномуТарифу = Неопределено И МассивВзносыПоЕдиномуТарифу.Количество()> 0  Тогда
					Для каждого Строка Из МассивВзносыПоЕдиномуТарифу Цикл  
						СтрокаНачисленнаяЗарплатаИВзносы.ВзносыПоЕдиномуТарифу = Строка.Сумма;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			Если Не ТЗВзносыПоМеждународнымДоговорам = Неопределено Тогда  
				Отбор = Новый Структура("ИдентификаторСтроки", СтрокаНачисленнаяЗарплатаИВзносыXDTO.ИдентификаторСтроки);
				МассивВзносыПоМеждународнымДоговорам = ТЗВзносыПоМеждународнымДоговорам.НайтиСтроки(Отбор);	
				Если НЕ МассивВзносыПоМеждународнымДоговорам = Неопределено И МассивВзносыПоМеждународнымДоговорам.Количество()> 0  Тогда
					Для каждого Строка Из МассивВзносыПоМеждународнымДоговорам Цикл  
						СтрокаНачисленнаяЗарплатаИВзносы.ОПСпоМеждународнымДоговорам = Строка.ОПСпоМеждународнымДоговорам;
						СтрокаНачисленнаяЗарплатаИВзносы.ОПСпоМеждународнымДоговорамСПревышения = Строка.ОПСпоМеждународнымДоговорамСПревышения;
						СтрокаНачисленнаяЗарплатаИВзносы.ОМСпоМеждународнымДоговорам = Строка.ОМСпоМеждународнымДоговорам;
						СтрокаНачисленнаяЗарплатаИВзносы.ОМСпоМеждународнымДоговорамСПревышения = Строка.ОМСпоМеждународнымДоговорамСПревышения;
						СтрокаНачисленнаяЗарплатаИВзносы.ОССпоМеждународнымДоговорам = Строка.ОССпоМеждународнымДоговорам;
						СтрокаНачисленнаяЗарплатаИВзносы.ОССпоМеждународнымДоговорамСПревышения = Строка.ОССпоМеждународнымДоговорамСПревышения;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			#Вставка
			// реализовал поиск элемента спр-ка СтруктураПредприятия по Коду БУ
			Если Не ТЗКодыБУ = Неопределено Тогда  
				Отбор = Новый Структура("ИдентификаторСтроки", СтрокаНачисленнаяЗарплатаИВзносыXDTO.ИдентификаторСтроки);
				МассивКодыБУ = ТЗКодыБУ.НайтиСтроки(Отбор);
				Если НЕ МассивКодыБУ = Неопределено И МассивКодыБУ.Количество()> 0  Тогда
					Для Каждого Строка Из МассивКодыБУ Цикл
						СтрокаНачисленнаяЗарплатаИВзносы.ПодразделениеПредприятия = Справочники.СтруктураПредприятия.НайтиПоКоду(Строка.КодБУ);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			#КонецВставки
			ИспользоватьФормат1_15 = (СравнитьВерсии(КомпонентыОбмена.ВерсияФорматаОбмена, "1.15") >= 0);
			Если ИспользоватьФормат1_15 И НачисленнаяЗарплатаИВзносыXDTO.Колонки.Найти("СпособРасчетов") <> Неопределено Тогда
				Если ЗначениеЗаполнено(СтрокаНачисленнаяЗарплатаИВзносыXDTO.СпособРасчетов) Тогда
					ПеречислениеСпособРасчетов = СтрШаблон(НСтр("ru = 'Перечисление.СпособыРасчетовСФизическимиЛицами.%1';
					|en = 'Перечисление.СпособыРасчетовСФизическимиЛицами.%1'"), СтрокаНачисленнаяЗарплатаИВзносыXDTO.СпособРасчетов);
					СпособРасчетов = ПредопределенноеЗначение(ПеречислениеСпособРасчетов);
					СтрокаНачисленнаяЗарплатаИВзносы.СпособРасчетов = СпособРасчетов;
				КонецЕсли;
			КонецЕсли;
			МассивНачисленнаяЗарплатаИВзносы.Добавить(СтрокаНачисленнаяЗарплатаИВзносы);
		КонецЦикла;

		ПолученныеДанные.ДополнительныеСвойства.Вставить("НачисленнаяЗарплатаИВзносы", МассивНачисленнаяЗарплатаИВзносы);
	КонецЕсли;

	// НачисленныйНДФЛ
	НачисленныйНДФЛXDTO = Неопределено;
	Если ДанныеXDTO.Свойство("НачисленныйНДФЛ", НачисленныйНДФЛXDTO)
		И ЗначениеЗаполнено(НачисленныйНДФЛXDTO) Тогда

		МассивНачисленныйНДФЛ = Новый Массив;

		Для Каждого СтрокаНачисленныйНДФЛXDTO Из НачисленныйНДФЛXDTO Цикл
			СтрокаНачисленныйНДФЛ = Новый Структура("ВидОперации, ПодразделениеПредприятия, РегистрацияВНалоговомОргане, Сумма, СпособРасчетов");
			#Вставка
			//// реализовал заполнение ФизЛица в ТЧ НачисленныйНДФЛ
			//Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
			//	СтрокаНачисленныйНДФЛ = Новый Структура("ФизическоеЛицо, ВидОперации, ПодразделениеПредприятия, РегистрацияВНалоговомОргане, Сумма, СпособРасчетов");
			//КонецЕсли; 
			#КонецВставки

			ЗаполнитьЗначенияСвойств(СтрокаНачисленныйНДФЛ, СтрокаНачисленныйНДФЛXDTO);

			СтрокаПодразделениеXDTO = Новый Структура("Подразделение");
			ЗаполнитьЗначенияСвойств(СтрокаПодразделениеXDTO, СтрокаНачисленныйНДФЛXDTO);
			Если ЗначениеЗаполнено(СтрокаПодразделениеXDTO.Подразделение)
				И ТипЗнч(СтрокаПодразделениеXDTO.Подразделение) = Тип("Структура") Тогда
				Если Не СтрокаПодразделениеXDTO.Подразделение.Свойство("Ссылка") Тогда
					СтрокаНачисленныйНДФЛ.ПодразделениеПредприятия = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
				Иначе
					СтрокаНачисленныйНДФЛ.ПодразделениеПредприятия = Новый Структура("Значение, ИмяПКО",
					СтрокаПодразделениеXDTO.Подразделение, "Справочник_Подразделения_Получение");
				КонецЕсли;
			КонецЕсли;

			ВидОперацииМД = ВидыОперацийПоЗарплатеЗначения.Найти(СтрокаНачисленныйНДФЛ.ВидОперации);
			Если Не ВидОперацииМД = Неопределено Тогда
				СтрокаНачисленныйНДФЛ.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.Получить(ВидыОперацийПоЗарплатеЗначения.Индекс(ВидОперацииМД));
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаНачисленныйНДФЛ.СпособРасчетов) Тогда
				СпособРасчетовМД = СпособыРасчетовСФизическимиЛицами.Найти(СтрокаНачисленныйНДФЛ.СпособРасчетов);
				Если Не СпособРасчетовМД = Неопределено Тогда
					СтрокаНачисленныйНДФЛ.СпособРасчетов = 
					Перечисления.СпособыРасчетовСФизическимиЛицами.Получить(СпособыРасчетовСФизическимиЛицами.Индекс(СпособРасчетовМД));
				КонецЕсли;
			КонецЕсли;

			МассивНачисленныйНДФЛ.Добавить(СтрокаНачисленныйНДФЛ);
		КонецЦикла;

		ПолученныеДанные.ДополнительныеСвойства.Вставить("НачисленныйНДФЛ", МассивНачисленныйНДФЛ);
	КонецЕсли;

	// УдержаннаяЗарплата, НачисленныеПроцентыПоЗаймам
	МассивУдержаннаяЗарплата = Новый Массив;
	МассивНачисленныеПроцентыПоЗаймам = Новый Массив;

	УдержаннаяЗарплатаXDTO = Неопределено;
	Если ДанныеXDTO.Свойство("УдержаннаяЗарплата", УдержаннаяЗарплатаXDTO)
		И ЗначениеЗаполнено(УдержаннаяЗарплатаXDTO) Тогда

		#Вставка
		// реализовал поиск элемента спр-ка СтруктураПредприятия по Коду БУ
		ТЗКодыБУ = Неопределено;
		Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
			Если ДанныеXDTO.Свойство("AdditionalInfo") Тогда 
				Если ДанныеXDTO.AdditionalInfo.Свойство("УдержанияКодыБУ") Тогда
					ТЗКодыБУ = ДанныеXDTO.AdditionalInfo.УдержанияКодыБУ;
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;
		НомерСтроки = 0;
		// реализовал заполнение Сотрудника "единым физлицом" из настройки узла плана обмена
		ФизлицоЕдиное = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КомпонентыОбмена.УзелКорреспондента, "Физлицо");
		#КонецВставки
		Для Каждого СтрокаУдержаннаяЗарплатаXDTO Из УдержаннаяЗарплатаXDTO Цикл
			СтрокаУдержаннаяЗарплата = Новый Структура("ВидОперации, Контрагент, ПодразделениеПредприятия, Сумма, ФизическоеЛицо, СпособРасчетов, ОписаниеУдержанияДляЧека, ЯвляетсяОснованиемОформленияКассовогоЧека");

			ЗаполнитьЗначенияСвойств(СтрокаУдержаннаяЗарплата, СтрокаУдержаннаяЗарплатаXDTO);

			СтрокаПодразделениеXDTO = Новый Структура("Подразделение");
			ЗаполнитьЗначенияСвойств(СтрокаПодразделениеXDTO, СтрокаУдержаннаяЗарплатаXDTO);
			Если ЗначениеЗаполнено(СтрокаПодразделениеXDTO.Подразделение)
				И ТипЗнч(СтрокаПодразделениеXDTO.Подразделение) = Тип("Структура") Тогда
				Если Не СтрокаПодразделениеXDTO.Подразделение.Свойство("Ссылка") Тогда
					СтрокаУдержаннаяЗарплата.ПодразделениеПредприятия = ЭлементПоУмолчанию(КомпонентыОбмена, "Подразделение");
				Иначе
					СтрокаУдержаннаяЗарплата.ПодразделениеПредприятия = Новый Структура("Значение, ИмяПКО",
					СтрокаПодразделениеXDTO.Подразделение, "Справочник_Подразделения_Получение");
				КонецЕсли;
			КонецЕсли;
			#Вставка
			// реализовал поиск элемента спр-ка СтруктураПредприятия по Коду БУ
			НомерСтроки = НомерСтроки + 1;
			Если Не ТЗКодыБУ = Неопределено Тогда  
				Отбор = Новый Структура("НомерСтроки", НомерСтроки);
				МассивКодыБУ = ТЗКодыБУ.НайтиСтроки(Отбор);
				Если НЕ МассивКодыБУ = Неопределено И МассивКодыБУ.Количество()> 0  Тогда
					Для Каждого Строка Из МассивКодыБУ Цикл
						СтрокаУдержаннаяЗарплата.ПодразделениеПредприятия = Справочники.СтруктураПредприятия.НайтиПоКоду(Строка.КодБУ);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			// реализовал заполнение Сотрудника "единым физлицом" из настройки узла плана обмена
			Если ЗначениеЗаполнено(ФизлицоЕдиное) Тогда
				СтрокаУдержаннаяЗарплата.ФизическоеЛицо = ФизлицоЕдиное;
			КонецЕсли;
			#КонецВставки

			ВидОперацииМД = ВидыОперацийПоЗарплатеЗначения.Найти(СтрокаУдержаннаяЗарплата.ВидОперации);
			Если Не ВидОперацииМД = Неопределено Тогда
				СтрокаУдержаннаяЗарплата.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.Получить(ВидыОперацийПоЗарплатеЗначения.Индекс(ВидОперацииМД));
			КонецЕсли;

			Если ЗначениеЗаполнено(СтрокаУдержаннаяЗарплата.СпособРасчетов) Тогда
				СпособРасчетовМД = СпособыРасчетовСФизическимиЛицами.Найти(СтрокаУдержаннаяЗарплата.СпособРасчетов);
				Если Не СпособРасчетовМД = Неопределено Тогда
					СтрокаУдержаннаяЗарплата.СпособРасчетов = 
					Перечисления.СпособыРасчетовСФизическимиЛицами.Получить(СпособыРасчетовСФизическимиЛицами.Индекс(СпособРасчетовМД));
				КонецЕсли;
			КонецЕсли;

			Если СтрокаУдержаннаяЗарплата.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.НачисленоПроцентовПоЗайму Тогда
				МассивНачисленныеПроцентыПоЗаймам.Добавить(СтрокаУдержаннаяЗарплата);
			Иначе
				МассивУдержаннаяЗарплата.Добавить(СтрокаУдержаннаяЗарплата);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если МассивУдержаннаяЗарплата.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("УдержаннаяЗарплата", МассивУдержаннаяЗарплата);
	КонецЕсли;

	Если МассивНачисленныеПроцентыПоЗаймам.Количество() > 0 Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НачисленныеПроцентыПоЗаймам", МассивНачисленныеПроцентыПоЗаймам);
	КонецЕсли;
	#Вставка
	ПолученныеДанные.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КомпонентыОбмена.УзелКорреспондента, "Организация");
	#КонецВставки
КонецПроцедуры

&После("ДобавитьПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение")
Процедура юум_ДобавитьПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение(ПравилаКонвертации)
	//ПКО = ПравилаКонвертации.Найти("Документ_ОтражениеЗарплатыВФинУчете_Получение");
	//СвойстваТЧ = ПКО.СвойстваТабличныхЧастей.Найти("НачисленныйНДФЛ");
	//ДобавитьПКС(СвойстваТЧ.Свойства, "ФизическоеЛицо", "", 1, "Справочник_ФизическиеЛица_Получение");
КонецПроцедуры

&ИзменениеИКонтроль("ПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение_ПередЗаписьюПолученныхДанных")
Процедура юум_ПКО_Документ_ОтражениеЗарплатыВФинУчете_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ЕстьИсправлениеИлиСторно(ДанныеИБ, ПолученныеДанные, КомпонентыОбмена) Тогда
		Возврат;
	КонецЕсли;

	ТекущийДокумент = ?(ДанныеИБ = Неопределено, ПолученныеДанные.Ссылка, ДанныеИБ.Ссылка);
	ДатаАктуальности = ПолученныеДанные.Дата;

	//Сворачиваем ТЧ НачисленнаяЗарплатаИВзносы и НачисленныйНДФЛ   
	КолонкиГруппировок = "Организация, ПодразделениеПредприятия, ВидОперации, СпособОтраженияЗарплатыВБухучете,
	| ОблагаетсяЕНВД, ВидНачисленияОплатыТрудаДляНУ, СпособРасчетов, НеОблагаетсяНДФЛ, Резерв, РезервБУ, РезервНУ, СпособРасчетов";
	КолонкиСуммирования = "Сумма, ВзносыПоЕдиномуТарифу, ВзносыВсего, ПФРСтраховая, ПФРНакопительная, ПФРПоСуммарномуТарифу, ПФРНаДоплатуЛетчикам,   
	| ПФРНаДоплатуШахтерам, ПФРЗаЗанятыхНаПодземныхИВредныхРаботах, ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах, ФСС, ФФОМС, ТФОМС,
	| ФССНесчастныеСлучаи, ПФРДоПредельнойВеличины, ПФРСПревышения, ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки,
	| ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка, ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки, ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка,
	| ОПСпоМеждународнымДоговорам,ОПСпоМеждународнымДоговорамСПревышения,ОМСпоМеждународнымДоговорам,ОМСпоМеждународнымДоговорамСПревышения,ОССпоМеждународнымДоговорам,
	| ОССпоМеждународнымДоговорамСПревышения";

	ПолученныеДанные.НачисленнаяЗарплатаИВзносы.Свернуть(КолонкиГруппировок, КолонкиСуммирования);

	КолонкиГруппировок = "Организация, ПодразделениеПредприятия, ВидОперации, СтавкаНДФЛ, НДФЛСДивидендов,
	| РегистрацияВНалоговомОргане, ТипНалога, СпособРасчетов";
	#Вставка
	//// реализовал заполнение ФизЛица в ТЧ НачисленныйНДФЛ
	//Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
	//	КолонкиГруппировок = "ФизическоеЛицо,Организация, ПодразделениеПредприятия, ВидОперации, СтавкаНДФЛ, НДФЛСДивидендов,
	//	| РегистрацияВНалоговомОргане, ТипНалога, СпособРасчетов";
	//КонецЕсли; 
	#КонецВставки
	КолонкиСуммирования = "Сумма";
	ПолученныеДанные.НачисленныйНДФЛ.Свернуть(КолонкиГруппировок, КолонкиСуммирования);

	Для Каждого СтрокаУдержаннаяЗарплата Из ПолученныеДанные.УдержаннаяЗарплата Цикл
		СтатьяРасходовАналитика = Документы.ОтражениеЗарплатыВФинансовомУчете.СтатьяАктивовПассивовПоУмолчанию(
		СтрокаУдержаннаяЗарплата.ФизическоеЛицо,
		СтрокаУдержаннаяЗарплата.ПодразделениеПредприятия, 
		СтрокаУдержаннаяЗарплата.ВидОперации, 
		СтрокаУдержаннаяЗарплата.Контрагент, 
		ТекущийДокумент, 
		ДатаАктуальности);

		ЗаполнитьЗначенияСвойств(СтрокаУдержаннаяЗарплата, СтатьяРасходовАналитика, "СтатьяАктивовПассивов, АналитикаАктивовПассивов");

		НоваяНастройка = НастройкаСчетовУчетаКлиентСервер.СоставНастройкиСчетовУчета();
		ЗаполнитьЗначенияСвойств(НоваяНастройка, СтатьяРасходовАналитика, "СчетУчета, Субконто1, Субконто2, Субконто3");
		СтрокаУдержаннаяЗарплата.НастройкаСчетовУчета = НастройкаСчетовУчетаСервер.НоваяНастройкаСчетовУчета(НоваяНастройка);
		#Вставка
		// реализовал заполнение СтатьяАктивовПассивов в ТЧ УдержаннаяЗарплата
		Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
			СтрокаУдержаннаяЗарплата.СтатьяАктивовПассивов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КомпонентыОбмена.УзелКорреспондента, "СтатьяАктивовПассивов");
		КонецЕсли; 
		#КонецВставки
	КонецЦикла;

	Для Каждого СтрокаНачисленныеПроцентыПоЗаймам Из ПолученныеДанные.НачисленныеПроцентыПоЗаймам Цикл
		СтатьяДоходовАналитика = ОтражениеЗарплатыВФУ_СтатьяДоходовПоУмолчанию(
		СтрокаНачисленныеПроцентыПоЗаймам.ФизическоеЛицо,
		СтрокаНачисленныеПроцентыПоЗаймам.ПодразделениеПредприятия,		
		ТекущийДокумент,
		ДатаАктуальности);

		ЗаполнитьЗначенияСвойств(СтрокаНачисленныеПроцентыПоЗаймам, СтатьяДоходовАналитика);
	КонецЦикла;

	Если Не ДанныеИБ = Неопределено Тогда
		// Способ отражения ЗП в БУ
		ЗаполнитьСвойстваТабличнойЧастиОбъекта(
		ПолученныеДанные.НачисленнаяЗарплатаИВзносы,
		ДанныеИБ.НачисленнаяЗарплатаИВзносы,
		"ВидНачисленияОплатыТрудаДляНУ, ВидОперации, ОблагаетсяЕНВД, ПодразделениеПредприятия, Сумма, ВзносыВсего, ВзносыПоЕдиномуТарифу,
		|ОПСпоМеждународнымДоговорам,ОПСпоМеждународнымДоговорамСПревышения,ОМСпоМеждународнымДоговорам,ОМСпоМеждународнымДоговорамСПревышения,ОССпоМеждународнымДоговорам,ОССпоМеждународнымДоговорамСПревышения", 
		"СпособОтраженияЗарплатыВБухучете");	

		// Статья/Аналитика в ТЧ "Удержания"
		ЗаполнитьСвойстваТабличнойЧастиОбъекта(
		ПолученныеДанные.УдержаннаяЗарплата,
		ДанныеИБ.УдержаннаяЗарплата,
		"ФизическоеЛицо, ПодразделениеПредприятия, ВидОперации, Контрагент, Сумма",
		"СтатьяАктивовПассивов, АналитикаАктивовПассивов, НастройкаСчетовУчета");

		// Статья/Аналитика в ТЧ "Проценты по займам"	
		ЗаполнитьСвойстваТабличнойЧастиОбъекта(
		ПолученныеДанные.НачисленныеПроцентыПоЗаймам,
		ДанныеИБ.НачисленныеПроцентыПоЗаймам,
		"ФизическоеЛицо, ПодразделениеПредприятия, Сумма",
		"СтатьяДоходов, АналитикаДоходов");
	КонецЕсли;
КонецПроцедуры


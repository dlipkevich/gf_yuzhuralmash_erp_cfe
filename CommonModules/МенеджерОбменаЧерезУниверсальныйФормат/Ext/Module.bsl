
#Область СлужебныйПрограммныйИнтерфейс

&Вместо("ПередКонвертацией")
Процедура юум_ПередКонвертацией(КомпонентыОбмена)
	Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
		СотрудникиДляОтложеннойОбработки = Новый Массив;
		КомпонентыОбмена.ПараметрыКонвертации.СотрудникиДляОтложеннойОбработки = СотрудникиДляОтложеннойОбработки;
		Возврат;
	КонецЕсли;
	ПродолжитьВызов(КомпонентыОбмена);
КонецПроцедуры

&Вместо("ПослеКонвертации")
Процедура юум_ПослеКонвертации(КомпонентыОбмена)
	Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
		Если КомпонентыОбмена.НаправлениеОбмена = "Получение" Тогда
			// здесь КомпонентыОбмена.НаправлениеОбмена = "Получение"
			Для Каждого Загруженный Из КомпонентыОбмена.ЗагруженныеОбъекты Цикл
				Если ТипЗнч(Загруженный.Объект) <> Тип("ДокументОбъект.ОтражениеЗарплатыВФинансовомУчете") Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(Загруженный.СсылкаНаОбъект)
					И ЭтотДокументУжеВРеестре(Загруженный.СсылкаНаОбъект) Тогда
					Продолжить;
				КонецЕсли;
				// записываем документ в Реестр документов
				ДокОбъект = Загруженный.СсылкаНаОбъект.ПолучитьОбъект();
				ДокОбъект.Записать();
			КонецЦикла;
			
			ОбъектыДляОтложеннойЗаписи = Неопределено;
			КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.Свойство("ОбъектыДляОтложеннойЗаписи", ОбъектыДляОтложеннойЗаписи);
			Если ТипЗнч(ОбъектыДляОтложеннойЗаписи) = Тип("ТаблицаЗначений") Тогда
				Для Каждого СтрокаТЗ Из ОбъектыДляОтложеннойЗаписи Цикл
					ПометкаУдаленияБыло = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЗ.Ссылка, "ПометкаУдаления");
					Если ПометкаУдаленияБыло <> СтрокаТЗ.ПометкаУдаления Тогда
						СпрОбъект = СтрокаТЗ.Ссылка.ПолучитьОбъект();
						Попытка
							СпрОбъект.УстановитьПометкуУдаления(СтрокаТЗ.ПометкаУдаления);
						Исключение
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
				КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.ОбъектыДляОтложеннойЗаписи = Неопределено;
			КонецЕсли;
			
			Для Каждого ОбъектСоответствия Из КомпонентыОбмена.ОбъектыДляОтложеннойЗаписи Цикл
				Если ТипЗнч(ОбъектСоответствия.Ключ) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
					ДанныеФИО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСоответствия.Ключ, "Фамилия, Имя, Отчество");
					ДанныеФИО.Вставить("Период", Неопределено);
				    //
					// здесь Физлицо "загружается" вместе с СостояниемСотрудника
					//
					Если ТребуетсяЗаписьФИО(ОбъектСоответствия.Ключ, ДанныеФИО) Тогда
						РегистрыСведений.ФИОФизическихЛиц.ДобавитьФИОФизическогоЛица(ОбъектСоответствия.Ключ, ДанныеФИО, НачалоДня(ТекущаяДата()));
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			РеквизитыФизическихЛиц = Неопределено;
			КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.Свойство("РеквизитыФизическихЛиц", РеквизитыФизическихЛиц);
			Если ТипЗнч(РеквизитыФизическихЛиц) = Тип("ТаблицаЗначений") Тогда
				//
				// здесь Физлицо "загружается" вместе с Сотрудником
				//
				Для Каждого СтрокаТЗ Из РеквизитыФизическихЛиц Цикл
					
					ДанныеФИО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЗ.Физлицо, "Фамилия, Имя, Отчество");
					ДанныеФИО.Вставить("Период", Неопределено);
					
					ДанныеФизлица = СтрокаТЗ.РеквизитыФизлица;
					Если ТипЗнч(ДанныеФизлица) = Тип("Структура") Тогда
						Если ДанныеФизлица.Фамилия <> ДанныеФИО.Фамилия
							ИЛИ ДанныеФизлица.Имя <> ДанныеФИО.Имя
							ИЛИ ДанныеФизлица.Отчество <> ДанныеФИО.Отчество Тогда
							ДанныеФИО.Фамилия = ДанныеФизлица.Фамилия;
							ДанныеФИО.Имя = ДанныеФизлица.Имя;
							ДанныеФИО.Отчество = ДанныеФизлица.Отчество;
							РегистрыСведений.ФИОФизическихЛиц.ДобавитьФИОФизическогоЛица(СтрокаТЗ.Физлицо, ДанныеФИО, НачалоДня(ТекущаяДата()));
						КонецЕсли;
						
						РеквизитыФизлица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЗ.Физлицо, "НаименованиеСлужебное, ФИО, Код, Инициалы");
						Если ДанныеФизлица.ФИО <> РеквизитыФизлица.ФИО
							ИЛИ ДанныеФизлица.НаименованиеСлужебное <> РеквизитыФизлица.НаименованиеСлужебное
							ИЛИ ДанныеФизлица.Код <> РеквизитыФизлица.Код
							ИЛИ ДанныеФизлица.Инициалы <> РеквизитыФизлица.Инициалы Тогда
							ФизлицоОбъект = СтрокаТЗ.Физлицо.ПолучитьОбъект();
							ЗаполнитьЗначенияСвойств(ФизлицоОбъект, ДанныеФизлица);
							ФизлицоОбъект.Наименование = ДанныеФизлица.ФИО;
							Попытка
								ФизлицоОбъект.Записать();
							Исключение
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;

			РасценкиРаботСотрудников = Неопределено;
			КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.Свойство("РасценкиРаботСотрудников", РасценкиРаботСотрудников);
			Если ТипЗнч(РасценкиРаботСотрудников) = Тип("Массив") Тогда
				Для Каждого ОписаниеРасценки Из РасценкиРаботСотрудников Цикл
					// сначала надо удалить все "старые" записи
					ИдентификаторЗУП = ОписаниеРасценки.ИдентификаторЗУП;
					УдалитьРасценкиРаботСотрудников(ИдентификаторЗУП);
	
					// затем создать "новые"
					Если ОписаниеРасценки.Свойство("Записи") Тогда
						Для Каждого Запись Из ОписаниеРасценки.Записи Цикл
		
							XDTOРазрядКатегория = Запись.РазрядКатегория;
							ИмяПКОРазрядКатегория = "Справочник_РазрядыКатегорииДолжностей_Получение";
							ПКОСсылки = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, ИмяПКОРазрядКатегория);
		
							РазрядКатегория = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
								КомпонентыОбмена,
								XDTOРазрядКатегория,
								ПКОСсылки,
								"ПолучитьСсылку").Ссылка;
		
								Период = Запись.Период;
								Расценка = Запись.Тариф;
		
								ЗаписатьРасценкиРаботСотрудников(Новый Структура("Период, РазрядКатегория, Расценка, ИдентификаторЗУП",
																	Период, РазрядКатегория, Расценка, ИдентификаторЗУП));
	
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
			
			Возврат;
		Иначе
			// здесь КомпонентыОбмена.НаправлениеОбмена = "Отправка"
			Возврат;
		КонецЕсли;
	КонецЕсли;
	ПродолжитьВызов(КомпонентыОбмена);
КонецПроцедуры

&Вместо("ПередОтложеннымЗаполнением")
Процедура юум_ПередОтложеннымЗаполнением(КомпонентыОбмена)
	Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
		Возврат;
	КонецЕсли;
	ПродолжитьВызов(КомпонентыОбмена);
КонецПроцедуры

Функция ЭтотДокументУжеВРеестре(Ссылка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеестрДокументов.ТипСсылки КАК ТипСсылки,
	               |	РеестрДокументов.Ссылка КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.РеестрДокументов КАК РеестрДокументов
	               |ГДЕ
	               |	РеестрДокументов.Ссылка = &Ссылка";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции
#КонецОбласти

#Область ПравилаОбработкиДанных

&После("ЗаполнитьПравилаОбработкиДанных")
Процедура юум_ЗаполнитьПравилаОбработкиДанных(НаправлениеОбмена, ПравилаОбработкиДанных)
	Если Метаданные.Имя = "УправлениеПредприятием" Тогда
		Если НаправлениеОбмена = "Отправка" Тогда
			ДобавитьПОД_Справочник_умЗаказы_Отправка(ПравилаОбработкиДанных);
			ДобавитьПОД_Документ_умИсходныеДанныеСделок_Отправка(ПравилаОбработкиДанных);
		ИначеЕсли НаправлениеОбмена = "Получение" Тогда
			ДобавитьПОД_Справочник_умБригады_Получение(ПравилаОбработкиДанных);
			ДобавитьПОД_Справочник_юумФизическиеЛица_Получение(ПравилаОбработкиДанных);
			ДобавитьПОД_Регистр_юумКоличествоВРЦ_Получение(ПравилаОбработкиДанных);
			ДобавитьПОД_Регистр_РасценкиРаботСотрудников_Получение(ПравилаОбработкиДанных);
			ДобавитьПОД_Справочник_РазрядыКатегорииДолжностей_Получение(ПравилаОбработкиДанных);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьПОД_Справочник_умЗаказы_Отправка(ПравилаОбработкиДанных)
	ПравилоОбработки                         = ПравилаОбработкиДанных.Добавить();
	ПравилоОбработки.Имя                     = "Справочник_умЗаказы_Отправка";
	ПравилоОбработки.ОбъектВыборкиМетаданные = Метаданные.Документы.ЗаказНаПроизводство2_2;
	ПравилоОбработки.ПриОбработке            = "ПОД_Справочник_умЗаказы_Отправка_ПриОбработке";
	ПравилоОбработки.ОчисткаДанных           = Ложь;
	ПравилоОбработки.ИспользуемыеПКО.Добавить("Справочник_умЗаказы_Отправка");
КонецПроцедуры


			//ПолученныеДанные.ВведенаВШтатноеРасписание = ДопДанные["ВведенаВШтатноеРасписание"];
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ВведенаВШтатноеРасписание", ДопДанные["ВведенаВШтатноеРасписание"]);
		КонецЕсли;
		
        Если ДопДанные.Свойство("ДатаВвода") Тогда
			//ПолученныеДанные.ДатаВвода = ДопДанные["ДатаВвода"];
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ДатаВвода", ДопДанные["ДатаВвода"]);
		КонецЕсли;
		
        Если ДопДанные.Свойство("ИсключенаИзШтатногоРасписания") Тогда
			//ПолученныеДанные.ДатаВвода = ДопДанные["ДатаВвода"];
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ИсключенаИзШтатногоРасписания", ДопДанные["ИсключенаИзШтатногоРасписания"]);
		КонецЕсли;
		
   		Если ДопДанные.Свойство("ДатаИсключения") Тогда

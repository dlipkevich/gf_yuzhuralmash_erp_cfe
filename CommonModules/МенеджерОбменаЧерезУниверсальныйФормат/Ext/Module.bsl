Процедура ДобавитьОбъектыДляОтложеннойЗаписи(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	ОписаниеРасценок = Новый Структура;
	ОписаниеРасценок.Вставить("ИдентификаторЗУП", ДанныеXDTO.КлючевыеСвойства.Ссылка.Значение);
	
	Если ДанныеXDTO.Свойство("Записи") Тогда
		ОписаниеРасценок.Вставить("Записи", ДанныеXDTO.Записи);
	КонецЕсли;

	РасценкиРаботСотрудников = Неопределено;
	КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.Свойство("РасценкиРаботСотрудников", РасценкиРаботСотрудников);
	Если РасценкиРаботСотрудников = Неопределено Тогда
		РасценкиРаботСотрудников = Новый Массив;
	КонецЕсли;
	
	РасценкиРаботСотрудников.Добавить(ОписаниеРасценок);
	КомпонентыОбмена.УзелКорреспондентаОбъект.ДополнительныеСвойства.Вставить("РасценкиРаботСотрудников", РасценкиРаботСотрудников);
	
КонецПроцедуры

Процедура УдалитьРасценкиРаботСотрудников(ИдентификаторЗУП)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("юум_ИдентификаторЗУП", ИдентификаторЗУП);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РасценкиРаботСотрудников.Период КАК Период,
	               |	РасценкиРаботСотрудников.ВидРабот КАК ВидРабот
	               |ИЗ
	               |	РегистрСведений.РасценкиРаботСотрудников КАК РасценкиРаботСотрудников
	               |ГДЕ
	               |	РасценкиРаботСотрудников.юум_ИдентификаторЗУП = &юум_ИдентификаторЗУП";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.РасценкиРаботСотрудников.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидРабот.Установить(Выборка.ВидРабот);
		НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
		НаборЗаписей.Записать();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРасценкиРаботСотрудников(СтрРасценки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КвалификационныйРазряд", СтрРасценки.РазрядКатегория);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВидыРаботСотрудников.Ссылка КАК ВидРабот
	               |ИЗ
	               |	Справочник.ВидыРаботСотрудников КАК ВидыРаботСотрудников
	               |ГДЕ
	               |	НЕ ВидыРаботСотрудников.ПометкаУдаления
	               |	И ВидыРаботСотрудников.КвалификационныйРазряд = &КвалификационныйРазряд";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыСведений.РасценкиРаботСотрудников.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидРабот.Установить(Выборка.ВидРабот);
		НаборЗаписей.Отбор.Период.Установить(СтрРасценки.Период);
		
		Запись = НаборЗаписей.Добавить();
		Запись.ВидРабот = Выборка.ВидРабот;
		Запись.Период = СтрРасценки.Период;
		Запись.Расценка = СтрРасценки.Расценка;
		Запись.юум_ИдентификаторЗУП = СтрРасценки.ИдентификаторЗУП;
		
		НаборЗаписей.Записать();
	КонецЦикла;

КонецПроцедуры


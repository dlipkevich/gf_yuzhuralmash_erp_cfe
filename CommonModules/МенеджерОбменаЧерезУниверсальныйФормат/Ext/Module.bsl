&ИзменениеИКонтроль("ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных")
Процедура юум_ПКО_Справочник_ФизическиеЛица_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	#Вставка
	Если ТипЗнч(КомпонентыОбмена.УзелКорреспондента) = Тип("ПланОбменаСсылка.юум_ИнтеграцияЗУП_ЕРП_УниверсальныйФормат") Тогда
		// запрещаем запись Физлиц при обмене с ЗУП если СтраховойНомерПФР ПУСТОЙ
		Если Не ЗначениеЗаполнено(ПолученныеДанные.СтраховойНомерПФР) Тогда
			ПолученныеДанные = Неопределено;
			Возврат;
		КонецЕсли;
	КонецЕсли;
	#КонецВставки
	//++ НЕ УТ
	ПолученныеДанные.ФИО = ПолученныеДанные.Наименование;
	Если ДанныеИБ <> Неопределено Тогда
		// Явно перезаполняются свойства, которых нет в ПКС (т.к. эти свойства отсутствуют в УТ).
		СтрокаРеквизиты = "МестоРождения, УточнениеНаименования, ФИО, ДатаРегистрации";
		//++ Локализация
		СтрокаРеквизиты = СтрокаРеквизиты + ", СтраховойНомерПФР";
		//-- Локализация
		ЗаполнитьРеквизиты(ДанныеИБ, ПолученныеДанные, СтрокаРеквизиты, Истина);
	КонецЕсли;
	//-- НЕ УТ
	ФизЛицоСсылка = ?(ДанныеИБ = Неопределено, ПолученныеДанные.ПолучитьСсылкуНового(), ДанныеИБ.Ссылка);
	ЗагрузитьДополнительныеСведения(ФизЛицоСсылка, ПолученныеДанные.ДополнительныеСвойства, КомпонентыОбмена);
	Если ЗначениеЗаполнено(ФизЛицоСсылка) И НЕ ФизЛицоСсылка.ЭтоГруппа Тогда
		ЗагрузитьПодробныеДанныеФИО(КомпонентыОбмена, ПолученныеДанные, ФизЛицоСсылка);
	ИначеЕсли ЗначениеЗаполнено(ФизЛицоСсылка) И ФизЛицоСсылка.ЭтоГруппа Тогда
		ПолученныеДанные = Неопределено;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
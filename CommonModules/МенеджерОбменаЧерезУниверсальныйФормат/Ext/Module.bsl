Процедура ПКО_Регистр_юумКоличествоВРЦ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	
	Период = ДанныеXDTO.КлючевыеСвойства.Период;
	
	КодБУ = ДанныеXDTO.КлючевыеСвойства.КодБУ;
	
	XDTOДолжности   = ДанныеXDTO.КлючевыеСвойства.Должность;
	ИмяПКОДолжности = "Справочник_Должности_Получение";
	ПКОСсылки       = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, ИмяПКОДолжности);
	
	Должность = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(
		КомпонентыОбмена,
		XDTOДолжности,
		ПКОСсылки,
		"ПолучитьСсылку").Ссылка;
		
	ПолученныеДанные.Отбор.Период.Значение = Период;
	ПолученныеДанные.Отбор.Период.Использование = Истина;
	
	ПолученныеДанные.Отбор.КодБУ.Значение = КодБУ;
	ПолученныеДанные.Отбор.КодБУ.Использование = Истина;
	
	ПолученныеДанные.Отбор.Должность.Значение = Должность;
	ПолученныеДанные.Отбор.Должность.Использование = Истина;
	
	ПолученныеДанные.Прочитать();
	
	Если ПолученныеДанные.Количество() > 0 Тогда
		СтрокаЗаписи = ПолученныеДанные[0];
	Иначе
		СтрокаЗаписи = ПолученныеДанные.Добавить();
	КонецЕсли;
	
	СтрокаЗаписи.Период = Период;
	СтрокаЗаписи.КодБУ = КодБУ;
	СтрокаЗаписи.Должность = Должность;
	СтрокаЗаписи.Количество = ДанныеXDTO.Количество;
	СтрокаЗаписи.Подразделение = Справочники.СтруктураПредприятия.НайтиПоКоду(КодБУ);
	Если ЗначениеЗаполнено(КодБУ) Тогда
		СтрокаЗаписи.Подразделение = Справочники.СтруктураПредприятия.НайтиПоКоду(КодБУ);
	Иначе
		СтрокаЗаписи.Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры


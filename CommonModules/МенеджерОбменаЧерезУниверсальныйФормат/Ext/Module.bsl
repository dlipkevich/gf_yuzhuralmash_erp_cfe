			ПолученныеДанные.ДополнительныеСвойства.Вставить("ДатаИсключения", ДопДанные["ДатаИсключения"]);
		КонецЕсли;
		
   		Если ДопДанные.Свойство("ПометкаУдаления") Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("ПометкаУдаления", ДопДанные["ПометкаУдаления"]);

#Область ПрограммныйИнтерфейс

// Изолированная проверка контекста заимствованного калькулятора.
// Не читает заказы, не рассчитывает график и не записывает данные.
// Возвращаемое значение:
// Структура - штатные параметры расчета графика без дополнительных настроек.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ПроверитьДоступККалькулятору() Экспорт
	Возврат НовыйПараметрыРасчета();
КонецФункции // } #юум

// Рассчитывает график с объемами формы без записи заказов, графика и заданий.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - доступный пользователю заказ.
//  ОбъемыФормы - ТаблицаЗначений - уникальные строки заказа, партии и ключа
//   номенклатуры; Требуется - весь запланированный остаток, Выбрано - новый
//   остаток с сохранением объема вне отборов формы. Запущенное не изменяется.
// Возвращаемое значение:
//  Структура - ГрафикЗапланирован, Ошибки, Оповещения, КоличествоЭтапов,
//   ДанныеРасчета - штатная модель с рассчитанной таблицей ЗагрузкаВРЦ.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьВПамяти(Знач Заказ, Знач ОбъемыФормы) Экспорт
    Если Метаданные.Версия <> "2.6.2.59" Тогда
        ВызватьИсключение "Расчет ВРЦ формы требует проверки совместимости с текущей версией ERP.";
    КонецЕсли;
    юум_ФП_ПроверитьОбъемы(Заказ, ОбъемыФормы);
    НастройкиПредварительногоПросмотра = Новый Структура;
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_ОбъемыФормы", ОбъемыФормы);
    Возврат юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Заказ, НастройкиПредварительногоПросмотра);
КонецФункции // } #юум

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Рассчитывает заказ с учетом уже рассчитанных более приоритетных заказов.
// Параметры:
//  Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - текущий доступный заказ.
//  ОбъемыФормы - ТаблицаЗначений - остатки по ключам партии и номенклатуры.
//  КонтекстОчереди - Структура - Заказы: Массив ранее рассчитанных заказов;
//   Загрузка: ТаблицаЗначений с ВРЦ, датой, распоряжением, этапом и Занято.
// Возвращаемое значение:
//  Структура - график и диагностика без записи данных.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьПоОчереди(Знач Заказ, Знач ОбъемыФормы, Знач КонтекстОчереди) Экспорт
    Если Метаданные.Версия <> "2.6.2.59" Тогда
        ВызватьИсключение "Расчет ВРЦ формы требует проверки совместимости с текущей версией ERP.";
    КонецЕсли;
    юум_ФП_ПроверитьОбъемы(Заказ, ОбъемыФормы);
    НастройкиПредварительногоПросмотра = Новый Структура;
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_ОбъемыФормы", ОбъемыФормы);
    НастройкиПредварительногоПросмотра.Вставить("юум_ФП_КонтекстОчереди", КонтекстОчереди);
    Возврат юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Заказ, НастройкиПредварительногоПросмотра);
КонецФункции // } #юум

// Возвращает доступные заказы в том же порядке, что штатный график.
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказНаПроизводство2_2 - заказы формы.
// Возвращаемое значение:
//  Массив - приоритет, подразделение, очередь.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ПорядокЗаказов(Знач Заказы) Экспорт
    ТекстПорядка = ТекстЗапросаДанныеЗаказа("&ТекстИмяТаблицы.Ссылка В (&Заказы)", Истина);
    ТекстПорядка = СтрЗаменить(ТекстПорядка, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
    ЗапросПорядка = Новый Запрос(ТекстПорядка);
    ЗапросПорядка.УстановитьПараметр("Заказы", Заказы);
    Возврат ЗапросПорядка.Выполнить().Выгрузить().ВыгрузитьКолонку("ЗаказНаПроизводство");
КонецФункции // } #юум

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&ИзменениеИКонтроль("ЗаписатьЗагрузкуВРЦ")
Процедура юум_ЗаписатьЗагрузкуВРЦ(ДанныеРасчета, ПараметрыРасчета, ОтборПоЭтапам)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЗагрузкаВРЦ = ДанныеРасчета.ЗагрузкаВРЦ;
	ЭтапыСРучнымРазмещением = ДанныеРасчета.ЭтапыСРучнымРазмещением;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(Загрузка.ДатаИнтервала, ДЕНЬ) КАК Период,
		|	Загрузка.ВидРабочегоЦентра                  КАК ВидРабочегоЦентра,
		|	Загрузка.ДатаИнтервала                      КАК ДатаИнтервала,
		|	Загрузка.Занято                             КАК Занято,
		|	Загрузка.Распоряжение                       КАК Распоряжение,
		|	Загрузка.Подразделение                      КАК Подразделение,
		|	Загрузка.Смена                              КАК Смена,
		|	Загрузка.КлючПартия                         КАК КлючПартия,
		|	Загрузка.Этап                               КАК Этап
		|ПОМЕСТИТЬ ВТНовыйГрафик
		|ИЗ
		|	&ЗагрузкаВРЦ КАК Загрузка
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Регистратор.Дата             КАК Период,
		|	МАКСИМУМ(Регистратор.Ссылка) КАК Ссылка
		|ПОМЕСТИТЬ ВТРегистраторы
		|ИЗ
		|	Документ.РегистраторГрафикаПроизводства КАК Регистратор
		|ГДЕ
		|	Регистратор.Проведен
		|	И Регистратор.Дата В (
		|		ВЫБРАТЬ РАЗЛИЧНЫЕ
		|			Т.Период КАК Дата
		|		ИЗ
		|			ВТНовыйГрафик КАК Т)
		|
		|СГРУППИРОВАТЬ ПО
		|	Регистратор.Дата
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Период
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.Регистратор       КАК Регистратор,
		|	ВложенныйЗапрос.Период            КАК Период,
		|	ВложенныйЗапрос.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|	ВложенныйЗапрос.ДатаИнтервала     КАК ДатаИнтервала,
		|	СУММА(ВложенныйЗапрос.Занято)     КАК Занято,
		|	ВложенныйЗапрос.Распоряжение      КАК Распоряжение,
		|	ВложенныйЗапрос.Подразделение     КАК Подразделение,
		|	ВложенныйЗапрос.Смена             КАК Смена,
		|	ВложенныйЗапрос.КлючПартия        КАК КлючПартия,
		|	ВложенныйЗапрос.Этап              КАК Этап
		|ИЗ
		|	(
		|		ВЫБРАТЬ
		|			ВЫБОР
		|				КОГДА НовыйГрафик.Этап ССЫЛКА Документ.ЭтапПроизводства2_2
		|					ТОГДА НовыйГрафик.Этап
		|				ИНАЧЕ ЕСТЬNULL(Регистраторы.Ссылка, ЗНАЧЕНИЕ(Документ.РегистраторГрафикаПроизводства.ПустаяСсылка))
		|			КОНЕЦ                         КАК Регистратор,
		|			НовыйГрафик.Период            КАК Период,
		|			НовыйГрафик.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|			НовыйГрафик.ДатаИнтервала     КАК ДатаИнтервала,
		|			НовыйГрафик.Занято            КАК Занято,
		|			НовыйГрафик.Распоряжение      КАК Распоряжение,
		|			НовыйГрафик.Подразделение     КАК Подразделение,
		|			НовыйГрафик.Смена             КАК Смена,
		|			НовыйГрафик.КлючПартия        КАК КлючПартия,
		|			НовыйГрафик.Этап              КАК Этап
		|		ИЗ
		|			ВТНовыйГрафик КАК НовыйГрафик
		|			
		|			ЛЕВОЕ СОЕДИНЕНИЕ ВТРегистраторы КАК Регистраторы
		|			ПО НовыйГрафик.Этап ССЫЛКА Справочник.ЭтапыПроизводства
		|				И НовыйГрафик.Период = Регистраторы.Период
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			СтарыйГрафик.Регистратор       КАК Регистратор,
		|			СтарыйГрафик.Период            КАК Период,
		|			СтарыйГрафик.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
		|			СтарыйГрафик.ДатаИнтервала     КАК ДатаИнтервала,
		|			-СтарыйГрафик.Занято           КАК Занято,
		|			СтарыйГрафик.Распоряжение      КАК Распоряжение,
		|			СтарыйГрафик.Подразделение     КАК Подразделение,
		|			СтарыйГрафик.Смена             КАК Смена,
		|			СтарыйГрафик.КлючПартия        КАК КлючПартия,
		|			СтарыйГрафик.Этап              КАК Этап
		|		ИЗ
		|			РегистрНакопления.ДоступностьВидовРабочихЦентров КАК СтарыйГрафик
		|		ГДЕ
		|			СтарыйГрафик.Распоряжение = &Заказ
		|			И &ТекстЗапросаОтборПоЭтапам
		|			И &ТекстЗапросаИсключитьЭтапыСРучнымРазмещением
		|	) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.Регистратор,
		|	ВложенныйЗапрос.Период,
		|	ВложенныйЗапрос.ВидРабочегоЦентра,
		|	ВложенныйЗапрос.ДатаИнтервала,
		|	ВложенныйЗапрос.Распоряжение,
		|	ВложенныйЗапрос.Подразделение,
		|	ВложенныйЗапрос.Смена,
		|	ВложенныйЗапрос.КлючПартия,
		|	ВложенныйЗапрос.Этап
		|
		|ИМЕЮЩИЕ
		|	СУММА(ВложенныйЗапрос.Занято) <> 0
		|
		|ИТОГИ ПО
		|	Регистратор,
		|	Период";
	
	Если ОтборПоЭтапам Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаОтборПоЭтапам",
			"(СтарыйГрафик.КлючПартия, СтарыйГрафик.Этап) В (
			|	ВЫБРАТЬ
			|		Т.КлючПартия,
			|		Т.Этап
			|	ИЗ
			|		ВТНовыйГрафик КАК Т)");
	Иначе
		ТекстЗапросаОтборПоЭтапам = 
			"НЕ СтарыйГрафик.Этап В (
			|	ВЫБРАТЬ
			|		Этапы.Ссылка КАК Этап
			|	ИЗ
			|		Документ.ЭтапПроизводства2_2 КАК Этапы
			|	ГДЕ
			|		Этапы.Распоряжение = &Заказ
			|		И Этапы.Проведен
			|		И Этапы.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЭтаповПроизводства2_2.Начат))";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаОтборПоЭтапам",
			ТекстЗапросаОтборПоЭтапам);
	КонецЕсли;
	
	Если НЕ ПараметрыРасчета.ОтменитьРучныеИзмененияГрафика
		И ЭтапыСРучнымРазмещением.Количество() > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаИсключитьЭтапыСРучнымРазмещением",
			"СтарыйГрафик.Этап НЕ В (&ЭтапыСРучнымРазмещением)");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ТекстЗапросаИсключитьЭтапыСРучнымРазмещением",
			"ИСТИНА");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ЗагрузкаВРЦ", ЗагрузкаВРЦ);
	Запрос.УстановитьПараметр("Заказ", ПараметрыРасчета.Заказ);
	Запрос.УстановитьПараметр("ЭтапыСРучнымРазмещением", ЭтапыСРучнымРазмещением);
	#Вставка
	МассивРегистраторов = Новый Массив;
	#КонецВставки
	
	ВыборкаРегистратор = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРегистратор.Следующий() Цикл
		ВыборкаПериод = ВыборкаРегистратор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ВыборкаРегистратор.Регистратор.Пустая() Тогда
			Пока ВыборкаПериод.Следующий() Цикл
				ДокументОбъект = Документы.РегистраторГрафикаПроизводства.СоздатьДокумент();
				ДокументОбъект.Дата = ВыборкаПериод.Период;
				ДокументОбъект.Проведен = Истина;
				ДокументОбъект.ОбменДанными.Загрузка = Истина;
				ДокументОбъект.Записать();
				
				Набор = РегистрыНакопления.ДоступностьВидовРабочихЦентров.СоздатьНаборЗаписей();
				Набор.Отбор.Регистратор.Установить(ДокументОбъект.Ссылка);
				
				Выборка = ВыборкаПериод.Выбрать();
				Пока Выборка.Следующий() Цикл
					Запись = Набор.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, Выборка);
					Запись.Регистратор = ДокументОбъект.Ссылка;
				КонецЦикла;
				
				Набор.Записать(Ложь);
				#Вставка
				МассивРегистраторов.Добавить(ДокументОбъект.Ссылка);
				#КонецВставки
			КонецЦикла;
		Иначе
			Набор = РегистрыНакопления.ДоступностьВидовРабочихЦентров.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
			
			Пока ВыборкаПериод.Следующий() Цикл
				Выборка = ВыборкаПериод.Выбрать();
				Пока Выборка.Следующий() Цикл
					ЗаполнитьЗначенияСвойств(Набор.Добавить(), Выборка);
				КонецЦикла;
			КонецЦикла;
			
			Набор.Записать(Ложь);
			#Вставка
			МассивРегистраторов.Добавить(ВыборкаРегистратор.Регистратор);
			#КонецВставки
		КонецЕсли;
	КонецЦикла;
	
	ЗагрузкаВРЦ.Свернуть("ВидРабочегоЦентра, ДатаИнтервала");
	РегистрыНакопления.ДоступностьВидовРабочихЦентров.ПроверитьЗагрузкаНеПревышаетДоступностьГрафика(ЗагрузкаВРЦ);
	#Вставка 
	ПараметрыОтбора = Новый Структура("Регистратор", МассивРегистраторов);
	РегистрыНакопления.ДоступностьВидовРабочихЦентров.юум_СвернутьЗаписиПоРесурсуЗанятоСОтбором(ПараметрыОтбора);
	#КонецВставки
	
КонецПроцедуры

&После("ПослеЗаписиГрафикаПроизводства")
Процедура юум_ПослеЗаписиГрафикаПроизводства(Заказ, Этапы)
	// перепишем начало и окончание по записи заказа в соответствии с записями этапов
	СтатусГрафика = РегистрыСведений.ГрафикЭтаповПроизводства2_2.СтатусРабочийГрафик(); 
	ПустойКлючСвязи = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	ПустойЭтап = Справочники.ЭтапыПроизводства.ПустаяСсылка(); 
	
	// запись заказа
	Набор = РегистрыСведений.ГрафикЭтаповПроизводства2_2.СоздатьНаборЗаписей();
	Набор.Отбор.ЗаказНаПроизводство.Установить(Заказ);
	Набор.Отбор.СтатусГрафика.Установить(СтатусГрафика);
	Набор.Отбор.КлючПартия.Установить(ПустойКлючСвязи);
	Набор.Отбор.Этап.Установить(ПустойЭтап); 
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
	    Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустойЭтап", ПустойЭтап);
	Запрос.УстановитьПараметр("ЗаказНаПроизводство", Заказ);
	Запрос.УстановитьПараметр("СтатусГрафика", СтатусГрафика);  
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МИНИМУМ(График.Начало) КАК Начало,
	|	МАКСИМУМ(График.Окончание) КАК Окончание
	|ИЗ
	|	РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
	|ГДЕ
	|	График.ЗаказНаПроизводство = &ЗаказНаПроизводство
	|	И График.СтатусГрафика = &СтатусГрафика
	|	И НЕ График.Этап = &ПустойЭтап";
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Начало = ?(Не ЗначениеЗаполнено(Выборка.Начало), '00010101', Выборка.Начало);
		Окончание = ?(Не ЗначениеЗаполнено(Выборка.Окончание), '00010101', Выборка.Окончание);  
		Меняли = Ложь;
		ЗаписьЗаказа = Набор[0]; 
		Если ЗначениеЗаполнено(Выборка.Начало) и НЕ ЗаписьЗаказа.Начало = Выборка.Начало Тогда
		    ЗаписьЗаказа.Начало = Выборка.Начало;
			Меняли = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.Окончание) и НЕ ЗаписьЗаказа.Окончание = Выборка.Окончание Тогда
		    ЗаписьЗаказа.Окончание = Выборка.Окончание;
			Меняли = Истина;
		КонецЕсли;
		Если Меняли Тогда
			Набор.Записать(РежимЗамещения.Замещение);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ОбъемыФормы - ТаблицаЗначений - Ключи заказа/партии/номенклатуры, Требуется и Выбрано.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПроверитьОбъемы(Знач Заказ, Знач ОбъемыФормы)
    Если ТипЗнч(Заказ) <> Тип("ДокументСсылка.ЗаказНаПроизводство2_2")
        Или Не ЗначениеЗаполнено(Заказ) Тогда
        ВызватьИсключение "Для расчета ВРЦ необходим заказ на производство.";
    КонецЕсли;
    Если ТипЗнч(ОбъемыФормы) <> Тип("ТаблицаЗначений") Тогда
        ВызватьИсключение "Объемы расчета ВРЦ должны быть таблицей значений.";
    КонецЕсли;
    КлючиВыходов = Новый Соответствие;
    Для Каждого ОбъемВыхода Из ОбъемыФормы Цикл
        НекорректенОбъем = ОбъемВыхода.ЗаказНаПроизводство <> Заказ;
        Если Не НекорректенОбъем Тогда
            НекорректенОбъем = ОбъемВыхода.Требуется <= 0
                Или ОбъемВыхода.Выбрано < 0
                Или ОбъемВыхода.Выбрано > ОбъемВыхода.Требуется;
        КонецЕсли;
        Если НекорректенОбъем Тогда
            ВызватьИсключение "Некорректные объемы остатка для расчета ВРЦ.";
        КонецЕсли;
        КлючВыхода = Строка(ОбъемВыхода.КлючПартия) + "|" + Строка(ОбъемВыхода.КлючНоменклатура);
        Если КлючиВыходов.Получить(КлючВыхода) <> Неопределено Тогда
            ВызватьИсключение "Повтор ключа выхода партии в расчете ВРЦ.";
        КонецЕсли;
        КлючиВыходов.Вставить(КлючВыхода, Истина);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПрочитатьРеквизитыБезЗаписи(Знач Заказ, ДанныеРасчета, ПараметрыРасчета)
    ТекстЧтенияЗаказа = ТекстЗапросаДанныеЗаказа("&ТекстИмяТаблицы.Ссылка = &Заказ", Ложь);
    ТекстЧтенияЗаказа = СтрЗаменить(ТекстЧтенияЗаказа, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
    ЗапросЗаказа = Новый Запрос(ТекстЧтенияЗаказа);
    ЗапросЗаказа.УстановитьПараметр("Заказ", Заказ);
    ВыборкаЗаказа = ЗапросЗаказа.Выполнить().Выбрать();
    Если Не ВыборкаЗаказа.Следующий() Тогда
        ВызватьИсключение "Заказ не найден или недоступен для расчета ВРЦ.";
    КонецЕсли;
    ЗаполнитьЗначенияСвойств(ДанныеРасчета.РеквизитыЗаказа, ВыборкаЗаказа);
    ПараметрыРасчета.ЗадействоватьРезервДоступности = ВыборкаЗаказа.ЗадействоватьРезервДоступности;
    ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ = ВыборкаЗаказа.ИспользоватьАльтернативныеВРЦ;
КонецПроцедуры // } #юум

// Параметры:
//    МенеджерТаблиц - МенеджерВременныхТаблиц - Менеджер временных таблиц текущего расчета графика.
//    ОбъемыФормы - ТаблицаЗначений - Ключи заказа/партии/номенклатуры, Требуется и Выбрано.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПоместитьОбъемыВыбора(МенеджерТаблиц, Знач ОбъемыФормы)
    ЗапросОбъемов = Новый Запрос;
    ЗапросОбъемов.МенеджерВременныхТаблиц = МенеджерТаблиц;
    ЗапросОбъемов.Текст =
    "ВЫБРАТЬ
    | ВыборФормы.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
    | ВыборФормы.КлючПартия КАК КлючПартия,
    | ВыборФормы.КлючНоменклатура КАК КлючНоменклатура,
    | ВыборФормы.Требуется КАК Требуется,
    | ВыборФормы.Выбрано КАК Выбрано
    |ПОМЕСТИТЬ юум_ФП_ОбъемыВыбора
    |ИЗ &ОбъемыФормы КАК ВыборФормы
    |ИНДЕКСИРОВАТЬ ПО ЗаказНаПроизводство, КлючПартия, КлючНоменклатура";
    ЗапросОбъемов.УстановитьПараметр("ОбъемыФормы", ОбъемыФормы);
    ЗапросОбъемов.Выполнить();
КонецПроцедуры // } #юум

// Параметры:
//    ШтатныйТекст - Строка - Исходный запрос структуры, в который подключается объем формы.
//
// Возвращаемое значение:
//    Структура - ИсходнаяСтруктура и ВыбраннаяСтруктура - части пакета запросов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_СтруктураЗаказаПоВыбору(Знач ШтатныйТекст)
    ИсходныйТекст = СтрЗаменить(ШтатныйТекст, "ВТСтруктураЗаказа", "юум_ФП_ИсходнаяСтруктураЗаказа");
    ТекстОбъемов =
    "ВЫБРАТЬ
    | Основа.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
    | Основа.КлючНоменклатура КАК КлючНоменклатура,
    | Основа.КлючПартия КАК КлючПартия,
    | Основа.Этап КАК Этап,
    | Основа.Номенклатура КАК Номенклатура,
    | Основа.Характеристика КАК Характеристика,
    | Основа.ЭтоВыпуск КАК ЭтоВыпуск,
    | Основа.ЭтоПеремещение КАК ЭтоПеремещение,
    | Основа.ЭтоПроизводствоПродукции КАК ЭтоПроизводствоПродукции,
    | Основа.ВидНоменклатуры КАК ВидНоменклатуры,
    | Основа.Спецификация КАК Спецификация,
    | Основа.Подразделение КАК Подразделение,
    | Основа.СкладПеремещения КАК СкладПеремещения,
    | Основа.НазначениеПеремещения КАК НазначениеПеремещения,
    | ВЫБОР
    |  КОГДА ВыборФормы.КлючНоменклатура ЕСТЬ НЕ NULL
    |   И Основа.ЭтоВыпуск И НЕ Основа.ЭтоПеремещение
    |  ТОГДА Основа.Запланировано * ВыборФормы.Выбрано / ВыборФормы.Требуется
    |  ИНАЧЕ Основа.Запланировано
    | КОНЕЦ КАК Запланировано,
    | Основа.Запущено КАК Запущено,
    | Основа.ДлительностьДоВыпуска КАК ДлительностьДоВыпуска,
    | Основа.ИдентификаторВГруппеИзделий КАК ИдентификаторВГруппеИзделий,
    | Основа.Уровень КАК Уровень
    |ПОМЕСТИТЬ ВТСтруктураЗаказа
    |ИЗ юум_ФП_ИсходнаяСтруктураЗаказа КАК Основа
    | ЛЕВОЕ СОЕДИНЕНИЕ юум_ФП_ОбъемыВыбора КАК ВыборФормы
    | ПО Основа.ЗаказНаПроизводство = ВыборФормы.ЗаказНаПроизводство
    |  И Основа.КлючПартия = ВыборФормы.КлючПартия
    |  И Основа.КлючНоменклатура = ВыборФормы.КлючНоменклатура
    |ИНДЕКСИРОВАТЬ ПО ЗаказНаПроизводство, КлючНоменклатура";
    Возврат Новый Структура("ИсходнаяСтруктура,ВыбраннаяСтруктура", ИсходныйТекст, ТекстОбъемов);
КонецФункции // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    Настройки - Структура - Параметры объема формы и необязательный контекст очереди расчета.
//
// Возвращаемое значение:
//    Структура - Результат размещения: ГрафикЗапланирован, Ошибки, Оповещения и ДанныеРасчета.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РассчитатьГрафикВнутриЗамераВремени(Знач Заказ, Знач Настройки)
    ПараметрыРасчета = НовыйПараметрыРасчета();
    ПараметрыРасчета.Заказ = Заказ;
    ПараметрыРасчета.Вставить("юум_ФП_ОбъемыФормы", Настройки.юум_ФП_ОбъемыФормы);
    ДанныеРасчета = НовыйДанныеРасчета();
    юум_ФП_ПрочитатьРеквизитыБезЗаписи(Заказ, ДанныеРасчета, ПараметрыРасчета);
    юум_ФП_ПрочитатьЭтапыПредварительногоПросмотра(Заказ, ДанныеРасчета, ПараметрыРасчета);
    Если Настройки.Свойство("юум_ФП_КонтекстОчереди") Тогда
        РазницыОчереди = юум_ФП_РазницыЗагрузкиОчереди(Заказ, Настройки.юум_ФП_КонтекстОчереди);
        ПараметрыРасчета.Вставить("юум_ФП_РазницыЗагрузки", РазницыОчереди);
        ПараметрыРасчета.Вставить("юум_ФП_УчтенныеИнтервалы", Новый Соответствие);
    КонецЕсли;
    ПрочитатьДоступность(Заказ, ДанныеРасчета, ПараметрыРасчета);
    юум_ФП_РазместитьЭтапыПредварительногоПросмотра(ДанныеРасчета, ПараметрыРасчета);
    ГрафикЗапланирован = ДанныеРасчета.Этапы.Количество() > 0
        И ПараметрыРасчета.Ошибки.Найти(Истина, "Критичная") = Неопределено;
    Если ГрафикЗапланирован И ДанныеРасчета.РеквизитыЗаказа.ЭтоСборка Тогда
        СместитьЭтапыПоДлительности(ДанныеРасчета, ПараметрыРасчета);
    КонецЕсли;
    РезультатПредварительногоПросмотра = Новый Структура;
    РезультатПредварительногоПросмотра.Вставить("ГрафикЗапланирован", ГрафикЗапланирован);
    РезультатПредварительногоПросмотра.Вставить("Ошибки", ПараметрыРасчета.Ошибки);
    РезультатПредварительногоПросмотра.Вставить("Оповещения", ПараметрыРасчета.Оповещения);
    РезультатПредварительногоПросмотра.Вставить("КоличествоЭтапов", ДанныеРасчета.Этапы.Количество());
    РезультатПредварительногоПросмотра.Вставить("ДанныеРасчета", ДанныеРасчета);
    Возврат РезультатПредварительногоПросмотра;
КонецФункции // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ПрочитатьЭтапыПредварительногоПросмотра(Заказ, ДанныеРасчета, ПараметрыРасчета)
	
	ТекстыЗапроса = Новый СписокЗначений;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
    юум_ФП_ОбъемыФормы = Неопределено;
    Если ПараметрыРасчета.Свойство("юум_ФП_ОбъемыФормы", юум_ФП_ОбъемыФормы) Тогда
        юум_ФП_ПоместитьОбъемыВыбора(МенеджерВременныхТаблиц, юум_ФП_ОбъемыФормы);
    КонецЕсли;

	// ВТСтруктураЗаказа
	ТекстЗапроса = ТекстЗапросаВТСтруктураЗаказа("&ТекстИмяТаблицы.ЗаказНаПроизводство = &Заказ");
    Если ПараметрыРасчета.Свойство("юум_ФП_ОбъемыФормы") Тогда
        ЗапросыСтруктуры = юум_ФП_СтруктураЗаказаПоВыбору(ТекстЗапроса);
        ТекстыЗапроса.Добавить(ЗапросыСтруктуры.ИсходнаяСтруктура, "юум_ФП_ИсходнаяСтруктураЗаказа");
        ТекстЗапроса = ЗапросыСтруктуры.ВыбраннаяСтруктура;
    КонецЕсли;

	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСтруктураЗаказа");
	
	// ВТВыпускПартий
	ТекстЗапроса = ТекстЗапросаВТВыпускПартий();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТВыпускПартий");
	
	// ВТКоличествоПартий
	ТекстЗапроса = ТекстЗапросаВТКоличествоПартий();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТКоличествоПартий");
	
	// ВТЗаказыНаРемонт
	ТекстЗапроса = ТекстЗапросаВТЗаказыНаРемонт("&ТекстИмяТаблицы.Ссылка = &Заказ");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонт");
	
	#Область ВТОграниченияГрафикаПроизводстваПоМатериалам
	
	Если ПараметрыРасчета.ВсеМатериалыВНаличии Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка) КАК ЗаказНаПроизводство,
			|	&ПустойКлючСвязи                                       КАК КлючПартия,
			|	ЗНАЧЕНИЕ(Документ.ЭтапПроизводства2_2.ПустаяСсылка)    КАК Этап,
			|	ДАТАВРЕМЯ(1, 1, 1)                                     КАК ДатаДоступности
			|ПОМЕСТИТЬ ВТОграниченияГрафикаПроизводстваПоМатериалам";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОграниченияГрафикаПроизводстваПоМатериалам");
		
	Иначе
		
		УправлениеПроизводством.СоздатьВТОграниченияГрафикаПроизводстваПоМатериаламДинамическаяСтруктура(
			МенеджерВременныхТаблиц,
			Заказ,
			Ложь,
			Истина);
		
	КонецЕсли;
	
	#КонецОбласти
	
	// ВТСвязиМеждуПартиями
	ТекстЗапроса = ТекстЗапросаВТСвязиМеждуПартиями();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиМеждуПартиями");
	
	// ВТПартии
	ТекстЗапроса = ТекстЗапросаВТПартии();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТПартии");
	
	// ВТСвязиПартийИЭтаповСправочник
	ТекстЗапроса = ТекстЗапросаВТСвязиПартийИЭтаповСправочник();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиПартийИЭтаповСправочник");
	
	// ВТЭтапыСправочник
	ТекстЗапроса = ТекстЗапросаВТЭтапыСправочник();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЭтапыСправочник");
	
	// ВТСвязиПартийИЭтаповДокумент
	ТекстЗапроса = ТекстЗапросаВТСвязиПартийИЭтаповДокумент();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязиПартийИЭтаповДокумент");

    юум_ФП_ЗапросыЭтаповПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ПараметрыРасчета);
    юум_ФП_ЗапросыРемонтаПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета);
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("СтатусГрафика", ПараметрыРасчета.СтатусГрафика);
	Запрос.УстановитьПараметр("ПустойКлючСвязи", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Запрос.УстановитьПараметр("ОсновнойКалендарь", Константы.ОсновнойКалендарьПредприятия.Получить());
	Запрос.УстановитьПараметр("ТекущаяДата", ПараметрыРасчета.ТекущаяДата);
	Запрос.УстановитьПараметр("НеограниченныйПаркОборудования", ПараметрыРасчета.НеограниченныйПаркОборудования);
	Запрос.УстановитьПараметр("ОтменитьРучныеИзмененияГрафика", ПараметрыРасчета.ОтменитьРучныеИзмененияГрафика);
	Запрос.УстановитьПараметр("ИспользоватьАльтернативныеВРЦ", ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ);
	ИспользоватьПараметризацию = ПолучитьФункциональнуюОпцию("ИспользоватьПараметризациюРесурсныхСпецификаций");
	Запрос.УстановитьПараметр("ИспользоватьПараметризациюСпецификаций", ИспользоватьПараметризацию);
	
	ИсходныйПривилегированныйРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Таблицы = ОбщегоНазначенияУТ.ВыгрузитьРезультатыЗапроса(Запрос, ТекстыЗапроса,, Истина, Ложь);
	Исключение
		УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(ИсходныйПривилегированныйРежим);
	
	Этапы = Таблицы.Этапы; // ТаблицаЗначений
	Этапы.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.Этапы = Этапы;
	
	Для каждого Колонка Из Этапы.Колонки Цикл
		ДанныеРасчета.ЭтапКопия.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Связи = Таблицы.Связи; // ТаблицаЗначений
	Связи.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.Связи = Связи;
	
	ВидыРЦ = Таблицы.ВидыРЦ; // ТаблицаЗначений
	РассчитатьВремяВидовРЦПоФормулам(ВидыРЦ, Таблицы.ИзделияКРасчетуВидовРЦПоФормуле);
	ВидыРЦ.Индексы.Добавить("КлючПартия, Этап");
	ДанныеРасчета.ВидыРЦ = ВидыРЦ;
	
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ Тогда
		АльтернативныеВидыРЦ = Таблицы.АльтернативныеВидыРЦ; // ТаблицаЗначений
		РассчитатьВремяВидовРЦПоФормулам(АльтернативныеВидыРЦ, Таблицы.ИзделияКРасчетуВидовРЦПоФормуле);
		АльтернативныеВидыРЦ.Индексы.Добавить("КлючПартия, Этап");
		АльтернативныеВидыРЦ.Индексы.Добавить("КлючПартия, Этап, КлючСвязи");
		ДанныеРасчета.АльтернативныеВидыРЦ = АльтернативныеВидыРЦ;
	КонецЕсли;
	
	ДанныеРасчета.Задания = Таблицы.Задания;
	ДанныеРасчета.ЭтапыСРучнымРазмещением = Таблицы.ЭтапыСРучнымРазмещением.ВыгрузитьКолонку("Ссылка");
	
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		СвязиРемонтов = Таблицы.СвязиРемонтов; // ТаблицаЗначений
		СвязиРемонтов.Индексы.Добавить("КлючПартияРемонт");
		ДанныеРасчета.СвязиРемонтов = СвязиРемонтов;
		
		Если Таблицы.ПартииРемонтаКРасчетуПорядка.Количество() > 0 Тогда
			РассчитатьПорядокРемонта(ДанныеРасчета, Таблицы.ПартииРемонтаКРасчетуПорядка);
		КонецЕсли;
	КонецЕсли;
	
	// Контроль видов РЦ
	СтруктураПоиска = Новый Структура("ЕстьОшибкаНеЗаполненаЗагрузка", Истина);
	ТаблицаОшибок = ВидыРЦ.Скопировать(СтруктураПоиска, "ВидРабочегоЦентра");
	ТаблицаОшибок.Свернуть("ВидРабочегоЦентра");
	Для каждого Строка Из ТаблицаОшибок Цикл
		ШаблонОповещения = НСтр("ru = 'Для вида РЦ ""%1"" не задана максимальная загрузка. "
			+ "Реквизит обязателен к заполнению для видов РЦ с параллельной загрузкой.'; "
			+ "en = 'The maximum load is not set for the ""%1"" work center type. "
			+ "The attribute is required for work center types with parallel load.'");
		ТекстОповещения = СтрШаблон(
			ШаблонОповещения,
			Строка.ВидРабочегоЦентра);
		ПараметрыРасчета.Оповещения.Вставить(ТекстОповещения, Строка.ВидРабочегоЦентра);
	КонецЦикла;
	
КонецПроцедуры // } #юум

// Параметры:
//    ТекстыЗапроса - СписокЗначений - Именованные части пакета запросов штатного расчета графика.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗапросыЭтаповПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета, ПараметрыРасчета)
	#Область ВТЗаказыНаРемонтКРасчетуПорядка
	
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	&Заказ КАК ЗаказНаПроизводство
			|ПОМЕСТИТЬ ВТЗаказыНаРемонтКРасчетуПорядка
			|ГДЕ
			|	ИСТИНА В (
			|		ВЫБРАТЬ ПЕРВЫЕ 1
			|			ИСТИНА
			|		ИЗ
			|			ВТПартии КАК Партии
			|			
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК Этапы
			|			ПО Партии.Ссылка = Этапы.Владелец
			|				И Партии.ЭтоПеремещение = ЛОЖЬ
			|		ГДЕ
			|			НЕ Этапы.ПометкаУдаления
			|			И НЕ ИСТИНА В (
			|				ВЫБРАТЬ ПЕРВЫЕ 1
			|					ИСТИНА
			|				ИЗ
			|					РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
			|				ГДЕ
			|					График.ЗаказНаПроизводство = Партии.ЗаказНаПроизводство
			|					И График.СтатусГрафика = 0
			|					И График.Этап = Этапы.Ссылка
			|					И График.КлючПартия = Партии.КлючПартия)
			|		
			|		ОБЪЕДИНИТЬ ВСЕ
			|		
			|		ВЫБРАТЬ ПЕРВЫЕ 1
			|			ИСТИНА
			|		ИЗ
			|			ВТПартии КАК Партии
			|			
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
			|			ПО Партии.Ссылка = Этапы.ПартияПроизводства
			|				И Партии.ЭтоПеремещение = ЛОЖЬ
			|		ГДЕ
			|			Этапы.Проведен
			|			И НЕ ИСТИНА В (
			|				ВЫБРАТЬ ПЕРВЫЕ 1
			|					ИСТИНА
			|				ИЗ
			|					РегистрСведений.ГрафикЭтаповПроизводства2_2 КАК График
			|				ГДЕ
			|					График.ЗаказНаПроизводство = Партии.ЗаказНаПроизводство
			|					И График.СтатусГрафика = 0
			|					И График.Этап = Этапы.Ссылка
			|					И График.КлючПартия = Партии.КлючПартия))";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонтКРасчетуПорядка");
		
	Иначе
		
		ТекстЗапроса = 
			"ВЫБРАТЬ ПЕРВЫЕ 0
			|	ЗНАЧЕНИЕ(Документ.ЗаказНаПроизводство2_2.ПустаяСсылка) КАК ЗаказНаПроизводство
			|ПОМЕСТИТЬ ВТЗаказыНаРемонтКРасчетуПорядка";
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЗаказыНаРемонтКРасчетуПорядка");
		
	КонецЕсли;
	
	#КонецОбласти
	
	// ВТСвязи
	ТекстЗапроса = ТекстЗапросаВТСвязи();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСвязи");
	
	// ВТЭтапыСРучнымРазмещением
	ТекстЗапроса = ТекстЗапросаВТЭтапыСРучнымРазмещением("&ТекстИмяТаблицы.Распоряжение = &Заказ");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТЭтапыСРучнымРазмещением");
	
	// ВТДатыНепланируемыхПредшественников
	ТекстЗапроса = ТекстЗапросаВТДатыНепланируемыхПредшественников("&ТекстИмяТаблицы.Распоряжение = &Заказ");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТДатыНепланируемыхПредшественников");
	
	// ВТОтборПоСвойствамНастройки
	ТекстЗапроса = ТекстЗапросаВТОтборПоСвойствамНастройки();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОтборПоСвойствамНастройки");
	
	// ВТОтборПоСвойствам
	ТекстЗапроса = УправлениеДаннымиОбИзделиях.ТекстЗапросаВТОтборПоСвойствам("ВТОтборПоСвойствамНастройки");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТОтборПоСвойствам");
	
	// ВТКоличествоРЦ
	ТекстЗапроса = ТекстЗапросаВТКоличествоРЦ("ИСТИНА");
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТКоличествоРЦ");
	
	// Этапы
	ТекстЗапроса = ТекстЗапросаЭтапы(Ложь);
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Этапы");
	
	// Связи
	ТекстЗапроса = ТекстЗапросаСвязи(ПараметрыРасчета.ОтменитьРучныеИзмененияГрафика);
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Связи");
	
	// ВидыРЦ
	ТекстЗапроса = ТекстЗапросаВидыРЦ(Ложь, "ИСТИНА", Ложь);
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВидыРЦ");
	
	Если ПараметрыРасчета.ИспользоватьАльтернативныеВРЦ Тогда
		ТекстЗапроса = ТекстЗапросаВидыРЦ(Ложь, "ИСТИНА", Истина);
		ТекстыЗапроса.Добавить(ТекстЗапроса, "АльтернативныеВидыРЦ");
	КонецЕсли;
	
	// ВТСпецификацииКРасчетуВидовРЦПоФормуле
	ТекстЗапроса = ТекстЗапросаВТСпецификацииКРасчетуВидовРЦПоФормуле();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТСпецификацииКРасчетуВидовРЦПоФормуле");
	
	// ИзделияКРасчетуВидовРЦПоФормуле
	ТекстЗапроса = ТекстЗапросаИзделияКРасчетуВидовРЦПоФормуле();
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ИзделияКРасчетуВидовРЦПоФормуле");
	
	#Область Задания
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Задания.ЗаказНаПроизводство КАК ЗаказНаПроизводство,
		|	Задания.Разделитель         КАК Разделитель,
		|	Задания.ЭтапПроизводства    КАК ЭтапПроизводства,
		|	Задания.КлючПартия          КАК КлючПартия
		|ИЗ
		|	РегистрСведений.ЗаданияКРасчетуСтруктурыЗаказаГрафикПроизводства КАК Задания
		|ГДЕ
		|	Задания.ЗаказНаПроизводство = &Заказ";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "Задания");
	
	#КонецОбласти
	
	#Область ЭтапыСРучнымРазмещением
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Этапы.Ссылка КАК Ссылка
		|ИЗ
		|	ВТЭтапыСРучнымРазмещением КАК Этапы";
	
	ТекстыЗапроса.Добавить(ТекстЗапроса, "ЭтапыСРучнымРазмещением");
	
	#КонецОбласти

КонецПроцедуры // } #юум

// Параметры:
//    ТекстыЗапроса - СписокЗначений - Именованные части пакета запросов штатного расчета графика.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ЗапросыРемонтаПредварительногоПросмотра(ТекстыЗапроса, ДанныеРасчета)
	Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт Тогда
		
		// СвязиРемонтов
		ТекстЗапроса = ТекстЗапросаСвязиРемонтов();
		ТекстыЗапроса.Добавить(ТекстЗапроса, "СвязиРемонтов");
		
		#Область ВТПартииРемонтаКРасчетуПорядка
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	СУММА(
			|		ВЫБОР
			|			КОГДА ЕСТЬNULL(ДлительностьЭтапов.ДлительностьВСекундах, 0) = 0
			|				ТОГДА 0.0001
			|			ИНАЧЕ ЕСТЬNULL(ДлительностьЭтапов.ДлительностьВСекундах, 0)
			|		КОНЕЦ)        КАК Ресурсоемкость
			|ПОМЕСТИТЬ ВТПартииРемонтаКРасчетуПорядка
			|ИЗ
			|	ВТПартии КАК Партии
			|	
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЭтапыПроизводства КАК Этапы
			|	ПО Партии.Ссылка = Этапы.Владелец
			|		И Партии.ЭтоПеремещение = ЛОЖЬ
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НормативнаяДлительностьЭтаповПроизводства КАК ДлительностьЭтапов
			|	ПО Этапы.Ссылка = ДлительностьЭтапов.Этап
			|		И Партии.Ссылка = ДлительностьЭтапов.Спецификация
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И НЕ Этапы.ПометкаУдаления
			|
			|СГРУППИРОВАТЬ ПО
			|	Партии.КлючПартия,
			|	Партии.Уровень
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	СУММА(
			|		ВЫБОР
			|			КОГДА Этапы.ДлительностьЭтапа = 0
			|				ТОГДА 0.0001
			|			ИНАЧЕ 
			|				ВЫБОР Этапы.ЕдиницаИзмеренияДлительностиЭтапа
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.День)
			|						ТОГДА Этапы.ДлительностьЭтапа * 86400
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Минута)
			|						ТОГДА Этапы.ДлительностьЭтапа * 60
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Час)
			|						ТОГДА Этапы.ДлительностьЭтапа * 3600
			|					КОГДА ЗНАЧЕНИЕ(Перечисление.ЕдиницыИзмеренияВремени.Секунда)
			|						ТОГДА Этапы.ДлительностьЭтапа
			|				КОНЕЦ
			|		КОНЕЦ)        КАК Ресурсоемкость
			|ИЗ
			|	ВТПартии КАК Партии
			|	
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭтапПроизводства2_2 КАК Этапы
			|	ПО Партии.Ссылка = Этапы.ПартияПроизводства
			|		И Партии.ЭтоПеремещение = ЛОЖЬ
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И Этапы.Проведен
			|
			|СГРУППИРОВАТЬ ПО
			|	Партии.КлючПартия,
			|	Партии.Уровень
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	Партии.КлючПартия КАК КлючПартия,
			|	Партии.Уровень    КАК Уровень,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) = 0
			|			ТОГДА 0.0001
			|		ИНАЧЕ ЕСТЬNULL(КэшНСИ.СпособОбеспечения.ДлительностьВДнях, 1) * 86400
			|	КОНЕЦ             КАК Ресурсоемкость
			|ИЗ
			|	ВТПартии КАК Партии
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КэшНСИСтруктурыЗаказа КАК КэшНСИ
			|	ПО Партии.НоменклатураПеремещения = КэшНСИ.Номенклатура
			|		И Партии.ХарактеристикаПеремещения = КэшНСИ.Характеристика
			|		И Партии.СкладПеремещения = КэшНСИ.Склад
			|		И Партии.НазначениеПеремещения = КэшНСИ.Назначение
			|		И Партии.ЗаказНаПроизводство = КэшНСИ.ЗаказНаПроизводство
			|ГДЕ
			|	Партии.ЗаказНаПроизводство В (
			|		ВЫБРАТЬ
			|			Т.ЗаказНаПроизводство
			|		ИЗ
			|			ВТЗаказыНаРемонтКРасчетуПорядка КАК Т)
			|	И Партии.ЭтоПеремещение
			|	И Партии.Ссылка = ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	КлючПартия";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ВТПартииРемонтаКРасчетуПорядка");
		
		#КонецОбласти
		
		#Область ПартииРемонтаКРасчетуПорядка
		
		ТекстЗапроса = 
			"ВЫБРАТЬ
			|	Партии.КлючПартия     КАК КлючПартияПредшественник,
			|	Партии.Ресурсоемкость КАК Ресурсоемкость,
			|	ЕСТЬNULL(Связи.КлючПартия, &ПустойКлючСвязи)                              КАК КлючПартия,
			|	ЕСТЬNULL(Связи.Этап, ЗНАЧЕНИЕ(Справочник.ЭтапыПроизводства.ПустаяСсылка)) КАК Этап
			|ИЗ
			|	ВТПартииРемонтаКРасчетуПорядка КАК Партии
			|
			|	ЛЕВОЕ СОЕДИНЕНИЕ ВТСвязиМеждуПартиями КАК Связи
			|	ПО Партии.КлючПартия = Связи.КлючПартияПредшественник
			|
			|УПОРЯДОЧИТЬ ПО
			|	Партии.Уровень УБЫВ";
		
		ТекстыЗапроса.Добавить(ТекстЗапроса, "ПартииРемонтаКРасчетуПорядка");
		
		#КонецОбласти
		
	КонецЕсли;

КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_РазместитьЭтапыПредварительногоПросмотра(ДанныеРасчета, ПараметрыРасчета)
    Для Каждого СтрокаЭтап Из ДанныеРасчета.Этапы Цикл
        Если Не СтрокаЭтап.Планировать Тогда
            Продолжить;
        КонецЕсли;
        юум_ФП_НаследоватьДатыПредшественников(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
        Если СтрокаЭтап.ПланироватьВидыРЦ Тогда
            РазместитьЭтапПоВидамРЦ(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
        Иначе
            РазместитьЭтапПоДлительности(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап, Истина);
        КонецЕсли;
        Если ДанныеРасчета.РеквизитыЗаказа.ЭтоРемонт
            И СтрокаЭтап.Окончание <> '00010101' Тогда
            Если СтрокаЭтап.ЭтоНачальныйЭтапРемонта
                Или СтрокаЭтап.НомерСледующегоЭтапа = 0 И Не СтрокаЭтап.ЭтоПеремещение Тогда
                юум_ФП_НаследоватьДатыРемонтов(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    КонтекстОчереди - Структура - Уже рассчитанные Заказы и их интервальная Загрузка.
//
// Возвращаемое значение:
//    ТаблицаЗначений - Разница исходной и рассчитанной загрузки предыдущих заказов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_РазницыЗагрузкиОчереди(Знач Заказ, Знач КонтекстОчереди)
    Разницы = Новый ТаблицаЗначений;
    ТипКолонки = Новый ОписаниеТипов("СправочникСсылка.ВидыРабочихЦентров");
    Разницы.Колонки.Добавить("ВидРабочегоЦентра", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Дата");
    Разницы.Колонки.Добавить("ДатаИнтервала", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Число");
    Разницы.Колонки.Добавить("РазницаВремени", ТипКолонки);
    ТипКолонки = Новый ОписаниеТипов("Число");
    Разницы.Колонки.Добавить("КоэффициентЗагрузки", ТипКолонки);
    Если КонтекстОчереди.Заказы.Количество() = 0 Тогда
        Возврат Разницы;
    КонецЕсли;
    МенеджерПриоритета = Новый МенеджерВременныхТаблиц;
    Документы.ЗаказНаПроизводство2_2.СоздатьВТЗаказыСБольшимПриоритетом(
        МенеджерПриоритета, "юум_ФП_ПриоритетОчереди", Заказ);
    ЗапросРазницы = Новый Запрос;
    ЗапросРазницы.МенеджерВременныхТаблиц = МенеджерПриоритета;
    ЗапросРазницы.Текст = юум_ФП_ТекстРазницыЗагрузки();
    ЗапросРазницы.УстановитьПараметр("ПредыдущиеЗаказы", КонтекстОчереди.Заказы);
    ЗапросРазницы.УстановитьПараметр("НоваяЗагрузка", КонтекстОчереди.Загрузка);
    Разницы = ЗапросРазницы.Выполнить().Выгрузить();
    Разницы.Индексы.Добавить("ВидРабочегоЦентра,ДатаИнтервала");
    Возврат Разницы;
КонецФункции // } #юум

//
//
//
// Возвращаемое значение:
//    Строка - Запрос интервалов с разницей загрузки ВРЦ для очереди.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_ТекстРазницыЗагрузки()
    Возврат
    "ВЫБРАТЬ
    | Источник.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    | Источник.ДатаИнтервала КАК ДатаИнтервала,
    | Источник.Распоряжение КАК Распоряжение,
    | Источник.Этап КАК Этап,
    | Источник.Занято КАК Занято
    |ПОМЕСТИТЬ юум_ФП_НоваяЗагрузкаОчереди
    |ИЗ &НоваяЗагрузка КАК Источник
    |;
    |ВЫБРАТЬ
    | Разницы.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    | Разницы.ДатаИнтервала КАК ДатаИнтервала,
    | СУММА(Разницы.РазницаВремени) КАК РазницаВремени,
    | МАКСИМУМ(ВЫБОР КОГДА Разницы.ВидРабочегоЦентра.ПараллельнаяЗагрузка
    |  И Разницы.ВидРабочегоЦентра.МаксимальнаяЗагрузка <> 0
    |  ТОГДА Разницы.ВидРабочегоЦентра.МаксимальнаяЗагрузка
    |  ИНАЧЕ 1 КОНЕЦ) КАК КоэффициентЗагрузки
    |ИЗ (
    | ВЫБРАТЬ
    |  БазоваяЗагрузка.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    |  БазоваяЗагрузка.ДатаИнтервала КАК ДатаИнтервала,
    |  БазоваяЗагрузка.Занято КАК РазницаВремени
    | ИЗ РегистрНакопления.ДоступностьВидовРабочихЦентров КАК БазоваяЗагрузка
    |  ВНУТРЕННЕЕ СОЕДИНЕНИЕ юум_ФП_ПриоритетОчереди КАК Приоритет
    |  ПО БазоваяЗагрузка.Распоряжение = Приоритет.Ссылка
    | ГДЕ БазоваяЗагрузка.Активность
    |  И БазоваяЗагрузка.Распоряжение В (&ПредыдущиеЗаказы)
    |  И БазоваяЗагрузка.Этап ССЫЛКА Справочник.ЭтапыПроизводства
    | ОБЪЕДИНИТЬ ВСЕ
    | ВЫБРАТЬ
    |  ТекущаяЗагрузка.ВидРабочегоЦентра КАК ВидРабочегоЦентра,
    |  ТекущаяЗагрузка.ДатаИнтервала КАК ДатаИнтервала,
    |  -ТекущаяЗагрузка.Занято КАК РазницаВремени
    | ИЗ юум_ФП_НоваяЗагрузкаОчереди КАК ТекущаяЗагрузка
    |  ВНУТРЕННЕЕ СОЕДИНЕНИЕ юум_ФП_ПриоритетОчереди КАК Приоритет
    |  ПО ТекущаяЗагрузка.Распоряжение = Приоритет.Ссылка
    | ГДЕ ТекущаяЗагрузка.Этап ССЫЛКА Справочник.ЭтапыПроизводства
    |) КАК Разницы
    |СГРУППИРОВАТЬ ПО Разницы.ВидРабочегоЦентра, Разницы.ДатаИнтервала
    |ИМЕЮЩИЕ СУММА(Разницы.РазницаВремени) <> 0";
КонецФункции // } #юум

// Нормальные вызовы ERP не имеют служебного контекста и проходят без изменений.
// При дочитывании исходная функция сохраняет ранее измененные строки таблицы.
&После("ПрочитатьДоступность")

// Параметры:
//    Заказ - ДокументСсылка.ЗаказНаПроизводство2_2 - Заказ, для которого рассчитывается график в памяти.
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    Граница - Дата, Неопределено - Необязательная граница интервалов учитываемой загрузки.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_УчестьЗагрузкуОчереди(Заказ, ДанныеРасчета, ПараметрыРасчета, Граница = Неопределено)
    Если Не ПараметрыРасчета.Свойство("юум_ФП_РазницыЗагрузки") Тогда
        Возврат;
    КонецЕсли;
    Разницы = ПараметрыРасчета.юум_ФП_РазницыЗагрузки;
    Если Разницы.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    УчтенныеИнтервалы = ПараметрыРасчета.юум_ФП_УчтенныеИнтервалы;
    КлючПоиска = Новый Структура("ВидРабочегоЦентра,ДатаИнтервала");
    Для Каждого ИнтервалДоступности Из ДанныеРасчета.ДоступностьВРЦ Цикл
        Если ИнтервалДоступности.ЭтоИндекс Тогда
            Продолжить;
        КонецЕсли;
        КлючИнтервала = юум_ФП_КлючИнтервалаДоступности(ИнтервалДоступности);
        Если УчтенныеИнтервалы.Получить(КлючИнтервала) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        ЗаполнитьЗначенияСвойств(КлючПоиска, ИнтервалДоступности);
        НайденныеРазницы = Разницы.НайтиСтроки(КлючПоиска);
        Если НайденныеРазницы.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Разница = НайденныеРазницы[0];
        ИнтервалДоступности.ДоступноВремя = ИнтервалДоступности.ДоступноВремя
            + Разница.РазницаВремени;
        ИнтервалДоступности.ДоступноВремяЗагрузка = ИнтервалДоступности.ДоступноВремяЗагрузка
            + Разница.РазницаВремени * Разница.КоэффициентЗагрузки;
        УчтенныеИнтервалы.Вставить(КлючИнтервала, Истина);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ИнтервалДоступности - СтрокаТаблицыЗначений - Вид рабочего центра, дата и границы интервала доступности.
//
// Возвращаемое значение:
//    Строка - Составной ключ ВРЦ, даты и границ интервала доступности.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Функция юум_ФП_КлючИнтервалаДоступности(Знач ИнтервалДоступности)
    Возврат Строка(ИнтервалДоступности.ВидРабочегоЦентра.УникальныйИдентификатор())
        + "|" + Формат(ИнтервалДоступности.ДатаИнтервала, "ДФ=yyyyMMddHHmmss")
        + "|" + Формат(ИнтервалДоступности.НачалоИнтервала, "ДФ=yyyyMMddHHmmss")
        + "|" + Формат(ИнтервалДоступности.ОкончаниеИнтервала, "ДФ=yyyyMMddHHmmss");
КонецФункции // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    СтрокаЭтап - СтрокаТаблицыЗначений - Текущий этап штатной модели графика.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_НаследоватьДатыПредшественников(ДанныеРасчета, ПараметрыРасчета, СтрокаЭтап)
    ПоискЭтапа = ПараметрыРасчета.КлючПартияЭтап;
    ПоискЭтапа.КлючПартия = СтрокаЭтап.КлючПартия;
    ПоискЭтапа.Этап = СтрокаЭтап.Этап;
    Для Каждого СтрокаСвязи Из ДанныеРасчета.Связи.НайтиСтроки(ПоискЭтапа) Цикл
        ПоискЭтапа.КлючПартия = СтрокаСвязи.КлючПартияПредшественник;
        ПоискЭтапа.Этап = СтрокаСвязи.ЭтапПредшественник;
        Предшественники = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтапа);
        Если Предшественники.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;
        Предшественник = Предшественники[0];
        СмещениеПредшественника = ?(Предшественник.Начало <> Предшественник.Окончание, 1, 0);
        СтрокаЭтап.НачалоРазмещения = Макс(СтрокаЭтап.НачалоРазмещения,
            Предшественник.Окончание + СмещениеПредшественника);
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    ИсходныйЭтап - СтрокаТаблицыЗначений - Этап, от которого начинается обход связей ремонтов.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_НаследоватьДатыРемонтов(ДанныеРасчета, ПараметрыРасчета, Знач ИсходныйЭтап)
    ОчередьРемонтов = Новый Массив;
    ОчередьРемонтов.Добавить(ИсходныйЭтап);
    ИндексОчереди = 0;
    ЧислоСвязей = ДанныеРасчета.СвязиРемонтов.Количество();
    ГраницаОбхода = Макс(1, ДанныеРасчета.Этапы.Количество() * (ЧислоСвязей + 1));
    Пока ИндексОчереди < ОчередьРемонтов.Количество() Цикл
        Если ИндексОчереди >= ГраницаОбхода Тогда
            ВызватьИсключение "Предпросмотр ВРЦ: превышена граница обхода связей ремонтов.";
        КонецЕсли;
        ЭлементРемонта = ОчередьРемонтов[ИндексОчереди];
        ИндексОчереди = ИндексОчереди + 1;
        ПоискРемонта = Новый Структура("КлючПартияРемонт", ЭлементРемонта.КлючПартия);
        Для Каждого СвязьРемонта Из ДанныеРасчета.СвязиРемонтов.НайтиСтроки(ПоискРемонта) Цикл
            юум_ФП_ОбновитьДатыРемонтногоЭтапа(ДанныеРасчета, ПараметрыРасчета,
                СвязьРемонта, ЭлементРемонта, ОчередьРемонтов);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры // } #юум

// Параметры:
//    ДанныеРасчета - Структура - Штатная модель графика: этапы, связи, доступность и реквизиты заказа.
//    ПараметрыРасчета - Структура - Штатные параметры, ошибки и дополнительные объемы расчета графика.
//    СвязьРемонта - СтрокаТаблицыЗначений - Связь текущего этапа с зависимой партией ремонта.
//    ЭлементРемонта - СтрокаТаблицыЗначений - Ремонтный этап, даты которого наследует зависимый этап.
//    ОчередьРемонтов - Массив - Обрабатываемые ремонтные этапы; пополняется найденными потомками.
// #юум {
// #ЧТЗ 04.01
// V2: согласование префикса и вызовов обработки.
// Sonar: оформление контрактов и локальных выражений; учетная логика сохранена.
// Галфинд mr. Cherryman 2026/11/11
Процедура юум_ФП_ОбновитьДатыРемонтногоЭтапа(ДанныеРасчета, ПараметрыРасчета,
    Знач СвязьРемонта, Знач ЭлементРемонта, ОчередьРемонтов)
    ПоискЭтапа = ПараметрыРасчета.КлючПартияЭтап;
    ЗаполнитьЗначенияСвойств(ПоискЭтапа, СвязьРемонта);
    ЭтапыРемонта = ДанныеРасчета.Этапы.НайтиСтроки(ПоискЭтапа);
    Если ЭтапыРемонта.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    ЭтапРемонта = ЭтапыРемонта[0];
    ПрежнееНачало = ЭтапРемонта.Начало;
    ПрежнееОкончание = ЭтапРемонта.Окончание;
    Если ЭтапРемонта.Начало = '00010101' Тогда
        ЗаполнитьЗначенияСвойств(ЭтапРемонта, ЭлементРемонта, "Начало,Окончание");
    Иначе
        ЭтапРемонта.Начало = Мин(ЭтапРемонта.Начало, ЭлементРемонта.Начало);
        ЭтапРемонта.Окончание = Макс(ЭтапРемонта.Окончание, ЭлементРемонта.Окончание);
    КонецЕсли;
    Если ЭтапРемонта.ЭтоНачальныйЭтапРемонта
        И (ПрежнееНачало <> ЭтапРемонта.Начало Или ПрежнееОкончание <> ЭтапРемонта.Окончание) Тогда
        ОчередьРемонтов.Добавить(ЭтапРемонта);
    КонецЕсли;
КонецПроцедуры // } #юум

#КонецОбласти

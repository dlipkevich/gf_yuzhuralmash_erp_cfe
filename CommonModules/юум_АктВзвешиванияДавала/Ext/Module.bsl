#Область ПрограммныйИнтерфейс

// Размещает на вкладке «Дополнительно» поля состава комиссии и обновляет их видимость.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа ОтгрузкаТоваровСХранения.
//
Процедура НастроитьПоляКомиссии(Форма) Экспорт
	
	ПоказыватьКомиссию = Форма.Объект.ХозяйственнаяОперация
		= Перечисления.ХозяйственныеОперации.ПередачаДавальцу2_5;
	ГруппаКомиссии = Форма.Элементы.Найти("юум_КомиссияАктаВзвешивания");
	Если ГруппаКомиссии = Неопределено И ПоказыватьКомиссию Тогда
		ГруппаКомиссии = ДобавитьПоляКомиссии(Форма.Элементы);
	КонецЕсли;
	
	Если ГруппаКомиссии <> Неопределено Тогда
		ГруппаКомиссии.Видимость = ПоказыватьКомиссию;
	КонецЕсли;
	
КонецПроцедуры

// Регистрирует акт для операции «Передача давальцу».
//
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандуПечати(КомандыПечати) Экспорт
	
	Команда = КомандыПечати.Добавить();
	Команда.Идентификатор = "юум_АктВзвешиванияДавала";
	Команда.Представление = НСтр("ru = 'Акт взвешивания давала'");
	Команда.Порядок = 15;
	Команда.ПроверкаПроведенияПередПечатью = Ложь;
	
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(
		Команда,
		"ХозяйственнаяОперация",
		Перечисления.ХозяйственныеОперации.ПередачаДавальцу2_5,
		ВидСравнения.Равно);
	
КонецПроцедуры

// Формирует востребованный акт и добавляет его в стандартную коллекцию печати.
//
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка.ОтгрузкаТоваровСХранения - документы к печати.
//  КоллекцияПечатныхФорм - см. УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм
//  ОбъектыПечати - СписокЗначений - области документов в комплекте печати.
//
Процедура Печать(Знач МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати) Экспорт
	
	ИмяМакета = "юум_АктВзвешиванияДавала";
	Если Не УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент = СформироватьАкты(МассивОбъектов, ОбъектыПечати);
	Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			ИмяМакета,
			НСтр("ru = 'Акт взвешивания давала'"),
			ТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьПоляКомиссии(ЭлементыФормы)
	
	ГруппаКомиссии = ЭлементыФормы.Добавить(
		"юум_КомиссияАктаВзвешивания", Тип("ГруппаФормы"), ЭлементыФормы.ГруппаДополнительно);
	ГруппаКомиссии.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаКомиссии.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаКомиссии.Заголовок = НСтр("ru = 'Комиссия для акта взвешивания'");
	
	ДобавитьПолеПодписанта(ЭлементыФормы, ГруппаКомиссии,
		"юум_ПредседательКомиссии", НСтр("ru = 'Председатель комиссии'"));
	
	ГруппаЧленов = ЭлементыФормы.Добавить("юум_ЧленыКомиссии", Тип("ГруппаФормы"), ГруппаКомиссии);
	ГруппаЧленов.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЧленов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаЧленов.Заголовок = НСтр("ru = 'Члены комиссии'");
	
	ДобавитьПолеПодписанта(ЭлементыФормы, ГруппаЧленов, "юум_ЧленыКомиссии1", НСтр("ru = 'Член комиссии 1'"));
	ДобавитьПолеПодписанта(ЭлементыФормы, ГруппаЧленов, "юум_ЧленыКомиссии2", НСтр("ru = 'Член комиссии 2'"));
	ДобавитьПолеПодписанта(ЭлементыФормы, ГруппаЧленов, "юум_ЧленыКомиссии3", НСтр("ru = 'Член комиссии 3'"));
	
	Возврат ГруппаКомиссии;
	
КонецФункции

Процедура ДобавитьПолеПодписанта(ЭлементыФормы, Родитель, Знач ИмяРеквизита, Знач Заголовок)
	
	Поле = ЭлементыФормы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = "Объект." + ИмяРеквизита;
	Поле.Заголовок = Заголовок;
	
КонецПроцедуры

Функция СформироватьАкты(Знач МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;
	ТабличныйДокумент.ПолеСверху = 33;
	ТабличныйДокумент.ПолеСнизу = 10;
	ТабличныйДокумент.МасштабПечати = 100;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_юум_АктВзвешиванияДавала";
	
	ДанныеАктов = ПолучитьДанныеАктов(МассивОбъектов);
	ДанныеОтветственных = ПолучитьДанныеОтветственных(ДанныеАктов.Шапки);
	Макет = Документы.ОтгрузкаТоваровСХранения.ПолучитьМакет("юум_АктВзвешиванияДавала");
	
	Для Каждого СсылкаНаДокумент Из МассивОбъектов Цикл
		Шапка = ДанныеАктов.Шапки.Найти(СсылкаНаДокумент, "Ссылка");
		Если Шапка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		ТоварыДокумента = ДанныеАктов.Товары.НайтиСтроки(Новый Структура("Ссылка", СсылкаНаДокумент));
		Комиссия = ПредставленияКомиссии(Шапка, ДанныеОтветственных);
		ВывестиАкт(ТабличныйДокумент, Макет, Шапка, ТоварыДокумента, Комиссия);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, СсылкаНаДокумент);
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПолучитьДанныеАктов(Знач МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Отгрузка.Ссылка КАК Ссылка,
	|	Отгрузка.Дата КАК Дата,
	|	ЕСТЬNULL(Отгрузка.ДокументОснование.Номер, """") КАК НомерОснования,
	|	ЕСТЬNULL(Отгрузка.Подразделение.Код, """") КАК КодЦеха,
	|	Отгрузка.юум_ПредседательКомиссии КАК Председатель,
	|	Отгрузка.юум_ЧленыКомиссии1 КАК ПервыйЧлен,
	|	Отгрузка.юум_ЧленыКомиссии2 КАК ВторойЧлен,
	|	Отгрузка.юум_ЧленыКомиссии3 КАК ТретийЧлен
	|ИЗ
	|	Документ.ОтгрузкаТоваровСХранения КАК Отгрузка
	|ГДЕ
	|	Отгрузка.Ссылка В (&ДокументыПечати)
	|	И Отгрузка.ХозяйственнаяОперация = &ПередачаДавальцу
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыДокумента.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ТоварыДокумента.Номенклатура.Код, """") КАК Чертеж,
	|	ЕСТЬNULL(ТоварыДокумента.Номенклатура.НаименованиеПолное, """") КАК ПолноеНаименование,
	|	ЕСТЬNULL(ТоварыДокумента.Номенклатура.Наименование, """") КАК Наименование
	|ИЗ
	|	Документ.ОтгрузкаТоваровСХранения.Товары КАК ТоварыДокумента
	|ГДЕ
	|	ТоварыДокумента.Ссылка В (&ДокументыПечати)
	|	И ТоварыДокумента.Ссылка.ХозяйственнаяОперация = &ПередачаДавальцу
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТоварыДокумента.Ссылка,
	|	ТоварыДокумента.НомерСтроки";
	
	Запрос.УстановитьПараметр("ДокументыПечати", МассивОбъектов);
	Запрос.УстановитьПараметр("ПередачаДавальцу", Перечисления.ХозяйственныеОперации.ПередачаДавальцу2_5);
	РезультатыПакета = Запрос.ВыполнитьПакет();
	Шапки = РезультатыПакета[0].Выгрузить();
	Товары = РезультатыПакета[1].Выгрузить();
	Шапки.Индексы.Добавить("Ссылка");
	Товары.Индексы.Добавить("Ссылка");
	
	Возврат Новый Структура("Шапки, Товары", Шапки, Товары);
	
КонецФункции

Функция ПодписантыДокумента(Шапка)
	
	Подписанты = Новый Массив;
	Подписанты.Добавить(Шапка.Председатель);
	Подписанты.Добавить(Шапка.ПервыйЧлен);
	Подписанты.Добавить(Шапка.ВторойЧлен);
	Подписанты.Добавить(Шапка.ТретийЧлен);
	
	Возврат Подписанты;
	
КонецФункции

Функция ПолучитьДанныеОтветственных(Шапки)
	
	УникальныеПодписанты = Новый Соответствие;
	Подписанты = Новый Массив;
	Для Каждого Шапка Из Шапки Цикл
		Для Каждого Подписант Из ПодписантыДокумента(Шапка) Цикл
			Если ЗначениеЗаполнено(Подписант) И УникальныеПодписанты.Получить(Подписант) = Неопределено Тогда
				УникальныеПодписанты.Вставить(Подписант, Истина);
				Подписанты.Добавить(Подписант);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Подписанты, "Должность, ФизическоеЛицо", Истина);
	
КонецФункции

Функция ПредставленияКомиссии(Шапка, ДанныеОтветственных)
	
	Подписи = Новый Массив;
	СоставВШапке = Новый Массив;
	Присутствовали = Новый Массив;
	
	Для Каждого Подписант Из ПодписантыДокумента(Шапка) Цикл
		ДанныеПодписанта = ДанныеОтветственных.Получить(Подписант);
		Если ДанныеПодписанта = Неопределено Тогда
			Подписи.Добавить("");
			СоставВШапке.Добавить("");
			Продолжить;
		КонецЕсли;
		
		ЧастиФИО = ФизическиеЛицаУТ.ФамилияИмяОтчество(ДанныеПодписанта.ФизическоеЛицо, Шапка.Дата);
		ПолноеИмя = СокрЛП(СтрШаблон("%1 %2 %3", ЧастиФИО.Фамилия, ЧастиФИО.Имя, ЧастиФИО.Отчество));
		Если ПустаяСтрока(ПолноеИмя) И ЗначениеЗаполнено(ДанныеПодписанта.ФизическоеЛицо) Тогда
			Если Не ДанныеПодписанта.Свойство("ФИОКарточки", ПолноеИмя) Тогда
				ФИОКарточки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					ДанныеПодписанта.ФизическоеЛицо, "ФИО", Истина);
				ПолноеИмя = ?(ФИОКарточки = Неопределено, "", СокрЛП(ФИОКарточки));
				ДанныеПодписанта.Вставить("ФИОКарточки", ПолноеИмя);
			КонецЕсли;
			ЧастиФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ПолноеИмя);
		КонецЕсли;
		ИмяДляПодписи = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиФИО);
		ИмяВРодительном = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ВРодительномПадеже(ПолноеИмя));
		Должность = СокрЛП(ДанныеПодписанта.Должность);
		ДолжностьВРодительном = ВРодительномПадеже(Должность);
		
		Подписи.Добавить(СокрЛП(Должность + " " + ИмяДляПодписи));
		СоставВШапке.Добавить(СокрЛП(ДолжностьВРодительном + " " + ИмяВРодительном));
		Если Не ПустаяСтрока(ИмяВРодительном) Тогда
			Присутствовали.Добавить(ИмяВРодительном);
		КонецЕсли;
	КонецЦикла;
	
	ЧленыВШапке = Новый Массив;
	Для ИндексПодписи = 1 По 3 Цикл
		Если Не ПустаяСтрока(СоставВШапке[ИндексПодписи]) Тогда
			ЧленыВШапке.Добавить(СоставВШапке[ИндексПодписи]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("ПредседательВШапке, ЧленыВШапке, Присутствовали, Подписи",
		СоставВШапке[0], СтрСоединить(ЧленыВШапке, "; "), СтрСоединить(Присутствовали, "; "), Подписи);
	
КонецФункции

Функция ВРодительномПадеже(Знач Представление)
	
	Если ПустаяСтрока(Представление) Тогда
		Возврат "";
	КонецЕсли;
	
	ВариантыСклонения = ПолучитьСклоненияСтроки(Представление, "Л=ru_RU", "ПД=Родительный");
	Возврат ?(ВариантыСклонения.Количество() = 0, Представление, ВариантыСклонения[0]);
	
КонецФункции

Процедура ВывестиАкт(ТабличныйДокумент, Макет, Шапка, ТоварыДокумента, Комиссия)
	
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	СоставКомиссии = СтрШаблон(
		НСтр("ru = 'Совместная комиссия, в составе председателя комиссии: %1; членов комиссии: %2'"),
		Комиссия.ПредседательВШапке,
		Комиссия.ЧленыВШапке);
	ОбстоятельстваПеревески = СтрШаблон(
		НСтр("ru = '%1г., в %2ч%3мин. в цехе №%4 провела перевеску необработанной заготовки.'"),
		Формат(Шапка.Дата, "ДФ=dd.MM.yyyy"),
		Формат(Шапка.Дата, "ДФ=HH"),
		Формат(Шапка.Дата, "ДФ=mm"),
		СокрЛП(Шапка.КодЦеха));
	ОбластьШапки.Параметры.Комиссия = СоставКомиссии + " " + ОбстоятельстваПеревески;
	ТабличныйДокумент.Вывести(ОбластьШапки);
	
	ВывестиТовары(ТабличныйДокумент, Макет, ТоварыДокумента,
		ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.НомерОснования));
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.Присутствовали = Комиссия.Присутствовали;
	ТабличныйДокумент.Вывести(Подвал);
	
	Подписи = Макет.ПолучитьОбласть("Подписи");
	Подписи.Параметры.ПодписьПредседателя = Комиссия.Подписи[0];
	Подписи.Параметры.ПодписьЧленаКомиссии1 = Комиссия.Подписи[1];
	Подписи.Параметры.ПодписьЧленаКомиссии2 = Комиссия.Подписи[2];
	Подписи.Параметры.ПодписьЧленаКомиссии3 = Комиссия.Подписи[3];
	ПроверяемыеОбласти = Новый Массив;
	ПроверяемыеОбласти.Добавить(Подписи);
	Если Не ТабличныйДокумент.ПроверитьВывод(ПроверяемыеОбласти) Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	ТабличныйДокумент.Вывести(Подписи);
	
КонецПроцедуры

Процедура ВывестиТовары(ТабличныйДокумент, Макет, ТоварыДокумента, Знач НомерЗаказа)
	
	ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ШапкаТаблицы);
	ОбластьТовара = Макет.ПолучитьОбласть("Строка");
	ПроверяемыеОбласти = Новый Массив;
	ПроверяемыеОбласти.Добавить(ОбластьТовара);
	
	Для Каждого ТоварДокумента Из ТоварыДокумента Цикл
		ОбластьТовара.Параметры.НомерЗаказа = НомерЗаказа;
		ОбластьТовара.Параметры.Чертеж = ТоварДокумента.Чертеж;
		ОбластьТовара.Параметры.Наименование = ?(ПустаяСтрока(ТоварДокумента.ПолноеНаименование),
			ТоварДокумента.Наименование, ТоварДокумента.ПолноеНаименование);
		
		Если Не ТабличныйДокумент.ПроверитьВывод(ПроверяемыеОбласти) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			ТабличныйДокумент.Вывести(ШапкаТаблицы);
		КонецЕсли;
		ТабличныйДокумент.Вывести(ОбластьТовара);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

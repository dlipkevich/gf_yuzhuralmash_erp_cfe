Процедура юум_УстановкаПараметровСеанса(ИменаПараметровСеанса) Экспорт
	Если ИменаПараметровСеанса <> Неопределено 
		И ИменаПараметровСеанса.Найти("юум_Организации_ОтдельныйРасчетВыпуска") <> Неопределено Тогда
		МассивОрганизаций = Новый Массив;
		тОрганизация = юум_ОбщегоНазначения.ПолучитьГлобальноеЗначение("РасчетЗатратНаВыпускОтдельнымДокументом");
		Если ЗначениеЗаполнено(тОрганизация) Тогда
			МассивОрганизаций.Добавить(тОрганизация);
		КонецЕсли;
		тОрганизация_Массив = юум_ОбщегоНазначения.ПолучитьГлобальноеЗначениеМассив("РасчетЗатратНаВыпускОтдельнымДокументом");
		Для каждого тОрганизация Из тОрганизация_Массив Цикл
			МассивОрганизаций.Добавить(тОрганизация);
		КонецЦикла; 
		
		ПараметрыСеанса.юум_Организации_ОтдельныйРасчетВыпуска = Новый ФиксированныйМассив(МассивОрганизаций);
	КонецЕсли;                                
	Если ИменаПараметровСеанса <> Неопределено
		И ИменаПараметровСеанса.Найти("юум_ДокументыБПО") <> Неопределено Тогда
		ПараметрыСеанса.юум_ДокументыБПО = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	// Галфинд ROL32:beg 05.09.2024
	Если ИменаПараметровСеанса <> Неопределено Тогда
		Если ИменаПараметровСеанса.Найти("юум_РежимОтладки") <> Неопределено Тогда
			ПараметрыСеанса.юум_РежимОтладки = ложь;
		КонецЕсли;
		Если ИменаПараметровСеанса.Найти("юум_КритичноеВремяПроизвольногоЗапроса") <> Неопределено Тогда
			ПараметрыСеанса.юум_КритичноеВремяПроизвольногоЗапроса = 0;
		КонецЕсли;
	КонецЕсли;
	// Галфинд ROL32:end 05.09.2024
	
КонецПроцедуры


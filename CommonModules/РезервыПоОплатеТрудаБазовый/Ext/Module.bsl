
&ИзменениеИКонтроль("ОбработкаПроверкиЗаполненияРезервовПоОплатеТруда")
Процедура юум_ОбработкаПроверкиЗаполненияРезервовПоОплатеТруда(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов)

	ИспользуетсяДетальныйУчетРезервов = Истина;
	РезервыПоОплатеТрудаПереопределяемый.ИспользуетсяДетальныйУчетРезервов(ИспользуетсяДетальныйУчетРезервов);

	ИспользоватьСтатьиФинансированияЗарплата = ПолучитьФункциональнуюОпцию("ИспользоватьСтатьиФинансированияЗарплата");

	Если ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийРезервовПоОплатеТруда.Корректировка
		Или ЭтотОбъект.ВидОперации = Перечисления.ВидыОперацийРезервовПоОплатеТруда.Списание Тогда
		МассивНепроверяемыхРеквизитов.Добавить("Начисления");
		МассивНепроверяемыхРеквизитов.Добавить("Взносы");
		МассивНепроверяемыхРеквизитов.Добавить("РасчетРезервов");
	КонецЕсли;
	Если Не ИспользуетсяДетальныйУчетРезервов Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ОценочныеОбязательстваПоСотрудникам.Сотрудник");
	КонецЕсли;

	Если ИспользуетсяДетальныйУчетРезервов Тогда
		Для Каждого СтрокаТаблицы Из ЭтотОбъект.ОценочныеОбязательстваПоСотрудникам Цикл
			Префикс = "ОценочныеОбязательстваПоСотрудникам[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Подразделение"" в строке %1 списка "" Обязательства и резервы по сотрудникам""';
				|en = 'The ""Business unit"" column in line %1 of the ""Liabilities and reserves by employees"" list might not be filled in'"),
				СтрокаТаблицы.НомерСтроки);
				Поле = Префикс + "Подразделение";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
			КонецЕсли;
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.СпособОтраженияЗарплатыВБухучете) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Способ отражения"" в строке %1 списка "" Обязательства и резервы по сотрудникам""';
				|en = 'The ""Record method"" column in line %1 of the ""Liabilities and reserves by employees"" list might not be filled in'"),
				СтрокаТаблицы.НомерСтроки);
				Поле = Префикс + "СпособОтраженияЗарплатыВБухучете";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
			КонецЕсли;
			Если ИспользоватьСтатьиФинансированияЗарплата И Не ЗначениеЗаполнено(СтрокаТаблицы.СтатьяФинансирования) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Статья финансирования"" в строке %1 списка "" Обязательства и резервы по сотрудникам""';
				|en = 'The ""Financing item"" column in line %1 of the ""Liabilities and reserves by employees"" list might not be filled in'"),
				СтрокаТаблицы.НомерСтроки);
				Поле = Префикс + "СтатьяФинансирования";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого СтрокаТаблицы Из ЭтотОбъект.ОценочныеОбязательства Цикл
		Префикс = "ОценочныеОбязательства[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].";
		#Вставка
		// Проверяем Подразделение только при необходимости
		// #юум #ЧТЗ Интеграция 1C:ЗУП→1C:ERP Галфинд  Садомцев 2026/10/01
		Если ПолучитьФункциональнуюОпцию("ИспользоватьНачислениеЗарплатыУТ") Тогда
		#КонецВставки
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Подразделение) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Подразделение"" в строке %1 списка "" Обязательства и резервы (сводно)""';
			|en = 'The ""Business unit"" column in line %1 of the ""Provisions and payroll funds (summary)"" list might not be filled in'"),
			СтрокаТаблицы.НомерСтроки);
			Поле = Префикс + "Подразделение";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
		КонецЕсли;
		#Вставка
		КонецЕсли;
		#КонецВставки
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СпособОтраженияЗарплатыВБухучете) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Способ отражения"" в строке %1 списка "" Обязательства и резервы (сводно)""';
			|en = 'The ""Record method"" column in line %1 of the ""Provisions and payroll funds (summary)"" list might not be filled in'"),
			СтрокаТаблицы.НомерСтроки);
			Поле = Префикс + "СпособОтраженияЗарплатыВБухучете";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
		КонецЕсли;
		Если ИспользоватьСтатьиФинансированияЗарплата И Не ЗначениеЗаполнено(СтрокаТаблицы.СтатьяФинансирования) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Возможно ошибочно не заполнена колонка ""Статья финансирования"" в строке %1 списка "" Обязательства и резервы (сводно)""';
			|en = 'The ""Financing item"" column in line %1 of the ""Provisions and payroll funds (summary)"" list might not be filled in'"),
			СтрокаТаблицы.НомерСтроки);
			Поле = Префикс + "СтатьяФинансирования";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, Поле, "Объект");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

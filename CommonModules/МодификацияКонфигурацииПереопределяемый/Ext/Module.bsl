#Область СлужебныеПроцедурыИФункции

// #юум {
// #04.02.2.13. Поля сохраненных подписантов на вкладке Дополнительно заказа.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - создаваемая типовая форма.
//  Отказ - Булево - штатный признак отказа создания, не изменяется.
//  СтандартнаяОбработка - Булево - штатный признак обработки, не изменяется.
&После("ПриСозданииНаСервере")
Процедура юум_КГЗПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка)

    Если Форма.ИмяФормы <> "Документ.ЗаказНаПроизводство2_2.Форма.ФормаДокумента" Тогда
        Возврат;
    КонецЕсли;
    Страница = Форма.Элементы.Найти("СтраницаДополнительно");
    Если Страница = Неопределено Тогда
        Возврат;
    КонецЕсли;
    юум_КГЗДобавитьПоле(Форма, Страница, "юум_Утверждающий", НСтр("ru = 'Утверждающий'"));
    юум_КГЗДобавитьПоле(Форма, Страница, "юум_РуководительСлужбыКачества",
        НСтр("ru = 'Руководитель службы качества'"));
    юум_КГЗДобавитьПоле(Форма, Страница, "юум_Исполнитель", НСтр("ru = 'Исполнитель'"));

КонецПроцедуры // } #юум

// #юум {
// #04.02.2.13. Поле формы с прямой привязкой к реквизиту заказа.
// Галфинд mr. Cherryman 2026/10/30
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма заказа.
//  Страница - ГруппаФормы - вкладка Дополнительно.
//  Имя - Строка - имя реквизита заказа и поля формы.
//  ЗаголовокПоля - Строка - название поля для пользователя.
Процедура юум_КГЗДобавитьПоле(Форма, Страница, Знач Имя, Знач ЗаголовокПоля)

    Если Форма.Элементы.Найти(Имя) <> Неопределено Тогда
        Возврат;
    КонецЕсли;
    Поле = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), Страница);
    Поле.Вид = ВидПоляФормы.ПолеВвода;
    Поле.ПутьКДанным = "Объект." + Имя;
    Поле.Заголовок = ЗаголовокПоля;
    Поле.Ширина = 40;
    Поле.КнопкаВыбора = Истина;
    Поле.КнопкаОчистки = Истина;

КонецПроцедуры // } #юум

#КонецОбласти

Функция ОбъектНоменклатуры(КЭШ, RS, Орск, ТекОб = Неопределено) Экспорт

	ИД = Поле(RS, "DESIGNATIO");
	Если СтрДлина(ИД) > 19 Тогда
		ИД = Лев(ИД, 19);		
	КонецЕсли;
	
	ИмяПодПапки  =  Поле(RS, "GROUP_NAME");
	Родитель = НайтиСоздатьПапкуНоменклатуры(КЭШ, ИмяПодПапки);
		
	Если Орск Тогда
		
		струПоля = Новый Структура("NAME,MATERIAL,GOST_M,TYPSIZE,GOST_S,STP", 
		Поле(RS, "NAME"), Поле(RS, "MATERIAL"), Поле(RS, "GOST_M"),
		Поле(RS, "TYPSIZE"), Поле(RS, "GOST_S"), Поле(RS, "STP"));
		НаименованиеП =	ПолучитьПолноеНаименование(струПоля);
		
	Иначе
		
		НаименованиеП = Поле(RS, "FULL_NAME_1C");
		
		Если ПустаяСтрока(НаименованиеП) Тогда
		
			струПоля = Новый Структура("NAME,MATERIAL,GOST_M,TYPSIZE,GOST_S,STP", 
				Поле(RS, "NAME"), Поле(RS, "MATERIAL"), Поле(RS, "GOST_M"),
			Поле(RS, "TYPSIZE"), Поле(RS, "GOST_S"), Поле(RS, "STP"));
			НаименованиеП =	ПолучитьПолноеНаименование(струПоля);
		
		КонецЕсли;
		стрВидНом 		= Поле(RS, "VID_NOMENKL");
	КонецЕсли;
	
	Попытка
		кодЕИ 			= Число(RS.Fields("P750").Value);
	Исключение
		кодЕИ = 0;
	КонецПопытки;
	
	стрЕИ_вес  		= Поле(RS, "P750M");
	Попытка
		Вес 			= Число(RS.Fields("H580").Value);
	Исключение
		Вес = 0;	
	КонецПопытки;
	
	стрЕИ_вес = ИсправитьЕИ(стрЕИ_вес);

	стрВидНом = стрВидНоменклатурыПоКоду(ИД);
	ВидНоменклатуры = НайтиСоздатьВидНоменклатуры(КЭШ, стрВидНом);
	
	ЕИ = КЭШ.ствЕИ_РС[кодЕИ];
	ЕИ_вес = НайтиСоздатьЕИ(КЭШ, стрЕИ_вес);
	
	Если ТекОб <> Неопределено Тогда
		об = ТекОб;	
	Иначе
		об = Справочники.Номенклатура.СоздатьЭлемент();
		об.юум_КодИнтермех = ИД;
		об.Код = ИД;
	КонецЕсли;
	
	об.ЕдиницаИзмерения = ЕИ;
	об.ВесЕдиницаИзмерения = ЕИ_вес;
	
	об.НаименованиеПолное = НаименованиеП;
	об.Наименование = об.НаименованиеПолное;
	
	об.ЕдиницаИзмерения = ЕИ;
	об.ВесЕдиницаИзмерения = ЕИ_вес;
	об.ВесЧислитель = Вес;
	об.ВесЗнаменатель = 1;
	об.ВесИспользовать = Истина;
	об.ВесМожноУказыватьВДокументах = Истина;
	
	об.ВидНоменклатуры = ВидНоменклатуры; 
	об.ТипНоменклатуры = ВидНоменклатуры.ТипНоменклатуры;
	Если об.ВидНоменклатуры = НайтиСоздатьВидНоменклатуры(КЭШ, "Готовая продукция, товары, полуфабрикаты") Тогда
		об.СхемаОбеспечения = КЭШ.схемаПроизводство;
	Иначе	
		об.СхемаОбеспечения = КЭШ.схемаОсновная;		
	КонецЕсли;
	об.Качество = Перечисления.ГрадацииКачества.Новый;
	
	об.СтавкаНДС = КЭШ.СтавкаНДС;
	об.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	об.ИспользоватьУпаковки = Истина;
	об.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры;
	
	об.ВариантОформленияПродажи = Перечисления.ВариантыОформленияПродажи.РеализацияТоваровУслуг;
	об.ОбособленнаяЗакупкаПродажа = Истина;
	об.Родитель = Родитель;
	
	об.ГруппаФинансовогоУчета = ГФУН(КЭШ, ВидНоменклатуры);
	об.ЦеноваяГруппа = ЦеноваяГруппа(КЭШ, ВидНоменклатуры);
	
	об.ДополнительныеСвойства.Вставить("РабочееНаименованиеПроверено", Истина);
	//об.Записать();
	Возврат об;

КонецФункции

Функция НайтиСоздатьПапкуНоменклатуры(КЭШ, наим)

	Если ПустаяСтрока(наим) Тогда
		Возврат КЭШ.КореньНом;	
	КонецЕсли;
	
	Папка = КЭШ.ПапкиНом[наим];
	Если Папка <> Неопределено Тогда
		Возврат Папка;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Родитель В ИЕРАРХИИ(&КореньНом)
	|	И Номенклатура.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("КореньНом", КЭШ.КореньНом);
	Запрос.УстановитьПараметр("Наименование", наим);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда 
		КЭШ.ПапкиНом[наим] = Выборка.Ссылка;
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	об = Справочники.Номенклатура.СоздатьГруппу();
	об.Родитель = КЭШ.КореньНом; 
	об.Код = наим;
	об.Наименование = наим;
	об.ОбменДанными.Загрузка = Истина;
	об.Записать();	
	
	КЭШ.ПапкиНом[наим] = об.Ссылка;
	Возврат об.Ссылка;
	
КонецФункции

Функция ПолучитьПолноеНаименование(Структура)
	
	Стр = ""
	+?(ЗначениеЗаполнено(Структура.NAME),		Структура.NAME+		"; ","")
	+?(ЗначениеЗаполнено(Структура.MATERIAL),	Структура.MATERIAL+	"; ","")
	+?(ЗначениеЗаполнено(Структура.GOST_M),		Структура.GOST_M+	"; ","")
	+?(ЗначениеЗаполнено(Структура.TYPSIZE),	Структура.TYPSIZE+	"; ","")
	+?(ЗначениеЗаполнено(Структура.GOST_S),		Структура.GOST_S+	"; ","")
	+?(ЗначениеЗаполнено(Структура.STP),		Структура.STP+		"; ","");
	
	Если СтрДлина(Стр) > 0 Тогда
		Стр = Лев(Стр, СтрДлина(Стр)-2); // убираем конечные "; "
	КонецЕсли;
	
	Возврат Стр;
	
КонецФункции

Функция ИсправитьЕИ(стр)

	Если стр = "1000шт" Тогда
		Возврат "тыс. шт";
	ИначеЕсли стр = "тыс" Тогда
		Возврат "тыс. шт";	
	ИначеЕсли стр = "пм" Тогда
		Возврат "пог. м";
	ИначеЕсли стр = "ком" Тогда
		Возврат "компл";
	КонецЕсли;
	
	Возврат стр;
	
КонецФункции


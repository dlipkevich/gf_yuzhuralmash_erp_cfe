Функция ПолучитьЕИ_РС()

	ств = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Код КАК Код,
	|	Т.ЕдиницаИзмерения КАК Ссылка
	|ИЗ
	|	РегистрСведений.юум_СоответствиеЕдиницИзмеренияВнешнейСистемы КАК Т";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ств[Выборка.Код] = Выборка.Ссылка; 
	КонецЦикла;

	Возврат ств;
	
КонецФункции

Функция ПолучитьВидыНоменклатуры()

	ств = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВидыНоменклатуры.Наименование КАК ИД,
	|	ВидыНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыНоменклатуры КАК ВидыНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыНоменклатуры.ПометкаУдаления УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ств[НРег(Выборка.ИД)] = Выборка.Ссылка; 
	КонецЦикла;

	Возврат ств;
	
КонецФункции 

Процедура ПолучитьГФУН_ЦГ(КЭШ)

	ств = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.ВидНоменклатуры КАК ВидНоменклатуры,
	|	т.ГруппаФинансовогоУчетаНоменклатуры КАК ГФУН
	|ИЗ
	|	РегистрСведений.юум_СоотвествиеВидаНоменклатурыГФУН КАК т";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.ГФУН) Тогда
			Продолжить;	
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Выборка.ВидНоменклатуры) Тогда
			вн = "ВСЕ";
		Иначе
			вн = Выборка.ВидНоменклатуры;
		КонецЕсли;
		ств[вн] = Выборка.ГФУН;
	КонецЦикла;
	КЭШ.Вставить("ствГФУН", ств);
	
	ств = Новый Соответствие;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	т.ВидНоменклатуры КАК ВидНоменклатуры,
	|	т.ЦеноваяГруппа КАК ЦГ
	|ИЗ
	|	РегистрСведений.юум_СоотвествиеВидаНоменклатурыЦеновойГруппе КАК т";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.ЦГ) Тогда
			Продолжить;	
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Выборка.ВидНоменклатуры) Тогда
			вн = "ВСЕ";
		Иначе
			вн = Выборка.ВидНоменклатуры;
		КонецЕсли;
		ств[вн] = Выборка.ЦГ;
	КонецЦикла;
	КЭШ.Вставить("ствЦГ", ств);
	
КонецПроцедуры

Функция СтавкаНДС()

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	т.Ссылка КАК Ставка
	|ИЗ
	|	Справочник.СтавкиНДС КАК т
	|ГДЕ
	|	т.Основная
	|
	|УПОРЯДОЧИТЬ ПО
	|	т.НачалоПериода УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ставка;
	КонецЦикла;

КонецФункции


Функция Поле(RS, Имя)

	п = RS.Fields(Имя);	
	Если п.Type = 200 ИЛИ п.Type = 202 Тогда
		//строка
		Возврат СокрЛП(п.Value);		
	ИначеЕсли п.Type = 139 Тогда		
		// число
		Возврат Формат(п.Value, "ЧГ=0");	
	КонецЕсли;
	
КонецФункции

Функция _ПОДОБНО(Код, Начало)

	Возврат СтрНачинаетсяС(Код, Начало);


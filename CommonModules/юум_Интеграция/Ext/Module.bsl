Функция ПолучитьЕИ()

	ств = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Т.Ссылка КАК Ссылка,
	|	Т.Наименование КАК Наименование,
	|	Т.Код КАК Код,
	|	Т.НаименованиеПолное КАК НаименованиеПолное
	|ИЗ
	|	Справочник.УпаковкиЕдиницыИзмерения КАК Т
	|ГДЕ
	|	Т.Владелец = ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ПометкаУдаления УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ств[НРег(Выборка.Наименование)] = Выборка.Ссылка; 
	КонецЦикла;

	Возврат ств;
	

Процедура ЗаполнитьКЭШНоменклатуры(КЭШ) Экспорт

    КЭШ.Вставить("схемаОсновная", Справочники.СхемыОбеспечения.НайтиПоНаименованию("Основная"));
	КЭШ.Вставить("схемаПроизводство", Справочники.СхемыОбеспечения.НайтиПоНаименованию("Производство"));

	КЭШ.Вставить("ствВидНом", ПолучитьВидыНоменклатуры());
	КЭШ.Вставить("ствЕИ", ПолучитьЕИ());
	КЭШ.Вставить("ствЕИ_РС", ПолучитьЕИ_РС());
	КЭШ.Вставить("СтавкаНДС", СтавкаНДС());
	
	суид = "735decb5-6d73-11ec-9721-00155d6a0f13";
	КореньНом = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(суид));
	
	Если КореньНом.ПолучитьОбъект() = Неопределено  Тогда
		об = Справочники.Номенклатура.СоздатьГруппу();
		об.УстановитьСсылкуНового(КореньНом);
		об.Код = "Intermech";
		об.Наименование = "Загружено из Intermech";
		об.ОбменДанными.Загрузка = Истина;
		об.Записать();
	КонецЕсли;

	КЭШ.Вставить("КореньНом", КореньНом);
	КЭШ.Вставить("ПапкиНом", Новый Соответствие);
	
	ПолучитьГФУН_ЦГ(КЭШ);
	

&НаКлиенте
Процедура юум_ДействиеПоказатьКомментарий(Команда)
	
	юум_ДействиеПоказатьКомментарийНаСервере();

КонецПроцедуры // } #юум

// #юум {
// #ЧТЗ Интеграция 1C:ЗУП→1C:ERP
// Галфинд  Садомцев 2026/10/01
&НаСервере
Процедура юум_ДействиеПоказатьКомментарийНаСервере()
	
	Если Элементы.юум_Комментарий.Видимость = Ложь Тогда
		Элементы.юум_Комментарий.Видимость = Истина;
		Команды.юум_КомандаПоказатьКомментарий.Заголовок = "Скрыть комментарий";
	Иначе
		Элементы.юум_Комментарий.Видимость = Ложь;
		Команды.юум_КомандаПоказатьКомментарий.Заголовок = "Показать комментарий";
	КонецЕсли;

КонецПроцедуры // } #юум

#КонецОбласти
&НаСервере
Процедура юум_ДоработатьФормуНаСервере()

	//Добавление команды формы
	Команда = Команды.Добавить("юум_КомандаПоказатьКомментарий"); //Имя команды
	Команда.Заголовок = "Показать комментарий";
	Команда.Действие  = "юум_ДействиеПоказатьКомментарий"; //Имя связанной процедуры
	
	//Добавление кнопки формы
	КнопкаФормы = Элементы.Добавить(
		"юум_КнопкаПоказатьКомментарий", //Имя кнопки
		Тип("КнопкаФормы"),             //Тип, всегда КнопкаФормы
		ЭтотОбъект);                      //Контейнер для кнопки (Форма, Группа, Командная панель)
		
	КнопкаФормы.ИмяКоманды = "юум_КомандаПоказатьКомментарий"; //Связь с командой по имени
	
	КнопкаФормы.Вид = ВидКнопкиФормы.Гиперссылка; 
	
	//// Создаем новые реквизиты
	//ДобавляемыеРеквизиты = Новый Массив; // Определяем массив добавляемых реквизитов
	//
	//НовыйРеквизит = Новый РеквизитФормы("юум_Комментарий", Новый ОписаниеТипов("Строка"), , "Комментарий");
	//ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);	
	//
	//ИзменитьРеквизиты(ДобавляемыеРеквизиты); // Применяем реквизиты
	
	// Создаем новые поля
	НовыйЭлемент = Элементы.Добавить("юум_Комментарий", Тип("ПолеФормы"));
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.юум_Комментарий";
	НовыйЭлемент.ТолькоПросмотр = Истина;
	НовыйЭлемент.Видимость = Ложь;
	НовыйЭлемент.МногострочныйРежим = Истина;
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
КонецПроцедуры // } #юум


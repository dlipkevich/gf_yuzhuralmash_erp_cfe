
&НаСервере
Процедура юум_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавитьЭлементы();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементы()
	
	НовЭлемент = Элементы.Вставить("юум_ЧерныйВес", Тип("ПолеФормы"), 
		Элементы.ГруппаОдноИзделие, Элементы.ГруппаРемонтируемоеИзделие);
	НовЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовЭлемент.ПутьКДанным = "Объект.юум_ЧерныйВес";
	
КонецПроцедуры


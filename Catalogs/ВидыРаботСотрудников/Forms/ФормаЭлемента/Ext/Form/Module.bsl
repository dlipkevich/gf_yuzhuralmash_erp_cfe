
&НаСервере
Процедура юум_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	ДобавитьЭлементы();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементы()
	
	НовЭлемент = Элементы.Вставить("юум_ШифрРабот", Тип("ПолеФормы"), 
		Элементы.ГруппаШапка, Элементы.ЕдиницаИзмерения);
	НовЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовЭлемент.ПутьКДанным = "Объект.юум_ШифрРабот";
	
	НовЭлемент = Элементы.Вставить("юум_КодВидаРабот", Тип("ПолеФормы"), 
		Элементы.ГруппаШапка, Элементы.ЕдиницаИзмерения);
	НовЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовЭлемент.ПутьКДанным = "Объект.юум_КодВидаРабот";
	
КонецПроцедуры

